        <Item class="ModuleScript" referent="4">
          <Properties>
            <string name="Name">Abilities</string>
            <string name="Source"><![CDATA[--!strict
local Types = require("../Types")

type Ability = Types.Ability
type PathId = Types.PathId

-- Ordered by Path (hexagon order), then unlock level.
local list: { Ability } = {
	-- Fang
	{
		id = "lunge",
		name = "Lunge",
		path = "Fang",
		unlockLevel = 3,
		cooldown = 6,
		kind = "dash",
		distance = 12,
		damage = 22,
		description = "Dash 12 studs; the first enemy you pass takes 22 damage.",
	},
	{
		id = "rending_flurry",
		name = "Rending Flurry",
		path = "Fang",
		unlockLevel = 10,
		cooldown = 8,
		kind = "melee",
		range = 8,
		damage = 10,
		hits = 3,
		interval = 0.25,
		description = "Strike the nearest enemy in front of you three times for 10 damage each.",
	},
	{
		id = "final_toll",
		name = "Final Toll",
		path = "Fang",
		unlockLevel = 18,
		cooldown = 14,
		kind = "melee",
		range = 8,
		damage = 12,
		executeBelow = 35,
		executeDamage = 40,
		description = "Strike for 12 damage, or 40 if the enemy has 35 health or less.",
	},
	-- Gale
	{
		id = "slipstream",
		name = "Slipstream",
		path = "Gale",
		unlockLevel = 3,
		cooldown = 5,
		kind = "dash",
		distance = 20,
		damage = 10,
		description = "Dash 20 studs; the first enemy you pass takes 10 damage.",
	},
	{
		id = "gust_blade",
		name = "Gust Blade",
		path = "Gale",
		unlockLevel = 10,
		cooldown = 4,
		kind = "shot",
		range = 35,
		damage = 18,
		description = "Fire a blade of wind up to 35 studs that deals 18 damage.",
	},
	{
		id = "afterimage",
		name = "Afterimage",
		path = "Gale",
		unlockLevel = 18,
		cooldown = 16,
		kind = "self",
		immune = 1.5,
		empower = { bonus = 20, duration = 4 },
		description = "For 1.5 seconds nothing can hurt or affect you; your next hit within 4 seconds deals 20 extra damage.",
	},
	-- Ember
	{
		id = "cinder_bolt",
		name = "Cinder Bolt",
		path = "Ember",
		unlockLevel = 3,
		cooldown = 3.5,
		kind = "shot",
		range = 50,
		damage = 16,
		burn = { dps = 3, duration = 3 },
		description = "Fire a bolt up to 50 studs that deals 16 damage and burns for 3 damage a second for 3 seconds.",
	},
	{
		id = "scattershot",
		name = "Scattershot",
		path = "Ember",
		unlockLevel = 10,
		cooldown = 7,
		kind = "shot",
		range = 30,
		damage = 8,
		shots = 5,
		spread = 40,
		description = "Fire five sparks in a 40 degree fan, each dealing 8 damage up to 30 studs.",
	},
	{
		id = "ashfield",
		name = "Ashfield",
		path = "Ember",
		unlockLevel = 18,
		cooldown = 15,
		kind = "zone",
		zone = { radius = 8, duration = 5, dps = 7, ahead = 25 },
		description = "Scorch the ground 25 studs ahead; enemies inside take 7 damage a second for 5 seconds.",
	},
	-- Mire
	{
		id = "bog_snare",
		name = "Bog Snare",
		path = "Mire",
		unlockLevel = 3,
		cooldown = 9,
		kind = "shot",
		range = 30,
		damage = 6,
		root = 1.5,
		description = "Fire a snare up to 30 studs that deals 6 damage and roots the target for 1.5 seconds.",
	},
	{
		id = "sinking_field",
		name = "Sinking Field",
		path = "Mire",
		unlockLevel = 10,
		cooldown = 14,
		kind = "zone",
		zone = { radius = 10, duration = 4, dps = 3, slow = 0.5, ahead = 0 },
		description = "Turn the ground around you to mud for 4 seconds, slowing enemies by half and dealing 3 damage a second.",
	},
	{
		id = "undertow",
		name = "Undertow",
		path = "Mire",
		unlockLevel = 18,
		cooldown = 12,
		kind = "shot",
		range = 25,
		damage = 10,
		pull = 4,
		slow = { factor = 0.7, duration = 2 },
		description = "Hit an enemy up to 25 studs for 10 damage, pull them to 4 studs in front of you and slow them for 2 seconds.",
	},
	-- Mend
	{
		id = "siphon",
		name = "Siphon",
		path = "Mend",
		unlockLevel = 3,
		cooldown = 6,
		kind = "melee",
		range = 8,
		damage = 14,
		heal = 14,
		healOnHit = true,
		description = "Strike for 14 damage and heal 14 health if it hits.",
	},
	{
		id = "ward",
		name = "Ward",
		path = "Mend",
		unlockLevel = 10,
		cooldown = 14,
		kind = "self",
		shield = { amount = 30, duration = 6 },
		allyRadius = 15,
		description = "Shield yourself and allies within 15 studs against 30 damage for 6 seconds.",
	},
	{
		id = "renewal",
		name = "Renewal",
		path = "Mend",
		unlockLevel = 18,
		cooldown = 18,
		kind = "self",
		heal = 35,
		cleanse = true,
		allyRadius = 15,
		description = "Heal yourself and allies within 15 studs for 35 health and remove slow, root and burn.",
	},
	-- Bulwark
	{
		id = "shield_bash",
		name = "Shield Bash",
		path = "Bulwark",
		unlockLevel = 3,
		cooldown = 7,
		kind = "melee",
		range = 8,
		damage = 14,
		knockback = 10,
		reduction = { factor = 0.6, duration = 2 },
		description = "Strike for 14 damage, knock the enemy back 10 studs and take 40% less damage for 2 seconds.",
	},
	{
		id = "rebuke",
		name = "Rebuke",
		path = "Bulwark",
		unlockLevel = 10,
		cooldown = 14,
		kind = "self",
		reflect = { factor = 0.5, duration = 2 },
		description = "For 2 seconds, reflect half of the damage you take back to the attacker.",
	},
	{
		id = "challenge",
		name = "Challenge",
		path = "Bulwark",
		unlockLevel = 18,
		cooldown = 16,
		kind = "burst",
		radius = 12,
		damage = 12,
		taunt = 3,
		description = "Enemies within 12 studs take 12 damage and are forced to target you for 3 seconds.",
	},
}

local byId: { [string]: Ability } = {}
for _, ability in list do
	byId[ability.id] = ability
end

local function forPath(path: PathId): { Ability }
	local result: { Ability } = {}
	for _, ability in list do
		if ability.path == path then
			table.insert(result, ability)
		end
	end
	return result
end

return {
	list = list,
	byId = byId,
	forPath = forPath,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="5">
          <Properties>
            <string name="Name">Looks</string>
            <string name="Source"><![CDATA[--!strict
export type Look = { r: number, g: number, b: number, material: string, transparency: number }

-- material is the name of an Enum.Material item.
local function look(r: number, g: number, b: number, material: string, transparency: number?): Look
	return { r = r, g = g, b = b, material = material, transparency = transparency or 0 }
end

local byName: { [string]: Look } = {
	grass = look(86, 140, 60, "Grass"),
	thorngrass = look(52, 92, 48, "Grass"),
	slate = look(128, 136, 148, "Slate"),
	ash = look(58, 52, 50, "Basalt"),
	mud = look(84, 92, 62, "Mud"),
	shale = look(96, 104, 112, "Slate"),
	palegrass = look(150, 160, 120, "Grass"),
	gravel = look(140, 132, 120, "Pebble"),
	hedge = look(38, 84, 42, "Grass"),
	pillar = look(150, 156, 168, "Slate"),
	wall = look(120, 112, 104, "Brick"),
	roof = look(96, 84, 72, "WoodPlanks"),
	wood = look(139, 100, 60, "WoodPlanks"),
	road = look(150, 146, 140, "Cobblestone"),
	sign = look(139, 100, 60, "Wood"),
	rock = look(110, 110, 112, "Slate"),
	trunk = look(92, 64, 40, "Wood"),
	leaf = look(60, 120, 50, "Grass"),
	deadwood = look(120, 110, 100, "Wood"),
	basalt = look(40, 38, 42, "Basalt"),
	rubble = look(130, 124, 116, "Slate"),
	flower = look(200, 150, 200, "Grass"),
	reed = look(120, 130, 70, "Grass"),
	briar = look(70, 48, 60, "Grass", 0.2),
	lava = look(255, 110, 20, "Neon", 0.1),
	vent = look(255, 170, 60, "Neon", 0.6),
	bog = look(60, 70, 40, "Mud", 0.2),
	tide = look(60, 120, 200, "Glass", 0.5),
	spring = look(90, 200, 255, "Neon", 0.4),
	gust = look(220, 240, 255, "Neon", 0.85),
	rockfall = look(255, 90, 60, "Neon", 0.7),
	none = look(0, 0, 0, "SmoothPlastic", 1),
}

return {
	byName = byName,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="6">
          <Properties>
            <string name="Name">Messages</string>
            <string name="Source"><![CDATA[--!strict
local templates: { [string]: string } = {
	GOT_CARD = "You found {name}!",
	CLAIMED = "{name} claimed.",
	UNCLAIMED = "{name} moved to your free slots.",
	DISCARDED = "{name} discarded.",
	FREE_FULL = "Your free slots are full.",
	CACHE_EMPTY = "This cache is empty. It will refill soon.",
	TOO_FAR = "You are too far away.",
	ALREADY_CLAIMED = "You have already claimed that Relic.",
	NOT_CLAIMED = "You have not claimed that Relic.",
	BAD_REQUEST = "That did not work.",
	BAD_INDEX = "That did not work.",
	UNKNOWN_CARD = "That did not work.",
	SLOW_DOWN = "Slow down.",
	DATA_NOT_LOADED = "Your Ledger is still loading.",
	LEDGER_COMPLETE = "{player} has completed the Ledger!",
	SEALED = "The island has sealed this Relic. Too many are already held here.",
	LEDGER_LOCKED = "Your Ledger is locked while a claim is made against you.",
	VAULTED = "{name} is now in your Vault.",
	UNVAULTED = "{name} left your Vault.",
	VAULT_FULL = "Your Vault is full.",
	NOT_HELD = "You do not hold that Relic.",
	CROWN_NO_VAULT = "Crown Relics cannot be Vaulted.",
	ALREADY_VAULTED = "That Relic is already in your Vault.",
	NOT_VAULTED = "That Relic is not in your Vault.",
	NOT_IN_SAFE_ZONE = "You can change your Vault only in Tallyport.",
	SHIELD_SELF = "You are shielded. Drop your shield to fight.",
	TARGET_SHIELDED = "That player is shielded.",
	SAFE_ZONE = "No fighting in Tallyport.",
	SHIELD_ENDED = "Your new-player shield has ended. Other players can now attack you.",
	MARKED = "You started a fight. You are Marked for 5 minutes.",
	DEFEATED_BY = "{player} defeated you and is making a claim on your Ledger.",
	CLAIM_STARTED = "You defeated {player}. Make your claim.",
	CLAIM_COOLDOWN = "You defeated {player}, but you already claimed from them in the last hour.",
	CLAIM_TAKEN = "You took {name}!",
	CLAIM_MISS = "Nothing there.",
	CLAIM_LOST = "{player} took from you: {names}.",
	CLAIM_SAFE = "{player} took nothing from you.",
	CLAIM_OVER = "The claim is over.",
	ALREADY_PICKED = "You already picked that slot.",
	TIER_LIMIT = "You cannot take any more Relics of that rarity.",
	BAD_SLOT = "That did not work.",
	CALLING_CHOSEN = "{path} is now your Calling.",
	CALLING_CHANGED = "{path} is now your Calling.",
	CALLING_ALREADY_SET = "You already have a Calling.",
	CALLING_SAME = "That is already your Calling.",
	CALLING_COOLDOWN = "You can change your Calling again in {days} days.",
	NOT_ENOUGH_COIN = "You need {cost} Coin.",
	NO_CALLING = "Choose a Calling first.",
	LEVEL_UP = "{path} reached level {level}.",
	ABILITY_UNLOCKED = "You learned {name}!",
	LOADOUT_CHANGED = "Abilities updated.",
	LOADOUT_SAFE_ZONE = "You can change abilities only in Tallyport.",
	NOT_UNLOCKED = "You have not learned that ability yet.",
	NO_ABILITY = "Nothing is equipped in that slot.",
	ON_COOLDOWN = "That ability is not ready yet.",
	ROOTED = "You are rooted and cannot dash.",
}

local function format(code: string, args: { [string]: string }?): string
	local template = templates[code]
	if template == nil then
		return code
	end
	local values = args
	if values == nil then
		return template
	end
	local text = string.gsub(template, "{(%w+)}", function(key: string): string?
		return values[key]
	end)
	return text
end

return {
	format = format,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="7">
          <Properties>
            <string name="Name">Paths</string>
            <string name="Source"><![CDATA[--!strict
local Types = require("../Types")

type PathId = Types.PathId

local order: { PathId } = { "Fang", "Gale", "Ember", "Mire", "Mend", "Bulwark" }

local info: { [PathId]: { name: string, style: string, color: { r: number, g: number, b: number } } } =
	{
		Fang = {
			name = "Fang",
			style = "Close-range burst damage",
			color = { r = 200, g = 50, b = 50 },
		},
		Gale = { name = "Gale", style = "Speed and evasion", color = { r = 120, g = 210, b = 230 } },
		Ember = {
			name = "Ember",
			style = "Ranged and area damage",
			color = { r = 240, g = 140, b = 40 },
		},
		Mire = { name = "Mire", style = "Control", color = { r = 100, g = 140, b = 60 } },
		Mend = {
			name = "Mend",
			style = "Healing and support",
			color = { r = 240, g = 230, b = 150 },
		},
		Bulwark = {
			name = "Bulwark",
			style = "Defence and counter",
			color = { r = 90, g = 100, b = 180 },
		},
	}

local function isPath(value: any): boolean
	if type(value) ~= "string" then
		return false
	end
	for _, path in order do
		if path == value then
			return true
		end
	end
	return false
end

return {
	order = order,
	info = info,
	isPath = isPath,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="8">
          <Properties>
            <string name="Name">Regions</string>
            <string name="Source"><![CDATA[--!strict
local Types = require("../Types")

type Region = Types.Region
type RegionId = Types.RegionId

local list: { Region } = {
	{
		id = "Tallyport",
		name = "Tallyport",
		hint = "Safe ground. No fighting here.",
		ground = "grass",
		fog = { r = 200, g = 215, b = 230, start = 200, finish = 2500 },
	},
	{
		id = "CountingFields",
		name = "Counting Fields",
		hint = "Quiet fields. Nothing here will hurt you.",
		ground = "grass",
		fog = { r = 200, g = 215, b = 230, start = 200, finish = 2500 },
	},
	{
		id = "Thornwood",
		name = "Thornwood",
		hint = "A hedge maze. Briars are a shortcut that costs health.",
		bearing = 0,
		ground = "thorngrass",
		fog = { r = 60, g = 90, b = 60, start = 80, finish = 900 },
	},
	{
		id = "SquallSteps",
		name = "Squall Steps",
		hint = "Climb the pillars. Brace when the wind lanes glow.",
		bearing = 60,
		ground = "slate",
		fog = { r = 210, g = 225, b = 240, start = 300, finish = 3000 },
	},
	{
		id = "CinderFlats",
		name = "Cinder Flats",
		hint = "Vents glow before they erupt. Lava burns fast.",
		bearing = 120,
		ground = "ash",
		fog = { r = 120, g = 50, b = 30, start = 120, finish = 1200 },
	},
	{
		id = "DrownedFen",
		name = "Drowned Fen",
		hint = "Stay on the boardwalk. The bog slows and drains you.",
		bearing = 180,
		ground = "mud",
		fog = { r = 110, g = 125, b = 110, start = 30, finish = 450 },
	},
	{
		id = "ReckoningRock",
		name = "Reckoning Rock",
		hint = "The causeway floods at high tide. The Rock is safe.",
		ground = "shale",
		fog = { r = 150, g = 170, b = 190, start = 100, finish = 1500 },
	},
	{
		id = "HushGardens",
		name = "Hush Gardens",
		hint = "The blight drains you. Springs heal.",
		bearing = 240,
		ground = "palegrass",
		fog = { r = 170, g = 150, b = 190, start = 100, finish = 1000 },
	},
	{
		id = "BastionReach",
		name = "Bastion Reach",
		hint = "Rocks fall where the ground glows. Shelter under the roofs.",
		bearing = 300,
		ground = "gravel",
		fog = { r = 150, g = 150, b = 160, start = 150, finish = 1600 },
	},
}

local byId: { [string]: Region } = {}
for _, region in list do
	byId[region.id] = region
end

-- The six regions with a bearing, in bearing order (0, 60, ... 300).
local wild: { RegionId } = {
	"Thornwood",
	"SquallSteps",
	"CinderFlats",
	"DrownedFen",
	"HushGardens",
	"BastionReach",
}

return {
	list = list,
	byId = byId,
	wild = wild,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="9">
          <Properties>
            <string name="Name">Relics</string>
            <string name="Source"><![CDATA[--!strict
local Types = require("../Types")

type Relic = Types.Relic

local list: { Relic } = {
	{
		id = "R001",
		slot = 1,
		name = "Tarnished Tally-Coin",
		tier = "Copper",
		description = "The Hoarder's first earning, rubbed dull by a lifetime of being counted.",
	},
	{
		id = "R002",
		slot = 2,
		name = "Dockhand's Knot",
		tier = "Copper",
		description = "A knot the Hoarder never untied, kept in case the debt came due.",
	},
	{
		id = "R003",
		slot = 3,
		name = "Gull-Feather Quill",
		tier = "Copper",
		description = "Every entry in the Hoarder's accounts was written with this scratchy plume.",
	},
	{
		id = "R004",
		slot = 4,
		name = "Salt-Cracked Lantern",
		tier = "Copper",
		description = "The Hoarder counted coins by its light long after the oil ran out.",
	},
	{
		id = "R005",
		slot = 5,
		name = "Moneylender's Scale",
		tier = "Copper",
		description = "One pan hangs lower than the other, and the Hoarder never fixed it.",
	},
	{
		id = "R006",
		slot = 6,
		name = "Barnacle Key",
		tier = "Copper",
		description = "It opens nothing on the isle now, yet the Hoarder refused to throw it back.",
	},
	{
		id = "R007",
		slot = 7,
		name = "Bottled Squall",
		tier = "Silver",
		description = "A small storm corked tight, saved for the day a rival's ship sailed too close.",
	},
	{
		id = "R008",
		slot = 8,
		name = "Ledger-Moth Wing",
		tier = "Silver",
		description = "Pale and papery, it came from the creature that ate the Hoarder's oldest debts.",
	},
	{
		id = "R009",
		slot = 9,
		name = "Debt-Collector's Bell",
		tier = "Silver",
		description = "The Hoarder rang it at every door, and no one ever answered kindly.",
	},
	{
		id = "R010",
		slot = 10,
		name = "Gilded Anchor Link",
		tier = "Gold",
		description = "One golden link from the chain that kept the Hoarder's fortune from drifting away.",
	},
	{
		id = "R011",
		slot = 11,
		name = "Weeping Strongbox",
		tier = "Gold",
		description = "It drips seawater from every seam, as if mourning what it was made to hold.",
	},
	{
		id = "R012",
		slot = 12,
		name = "The Hoarder's Thumbprint",
		tier = "Platinum",
		description = "A single pressed mark in solid platinum, the Hoarder's seal on everything they owned.",
	},
}

local byId: { [Types.CardId]: Relic } = {}
for _, relic in list do
	byId[relic.id] = relic
end

return {
	list = list,
	byId = byId,
	count = #list,
}
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="10">
          <Properties>
            <string name="Name">SiteData</string>
