      <Item class="Folder" referent="24">
        <Properties>
          <string name="Name">Rules</string>
        </Properties>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">BlindClaim</string>
            <string name="Source"><![CDATA[--!strict
local Ledger = require("./Ledger")
local Relics = require("../Catalog/Relics")
local Types = require("../Types")

type CardId = Types.CardId
type Ledger = Types.Ledger
type Vault = Types.Vault

export type Claim = {
	picksLeft: number,
	expiresAt: number,
	taken: { [string]: number },
	picked: { [string]: string },
	takenIds: { CardId },
}

local BlindClaim = {}

BlindClaim.PICKS = 5
BlindClaim.DURATION = 30
BlindClaim.TIER_LIMIT = { Crown = 1, Platinum = 1, Gold = 2, Silver = 3, Copper = 3 }

function BlindClaim.start(now: number): Claim
	return {
		picksLeft = BlindClaim.PICKS,
		expiresAt = now + BlindClaim.DURATION,
		taken = {},
		picked = {},
		takenIds = {},
	}
end

function BlindClaim.isOpen(claim: Claim, now: number): boolean
	return claim.picksLeft > 0 and now < claim.expiresAt
end

-- Spends one pick on a slot. Refusals return the inputs untouched and spend nothing.
-- rawSlot comes straight from a client: any type, never raises.
function BlindClaim.pick(
	claim: Claim,
	victim: Ledger,
	victimVault: Vault,
	killer: Ledger,
	rawSlot: any,
	now: number
): (Claim, Ledger, Ledger, string, CardId?)
	if not BlindClaim.isOpen(claim, now) then
		return claim, victim, killer, "CLAIM_OVER"
	end
	if
		type(rawSlot) ~= "number"
		or rawSlot ~= rawSlot
		or rawSlot < 1
		or rawSlot > Relics.count
		or rawSlot ~= math.floor(rawSlot)
	then
		return claim, victim, killer, "BAD_SLOT"
	end
	local slot: number = rawSlot
	local key = tostring(slot)
	if claim.picked[key] ~= nil then
		return claim, victim, killer, "ALREADY_PICKED"
	end
	local relic = Relics.list[slot]
	local limit = BlindClaim.TIER_LIMIT[relic.tier] or 0
	if (claim.taken[relic.tier] or 0) >= limit then
		return claim, victim, killer, "TIER_LIMIT"
	end

	local result: Claim = {
		picksLeft = claim.picksLeft - 1,
		expiresAt = claim.expiresAt,
		taken = table.clone(claim.taken),
		picked = table.clone(claim.picked),
		takenIds = table.clone(claim.takenIds),
	}

	local newKiller = nil
	if Ledger.count(victim, relic.id) > 0 and victimVault[relic.id] ~= true then
		newKiller = Ledger.add(killer, relic.id)
	end
	if newKiller == nil then
		result.picked[key] = "MISS"
		return result, victim, killer, "MISS"
	end

	local newVictim: Ledger =
		{ claimed = table.clone(victim.claimed), free = table.clone(victim.free) }
	local index = table.find(newVictim.free, relic.id)
	if index ~= nil then
		table.remove(newVictim.free, index)
	else
		newVictim.claimed[relic.id] = nil
	end
	result.picked[key] = "TAKEN"
	result.taken[relic.tier] = (result.taken[relic.tier] or 0) + 1
	table.insert(result.takenIds, relic.id)
	return result, newVictim, newKiller, "TAKEN", relic.id
end

return BlindClaim
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">Casting</string>
            <string name="Source"><![CDATA[--!strict
local Abilities = require("../Catalog/Abilities")
local Combat = require("./Combat")
local PathProgress = require("./PathProgress")
local Targeting = require("./Targeting")
local Types = require("../Types")

type Vec3 = Types.Vec3
type Ability = Types.Ability
type PathProgress = Types.PathProgress
type Fighter = Combat.Fighter

export type CastState = { cooldowns: { [string]: number }, lastCast: number } -- ability id -> time it is ready
export type Hit = { targetId: number, damage: number }
export type Zone = { center: Vec3, radius: number, duration: number, dps: number, slow: number? }
export type Plan = {
	hits: { Hit },
	waves: number,
	interval: number,
	moveTo: Vec3?,
	pullTo: Vec3?,
	knockbackTo: Vec3?,
	zone: Zone?,
}

local Casting = {}

Casting.GLOBAL_GAP = 0.3

function Casting.new(): CastState
	return { cooldowns = {}, lastCast = -math.huge }
end

function Casting.canCast(
	state: CastState,
	progress: PathProgress,
	rawSlot: any,
	now: number,
	rooted: boolean
): (string?, string)
	if
		type(rawSlot) ~= "number"
		or rawSlot ~= rawSlot
		or rawSlot ~= math.floor(rawSlot)
		or rawSlot < 1
		or rawSlot > 4
	then
		return nil, "BAD_REQUEST"
	end
	local id = progress.loadout[rawSlot :: number]
	if id == nil or id == "" then
		return nil, "NO_ABILITY"
	end
	local ability = Abilities.byId[id]
	if ability == nil or table.find(PathProgress.unlocked(progress), id) == nil then
		return nil, "NOT_UNLOCKED"
	end
	-- Written so NaN fails safe: only a clearly elapsed time passes.
	local readyAt = state.cooldowns[id] or -math.huge
	if not (now >= readyAt) or not (now - state.lastCast >= Casting.GLOBAL_GAP) then
		return nil, "ON_COOLDOWN"
	end
	if rooted and ability.kind == "dash" then
		return nil, "ROOTED"
	end
	return id, "OK"
end

function Casting.commit(state: CastState, abilityId: string, now: number): CastState
	local cooldowns = table.clone(state.cooldowns)
	local ability = Abilities.byId[abilityId]
	if ability ~= nil then
		cooldowns[abilityId] = now + ability.cooldown
	end
	return { cooldowns = cooldowns, lastCast = now }
end

local function fighterById(others: { Fighter }, id: number): Fighter?
	for _, other in others do
		if other.id == id then
			return other
		end
	end
	return nil
end

local function emptyPlan(): Plan
	return { hits = {}, waves = 1, interval = 0 }
end

local function planMelee(
	ability: Ability,
	caster: Fighter,
	others: { Fighter },
	taunter: number?
): Plan
	local plan = emptyPlan()
	plan.waves = ability.hits or 1
	plan.interval = ability.interval or 0
	local targetId = Combat.pickTarget(caster, others, ability.range, taunter)
	if targetId == nil then
		return plan
	end
	local target = fighterById(others, targetId)
	local damage = ability.damage or 0
	if
		target ~= nil
		and target.health ~= nil
		and ability.executeBelow ~= nil
		and ability.executeDamage ~= nil
		and target.health <= ability.executeBelow
	then
		damage = ability.executeDamage
	end
	table.insert(plan.hits, { targetId = targetId, damage = damage })
	if target ~= nil and ability.knockback ~= nil then
		local lx, lz = caster.look.x, caster.look.z
		local length = math.sqrt(lx * lx + lz * lz)
		if length > 0 and length < math.huge then
			plan.knockbackTo = {
				x = target.position.x + lx / length * ability.knockback,
				y = target.position.y,
				z = target.position.z + lz / length * ability.knockback,
			}
		end
	end
	return plan
end

local function planShot(
	ability: Ability,
	caster: Fighter,
	others: { Fighter },
	taunter: number?
): Plan
	local plan = emptyPlan()
	local shots = ability.shots or 1
	local spread = ability.spread or 0
	for i = 1, shots do
		local angle = 0
		if shots > 1 then
			angle = -spread / 2 + spread * (i - 1) / (shots - 1)
		end
		local targetId = Targeting.shot(caster, others, ability.range or 0, angle, taunter)
		if targetId ~= nil then
			table.insert(plan.hits, { targetId = targetId, damage = ability.damage or 0 })
		end
	end
	if ability.pull ~= nil then
		plan.pullTo = Targeting.ahead(caster, ability.pull)
	end
	return plan
end

function Casting.plan(
	ability: Ability,
	caster: Fighter,
	others: { Fighter },
	taunter: number?
): Plan
	local kind = ability.kind
	if kind == "melee" then
		return planMelee(ability, caster, others, taunter)
	elseif kind == "shot" then
		return planShot(ability, caster, others, taunter)
	end
	local plan = emptyPlan()
	if kind == "dash" then
		local distance = ability.distance or 0
		plan.moveTo = Targeting.ahead(caster, distance)
		local targetId = Targeting.dashHit(caster, others, distance)
		if targetId ~= nil then
			table.insert(plan.hits, { targetId = targetId, damage = ability.damage or 0 })
		end
	elseif kind == "zone" and ability.zone ~= nil then
		local z = ability.zone
		plan.zone = {
			center = Targeting.ahead(caster, z.ahead),
			radius = z.radius,
			duration = z.duration,
			dps = z.dps,
			slow = z.slow,
		}
	elseif kind == "burst" then
		for _, id in Targeting.inRadius(caster.position, others, ability.radius or 0, caster.id) do
			table.insert(plan.hits, { targetId = id, damage = ability.damage or 0 })
		end
	end
	return plan
end

return Casting
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">ClaimView</string>
            <string name="Source"><![CDATA[--!strict
local BlindClaim = require("./BlindClaim")
local Relics = require("../Catalog/Relics")
local Types = require("../Types")

type Tier = Types.Tier

export type SlotView = {
	slot: number,
	label: string,
	name: string,
	tier: Tier,
	state: "open" | "taken" | "miss" | "locked",
}
export type View = {
	title: string,
	picksText: string,
	secondsLeft: number,
	open: boolean,
	slots: { SlotView },
}

local ClaimView = {}

-- Turns a claim into display data. Pure: slot contents stay hidden, only outcomes show.
function ClaimView.build(victimName: string, claim: BlindClaim.Claim, now: number): View
	local open = BlindClaim.isOpen(claim, now)
	local slots: { SlotView } = {}
	for _, relic in Relics.list do
		local outcome = claim.picked[tostring(relic.slot)]
		local state: "open" | "taken" | "miss" | "locked"
		if outcome == "TAKEN" then
			state = "taken"
		elseif outcome == "MISS" then
			state = "miss"
		elseif
			not open
			or (claim.taken[relic.tier] or 0) >= (BlindClaim.TIER_LIMIT[relic.tier] or 0)
		then
			state = "locked"
		else
			state = "open"
		end
		table.insert(slots, {
			slot = relic.slot,
			label = string.format("%03d", relic.slot),
			name = relic.name,
			tier = relic.tier,
			state = state,
		})
	end
	return {
		title = `Claim on {victimName}`,
		picksText = `Picks left: {claim.picksLeft}`,
		secondsLeft = math.max(0, math.ceil(claim.expiresAt - now)),
		open = open,
		slots = slots,
	}
end

return ClaimView
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">Combat</string>
            <string name="Source"><![CDATA[--!strict
local Types = require("../Types")

type Vec3 = Types.Vec3

export type Fighter = { id: number, position: Vec3, look: Vec3, health: number? }
-- key: tostring(victim id)
export type HitLog = { [string]: { attackerId: number, at: number } }

local Combat = {}

Combat.MAX_HEALTH = 100
Combat.STRIKE_DAMAGE = 20
Combat.STRIKE_COOLDOWN = 0.8
Combat.STRIKE_RANGE = 8
Combat.STRIKE_MIN_DOT = 0.5 -- target must be within 60 degrees of straight ahead
Combat.STRIKE_MAX_HEIGHT = 6 -- maximum vertical gap
Combat.KILL_CREDIT_SECONDS = 15
Combat.COMBAT_LOG_SECONDS = 30

function Combat.canStrike(lastStrikeAt: number?, now: number): boolean
	return lastStrikeAt == nil or now - lastStrikeAt >= Combat.STRIKE_COOLDOWN
end

-- Distance and direction ignore the y axis. Returns the id of the nearest fighter in reach and arc.
-- range defaults to STRIKE_RANGE. A taunter that passes every check wins over a nearer fighter.
function Combat.pickTarget(
	attacker: Fighter,
	others: { Fighter },
	range: number?,
	taunter: number?
): number?
	local lookLength =
		math.sqrt(attacker.look.x * attacker.look.x + attacker.look.z * attacker.look.z)
	if not (lookLength > 0 and lookLength < math.huge) then
		return nil
	end
	local lookX = attacker.look.x / lookLength
	local lookZ = attacker.look.z / lookLength

	local reach = range or Combat.STRIKE_RANGE
	local bestId: number? = nil
	local bestDistance = math.huge
	for _, other in others do
		if other.id == attacker.id then
			continue
		end
		if not (math.abs(other.position.y - attacker.position.y) <= Combat.STRIKE_MAX_HEIGHT) then
			continue
		end
		local dx = other.position.x - attacker.position.x
		local dz = other.position.z - attacker.position.z
		local distance = math.sqrt(dx * dx + dz * dz)
		if not (distance <= reach) then
			continue
		end
		-- Standing on the attacker counts as in the arc.
		if not (distance == 0 or (dx * lookX + dz * lookZ) / distance >= Combat.STRIKE_MIN_DOT) then
			continue
		end
		if taunter ~= nil and other.id == taunter then
			return other.id
		end
		if distance < bestDistance then
			bestDistance = distance
			bestId = other.id
		end
	end
	return bestId
end

function Combat.recordHit(log: HitLog, victimId: number, attackerId: number, now: number): HitLog
	local newLog = table.clone(log)
	newLog[tostring(victimId)] = { attackerId = attackerId, at = now }
	return newLog
end

function Combat.creditFor(
	log: HitLog,
	victimId: number,
	now: number,
	windowSeconds: number
): number?
	local entry = log[tostring(victimId)]
	if entry ~= nil and now - entry.at <= windowSeconds then
		return entry.attackerId
	end
	return nil
end

function Combat.clear(log: HitLog, victimId: number): HitLog
	local newLog = table.clone(log)
	newLog[tostring(victimId)] = nil
	return newLog
end

return Combat
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">Effects</string>
            <string name="Source"><![CDATA[--!strict
-- Pure status-effect rules. Every "until" is exclusive: active while now < until.
-- Comparisons are written so a NaN time reads as "not active" and never grants anything.
export type Status = {
	immuneUntil: number,
	reduceUntil: number,
	reduceFactor: number,
	shield: number,
	shieldUntil: number,
	reflectUntil: number,
	reflectFactor: number,
	slowUntil: number,
	slowFactor: number,
	rootUntil: number,
	burnUntil: number,
	burnDps: number,
	burnBy: number,
	tauntUntil: number,
	tauntBy: number,
	empowerUntil: number,
	empowerBonus: number,
}

local Effects = {}

function Effects.new(): Status
	return {
		immuneUntil = 0,
		reduceUntil = 0,
		reduceFactor = 1,
		shield = 0,
		shieldUntil = 0,
		reflectUntil = 0,
		reflectFactor = 1,
		slowUntil = 0,
		slowFactor = 1,
		rootUntil = 0,
		burnUntil = 0,
		burnDps = 0,
		burnBy = 0,
		tauntUntil = 0,
		tauntBy = 0,
		empowerUntil = 0,
		empowerBonus = 0,
	}
end

function Effects.isImmune(s: Status, now: number): boolean
	return now < s.immuneUntil
end

function Effects.resolveDamage(s: Status, amount: number, now: number): (Status, number, number)
	-- Written positively so NaN, zero, negative and infinite amounts all fall out as no damage.
	if not (amount > 0 and amount < math.huge) then
		return s, 0, 0
	end
	if now < s.immuneUntil then
		return s, 0, 0
	end
	local after = amount
	if now < s.reduceUntil then
		after = amount * s.reduceFactor
	end
	local reflected = 0
	if now < s.reflectUntil then
		reflected = after * s.reflectFactor
	end
	local health = after
	local out = s
	if now < s.shieldUntil and s.shield > 0 then
		local absorbed = math.min(after, s.shield)
		health = after - absorbed
		out = table.clone(s)
		out.shield = s.shield - absorbed
	end
	-- A NaN factor would poison the result; fail to zero rather than to extra damage.
	if not (health >= 0) then
		health = 0
	end
	if not (reflected >= 0) then
		reflected = 0
	end
	return out, health, reflected
end

function Effects.applyImmune(s: Status, duration: number, now: number): Status
	local out = table.clone(s)
	out.immuneUntil = now + duration
	return out
end

function Effects.applyReduction(s: Status, factor: number, duration: number, now: number): Status
	local out = table.clone(s)
	out.reduceFactor = factor
	out.reduceUntil = now + duration
	return out
end

-- Replaces any current shield.
function Effects.applyShield(s: Status, amount: number, duration: number, now: number): Status
	local out = table.clone(s)
	out.shield = amount
	out.shieldUntil = now + duration
	return out
end

function Effects.applyReflect(s: Status, factor: number, duration: number, now: number): Status
	local out = table.clone(s)
	out.reflectFactor = factor
	out.reflectUntil = now + duration
	return out
end

-- Strongest (lowest factor) slow wins. An equal or stronger one replaces and refreshes;
-- a weaker one neither replaces nor extends the active slow.
function Effects.applySlow(s: Status, factor: number, duration: number, now: number): Status
	local out = table.clone(s)
	-- A NaN factor is rejected (it would otherwise read as stronger than anything).
	if not (factor >= 0) then
		return out
	end
	if now < s.slowUntil and not (factor <= s.slowFactor) then
		return out
	end
	out.slowFactor = factor
	out.slowUntil = now + duration
	return out
end

function Effects.applyRoot(s: Status, duration: number, now: number): Status
	local out = table.clone(s)
	out.rootUntil = now + duration
	return out
end

function Effects.applyBurn(
	s: Status,
	dps: number,
	duration: number,
	byId: number,
	now: number
): Status
	local out = table.clone(s)
	out.burnDps = dps
	out.burnBy = byId
	out.burnUntil = now + duration
	return out
end

function Effects.applyTaunt(s: Status, byId: number, duration: number, now: number): Status
	local out = table.clone(s)
	out.tauntBy = byId
	out.tauntUntil = now + duration
	return out
end

function Effects.applyEmpower(s: Status, bonus: number, duration: number, now: number): Status
	local out = table.clone(s)
	out.empowerBonus = bonus
	out.empowerUntil = now + duration
	return out
end

-- Clears slow, root and burn.
function Effects.cleanse(s: Status): Status
	local out = table.clone(s)
	out.slowUntil = 0
	out.slowFactor = 1
	out.rootUntil = 0
	out.burnUntil = 0
	out.burnDps = 0
	out.burnBy = 0
	return out
end

function Effects.isRooted(s: Status, now: number): boolean
	return now < s.rootUntil
end

function Effects.speedFactor(s: Status, now: number): number
	if now < s.rootUntil then
		return 0
	end
	if now < s.slowUntil then
		return s.slowFactor
	end
	return 1
end

function Effects.burnTick(s: Status, now: number): (number, number)
	if now < s.burnUntil then
		return s.burnDps, s.burnBy
	end
	return 0, 0
end

function Effects.tauntedBy(s: Status, now: number): number?
	if now < s.tauntUntil then
		return s.tauntBy
	end
	return nil
end

-- Returns the bonus while active and consumes it.
function Effects.takeEmpower(s: Status, now: number): (Status, number)
	if now < s.empowerUntil then
		local out = table.clone(s)
		out.empowerUntil = 0
		out.empowerBonus = 0
		return out, s.empowerBonus
	end
	return s, 0
end

return Effects
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">Geography</string>
            <string name="Source"><![CDATA[--!strict
local Types = require("../Types")
local Regions = require("../Catalog/Regions")

export type Strip = { z: number, x1: number, x2: number, region: Types.RegionId }
export type Bridge = { x: number, z: number, yaw: number, length: number, width: number }

local Geography = {}

Geography.CELL = 40
Geography.GRID = 34
Geography.TOWN_RADIUS = 40
Geography.FIELDS_RADIUS = 260
Geography.DROWN_Y = -6
Geography.ROCK = { x = 0, z = 1240, radius = 80 }

local CELL = Geography.CELL
local GRID = Geography.GRID
local ROCK = Geography.ROCK
local CAUSEWAY_MIN_Z = 940
local CAUSEWAY_MAX_Z = 1160
local RIVER_BEARINGS = { 30, 150, 270 }
local RIVER_START = 300
local RIVER_HALF_WIDTH = 50
local BRIDGE_ALONG = { 420, 760 }
local BRIDGE_LENGTH = 180
local BRIDGE_WIDTH = 16

local function isFinite(n: number): boolean
	return n > -math.huge and n < math.huge
end

-- Degrees clockwise from north (-Z), in [0, 360). The centre has no direction and reads as 0.
function Geography.bearingOf(x: number, z: number): number
	if x == 0 and z == 0 then
		return 0
	end
	local b = math.deg(math.atan2(x, -z))
	if b < 0 then
		b += 360
		-- A tiny negative angle rounds up to exactly 360.
		if b >= 360 then
			b = 0
		end
	end
	return b
end

function Geography.coastRadius(bearing: number): number
	local t = math.rad(bearing)
	return 960 + 60 * math.sin(3 * t) + 40 * math.sin(5 * t + 1)
end

-- World x, z to a region frame: distance down the bearing, distance to the right of it.
function Geography.toFrame(bearing: number, x: number, z: number): (number, number)
	local t = math.rad(bearing)
	local s, c = math.sin(t), math.cos(t)
	return x * s - z * c, x * c + z * s
end

function Geography.fromFrame(bearing: number, along: number, across: number): (number, number)
	local t = math.rad(bearing)
	local s, c = math.sin(t), math.cos(t)
	return along * s + across * c, -along * c + across * s
end

local function bearingOfRegion(regionId: string): number
	local region = Regions.byId[regionId]
	local bearing = if region then region.bearing else nil
	if bearing == nil then
		error(`Geography: region {regionId} has no bearing`)
	end
	return bearing
end

function Geography.place(regionId: string, along: number, across: number): (number, number)
	return Geography.fromFrame(bearingOfRegion(regionId), along, across)
end

function Geography.cellOf(x: number, z: number): (number, number)
	return math.floor(x / CELL + 0.5), math.floor(z / CELL + 0.5)
end

-- The region owning cell (i, j), judged at the cell centre. Tallyport is not a cell region:
-- its circle is smaller than a cell and regionAt answers for it.
function Geography.cellRegion(i: number, j: number): Types.RegionId
	local x, z = CELL * i, CELL * j
	local rx, rz = x - ROCK.x, z - ROCK.z
	if rx * rx + rz * rz <= ROCK.radius * ROCK.radius then
		return "ReckoningRock"
	end
	if i == 0 and CAUSEWAY_MIN_Z <= z and z <= CAUSEWAY_MAX_Z then
		return "ReckoningRock"
	end
	if math.sqrt(x * x + z * z) <= Geography.FIELDS_RADIUS then
		return "CountingFields"
	end
	return Regions.wild[math.floor((Geography.bearingOf(x, z) + 30) / 60) % 6 + 1]
end

function Geography.cellIsLand(i: number, j: number): boolean
	if math.abs(i) > GRID or math.abs(j) > GRID then
		return false
	end
	if Geography.cellRegion(i, j) == "ReckoningRock" then
		return true
	end
	local x, z = CELL * i, CELL * j
	if math.sqrt(x * x + z * z) > Geography.coastRadius(Geography.bearingOf(x, z)) then
		return false
	end
	for _, bearing in RIVER_BEARINGS do
		local along, across = Geography.toFrame(bearing, x, z)
		if along >= RIVER_START and math.abs(across) < RIVER_HALF_WIDTH then
			return false
		end
	end
	return true
end

-- A position that is not a finite number reads as Counting Fields.
function Geography.regionAt(x: number, z: number): Types.RegionId
	if not (isFinite(x) and isFinite(z)) then
		return "CountingFields"
	end
	if x * x + z * z <= Geography.TOWN_RADIUS * Geography.TOWN_RADIUS then
		return "Tallyport"
	end
	return Geography.cellRegion(Geography.cellOf(x, z))
end

function Geography.isLand(x: number, z: number): boolean
	if not (isFinite(x) and isFinite(z)) then
		return false
	end
	return Geography.cellIsLand(Geography.cellOf(x, z))
end

-- Every land cell exactly once, as horizontal runs of one region: row z = 40j, from x1 to x2.
function Geography.strips(): { Strip }
	local strips: { Strip } = {}
	for j = -GRID, GRID do
		local runStart: number? = nil
		local runRegion: Types.RegionId = "CountingFields"
		-- One cell past the grid is never land, so it closes a run that reaches the edge.
		for i = -GRID, GRID + 1 do
			local region = if Geography.cellIsLand(i, j) then Geography.cellRegion(i, j) else nil
			if runStart ~= nil and region ~= runRegion then
				table.insert(strips, {
					z = CELL * j,
					x1 = CELL * runStart - CELL / 2,
					x2 = CELL * (i - 1) + CELL / 2,
					region = runRegion,
				})
				runStart = nil
			end
			if region ~= nil and runStart == nil then
				runStart = i
				runRegion = region
			end
		end
	end
	return strips
end

-- One bridge over each river at 420 and 760 out, lying across the river.
function Geography.bridges(): { Bridge }
	local bridges: { Bridge } = {}
	for _, bearing in RIVER_BEARINGS do
		for _, along in BRIDGE_ALONG do
			local x, z = Geography.fromFrame(bearing, along, 0)
			table.insert(bridges, {
				x = x,
				z = z,
				yaw = (bearing + 90) % 360,
				length = BRIDGE_LENGTH,
				width = BRIDGE_WIDTH,
			})
		end
	end
	return bridges
end

function Geography.circle(
	regionId: string,
	along: number,
	across: number,
	radius: number
): Types.Shape
	local x, z = Geography.place(regionId, along, across)
	return {
		kind = "circle",
		x = x,
		z = z,
		radius = radius,
		bearing = 0,
		halfAlong = 0,
		halfAcross = 0,
		region = "",
	}
end

function Geography.rect(
	regionId: string,
	a1: number,
	a2: number,
	c1: number,
	c2: number
): Types.Shape
	local x, z = Geography.place(regionId, (a1 + a2) / 2, (c1 + c2) / 2)
	return {
		kind = "rect",
		x = x,
		z = z,
		radius = 0,
		bearing = bearingOfRegion(regionId),
		halfAlong = (a2 - a1) / 2,
		halfAcross = (c2 - c1) / 2,
		region = "",
	}
end

-- Everything of the region at least minRadius from the island centre.
function Geography.regionShape(regionId: string, minRadius: number): Types.Shape
	return {
		kind = "region",
		x = 0,
		z = 0,
		radius = minRadius,
		bearing = 0,
		halfAlong = 0,
		halfAcross = 0,
		region = regionId,
	}
end

return Geography
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">Hazards</string>
            <string name="Source"><![CDATA[--!strict
local Geography = require("./Geography")
local Types = require("../Types")

export type Phase = "idle" | "warn" | "active"
export type Burst = { id: string, damage: number, cycle: number }
export type Sample = {
	dps: number,
	heal: number,
	slow: number, -- smallest speed multiplier in effect; 1 when none
	pushX: number,
	pushZ: number,
	bursts: { Burst },
	names: { string },
}

local Hazards = {}

Hazards.TICK_SECONDS = 0.25
Hazards.SLOW_SECONDS = 1

local function isFinite(n: number): boolean
	return n > -math.huge and n < math.huge
end

-- A point that is not a finite number is inside nothing.
function Hazards.contains(shape: Types.Shape, x: number, z: number): boolean
	if not (isFinite(x) and isFinite(z)) then
		return false
	end
	if shape.kind == "circle" then
		local dx, dz = x - shape.x, z - shape.z
		return dx * dx + dz * dz <= shape.radius * shape.radius
	elseif shape.kind == "rect" then
		local along, across = Geography.toFrame(shape.bearing, x - shape.x, z - shape.z)
		return math.abs(along) <= shape.halfAlong and math.abs(across) <= shape.halfAcross
	elseif shape.kind == "region" then
		return Geography.regionAt(x, z) == shape.region and math.sqrt(x * x + z * z) >= shape.radius
	end
	return false
end

-- Inside the shape and inside none of its holes.
function Hazards.affects(hazard: Types.Hazard, x: number, z: number): boolean
	if not Hazards.contains(hazard.shape, x, z) then
		return false
	end
	if hazard.holes then
		for _, hole in hazard.holes do
			if Hazards.contains(hole, x, z) then
				return false
			end
		end
	end
	return true
end

-- The phase, the cycle index, and the fraction of the current phase already elapsed (0..1).
function Hazards.phase(hazard: Types.Hazard, now: number): (Phase, number, number)
	local cycle = hazard.cycle
	if cycle == nil then
		return "active", 0, 0
	end
	if not isFinite(now) then
		return "idle", 0, 0
	end
	local shifted = now + cycle.offset
	local t = shifted % cycle.period
	local index = math.floor(shifted / cycle.period)
	local idle = cycle.period - cycle.warn - cycle.active
	if t < idle then
		return "idle", index, t / idle
	elseif t < idle + cycle.warn then
		return "warn", index, (t - idle) / cycle.warn
	end
	return "active", index, math.min((t - idle - cycle.warn) / cycle.active, 1)
end

-- The combined effect on a point at time now. Only active hazards that affect the point count.
function Hazards.sample(list: { Types.Hazard }, x: number, z: number, now: number): Sample
	local sample: Sample = {
		dps = 0,
		heal = 0,
		slow = 1,
		pushX = 0,
		pushZ = 0,
		bursts = {},
		names = {},
	}
	for _, hazard in list do
		if Hazards.affects(hazard, x, z) then
			local phase, index = Hazards.phase(hazard, now)
			if phase == "active" then
				sample.dps += hazard.dps or 0
				sample.heal += hazard.heal or 0
				if hazard.slow ~= nil then
					sample.slow = math.min(sample.slow, hazard.slow)
				end
				if hazard.push ~= nil then
					sample.pushX += hazard.push.x
					sample.pushZ += hazard.push.z
				end
				if hazard.damage ~= nil then
					table.insert(
						sample.bursts,
						{ id = hazard.id, damage = hazard.damage, cycle = index }
					)
				end
				if not table.find(sample.names, hazard.name) then
					table.insert(sample.names, hazard.name)
				end
			end
		end
	end
	return sample
end

return Hazards
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">Ledger</string>
            <string name="Source"><![CDATA[--!strict
local Relics = require("../Catalog/Relics")
local Types = require("../Types")

type CardId = Types.CardId
type Ledger = Types.Ledger

local Ledger = {}

Ledger.FREE_SLOTS = 20

local function copy(ledger: Ledger): Ledger
	return { claimed = table.clone(ledger.claimed), free = table.clone(ledger.free) }
end

local function validIndex(ledger: Ledger, index: number): boolean
	return index == math.floor(index) and index >= 1 and index <= #ledger.free
end

function Ledger.new(): Ledger
	return { claimed = {}, free = {} }
end

function Ledger.add(ledger: Ledger, cardId: CardId): (Ledger?, string?)
	if Relics.byId[cardId] == nil then
		return nil, "UNKNOWN_CARD"
	end
	if #ledger.free >= Ledger.FREE_SLOTS then
		return nil, "FREE_FULL"
	end
	local result = copy(ledger)
	table.insert(result.free, cardId)
	return result
end

function Ledger.claim(ledger: Ledger, freeIndex: number): (Ledger?, string?)
	if not validIndex(ledger, freeIndex) then
		return nil, "BAD_INDEX"
	end
	local cardId = ledger.free[freeIndex]
	if ledger.claimed[cardId] then
		return nil, "ALREADY_CLAIMED"
	end
	local result = copy(ledger)
	table.remove(result.free, freeIndex)
	result.claimed[cardId] = true
	return result
end

function Ledger.unclaim(ledger: Ledger, cardId: CardId): (Ledger?, string?)
	if not ledger.claimed[cardId] then
		return nil, "NOT_CLAIMED"
	end
	if #ledger.free >= Ledger.FREE_SLOTS then
		return nil, "FREE_FULL"
	end
	local result = copy(ledger)
	result.claimed[cardId] = nil
	table.insert(result.free, cardId)
	return result
end

function Ledger.discard(ledger: Ledger, freeIndex: number): (Ledger?, string?)
	if not validIndex(ledger, freeIndex) then
		return nil, "BAD_INDEX"
	end
	local result = copy(ledger)
	table.remove(result.free, freeIndex)
	return result
end

function Ledger.count(ledger: Ledger, cardId: CardId): number
	local total = if ledger.claimed[cardId] then 1 else 0
	for _, id in ledger.free do
		if id == cardId then
			total += 1
		end
	end
	return total
end

function Ledger.claimedCount(ledger: Ledger): number
	local total = 0
	for _, value in ledger.claimed do
		if value then
			total += 1
		end
	end
	return total
end

function Ledger.isComplete(ledger: Ledger): boolean
	for _, relic in Relics.list do
		if not ledger.claimed[relic.id] then
			return false
		end
	end
	return true
end

-- Turns arbitrary saved data into a valid Ledger. Never errors.
function Ledger.sanitize(raw: any): Ledger
	local result = Ledger.new()
	if type(raw) ~= "table" then
		return result
	end
	local rawClaimed = raw.claimed
	if type(rawClaimed) == "table" then
		for key, value in rawClaimed do
			if type(key) == "string" and Relics.byId[key] ~= nil and value == true then
				result.claimed[key] = true
			end
		end
	end
	local rawFree = raw.free
	if type(rawFree) == "table" then
		for i = 1, #rawFree do
			if #result.free >= Ledger.FREE_SLOTS then
				break
			end
			local id = rawFree[i]
			if type(id) == "string" and Relics.byId[id] ~= nil then
				table.insert(result.free, id)
			end
		end
	end
	return result
end

return Ledger
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">LedgerActions</string>
            <string name="Source"><![CDATA[--!strict
local Ledger = require("./Ledger")
local Types = require("../Types")

type CardId = Types.CardId
type Ledger = Types.Ledger

local MAX_CARD_ID_LENGTH = 16

local LedgerActions = {}

-- Validates a raw client request and applies it to the ledger.
-- Request shapes:
--   { kind = "claim" | "discard", freeIndex = number, cardId = string }
--   { kind = "unclaim", cardId = string }
-- claim and discard carry the card the player saw on that row; if the free list has
-- shifted (a double click), the card at freeIndex differs and the request is BAD_INDEX.
-- Success: new ledger, "CLAIMED" | "UNCLAIMED" | "DISCARDED", affected card id.
-- Failure: nil, error code, nil. Never errors on hostile input.
function LedgerActions.apply(ledger: Ledger?, raw: any): (Ledger?, string, CardId?)
	if ledger == nil then
		return nil, "DATA_NOT_LOADED", nil
	end
	if type(raw) ~= "table" then
		return nil, "BAD_REQUEST", nil
	end
	local kind = raw.kind
	if kind == "claim" or kind == "discard" then
		local freeIndex = raw.freeIndex
		if type(freeIndex) ~= "number" then
			return nil, "BAD_REQUEST", nil
		end
		local shownCardId = raw.cardId
		if type(shownCardId) ~= "string" or #shownCardId > MAX_CARD_ID_LENGTH then
			return nil, "BAD_REQUEST", nil
		end
		local cardId = ledger.free[freeIndex]
		if cardId ~= shownCardId then
			return nil, "BAD_INDEX", nil
		end
		local result, err
		if kind == "claim" then
			result, err = Ledger.claim(ledger, freeIndex)
		else
			result, err = Ledger.discard(ledger, freeIndex)
		end
		if result == nil then
			return nil, err or "BAD_REQUEST", nil
		end
		return result, if kind == "claim" then "CLAIMED" else "DISCARDED", cardId
	elseif kind == "unclaim" then
		local cardId = raw.cardId
		if type(cardId) ~= "string" or #cardId > MAX_CARD_ID_LENGTH then
			return nil, "BAD_REQUEST", nil
		end
		local result, err = Ledger.unclaim(ledger, cardId)
		if result == nil then
			return nil, err or "BAD_REQUEST", nil
		end
		return result, "UNCLAIMED", cardId
	end
	return nil, "BAD_REQUEST", nil
end

return LedgerActions
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">LedgerView</string>
            <string name="Source"><![CDATA[--!strict
local Ledger = require("./Ledger")
local Relics = require("../Catalog/Relics")
local Vault = require("./Vault")
local Types = require("../Types")

type CardId = Types.CardId
type Tier = Types.Tier
type Ledger = Types.Ledger
type Vault = Types.Vault

export type SlotView = {
	slot: number,
	label: string,
	cardId: CardId,
	name: string,
	tier: Tier,
	claimed: boolean,
	spares: number,
	vaulted: boolean,
	canVault: boolean,
}
export type FreeView =
	{ index: number, cardId: CardId, name: string, tier: Tier, canClaim: boolean }
export type View = {
	progressText: string,
	freeText: string,
	vaultText: string,
	complete: boolean,
	slots: { SlotView },
	free: { FreeView },
}

local LedgerView = {}

-- Turns a Ledger into display data. Pure: the client renders this and nothing else.
function LedgerView.build(ledger: Ledger, vault: Vault?): View
	local vaulted: Vault = vault or {}
	local spares: { [CardId]: number } = {}
	for _, cardId in ledger.free do
		spares[cardId] = (spares[cardId] or 0) + 1
	end

	local slots: { SlotView } = {}
	for _, relic in Relics.list do
		table.insert(slots, {
			slot = relic.slot,
			label = string.format("%03d", relic.slot),
			cardId = relic.id,
			name = relic.name,
			tier = relic.tier,
			claimed = ledger.claimed[relic.id] == true,
			spares = spares[relic.id] or 0,
			vaulted = vaulted[relic.id] == true,
			canVault = Ledger.count(ledger, relic.id) > 0
				and relic.tier ~= "Crown"
				and vaulted[relic.id] ~= true,
		})
	end

	local free: { FreeView } = {}
	for index, cardId in ledger.free do
		local relic = Relics.byId[cardId]
		if relic ~= nil then
			table.insert(free, {
				index = index,
				cardId = cardId,
				name = relic.name,
				tier = relic.tier,
				canClaim = ledger.claimed[cardId] ~= true,
			})
		end
	end

	return {
		progressText = `{Ledger.claimedCount(ledger)} / {Relics.count}`,
		freeText = `{#ledger.free} / {Ledger.FREE_SLOTS}`,
		vaultText = `{Vault.size(vaulted)} / {Vault.MAX}`,
		complete = Ledger.isComplete(ledger),
		slots = slots,
		free = free,
	}
end

return LedgerView
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">Loadout</string>
            <string name="Source"><![CDATA[--!strict
local Abilities = require("../Catalog/Abilities")
local PathProgress = require("./PathProgress")
local Types = require("../Types")

type PathProgress = Types.PathProgress

local MAX_ABILITY_ID_LENGTH = 16

local Loadout = {}

Loadout.SLOTS = 4

local function copy(progress: PathProgress): PathProgress
	return {
		calling = progress.calling,
		xp = table.clone(progress.xp),
		loadout = table.clone(progress.loadout),
		callingChanges = progress.callingChanges,
		callingChangedAt = progress.callingChangedAt,
	}
end

-- request: { slot = number, abilityId = string }; "" clears the slot.
function Loadout.apply(
	progress: PathProgress?,
	raw: any,
	inSafeZone: boolean
): (PathProgress?, string)
	if progress == nil then
		return nil, "DATA_NOT_LOADED"
	end
	if type(raw) ~= "table" then
		return nil, "BAD_REQUEST"
	end
	local slot, abilityId = raw.slot, raw.abilityId
	if
		type(slot) ~= "number"
		or slot ~= slot
		or slot ~= math.floor(slot)
		or slot < 1
		or slot > Loadout.SLOTS
	then
		return nil, "BAD_REQUEST"
	end
	if type(abilityId) ~= "string" or #abilityId > MAX_ABILITY_ID_LENGTH then
		return nil, "BAD_REQUEST"
	end
	if abilityId ~= "" and Abilities.byId[abilityId] == nil then
		return nil, "BAD_REQUEST"
	end
	if progress.calling == "" then
		return nil, "NO_CALLING"
	end
	if not inSafeZone then
		return nil, "LOADOUT_SAFE_ZONE"
	end
	if abilityId ~= "" and not table.find(PathProgress.unlocked(progress), abilityId) then
		return nil, "NOT_UNLOCKED"
	end
	local result = copy(progress)
	if abilityId ~= "" then
		for i, id in result.loadout do
			if id == abilityId then
				result.loadout[i] = ""
			end
		end
	end
	result.loadout[slot] = abilityId
	return result, "LOADOUT_CHANGED"
end

-- Each id not yet equipped goes into the first empty slot, if any.
function Loadout.autoFill(progress: PathProgress, ids: { string }): PathProgress
	local result = copy(progress)
	for _, id in ids do
		if not table.find(result.loadout, id) then
			local empty = table.find(result.loadout, "")
			if empty ~= nil then
				result.loadout[empty] = id
			end
		end
	end
	return result
end

return Loadout
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">PathProgress</string>
            <string name="Source"><![CDATA[--!strict
local Abilities = require("../Catalog/Abilities")
local Paths = require("../Catalog/Paths")
local Types = require("../Types")

type PathProgress = Types.PathProgress
type PathId = Types.PathId

local PathProgress = {}

PathProgress.MAX_LEVEL = 20
PathProgress.CALLING_START_LEVEL = 3
PathProgress.CHANGE_COST = 500
PathProgress.CHANGE_COOLDOWN = 604800

local RATES = { 1, 0.8, 0.6, 0.4 }
local LOADOUT_SIZE = 4

local function indexOf(path: string): number?
	for i, id in Paths.order do
		if id == path then
			return i
		end
	end
	return nil
end

local function finite(value: any): boolean
	return type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

function PathProgress.distance(a: PathId, b: PathId): number
	local ia, ib = indexOf(a), indexOf(b)
	if ia == nil or ib == nil then
		return 3
	end
	local d = math.abs(ia - ib)
	return math.min(d, #Paths.order - d)
end

function PathProgress.learningRate(calling: string, path: string): number
	if not Paths.isPath(calling) or not Paths.isPath(path) then
		return 0
	end
	return RATES[PathProgress.distance(calling :: PathId, path :: PathId) + 1] or 0
end

function PathProgress.totalXpForLevel(level: number): number
	return 100 * (level - 1) * level / 2
end

function PathProgress.maxXp(): number
	return PathProgress.totalXpForLevel(PathProgress.MAX_LEVEL)
end

function PathProgress.levelForXp(xp: number): number
	if type(xp) ~= "number" or not (xp > 0) then
		return 1
	end
	for level = PathProgress.MAX_LEVEL, 2, -1 do
		if xp >= PathProgress.totalXpForLevel(level) then
			return level
		end
	end
	return 1
end

function PathProgress.level(progress: PathProgress, path: string): number
	local xp = progress.xp[path]
	if xp == nil then
		return 1
	end
	return PathProgress.levelForXp(xp)
end

function PathProgress.new(): PathProgress
	local xp: { [string]: number } = {}
	for _, path in Paths.order do
		xp[path] = 0
	end
	return {
		calling = "",
		xp = xp,
		loadout = table.create(LOADOUT_SIZE, ""),
		callingChanges = 0,
		callingChangedAt = 0,
	}
end

local function copy(progress: PathProgress): PathProgress
	return {
		calling = progress.calling,
		xp = table.clone(progress.xp),
		loadout = table.clone(progress.loadout),
		callingChanges = progress.callingChanges,
		callingChangedAt = progress.callingChangedAt,
	}
end

function PathProgress.unlocked(progress: PathProgress): { string }
	local result = {}
	for _, ability in Abilities.list do
		if PathProgress.level(progress, ability.path) >= ability.unlockLevel then
			table.insert(result, ability.id)
		end
	end
	return result
end

local function unlockedBetween(path: string, before: number, after: number): { string }
	local result = {}
	for _, ability in Abilities.forPath(path :: PathId) do
		if ability.unlockLevel > before and ability.unlockLevel <= after then
			table.insert(result, ability.id)
		end
	end
	return result
end

function PathProgress.chooseCalling(
	progress: PathProgress,
	raw: any
): (PathProgress?, string, { string })
	if not Paths.isPath(raw) then
		return nil, "BAD_REQUEST", {}
	end
	if progress.calling ~= "" then
		return nil, "CALLING_ALREADY_SET", {}
	end
	local path = raw :: string
	local result = copy(progress)
	local before = PathProgress.level(progress, path)
	result.calling = path
	local start = PathProgress.totalXpForLevel(PathProgress.CALLING_START_LEVEL)
	result.xp[path] = math.max(result.xp[path] or 0, start)
	local after = PathProgress.level(result, path)
	return result, "CALLING_CHOSEN", unlockedBetween(path, before, after)
end

function PathProgress.changeCalling(
	progress: PathProgress,
	raw: any,
	coin: number,
	now: number
): (PathProgress?, string, number)
	if not Paths.isPath(raw) then
		return nil, "BAD_REQUEST", 0
	end
	if progress.calling == "" then
		return nil, "NO_CALLING", 0
	end
	if progress.calling == raw then
		return nil, "CALLING_SAME", 0
	end
	-- Written so NaN fails safe: only a clearly elapsed cooldown passes.
	if
		progress.callingChangedAt > 0
		and not (now - progress.callingChangedAt >= PathProgress.CHANGE_COOLDOWN)
	then
		return nil, "CALLING_COOLDOWN", 0
	end
	local cost = if progress.callingChanges == 0 then 0 else PathProgress.CHANGE_COST
	if not (coin >= cost) then
		return nil, "NOT_ENOUGH_COIN", 0
	end
	local result = copy(progress)
	result.calling = raw :: string
	result.callingChanges = progress.callingChanges + 1
	result.callingChangedAt = now
	return result, "CALLING_CHANGED", cost
end

function PathProgress.addXp(
	progress: PathProgress,
	path: string,
	base: number
): (PathProgress, number, number, { string })
	if not Paths.isPath(path) or progress.calling == "" or not finite(base) or not (base > 0) then
		return progress, 0, 0, {}
	end
	local rate = PathProgress.learningRate(progress.calling, path)
	local current = progress.xp[path] or 0
	local room = math.max(0, PathProgress.maxXp() - current)
	local gained = math.min(math.max(0, math.floor(base * rate)), room)
	if not (gained > 0) then
		return progress, 0, 0, {}
	end
	local result = copy(progress)
	result.xp[path] = current + gained
	local before = PathProgress.levelForXp(current)
	local after = PathProgress.levelForXp(current + gained)
	return result, gained, after - before, unlockedBetween(path, before, after)
end

-- Turns arbitrary saved data into valid PathProgress. Never errors.
function PathProgress.sanitize(raw: any): PathProgress
	local result = PathProgress.new()
	if type(raw) ~= "table" then
		return result
	end
	if Paths.isPath(raw.calling) then
		result.calling = raw.calling
	end
	local rawXp = raw.xp
	if type(rawXp) == "table" then
		for _, path in Paths.order do
			local value = rawXp[path]
			if finite(value) then
				result.xp[path] = math.clamp(value, 0, PathProgress.maxXp())
			end
		end
	end
	if finite(raw.callingChanges) and raw.callingChanges >= 0 then
		result.callingChanges = raw.callingChanges
	end
	if finite(raw.callingChangedAt) and raw.callingChangedAt >= 0 then
		result.callingChangedAt = raw.callingChangedAt
	end
	local rawLoadout = raw.loadout
	if type(rawLoadout) == "table" then
		local owned = {}
		for _, id in PathProgress.unlocked(result) do
			owned[id] = true
		end
		local used = {}
		for i = 1, LOADOUT_SIZE do
			local id = rawLoadout[i]
			if type(id) == "string" and owned[id] and not used[id] then
				used[id] = true
				result.loadout[i] = id
			end
		end
	end
	return result
end

return PathProgress
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">PathView</string>
            <string name="Source"><![CDATA[--!strict
local Abilities = require("../Catalog/Abilities")
local Loadout = require("./Loadout")
local PathProgress = require("./PathProgress")
local Paths = require("../Catalog/Paths")
local Types = require("../Types")

type PathProgress = Types.PathProgress

export type AbilityView = {
	id: string,
	name: string,
	description: string,
	unlockLevel: number,
	unlocked: boolean,
	equippedSlot: number,
}
export type RowView = {
	path: string,
	name: string,
	style: string,
	level: number,
	xpText: string,
	rateText: string,
	isCalling: boolean,
	abilities: { AbilityView },
	changeText: string,
	canChange: boolean,
}
export type SlotView = { slot: number, abilityId: string, name: string }
export type View = {
	needsCalling: boolean,
	callingText: string,
	rows: { RowView },
	slots: { SlotView },
}

local SECONDS_PER_DAY = 86400

local PathView = {}

local function xpText(xp: number, level: number): string
	if level >= PathProgress.MAX_LEVEL then
		return "MAX"
	end
	local floor = PathProgress.totalXpForLevel(level)
	local into = math.floor(xp - floor)
	local needed = PathProgress.totalXpForLevel(level + 1) - floor
	return `{into} / {needed}`
end

local function changeState(progress: PathProgress, coin: number, now: number): (string, boolean)
	-- Mirrors PathProgress.changeCalling: the cooldown applies once a change has been made.
	if
		progress.callingChangedAt > 0
		and not (now - progress.callingChangedAt >= PathProgress.CHANGE_COOLDOWN)
	then
		local left = progress.callingChangedAt + PathProgress.CHANGE_COOLDOWN - now
		return `Available in {math.ceil(left / SECONDS_PER_DAY)} days`, false
	end
	if progress.callingChanges == 0 then
		return "Free", true
	end
	return `{PathProgress.CHANGE_COST} Coin`, coin >= PathProgress.CHANGE_COST
end

function PathView.build(progress: PathProgress, coin: number, now: number): View
	local hasCalling = progress.calling ~= ""
	local slotOf: { [string]: number } = {}
	for slot, id in progress.loadout do
		if id ~= "" then
			slotOf[id] = slot
		end
	end

	local rows: { RowView } = {}
	for _, path in Paths.order do
		local info = Paths.info[path]
		local level = PathProgress.level(progress, path)
		local abilities: { AbilityView } = {}
		for _, ability in Abilities.forPath(path) do
			table.insert(abilities, {
				id = ability.id,
				name = ability.name,
				description = ability.description,
				unlockLevel = ability.unlockLevel,
				unlocked = level >= ability.unlockLevel,
				equippedSlot = slotOf[ability.id] or 0,
			})
		end
		local isCalling = hasCalling and progress.calling == path
		local changeText, canChange = "", false
		if hasCalling and not isCalling then
			changeText, canChange = changeState(progress, coin, now)
		end
		table.insert(rows, {
			path = path,
			name = info.name,
			style = info.style,
			level = level,
			xpText = xpText(progress.xp[path] or 0, level),
			rateText = if hasCalling
				then `{math.floor(PathProgress.learningRate(progress.calling, path) * 100 + 0.5)}%`
				else "—",
			isCalling = isCalling,
			abilities = abilities,
			changeText = changeText,
			canChange = canChange,
		})
	end

	local slots: { SlotView } = {}
	for slot = 1, Loadout.SLOTS do
		local id = progress.loadout[slot] or ""
		local ability = Abilities.byId[id]
		table.insert(
			slots,
			{ slot = slot, abilityId = id, name = if ability then ability.name else "" }
		)
	end

	return {
		needsCalling = not hasCalling,
		callingText = if hasCalling
			then `Calling: {Paths.info[progress.calling :: Types.PathId].name}`
			else "Choose your Calling",
		rows = rows,
		slots = slots,
	}
end

return PathView
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">PlaceView</string>
            <string name="Source"><![CDATA[--!strict
-- Where a point is and which hazards are in effect there. Pure: the client shows this.
local Geography = require("./Geography")
local Hazards = require("./Hazards")
local Regions = require("../Catalog/Regions")
local Sites = require("../Catalog/Sites")

export type Place = { regionId: string, name: string, hint: string, hazards: { string } }

local PlaceView = {}

-- The region at (x, z) and the names of the hazards active there at server time `now`.
-- A position that is not a finite number reads as Counting Fields with no hazards.
function PlaceView.at(x: number, z: number, now: number): Place
	local regionId = Geography.regionAt(x, z)
	local region = Regions.byId[regionId]
	local sample = Hazards.sample(Sites.hazards, x, z, now)
	return {
		regionId = regionId,
		name = region.name,
		hint = region.hint,
		hazards = sample.names,
	}
end

return PlaceView
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">Protection</string>
            <string name="Source"><![CDATA[--!strict
local World = require("../Catalog/World")
local Combat = require("./Combat")
local Types = require("../Types")

type Vec3 = Types.Vec3
type Ledger = Types.Ledger

export type Status = {
	inSafeZone: boolean,
	newShield: boolean,
	respawnShieldUntil: number,
	markedUntil: number,
}
-- key: killerId .. ":" .. victimId -> time of last claim
export type ClaimHistory = { [string]: number }

local Protection = {}

Protection.SHIELD_RELICS = 3
Protection.RESPAWN_SHIELD_SECONDS = 60
Protection.MARKED_SECONDS = 300
Protection.RETALIATE_SECONDS = 30
Protection.CLAIM_COOLDOWN_SECONDS = 3600

local function claimKey(killerId: number, victimId: number): string
	return tostring(killerId) .. ":" .. tostring(victimId)
end

function Protection.inSafeZone(position: Vec3): boolean
	local distance = math.sqrt(position.x * position.x + position.z * position.z)
	-- Written as a negation so a NaN position counts as inside (protected), not outside.
	return not (distance > World.townRadius)
end

-- Claimed Relics plus spare ones.
function Protection.shouldEndShield(ledger: Ledger): boolean
	local count = #ledger.free
	for _ in ledger.claimed do
		count += 1
	end
	return count >= Protection.SHIELD_RELICS
end

function Protection.isMarked(status: Status, now: number): boolean
	-- NaN compares false, so a NaN time reads as NOT Marked, which keeps safe-zone protection.
	return now < status.markedUntil
end

function Protection.isShielded(status: Status, now: number): boolean
	-- Written as a negation so a NaN time counts as still shielded (fails closed).
	return status.newShield or not (now >= status.respawnShieldUntil)
end

function Protection.canDamage(attacker: Status, victim: Status, now: number): (boolean, string?)
	if attacker.newShield then
		return false, "SHIELD_SELF"
	end
	if Protection.isShielded(victim, now) then
		return false, "TARGET_SHIELDED"
	end
	local victimMarked = Protection.isMarked(victim, now)
	if victim.inSafeZone and not victimMarked then
		return false, "SAFE_ZONE"
	end
	if attacker.inSafeZone and not victimMarked then
		return false, "SAFE_ZONE"
	end
	return true, nil
end

-- True when this hit starts a fight: the victim is not Marked and did not hit the attacker recently.
function Protection.isAggressor(
	log: Combat.HitLog,
	attackerId: number,
	victimId: number,
	victimMarked: boolean,
	now: number
): boolean
	if victimMarked then
		return false
	end
	local entry = log[tostring(attackerId)]
	if
		entry ~= nil
		and entry.attackerId == victimId
		and now - entry.at <= Protection.RETALIATE_SECONDS
	then
		return false
	end
	return true
end

function Protection.canClaim(
	history: ClaimHistory,
	killerId: number,
	victimId: number,
	now: number
): boolean
	local last = history[claimKey(killerId, victimId)]
	return last == nil or now - last >= Protection.CLAIM_COOLDOWN_SECONDS
end

function Protection.recordClaim(
	history: ClaimHistory,
	killerId: number,
	victimId: number,
	now: number
): ClaimHistory
	local newHistory = table.clone(history)
	newHistory[claimKey(killerId, victimId)] = now
	return newHistory
end

return Protection
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">RateLimiter</string>
            <string name="Source"><![CDATA[--!strict

-- Token bucket. `allow` mutates its bucket (the one deliberate exception to
-- the no-mutation rule for rules modules).
export type Bucket = { tokens: number, last: number }

local RateLimiter = {}

function RateLimiter.new(capacity: number, now: number): Bucket
	return { tokens = capacity, last = now }
end

function RateLimiter.allow(
	bucket: Bucket,
	now: number,
	capacity: number,
	refillPerSecond: number
): boolean
	local elapsed = math.max(0, now - bucket.last)
	bucket.tokens = math.min(capacity, bucket.tokens + elapsed * refillPerSecond)
	bucket.last = math.max(bucket.last, now)
	if bucket.tokens >= 1 then
		bucket.tokens -= 1
		return true
	end
	return false
end

return RateLimiter
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">Scarcity</string>
            <string name="Source"><![CDATA[--!strict
local Ledger = require("./Ledger")
local Relics = require("../Catalog/Relics")
local Tiers = require("../Catalog/Tiers")
local Types = require("../Types")

type CardId = Types.CardId
type Ledger = Types.Ledger

local Scarcity = {}

-- Copies of one Relic held across the given ledgers, claimed and spare alike.
function Scarcity.countHeld(ledgers: { Ledger }, relicId: CardId): number
	local total = 0
	for _, ledger in ledgers do
		total += Ledger.count(ledger, relicId)
	end
	return total
end

-- A cache is sealed once the server holds as many copies as the tier cap.
-- Tiers without a cap, and unknown ids, are never sealed.
function Scarcity.isSealed(relicId: CardId, held: number): boolean
	local relic = Relics.byId[relicId]
	if relic == nil then
		return false
	end
	local cap = Tiers.info[relic.tier].serverCap
	return cap ~= nil and held >= cap
end

return Scarcity
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">Sources</string>
            <string name="Source"><![CDATA[--!strict
local Ledger = require("./Ledger")
local Relics = require("../Catalog/Relics")
local Tiers = require("../Catalog/Tiers")
local Types = require("../Types")

type Cache = Types.Cache
type Ledger = Types.Ledger

-- cache id -> time it becomes available
export type SourceState = { [string]: number }

local Sources = {}

Sources.MAX_DISTANCE = 15

function Sources.new(caches: { Cache }): SourceState
	local state: SourceState = {}
	for _, cache in caches do
		state[cache.id] = 0
	end
	return state
end

function Sources.isAvailable(state: SourceState, cacheId: string, now: number): boolean
	local availableAt = state[cacheId]
	return availableAt ~= nil and now >= availableAt
end

-- Checks run in order: data, locked ledger, distance, cache, sealed, free slots. A failure returns the
-- same state untouched, so a refused attempt never consumes the cache.
-- On success the fourth value is the time the cache becomes available again.
function Sources.tryCollect(
	state: SourceState,
	ledger: Ledger?,
	cache: Cache,
	now: number,
	distance: number,
	sealed: boolean,
	locked: boolean
): (SourceState, Ledger?, string, number?)
	if ledger == nil then
		return state, nil, "DATA_NOT_LOADED", nil
	end
	if locked then
		return state, nil, "LEDGER_LOCKED", nil
	end
	if not (distance <= Sources.MAX_DISTANCE) then
		return state, nil, "TOO_FAR", nil
	end
	if not Sources.isAvailable(state, cache.id, now) then
		return state, nil, "CACHE_EMPTY", nil
	end
	local relic = Relics.byId[cache.relicId]
	if relic == nil then
		return state, nil, "CACHE_EMPTY", nil
	end
	if sealed then
		return state, nil, "SEALED", nil
	end
	local result, err = Ledger.add(ledger, cache.relicId)
	if result == nil then
		return state, nil, err or "FREE_FULL", nil
	end
	local newState = table.clone(state)
	local availableAt = now + Tiers.info[relic.tier].cacheRespawnSeconds
	newState[cache.id] = availableAt
	return newState, result, "GOT_CARD", availableAt
end

return Sources
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">StatusView</string>
            <string name="Source"><![CDATA[--!strict
-- Status lines for the HUD. Pure: the client renders this and nothing else.

export type Line = { text: string, kind: "region" | "safe" | "shield" | "marked" | "hazard" }
export type Status = { newShield: boolean, respawnShieldSeconds: number, markedSeconds: number }

local StatusView = {}

-- Written so NaN and negative values read as "not running".
local function running(seconds: number): boolean
	return seconds > 0 and seconds < math.huge
end

-- The region comes first, then safe zone and status effects, then the hazards in effect.
-- Without a place there are no region or hazard lines.
function StatusView.build(
	status: Status?,
	inSafeZone: boolean,
	place: { name: string, hazards: { string } }?
): { Line }
	local lines: { Line } = {}
	if place ~= nil then
		table.insert(lines, { text = place.name, kind = "region" })
	end
	if inSafeZone then
		table.insert(lines, { text = "Safe zone", kind = "safe" })
	end
	if status ~= nil then
		if status.newShield then
			table.insert(lines, { text = "New-player shield", kind = "shield" })
		end
		if running(status.respawnShieldSeconds) then
			local seconds = math.ceil(status.respawnShieldSeconds)
			table.insert(lines, { text = `Respawn shield: {seconds}s`, kind = "shield" })
		end
		if running(status.markedSeconds) then
			local total = math.ceil(status.markedSeconds)
			local text = string.format("MARKED %d:%02d", total // 60, total % 60)
			table.insert(lines, { text = text, kind = "marked" })
		end
	end
	if place ~= nil then
		for _, name in place.hazards do
			table.insert(lines, { text = name, kind = "hazard" })
		end
	end
	return lines
end

return StatusView
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">Targeting</string>
            <string name="Source"><![CDATA[--!strict
local Types = require("../Types")
local Combat = require("./Combat")

type Vec3 = Types.Vec3
type Fighter = Combat.Fighter

local Targeting = {}

Targeting.SHOT_RADIUS = 2.5
Targeting.DASH_WIDTH = 3

-- Normalised horizontal look, or nil for a zero-length or non-finite look.
local function horizontalLook(attacker: Fighter): (number?, number?)
	local x, z = attacker.look.x, attacker.look.z
	local length = math.sqrt(x * x + z * z)
	if not (length > 0 and length < math.huge) then
		return nil, nil
	end
	return x / length, z / length
end

function Targeting.ahead(attacker: Fighter, distance: number): Vec3
	local x, z = horizontalLook(attacker)
	if x == nil or z == nil then
		return { x = attacker.position.x, y = attacker.position.y, z = attacker.position.z }
	end
	return {
		x = attacker.position.x + x * distance,
		y = attacker.position.y,
		z = attacker.position.z + z * distance,
	}
end

-- Fighters within reach of a ray (direction dirX, dirZ) from the attacker: distance along the
-- ray in (0, length], distance from the ray at most width. Returns the nearest along the ray, or
-- the taunter when it qualifies. Comparisons are written so NaN fails closed.
local function scanRay(
	attacker: Fighter,
	others: { Fighter },
	dirX: number,
	dirZ: number,
	length: number,
	width: number,
	taunter: number?
): number?
	local bestId: number? = nil
	local bestAlong = math.huge
	for _, other in others do
		if other.id == attacker.id then
			continue
		end
		if not (math.abs(other.position.y - attacker.position.y) <= Combat.STRIKE_MAX_HEIGHT) then
			continue
		end
		local dx = other.position.x - attacker.position.x
		local dz = other.position.z - attacker.position.z
		local along = dx * dirX + dz * dirZ
		local across = math.abs(dx * dirZ - dz * dirX)
		if not (along > 0 and along <= length and across <= width) then
			continue
		end
		if taunter ~= nil and other.id == taunter then
			return other.id
		end
		if along < bestAlong then
			bestAlong = along
			bestId = other.id
		end
	end
	return bestId
end

-- Positive angleDegrees turns the look clockwise seen from above (from -z towards +x).
function Targeting.shot(
	attacker: Fighter,
	others: { Fighter },
	range: number,
	angleDegrees: number,
	taunter: number?
): number?
	local lookX, lookZ = horizontalLook(attacker)
	if lookX == nil or lookZ == nil then
		return nil
	end
	local angle = math.rad(angleDegrees)
	local sin, cos = math.sin(angle), math.cos(angle)
	local dirX = lookX * cos - lookZ * sin
	local dirZ = lookX * sin + lookZ * cos
	return scanRay(attacker, others, dirX, dirZ, range, Targeting.SHOT_RADIUS, taunter)
end

function Targeting.inRadius(
	center: Vec3,
	others: { Fighter },
	radius: number,
	excludeId: number?
): { number }
	local ids: { number } = {}
	for _, other in others do
		if excludeId ~= nil and other.id == excludeId then
			continue
		end
		if not (math.abs(other.position.y - center.y) <= Combat.STRIKE_MAX_HEIGHT) then
			continue
		end
		local dx = other.position.x - center.x
		local dz = other.position.z - center.z
		if dx * dx + dz * dz <= radius * radius then
			table.insert(ids, other.id)
		end
	end
	table.sort(ids)
	return ids
end

function Targeting.dashHit(attacker: Fighter, others: { Fighter }, distance: number): number?
	local lookX, lookZ = horizontalLook(attacker)
	if lookX == nil or lookZ == nil then
		return nil
	end
	return scanRay(attacker, others, lookX, lookZ, distance, Targeting.DASH_WIDTH, nil)
end

return Targeting
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">Vault</string>
            <string name="Source"><![CDATA[--!strict
local Ledger = require("./Ledger")
local Relics = require("../Catalog/Relics")
local Types = require("../Types")

type CardId = Types.CardId
type Ledger = Types.Ledger
type Vault = Types.Vault

local MAX_CARD_ID_LENGTH = 16

local Vault = {}

Vault.MAX = 3

function Vault.size(vault: Vault): number
	local total = 0
	for _, value in vault do
		if value then
			total += 1
		end
	end
	return total
end

-- Drops vaulted ids the ledger no longer holds.
function Vault.prune(vault: Vault, ledger: Ledger): Vault
	local result: Vault = {}
	for cardId, value in vault do
		if value and Ledger.count(ledger, cardId) > 0 then
			result[cardId] = true
		end
	end
	return result
end

-- Turns arbitrary saved data into a valid Vault. Never errors.
-- Keeps known, held, non-Crown ids whose value is true; at most MAX, lowest slot numbers first.
function Vault.sanitize(raw: any, ledger: Ledger): Vault
	local result: Vault = {}
	if type(raw) ~= "table" then
		return result
	end
	for _, relic in Relics.list do
		if Vault.size(result) >= Vault.MAX then
			break
		end
		if
			relic.tier ~= "Crown"
			and raw[relic.id] == true
			and Ledger.count(ledger, relic.id) > 0
		then
			result[relic.id] = true
		end
	end
	return result
end

-- Validates a raw client request and applies it to the vault.
-- Request shape: { kind = "add" | "remove", cardId = string }
-- Success: new vault, "VAULTED" | "UNVAULTED", card id.
-- Failure: nil, error code, nil. Never errors on hostile input.
function Vault.apply(
	vault: Vault?,
	ledger: Ledger?,
	raw: any,
	inSafeZone: boolean,
	locked: boolean
): (Vault?, string, CardId?)
	if vault == nil or ledger == nil then
		return nil, "DATA_NOT_LOADED", nil
	end
	if locked then
		return nil, "LEDGER_LOCKED", nil
	end
	if type(raw) ~= "table" then
		return nil, "BAD_REQUEST", nil
	end
	local kind = raw.kind
	local cardId = raw.cardId
	if kind ~= "add" and kind ~= "remove" then
		return nil, "BAD_REQUEST", nil
	end
	if type(cardId) ~= "string" or #cardId > MAX_CARD_ID_LENGTH then
		return nil, "BAD_REQUEST", nil
	end
	if not inSafeZone then
		return nil, "NOT_IN_SAFE_ZONE", nil
	end
	if kind == "add" then
		local relic = Relics.byId[cardId]
		if relic == nil then
			return nil, "UNKNOWN_CARD", nil
		end
		if relic.tier == "Crown" then
			return nil, "CROWN_NO_VAULT", nil
		end
		if Ledger.count(ledger, cardId) == 0 then
			return nil, "NOT_HELD", nil
		end
		if vault[cardId] then
			return nil, "ALREADY_VAULTED", nil
		end
		if Vault.size(vault) >= Vault.MAX then
			return nil, "VAULT_FULL", nil
		end
		local result = table.clone(vault)
		result[cardId] = true
		return result, "VAULTED", cardId
	end
	if not vault[cardId] then
		return nil, "NOT_VAULTED", nil
	end
	local result = table.clone(vault)
	result[cardId] = nil
	return result, "UNVAULTED", cardId
end

return Vault
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="46">
        <Properties>
          <string name="Name">Types</string>
          <string name="Source"><![CDATA[--!strict
export type CardId = string
export type Tier = "Copper" | "Silver" | "Gold" | "Platinum" | "Crown"
export type Relic = { id: CardId, slot: number, name: string, tier: Tier, description: string }
export type Ledger = { claimed: { [CardId]: boolean }, free: { CardId } }
export type Vec3 = { x: number, y: number, z: number }
export type Cache = { id: string, relicId: CardId, position: Vec3, hold: number? }
export type Vault = { [CardId]: boolean }
export type PathId = "Fang" | "Gale" | "Ember" | "Mire" | "Mend" | "Bulwark"
export type PathProgress = {
	calling: string, -- a PathId, or "" before the first choice
	xp: { [string]: number }, -- one entry per PathId
	loadout: { string }, -- exactly 4 entries; "" = empty slot
	callingChanges: number,
	callingChangedAt: number, -- os.time() of the last change, 0 if never
}
export type Ability = {
	id: string,
	name: string,
	path: PathId,
	unlockLevel: number,
	cooldown: number,
	description: string,
	kind: "melee" | "shot" | "dash" | "zone" | "self" | "burst",
	range: number?,
	damage: number?,
	hits: number?,
	interval: number?,
	shots: number?,
	spread: number?, -- shot fan: count, total angle in degrees
	distance: number?, -- dash length
	executeBelow: number?,
	executeDamage: number?,
	burn: { dps: number, duration: number }?,
	root: number?,
	slow: { factor: number, duration: number }?, -- factor = speed multiplier (0.7 = 30% slower)
	pull: number?,
	knockback: number?,
	taunt: number?,
	zone: { radius: number, duration: number, dps: number, slow: number?, ahead: number }?,
	radius: number?, -- burst radius
	heal: number?,
	healOnHit: boolean?,
	cleanse: boolean?,
	shield: { amount: number, duration: number }?,
	immune: number?,
	empower: { bonus: number, duration: number }?,
	reduction: { factor: number, duration: number }?, -- factor = damage multiplier (0.6 = 40% less)
	reflect: { factor: number, duration: number }?,
	allyRadius: number?,
}
export type PlayerData = {
	schemaVersion: number,
	ledger: Ledger,
	coin: number,
	vault: Vault,
	shieldEnded: boolean,
	paths: PathProgress,
}
export type RegionId =
	"Tallyport"
	| "CountingFields"
	| "Thornwood"
	| "SquallSteps"
	| "CinderFlats"
	| "DrownedFen"
	| "ReckoningRock"
	| "HushGardens"
	| "BastionReach"
export type Region = {
	id: RegionId,
	name: string,
	hint: string,
	bearing: number?, -- wild regions only
	ground: string, -- a look name
	fog: { r: number, g: number, b: number, start: number, finish: number },
}
-- Every field is always present; unused ones are 0 or "".
export type Shape = {
	kind: "circle" | "rect" | "region",
	x: number,
	z: number, -- centre; 0 for "region"
	radius: number, -- circle radius; for "region" the least distance from the island centre
	bearing: number,
	halfAlong: number,
	halfAcross: number, -- rect only
	region: string, -- "region" only
}
export type Cycle = { period: number, warn: number, active: number, offset: number }
export type Hazard = {
	id: string,
	region: RegionId,
	name: string,
	look: string,
	shape: Shape,
	holes: { Shape }?,
	cycle: Cycle?,
	dps: number?,
	damage: number?,
	heal: number?,
	slow: number?, -- speed multiplier, 0.5 = half speed
	push: { x: number, z: number }?, -- world velocity, studs per second
	markerY: number?, -- height of the visual marker; ground when nil
}
-- x, y, z is the centre. sx is the extent across the yaw bearing, sy the height, sz the
-- extent along it. A cylinder stands upright: sx = sz = diameter.
export type Feature = {
	look: string,
	shape: "block" | "cylinder",
	x: number,
	y: number,
	z: number,
	sx: number,
	sy: number,
	sz: number,
	yaw: number,
	solid: boolean,
	text: string?,
}
export type SiteCache = { relicId: CardId, x: number, y: number, z: number, hold: number? }
export type Site = {
	region: RegionId,
	hazards: { Hazard },
	features: { Feature },
	prize: SiteCache?,
	keepOut: { Shape },
}

return {}
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="47">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="48">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="49">
        <Properties>
          <string name="Name">AbilityService</string>
          <string name="Source"><![CDATA[--!strict
-- Turns a client's "cast slot N" into the effects of the 18 abilities. The client names only
-- a slot: the ability, targets, damage, movement and timing are all decided here, from the pure
-- Casting plan and the server's own view of the world. Every player hit goes through
-- CombatService.damage, and a hit's statuses, pull or knockback follow only when it landed.
local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Abilities = require(ReplicatedStorage.Shared.Catalog.Abilities)
local Casting = require(ReplicatedStorage.Shared.Rules.Casting)
local Combat = require(ReplicatedStorage.Shared.Rules.Combat)
local Effects = require(ReplicatedStorage.Shared.Rules.Effects)
local Net = require(ReplicatedStorage.Shared.Net)
local Paths = require(ReplicatedStorage.Shared.Catalog.Paths)
local RateLimiter = require(ReplicatedStorage.Shared.Rules.RateLimiter)
local Targeting = require(ReplicatedStorage.Shared.Rules.Targeting)
local Types = require(ReplicatedStorage.Shared.Types)
local World = require(ReplicatedStorage.Shared.Catalog.World)
local CombatService = require(script.Parent.CombatService)
local LedgerService = require(script.Parent.LedgerService)
local PathService = require(script.Parent.PathService)
local Sight = require(script.Parent.Sight)
local StatusService = require(script.Parent.StatusService)

type Ability = Types.Ability
type Fighter = Combat.Fighter
type Plan = Casting.Plan
type Vec3 = Types.Vec3

local BUCKET_CAPACITY = 10
local BUCKET_REFILL_PER_SECOND = 5
local WALL_MARGIN = 2 -- a move stops this many studs short of anything in its way
local ZONE_WALL_MARGIN = 1 -- a zone's centre stops this far short of a wall
local GROUND_PROBE = 50 -- how far below a move's end point to look for ground
local R6_LEG_HEIGHT = 2
local SHOT_WIDTH = 0.3
local SHOT_SECONDS = 0.15
local RING_SECONDS = 0.3
local RING_SEGMENTS = 24
local RING_WIDTH = 0.6
local RING_HEIGHT = 0.2
local RING_LIFT = 0.2 -- above the caster's feet
local DEFAULT_COLOR = Color3.fromRGB(200, 200, 200)

local AbilityService = {}

-- Cooldowns per player, on os.clock(). Kept across respawns, dropped when the player leaves.
local castStates: { [Player]: Casting.CastState } = {}
local buckets: { [Player]: RateLimiter.Bucket } = {}
local cooldownRemote: RemoteEvent

-- True if the player has a token left in their rate-limit bucket (takes one).
local function allowed(player: Player): boolean
	local now = os.clock()
	local bucket = buckets[player]
	if bucket == nil then
		bucket = RateLimiter.new(BUCKET_CAPACITY, now)
		buckets[player] = bucket
	end
	return RateLimiter.allow(bucket, now, BUCKET_CAPACITY, BUCKET_REFILL_PER_SECOND)
end

-- The Humanoid and HumanoidRootPart of a living character, or nil.
local function living(player: Player): (Humanoid?, BasePart?)
	local character = player.Character
	if character == nil then
		return nil, nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid == nil or humanoid.Health <= 0 then
		return nil, nil
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	if root == nil or not root:IsA("BasePart") then
		return nil, nil
	end
	return humanoid, root
end

local function fighterOf(player: Player, humanoid: Humanoid, root: BasePart): Fighter
	local p = root.Position
	local look = root.CFrame.LookVector
	return {
		id = player.UserId,
		position = { x = p.X, y = p.Y, z = p.Z },
		look = { x = look.X, y = look.Y, z = look.Z },
		health = humanoid.Health,
	}
end

local function effectsFolder(): Folder
	local existing = workspace:FindFirstChild("Effects")
	if existing ~= nil and existing:IsA("Folder") then
		return existing
	end
	local folder = Instance.new("Folder")
	folder.Name = "Effects"
	folder.Parent = workspace
	return folder
end

local function pathColor(path: string): Color3
	local info = Paths.info[path :: Types.PathId]
	if info == nil then
		return DEFAULT_COLOR
	end
	return Color3.fromRGB(info.color.r, info.color.g, info.color.b)
end

-- Height of the root's centre above the feet of a standing character.
local function standHeight(humanoid: Humanoid, root: BasePart): number
	if humanoid.RigType == Enum.HumanoidRigType.R15 then
		return humanoid.HipHeight + root.Size.Y / 2
	end
	return R6_LEG_HEIGHT + root.Size.Y / 2
end

-- ---------------------------------------------------------------------------------------
-- World rays: movement (dash, pull, knockback) and line of sight
-- ---------------------------------------------------------------------------------------

-- Moves a character towards `target` using only the server's own geometry. `target` always
-- comes from a server plan, never from a client. A level ray from the root towards the
-- target's x and z stops WALL_MARGIN short of anything in the way; a ray down from there
-- stands the character on the ground, or keeps its current height if there is none. The
-- facing is kept and the velocity zeroed. Returns the level distance actually travelled
-- (0 when nothing moved).
local function moveCharacter(humanoid: Humanoid, root: BasePart, target: Vec3): number
	local from = root.Position
	local dx = target.x - from.X
	local dz = target.z - from.Z
	local distance = math.sqrt(dx * dx + dz * dz)
	-- Written so NaN or infinite targets move nobody.
	if not (distance > 0 and distance < math.huge) then
		return 0
	end
	local direction = Vector3.new(dx / distance, 0, dz / distance)
	local params = Sight.rayParams()
	local travel = distance
	local blocked = workspace:Raycast(from, direction * distance, params)
	if blocked ~= nil then
		travel = math.max(0, blocked.Distance - WALL_MARGIN)
	end
	local stop = from + direction * travel
	local y = from.Y
	local ground = workspace:Raycast(stop, Vector3.new(0, -GROUND_PROBE, 0), params)
	if ground ~= nil then
		y = ground.Position.Y + standHeight(humanoid, root)
	end
	root.CFrame = CFrame.new(stop.X, y, stop.Z) * root.CFrame.Rotation
	root.AssemblyLinearVelocity = Vector3.zero
	return travel
end

-- ---------------------------------------------------------------------------------------
-- Effects on players
-- ---------------------------------------------------------------------------------------

local function heal(player: Player, amount: number)
	local humanoid = living(player)
	if humanoid == nil or not (amount > 0) then
		return
	end
	humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + amount)
end

-- Who a support effect reaches: the caster and the caster's allies (in M3 only the caster;
-- parties come later), each alive and, when the ability has an ally radius, within it.
local function alliesOf(player: Player, ability: Ability): { Player }
	local _, casterRoot = living(player)
	if casterRoot == nil then
		return {}
	end
	local reach = ability.allyRadius
	local result: { Player } = {}
	for _, ally in { player } do
		local _, allyRoot = living(ally)
		if allyRoot == nil then
			continue
		end
		if
			ally ~= player
			and reach ~= nil
			and not ((allyRoot.Position - casterRoot.Position).Magnitude <= reach)
		then
			continue
		end
		table.insert(result, ally)
	end
	return result
end

-- The hit's statuses on a victim the damage reached. Only called after damage() returned true.
local function applyHitStatuses(player: Player, ability: Ability, victim: Player)
	local burn, rootFor, slow, taunt = ability.burn, ability.root, ability.slow, ability.taunt
	if burn == nil and rootFor == nil and slow == nil and taunt == nil then
		return
	end
	local byId = player.UserId
	StatusService.update(victim, function(status, now)
		local out = status
		if burn ~= nil then
			out = Effects.applyBurn(out, burn.dps, burn.duration, byId, now)
		end
		if rootFor ~= nil then
			out = Effects.applyRoot(out, rootFor, now)
		end
		if slow ~= nil then
			out = Effects.applySlow(out, slow.factor, slow.duration, now)
		end
		if taunt ~= nil then
			out = Effects.applyTaunt(out, byId, taunt, now)
		end
		return out
	end)
end

local function vector(v: Vec3): Vector3
	return Vector3.new(v.x, v.y, v.z)
end

-- True when nothing solid stands between the caster and the fighter `targetId`: one ray from
-- the root position the plan was made from (for a dash, where it started) to the target's
-- root or post position.
local function inSight(caster: Fighter, others: { Fighter }, targetId: number): boolean
	for _, other in others do
		if other.id == targetId then
			local postId = if CombatService.isPost(targetId) then targetId else nil
			return Sight.obstruction(vector(caster.position), vector(other.position), postId) == nil
		end
	end
	return false
end

-- Applies a plan's hits. A hit the caster has no line of sight to is skipped entirely. A post
-- trains the ability's Path (posts ignore every effect); a player takes the hit through
-- CombatService.damage, and its statuses and its pull or knockback follow only when that
-- returned true. Heal-on-hit heals the caster and allies when any player hit landed or a post
-- was hit.
local function applyHits(
	player: Player,
	ability: Ability,
	plan: Plan,
	caster: Fighter,
	others: { Fighter },
	byId: { [number]: Player }
)
	local connected = false
	for _, hit in plan.hits do
		if not inSight(caster, others, hit.targetId) then
			continue
		end
		if CombatService.isPost(hit.targetId) then
			CombatService.hitPost(player, hit.targetId, ability.path)
			connected = true
			continue
		end
		local victim = byId[hit.targetId]
		if victim == nil or not CombatService.damage(player, victim, hit.damage) then
			continue
		end
		connected = true
		applyHitStatuses(player, ability, victim)
		-- No ability both pulls and knocks back; each point is for the plan's one target.
		local destination = plan.pullTo or plan.knockbackTo
		if destination ~= nil then
			local humanoid, root = living(victim)
			if humanoid ~= nil and root ~= nil then
				moveCharacter(humanoid, root, destination)
			end
		end
	end
	local amount = ability.heal
	if connected and ability.healOnHit == true and amount ~= nil then
		for _, ally in alliesOf(player, ability) do
			heal(ally, amount)
		end
	end
end

-- Heal (unless it is a heal-on-hit), cleanse, shield, immune, empower, reduction and reflect
-- on the caster and allies.
local function applySelfEffects(player: Player, ability: Ability)
	local amount = if ability.healOnHit == true then nil else ability.heal
	local cleanse = ability.cleanse == true
	local shield, immune, empower = ability.shield, ability.immune, ability.empower
	local reduction, reflect = ability.reduction, ability.reflect
	local anyStatus = cleanse
		or shield ~= nil
		or immune ~= nil
		or empower ~= nil
		or reduction ~= nil
		or reflect ~= nil
	if amount == nil and not anyStatus then
		return
	end
	for _, ally in alliesOf(player, ability) do
		if amount ~= nil then
			heal(ally, amount)
		end
		if not anyStatus then
			continue
		end
		StatusService.update(ally, function(status, now)
			local out = status
			if cleanse then
				out = Effects.cleanse(out)
			end
			if shield ~= nil then
				out = Effects.applyShield(out, shield.amount, shield.duration, now)
			end
			if immune ~= nil then
				out = Effects.applyImmune(out, immune, now)
			end
			if empower ~= nil then
				out = Effects.applyEmpower(out, empower.bonus, empower.duration, now)
			end
			if reduction ~= nil then
				out = Effects.applyReduction(out, reduction.factor, reduction.duration, now)
			end
			if reflect ~= nil then
				out = Effects.applyReflect(out, reflect.factor, reflect.duration, now)
			end
			return out
		end)
	end
end

-- ---------------------------------------------------------------------------------------
-- Visuals (server-made, short-lived, in workspace.Effects)
-- ---------------------------------------------------------------------------------------

local function effectPart(name: string, color: Color3): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Material = Enum.Material.Neon
	part.Color = color
	return part
end

local function showRay(from: Vector3, to: Vector3, color: Color3)
	local length = (to - from).Magnitude
	if not (length > 0 and length < math.huge) then
		return
	end
	local part = effectPart("Shot", color)
	part.Size = Vector3.new(SHOT_WIDTH, SHOT_WIDTH, length)
	part.CFrame = CFrame.lookAt(from, to) * CFrame.new(0, 0, -length / 2)
	part.Parent = effectsFolder()
	Debris:AddItem(part, SHOT_SECONDS)
end

-- One ray per shot, from the caster to the fighter that shot found, or to full range, cut
-- short where something solid blocks it (as the hit is). The fan and the target use the same
-- rules as the plan (Casting and Targeting.shot).
local function showShots(ability: Ability, caster: Fighter, others: { Fighter }, taunter: number?)
	local lx, lz = caster.look.x, caster.look.z
	local length = math.sqrt(lx * lx + lz * lz)
	if not (length > 0 and length < math.huge) then
		return
	end
	lx, lz = lx / length, lz / length
	local range = ability.range or 0
	local shots = ability.shots or 1
	local spread = ability.spread or 0
	local color = pathColor(ability.path)
	local from = Vector3.new(caster.position.x, caster.position.y, caster.position.z)
	for i = 1, shots do
		local angle = 0
		if shots > 1 then
			angle = -spread / 2 + spread * (i - 1) / (shots - 1)
		end
		-- Positive angles turn clockwise seen from above, as in Targeting.shot.
		local radians = math.rad(angle)
		local sin, cos = math.sin(radians), math.cos(radians)
		local to = from + Vector3.new(lx * cos - lz * sin, 0, lx * sin + lz * cos) * range
		local targetId = Targeting.shot(caster, others, range, angle, taunter)
		if targetId ~= nil then
			for _, other in others do
				if other.id == targetId then
					to = vector(other.position)
					break
				end
			end
		end
		local postId = if targetId ~= nil and CombatService.isPost(targetId) then targetId else nil
		showRay(from, Sight.obstruction(from, to, postId) or to, color)
	end
end

-- A flat ring of the burst's radius around the caster's feet.
local function showRing(center: Vector3, radius: number, color: Color3)
	if not (radius > 0 and radius < math.huge) then
		return
	end
	local ring = Instance.new("Model")
	ring.Name = "Ring"
	local segment = 2 * radius * math.sin(math.pi / RING_SEGMENTS) + RING_WIDTH
	for i = 1, RING_SEGMENTS do
		local part = effectPart("Segment", color)
		-- Local X points outwards from the centre, local Z along the ring.
		part.Size = Vector3.new(RING_WIDTH, RING_HEIGHT, segment)
		part.CFrame = CFrame.new(center)
			* CFrame.Angles(0, (i - 1) / RING_SEGMENTS * 2 * math.pi, 0)
			* CFrame.new(radius, 0, 0)
		part.Parent = ring
	end
	ring.Parent = effectsFolder()
	Debris:AddItem(ring, RING_SECONDS)
end

-- ---------------------------------------------------------------------------------------
-- Casting
-- ---------------------------------------------------------------------------------------

-- The fighters a plan may pick from. A single-target melee or shot ability only sees what the
-- caster has a clear line to, so a target behind a corner never swallows the hit (and an
-- unseen taunter forces nothing). Area abilities keep everyone: applyHits skips unseen hits.
local function candidates(ability: Ability, caster: Fighter, others: { Fighter }): { Fighter }
	if ability.kind == "melee" or ability.kind == "shot" then
		return Sight.filter(vector(caster.position), others)
	end
	return others
end

-- Settles a planned zone on the server's own geometry. The centre never lands past a wall
-- (a level ray from the caster's root towards it stops ZONE_WALL_MARGIN short of the hit),
-- and its height is the ground under it, or World.groundY when there is none.
local function placeZone(zone: Casting.Zone, from: Vector3): Casting.Zone
	local params = Sight.rayParams()
	local x, z = zone.center.x, zone.center.z
	local dx, dz = x - from.X, z - from.Z
	local distance = math.sqrt(dx * dx + dz * dz)
	if distance > 0 and distance < math.huge then
		local blocked = workspace:Raycast(from, Vector3.new(dx, 0, dz), params)
		if blocked ~= nil then
			local travel = math.max(0, blocked.Distance - ZONE_WALL_MARGIN)
			x, z = from.X + dx / distance * travel, from.Z + dz / distance * travel
		end
	end
	-- Probe from above the caster's height so a centre on higher ground still finds its floor.
	local y = World.groundY
	local probeTop = from.Y + Combat.STRIKE_MAX_HEIGHT
	local ground = workspace:Raycast(
		Vector3.new(x, probeTop, z),
		Vector3.new(0, -(GROUND_PROBE + Combat.STRIKE_MAX_HEIGHT), 0),
		params
	)
	if ground ~= nil then
		y = ground.Position.Y
	end
	local placed = table.clone(zone)
	placed.center = { x = x, y = y, z = z }
	return placed
end

-- A later wave (Rending Flurry): re-planned from where the caster is now. Skipped if the caster
-- left, died or respawned since the cast.
local function runWave(player: Player, character: Model?, ability: Ability)
	if player.Parent ~= Players or player.Character ~= character then
		return
	end
	local humanoid, root = living(player)
	if humanoid == nil or root == nil then
		return
	end
	local now = os.clock()
	local others, byId = CombatService.fighters(player)
	local taunter = Effects.tauntedBy(StatusService.get(player), now)
	local caster = fighterOf(player, humanoid, root)
	local plan = Casting.plan(ability, caster, candidates(ability, caster, others), taunter)
	applyHits(player, ability, plan, caster, others, byId)
end

local function handleCast(player: Player, rawSlot: any)
	if player.Parent ~= Players then
		return
	end
	local humanoid, root = living(player)
	if humanoid == nil or root == nil or not allowed(player) then
		return
	end
	local progress = PathService.get(player)
	if progress == nil then
		LedgerService.notify(player, "DATA_NOT_LOADED")
		return
	end
	if progress.calling == "" then
		LedgerService.notify(player, "NO_CALLING")
		return
	end

	-- No yielding call from here to the commit: the cooldown check cannot go stale.
	local now = os.clock()
	local status = StatusService.get(player)
	local state = castStates[player] or Casting.new()
	local id, code = Casting.canCast(state, progress, rawSlot, now, Effects.isRooted(status, now))
	if id == nil then
		if code ~= "ON_COOLDOWN" then
			LedgerService.notify(player, code)
		end
		return
	end
	local ability = Abilities.byId[id]
	if ability == nil then
		return
	end
	castStates[player] = Casting.commit(state, id, now)
	-- canCast accepted the slot, so it is a whole number from 1 to 4.
	cooldownRemote:FireClient(player, rawSlot :: number, ability.cooldown)

	local character = player.Character
	local others, byId = CombatService.fighters(player)
	local taunter = Effects.tauntedBy(status, now)
	local caster = fighterOf(player, humanoid, root)
	local targets = candidates(ability, caster, others)
	local plan = Casting.plan(ability, caster, targets, taunter)

	local moveTo = plan.moveTo
	if moveTo ~= nil then
		local clear = moveCharacter(humanoid, root, moveTo)
		if ability.kind == "dash" then
			-- The plan scanned the dash's full length; a wall can stop it short. Only an enemy
			-- inside the stretch actually travelled, plus the gap to what stopped it (the move
			-- halts WALL_MARGIN short of it, and a post's centre is a further stud in), is
			-- passed, scanned from the start point. Line of sight still rules out anything
			-- behind a wall.
			local hits: { Casting.Hit } = {}
			local reach = math.min(ability.distance or 0, clear + WALL_MARGIN + 1.5)
			local targetId = Targeting.dashHit(caster, others, reach)
			if targetId ~= nil then
				table.insert(hits, { targetId = targetId, damage = ability.damage or 0 })
			end
			plan.hits = hits
		end
	end
	applyHits(player, ability, plan, caster, others, byId)
	for k = 1, plan.waves - 1 do
		task.delay(plan.interval * k, runWave, player, character, ability)
	end
	local zone = plan.zone
	if zone ~= nil then
		StatusService.addZone(player, placeZone(zone, root.Position), ability.path)
	end
	applySelfEffects(player, ability)

	if ability.kind == "shot" then
		showShots(ability, caster, targets, taunter)
	elseif ability.kind == "burst" then
		local p = caster.position
		local center = Vector3.new(p.x, p.y - standHeight(humanoid, root) + RING_LIFT, p.z)
		showRing(center, ability.radius or 0, pathColor(ability.path))
	end
end

function AbilityService.start()
	cooldownRemote = LedgerService.makeRemote(Net.AbilityCooldown)
	LedgerService.makeRemote(Net.CastAbility).OnServerEvent:Connect(handleCast)
	effectsFolder()

	Players.PlayerRemoving:Connect(function(player)
		castStates[player] = nil
		buckets[player] = nil
	end)
end

return AbilityService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="50">
        <Properties>
          <string name="Name">ClaimService</string>
          <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local BlindClaim = require(ReplicatedStorage.Shared.Rules.BlindClaim)
local Net = require(ReplicatedStorage.Shared.Net)
local Protection = require(ReplicatedStorage.Shared.Rules.Protection)
local RateLimiter = require(ReplicatedStorage.Shared.Rules.RateLimiter)
local Relics = require(ReplicatedStorage.Shared.Catalog.Relics)
local CombatService = require(script.Parent.CombatService)
local DataService = require(script.Parent.DataService)
local LedgerService = require(script.Parent.LedgerService)

local BUCKET_CAPACITY = 10
local BUCKET_REFILL_PER_SECOND = 5

local ClaimService = {}

local startedCallbacks: { (killer: Player, victim: Player) -> () } = {}

-- Registers a callback that runs (each in pcall) right after a claim opens.
function ClaimService.onClaimStarted(callback: (killer: Player, victim: Player) -> ())
	table.insert(startedCallbacks, callback)
end

-- One open claim, made by `killer` on `victim`. Names are kept because either may leave.
type Session = {
	killer: Player,
	victim: Player,
	killerName: string,
	victimName: string,
	claim: BlindClaim.Claim,
	release: () -> (),
	closed: boolean,
}

-- Open claims by killer. A killer has at most one; a victim is in at most one (they are locked).
local sessions: { [Player]: Session } = {}
-- Last claim time per killer and victim (UserIds), on the os.clock() clock.
local history: Protection.ClaimHistory = {}
local buckets: { [Player]: RateLimiter.Bucket } = {}
local claimUpdate: RemoteEvent

-- True if the player has a token left in their rate-limit bucket (takes one).
local function allowed(player: Player): boolean
	local now = os.clock()
	local bucket = buckets[player]
	if bucket == nil then
		bucket = RateLimiter.new(BUCKET_CAPACITY, now)
		buckets[player] = bucket
	end
	return RateLimiter.allow(bucket, now, BUCKET_CAPACITY, BUCKET_REFILL_PER_SECOND)
end

local function sendUpdate(session: Session)
	if session.killer.Parent ~= Players then
		return
	end
	claimUpdate:FireClient(session.killer, {
		victimName = session.victimName,
		claim = session.claim,
		secondsLeft = math.max(0, session.claim.expiresAt - os.clock()),
	})
end

-- Ends a claim. Every path that ends a claim comes here; it runs once only.
local function close(session: Session)
	if session.closed then
		return
	end
	session.closed = true
	if sessions[session.killer] == session then
		sessions[session.killer] = nil
	end

	LedgerService.unlock(session.victim)
	session.release()

	if session.killer.Parent == Players then
		claimUpdate:FireClient(session.killer, nil)
		LedgerService.notify(session.killer, "CLAIM_OVER")
	end
	if session.victim.Parent == Players then
		local names: { string } = {}
		for _, id in session.claim.takenIds do
			local relic = Relics.byId[id]
			table.insert(names, if relic ~= nil then relic.name else id)
		end
		if #names > 0 then
			LedgerService.notify(session.victim, "CLAIM_LOST", {
				player = session.killerName,
				names = table.concat(names, ", "),
			})
		else
			LedgerService.notify(session.victim, "CLAIM_SAFE", { player = session.killerName })
		end
	end
end

-- Runs in the thread that reported the defeat. For a combat log that is the leaver's
-- PlayerRemoving, so the hold is taken before their profile can be released.
local function onDefeat(killer: Player, victim: Player)
	if sessions[killer] ~= nil or LedgerService.isLocked(victim) then
		return
	end
	if LedgerService.get(killer) == nil or LedgerService.get(victim) == nil then
		return
	end
	local now = os.clock()
	if not Protection.canClaim(history, killer.UserId, victim.UserId, now) then
		if killer.Parent == Players then
			LedgerService.notify(killer, "CLAIM_COOLDOWN", { player = victim.DisplayName })
		end
		return
	end

	history = Protection.recordClaim(history, killer.UserId, victim.UserId, now)
	local session: Session = {
		killer = killer,
		victim = victim,
		killerName = killer.DisplayName,
		victimName = victim.DisplayName,
		claim = BlindClaim.start(now),
		release = DataService.hold(victim),
		closed = false,
	}
	LedgerService.lock(victim)
	sessions[killer] = session

	if victim.Parent == Players then
		LedgerService.notify(victim, "DEFEATED_BY", { player = session.killerName })
	end
	LedgerService.notify(killer, "CLAIM_STARTED", { player = session.victimName })
	sendUpdate(session)
	for _, callback in startedCallbacks do
		local ok, err = pcall(callback, killer, victim)
		if not ok then
			warn(`[IsleOfAvarice] onClaimStarted callback failed: {err}`)
		end
	end

	task.delay(BlindClaim.DURATION, close, session)
end

local function handlePick(player: Player, slot: any)
	if player.Parent ~= Players then
		return
	end
	if not allowed(player) then
		return
	end
	local session = sessions[player]
	if session == nil or session.closed then
		return
	end

	-- Read both sides and check both are loaded before writing either.
	-- No yielding call from here to the two writes.
	local victimLedger = LedgerService.get(session.victim)
	local victimVault = LedgerService.getVault(session.victim)
	local killerLedger = LedgerService.get(player)
	if victimLedger == nil or victimVault == nil or killerLedger == nil then
		close(session)
		return
	end

	local now = os.clock()
	local claim, newVictim, newKiller, code, cardId =
		BlindClaim.pick(session.claim, victimLedger, victimVault, killerLedger, slot, now)

	-- The new claim is stored only once the card has moved, so a failed write records nothing.
	if code == "TAKEN" then
		if not LedgerService.set(session.victim, newVictim) then
			close(session)
			return
		end
		if not LedgerService.set(player, newKiller) then
			-- Cannot happen after the check above; if it does, give the card back.
			LedgerService.set(session.victim, victimLedger)
			close(session)
			return
		end
		session.claim = claim
		local relic = if cardId ~= nil then Relics.byId[cardId] else nil
		LedgerService.notify(
			player,
			"CLAIM_TAKEN",
			{ name = if relic ~= nil then relic.name else "" }
		)
	elseif code == "MISS" then
		session.claim = claim
		LedgerService.notify(player, "CLAIM_MISS")
	else
		-- A refusal returns the claim unchanged and spends no pick.
		LedgerService.notify(player, code)
	end

	sendUpdate(session)
	if not BlindClaim.isOpen(session.claim, now) then
		close(session)
	end
end

function ClaimService.start()
	claimUpdate = LedgerService.makeRemote(Net.ClaimUpdate)
	local claimPick = LedgerService.makeRemote(Net.ClaimPick)
	claimPick.OnServerEvent:Connect(handlePick)

	CombatService.onDefeat(onDefeat)

	Players.PlayerRemoving:Connect(function(player)
		buckets[player] = nil
		-- A leaving killer's claim ends. A leaving victim's claim goes on: their profile is held.
		local session = sessions[player]
		if session ~= nil then
			close(session)
		end
	end)
end

return ClaimService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="51">
        <Properties>
          <string name="Name">CombatService</string>
          <string name="Source"><![CDATA[--!strict
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Combat = require(ReplicatedStorage.Shared.Rules.Combat)
local Effects = require(ReplicatedStorage.Shared.Rules.Effects)
local Net = require(ReplicatedStorage.Shared.Net)
local Protection = require(ReplicatedStorage.Shared.Rules.Protection)
local Types = require(ReplicatedStorage.Shared.Types)
local World = require(ReplicatedStorage.Shared.Catalog.World)
local DataService = require(script.Parent.DataService)
local LedgerService = require(script.Parent.LedgerService)
local ProtectionService = require(script.Parent.ProtectionService)
local Sight = require(script.Parent.Sight)
local StatusService = require(script.Parent.StatusService)

type DamageOpts = { reflected: boolean?, tick: boolean?, passive: boolean? }

local POST_TAG = "TrainingPost"
local POST_XP = 10
local POST_XP_GAP = 0.5 -- seconds between paid hits, per post per attacker
local POST_FLASH_SECONDS = 0.15
local POST_FLASH_COLOR = Color3.fromRGB(255, 235, 150)

local CombatService = {}

-- Who last hit whom, keyed by victim UserId. Time from os.clock().
local hitLog: Combat.HitLog = {}
local lastStrike: { [Player]: number } = {}
local defeatCallbacks: { (killer: Player, victim: Player) -> () } = {}
local hitFx: RemoteEvent
-- Last paid hit per attacker per post id, on os.clock().
local postHits: { [Player]: { [number]: number } } = {}
local postBaseColor: { [BasePart]: Color3 } = {}
local postFlashToken: { [BasePart]: number } = {}

-- PathService.get and PathService.grant, passed in by Main.server.luau. PathService
-- requires ClaimService, which requires this module, so requiring it here would be a cycle.
local getPaths: ((Player) -> Types.PathProgress?)? = nil
local grantXp: ((Player, string, number) -> ())? = nil

-- The Humanoid and HumanoidRootPart of a living character, or nil.
local function living(player: Player): (Humanoid?, BasePart?)
	local character = player.Character
	if character == nil then
		return nil, nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid == nil or humanoid.Health <= 0 then
		return nil, nil
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	if root == nil or not root:IsA("BasePart") then
		return nil, nil
	end
	return humanoid, root
end

local function fighterOf(id: number, root: BasePart, health: number?): Combat.Fighter
	local p = root.Position
	local look = root.CFrame.LookVector
	return {
		id = id,
		position = { x = p.X, y = p.Y, z = p.Z },
		look = { x = look.X, y = look.Y, z = look.Z },
		health = health,
	}
end

-- Every training post part in the world, by post id.
local function postParts(): { [number]: BasePart }
	local parts: { [number]: BasePart } = {}
	for _, instance in CollectionService:GetTagged(POST_TAG) do
		local id = instance:GetAttribute("PostId")
		if
			instance:IsA("BasePart")
			and instance:IsDescendantOf(workspace)
			and type(id) == "number"
			and World.postIndex(id) ~= nil
		then
			parts[id] = instance
		end
	end
	return parts
end

-- A short flash on the post part. A newer flash takes over the restore.
local function flashPost(postId: number)
	local part = postParts()[postId]
	if part == nil then
		return
	end
	local base = postBaseColor[part] or part.Color
	postBaseColor[part] = base
	local token = (postFlashToken[part] or 0) + 1
	postFlashToken[part] = token
	part.Color = POST_FLASH_COLOR
	task.delay(POST_FLASH_SECONDS, function()
		if postFlashToken[part] == token then
			part.Color = base
		end
	end)
end

-- Runs every defeat callback now, in this thread, so a callback can take a DataService hold
-- inside PlayerRemoving before the leaver's profile is released.
local function fireDefeat(killer: Player, victim: Player)
	for _, callback in defeatCallbacks do
		local ok, err = pcall(callback, killer, victim)
		if not ok then
			warn(`[IsleOfAvarice] onDefeat callback failed: {err}`)
		end
	end
end

-- Gives the kill to whoever hit the victim within the window, if they are still here.
local function creditDefeat(victim: Player, windowSeconds: number)
	local now = os.clock()
	local killerId = Combat.creditFor(hitLog, victim.UserId, now, windowSeconds)
	hitLog = Combat.clear(hitLog, victim.UserId)
	if killerId == nil then
		return
	end
	local killer = Players:GetPlayerByUserId(killerId)
	if killer ~= nil and killer ~= victim then
		fireDefeat(killer, victim)
	end
end

function CombatService.isPost(id: number): boolean
	return World.postIndex(id) ~= nil
end

-- Every other living player's fighter (with health) plus every training post, and a map
-- from player fighter id (UserId) to the Player.
function CombatService.fighters(except: Player): ({ Combat.Fighter }, { [number]: Player })
	local list: { Combat.Fighter } = {}
	local byId: { [number]: Player } = {}
	for _, other in Players:GetPlayers() do
		if other == except then
			continue
		end
		local humanoid, root = living(other)
		if humanoid ~= nil and root ~= nil then
			table.insert(list, fighterOf(other.UserId, root, humanoid.Health))
			byId[other.UserId] = other
		end
	end
	local parts = postParts()
	for i = 1, #World.trainingPosts do
		local id = World.POST_ID_BASE - i
		local part = parts[id]
		if part ~= nil then
			local p = part.Position
			table.insert(list, {
				id = id,
				position = { x = p.X, y = p.Y, z = p.Z },
				look = { x = 0, y = 0, z = 1 },
			})
		end
	end
	return list, byId
end

-- Path XP for hitting a training post: at most once per POST_XP_GAP per post per attacker.
-- Posts have no protections. Callers pass the Path to train; nothing is paid without one.
function CombatService.hitPost(attacker: Player, postId: number, path: string)
	if attacker.Parent ~= Players or World.postIndex(postId) == nil then
		return
	end
	flashPost(postId)
	local now = os.clock()
	local hits = postHits[attacker]
	if hits == nil then
		hits = {}
		postHits[attacker] = hits
	end
	local last = hits[postId]
	-- Written so a NaN time pays nothing.
	if last ~= nil and not (now - last >= POST_XP_GAP) then
		return
	end
	hits[postId] = now
	local grant = grantXp
	if grant ~= nil then
		grant(attacker, path, POST_XP)
	end
end

-- The one way a player takes damage: the Strike, abilities, burns, zones and reflects.
-- True only when the hit landed (it passed the protections and the victim was not immune);
-- callers apply statuses, pulls and knockbacks only then.
-- `reflected`: damage sent back by a reflect, so no protections, Mark or empower.
-- `tick`: burn or zone damage, so refusals are not notified and no empower is used.
-- `passive`: a zone tick on someone who walked in after it was placed; the damage and the
-- protections are unchanged, but the attacker is not Marked and keeps their respawn shield.
function CombatService.damage(
	attacker: Player,
	victim: Player,
	amount: number,
	opts: DamageOpts?
): boolean
	local reflected = opts ~= nil and opts.reflected == true
	local tick = opts ~= nil and opts.tick == true
	local passive = opts ~= nil and opts.passive == true
	if attacker == victim or attacker.Parent ~= Players or victim.Parent ~= Players then
		return false
	end
	local victimHumanoid = living(victim)
	if victimHumanoid == nil then
		return false
	end
	local now = os.clock()

	-- No yielding call from here to TakeDamage: statuses cannot go stale.
	if not reflected then
		local attackerStatus = ProtectionService.status(attacker, now)
		if attackerStatus == nil then
			-- A living attacker without loaded data is told; one without a living character
			-- (a burn or zone outliving its owner) cannot pass the protections either.
			if not tick and DataService.get(attacker) == nil then
				LedgerService.notify(attacker, "DATA_NOT_LOADED")
			end
			return false
		end
		local victimStatus = ProtectionService.status(victim, now)
		if victimStatus == nil then
			-- Victim's data is not loaded yet: treat them as shielded.
			if not tick then
				LedgerService.notify(attacker, "TARGET_SHIELDED")
			end
			return false
		end
		local ok, code = Protection.canDamage(attackerStatus, victimStatus, now)
		if not ok then
			if not tick then
				LedgerService.notify(attacker, code or "BAD_REQUEST")
			end
			return false
		end

		-- A passive hit (a zone on someone who walked into it) starts no fight for its owner.
		if not passive then
			ProtectionService.endRespawnShield(attacker)
			local victimMarked = Protection.isMarked(victimStatus, now)
			if
				Protection.isAggressor(hitLog, attacker.UserId, victim.UserId, victimMarked, now)
			then
				ProtectionService.mark(attacker, now)
			end
		end
	end

	local total = amount
	if not reflected and not tick then
		local bonus = 0
		StatusService.update(attacker, function(status, at)
			local out, taken = Effects.takeEmpower(status, at)
			bonus = taken
			return out
		end)
		total += bonus
	end

	local immune, health, reflectBack = false, 0, 0
	StatusService.update(victim, function(status, at)
		immune = Effects.isImmune(status, at)
		local out, toHealth, toReflect = Effects.resolveDamage(status, total, at)
		health, reflectBack = toHealth, toReflect
		return out
	end)
	if immune and not (health > 0) then
		return false
	end

	-- Record the hit before the damage: with immediate signal behaviour, Died can fire
	-- inside TakeDamage, and the kill must already be credited by then.
	hitLog = Combat.recordHit(hitLog, victim.UserId, attacker.UserId, now)
	if health > 0 then
		victimHumanoid:TakeDamage(health)
	end
	hitFx:FireAllClients(victim.UserId)

	-- A player the hit defeated reflects nothing.
	if reflectBack > 0 and not reflected and victimHumanoid.Health > 0 then
		CombatService.damage(victim, attacker, reflectBack, { reflected = true })
	end
	return true
end

-- Damage from the island: no attacker, no protections (shields guard against players only),
-- no hit-log entry. The victim's own effects still apply: immunity cancels it; damage
-- reduction and ability shields absorb. Sets Humanoid.Health directly, so a ForceField does
-- not block it. `flash` also fires the HitFx remote. True when health was removed.
function CombatService.environmentDamage(victim: Player, amount: number, flash: boolean?): boolean
	-- Written positively so a NaN amount is refused too.
	if not (amount > 0) or victim.Parent ~= Players then
		return false
	end
	local humanoid = living(victim)
	if humanoid == nil then
		return false
	end

	-- No yielding call from here to the health change: statuses cannot go stale.
	local immune, health = false, 0
	StatusService.update(victim, function(status, at)
		immune = Effects.isImmune(status, at)
		-- The reflect amount is dropped: the island has nothing to reflect at.
		local out, toHealth = Effects.resolveDamage(status, amount, at)
		health = toHealth
		return out
	end)
	if immune and not (health > 0) then
		return false
	end

	-- Not TakeDamage: a ForceField blocks that, and a shielded player is still hurt by the island.
	-- A defeat here is credited by the Died handler like any other.
	if health > 0 then
		humanoid.Health = math.max(0, humanoid.Health - health)
	end
	if flash == true then
		hitFx:FireAllClients(victim.UserId)
	end
	return health > 0
end

-- Defeats the victim outright (drowning). Ignores effects. The Died handler credits it.
function CombatService.environmentDefeat(victim: Player)
	if victim.Parent ~= Players then
		return
	end
	local humanoid = living(victim)
	if humanoid ~= nil then
		humanoid.Health = 0
	end
end

-- The client only says "I swung". Target, reach, damage and timing are all decided here.
local function handleStrike(player: Player)
	if player.Parent ~= Players then
		return
	end
	local _, attackerRoot = living(player)
	if attackerRoot == nil then
		return
	end
	local now = os.clock()
	if not Combat.canStrike(lastStrike[player], now) then
		return
	end
	lastStrike[player] = now

	-- Only what the attacker can see is a candidate, so a target behind a corner never
	-- swallows the swing, and an unseen taunter forces nothing.
	local all, byId = CombatService.fighters(player)
	local others = Sight.filter(attackerRoot.Position, all)
	local taunter = Effects.tauntedBy(StatusService.get(player), now)
	local targetId = Combat.pickTarget(fighterOf(player.UserId, attackerRoot), others, nil, taunter)
	if targetId == nil then
		return
	end

	if CombatService.isPost(targetId) then
		-- A post trains the Calling; without a Calling the swing does nothing.
		local paths = getPaths
		local progress = if paths ~= nil then paths(player) else nil
		if progress ~= nil and progress.calling ~= "" then
			CombatService.hitPost(player, targetId, progress.calling)
		end
		return
	end

	local victim = byId[targetId]
	if victim == nil then
		return
	end
	CombatService.damage(player, victim, Combat.STRIKE_DAMAGE)
end

local function onCharacterAdded(player: Player, character: Model)
	local humanoid = character:WaitForChild("Humanoid", 10)
	if humanoid == nil or not humanoid:IsA("Humanoid") then
		return
	end
	humanoid.MaxHealth = Combat.MAX_HEALTH
	humanoid.Health = Combat.MAX_HEALTH
	humanoid.Died:Connect(function()
		creditDefeat(player, Combat.KILL_CREDIT_SECONDS)
	end)
end

local function watchPlayer(player: Player)
	player.CharacterAdded:Connect(function(character)
		onCharacterAdded(player, character)
	end)
	local character = player.Character
	if character ~= nil then
		task.spawn(onCharacterAdded, player, character)
	end
end

-- Player-versus-player defeats, and leaving within the combat-log window after being hit.
function CombatService.onDefeat(callback: (killer: Player, victim: Player) -> ())
	table.insert(defeatCallbacks, callback)
end

-- `paths` and `grant` are PathService.get and PathService.grant (see getPaths above).
function CombatService.start(
	paths: (Player) -> Types.PathProgress?,
	grant: (Player, string, number) -> ()
)
	getPaths = paths
	grantXp = grant
	hitFx = LedgerService.makeRemote(Net.HitFx)
	local strike = LedgerService.makeRemote(Net.Strike)
	strike.OnServerEvent:Connect(handleStrike)

	Players.PlayerAdded:Connect(watchPlayer)
	for _, player in Players:GetPlayers() do
		watchPlayer(player)
	end

	-- Combat log: leaving soon after being hit counts as a defeat.
	DataService.beforeRelease(function(player)
		creditDefeat(player, Combat.COMBAT_LOG_SECONDS)
	end)
	Players.PlayerRemoving:Connect(function(player)
		lastStrike[player] = nil
		postHits[player] = nil
	end)
end

return CombatService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="52">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Ledger = require(ReplicatedStorage.Shared.Rules.Ledger)
local PathProgress = require(ReplicatedStorage.Shared.Rules.PathProgress)
local Types = require(ReplicatedStorage.Shared.Types)
local Vault = require(ReplicatedStorage.Shared.Rules.Vault)
local ProfileStore = require(script.Parent.Vendor.ProfileStore)

type PlayerData = Types.PlayerData

local DataService = {}

local TEMPLATE = {
	schemaVersion = 1,
	ledger = { claimed = {}, free = {} },
	coin = 0,
	vault = {},
	shieldEnded = false,
	paths = PathProgress.new(),
}

-- Longest a leaving player's profile stays open for holds.
local MAX_HOLD_SECONDS = 45
local HOLD_POLL_SECONDS = 0.25

local store = ProfileStore.New("PlayerData_v1", TEMPLATE)

-- Active profiles by player. An entry exists only between a finished load and its release.
local profiles: { [Player]: any } = {}
-- Players whose load is in flight, so a player is never loaded twice.
local loading: { [Player]: boolean } = {}
-- Players whose session is being ended because they are leaving, so they are not kicked.
local leaving: { [Player]: boolean } = {}
-- Number of open holds per player; a held profile stays open after the player has left.
local holds: { [Player]: number } = {}
local beforeReleaseCallbacks: { (player: Player) -> () } = {}
local loadedCallbacks: { (player: Player, data: PlayerData) -> () } = {}

local function fireLoaded(player: Player, data: PlayerData)
	for _, callback in loadedCallbacks do
		task.spawn(callback, player, data)
	end
end

local function loadProfile(player: Player)
	if profiles[player] ~= nil or loading[player] then
		return
	end
	loading[player] = true

	local profile = store:StartSessionAsync(tostring(player.UserId), {
		Cancel = function()
			return player.Parent ~= Players
		end,
	})
	loading[player] = nil

	if profile == nil then
		-- Cancelled because the player left (Kick is then a harmless no-op) or the load failed.
		if player.Parent == Players then
			player:Kick("Your data could not be loaded. Please rejoin.")
		end
		return
	end

	if player.Parent ~= Players then
		-- The player left while the profile was loading: release it and store nothing.
		profile:EndSession()
		return
	end

	profile:AddUserId(player.UserId)
	profile:Reconcile()
	profile.Data.ledger = Ledger.sanitize(profile.Data.ledger)
	profile.Data.vault = Vault.sanitize(profile.Data.vault, profile.Data.ledger)
	profile.Data.paths = PathProgress.sanitize(profile.Data.paths)
	if type(profile.Data.shieldEnded) ~= "boolean" then
		profile.Data.shieldEnded = false
	end
	local coin = profile.Data.coin
	if type(coin) ~= "number" or coin ~= coin or coin == math.huge or coin < 0 then
		profile.Data.coin = 0
	end

	profile.OnSessionEnd:Connect(function()
		if profiles[player] == profile then
			profiles[player] = nil
		end
		local isLeaving = leaving[player]
		leaving[player] = nil
		if player.Parent == Players and not isLeaving then
			player:Kick("Your data was loaded elsewhere. Please rejoin.")
		end
	end)

	profiles[player] = profile
	fireLoaded(player, profile.Data)
end

local function releaseProfile(player: Player)
	local profile = profiles[player]
	profiles[player] = nil
	if profile ~= nil then
		leaving[player] = true
		profile:EndSession()
	end
end

-- Runs when a player is leaving, before the profile is released. Holds are taken here.
function DataService.beforeRelease(callback: (player: Player) -> ())
	table.insert(beforeReleaseCallbacks, callback)
end

-- Keeps the player's profile open (for up to MAX_HOLD_SECONDS after they leave).
-- Returns a function that lets go; it works once only.
function DataService.hold(player: Player): () -> ()
	holds[player] = (holds[player] or 0) + 1
	local released = false
	return function()
		if released then
			return
		end
		released = true
		local count = holds[player]
		if count ~= nil then
			holds[player] = if count > 1 then count - 1 else nil
		end
	end
end

local function handleRemoving(player: Player)
	for _, callback in beforeReleaseCallbacks do
		local ok, err = pcall(callback, player)
		if not ok then
			warn(`[IsleOfAvarice] beforeRelease callback failed: {err}`)
		end
	end
	local deadline = os.clock() + MAX_HOLD_SECONDS
	while holds[player] ~= nil and os.clock() < deadline do
		task.wait(HOLD_POLL_SECONDS)
	end
	holds[player] = nil
	releaseProfile(player)
end

-- Returns the player's saved data, or nil until it has loaded and after it was released.
function DataService.get(player: Player): PlayerData?
	local profile = profiles[player]
	if profile ~= nil and profile:IsActive() then
		return profile.Data
	end
	return nil
end

-- The saved data of every player whose profile is open, including held players who have left.
function DataService.all(): { PlayerData }
	local result: { PlayerData } = {}
	for _, profile in profiles do
		if profile:IsActive() then
			table.insert(result, profile.Data)
		end
	end
	return result
end

-- Registers a callback that runs (in its own thread) once a player's data is loaded and sanitised.
-- Players whose data is already loaded are reported immediately.
function DataService.onLoaded(callback: (player: Player, data: PlayerData) -> ())
	table.insert(loadedCallbacks, callback)
	for player, profile in profiles do
		if profile:IsActive() then
			task.spawn(callback, player, profile.Data)
		end
	end
end

function DataService.start()
	Players.PlayerAdded:Connect(function(player)
		loadProfile(player)
	end)
	Players.PlayerRemoving:Connect(handleRemoving)
	for _, player in Players:GetPlayers() do
		task.spawn(loadProfile, player)
	end
end

return DataService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="53">
        <Properties>
          <string name="Name">HazardService</string>
          <string name="Source"><![CDATA[--!strict
-- Applies the island's hazards to every player four times a second. The server decides all
-- of it: damage, healing, slow and drowning. The gust push is the one client-applied effect
-- and is not handled here. Hazard cycles run on workspace:GetServerTimeNow().
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Effects = require(ReplicatedStorage.Shared.Rules.Effects)
local Geography = require(ReplicatedStorage.Shared.Rules.Geography)
local Hazards = require(ReplicatedStorage.Shared.Rules.Hazards)
local Sites = require(ReplicatedStorage.Shared.Catalog.Sites)
local CombatService = require(script.Parent.CombatService)
local StatusService = require(script.Parent.StatusService)

-- A long stall must not turn into one huge damage or healing step.
local MAX_ELAPSED_SECONDS = 1

local HazardService = {}

-- Real time gathered since the last tick.
local accumulated = 0
-- The last burst cycle that hit each player, by hazard id, so a burst lands once per cycle.
local lastBurst: { [Player]: { [string]: number } } = {}

-- The Humanoid and HumanoidRootPart of a living character, or nil.
local function living(player: Player): (Humanoid?, BasePart?)
	local character = player.Character
	if character == nil then
		return nil, nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid == nil or humanoid.Health <= 0 then
		return nil, nil
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	if root == nil or not root:IsA("BasePart") then
		return nil, nil
	end
	return humanoid, root
end

-- One player's share of a tick: drowning, damage, bursts, healing, then slow.
local function tickPlayer(player: Player, now: number, elapsed: number)
	local humanoid, root = living(player)
	if humanoid == nil or root == nil then
		return
	end
	local position = root.Position
	if position.Y < Geography.DROWN_Y then
		CombatService.environmentDefeat(player)
		return
	end

	local sample = Hazards.sample(Sites.hazards, position.X, position.Z, now)
	if sample.dps > 0 then
		CombatService.environmentDamage(player, sample.dps * elapsed)
	end

	if #sample.bursts > 0 then
		local seen = lastBurst[player]
		if seen == nil then
			seen = {}
			lastBurst[player] = seen
		end
		for _, burst in sample.bursts do
			if seen[burst.id] ~= burst.cycle then
				seen[burst.id] = burst.cycle
				CombatService.environmentDamage(player, burst.damage, true)
			end
		end
	end

	if sample.heal > 0 and humanoid.Health > 0 then
		humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + sample.heal * elapsed)
	end

	local slow = sample.slow
	if slow < 1 then
		StatusService.update(player, function(status, at)
			return Effects.applySlow(status, slow, Hazards.SLOW_SECONDS, at)
		end)
	end
end

local function runTick(elapsed: number)
	local now = workspace:GetServerTimeNow()
	local failures = 0
	local firstError = ""
	for _, player in Players:GetPlayers() do
		local ok, err = pcall(tickPlayer, player, now, elapsed)
		if not ok then
			failures += 1
			if failures == 1 then
				firstError = tostring(err)
			end
		end
	end
	-- One warning per tick, however many players failed: this runs four times a second.
	if failures > 0 then
		warn(`[IsleOfAvarice] HazardService failed for {failures} player(s): {firstError}`)
	end
end

local function onHeartbeat(deltaTime: number)
	accumulated += deltaTime
	if accumulated < Hazards.TICK_SECONDS then
		return
	end
	local elapsed = math.min(accumulated, MAX_ELAPSED_SECONDS)
	accumulated = 0
	runTick(elapsed)
end

function HazardService.start()
	Players.PlayerRemoving:Connect(function(player)
		lastBurst[player] = nil
	end)
	RunService.Heartbeat:Connect(onHeartbeat)
end

return HazardService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="54">
        <Properties>
          <string name="Name">LedgerService</string>
          <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Ledger = require(ReplicatedStorage.Shared.Rules.Ledger)
local LedgerActions = require(ReplicatedStorage.Shared.Rules.LedgerActions)
local RateLimiter = require(ReplicatedStorage.Shared.Rules.RateLimiter)
local Net = require(ReplicatedStorage.Shared.Net)
local Relics = require(ReplicatedStorage.Shared.Catalog.Relics)
local Types = require(ReplicatedStorage.Shared.Types)
local Vault = require(ReplicatedStorage.Shared.Rules.Vault)
local DataService = require(script.Parent.DataService)

type Ledger = Types.Ledger
type Vault = Types.Vault

local BUCKET_CAPACITY = 10
local BUCKET_REFILL_PER_SECOND = 5
local SLOW_DOWN_INTERVAL = 1

local LedgerService = {}

local ledgerSync: RemoteEvent
local ledgerAction: RemoteEvent
local ledgerRequest: RemoteEvent
local notifyRemote: RemoteEvent

local buckets: { [Player]: RateLimiter.Bucket } = {}
local completed: { [Player]: boolean } = {}
local lastSlowDown: { [Player]: number } = {}
local locked: { [Player]: boolean } = {}
local changedCallbacks: { (player: Player, ledger: Ledger) -> () } = {}
local remotesFolder: Folder?

-- The player's Ledger, or nil until their data has loaded and after they left.
function LedgerService.get(player: Player): Ledger?
	local data = DataService.get(player)
	if data == nil then
		return nil
	end
	return data.ledger
end

-- The player's Vault, or nil until their data has loaded and after they left.
function LedgerService.getVault(player: Player): Vault?
	local data = DataService.get(player)
	if data == nil then
		return nil
	end
	return data.vault
end

-- Ledgers of every player whose data is loaded (including held players who have left).
function LedgerService.all(): { Ledger }
	local result: { Ledger } = {}
	for _, data in DataService.all() do
		table.insert(result, data.ledger)
	end
	return result
end

-- A locked player's Ledger and Vault may not be changed by that player.
function LedgerService.lock(player: Player)
	locked[player] = true
end

function LedgerService.unlock(player: Player)
	locked[player] = nil
end

function LedgerService.isLocked(player: Player): boolean
	return locked[player] == true
end

function LedgerService.onChanged(callback: (player: Player, ledger: Ledger) -> ())
	table.insert(changedCallbacks, callback)
end

-- Creates a RemoteEvent in the Remotes folder. Works for services started after LedgerService.start().
function LedgerService.makeRemote(name: string): RemoteEvent
	local folder = remotesFolder
	assert(folder ~= nil, "LedgerService.start must run before makeRemote")
	local remote = Instance.new("RemoteEvent")
	remote.Name = name
	remote.Parent = folder
	return remote
end

-- Writes the Ledger to saved data, prunes the Vault to match, and tells that player's client.
-- Returns false, changing nothing, if no data is loaded.
function LedgerService.set(player: Player, ledger: Ledger): boolean
	local data = DataService.get(player)
	if data == nil then
		return false
	end
	data.ledger = ledger
	data.vault = Vault.prune(data.vault, ledger)
	if player.Parent == Players then
		ledgerSync:FireClient(player, ledger, data.vault)
	end
	for _, callback in changedCallbacks do
		task.spawn(callback, player, ledger)
	end
	return true
end

-- Writes the Vault to saved data and tells that player's client.
-- Returns false, changing nothing, if no data is loaded.
function LedgerService.setVault(player: Player, vault: Vault): boolean
	local data = DataService.get(player)
	if data == nil then
		return false
	end
	data.vault = vault
	if player.Parent == Players then
		ledgerSync:FireClient(player, data.ledger, vault)
	end
	return true
end

function LedgerService.notify(player: Player, code: string, args: { [string]: string }?)
	notifyRemote:FireClient(player, code, args)
end

function LedgerService.notifyAll(code: string, args: { [string]: string }?)
	notifyRemote:FireAllClients(code, args)
end

-- True if the player has a token left in their rate-limit bucket (takes one).
local function allowed(player: Player): boolean
	local now = os.clock()
	local bucket = buckets[player]
	if bucket == nil then
		bucket = RateLimiter.new(BUCKET_CAPACITY, now)
		buckets[player] = bucket
	end
	return RateLimiter.allow(bucket, now, BUCKET_CAPACITY, BUCKET_REFILL_PER_SECOND)
end

local function handleRequest(player: Player)
	if player.Parent ~= Players then
		return
	end
	if not allowed(player) then
		return
	end
	local ledger = LedgerService.get(player)
	if ledger ~= nil then
		ledgerSync:FireClient(player, ledger, LedgerService.getVault(player) or {})
	end
end

local function handleAction(player: Player, request: any)
	if player.Parent ~= Players then
		return
	end
	if not allowed(player) then
		local now = os.clock()
		local last = lastSlowDown[player]
		if last == nil or now - last >= SLOW_DOWN_INTERVAL then
			lastSlowDown[player] = now
			LedgerService.notify(player, "SLOW_DOWN")
		end
		return
	end

	if LedgerService.isLocked(player) then
		LedgerService.notify(player, "LEDGER_LOCKED")
		return
	end

	-- No yielding call from here to set(): the Ledger read cannot go stale.
	local newLedger, code, cardId = LedgerActions.apply(LedgerService.get(player), request)
	if newLedger == nil then
		LedgerService.notify(player, code)
		return
	end
	if not LedgerService.set(player, newLedger) then
		LedgerService.notify(player, "DATA_NOT_LOADED")
		return
	end
	local relic = if cardId ~= nil then Relics.byId[cardId] else nil
	LedgerService.notify(player, code, { name = if relic ~= nil then relic.name else "" })

	if code == "CLAIMED" and Ledger.isComplete(newLedger) and not completed[player] then
		completed[player] = true
		notifyRemote:FireAllClients("LEDGER_COMPLETE", { player = player.DisplayName })
	end
end

function LedgerService.start()
	local folder = Instance.new("Folder")
	folder.Name = Net.FOLDER
	folder.Parent = ReplicatedStorage

	remotesFolder = folder
	ledgerSync = LedgerService.makeRemote(Net.LedgerSync)
	ledgerAction = LedgerService.makeRemote(Net.LedgerAction)
	ledgerRequest = LedgerService.makeRemote(Net.LedgerRequest)
	notifyRemote = LedgerService.makeRemote(Net.Notify)

	ledgerAction.OnServerEvent:Connect(handleAction)
	ledgerRequest.OnServerEvent:Connect(handleRequest)
	Players.PlayerRemoving:Connect(function(player)
		buckets[player] = nil
		completed[player] = nil
		lastSlowDown[player] = nil
		-- A held player's profile is still open; whoever holds it unlocks them.
		-- Deferred so the holds taken by other PlayerRemoving handlers exist by now.
		task.defer(function()
			if DataService.get(player) == nil then
				locked[player] = nil
			end
		end)
	end)

	DataService.onLoaded(function(player, data)
		-- A player may have left before this callback ran.
		if player.Parent == Players then
			ledgerSync:FireClient(player, data.ledger, data.vault)
		end
	end)
end

return LedgerService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="55">
        <Properties>
          <string name="Name">LookPainter</string>
          <string name="Source"><![CDATA[--!strict
-- Paints a part from a named look in the Looks catalog.
--   LookPainter.paint(part, look)
--       Sets the part's colour, material and transparency. A look the catalog does not have,
--       or one whose material is not an Enum.Material item, paints opaque grey SmoothPlastic
--       instead, so a typo shows on the island rather than breaking the build.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Looks = require(ReplicatedStorage.Shared.Catalog.Looks)

local FALLBACK_COLOR = Color3.fromRGB(128, 128, 128)

local LookPainter = {}

-- The Enum.Material item with this name, or nil. Indexing an Enum with a name it does not
-- have raises, and a name such as "GetEnumItems" finds a method, so both are screened out.
local function materialNamed(name: string): Enum.Material?
	local ok, item = pcall(function(): any
		return (Enum.Material :: any)[name]
	end)
	if ok and typeof(item) == "EnumItem" and item.EnumType == Enum.Material then
		return item
	end
	return nil
end

function LookPainter.paint(part: BasePart, look: string)
	local spec = Looks.byName[look]
	if spec ~= nil then
		local material = materialNamed(spec.material)
		if material ~= nil then
			part.Color = Color3.fromRGB(spec.r, spec.g, spec.b)
			part.Material = material
			part.Transparency = spec.transparency
			return
		end
	end
	part.Color = FALLBACK_COLOR
	part.Material = Enum.Material.SmoothPlastic
	part.Transparency = 0
end

return LookPainter
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="56">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
local AbilityService = require(script.Parent.AbilityService)
local ClaimService = require(script.Parent.ClaimService)
local CombatService = require(script.Parent.CombatService)
local DataService = require(script.Parent.DataService)
local HazardService = require(script.Parent.HazardService)
local LedgerService = require(script.Parent.LedgerService)
local PathService = require(script.Parent.PathService)
local ProtectionService = require(script.Parent.ProtectionService)
local SourceService = require(script.Parent.SourceService)
local StatusService = require(script.Parent.StatusService)
local VaultService = require(script.Parent.VaultService)
local WorldBuilder = require(script.Parent.WorldBuilder)

-- A failing step is reported but does not stop the steps after it.
local function runStep(name: string, step: () -> ())
	local ok, trace = xpcall(step, debug.traceback)
	if not ok then
		warn(`[IsleOfAvarice] {name} failed: {trace}`)
	end
end

runStep("WorldBuilder.build", WorldBuilder.build)
runStep("LedgerService.start", LedgerService.start)
runStep("SourceService.start", SourceService.start)
runStep("VaultService.start", VaultService.start)
runStep("ProtectionService.start", ProtectionService.start)
-- StatusService never requires CombatService, and CombatService never requires PathService
-- (PathService -> ClaimService -> CombatService): the functions are passed in here instead.
runStep("StatusService.start", function()
	StatusService.start(CombatService.damage, CombatService.hitPost)
end)
runStep("CombatService.start", function()
	CombatService.start(PathService.get, PathService.grant)
end)
runStep("AbilityService.start", AbilityService.start)
runStep("HazardService.start", HazardService.start)
runStep("ClaimService.start", ClaimService.start)
runStep("PathService.start", PathService.start)
-- Data last, so no player loads before the remotes and callbacks exist.
runStep("DataService.start", DataService.start)

print("[IsleOfAvarice] server started")
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="57">
        <Properties>
          <string name="Name">PathService</string>
          <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Abilities = require(ReplicatedStorage.Shared.Catalog.Abilities)
local Loadout = require(ReplicatedStorage.Shared.Rules.Loadout)
local Net = require(ReplicatedStorage.Shared.Net)
local PathProgress = require(ReplicatedStorage.Shared.Rules.PathProgress)
local Protection = require(ReplicatedStorage.Shared.Rules.Protection)
local RateLimiter = require(ReplicatedStorage.Shared.Rules.RateLimiter)
local Types = require(ReplicatedStorage.Shared.Types)
local ClaimService = require(script.Parent.ClaimService)
local DataService = require(script.Parent.DataService)
local LedgerService = require(script.Parent.LedgerService)

type PathProgress = Types.PathProgress

local BUCKET_CAPACITY = 10
local BUCKET_REFILL_PER_SECOND = 5
local DEFEAT_XP = 150
local SECONDS_PER_DAY = 86400

local PathService = {}

local buckets: { [Player]: RateLimiter.Bucket } = {}
local changedCallbacks: { (player: Player, progress: PathProgress) -> () } = {}
local pathSync: RemoteEvent

-- True if the player has a token left in their rate-limit bucket (takes one).
local function allowed(player: Player): boolean
	local now = os.clock()
	local bucket = buckets[player]
	if bucket == nil then
		bucket = RateLimiter.new(BUCKET_CAPACITY, now)
		buckets[player] = bucket
	end
	return RateLimiter.allow(bucket, now, BUCKET_CAPACITY, BUCKET_REFILL_PER_SECOND)
end

-- The server reads the position itself. No character counts as outside the safe zone.
local function playerInSafeZone(player: Player): boolean
	local character = player.Character
	local root = if character ~= nil then character:FindFirstChild("HumanoidRootPart") else nil
	if root == nil or not root:IsA("BasePart") then
		return false
	end
	local p = root.Position
	return Protection.inSafeZone({ x = p.X, y = p.Y, z = p.Z })
end

local function sync(player: Player, data: Types.PlayerData)
	if player.Parent ~= Players then
		return
	end
	pathSync:FireClient(player, data.paths, data.coin, os.time())
end

-- The player's saved Path progress, or nil until loaded and after they left.
function PathService.get(player: Player): PathProgress?
	local data = DataService.get(player)
	if data == nil then
		return nil
	end
	return data.paths
end

function PathService.onChanged(callback: (player: Player, progress: PathProgress) -> ())
	table.insert(changedCallbacks, callback)
end

local function fireChanged(player: Player, progress: PathProgress)
	for _, callback in changedCallbacks do
		local ok, err = pcall(callback, player, progress)
		if not ok then
			warn(`[IsleOfAvarice] onChanged callback failed: {err}`)
		end
	end
end

local function abilityName(id: string): string
	local ability = Abilities.byId[id]
	return if ability ~= nil then ability.name else id
end

-- Adds Path XP at the learning rate for the player's Calling. Does nothing for a player whose
-- data is not loaded or who has left. No yielding call between the read and the write.
function PathService.grant(player: Player, path: string, base: number)
	if player.Parent ~= Players then
		return
	end
	local data = DataService.get(player)
	if data == nil then
		return
	end
	local newProgress, gained, levelsGained, unlocked = PathProgress.addXp(data.paths, path, base)
	if not (gained > 0) then
		return
	end
	newProgress = Loadout.autoFill(newProgress, unlocked)
	data.paths = newProgress

	if levelsGained > 0 then
		LedgerService.notify(player, "LEVEL_UP", {
			path = path,
			level = tostring(PathProgress.level(newProgress, path)),
		})
	end
	for _, id in unlocked do
		LedgerService.notify(player, "ABILITY_UNLOCKED", { name = abilityName(id) })
	end
	sync(player, data)
	fireChanged(player, newProgress)
end

local function handlePick(player: Player, pathId: any)
	if player.Parent ~= Players or not allowed(player) then
		return
	end
	local data = DataService.get(player)
	if data == nil then
		LedgerService.notify(player, "DATA_NOT_LOADED")
		return
	end
	local newProgress, code, unlocked = PathProgress.chooseCalling(data.paths, pathId)
	if newProgress == nil then
		LedgerService.notify(player, code)
		return
	end
	data.paths = Loadout.autoFill(newProgress, unlocked)
	LedgerService.notify(player, "CALLING_CHOSEN", { path = newProgress.calling })
	sync(player, data)
	fireChanged(player, data.paths)
end

local function handleChange(player: Player, pathId: any)
	if player.Parent ~= Players or not allowed(player) then
		return
	end
	local data = DataService.get(player)
	if data == nil then
		LedgerService.notify(player, "DATA_NOT_LOADED")
		return
	end
	local now = os.time()
	local newProgress, code, cost = PathProgress.changeCalling(data.paths, pathId, data.coin, now)
	if newProgress == nil then
		if code == "CALLING_COOLDOWN" then
			local left = data.paths.callingChangedAt + PathProgress.CHANGE_COOLDOWN - now
			LedgerService.notify(
				player,
				code,
				{ days = tostring(math.max(1, math.ceil(left / SECONDS_PER_DAY))) }
			)
		elseif code == "NOT_ENOUGH_COIN" then
			LedgerService.notify(player, code, { cost = tostring(PathProgress.CHANGE_COST) })
		else
			LedgerService.notify(player, code)
		end
		return
	end
	data.coin = data.coin - cost
	data.paths = newProgress
	LedgerService.notify(player, "CALLING_CHANGED", { path = newProgress.calling })
	sync(player, data)
	fireChanged(player, newProgress)
end

local function handleLoadout(player: Player, request: any)
	if player.Parent ~= Players or not allowed(player) then
		return
	end
	local data = DataService.get(player)
	local newProgress, code =
		Loadout.apply(if data ~= nil then data.paths else nil, request, playerInSafeZone(player))
	if newProgress == nil or data == nil then
		LedgerService.notify(player, code)
		return
	end
	data.paths = newProgress
	LedgerService.notify(player, code)
	sync(player, data)
	fireChanged(player, newProgress)
end

function PathService.start()
	pathSync = LedgerService.makeRemote(Net.PathSync)
	LedgerService.makeRemote(Net.PickCalling).OnServerEvent:Connect(handlePick)
	LedgerService.makeRemote(Net.ChangeCalling).OnServerEvent:Connect(handleChange)
	LedgerService.makeRemote(Net.LoadoutAction).OnServerEvent:Connect(handleLoadout)

	DataService.onLoaded(function(player, data)
		sync(player, data)
	end)

	ClaimService.onClaimStarted(function(killer)
		local progress = PathService.get(killer)
		if progress ~= nil and progress.calling ~= "" then
			PathService.grant(killer, progress.calling, DEFEAT_XP)
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		buckets[player] = nil
	end)
end

return PathService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="58">
        <Properties>
          <string name="Name">ProtectionService</string>
          <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Shared.Net)
local Protection = require(ReplicatedStorage.Shared.Rules.Protection)
local Types = require(ReplicatedStorage.Shared.Types)
local DataService = require(script.Parent.DataService)
local LedgerService = require(script.Parent.LedgerService)

type Ledger = Types.Ledger
type Status = Protection.Status

local SHIELD_NAME = "Shield"
local MARKED_TAG_NAME = "MarkedTag"
local MARKED_COLOR = Color3.fromRGB(230, 40, 40)

local ProtectionService = {}

-- Per-player timers, on the os.clock() clock. The new-player shield lives in saved data.
type Timers = { respawnShieldUntil: number, markedUntil: number }
local timers: { [Player]: Timers } = {}

local statusSync: RemoteEvent

-- Read-only defaults for a player with no entry. Never written to.
local NO_TIMERS: Timers = { respawnShieldUntil = 0, markedUntil = 0 }

-- The player's timers, created on first use. Only for players still in the game.
local function timersFor(player: Player): Timers
	local t = timers[player]
	if t == nil then
		t = { respawnShieldUntil = 0, markedUntil = 0 }
		timers[player] = t
	end
	return t
end

-- Reads the player's timers without creating an entry (safe for players who left).
local function peekTimers(player: Player): Timers
	return timers[player] or NO_TIMERS
end

-- True while the player's data is loaded and the new-player shield has not ended.
local function hasNewShield(player: Player): boolean
	local data = DataService.get(player)
	return data ~= nil and not data.shieldEnded
end

-- The HumanoidRootPart of a living character, or nil.
local function livingRoot(player: Player): BasePart?
	local character = player.Character
	if character == nil then
		return nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid == nil or humanoid.Health <= 0 then
		return nil
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	if root == nil or not root:IsA("BasePart") then
		return nil
	end
	return root
end

local function sendStatus(player: Player)
	if player.Parent ~= Players then
		return
	end
	local now = os.clock()
	local t = peekTimers(player)
	statusSync:FireClient(player, {
		newShield = hasNewShield(player),
		respawnShieldSeconds = math.max(0, t.respawnShieldUntil - now),
		markedSeconds = math.max(0, t.markedUntil - now),
	})
end

-- Adds or removes the visible Shield force field so it matches the player's shields.
local function updateForceField(player: Player)
	local character = player.Character
	if character == nil then
		return
	end
	local shielded = hasNewShield(player) or os.clock() < peekTimers(player).respawnShieldUntil
	local existing = character:FindFirstChild(SHIELD_NAME)
	if shielded and existing == nil then
		local field = Instance.new("ForceField")
		field.Name = SHIELD_NAME
		field.Visible = true
		field.Parent = character
	elseif not shielded and existing ~= nil then
		existing:Destroy()
	end
end

local function removeMarkedTag(character: Model)
	for _, child in character:GetDescendants() do
		if child.Name == MARKED_TAG_NAME and child:IsA("BillboardGui") then
			child:Destroy()
		end
	end
end

local function addMarkedTag(character: Model)
	removeMarkedTag(character)
	local anchor = character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")
	if anchor == nil or not anchor:IsA("BasePart") then
		return
	end
	local tag = Instance.new("BillboardGui")
	tag.Name = MARKED_TAG_NAME
	tag.Adornee = anchor
	tag.AlwaysOnTop = true
	tag.MaxDistance = 200
	tag.Size = UDim2.fromOffset(120, 30)
	tag.StudsOffset = Vector3.new(0, 2.5, 0)

	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Text = "MARKED"
	label.TextColor3 = MARKED_COLOR
	label.TextStrokeTransparency = 0.3
	label.TextScaled = true
	label.Font = Enum.Font.GothamBold
	label.Parent = tag

	tag.Parent = anchor
end

-- Removes the Marked tag once the Marked time has run out (a later mark extends it).
local function scheduleUnmark(player: Player, after: number)
	task.delay(after, function()
		local t = timers[player]
		if t == nil or os.clock() < t.markedUntil then
			return
		end
		local character = player.Character
		if character ~= nil then
			removeMarkedTag(character)
		end
		sendStatus(player)
	end)
end

-- Ends the new-player shield for good.
local function endNewShield(player: Player)
	local data = DataService.get(player)
	if data == nil or data.shieldEnded then
		return
	end
	data.shieldEnded = true
	if player.Parent == Players then
		LedgerService.notify(player, "SHIELD_ENDED")
	end
	updateForceField(player)
	sendStatus(player)
end

local function checkShieldEnd(player: Player, ledger: Ledger)
	if Protection.shouldEndShield(ledger) then
		endNewShield(player)
	end
end

local function onCharacterAdded(player: Player, character: Model)
	local now = os.clock()
	local t = timersFor(player)
	t.respawnShieldUntil = now + Protection.RESPAWN_SHIELD_SECONDS
	updateForceField(player)
	if now < t.markedUntil then
		addMarkedTag(character)
	end
	sendStatus(player)

	task.delay(Protection.RESPAWN_SHIELD_SECONDS, function()
		if player.Character == character then
			updateForceField(player)
			sendStatus(player)
		end
	end)
end

local function watchPlayer(player: Player)
	player.CharacterAdded:Connect(function(character)
		onCharacterAdded(player, character)
	end)
	local character = player.Character
	if character ~= nil then
		task.spawn(onCharacterAdded, player, character)
	end
end

-- The player's protection status, or nil without loaded data or a living character.
function ProtectionService.status(player: Player, _now: number): Status?
	if DataService.get(player) == nil then
		return nil
	end
	local root = livingRoot(player)
	if root == nil then
		return nil
	end
	local t = peekTimers(player)
	local p = root.Position
	return {
		inSafeZone = Protection.inSafeZone({ x = p.X, y = p.Y, z = p.Z }),
		newShield = hasNewShield(player),
		respawnShieldUntil = t.respawnShieldUntil,
		markedUntil = t.markedUntil,
	}
end

-- Marks the player for MARKED_SECONDS from now. A player already Marked has the time extended.
function ProtectionService.mark(player: Player, now: number)
	if player.Parent ~= Players then
		return
	end
	local t = timersFor(player)
	local wasMarked = now < t.markedUntil
	t.markedUntil = now + Protection.MARKED_SECONDS
	if not wasMarked then
		LedgerService.notify(player, "MARKED")
		local character = player.Character
		if character ~= nil then
			addMarkedTag(character)
		end
	end
	sendStatus(player)
	scheduleUnmark(player, Protection.MARKED_SECONDS)
end

-- Ends the respawn shield early (the player attacked someone).
function ProtectionService.endRespawnShield(player: Player)
	local t = timers[player]
	if t == nil or t.respawnShieldUntil == 0 then
		return
	end
	t.respawnShieldUntil = 0
	updateForceField(player)
	sendStatus(player)
end

function ProtectionService.start()
	statusSync = LedgerService.makeRemote(Net.StatusSync)
	local shieldDrop = LedgerService.makeRemote(Net.ShieldDrop)

	shieldDrop.OnServerEvent:Connect(function(player)
		if player.Parent ~= Players then
			return
		end
		endNewShield(player)
	end)

	LedgerService.onChanged(checkShieldEnd)
	DataService.onLoaded(function(player, data)
		checkShieldEnd(player, data.ledger)
		updateForceField(player)
		sendStatus(player)
	end)

	Players.PlayerAdded:Connect(watchPlayer)
	for _, player in Players:GetPlayers() do
		watchPlayer(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		timers[player] = nil
	end)
end

return ProtectionService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="59">
        <Properties>
          <string name="Name">Sight</string>
          <string name="Source"><![CDATA[--!strict
-- Server-side world rays shared by AbilityService and CombatService.
--   Sight.rayParams(): RaycastParams
--       Rays pass through every player's character, workspace.Effects and anything a
--       character could walk through (non-colliding parts, water).
--   Sight.obstruction(from, to, postId?): Vector3?
--       Where the straight line from `from` to `to` is first blocked, or nil when clear.
--       When the target is a training post, pass its id: the ray ending on that post's own
--       surface is not a block. A NaN or infinite line counts as blocked.
--   Sight.inSight(from, to, postId?): boolean
--       True when nothing solid stands between the two points.
--   Sight.filter(from, fighters): { Fighter }
--       The fighters (players and posts) the point `from` has a clear line to, in order.
--       Used before choosing a nearest target, so one behind a corner never takes the hit.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Combat = require(ReplicatedStorage.Shared.Rules.Combat)
local World = require(ReplicatedStorage.Shared.Catalog.World)

type Fighter = Combat.Fighter

local Sight = {}

function Sight.rayParams(): RaycastParams
	local exclude: { Instance } = {}
	local effects = workspace:FindFirstChild("Effects")
	if effects ~= nil then
		table.insert(exclude, effects)
	end
	for _, other in Players:GetPlayers() do
		local character = other.Character
		if character ~= nil then
			table.insert(exclude, character)
		end
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = exclude
	params.RespectCanCollide = true
	params.IgnoreWater = true
	return params
end

function Sight.obstruction(from: Vector3, to: Vector3, postId: number?): Vector3?
	local delta = to - from
	-- Written so a NaN or infinite line counts as blocked.
	if not (delta.Magnitude < math.huge) then
		return from
	end
	local result = workspace:Raycast(from, delta, Sight.rayParams())
	if result == nil then
		return nil
	end
	if postId ~= nil and result.Instance:GetAttribute("PostId") == postId then
		return nil
	end
	return result.Position
end

function Sight.inSight(from: Vector3, to: Vector3, postId: number?): boolean
	return Sight.obstruction(from, to, postId) == nil
end

function Sight.filter(from: Vector3, fighters: { Fighter }): { Fighter }
	local kept: { Fighter } = {}
	for _, fighter in fighters do
		local p = fighter.position
		local postId = if World.postIndex(fighter.id) ~= nil then fighter.id else nil
		if Sight.inSight(from, Vector3.new(p.x, p.y, p.z), postId) then
			table.insert(kept, fighter)
		end
	end
	return kept
end

return Sight
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="60">
        <Properties>
          <string name="Name">SiteBuilder</string>
          <string name="Source"><![CDATA[--!strict
-- Builds the island's structures and a visual marker for each hazard.
--   SiteBuilder.build(island)
--       Adds Folder "Features" (one anchored Part for every Sites.features entry) and Folder
--       "Hazards" (one marker Part for every Sites.hazards entry that covers an area) to
--       `island`. Each marker is named with its hazard id, carries the attribute HazardId and
--       the tag "Hazard", and touches nothing: it is only there to be seen. A region-wide
--       hazard has no marker. A tide marker also carries the attribute Rise.
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Sites = require(ReplicatedStorage.Shared.Catalog.Sites)
local Types = require(ReplicatedStorage.Shared.Types)
local World = require(ReplicatedStorage.Shared.Catalog.World)
local LookPainter = require(script.Parent.LookPainter)

local SiteBuilder = {}

local MARKER_THICKNESS = 0.3
-- Markers float a little above the surface they mark so the ground does not hide them.
local MARKER_LIFT = 0.2
local TIDE_RISE = 3
-- A sign's label floats this far above the top of the part that carries it.
local LABEL_CLEARANCE = 2

-- White bold text over the part (height studs tall), in the style of the training-post label.
-- It sits above the part's top face so the part itself never hides it.
local function addLabel(part: BasePart, text: string, height: number)
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(260, 70)
	gui.StudsOffset = Vector3.new(0, height / 2 + LABEL_CLEARANCE, 0)
	gui.MaxDistance = 120
	gui.AlwaysOnTop = false
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0.5
	label.TextScaled = true
	label.Font = Enum.Font.GothamBold
	label.Parent = gui
	gui.Parent = part
end

local function buildFeature(parent: Folder, feature: Types.Feature)
	local part = Instance.new("Part")
	part.Name = feature.look
	part.Anchored = true
	local centre = CFrame.new(feature.x, feature.y, feature.z)
	if feature.shape == "cylinder" then
		-- A Roblox cylinder's axis is X: Size is (height, diameter, diameter), and a quarter
		-- turn about Z stands it upright.
		part.Shape = Enum.PartType.Cylinder
		part.Size = Vector3.new(feature.sy, feature.sx, feature.sx)
		part.CFrame = centre * CFrame.Angles(0, 0, math.rad(90))
	else
		-- A bearing runs clockwise from north (-Z), so the turn about Y is its negative.
		part.Size = Vector3.new(feature.sx, feature.sy, feature.sz)
		part.CFrame = centre * CFrame.Angles(0, -math.rad(feature.yaw), 0)
	end
	LookPainter.paint(part, feature.look)
	part.CanCollide = feature.solid
	if not feature.solid then
		part.CanQuery = false
		part.CanTouch = false
	end
	if feature.text ~= nil then
		addLabel(part, feature.text, feature.sy)
	end
	part.Parent = parent
end

local function buildMarker(parent: Folder, hazard: Types.Hazard)
	local shape = hazard.shape
	if shape.kind == "region" then
		return
	end
	local part = Instance.new("Part")
	part.Name = hazard.id
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	local centre = CFrame.new(shape.x, (hazard.markerY or World.groundY) + MARKER_LIFT, shape.z)
	if shape.kind == "circle" then
		-- A flat disc: the cylinder's axis (its X, the thickness) is turned to point up.
		part.Shape = Enum.PartType.Cylinder
		part.Size = Vector3.new(MARKER_THICKNESS, shape.radius * 2, shape.radius * 2)
		part.CFrame = centre * CFrame.Angles(0, 0, math.rad(90))
	else
		part.Size = Vector3.new(2 * shape.halfAcross, MARKER_THICKNESS, 2 * shape.halfAlong)
		part.CFrame = centre * CFrame.Angles(0, -math.rad(shape.bearing), 0)
	end
	LookPainter.paint(part, hazard.look)
	part:SetAttribute("HazardId", hazard.id)
	CollectionService:AddTag(part, "Hazard")
	if hazard.look == "tide" then
		part:SetAttribute("Rise", TIDE_RISE)
	end
	part.Parent = parent
end

function SiteBuilder.build(island: Folder)
	local features = Instance.new("Folder")
	features.Name = "Features"
	for _, feature in Sites.features do
		buildFeature(features, feature)
	end
	features.Parent = island

	local hazards = Instance.new("Folder")
	hazards.Name = "Hazards"
	for _, hazard in Sites.hazards do
		buildMarker(hazards, hazard)
	end
	hazards.Parent = island
end

return SiteBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="61">
        <Properties>
          <string name="Name">SourceService</string>
          <string name="Source"><![CDATA[--!strict
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Relics = require(ReplicatedStorage.Shared.Catalog.Relics)
local World = require(ReplicatedStorage.Shared.Catalog.World)
local Scarcity = require(ReplicatedStorage.Shared.Rules.Scarcity)
local Sources = require(ReplicatedStorage.Shared.Rules.Sources)
local DataService = require(script.Parent.DataService)
local LedgerService = require(script.Parent.LedgerService)

local SourceService = {}

local function isSealed(relicId: string): boolean
	return Scarcity.isSealed(relicId, Scarcity.countHeld(LedgerService.all(), relicId))
end

-- Sealed caches read "Sealed cache" with a dull pillar; open ones read "Cache" with a glowing one.
local function showSealed(part: BasePart, sealed: boolean)
	local prompt = part:FindFirstChildOfClass("ProximityPrompt")
	if prompt ~= nil then
		prompt.ObjectText = if sealed then "Sealed cache" else "Cache"
	end
	local pillar = part:FindFirstChild("Pillar")
	if pillar ~= nil and pillar:IsA("BasePart") then
		pillar.Material = if sealed then Enum.Material.SmoothPlastic else Enum.Material.Neon
	end
end

local function setVisible(part: BasePart, visible: boolean)
	local transparency = if visible then 0 else 1
	part.Transparency = transparency
	part.CanCollide = visible
	local pillar = part:FindFirstChild("Pillar")
	if pillar ~= nil and pillar:IsA("BasePart") then
		pillar.Transparency = transparency
		pillar.CanCollide = visible
	end
	local prompt = part:FindFirstChildOfClass("ProximityPrompt")
	if prompt ~= nil then
		prompt.Enabled = visible
	end
end

local function distanceToPlayer(player: Player, part: BasePart): number
	local character = player.Character
	local root = if character ~= nil then character:FindFirstChild("HumanoidRootPart") else nil
	if root == nil or not root:IsA("BasePart") then
		return math.huge
	end
	return (root.Position - part.Position).Magnitude
end

function SourceService.start()
	local state = Sources.new(World.caches)

	local cacheParts: { BasePart } = {}

	local function refreshSealed()
		for _, part in cacheParts do
			local cacheId = part:GetAttribute("CacheId")
			local cache = if type(cacheId) == "string" then World.cacheById[cacheId] else nil
			if cache ~= nil then
				showSealed(part, isSealed(cache.relicId))
			end
		end
	end

	local function connect(part: Instance)
		if not part:IsA("BasePart") then
			return
		end
		local prompt = part:FindFirstChildOfClass("ProximityPrompt")
		if prompt == nil then
			return
		end
		table.insert(cacheParts, part)
		prompt.Triggered:Connect(function(player: Player)
			local cacheId = part:GetAttribute("CacheId")
			local cache = if type(cacheId) == "string" then World.cacheById[cacheId] else nil
			if cache == nil then
				return
			end

			-- No yielding call between tryCollect and storing the new state.
			local now = os.clock()
			local newState, newLedger, code, availableAt = Sources.tryCollect(
				state,
				LedgerService.get(player),
				cache,
				now,
				distanceToPlayer(player, part),
				isSealed(cache.relicId),
				LedgerService.isLocked(player)
			)
			if newLedger == nil or availableAt == nil then
				LedgerService.notify(player, code)
				return
			end
			if not LedgerService.set(player, newLedger) then
				-- The data went away; the cache stays as it was.
				LedgerService.notify(player, "DATA_NOT_LOADED")
				return
			end
			state = newState
			local relic = Relics.byId[cache.relicId]
			LedgerService.notify(player, code, { name = if relic ~= nil then relic.name else "" })

			setVisible(part, false)
			task.delay(availableAt - now, setVisible, part, true)
		end)
	end

	for _, instance in CollectionService:GetTagged("Cache") do
		connect(instance)
	end

	LedgerService.onChanged(refreshSealed)
	DataService.onLoaded(refreshSealed)
	Players.PlayerRemoving:Connect(function()
		-- One frame later, once the leaving player's data is gone (held players stay counted).
		task.defer(refreshSealed)
	end)
	refreshSealed()
end

return SourceService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="62">
        <Properties>
          <string name="Name">StatusService</string>
          <string name="Source"><![CDATA[--!strict
-- Owns every player's effect status (slow, root, burn, shield, ...) and the ground zones.
-- Never requires CombatService: Main passes its damage and hitPost functions into start(),
-- so every burn and zone tick goes through the one damage pipeline.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local StarterPlayer = game:GetService("StarterPlayer")

local Casting = require(ReplicatedStorage.Shared.Rules.Casting)
local Combat = require(ReplicatedStorage.Shared.Rules.Combat)
local Effects = require(ReplicatedStorage.Shared.Rules.Effects)
local Paths = require(ReplicatedStorage.Shared.Catalog.Paths)
local Types = require(ReplicatedStorage.Shared.Types)
local World = require(ReplicatedStorage.Shared.Catalog.World)

type Status = Effects.Status
-- CombatService.damage: true when the hit landed.
type DamageFn = (
	attacker: Player,
	victim: Player,
	amount: number,
	opts: { reflected: boolean?, tick: boolean?, passive: boolean? }?
) -> boolean
type HitPostFn = (attacker: Player, postId: number, path: string) -> ()

type ZoneEntry = {
	owner: Player,
	x: number,
	y: number,
	-- Players inside when the zone was placed; others who walk in later are passive targets.
	inside: { [Player]: boolean },
	z: number,
	radius: number,
	dps: number,
	slow: number?,
	path: string,
	expiresAt: number,
	part: BasePart?,
}

local BASE_WALK_SPEED = 16
local TICK_SECONDS = 1
local ZONE_SLOW_SECONDS = 1.2
local ZONE_THICKNESS = 0.3
local ZONE_TRANSPARENCY = 0.6
local ZONE_DEFAULT_COLOR = Color3.fromRGB(200, 200, 200)

local StatusService = {}

-- Time from os.clock() everywhere.
local statuses: { [Player]: Status } = {}
local zones: { ZoneEntry } = {}
-- The Humanoid whose jump we zeroed for a root, so it can be restored afterwards.
local jumpBlocked: { [Player]: Humanoid } = {}
local damageFn: DamageFn? = nil
local hitPostFn: HitPostFn? = nil
local nextTick = 0

-- Read-only defaults for a player with no entry. Never written to.
local FRESH: Status = Effects.new()

-- The Humanoid and HumanoidRootPart of a living character, or nil.
local function living(player: Player): (Humanoid?, BasePart?)
	local character = player.Character
	if character == nil then
		return nil, nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid == nil or humanoid.Health <= 0 then
		return nil, nil
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	if root == nil or not root:IsA("BasePart") then
		return nil, nil
	end
	return humanoid, root
end

local function effectsFolder(): Folder
	local existing = workspace:FindFirstChild("Effects")
	if existing ~= nil and existing:IsA("Folder") then
		return existing
	end
	local folder = Instance.new("Folder")
	folder.Name = "Effects"
	folder.Parent = workspace
	return folder
end

local function pathColor(path: string): Color3
	local info = Paths.info[path :: Types.PathId]
	if info == nil then
		return ZONE_DEFAULT_COLOR
	end
	return Color3.fromRGB(info.color.r, info.color.g, info.color.b)
end

-- A translucent neon disc of the zone's radius lying on the ground.
local function makeZonePart(entry: ZoneEntry): BasePart
	local part = Instance.new("Part")
	part.Name = "Zone"
	part.Shape = Enum.PartType.Cylinder
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Material = Enum.Material.Neon
	part.Color = pathColor(entry.path)
	part.Transparency = ZONE_TRANSPARENCY
	-- A cylinder's axis is its X axis: stand it on end, then lay it flat.
	part.Size = Vector3.new(ZONE_THICKNESS, entry.radius * 2, entry.radius * 2)
	part.CFrame = CFrame.new(entry.x, entry.y + 0.25, entry.z) * CFrame.Angles(0, 0, math.pi / 2)
	part.Parent = effectsFolder()
	return part
end

local function removeZone(index: number)
	local entry = table.remove(zones, index)
	if entry ~= nil and entry.part ~= nil then
		entry.part:Destroy()
	end
end

local function removeExpiredZones(now: number)
	for i = #zones, 1, -1 do
		local entry = zones[i]
		-- Written so a NaN time removes the zone rather than keeping it forever.
		if not (now < entry.expiresAt) or entry.owner.Parent ~= Players then
			removeZone(i)
		end
	end
end

local function horizontalDistance(ax: number, az: number, bx: number, bz: number): number
	local dx = ax - bx
	local dz = az - bz
	return math.sqrt(dx * dx + dz * dz)
end

-- Runs one tick step; a failure is reported and does not stop the other steps.
local function guarded(name: string, step: () -> ())
	local ok, err = pcall(step)
	if not ok then
		warn(`[IsleOfAvarice] StatusService {name} failed: {err}`)
	end
end

-- True when a root at `p` is inside the zone: within its radius on the ground plane and
-- within the height tolerance every other targeting rule uses.
local function zoneContains(entry: ZoneEntry, p: Vector3): boolean
	return horizontalDistance(p.X, p.Z, entry.x, entry.z) <= entry.radius
		and math.abs(p.Y - entry.y) <= Combat.STRIKE_MAX_HEIGHT
end

local function tickBurns(now: number, damage: DamageFn)
	-- Snapshot first: damage writes statuses while we would otherwise be iterating them.
	local burns: { { victim: Player, dps: number, burnBy: number } } = {}
	for victim, status in statuses do
		local dps, burnBy = Effects.burnTick(status, now)
		if dps > 0 and burnBy ~= 0 then
			table.insert(burns, { victim = victim, dps = dps, burnBy = burnBy })
		end
	end
	for _, burn in burns do
		local found = Players:GetPlayerByUserId(burn.burnBy)
		if found == nil then
			continue
		end
		local burner: Player = found
		guarded("burn tick", function()
			damage(burner, burn.victim, burn.dps, { tick = true })
		end)
	end
end

local function tickZone(entry: ZoneEntry, damage: DamageFn, hitPost: HitPostFn?)
	local owner = entry.owner
	if owner.Parent ~= Players then
		return
	end
	for _, victim in Players:GetPlayers() do
		if victim == owner then
			continue
		end
		local _, root = living(victim)
		if root == nil then
			continue
		end
		if not zoneContains(entry, root.Position) then
			continue
		end
		-- Someone who walked in after placement is hurt and slowed, but the owner is not
		-- marked, loses no respawn shield and starts no fight by it.
		local passive = not entry.inside[victim]
		-- The slow is only refreshed on a victim the damage actually reached.
		local landed = damage(owner, victim, entry.dps, { tick = true, passive = passive })
		local slow = entry.slow
		if landed and slow ~= nil then
			local factor: number = slow
			StatusService.update(victim, function(status, at)
				return Effects.applySlow(status, factor, ZONE_SLOW_SECONDS, at)
			end)
		end
	end
	if hitPost ~= nil then
		for i, post in World.trainingPosts do
			if horizontalDistance(post.x, post.z, entry.x, entry.z) <= entry.radius then
				hitPost(owner, World.POST_ID_BASE - i, entry.path)
			end
		end
	end
end

local function tick(now: number)
	local configured = damageFn
	if configured == nil then
		return
	end
	local damage: DamageFn = configured
	local hitPost = hitPostFn
	tickBurns(now, damage)
	-- A copy: a zone's owner leaving mid-tick must not shift the list under us.
	for _, entry in table.clone(zones) do
		if now < entry.expiresAt then
			guarded("zone tick", function()
				tickZone(entry, damage, hitPost)
			end)
		end
	end
end

-- Walk speed follows slow and root; jumping is off while rooted.
local function applyMovement(now: number)
	for _, player in Players:GetPlayers() do
		local humanoid = living(player)
		if humanoid == nil then
			continue
		end
		local status = statuses[player] or FRESH
		local speed = BASE_WALK_SPEED * Effects.speedFactor(status, now)
		if humanoid.WalkSpeed ~= speed then
			humanoid.WalkSpeed = speed
		end
		local blocked = jumpBlocked[player]
		if Effects.isRooted(status, now) then
			if blocked ~= humanoid then
				humanoid.JumpPower = 0
				humanoid.JumpHeight = 0
				jumpBlocked[player] = humanoid
			end
		elseif blocked ~= nil then
			if blocked == humanoid then
				humanoid.JumpPower = StarterPlayer.CharacterJumpPower
				humanoid.JumpHeight = StarterPlayer.CharacterJumpHeight
			end
			jumpBlocked[player] = nil
		end
	end
end

local function onHeartbeat()
	local now = os.clock()
	applyMovement(now)
	removeExpiredZones(now)
	if now >= nextTick then
		nextTick = now + TICK_SECONDS
		tick(now)
	end
end

local function watchPlayer(player: Player)
	statuses[player] = Effects.new()
	player.CharacterAdded:Connect(function()
		statuses[player] = Effects.new()
		jumpBlocked[player] = nil
	end)
end

local function dropPlayer(player: Player)
	statuses[player] = nil
	jumpBlocked[player] = nil
	for i = #zones, 1, -1 do
		if zones[i].owner == player then
			removeZone(i)
		end
	end
end

-- The player's status; a fresh one when they have none. Treat it as read-only.
function StatusService.get(player: Player): Status
	return statuses[player] or Effects.new()
end

-- Replaces the player's status with fn(status, now). No yielding inside fn. A player who
-- has left (no entry) is not given a new one.
function StatusService.update(player: Player, fn: (Status, number) -> Status)
	local current = statuses[player]
	local nextStatus = fn(current or Effects.new(), os.clock())
	if current ~= nil then
		statuses[player] = nextStatus
	end
end

-- A ground zone owned by `owner`: once a second it damages every other living player
-- inside and pays `path` XP for every training post inside, until it expires.
function StatusService.addZone(owner: Player, zone: Casting.Zone, path: string)
	if owner.Parent ~= Players then
		return
	end
	local radius, duration, dps = zone.radius, zone.duration, zone.dps
	if
		not (radius > 0 and radius < math.huge)
		or not (duration > 0 and duration < math.huge)
		or not (dps >= 0 and dps < math.huge)
		or not (math.abs(zone.center.x) < math.huge and math.abs(zone.center.z) < math.huge)
	then
		return
	end
	local entry: ZoneEntry = {
		owner = owner,
		x = zone.center.x,
		y = zone.center.y,
		z = zone.center.z,
		inside = {},
		radius = radius,
		dps = dps,
		slow = zone.slow,
		path = path,
		expiresAt = os.clock() + duration,
		part = nil,
	}
	if not (math.abs(zone.center.y) < math.huge) then
		return
	end
	for _, other in Players:GetPlayers() do
		local _, otherRoot = living(other)
		if other ~= owner and otherRoot ~= nil and zoneContains(entry, otherRoot.Position) then
			entry.inside[other] = true
		end
	end
	entry.part = makeZonePart(entry)
	table.insert(zones, entry)
end

function StatusService.start(damage: DamageFn, hitPost: HitPostFn)
	damageFn = damage
	hitPostFn = hitPost
	effectsFolder()

	Players.PlayerAdded:Connect(watchPlayer)
	for _, player in Players:GetPlayers() do
		watchPlayer(player)
	end
	Players.PlayerRemoving:Connect(dropPlayer)

	nextTick = os.clock() + TICK_SECONDS
	RunService.Heartbeat:Connect(onHeartbeat)
end

return StatusService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="63">
        <Properties>
          <string name="Name">TerrainBuilder</string>
          <string name="Source"><![CDATA[--!strict
-- Builds the island's ground and the sea around it.
--   TerrainBuilder.build(island)
--       Adds Folder "Ground" (one Part per strip from Geography.strips(), painted with its
--       region's ground look) and Folder "Sea" (four Parts) to `island`.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Geography = require(ReplicatedStorage.Shared.Rules.Geography)
local Regions = require(ReplicatedStorage.Shared.Catalog.Regions)
local World = require(ReplicatedStorage.Shared.Catalog.World)
local LookPainter = require(script.Parent.LookPainter)

local TerrainBuilder = {}

local GROUND_THICKNESS = 4
-- A Part cannot be larger than 2048 studs on a side, so the sea is four of them, one per
-- quadrant, together covering -2048 to 2048 in x and z.
local SEA_SIZE = 2048
local SEA_THICKNESS = 2
local SEA_CENTER_Y = -4
local SEA_COLOR = Color3.fromRGB(40, 100, 170)
local SEA_TRANSPARENCY = 0.3

local function buildGround(island: Folder)
	local ground = Instance.new("Folder")
	ground.Name = "Ground"
	for _, strip in Geography.strips() do
		local region = Regions.byId[strip.region]
		local part = Instance.new("Part")
		part.Name = "Ground"
		part.Anchored = true
		part.Size = Vector3.new(strip.x2 - strip.x1, GROUND_THICKNESS, Geography.CELL)
		-- Block centres are half a height below the top face.
		part.CFrame =
			CFrame.new((strip.x1 + strip.x2) / 2, World.groundY - GROUND_THICKNESS / 2, strip.z)
		LookPainter.paint(part, if region then region.ground else "")
		part.Parent = ground
	end
	ground.Parent = island
end

local function buildSea(island: Folder)
	local sea = Instance.new("Folder")
	sea.Name = "Sea"
	for _, signX in { -1, 1 } do
		for _, signZ in { -1, 1 } do
			local part = Instance.new("Part")
			part.Name = "Sea"
			part.Anchored = true
			part.Size = Vector3.new(SEA_SIZE, SEA_THICKNESS, SEA_SIZE)
			part.CFrame = CFrame.new(signX * SEA_SIZE / 2, SEA_CENTER_Y, signZ * SEA_SIZE / 2)
			part.Color = SEA_COLOR
			part.Material = Enum.Material.Glass
			part.Transparency = SEA_TRANSPARENCY
			part.CanCollide = false
			part.Parent = sea
		end
	end
	sea.Parent = island
end

function TerrainBuilder.build(island: Folder)
	buildGround(island)
	buildSea(island)
end

return TerrainBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="64">
        <Properties>
          <string name="Name">VaultService</string>
          <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Protection = require(ReplicatedStorage.Shared.Rules.Protection)
local RateLimiter = require(ReplicatedStorage.Shared.Rules.RateLimiter)
local Vault = require(ReplicatedStorage.Shared.Rules.Vault)
local Net = require(ReplicatedStorage.Shared.Net)
local Relics = require(ReplicatedStorage.Shared.Catalog.Relics)
local LedgerService = require(script.Parent.LedgerService)

local BUCKET_CAPACITY = 10
local BUCKET_REFILL_PER_SECOND = 5

local VaultService = {}

local buckets: { [Player]: RateLimiter.Bucket } = {}

-- True if the player has a token left in their rate-limit bucket (takes one).
local function allowed(player: Player): boolean
	local now = os.clock()
	local bucket = buckets[player]
	if bucket == nil then
		bucket = RateLimiter.new(BUCKET_CAPACITY, now)
		buckets[player] = bucket
	end
	return RateLimiter.allow(bucket, now, BUCKET_CAPACITY, BUCKET_REFILL_PER_SECOND)
end

-- The server reads the position itself. No character counts as outside the safe zone.
local function playerInSafeZone(player: Player): boolean
	local character = player.Character
	local root = if character ~= nil then character:FindFirstChild("HumanoidRootPart") else nil
	if root == nil or not root:IsA("BasePart") then
		return false
	end
	local p = root.Position
	return Protection.inSafeZone({ x = p.X, y = p.Y, z = p.Z })
end

local function handleAction(player: Player, request: any)
	if player.Parent ~= Players then
		return
	end
	if not allowed(player) then
		return
	end

	-- No yielding call from here to setVault(): the reads cannot go stale.
	local newVault, code, cardId = Vault.apply(
		LedgerService.getVault(player),
		LedgerService.get(player),
		request,
		playerInSafeZone(player),
		LedgerService.isLocked(player)
	)
	if newVault == nil then
		LedgerService.notify(player, code)
		return
	end
	if not LedgerService.setVault(player, newVault) then
		LedgerService.notify(player, "DATA_NOT_LOADED")
		return
	end
	local relic = if cardId ~= nil then Relics.byId[cardId] else nil
	LedgerService.notify(player, code, { name = if relic ~= nil then relic.name else "" })
end

function VaultService.start()
	local vaultAction = LedgerService.makeRemote(Net.VaultAction)
	vaultAction.OnServerEvent:Connect(handleAction)
	Players.PlayerRemoving:Connect(function(player)
		buckets[player] = nil
	end)
end

return VaultService
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="65">
        <Properties>
          <string name="Name">Vendor</string>
        </Properties>
        <Item class="ModuleScript" referent="66">
          <Properties>
            <string name="Name">ProfileStore</string>
            <string name="Source"><![CDATA[--[[
MAD STUDIO (by loleris)

-[ProfileStore]---------------------------------------

	Periodic DataStore saving solution with session locking
	
	WARNINGS FOR "Profile.Data" VALUES:
	 	! Do not create numeric tables with gaps - attempting to store such tables will result in an error.
		! Do not create mixed tables (some values indexed by number and others by a string key)
			- only numerically indexed  data will be stored.
		! Do not index tables by anything other than numbers and strings.
		! Do not reference Roblox Instances
		! Do not reference userdata (Vector3, Color3, CFrame...) - Serialize userdata before referencing
		! Do not reference functions
		
	Members:
	
		ProfileStore.IsClosing          [bool]
			-- Set to true after a game:BindToClose() trigger
			
		ProfileStore.IsCriticalState    [bool]
			-- Set to true when ProfileStore experiences too many consecutive errors
		
		ProfileStore.OnError            [Signal] (message, store_name, profile_key)
			-- Most ProfileStore errors will be caught and passed to this signal
			
		ProfileStore.OnOverwrite        [Signal] (store_name, profile_key)
			-- Triggered when a DataStore key was likely used to store data that wasn't
			a ProfileStore profile or the ProfileStore structure was invalidly manually
			altered for that DataStore key
			
		ProfileStore.OnCriticalToggle   [Signal] (is_critical)
			-- Triggered when ProfileStore experiences too many consecutive errors
		
		ProfileStore.DataStoreState     [string] ("NotReady", "NoInternet", "NoAccess", "Access")
			-- This value resembles ProfileStore's access to the DataStore; The value starts
			as "NotReady" and will eventually change to one of the other 3 possible values.
	
	Functions:
	
		ProfileStore.New(store_name, template?) --> [ProfileStore]
			store_name   [string] -- DataStore name
			template     [table] or nil -- Profiles will default to given table (hard-copy) when no data was saved previously
			
		ProfileStore.SetConstant(name, value)
			name    [string]
			value   [number]
				
	Members [ProfileStore]:
	
		ProfileStore.Mock   [ProfileStore]
			-- Reflection of ProfileStore methods, but the methods will now query a mock
			DataStore with no relation to the real DataStore
			
		ProfileStore.Name   [string]
		
	Methods [ProfileStore]:
	
		ProfileStore:StartSessionAsync(profile_key, params?) --> [Profile] or nil
			profile_key [string] -- DataStore key
			params      nil or [table]: -- Custom params; E.g. {Steal = true}
				{
					Steal = true, -- Pass this to disregard an existing session lock
					Cancel = fn() -> (boolean), -- Pass this to create a request cancel condition.
						-- If the cancel function returns true, ProfileStore will stop trying to
						-- start the session and return nil
				}
			
		ProfileStore:MessageAsync(profile_key, message) --> is_success [bool]
			profile_key [string] -- DataStore key
			message     [table] -- Data to be messaged to the profile
			
		ProfileStore:GetAsync(profile_key, version?) --> [Profile] or nil
			-- Reads a profile without starting a session - will not autosave
			profile_key   [string] -- DataStore key
			version       nil or [string] -- DataStore key version

		ProfileStore:VersionQuery(profile_key, sort_direction?, min_date?, max_date?) --> [VersionQuery]
			profile_key      [string]
			sort_direction   nil or [Enum.SortDirection]
			min_date         nil or [DateTime]
			max_date         nil or [DateTime]
			
		ProfileStore:RemoveAsync(profile_key) --> is_success [bool]
			-- Completely removes profile data from the DataStore / mock DataStore with no way to recover it.

	Methods [VersionQuery]:

		VersionQuery:NextAsync() --> [Profile] or nil -- (Yields)
			-- Returned profile is similar to profiles returned by ProfileStore:GetAsync()
		
	Members [Profile]:
	
		Profile.Data               [table]
			-- When the profile is active changes to this table are guaranteed to be saved
		Profile.LastSavedData      [table] (Read-only)
			-- Last snapshot of "Profile.Data" that has been successfully saved to the DataStore;
			Useful for proper developer product purchase receipt handling
		
		Profile.FirstSessionTime   [number] (Read-only)
			-- os.time() timestamp of the first profile session
			
		Profile.SessionLoadCount   [number] (Read-only) -- Amount of times a session was started for this profile
			
		Profile.Session            [table] (Read-only) {PlaceId = number, JobId = string} / nil
			-- Set to a table if this profile is in use by a server; nil if released

		Profile.RobloxMetaData     [table] -- Writable table that gets saved automatically and once the profile is released
		Profile.UserIds            [table] -- (Read-only) -- {user_id [number], ...} -- User ids associated with this profile

		Profile.KeyInfo            [DataStoreKeyInfo] -- Changes before OnAfterSave signal
		
		Profile.OnSave             [Signal] ()
			-- Triggered right before changes to Profile.Data are saved to the DataStore
			
		Profile.OnLastSave         [Signal] (reason [string]: "Manual", "External", "Shutdown")
			-- Triggered right before changes to Profile.Data are saved to the DataStore
			for the last time; A reason is provided for the last save:
				- "Manual"   - Profile:EndSession() was called
				- "Shutdown" - The server that has ownership of this profile is shutting down
				- "External" - Another server has started a session for this profile
			Note that this event will not trigger for when a profile session is ended by
			another server trying to take ownership of the session - this is impossible to
			do without compromising on ProfileStore's speed.
			
		Profile.OnSessionEnd       [Signal] ()
			-- Triggered when the profile session is terminated on this server
		
		Profile.OnAfterSave        [Signal] (last_saved_data)
			-- Triggered after a successful save
			last_saved_data [table] -- Profile.LastSavedData
			
		Profile.ProfileStore       [ProfileStore] -- ProfileStore object this profile belongs to
		Profile.Key                [string] -- DataStore key
		
	Methods [Profile]:
	
		Profile:IsActive() --> [bool] -- If "true" is returned, changes to Profile.Data are guaranteed to save;
			This guarantee is only valid until code yields (e.g. task.wait() is used).
			
		Profile:Reconcile() -- Fills in missing (nil) [string_key] = [value] pairs to the Profile.Data structure
			from the "template" argument that was passed to "ProfileStore.New()"
			
		Profile:EndSession() -- Call after the server has finished working with this profile
			e.g., after the player leaves (Profile object will become inactive)

		Profile:AddUserId(user_id) -- Associates user_id with profile (GDPR compliance)
			user_id   [number]

		Profile:RemoveUserId(user_id) -- Unassociates user_id with profile (safe function)
			user_id   [number]
			
		Profile:MessageHandler(fn) -- Sets a message handler for this profile
			fn [function] (message [table], processed [function]())
			-- The handler function receives a message table and a callback function;
			The callback function is to be called when a message has been processed
			- this will discard the message from the profile message cache; If the
			callback function is not called, other message handlers will also be triggered
			with unprocessed message data.
			
		Profile:Save() -- If the profile session is still active makes an UpdateAsync call
			to the DataStore to immediately save profile data

		Profile:SetAsync() -- Forcefully saves changes to the profile; Only for profiles
			loaded with ProfileStore:GetAsync() or ProfileStore:VersionQuery()
		
--]]

local AUTO_SAVE_PERIOD = 300 -- (Seconds) Time between when changes to a profile are saved to the DataStore
local LOAD_REPEAT_PERIOD = 10 -- (Seconds) Time between successive profile reads when handling a session conflict
local FIRST_LOAD_REPEAT = 5 -- (Seconds) Time between first and second profile read when handling a session conflict
local SESSION_STEAL = 40 -- (Seconds) Time until a session conflict is resolved with the waiting server stealing the session
local ASSUME_DEAD = 630 -- (Seconds) If a profile hasn't had updates for this long, quickly assume an active session belongs to a crashed server
local START_SESSION_TIMEOUT = 120 -- (Seconds) If a session can't be started for a profile for this long, stop repeating calls to the DataStore

local CRITICAL_STATE_ERROR_COUNT = 5 -- Assume critical state if this many issues happen in a short amount of time
local CRITICAL_STATE_ERROR_EXPIRE = 120 -- (Seconds) Individual issue expiration
local CRITICAL_STATE_EXPIRE = 120 -- (Seconds) Critical state expiration

local MAX_MESSAGE_QUEUE = 1000 -- Max messages saved in a profile that were sent using "ProfileStore:MessageAsync()"

----- Dependencies -----

-- local Util = require(game.ReplicatedStorage.Shared.Util)
-- local Signal = Util.Signal

local Signal
do
	local FreeRunnerThread

	--[[
		Yield-safe coroutine reusing by stravant;
		Sources:
		https://devforum.roblox.com/t/lua-signal-class-comparison-optimal-goodsignal-class/1387063
		https://gist.github.com/stravant/b75a322e0919d60dde8a0316d1f09d2f
	--]]

	local function AcquireRunnerThreadAndCallEventHandler(fn, ...)
		local acquired_runner_thread = FreeRunnerThread
		FreeRunnerThread = nil
		fn(...)
		-- The handler finished running, this runner thread is free again.
		FreeRunnerThread = acquired_runner_thread
	end

	local function RunEventHandlerInFreeThread(...)
		AcquireRunnerThreadAndCallEventHandler(...)
		while true do
			AcquireRunnerThreadAndCallEventHandler(coroutine.yield())
		end
	end

	local Connection = {}
	Connection.__index = Connection

	local SignalClass = {}
	SignalClass.__index = SignalClass

	function Connection:Disconnect()
		if self.is_connected == false then
			return
		end

		local signal = self.signal
		self.is_connected = false
		signal.listener_count -= 1

		if signal.head == self then
			signal.head = self.next
		else
			local prev = signal.head
			while prev ~= nil and prev.next ~= self do
				prev = prev.next
			end
			if prev ~= nil then
				prev.next = self.next
			end
		end
	end

	function SignalClass.New()
		local self = {
			head = nil,
			listener_count = 0,
		}
		setmetatable(self, SignalClass)

		return self
	end

	function SignalClass:Connect(listener: (...any) -> ())
		if type(listener) ~= "function" then
			error(`[{script.Name}]: \"listener\" must be a function; Received {typeof(listener)}`)
		end

		local connection = {
			listener = listener,
			signal = self,
			next = self.head,
			is_connected = true,
		}
		setmetatable(connection, Connection)

		self.head = connection
		self.listener_count += 1

		return connection
	end

	function SignalClass:GetListenerCount(): number
		return self.listener_count
	end

	function SignalClass:Fire(...)
		local item = self.head
		while item ~= nil do
			if item.is_connected == true then
				if not FreeRunnerThread then
					FreeRunnerThread = coroutine.create(RunEventHandlerInFreeThread)
				end
				task.spawn(FreeRunnerThread, item.listener, ...)
			end
			item = item.next
		end
	end

	function SignalClass:Wait()
		local co = coroutine.running()
		local connection
		connection = self:Connect(function(...)
			connection:Disconnect()
			task.spawn(co, ...)
		end)
		return coroutine.yield()
	end

	Signal = table.freeze({
		New = SignalClass.New,
	})
end

----- Private -----

local ActiveSessionCheck = {} -- {[session_token] = profile, ...}
local AutoSaveList = {} -- {profile, ...} -- Loaded profile table which will be circularly auto-saved
local IssueQueue = {} -- {issue_time, ...}

local DataStoreService = game:GetService("DataStoreService")
local MessagingService = game:GetService("MessagingService")
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")

local PlaceId = game.PlaceId
local JobId = game.JobId

local AutoSaveIndex = 1 -- Next profile to auto save
local LastAutoSave = os.clock()

local LoadIndex = 0

local ActiveProfileLoadJobs = 0 -- Number of active threads that are loading in profiles
local ActiveProfileSaveJobs = 0 -- Number of active threads that are saving profiles

local CriticalStateStart = 0 -- os.clock()

local IsStudio = RunService:IsStudio()
local DataStoreState: "NotReady" | "NoInternet" | "NoAccess" | "Access" = "NotReady"

local MockStore = {}
local UserMockStore = {}
local MockFlag = false

local OnError = Signal.New() -- (message, store_name, profile_key)
local OnOverwrite = Signal.New() -- (store_name, profile_key)

local UpdateQueue =
	{ -- For stability sake, we won't do UpdateAsync calls for the same key until all previous calls finish
		--[[
		[session_token] = {
			coroutine, ...
		},
		...
	--]]
	}

local function WaitInUpdateQueue(session_token) --> next_in_queue()
	local is_first = false

	if UpdateQueue[session_token] == nil then
		is_first = true
		UpdateQueue[session_token] = {}
	end

	local queue = UpdateQueue[session_token]

	if is_first == false then
		table.insert(queue, coroutine.running())
		coroutine.yield()
	end

	return function()
		local next_co = table.remove(queue, 1)
		if next_co ~= nil then
			coroutine.resume(next_co)
		else
			UpdateQueue[session_token] = nil
		end
	end
end

local function SessionToken(store_name, profile_key, is_mock)
	local session_token = "L_" -- Live

	if is_mock == true then
		session_token = "U_" -- User mock
	elseif DataStoreState ~= "Access" then
		session_token = "M_" -- Mock, cause no DataStore access
	end

	session_token ..= store_name .. "\0" .. profile_key

	return session_token
end

local function DeepCopyTable(t)
	local copy = {}
	for key, value in pairs(t) do
		if type(value) == "table" then
			copy[key] = DeepCopyTable(value)
		else
			copy[key] = value
		end
	end
	return copy
end

local function ReconcileTable(target, template)
	for k, v in pairs(template) do
		if type(k) == "string" then -- Only string keys will be reconciled
			if target[k] == nil then
				if type(v) == "table" then
					target[k] = DeepCopyTable(v)
				else
					target[k] = v
				end
			elseif type(target[k]) == "table" and type(v) == "table" then
				ReconcileTable(target[k], v)
			end
		end
	end
end

local function RegisterError(error_message, store_name, profile_key) -- Called when a DataStore API call errors
	warn(`[{script.Name}]: DataStore API error (STORE:{store_name}; KEY:{profile_key}) - {tostring(error_message)}`)
	table.insert(IssueQueue, os.clock()) -- Adding issue time to queue
	OnError:Fire(tostring(error_message), store_name, profile_key)
end

local function RegisterOverwrite(store_name, profile_key) -- Called when a corrupted profile is loaded
	warn(`[{script.Name}]: Invalid profile was overwritten (STORE:{store_name}; KEY:{profile_key})`)
	OnOverwrite:Fire(store_name, profile_key)
end

local function NewMockDataStoreKeyInfo(params)
	local version_id_string = tostring(params.VersionId or 0)
	local meta_data = params.MetaData or {}
	local user_ids = params.UserIds or {}

	return {
		CreatedTime = params.CreatedTime,
		UpdatedTime = params.UpdatedTime,
		Version = string.rep("0", 16)
			.. "."
			.. string.rep("0", 10 - string.len(version_id_string))
			.. version_id_string
			.. "."
			.. string.rep("0", 16)
			.. "."
			.. "01",

		GetMetadata = function()
			return DeepCopyTable(meta_data)
		end,

		GetUserIds = function()
			return DeepCopyTable(user_ids)
		end,
	}
end

local function MockUpdateAsync(mock_data_store, profile_store_name, key, transform_function, is_get_call) --> loaded_data, key_info
	local profile_store = mock_data_store[profile_store_name]

	if profile_store == nil then
		profile_store = {}
		mock_data_store[profile_store_name] = profile_store
	end

	local epoch_time = math.floor(os.time() * 1000)
	local mock_entry = profile_store[key]
	local mock_entry_was_nil = false

	if mock_entry == nil then
		mock_entry_was_nil = true
		if is_get_call ~= true then
			mock_entry = {
				Data = nil,
				CreatedTime = epoch_time,
				UpdatedTime = epoch_time,
				VersionId = 0,
				UserIds = {},
				MetaData = {},
			}
			profile_store[key] = mock_entry
		end
	end

	local mock_key_info = mock_entry_was_nil == false and NewMockDataStoreKeyInfo(mock_entry) or nil

	local transform, user_ids, roblox_meta_data = transform_function(mock_entry and mock_entry.Data, mock_key_info)

	if transform == nil then
		return nil
	else
		if mock_entry ~= nil and is_get_call ~= true then
			mock_entry.Data = DeepCopyTable(transform)
			mock_entry.UserIds = DeepCopyTable(user_ids or {})
			mock_entry.MetaData = DeepCopyTable(roblox_meta_data or {})
			mock_entry.VersionId += 1
			mock_entry.UpdatedTime = epoch_time
		end

		return DeepCopyTable(transform), mock_entry ~= nil and NewMockDataStoreKeyInfo(mock_entry) or nil
	end
end

local function UpdateAsync(profile_store, profile_key, transform_params, is_user_mock, is_get_call, version) --> loaded_data, key_info
	--transform_params = {
	--	ExistingProfileHandle = function(latest_data),
	--	MissingProfileHandle = function(latest_data),
	--	EditProfile = function(lastest_data),
	--}

	local loaded_data, key_info

	local next_in_queue = WaitInUpdateQueue(SessionToken(profile_store.Name, profile_key, is_user_mock))

	local success = true

	local success, error_message = pcall(function()
		local transform_function = function(latest_data)
			local missing_profile = false
			local overwritten = false
			local global_updates = { 0, {} }

			if latest_data == nil then
				missing_profile = true
			elseif type(latest_data) ~= "table" then
				missing_profile = true
				overwritten = true
			else
				if
					type(latest_data.Data) == "table"
					and type(latest_data.MetaData) == "table"
					and type(latest_data.GlobalUpdates) == "table"
				then
					-- Regular profile structure detected:

					latest_data.WasOverwritten = false -- Must be set to false if set previously
					global_updates = latest_data.GlobalUpdates

					if transform_params.ExistingProfileHandle ~= nil then
						transform_params.ExistingProfileHandle(latest_data)
					end
				elseif
					latest_data.Data == nil
					and latest_data.MetaData == nil
					and type(latest_data.GlobalUpdates) == "table"
				then
					-- Regular structure not detected, but GlobalUpdate data exists:

					latest_data.WasOverwritten = false -- Must be set to false if set previously
					global_updates = latest_data.GlobalUpdates or global_updates
					missing_profile = true
				else
					missing_profile = true
					overwritten = true
				end
			end

			-- Profile was not created or corrupted and no GlobalUpdate data exists:
			if missing_profile == true then
				latest_data = {
					-- Data = nil,
					-- MetaData = nil,
					GlobalUpdates = global_updates,
				}
				if transform_params.MissingProfileHandle ~= nil then
					transform_params.MissingProfileHandle(latest_data)
				end
			end

			-- Editing profile:
			if transform_params.EditProfile ~= nil then
				transform_params.EditProfile(latest_data)
			end

			-- Invalid data handling (Silently override with empty profile)
			if overwritten == true then
				latest_data.WasOverwritten = true -- Temporary tag that will be removed on first save
			end

			return latest_data, latest_data.UserIds, latest_data.RobloxMetaData
		end

		if is_user_mock == true then -- Used when the profile is accessed through ProfileStore.Mock
			loaded_data, key_info =
				MockUpdateAsync(UserMockStore, profile_store.Name, profile_key, transform_function, is_get_call)
			task.wait() -- Simulate API call yield
		elseif DataStoreState ~= "Access" then -- Used when API access is disabled
			loaded_data, key_info =
				MockUpdateAsync(MockStore, profile_store.Name, profile_key, transform_function, is_get_call)
			task.wait() -- Simulate API call yield
		else
			if is_get_call == true then
				if version ~= nil then
					local success, error_message = pcall(function()
						loaded_data, key_info = profile_store.data_store:GetVersionAsync(profile_key, version)
					end)

					if
						success == false
						and type(error_message) == "string"
						and string.find(error_message, "not valid") ~= nil
					then
						warn(`[{script.Name}]: Passed version argument is not valid; Traceback:\n` .. debug.traceback())
					end
				else
					loaded_data, key_info = profile_store.data_store:GetAsync(profile_key)
				end

				loaded_data = transform_function(loaded_data)
			else
				loaded_data, key_info = profile_store.data_store:UpdateAsync(profile_key, transform_function)
			end
		end
	end)

	next_in_queue()

	if success == true and type(loaded_data) == "table" then
		-- Invalid data handling:
		if loaded_data.WasOverwritten == true and is_get_call ~= true then
			RegisterOverwrite(profile_store.Name, profile_key)
		end
		-- Return loaded_data:
		return loaded_data, key_info
	else
		-- Error handling:
		RegisterError(error_message or "Undefined error", profile_store.Name, profile_key)
		-- Return nothing:
		return nil
	end
end

local function IsThisSession(session_tag)
	return session_tag[1] == PlaceId and session_tag[2] == JobId
end

local function ReadMockFlag(): boolean
	local is_mock = MockFlag
	MockFlag = false
	return is_mock
end

local function WaitForStoreReady(profile_store)
	while profile_store.is_ready == false do
		task.wait()
	end
end

local function AddProfileToAutoSave(profile)
	ActiveSessionCheck[profile.session_token] = profile

	-- Add at AutoSaveIndex and move AutoSaveIndex right:

	table.insert(AutoSaveList, AutoSaveIndex, profile)

	if #AutoSaveList > 1 then
		AutoSaveIndex = AutoSaveIndex + 1
	elseif #AutoSaveList == 1 then
		-- First profile created - make sure it doesn't get immediately auto saved:
		LastAutoSave = os.clock()
	end
end

local function RemoveProfileFromAutoSave(profile)
	ActiveSessionCheck[profile.session_token] = nil

	local auto_save_index = table.find(AutoSaveList, profile)

	if auto_save_index ~= nil then
		table.remove(AutoSaveList, auto_save_index)
		if auto_save_index < AutoSaveIndex then
			AutoSaveIndex = AutoSaveIndex - 1 -- Table contents were moved left before AutoSaveIndex so move AutoSaveIndex left as well
		end
		if AutoSaveList[AutoSaveIndex] == nil then -- AutoSaveIndex was at the end of the AutoSaveList - reset to 1
			AutoSaveIndex = 1
		end
	end
end

local function SaveProfileAsync(profile, is_ending_session, is_overwriting, last_save_reason)
	if type(profile.Data) ~= "table" then
		error(
			`[{script.Name}]: Developer code likely set "Profile.Data" to a non-table value! (STORE:{profile.ProfileStore.Name}; KEY:{profile.Key})`
		)
	end

	profile.OnSave:Fire()
	if is_ending_session == true then
		profile.OnLastSave:Fire(last_save_reason or "Manual")
	end

	if is_ending_session == true and is_overwriting ~= true then
		if profile.roblox_message_subscription ~= nil then
			profile.roblox_message_subscription:Disconnect()
		end
		RemoveProfileFromAutoSave(profile)
		profile.OnSessionEnd:Fire()
	end

	ActiveProfileSaveJobs = ActiveProfileSaveJobs + 1

	-- Compare "SessionLoadCount" when writing to profile to prevent a rare case of repeat last save when the profile is loaded on the same server again

	local repeat_save_flag = true -- Released Profile save calls have to repeat until they succeed
	local exp_backoff = 1

	while repeat_save_flag == true do
		if is_ending_session ~= true then
			repeat_save_flag = false
		end

		local loaded_data, key_info = UpdateAsync(profile.ProfileStore, profile.Key, {
			ExistingProfileHandle = nil,
			MissingProfileHandle = nil,
			EditProfile = function(latest_data)
				-- Check if this session still owns the profile:

				local session_owns_profile = false

				if is_overwriting ~= true then
					local active_session = latest_data.MetaData.ActiveSession
					local session_load_count = latest_data.MetaData.SessionLoadCount

					if type(active_session) == "table" then
						session_owns_profile = IsThisSession(active_session)
							and session_load_count == profile.load_index
					end
				else
					session_owns_profile = true
				end

				-- We may only edit the profile if this server has ownership of the profile:

				if session_owns_profile == true then
					-- Clear processed updates (messages):

					local locked_updates = profile.locked_global_updates -- [index] = true, ...
					local active_updates = latest_data.GlobalUpdates[2]
					-- ProfileService module format: {{update_id, version_id, update_locked, update_data}, ...}
					-- ProfileStore module format: {{update_id, update_data}, ...}

					if next(locked_updates) ~= nil then
						local i = 1
						while i <= #active_updates do
							local update = active_updates[i]
							if locked_updates[update[1]] == true then
								table.remove(active_updates, i)
							else
								i += 1
							end
						end
					end

					-- Save profile data:

					latest_data.Data = profile.Data
					latest_data.RobloxMetaData = profile.RobloxMetaData
					latest_data.UserIds = profile.UserIds

					if is_overwriting ~= true then
						latest_data.MetaData.LastUpdate = os.time()

						if is_ending_session == true then
							latest_data.MetaData.ActiveSession = nil
						end
					else
						latest_data.MetaData.ActiveSession = nil
						latest_data.MetaData.ForceLoadSession = nil
					end
				end
			end,
		}, profile.is_mock)

		if loaded_data ~= nil and key_info ~= nil then
			if is_overwriting == true then
				break
			end

			repeat_save_flag = false

			local active_session = loaded_data.MetaData.ActiveSession
			local session_load_count = loaded_data.MetaData.SessionLoadCount
			local session_owns_profile = false

			if type(active_session) == "table" then
				session_owns_profile = IsThisSession(active_session) and session_load_count == profile.load_index
			end

			local force_load_session = loaded_data.MetaData.ForceLoadSession
			local force_load_pending = false
			if type(force_load_session) == "table" then
				force_load_pending = not IsThisSession(force_load_session)
			end

			local is_active = profile:IsActive()

			-- If another server is trying to start a session for this profile - end the session:

			if force_load_pending == true and session_owns_profile == true then
				if is_active == true then
					SaveProfileAsync(profile, true, false, "External")
				end
				break
			end

			-- Clearing processed update list / Detecting new updates:

			local locked_updates = profile.locked_global_updates -- [index] = true, ...
			local received_updates = profile.received_global_updates -- [index] = true, ...
			local active_updates = loaded_data.GlobalUpdates[2]

			local new_updates = {} -- {}, ...
			local still_pending = {} -- [index] = true, ...

			for _, update in ipairs(active_updates) do
				if locked_updates[update[1]] == true then
					still_pending[update[1]] = true
				elseif received_updates[update[1]] ~= true then
					received_updates[update[1]] = true
					table.insert(new_updates, update)
				end
			end

			for index in pairs(locked_updates) do
				if still_pending[index] ~= true then
					locked_updates[index] = nil
				end
			end

			-- Updating profile values:

			profile.KeyInfo = key_info
			profile.LastSavedData = loaded_data.Data
			profile.global_updates = loaded_data.GlobalUpdates and loaded_data.GlobalUpdates[2] or {}

			if session_owns_profile == true then
				if is_active == true and is_ending_session ~= true then
					-- Processing new global updates (messages):

					for _, update in ipairs(new_updates) do
						local index = update[1]
						local update_data = update[#update] -- Backwards compatibility with ProfileService

						for _, handler in ipairs(profile.message_handlers) do
							local is_processed = false
							local processed_callback = function()
								is_processed = true
								locked_updates[index] = true
							end

							local send_update_data = DeepCopyTable(update_data)

							task.spawn(handler, send_update_data, processed_callback)

							if is_processed == true then
								break
							end
						end
					end
				end
			else
				if profile.roblox_message_subscription ~= nil then
					profile.roblox_message_subscription:Disconnect()
				end

				if is_active == true then
					RemoveProfileFromAutoSave(profile)
					profile.OnSessionEnd:Fire()
				end
			end

			profile.OnAfterSave:Fire(profile.LastSavedData)
		elseif repeat_save_flag == true then
			-- DataStore call likely resulted in an error; Repeat the DataStore call shortly
			task.wait(exp_backoff)
			exp_backoff = math.min(if last_save_reason == "Shutdown" then 8 else 20, exp_backoff * 2)
		end
	end

	ActiveProfileSaveJobs = ActiveProfileSaveJobs - 1
end

----- Public -----

--[[
	Saved profile structure:
	
	{
		Data = {},
		
		MetaData = {
			ProfileCreateTime = 0,
			SessionLoadCount = 0,
			ActiveSession = {place_id, game_job_id, unique_session_id} / nil,
			ForceLoadSession = {place_id, game_job_id} / nil,
			LastUpdate = 0, -- os.time()
			MetaTags = {}, -- Backwards compatibility with ProfileService
		},
		
		RobloxMetaData = {},
		UserIds = {},
		
		GlobalUpdates = {
			update_index,
			{
				{update_index, data}, ...
			},
		},
	}

--]]

export type Profile<T> = {
	Data: T & { [any]: any },
	LastSavedData: T & { [any]: any },
	FirstSessionTime: number,
	SessionLoadCount: number,
	Session: { PlaceId: number, JobId: string }?,
	RobloxMetaData: { [any]: any },
	UserIds: { [any]: any },
	KeyInfo: DataStoreKeyInfo,
	OnSave: { Connect: (self: any, listener: () -> ()) -> { Disconnect: (self: any) -> () } },
	OnLastSave: {
		Connect: (
			self: any,
			listener: (reason: "Manual" | "External" | "Shutdown") -> ()
		) -> { Disconnect: (self: any) -> () },
	},
	OnSessionEnd: { Connect: (self: any, listener: () -> ()) -> { Disconnect: (self: any) -> () } },
	OnAfterSave: {
		Connect: (self: any, listener: (last_saved_data: T & { [any]: any }) -> ()) -> (
			{ Disconnect: (self: any) -> () }
		),
	},
	ProfileStore: { [any]: any },
	Key: string,

	IsActive: (self: any) -> boolean,
	Reconcile: (self: any) -> (),
	EndSession: (self: any) -> (),
	AddUserId: (self: any, user_id: number) -> (),
	RemoveUserId: (self: any, user_id: number) -> (),
	MessageHandler: (self: any, fn: (message: { [any]: any }, processed: () -> ()) -> ()) -> (),
	Save: (self: any) -> (),
	SetAsync: (self: any) -> (),
}

export type VersionQuery<T> = {
	NextAsync: (self: any) -> Profile<T>?,
}

type ProfileStoreStandard<T> = {
	Name: string,
	StartSessionAsync: (self: any, profile_key: string, params: { Steal: boolean? }) -> Profile<T>?,
	MessageAsync: (self: any, profile_key: string, message: { [any]: any }) -> boolean,
	GetAsync: (self: any, profile_key: string, version: string?) -> Profile<T>?,
	VersionQuery: (
		self: any,
		profile_key: string,
		sort_direction: Enum.SortDirection?,
		min_date: DateTime | number | nil,
		max_date: DateTime | number | nil
	) -> VersionQuery<T>,
	RemoveAsync: (self: any, profile_key: string) -> boolean,
}

export type ProfileStore<T> = {
	Mock: ProfileStoreStandard<T>,
} & ProfileStoreStandard<T>

type ConstantName =
	"AUTO_SAVE_PERIOD"
	| "LOAD_REPEAT_PERIOD"
	| "FIRST_LOAD_REPEAT"
	| "SESSION_STEAL"
	| "ASSUME_DEAD"
	| "START_SESSION_TIMEOUT"
	| "CRITICAL_STATE_ERROR_COUNT"
	| "CRITICAL_STATE_ERROR_EXPIRE"
	| "CRITICAL_STATE_EXPIRE"
	| "MAX_MESSAGE_QUEUE"

export type ProfileStoreModule = {
	IsClosing: boolean,
	IsCriticalState: boolean,
	OnError: {
		Connect: (
			self: any,
			listener: (message: string, store_name: string, profile_key: string) -> ()
		) -> { Disconnect: (self: any) -> () },
	},
	OnOverwrite: {
		Connect: (
			self: any,
			listener: (store_name: string, profile_key: string) -> ()
		) -> { Disconnect: (self: any) -> () },
	},
	OnCriticalToggle: { Connect: (
		self: any,
		listener: (is_critical: boolean) -> ()
	) -> { Disconnect: (self: any) -> () } },
	DataStoreState: "NotReady" | "NoInternet" | "NoAccess" | "Access",
	New: <T>(store_name: string, template: T?) -> ProfileStore<T>,
	SetConstant: (name: ConstantName, value: number) -> (),
}

local Profile = {}
Profile.__index = Profile

function Profile.New(raw_data, key_info, profile_store, key, is_mock, session_token)
	local data = raw_data.Data or {}
	local session = raw_data.MetaData and raw_data.MetaData.ActiveSession or nil

	local global_updates = raw_data.GlobalUpdates and raw_data.GlobalUpdates[2] or {}
	local received_global_updates = {}

	for _, update in ipairs(global_updates) do
		received_global_updates[update[1]] = true
	end

	local self = {

		Data = data,
		LastSavedData = DeepCopyTable(data),

		FirstSessionTime = raw_data.MetaData and raw_data.MetaData.ProfileCreateTime or 0,
		SessionLoadCount = raw_data.MetaData and raw_data.MetaData.SessionLoadCount or 0,
		Session = session and { PlaceId = session[1], JobId = session[2] },

		RobloxMetaData = raw_data.RobloxMetaData or {},
		UserIds = raw_data.UserIds or {},
		KeyInfo = key_info,

		OnAfterSave = Signal.New(),
		OnSave = Signal.New(),
		OnLastSave = Signal.New(),
		OnSessionEnd = Signal.New(),

		ProfileStore = profile_store,
		Key = key,

		load_timestamp = os.clock(),
		is_mock = is_mock,
		session_token = session_token or "",
		load_index = raw_data.MetaData and raw_data.MetaData.SessionLoadCount or 0,
		locked_global_updates = {},
		received_global_updates = received_global_updates,
		message_handlers = {},
		global_updates = global_updates,
	}
	setmetatable(self, Profile)

	return self
end

function Profile:IsActive()
	return ActiveSessionCheck[self.session_token] == self
end

function Profile:Reconcile()
	ReconcileTable(self.Data, self.ProfileStore.template)
end

function Profile:EndSession()
	if self:IsActive() == true then
		task.spawn(SaveProfileAsync, self, true, nil, "Manual") -- Call save function in a new thread with release_from_session = true
	end
end

function Profile:AddUserId(user_id) -- Associates user_id with profile (GDPR compliance)
	if type(user_id) ~= "number" or user_id % 1 ~= 0 then
		warn(
			`[{script.Name}]: Invalid UserId argument for :AddUserId() ({tostring(user_id)}); Traceback:\n`
				.. debug.traceback()
		)
		return
	end

	if user_id < 0 and self.is_mock ~= true and DataStoreState == "Access" then
		return -- Avoid giving real Roblox APIs negative UserId's
	end

	if table.find(self.UserIds, user_id) == nil then
		table.insert(self.UserIds, user_id)
	end
end

function Profile:RemoveUserId(user_id) -- Unassociates user_id with profile (safe function)
	if type(user_id) ~= "number" or user_id % 1 ~= 0 then
		warn(
			`[{script.Name}]: Invalid UserId argument for :RemoveUserId() ({tostring(user_id)}); Traceback:\n`
				.. debug.traceback()
		)
		return
	end

	local index = table.find(self.UserIds, user_id)

	if index ~= nil then
		table.remove(self.UserIds, index)
	end
end

function Profile:SetAsync() -- Saves the profile to the DataStore and removes the session lock
	if self.view_mode ~= true then
		error(`[{script.Name}]: :SetAsync() can only be used in view mode`)
	end

	SaveProfileAsync(self, nil, true)
end

function Profile:MessageHandler(fn)
	if type(fn) ~= "function" then
		error(`[{script.Name}]: fn argument is not a function`)
	end

	if self.view_mode ~= true and self:IsActive() ~= true then
		return -- Don't process messages if the profile session was ended
	end

	local locked_updates = self.locked_global_updates
	table.insert(self.message_handlers, fn)

	for _, update in ipairs(self.global_updates) do
		local index = update[1]
		local update_data = update[#update] -- Backwards compatibility with ProfileService

		if locked_updates[index] ~= true then
			local processed_callback = function()
				locked_updates[index] = true
			end

			local send_update_data = DeepCopyTable(update_data)

			task.spawn(fn, send_update_data, processed_callback)
		end
	end
end

function Profile:Save()
	if self.view_mode == true then
		error(`[{script.Name}]: Can't save profile in view mode; Should you be calling :SetAsync() instead?`)
	end

	if self:IsActive() == false then
		warn(
			`[{script.Name}]: Attempted saving an inactive profile (STORE:{self.ProfileStore.Name}; KEY:{self.Key});`
				.. ` Traceback:\n`
				.. debug.traceback()
		)
		return
	end

	-- Move the profile right behind the auto save index to delay the next auto save for it:
	RemoveProfileFromAutoSave(self)
	AddProfileToAutoSave(self)

	-- Perform save in new thread:
	task.spawn(SaveProfileAsync, self)
end

local ProfileStore: ProfileStoreModule = {

	IsClosing = false,
	IsCriticalState = false,
	OnError = OnError, -- (message, store_name, profile_key)
	OnOverwrite = OnOverwrite, -- (store_name, profile_key)
	OnCriticalToggle = Signal.New(), -- (is_critical)
	DataStoreState = "NotReady", -- ("NotReady", "NoInternet", "NoAccess", "Access")
}
ProfileStore.__index = ProfileStore

function ProfileStore.SetConstant(name, value)
	if type(value) ~= "number" then
		error(`[{script.Name}]: Invalid value type`)
	end

	if name == "AUTO_SAVE_PERIOD" then
		AUTO_SAVE_PERIOD = value
	elseif name == "LOAD_REPEAT_PERIOD" then
		LOAD_REPEAT_PERIOD = value
	elseif name == "FIRST_LOAD_REPEAT" then
		FIRST_LOAD_REPEAT = value
	elseif name == "SESSION_STEAL" then
		SESSION_STEAL = value
	elseif name == "ASSUME_DEAD" then
		ASSUME_DEAD = value
	elseif name == "START_SESSION_TIMEOUT" then
		START_SESSION_TIMEOUT = value
	elseif name == "CRITICAL_STATE_ERROR_COUNT" then
		CRITICAL_STATE_ERROR_COUNT = value
	elseif name == "CRITICAL_STATE_ERROR_EXPIRE" then
		CRITICAL_STATE_ERROR_EXPIRE = value
	elseif name == "CRITICAL_STATE_EXPIRE" then
		CRITICAL_STATE_EXPIRE = value
	elseif name == "MAX_MESSAGE_QUEUE" then
		MAX_MESSAGE_QUEUE = value
	else
		error(`[{script.Name}]: Invalid constant name was provided`)
	end
end

function ProfileStore.Test()
	return {
		ActiveSessionCheck = ActiveSessionCheck,
		AutoSaveList = AutoSaveList,
		ActiveProfileLoadJobs = ActiveProfileLoadJobs,
		ActiveProfileSaveJobs = ActiveProfileSaveJobs,
		MockStore = MockStore,
		UserMockStore = UserMockStore,
		UpdateQueue = UpdateQueue,
	}
end

function ProfileStore.New(store_name, template)
	template = template or {}

	if type(store_name) ~= "string" then
		error(`[{script.Name}]: Invalid or missing "store_name"`)
	elseif string.len(store_name) == 0 then
		error(`[{script.Name}]: store_name cannot be an empty string`)
	elseif string.len(store_name) > 50 then
		error(`[{script.Name}]: store_name is too long`)
	end

	if type(template) ~= "table" then
		error(`[{script.Name}]: Invalid template argument`)
	end

	local self
	self = {

		Mock = {

			Name = store_name,

			StartSessionAsync = function(_, profile_key)
				MockFlag = true
				return self:StartSessionAsync(profile_key)
			end,
			MessageAsync = function(_, profile_key, message)
				MockFlag = true
				return self:MessageAsync(profile_key, message)
			end,
			GetAsync = function(_, profile_key, version)
				MockFlag = true
				return self:GetAsync(profile_key, version)
			end,
			VersionQuery = function(_, profile_key, sort_direction, min_date, max_date)
				MockFlag = true
				return self:VersionQuery(profile_key, sort_direction, min_date, max_date)
			end,
			RemoveAsync = function(_, profile_key)
				MockFlag = true
				return self:RemoveAsync(profile_key)
			end,
		},

		Name = store_name,

		template = template,
		data_store = nil,
		load_jobs = {},
		mock_load_jobs = {},
		is_ready = true,
	}
	setmetatable(self, ProfileStore)

	local options = Instance.new("DataStoreOptions")
	options:SetExperimentalFeatures({ v2 = true })

	if DataStoreState == "NotReady" then
		-- The module is not sure whether DataStores are accessible yet:

		self.is_ready = false

		task.spawn(function()
			repeat
				task.wait()
			until DataStoreState ~= "NotReady"

			if DataStoreState == "Access" then
				self.data_store = DataStoreService:GetDataStore(store_name, nil, options)
			end

			self.is_ready = true
		end)
	elseif DataStoreState == "Access" then
		self.data_store = DataStoreService:GetDataStore(store_name, nil, options)
	end

	return self
end

function ProfileStore:StartSessionAsync(profile_key, params)
	local is_mock = ReadMockFlag()

	if type(profile_key) ~= "string" then
		error(`[{script.Name}]: profile_key must be a string`)
	elseif string.len(profile_key) == 0 then
		error(`[{script.Name}]: Invalid profile_key`)
	elseif string.len(profile_key) > 50 then
		error(`[{script.Name}]: profile_key is too long`)
	end

	if params ~= nil and type(params) ~= "table" then
		error(`[{script.Name}]: Invalid params`)
	end

	params = params or {}

	if ProfileStore.IsClosing == true then
		return nil
	end

	WaitForStoreReady(self)

	local session_token = SessionToken(self.Name, profile_key, is_mock)

	if ActiveSessionCheck[session_token] ~= nil then
		error(`[{script.Name}]: Profile (STORE:{self.Name}; KEY:{profile_key}) is already loaded in this session`)
	end

	ActiveProfileLoadJobs = ActiveProfileLoadJobs + 1

	local is_user_cancel = false

	local function cancel_condition()
		if is_user_cancel == false then
			if params.Cancel ~= nil then
				is_user_cancel = params.Cancel() == true
			end
			return is_user_cancel
		end
		return true
	end

	local user_steal = params.Steal == true

	local force_load_steps = 0 -- Session conflict handling values
	local request_force_load = true
	local steal_session = false

	local start = os.clock()
	local exp_backoff = 1

	while ProfileStore.IsClosing == false and cancel_condition() == false do
		-- Load profile:

		-- SPECIAL CASE - If StartSessionAsync is called for the same key again before another StartSessionAsync finishes,
		-- grab the DataStore return for the new call. The early call will return nil. This is supposed to retain
		-- expected and efficient behaviour in cases where a player would quickly rejoin the same server.

		LoadIndex += 1
		local load_id = LoadIndex
		local profile_load_jobs = is_mock == true and self.mock_load_jobs or self.load_jobs
		local profile_load_job = profile_load_jobs[profile_key] -- {load_id, {loaded_data, key_info} or nil}

		local loaded_data, key_info
		local unique_session_id = HttpService:GenerateGUID(false)

		if profile_load_job ~= nil then
			profile_load_job[1] = load_id -- Steal load job
			while profile_load_job[2] == nil do -- Wait for job to finish
				task.wait()
			end
			if profile_load_job[1] == load_id then -- Load job hasn't been double-stolen
				loaded_data, key_info = table.unpack(profile_load_job[2])
				profile_load_jobs[profile_key] = nil
			else
				ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
				return nil
			end
		else
			profile_load_job = { load_id, nil }
			profile_load_jobs[profile_key] = profile_load_job

			profile_load_job[2] = table.pack(UpdateAsync(self, profile_key, {
				ExistingProfileHandle = function(latest_data)
					if ProfileStore.IsClosing == true or cancel_condition() == true then
						return
					end

					local active_session = latest_data.MetaData.ActiveSession
					local force_load_session = latest_data.MetaData.ForceLoadSession

					if active_session == nil then
						latest_data.MetaData.ActiveSession = { PlaceId, JobId, unique_session_id }
						latest_data.MetaData.ForceLoadSession = nil
					elseif type(active_session) == "table" then
						if IsThisSession(active_session) == false then
							local last_update = latest_data.MetaData.LastUpdate
							if last_update ~= nil then
								if os.time() - last_update > ASSUME_DEAD then
									latest_data.MetaData.ActiveSession = { PlaceId, JobId, unique_session_id }
									latest_data.MetaData.ForceLoadSession = nil
									return
								end
							end
							if steal_session == true or user_steal == true then
								local force_load_interrupted = if force_load_session ~= nil
									then not IsThisSession(force_load_session)
									else true
								if force_load_interrupted == false or user_steal == true then
									latest_data.MetaData.ActiveSession = { PlaceId, JobId, unique_session_id }
									latest_data.MetaData.ForceLoadSession = nil
								end
							elseif request_force_load == true then
								latest_data.MetaData.ForceLoadSession = { PlaceId, JobId }
							end
						else
							latest_data.MetaData.ForceLoadSession = nil
						end
					end
				end,
				MissingProfileHandle = function(latest_data)
					local is_cancel = ProfileStore.IsClosing == true or cancel_condition() == true

					latest_data.Data = DeepCopyTable(self.template)
					latest_data.MetaData = {
						ProfileCreateTime = os.time(),
						SessionLoadCount = 0,
						ActiveSession = if is_cancel == false then { PlaceId, JobId, unique_session_id } else nil,
						ForceLoadSession = nil,
						MetaTags = {}, -- Backwards compatibility with ProfileService
					}
				end,
				EditProfile = function(latest_data)
					if ProfileStore.IsClosing == true or cancel_condition() == true then
						return
					end

					local active_session = latest_data.MetaData.ActiveSession
					if active_session ~= nil and IsThisSession(active_session) == true then
						latest_data.MetaData.SessionLoadCount = latest_data.MetaData.SessionLoadCount + 1
						latest_data.MetaData.LastUpdate = os.time()
					end
				end,
			}, is_mock))
			if profile_load_job[1] == load_id then -- Load job hasn't been stolen
				loaded_data, key_info = table.unpack(profile_load_job[2])
				profile_load_jobs[profile_key] = nil
			else
				ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
				return nil -- Load job stolen
			end
		end

		-- Handle load_data:

		if loaded_data ~= nil and key_info ~= nil then
			local active_session = loaded_data.MetaData.ActiveSession
			if type(active_session) == "table" then
				if IsThisSession(active_session) == true then
					-- Profile is now taken by this session:

					local profile = Profile.New(loaded_data, key_info, self, profile_key, is_mock, session_token)
					AddProfileToAutoSave(profile)

					if is_mock ~= true and DataStoreState == "Access" then
						-- Use MessagingService to quickly detect session conflicts and resolve them quickly:

						local last_roblox_message = 0

						profile.roblox_message_subscription = MessagingService:SubscribeAsync(
							"PS_" .. unique_session_id,
							function(message)
								if
									type(message.Data) == "table"
									and message.Data.LoadCount == profile.SessionLoadCount
								then
									-- High reaction rate, based on numPlayers × 10 DataStore budget as of writing
									if os.clock() - last_roblox_message > 6 then
										last_roblox_message = os.clock()
										if profile:IsActive() == true then
											if message.Data.EndSession == true then
												SaveProfileAsync(profile, true, false, "External")
											else
												profile:Save()
											end
										end
									end
								end
							end
						)
					end

					if ProfileStore.IsClosing == true or cancel_condition() == true then
						-- The server has initiated a shutdown by the time this profile was loaded
						SaveProfileAsync(profile, true) -- Release profile and yield until the DataStore call is finished
						profile = nil -- Don't return the profile object
					end

					ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
					return profile
				else
					if ProfileStore.IsClosing == true or cancel_condition() == true then
						ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
						return nil
					end

					-- Profile is taken by some other session:

					local force_load_session = loaded_data.MetaData.ForceLoadSession
					local force_load_interrupted = if force_load_session ~= nil
						then not IsThisSession(force_load_session)
						else true

					if force_load_interrupted == false then
						if request_force_load == false then
							force_load_steps = force_load_steps + 1
							if force_load_steps >= math.ceil(SESSION_STEAL / LOAD_REPEAT_PERIOD) then
								steal_session = true
							end
						end

						-- Request the remote server to end its session:
						if type(active_session[3]) == "string" then
							local session_load_count = loaded_data.MetaData.SessionLoadCount or 0
							MessagingService:PublishAsync(
								"PS_" .. active_session[3],
								{ LoadCount = session_load_count, EndSession = true }
							)
						end

						-- Attempt to load the profile again after a delay
						local wait_until = os.clock()
							+ if request_force_load == true then FIRST_LOAD_REPEAT else LOAD_REPEAT_PERIOD
						repeat
							task.wait()
						until os.clock() >= wait_until or ProfileStore.IsClosing == true
					else
						-- Another session tried to load this profile:
						ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
						return nil
					end

					request_force_load = false -- Only request a force load once
				end
			else
				ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
				return nil -- In this scenario it is likely that this server started shutting down
			end
		else
			-- A DataStore call has likely ended in an error:

			local default_timeout = false

			if params.Cancel == nil then
				default_timeout = os.clock() - start >= START_SESSION_TIMEOUT
			end

			if default_timeout == true or ProfileStore.IsClosing == true or cancel_condition() == true then
				ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
				return nil
			end

			task.wait(exp_backoff) -- Repeat the call shortly
			exp_backoff = math.min(20, exp_backoff * 2)
		end
	end

	ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
	return nil -- Game started shutting down or the request was cancelled - don't return the profile
end

function ProfileStore:MessageAsync(profile_key, message)
	local is_mock = ReadMockFlag()

	if type(profile_key) ~= "string" then
		error(`[{script.Name}]: profile_key must be a string`)
	elseif string.len(profile_key) == 0 then
		error(`[{script.Name}]: Invalid profile_key`)
	elseif string.len(profile_key) > 50 then
		error(`[{script.Name}]: profile_key is too long`)
	end

	if type(message) ~= "table" then
		error(`[{script.Name}]: message must be a table`)
	end

	if ProfileStore.IsClosing == true then
		return false
	end

	WaitForStoreReady(self)

	local exp_backoff = 1

	while ProfileStore.IsClosing == false do
		-- Updating profile:

		local loaded_data = UpdateAsync(self, profile_key, {
			ExistingProfileHandle = nil,
			MissingProfileHandle = nil,
			EditProfile = function(latest_data)
				local global_updates = latest_data.GlobalUpdates
				local update_list = global_updates[2]
				--{
				--	update_index,
				--	{
				--		{update_index, data}, ...
				--	},
				--},

				global_updates[1] += 1
				table.insert(update_list, { global_updates[1], message })

				-- Clearing queue if above limit:

				while #update_list > MAX_MESSAGE_QUEUE do
					table.remove(update_list, 1)
				end
			end,
		}, is_mock)

		if loaded_data ~= nil then
			local session_token = SessionToken(self.Name, profile_key, is_mock)

			local profile = ActiveSessionCheck[session_token]

			if profile ~= nil then
				-- The message was sent to a profile that is active in this server:
				profile:Save()
			else
				local meta_data = loaded_data.MetaData or {}
				local active_session = meta_data.ActiveSession
				local session_load_count = meta_data.SessionLoadCount or 0

				if type(active_session) == "table" and type(active_session[3]) == "string" then
					-- Request the remote server to auto-save sooner and receive the message:
					MessagingService:PublishAsync("PS_" .. active_session[3], { LoadCount = session_load_count })
				end
			end

			return true
		else
			task.wait(exp_backoff) -- A DataStore call has likely ended in an error - repeat the call shortly
			exp_backoff = math.min(20, exp_backoff * 2)
		end
	end

	return false
end

function ProfileStore:GetAsync(profile_key, version)
	local is_mock = ReadMockFlag()

	if type(profile_key) ~= "string" then
		error(`[{script.Name}]: profile_key must be a string`)
	elseif string.len(profile_key) == 0 then
		error(`[{script.Name}]: Invalid profile_key`)
	elseif string.len(profile_key) > 50 then
		error(`[{script.Name}]: profile_key is too long`)
	end

	if ProfileStore.IsClosing == true then
		return nil
	end

	WaitForStoreReady(self)

	if version ~= nil and (is_mock or DataStoreState ~= "Access") then
		return nil -- No version support in mock mode
	end

	local exp_backoff = 1

	while ProfileStore.IsClosing == false do
		-- Load profile:

		local loaded_data, key_info = UpdateAsync(
			self,
			profile_key,
			{
				ExistingProfileHandle = nil,
				MissingProfileHandle = function(latest_data)
					latest_data.Data = DeepCopyTable(self.template)
					latest_data.MetaData = {
						ProfileCreateTime = os.time(),
						SessionLoadCount = 0,
						ActiveSession = nil,
						ForceLoadSession = nil,
						MetaTags = {}, -- Backwards compatibility with ProfileService
					}
				end,
				EditProfile = nil,
			},
			is_mock,
			true, -- Use :GetAsync()
			version -- DataStore key version
		)

		-- Handle load_data:

		if loaded_data ~= nil then
			if key_info == nil then
				return nil -- Load was successful, but the key was empty - return no profile object
			end

			local profile = Profile.New(loaded_data, key_info, self, profile_key, is_mock)
			profile.view_mode = true

			return profile
		else
			task.wait(exp_backoff) -- A DataStore call has likely ended in an error - repeat the call shortly
			exp_backoff = math.min(20, exp_backoff * 2)
		end
	end

	return nil -- Game started shutting down - don't return the profile
end

function ProfileStore:RemoveAsync(profile_key)
	local is_mock = ReadMockFlag()

	if type(profile_key) ~= "string" or string.len(profile_key) == 0 then
		error(`[{script.Name}]: Invalid profile_key`)
	end

	if ProfileStore.IsClosing == true then
		return false
	end

	WaitForStoreReady(self)

	local wipe_status = false

	local next_in_queue = WaitInUpdateQueue(SessionToken(self.Name, profile_key, is_mock))

	if is_mock == true then -- Used when the profile is accessed through ProfileStore.Mock
		local mock_data_store = UserMockStore[self.Name]

		if mock_data_store ~= nil then
			mock_data_store[profile_key] = nil
			if next(mock_data_store) == nil then
				UserMockStore[self.Name] = nil
			end
		end

		wipe_status = true
		task.wait() -- Simulate API call yield
	elseif DataStoreState ~= "Access" then -- Used when API access is disabled
		local mock_data_store = MockStore[self.Name]

		if mock_data_store ~= nil then
			mock_data_store[profile_key] = nil
			if next(mock_data_store) == nil then
				MockStore[self.Name] = nil
			end
		end

		wipe_status = true
		task.wait() -- Simulate API call yield
	else -- Live DataStore
		wipe_status = pcall(function()
			self.data_store:RemoveAsync(profile_key)
		end)
	end

	next_in_queue()

	return wipe_status
end

local ProfileVersionQuery = {}
ProfileVersionQuery.__index = ProfileVersionQuery

function ProfileVersionQuery.New(profile_store, profile_key, sort_direction, min_date, max_date)
	local self = {
		profile_store = profile_store,
		profile_key = profile_key,
		sort_direction = sort_direction,
		min_date = min_date,
		max_date = max_date,

		query_pages = nil,
		query_index = 0,
		query_failure = false,

		is_query_yielded = false,
		query_queue = {},
	}
	setmetatable(self, ProfileVersionQuery)

	return self
end

function MoveVersionQueryQueue(self) -- Hidden ProfileVersionQuery method
	while #self.query_queue > 0 do
		local queue_entry = table.remove(self.query_queue, 1)

		task.spawn(queue_entry)

		if self.is_query_yielded == true then
			break
		end
	end
end

local VersionQueryNextAsyncStackingFlag = false

function ProfileVersionQuery:NextAsync()
	local is_stacking = VersionQueryNextAsyncStackingFlag == true
	VersionQueryNextAsyncStackingFlag = false

	if self.profile_store == nil then
		return nil
	end

	WaitForStoreReady(self.profile_store)

	local profile
	local is_finished = false

	local function query_job()
		if self.query_failure == true then
			is_finished = true
			return
		end

		-- First "next" call loads version pages:

		if self.query_pages == nil then
			self.is_query_yielded = true

			task.spawn(function()
				VersionQueryNextAsyncStackingFlag = true
				profile = self:NextAsync()
				is_finished = true
			end)

			local list_success, error_message = pcall(function()
				self.query_pages = self.profile_store.data_store:ListVersionsAsync(
					self.profile_key,
					self.sort_direction,
					self.min_date,
					self.max_date
				)
				self.query_index = 0
			end)

			if list_success == false or self.query_pages == nil then
				warn(`[{script.Name}]: Version query fail - {tostring(error_message)}`)
				self.query_failure = true
			end

			self.is_query_yielded = false

			MoveVersionQueryQueue(self)

			return
		end

		local current_page = self.query_pages:GetCurrentPage()
		local next_item = current_page[self.query_index + 1]

		-- No more entries:

		if self.query_pages.IsFinished == true and next_item == nil then
			is_finished = true
			return
		end

		-- Load next page when this page is over:

		if next_item == nil then
			self.is_query_yielded = true
			task.spawn(function()
				VersionQueryNextAsyncStackingFlag = true
				profile = self:NextAsync()
				is_finished = true
			end)

			local success, error_message = pcall(function()
				self.query_pages:AdvanceToNextPageAsync()
				self.query_index = 0
			end)

			if success == false or #self.query_pages:GetCurrentPage() == 0 then
				self.query_failure = true
			end

			self.is_query_yielded = false
			MoveVersionQueryQueue(self)

			return
		end

		-- Next page item:

		self.query_index += 1
		profile = self.profile_store:GetAsync(self.profile_key, next_item.Version)
		is_finished = true
	end

	if self.is_query_yielded == false then
		query_job()
	else
		if is_stacking == true then
			table.insert(self.query_queue, 1, query_job)
		else
			table.insert(self.query_queue, query_job)
		end
	end

	while is_finished == false do
		task.wait()
	end

	return profile
end

local WarnAboutVersionQueryOnce = false

function ProfileStore:VersionQuery(profile_key, sort_direction, min_date, max_date)
	local is_mock = ReadMockFlag()

	if type(profile_key) ~= "string" or string.len(profile_key) == 0 then
		error(`[{script.Name}]: Invalid profile_key`)
	end

	if ProfileStore.IsClosing == true then
		return setmetatable({}, ProfileVersionQuery) -- Silently fail :NextAsync() requests
	end

	if is_mock or DataStoreState ~= "Access" then
		if IsStudio == true and WarnAboutVersionQueryOnce == false then
			WarnAboutVersionQueryOnce = true
			warn(`[{script.Name}]: :VersionQuery() is not supported in mock mode!`)
		end
		return setmetatable({}, ProfileVersionQuery) -- Silently fail :NextAsync() requests
	end

	-- Type check:

	if
		sort_direction ~= nil
		and (typeof(sort_direction) ~= "EnumItem" or sort_direction.EnumType ~= Enum.SortDirection)
	then
		error(`[{script.Name}]: Invalid sort_direction ({tostring(sort_direction)})`)
	end

	if min_date ~= nil and typeof(min_date) ~= "DateTime" and typeof(min_date) ~= "number" then
		error(`[{script.Name}]: Invalid min_date ({tostring(min_date)})`)
	end

	if max_date ~= nil and typeof(max_date) ~= "DateTime" and typeof(max_date) ~= "number" then
		error(`[{script.Name}]: Invalid max_date ({tostring(max_date)})`)
	end

	min_date = typeof(min_date) == "DateTime" and min_date.UnixTimestampMillis or min_date
	max_date = typeof(max_date) == "DateTime" and max_date.UnixTimestampMillis or max_date

	return ProfileVersionQuery.New(self, profile_key, sort_direction, min_date, max_date)
end

-- DataStore API access check:

if IsStudio == true then
	task.spawn(function()
		local new_state = "NoAccess"

		local status, message = pcall(function()
			-- This will error if current instance has no Studio API access:
			DataStoreService:GetDataStore("____PS"):SetAsync("____PS", os.time())
		end)

		local no_internet_access = status == false and string.find(message, "ConnectFail", 1, true) ~= nil

		if no_internet_access == true then
			warn(`[{script.Name}]: No internet access - check your network connection`)
		end

		if
			status == false
			and (
				string.find(message, "403", 1, true) ~= nil -- Cannot write to DataStore from studio if API access is not enabled
				or string.find(message, "must publish", 1, true) ~= nil -- Game must be published to access live keys
				or no_internet_access == true
			)
		then -- No internet access
			new_state = if no_internet_access == true then "NoInternet" else "NoAccess"
			print(`[{script.Name}]: Roblox API services unavailable - data will not be saved`)
		else
			new_state = "Access"
			print(`[{script.Name}]: Roblox API services available - data will be saved`)
		end

		DataStoreState = new_state
		ProfileStore.DataStoreState = new_state
	end)
else
	DataStoreState = "Access"
	ProfileStore.DataStoreState = "Access"
end

-- Update loop:

RunService.Heartbeat:Connect(function()
	-- Auto saving:

	local auto_save_list_length = #AutoSaveList
	if auto_save_list_length > 0 then
		local auto_save_index_speed = AUTO_SAVE_PERIOD / auto_save_list_length
		local os_clock = os.clock()
		while os_clock - LastAutoSave > auto_save_index_speed do
			LastAutoSave = LastAutoSave + auto_save_index_speed
			local profile = AutoSaveList[AutoSaveIndex]
			if os_clock - profile.load_timestamp < AUTO_SAVE_PERIOD / 2 then
				-- This profile is freshly loaded - auto saving immediately is not necessary:
				profile = nil
				for _ = 1, auto_save_list_length - 1 do
					-- Move auto save index to the right:
					AutoSaveIndex = AutoSaveIndex + 1
					if AutoSaveIndex > auto_save_list_length then
						AutoSaveIndex = 1
					end
					profile = AutoSaveList[AutoSaveIndex]
					if os_clock - profile.load_timestamp >= AUTO_SAVE_PERIOD / 2 then
						break
					else
						profile = nil
					end
				end
			end
			-- Move auto save index to the right:
			AutoSaveIndex = AutoSaveIndex + 1
			if AutoSaveIndex > auto_save_list_length then
				AutoSaveIndex = 1
			end
			-- Perform save call:
			if profile ~= nil then
				task.spawn(SaveProfileAsync, profile) -- Auto save profile in new thread
			end
		end
	end

	-- Critical state handling:

	if ProfileStore.IsCriticalState == false then
		if #IssueQueue >= CRITICAL_STATE_ERROR_COUNT then
			ProfileStore.IsCriticalState = true
			ProfileStore.OnCriticalToggle:Fire(true)
			CriticalStateStart = os.clock()
			warn(`[{script.Name}]: Entered critical state`)
		end
	else
		if #IssueQueue >= CRITICAL_STATE_ERROR_COUNT then
			CriticalStateStart = os.clock()
		elseif os.clock() - CriticalStateStart > CRITICAL_STATE_EXPIRE then
			ProfileStore.IsCriticalState = false
			ProfileStore.OnCriticalToggle:Fire(false)
			warn(`[{script.Name}]: Critical state ended`)
		end
	end

	-- Issue queue:

	while true do
		local issue_time = IssueQueue[1]
		if issue_time == nil then
			break
		elseif os.clock() - issue_time > CRITICAL_STATE_ERROR_EXPIRE then
			table.remove(IssueQueue, 1)
		else
			break
		end
	end
end)

-- Release all loaded profiles when the server is shutting down:

task.spawn(function()
	while DataStoreState == "NotReady" do
		task.wait()
	end

	if DataStoreState ~= "Access" then
		game:BindToClose(function()
			ProfileStore.IsClosing = true
			task.wait() -- Mock shutdown delay
		end)

		return -- Don't wait for profiles to properly save in mock mode so studio could end the simulation faster
	end

	game:BindToClose(function()
		ProfileStore.IsClosing = true

		-- Release all active profiles:
		-- (Clone AutoSaveList to a new table because AutoSaveList changes when profiles are released)

		local on_close_save_job_count = 0
		local active_profiles = {}
		for index, profile in ipairs(AutoSaveList) do
			active_profiles[index] = profile
		end

		-- Release the profiles; Releasing profiles can trigger listeners that release other profiles, so check active state:
		for _, profile in ipairs(active_profiles) do
			if profile:IsActive() == true then
				on_close_save_job_count = on_close_save_job_count + 1
				task.spawn(function() -- Save profile on new thread
					SaveProfileAsync(profile, true, nil, "Shutdown")
					on_close_save_job_count = on_close_save_job_count - 1
				end)
			end
		end

		-- Yield until all active profile jobs are finished:
		while on_close_save_job_count > 0 or ActiveProfileLoadJobs > 0 or ActiveProfileSaveJobs > 0 do
			task.wait()
		end

		return -- We're done!
	end)
end)

return ProfileStore
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="67">
        <Properties>
          <string name="Name">WorldBuilder</string>
          <string name="Source"><![CDATA[--!strict
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Relics = require(ReplicatedStorage.Shared.Catalog.Relics)
local Tiers = require(ReplicatedStorage.Shared.Catalog.Tiers)
local Types = require(ReplicatedStorage.Shared.Types)
local World = require(ReplicatedStorage.Shared.Catalog.World)
local SiteBuilder = require(script.Parent.SiteBuilder)
local TerrainBuilder = require(script.Parent.TerrainBuilder)

local WorldBuilder = {}

local STONE = Color3.fromRGB(150, 146, 140)
local ROCK = Color3.fromRGB(110, 110, 112)
local WOOD = Color3.fromRGB(139, 100, 60)
local WALL = Color3.fromRGB(170, 150, 120)

local function makePart(
	parent: Instance,
	name: string,
	size: Vector3,
	position: Vector3,
	color: Color3,
	material: Enum.Material
): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Anchored = true
	part.Size = size
	part.CFrame = CFrame.new(position)
	part.Color = color
	part.Material = material
	part.Parent = parent
	return part
end

local function buildTallyport(island: Folder)
	local town = Instance.new("Folder")
	town.Name = "Tallyport"

	makePart(
		town,
		"Plaza",
		Vector3.new(80, 0.2, 80),
		Vector3.new(0, World.groundY + 0.1, 0),
		STONE,
		Enum.Material.Cobblestone
	)

	local spawnPad = Instance.new("SpawnLocation")
	spawnPad.Name = "Spawn"
	spawnPad.Anchored = true
	spawnPad.Neutral = true
	spawnPad.Size = Vector3.new(6, 1, 6)
	spawnPad.CFrame = CFrame.new(World.spawn.x, World.spawn.y, World.spawn.z)
	-- No default spawn force field: ProtectionService gives the respawn shield instead.
	spawnPad.Duration = 0
	spawnPad.Parent = town

	-- Safe-zone marker: a flat disc over the plaza. A Roblox cylinder's axis is X,
	-- so it is turned a quarter about Z to lie flat. Plaza top is groundY + 0.2.
	local disc = Instance.new("Part")
	disc.Name = "SafeZone"
	disc.Shape = Enum.PartType.Cylinder
	disc.Anchored = true
	disc.CanCollide = false
	disc.CanTouch = false
	disc.CanQuery = false
	disc.Size = Vector3.new(0.05, World.townRadius * 2, World.townRadius * 2)
	disc.CFrame = CFrame.new(0, World.groundY + 0.2 + 0.1, 0) * CFrame.Angles(0, 0, math.rad(90))
	disc.Color = Color3.fromRGB(255, 225, 140)
	disc.Material = Enum.Material.Neon
	disc.Transparency = 0.8
	disc.Parent = town

	-- Four buildings of different sizes at the plaza corners (width, height, depth).
	local buildings = {
		{ x = -28, z = -28, w = 16, h = 12, d = 14 },
		{ x = 28, z = -28, w = 12, h = 18, d = 12 },
		{ x = -28, z = 28, w = 14, h = 9, d = 18 },
		{ x = 28, z = 28, w = 18, h = 14, d = 16 },
	}
	for i, b in buildings do
		makePart(
			town,
			"Building" .. i,
			Vector3.new(b.w, b.h, b.d),
			Vector3.new(b.x, World.groundY + b.h / 2, b.z),
			WALL,
			Enum.Material.Brick
		)
	end
	town.Parent = island
end

local function buildCache(island: Folder, index: number, cache: Types.Cache)
	local relic = Relics.byId[cache.relicId]
	local c = Tiers.info[relic.tier].color
	local color = Color3.fromRGB(c.r, c.g, c.b)
	local p = cache.position
	-- The cache is 2 tall and its position is its centre, so the floor it stands on is 1 below.
	-- Most caches stand on the ground; a few stand on a raised floor of their own.
	local base = p.y - 1

	local part = makePart(
		island,
		cache.id,
		Vector3.new(2, 2, 2),
		Vector3.new(p.x, p.y, p.z),
		color,
		Enum.Material.SmoothPlastic
	)
	part:SetAttribute("CacheId", cache.id)
	CollectionService:AddTag(part, "Cache")

	-- Pillar is 12 tall, standing on the cache's own floor 3 studs to the side.
	makePart(
		part,
		"Pillar",
		Vector3.new(1, 12, 1),
		Vector3.new(p.x + 3, base + 6, p.z),
		color,
		Enum.Material.Neon
	)

	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Open"
	prompt.ObjectText = "Cache"
	prompt.HoldDuration = cache.hold or 0.5
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.Parent = part

	-- Landmark rock: size depends only on the index, so every build is identical. Only a cache
	-- near the ground has one; a raised cache already stands out.
	if base < 1 then
		local w = 4 + (index % 3) * 2
		local h = 3 + (index % 4)
		local d = 4 + (index % 2) * 3
		makePart(
			island,
			"Rock" .. cache.id,
			Vector3.new(w, h, d),
			Vector3.new(p.x - 8, base + h / 2, p.z + 5),
			ROCK,
			Enum.Material.Slate
		)
	end
end

local function buildPost(island: Folder, index: number, position: Types.Vec3)
	-- 6 tall, standing on the ground.
	local part = makePart(
		island,
		"Post" .. index,
		Vector3.new(2, 6, 2),
		Vector3.new(position.x, World.groundY + 3, position.z),
		WOOD,
		Enum.Material.Wood
	)
	part:SetAttribute("PostId", World.POST_ID_BASE - index)
	CollectionService:AddTag(part, "TrainingPost")

	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(140, 30)
	gui.StudsOffset = Vector3.new(0, 4.5, 0)
	gui.MaxDistance = 60
	gui.AlwaysOnTop = true
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = "Training post"
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0.5
	label.TextScaled = true
	label.Font = Enum.Font.GothamBold
	label.Parent = gui
	gui.Parent = part
end

function WorldBuilder.build()
	local island = Instance.new("Folder")
	island.Name = "Island"
	TerrainBuilder.build(island)
	SiteBuilder.build(island)
	buildTallyport(island)
	for i, cache in World.caches do
		buildCache(island, i, cache)
	end
	for i, position in World.trainingPosts do
		buildPost(island, i, position)
	end
	island.Parent = workspace
end

return WorldBuilder
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="68">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="69">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="70">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="71">
          <Properties>
            <string name="Name">AbilityBar</string>
            <string name="Source"><![CDATA[--!strict
-- Bottom-centre ability bar: four slots (keys 1-4), tap or click to cast.
-- The server decides whether a cast works; the cooldown overlay here is display only.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local PathView = require(Shared:WaitForChild("Rules"):WaitForChild("PathView"))

local AbilityBar = {}

local SLOT_COUNT = 4
local TEXT_LIGHT = Color3.fromRGB(245, 235, 210)
local BUTTON_COLOR = Color3.fromRGB(70, 60, 90)
local DIM_COLOR = Color3.fromRGB(45, 42, 52)
local OVERLAY_COLOR = Color3.fromRGB(10, 8, 14)

type Slot = {
	button: TextButton,
	overlay: Frame,
	timeLabel: TextLabel,
	nameLabel: TextLabel,
	endsAt: number,
	total: number,
}

local slots: { [number]: Slot } = {}
local ticking: RBXScriptConnection? = nil

local function addCorner(parent: Instance, radius: number)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius)
	corner.Parent = parent
end

local function limitText(parent: Instance, minSize: number, maxSize: number)
	local constraint = Instance.new("UITextSizeConstraint")
	constraint.MinTextSize = minSize
	constraint.MaxTextSize = maxSize
	constraint.Parent = parent
end

local function tick()
	local now = os.clock()
	local anyActive = false
	for _, slot in slots do
		local remaining = slot.endsAt - now
		if remaining > 0 and slot.total > 0 then
			anyActive = true
			slot.overlay.Visible = true
			slot.overlay.Size = UDim2.fromScale(1, math.min(1, remaining / slot.total))
			slot.timeLabel.Text = tostring(math.ceil(remaining))
		elseif slot.overlay.Visible then
			slot.overlay.Visible = false
			slot.timeLabel.Text = ""
		end
	end
	if not anyActive and ticking ~= nil then
		ticking:Disconnect()
		ticking = nil
	end
end

local function buildSlot(parent: Frame, index: number, onCast: (slot: number) -> ()): Slot
	local button = Instance.new("TextButton")
	button.Name = "Slot" .. index
	button.LayoutOrder = index
	button.Size = UDim2.fromScale(1, 1)
	button.SizeConstraint = Enum.SizeConstraint.RelativeYY
	button.BackgroundColor3 = DIM_COLOR
	button.Text = ""
	addCorner(button, 8)

	local key = Instance.new("TextLabel")
	key.Name = "Key"
	key.BackgroundTransparency = 1
	key.Position = UDim2.fromScale(0.06, 0.04)
	key.Size = UDim2.fromScale(0.3, 0.3)
	key.TextColor3 = TEXT_LIGHT
	key.TextScaled = true
	key.TextXAlignment = Enum.TextXAlignment.Left
	key.Font = Enum.Font.GothamBold
	key.Text = tostring(index)
	limitText(key, 8, 18)
	key.Parent = button

	local nameLabel = Instance.new("TextLabel")
	nameLabel.Name = "AbilityName"
	nameLabel.BackgroundTransparency = 1
	nameLabel.Position = UDim2.fromScale(0.05, 0.32)
	nameLabel.Size = UDim2.fromScale(0.9, 0.62)
	nameLabel.TextColor3 = TEXT_LIGHT
	nameLabel.TextScaled = true
	nameLabel.TextWrapped = true
	nameLabel.Font = Enum.Font.GothamMedium
	nameLabel.Text = "—"
	nameLabel.TextTransparency = 0.6
	limitText(nameLabel, 8, 16)
	nameLabel.Parent = button

	local overlay = Instance.new("Frame")
	overlay.Name = "Cooldown"
	overlay.AnchorPoint = Vector2.new(0, 1)
	overlay.Position = UDim2.fromScale(0, 1)
	overlay.Size = UDim2.fromScale(1, 1)
	overlay.BackgroundColor3 = OVERLAY_COLOR
	overlay.BackgroundTransparency = 0.35
	overlay.BorderSizePixel = 0
	overlay.Visible = false
	addCorner(overlay, 8)
	overlay.Parent = button

	local timeLabel = Instance.new("TextLabel")
	timeLabel.Name = "Seconds"
	timeLabel.AnchorPoint = Vector2.new(0.5, 0.5)
	timeLabel.Position = UDim2.fromScale(0.5, 0.5)
	timeLabel.Size = UDim2.fromScale(0.6, 0.4)
	timeLabel.BackgroundTransparency = 1
	timeLabel.TextColor3 = TEXT_LIGHT
	timeLabel.TextScaled = true
	timeLabel.Font = Enum.Font.GothamBold
	timeLabel.Text = ""
	limitText(timeLabel, 10, 24)
	timeLabel.ZIndex = 3
	timeLabel.Parent = button

	button.Activated:Connect(function()
		onCast(index)
	end)
	button.Parent = parent
	return {
		button = button,
		overlay = overlay,
		timeLabel = timeLabel,
		nameLabel = nameLabel,
		endsAt = 0,
		total = 0,
	}
end

function AbilityBar.mount(playerGui: PlayerGui, onCast: (slot: number) -> ())
	local gui = Instance.new("ScreenGui")
	gui.Name = "AbilityGui"
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 11

	local bar = Instance.new("Frame")
	bar.Name = "Bar"
	bar.AnchorPoint = Vector2.new(0.5, 1)
	bar.Position = UDim2.fromScale(0.5, 0.97)
	bar.Size = UDim2.fromScale(0.34, 0.1)
	bar.BackgroundTransparency = 1
	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Horizontal
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.VerticalAlignment = Enum.VerticalAlignment.Center
	layout.Padding = UDim.new(0, 6)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = bar

	for index = 1, SLOT_COUNT do
		slots[index] = buildSlot(bar, index, onCast)
	end
	bar.Parent = gui
	gui.Parent = playerGui
end

function AbilityBar.render(views: { PathView.SlotView })
	for _, view in views do
		local slot = slots[view.slot]
		if slot ~= nil then
			local empty = view.name == ""
			slot.nameLabel.Text = if empty then "—" else view.name
			slot.button.BackgroundColor3 = if empty then DIM_COLOR else BUTTON_COLOR
			slot.nameLabel.TextTransparency = if empty then 0.6 else 0
		end
	end
end

function AbilityBar.startCooldown(slotIndex: number, seconds: number)
	local slot = slots[slotIndex]
	if slot == nil or seconds <= 0 then
		return
	end
	slot.total = seconds
	slot.endsAt = os.clock() + seconds
	tick()
	if ticking == nil then
		ticking = RunService.RenderStepped:Connect(tick)
	end
end

return AbilityBar
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="72">
          <Properties>
            <string name="Name">Atmosphere</string>
            <string name="Source"><![CDATA[--!strict
-- Fades the fog to the colour and range of the region the player is in.
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Regions = require(Shared:WaitForChild("Catalog"):WaitForChild("Regions"))

local FADE_SECONDS = 1.5

local Atmosphere = {}

-- The fade in progress, so a new region can replace it.
local current: Tween? = nil

-- An unknown region id changes nothing.
function Atmosphere.set(regionId: string)
	local region = Regions.byId[regionId]
	if region == nil then
		return
	end
	local fog = region.fog
	local previous = current
	if previous ~= nil then
		previous:Cancel()
	end
	local tween = TweenService:Create(Lighting, TweenInfo.new(FADE_SECONDS), {
		FogColor = Color3.fromRGB(fog.r, fog.g, fog.b),
		FogStart = fog.start,
		FogEnd = fog.finish,
	})
	current = tween
	tween:Play()
end

return Atmosphere
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="73">
          <Properties>
            <string name="Name">ClaimUI</string>
            <string name="Source"><![CDATA[--!strict
-- The blind-claim screen. It shows every numbered slot face down: nothing tells the
-- killer whether the victim holds a Relic, only what each pick turned out to be.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Tiers = require(Shared:WaitForChild("Catalog"):WaitForChild("Tiers"))
local Rules = Shared:WaitForChild("Rules")
local BlindClaim = require(Rules:WaitForChild("BlindClaim"))
local ClaimView = require(Rules:WaitForChild("ClaimView"))
local Types = require(Shared:WaitForChild("Types"))

local TICK_SECONDS = 0.25

local TEXT_LIGHT = Color3.fromRGB(245, 235, 210)
local TEXT_DARK = Color3.fromRGB(20, 18, 24)
local TEXT_DIM = Color3.fromRGB(130, 130, 135)
local PANEL_COLOR = Color3.fromRGB(32, 28, 38)
local MISS_COLOR = Color3.fromRGB(40, 40, 45)
local LOCKED_COLOR = Color3.fromRGB(70, 70, 75)
local BUTTON_COLOR = Color3.fromRGB(70, 60, 90)

local ClaimUI = {}

local panel: Frame? = nil
local titleLabel: TextLabel? = nil
local picksLabel: TextLabel? = nil
local timerLabel: TextLabel? = nil
local grid: Frame? = nil
local pickHandler: (slot: number) -> () = function(_slot: number) end

-- What is on screen. The deadline is on the local clock: the server's expiresAt is on the
-- server's clock and is never compared with local time.
local victimName = ""
local currentClaim: BlindClaim.Claim? = nil
local deadline = 0
local shownOpen = false
local ticking = false

local function tierColor(tier: Types.Tier): Color3
	local color = Tiers.info[tier].color
	return Color3.fromRGB(color.r, color.g, color.b)
end

local function addCorner(parent: Instance, radius: number)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius)
	corner.Parent = parent
end

local function limitText(parent: Instance, minSize: number, maxSize: number)
	local constraint = Instance.new("UITextSizeConstraint")
	constraint.MinTextSize = minSize
	constraint.MaxTextSize = maxSize
	constraint.Parent = parent
end

local function makeLabel(name: string, size: UDim2, position: UDim2, maxText: number): TextLabel
	local label = Instance.new("TextLabel")
	label.Name = name
	label.Size = size
	label.Position = position
	label.BackgroundTransparency = 1
	label.TextColor3 = TEXT_LIGHT
	label.TextScaled = true
	label.TextWrapped = true
	label.Font = Enum.Font.GothamMedium
	label.Text = ""
	limitText(label, 10, maxText)
	return label
end

local function secondsRemaining(): number
	return math.max(0, deadline - os.clock())
end

local function buildView(claim: BlindClaim.Claim): ClaimView.View
	return ClaimView.build(victimName, claim, claim.expiresAt - secondsRemaining())
end

local function makeCell(slot: ClaimView.SlotView): TextButton
	local cell = Instance.new("TextButton")
	cell.Name = "Slot" .. slot.label
	cell.LayoutOrder = slot.slot
	cell.Font = Enum.Font.GothamMedium
	cell.TextScaled = true
	cell.TextWrapped = true
	cell.AutoButtonColor = slot.state == "open"
	addCorner(cell, 8)
	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0, 4)
	padding.PaddingBottom = UDim.new(0, 4)
	padding.PaddingLeft = UDim.new(0, 4)
	padding.PaddingRight = UDim.new(0, 4)
	padding.Parent = cell
	limitText(cell, 9, 20)

	local text = slot.label .. "\n" .. slot.name
	if slot.state == "open" then
		cell.BackgroundColor3 = tierColor(slot.tier)
		cell.BackgroundTransparency = 0.35
		cell.TextColor3 = TEXT_DARK
	elseif slot.state == "taken" then
		cell.BackgroundColor3 = tierColor(slot.tier)
		cell.TextColor3 = TEXT_DARK
		cell.Font = Enum.Font.GothamBold
		text ..= "\nTaken!"
		local stroke = Instance.new("UIStroke")
		stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		stroke.Color = Color3.new(1, 1, 1)
		stroke.Thickness = 3
		stroke.Parent = cell
	elseif slot.state == "miss" then
		cell.BackgroundColor3 = MISS_COLOR
		cell.TextColor3 = TEXT_DIM
		text ..= "\nNothing"
	else
		cell.BackgroundColor3 = LOCKED_COLOR
		cell.BackgroundTransparency = 0.4
		cell.TextColor3 = TEXT_DIM
		cell.TextTransparency = 0.4
	end
	cell.Text = text

	if slot.state == "open" then
		cell.Activated:Connect(function()
			pickHandler(slot.slot)
		end)
	end
	return cell
end

local function render()
	local claim = currentClaim
	local cells = grid
	if claim == nil or cells == nil then
		return
	end
	local view = buildView(claim)
	shownOpen = view.open
	if titleLabel ~= nil then
		titleLabel.Text = view.title
	end
	if picksLabel ~= nil then
		picksLabel.Text = view.picksText
	end
	if timerLabel ~= nil then
		timerLabel.Text = `{view.secondsLeft}s`
	end
	for _, child in cells:GetChildren() do
		if not child:IsA("UIComponent") then
			child:Destroy()
		end
	end
	for _, slot in view.slots do
		makeCell(slot).Parent = cells
	end
end

-- Counts down locally while the screen is open; redraws the slots when time runs out.
local function startTicking()
	if ticking then
		return
	end
	ticking = true
	task.spawn(function()
		while ClaimUI.isOpen() do
			local claim = currentClaim
			if claim ~= nil then
				local view = buildView(claim)
				if view.open ~= shownOpen then
					render()
				elseif timerLabel ~= nil then
					timerLabel.Text = `{view.secondsLeft}s`
				end
			end
			task.wait(TICK_SECONDS)
		end
		ticking = false
	end)
end

function ClaimUI.mount(playerGui: PlayerGui, onPick: (slot: number) -> ())
	pickHandler = onPick

	local gui = Instance.new("ScreenGui")
	gui.Name = "ClaimGui"
	gui.ResetOnSpawn = false
	-- Above the Ledger book (10), the status HUD (15) and messages (20).
	gui.DisplayOrder = 30

	local frame = Instance.new("Frame")
	frame.Name = "Claim"
	frame.AnchorPoint = Vector2.new(0.5, 0.5)
	frame.Position = UDim2.fromScale(0.5, 0.55)
	frame.Size = UDim2.fromScale(0.7, 0.7)
	frame.BackgroundColor3 = PANEL_COLOR
	frame.Visible = false
	addCorner(frame, 14)

	local title = makeLabel("Title", UDim2.fromScale(0.6, 0.08), UDim2.fromScale(0.03, 0.03), 30)
	title.Font = Enum.Font.GothamBold
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.Parent = frame
	titleLabel = title

	local timer = makeLabel("Timer", UDim2.fromScale(0.15, 0.08), UDim2.fromScale(0.82, 0.03), 30)
	timer.Font = Enum.Font.GothamBold
	timer.TextXAlignment = Enum.TextXAlignment.Right
	timer.Parent = frame
	timerLabel = timer

	local hint = makeLabel("Hint", UDim2.fromScale(0.94, 0.06), UDim2.fromScale(0.03, 0.11), 18)
	hint.TextXAlignment = Enum.TextXAlignment.Left
	hint.TextColor3 = TEXT_DIM
	hint.Text = "Pick the Relics you think they hold. You are not told why a pick misses."
	hint.Parent = frame

	local picks = makeLabel("Picks", UDim2.fromScale(0.4, 0.05), UDim2.fromScale(0.03, 0.18), 20)
	picks.TextXAlignment = Enum.TextXAlignment.Left
	picks.Parent = frame
	picksLabel = picks

	local cells = Instance.new("Frame")
	cells.Name = "Slots"
	cells.BackgroundTransparency = 1
	cells.Position = UDim2.fromScale(0.03, 0.25)
	cells.Size = UDim2.fromScale(0.94, 0.6)
	local layout = Instance.new("UIGridLayout")
	layout.CellSize = UDim2.fromScale(0.235, 0.3)
	layout.CellPadding = UDim2.fromScale(0.02, 0.04)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = cells
	cells.Parent = frame
	grid = cells

	local done = Instance.new("TextButton")
	done.Name = "Done"
	done.AnchorPoint = Vector2.new(0.5, 1)
	done.Position = UDim2.fromScale(0.5, 0.97)
	done.Size = UDim2.fromScale(0.2, 0.08)
	done.BackgroundColor3 = BUTTON_COLOR
	done.TextColor3 = TEXT_LIGHT
	done.TextScaled = true
	done.Font = Enum.Font.GothamBold
	done.Text = "Done"
	addCorner(done, 8)
	limitText(done, 10, 22)
	-- Hides the screen here only; the server ends the claim on its own timer.
	done.Activated:Connect(ClaimUI.hide)
	done.Parent = frame

	frame.Parent = gui
	panel = frame
	gui.Parent = playerGui
end

function ClaimUI.show(name: string, claim: BlindClaim.Claim, secondsLeft: number)
	local frame = panel
	if frame == nil then
		return
	end
	victimName = name
	currentClaim = claim
	deadline = os.clock() + math.max(0, secondsLeft)
	frame.Visible = true
	render()
	startTicking()
end

function ClaimUI.hide()
	currentClaim = nil
	local frame = panel
	if frame ~= nil then
		frame.Visible = false
	end
end

function ClaimUI.isOpen(): boolean
	local frame = panel
	return frame ~= nil and frame.Visible
end

return ClaimUI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="74">
          <Properties>
            <string name="Name">CombatController</string>
            <string name="Source"><![CDATA[--!strict
-- Strike input and the hit flash. The client only asks to Strike; the server decides the rest.
local ContextActionService = game:GetService("ContextActionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Combat = require(Shared:WaitForChild("Rules"):WaitForChild("Combat"))

local FLASH_SECONDS = 0.15

local CombatController = {}

function CombatController.start(
	strike: () -> (),
	cast: (slot: number) -> (),
	isBlocked: () -> boolean
)
	local lastStrike = -math.huge
	ContextActionService:BindAction("Strike", function(_name, state, _input)
		if state == Enum.UserInputState.Begin and not isBlocked() then
			local now = os.clock()
			if now - lastStrike >= Combat.STRIKE_COOLDOWN then
				lastStrike = now
				strike()
			end
		end
		-- Pass, so clicks still reach the camera and other controls.
		return Enum.ContextActionResult.Pass
	end, true, Enum.UserInputType.MouseButton1, Enum.KeyCode.F)
	ContextActionService:SetTitle("Strike", "Strike")

	-- Keys 1-4 cast ability slots; the bar itself is the touch control. The server decides.
	local keys = { Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three, Enum.KeyCode.Four }
	for slot, key in keys do
		ContextActionService:BindAction("Cast" .. slot, function(_name, state, _input)
			if state == Enum.UserInputState.Begin and not isBlocked() then
				cast(slot)
			end
			return Enum.ContextActionResult.Pass
		end, false, key)
	end
end

-- A brief white flash on a character that was hit.
function CombatController.flash(character: Model)
	local highlight = Instance.new("Highlight")
	highlight.Name = "HitFlash"
	highlight.FillColor = Color3.new(1, 1, 1)
	highlight.FillTransparency = 0.3
	highlight.OutlineColor = Color3.new(1, 1, 1)
	highlight.OutlineTransparency = 0
	highlight.Adornee = character
	highlight.Parent = character
	task.delay(FLASH_SECONDS, function()
		highlight:Destroy()
	end)
end

return CombatController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="75">
          <Properties>
            <string name="Name">HazardController</string>
            <string name="Source"><![CDATA[--!strict
-- Hazard visuals and the one hazard effect the client applies itself: the gust push on the
-- local character. The server decides every hazard's damage, healing, slow and drowning.
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Catalog = Shared:WaitForChild("Catalog")
local Hazards = require(Shared:WaitForChild("Rules"):WaitForChild("Hazards"))
local Looks = require(Catalog:WaitForChild("Looks"))
local Sites = require(Catalog:WaitForChild("Sites"))
local Types = require(Shared:WaitForChild("Types"))

local MARKER_TAG = "Hazard"
local VISUAL_SECONDS = 0.1
local WARN_BRIGHT = 0.35
local WARN_DIM = 0.6
local ACTIVE_TRANSPARENCY = 0.05
-- The warning flips between bright and dim this many times a second.
local WARN_FLIPS_PER_SECOND = 4

local HazardController = {}

-- What a marker looked like before the controller touched it.
type Rest = { cframe: CFrame, transparency: number }

-- The rest is kept on the marker itself, in client-local attributes. A table keyed by the part
-- can lose its entry when the part's Lua wrapper is collected, and a marker that is lifted at
-- that moment would then be taken for its resting self and lifted again, pass after pass.
-- Both values are written together, on the first pass, before anything has moved the marker.
local function restOf(marker: BasePart, hazard: Types.Hazard): Rest
	local cframe = marker:GetAttribute("RestCFrame")
	local transparency = marker:GetAttribute("RestTransparency")
	if typeof(cframe) == "CFrame" and type(transparency) == "number" then
		return { cframe = cframe, transparency = transparency }
	end
	local look = Looks.byName[hazard.look]
	local rest: Rest = {
		cframe = marker.CFrame,
		transparency = if look ~= nil then look.transparency else marker.Transparency,
	}
	marker:SetAttribute("RestCFrame", rest.cframe)
	marker:SetAttribute("RestTransparency", rest.transparency)
	return rest
end

-- Idle markers sit at rest, a warning flashes, and an active hazard is nearly solid. A
-- marker with a Rise attribute (the tide) lifts by that much as the hazard goes active.
local function showMarker(marker: BasePart, hazard: Types.Hazard, now: number)
	local rest = restOf(marker, hazard)
	local phase, _, elapsed = Hazards.phase(hazard, now)
	local lift = 0
	if phase == "idle" then
		marker.Transparency = rest.transparency
	elseif phase == "warn" then
		local bright = math.floor(now * WARN_FLIPS_PER_SECOND) % 2 == 0
		marker.Transparency = if bright then WARN_BRIGHT else WARN_DIM
		lift = elapsed
	else
		marker.Transparency = ACTIVE_TRANSPARENCY
		lift = 1
	end
	local rise = marker:GetAttribute("Rise")
	if type(rise) == "number" then
		marker.CFrame = rest.cframe + Vector3.new(0, rise * lift, 0)
	end
end

-- Read the tagged list afresh each pass: a marker may appear after this runs.
local function showMarkers(now: number)
	for _, instance in CollectionService:GetTagged(MARKER_TAG) do
		if instance:IsA("BasePart") then
			local id = instance:GetAttribute("HazardId")
			local hazard = if type(id) == "string" then Sites.hazardById[id] else nil
			-- A hazard without a cycle has nothing to count down to; leave its marker alone.
			if hazard ~= nil and hazard.cycle ~= nil then
				showMarker(instance, hazard, now)
			end
		end
	end
end

-- Moves the local character along any gust it stands in, while it is alive.
local function pushLocalCharacter(dt: number, now: number)
	local character = Players.LocalPlayer.Character
	if character == nil then
		return
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	if humanoid == nil or humanoid.Health <= 0 or root == nil or not root:IsA("BasePart") then
		return
	end
	local position = root.Position
	local sample = Hazards.sample(Sites.hazards, position.X, position.Z, now)
	if sample.pushX ~= 0 or sample.pushZ ~= 0 then
		root.CFrame += Vector3.new(sample.pushX, 0, sample.pushZ) * dt
	end
end

function HazardController.start()
	local sinceVisuals = 0
	RunService.RenderStepped:Connect(function(dt)
		local now = workspace:GetServerTimeNow()
		pushLocalCharacter(dt, now)
		sinceVisuals += dt
		if sinceVisuals >= VISUAL_SECONDS then
			sinceVisuals = 0
			showMarkers(now)
		end
	end)
end

return HazardController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="76">
          <Properties>
            <string name="Name">LedgerUI</string>
            <string name="Source"><![CDATA[--!strict
local ContextActionService = game:GetService("ContextActionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Tiers = require(Shared:WaitForChild("Catalog"):WaitForChild("Tiers"))
local LedgerView = require(Shared:WaitForChild("Rules"):WaitForChild("LedgerView"))
local Types = require(Shared:WaitForChild("Types"))

type View = LedgerView.View

local LedgerUI = {}

local TEXT_LIGHT = Color3.fromRGB(245, 235, 210)
local TEXT_DIM = Color3.fromRGB(130, 130, 135)
local PANEL_COLOR = Color3.fromRGB(32, 28, 38)
local LOCKED_COLOR = Color3.fromRGB(55, 55, 60)
local BUTTON_COLOR = Color3.fromRGB(70, 60, 90)
local VAULT_GOLD = Color3.fromRGB(255, 200, 40)

local panel: Frame? = nil
local slotGrid: ScrollingFrame? = nil
local freeList: ScrollingFrame? = nil
local progressLabel: TextLabel? = nil
local freeLabel: TextLabel? = nil
local vaultLabel: TextLabel? = nil
local actionHandler: (request: { [string]: any }) -> () = function(_request: { [string]: any }) end
local vaultHandler: (request: { [string]: any }) -> () = function(_request: { [string]: any }) end

local function tierColor(tier: Types.Tier): Color3
	local color = Tiers.info[tier].color
	return Color3.fromRGB(color.r, color.g, color.b)
end

local function addCorner(parent: Instance, radius: number)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius)
	corner.Parent = parent
end

local function addPadding(parent: Instance, pixels: number)
	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0, pixels)
	padding.PaddingBottom = UDim.new(0, pixels)
	padding.PaddingLeft = UDim.new(0, pixels)
	padding.PaddingRight = UDim.new(0, pixels)
	padding.Parent = parent
end

local function limitText(parent: Instance, minSize: number, maxSize: number)
	local constraint = Instance.new("UITextSizeConstraint")
	constraint.MinTextSize = minSize
	constraint.MaxTextSize = maxSize
	constraint.Parent = parent
end

local function makeLabel(name: string, size: UDim2, position: UDim2, maxText: number): TextLabel
	local label = Instance.new("TextLabel")
	label.Name = name
	label.Size = size
	label.Position = position
	label.BackgroundTransparency = 1
	label.TextColor3 = TEXT_LIGHT
	label.TextScaled = true
	label.Font = Enum.Font.GothamMedium
	label.Text = ""
	limitText(label, 10, maxText)
	return label
end

local function makeButton(name: string, text: string, size: UDim2): TextButton
	local button = Instance.new("TextButton")
	button.Name = name
	button.Size = size
	button.BackgroundColor3 = BUTTON_COLOR
	button.TextColor3 = TEXT_LIGHT
	button.TextScaled = true
	button.Font = Enum.Font.GothamBold
	button.Text = text
	button.AutoButtonColor = true
	addCorner(button, 8)
	limitText(button, 10, 22)
	return button
end

-- Destroys every child except layout objects.
local function clearRows(container: Instance)
	for _, child in container:GetChildren() do
		if not child:IsA("UIComponent") then
			child:Destroy()
		end
	end
end

local function makeSlot(slot: LedgerView.SlotView, order: number): TextButton
	local button = Instance.new("TextButton")
	button.Name = "Slot" .. slot.label
	button.LayoutOrder = order
	button.AutoButtonColor = slot.claimed
	button.Font = Enum.Font.GothamMedium
	button.TextScaled = true
	button.TextWrapped = true
	if slot.claimed then
		button.BackgroundColor3 = tierColor(slot.tier)
		button.TextColor3 = Color3.fromRGB(20, 18, 24)
	else
		button.BackgroundColor3 = LOCKED_COLOR
		button.TextColor3 = TEXT_DIM
	end
	local text = slot.label .. "\n" .. slot.name
	if slot.spares > 0 then
		text ..= "\nx" .. slot.spares
	end
	button.Text = text
	addCorner(button, 8)
	addPadding(button, 4)
	limitText(button, 9, 20)
	if slot.claimed then
		button.Activated:Connect(function()
			actionHandler({ kind = "unclaim", cardId = slot.cardId })
		end)
	end
	if slot.vaulted then
		local stroke = Instance.new("UIStroke")
		stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		stroke.Color = VAULT_GOLD
		stroke.Thickness = 3
		stroke.Parent = button
	end
	if slot.vaulted or slot.canVault then
		-- A button on top of the slot takes the click, so the slot's unclaim does not fire.
		local vaultButton = makeButton(
			"Vault",
			if slot.vaulted then "Vaulted" else "Vault",
			UDim2.new(0.55, 0, 0, 18)
		)
		vaultButton.AnchorPoint = Vector2.new(1, 1)
		vaultButton.Position = UDim2.fromScale(1, 1)
		vaultButton.ZIndex = button.ZIndex + 1
		if slot.vaulted then
			vaultButton.BackgroundColor3 = VAULT_GOLD
			vaultButton.TextColor3 = Color3.fromRGB(20, 18, 24)
		end
		vaultButton.Activated:Connect(function()
			vaultHandler({ kind = if slot.vaulted then "remove" else "add", cardId = slot.cardId })
		end)
		vaultButton.Parent = button
	end
	return button
end

local function makeFreeRow(card: LedgerView.FreeView): Frame
	local row = Instance.new("Frame")
	row.Name = "Free" .. card.index
	row.LayoutOrder = card.index
	row.Size = UDim2.new(1, 0, 0, 52)
	row.BackgroundColor3 = tierColor(card.tier)
	addCorner(row, 8)

	local name = makeLabel("Name", UDim2.fromScale(0.5, 1), UDim2.fromScale(0, 0), 22)
	name.TextColor3 = Color3.fromRGB(20, 18, 24)
	name.TextXAlignment = Enum.TextXAlignment.Left
	name.Text = card.name
	addPadding(name, 6)
	name.Parent = row

	local discard = makeButton("Discard", "Discard", UDim2.new(0.22, 0, 1, -8))
	discard.AnchorPoint = Vector2.new(1, 0.5)
	discard.Position = UDim2.new(0.99, 0, 0.5, 0)
	discard.Activated:Connect(function()
		actionHandler({ kind = "discard", freeIndex = card.index, cardId = card.cardId })
	end)
	discard.Parent = row

	if card.canClaim then
		local claim = makeButton("Claim", "Claim", UDim2.new(0.22, 0, 1, -8))
		claim.AnchorPoint = Vector2.new(1, 0.5)
		claim.Position = UDim2.new(0.75, 0, 0.5, 0)
		claim.Activated:Connect(function()
			actionHandler({ kind = "claim", freeIndex = card.index, cardId = card.cardId })
		end)
		claim.Parent = row
	end
	return row
end

function LedgerUI.mount(
	playerGui: PlayerGui,
	onAction: (request: { [string]: any }) -> (),
	onVault: (request: { [string]: any }) -> ()
)
	actionHandler = onAction
	vaultHandler = onVault

	local gui = Instance.new("ScreenGui")
	gui.Name = "LedgerGui"
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 10

	local openButton = makeButton("OpenButton", "Ledger", UDim2.fromScale(0.14, 0.07))
	openButton.AnchorPoint = Vector2.new(0, 1)
	openButton.Position = UDim2.fromScale(0.02, 0.97)
	local openLimit = openButton:FindFirstChildOfClass("UITextSizeConstraint")
	if openLimit ~= nil then
		openLimit.MinTextSize = 12
	end
	openButton.Activated:Connect(LedgerUI.toggle)
	openButton.Parent = gui

	local book = Instance.new("Frame")
	book.Name = "Book"
	book.AnchorPoint = Vector2.new(0.5, 0.5)
	book.Position = UDim2.fromScale(0.5, 0.5)
	book.Size = UDim2.fromScale(0.7, 0.7)
	book.BackgroundColor3 = PANEL_COLOR
	book.Visible = false
	addCorner(book, 14)

	local title = makeLabel("Title", UDim2.fromScale(0.6, 0.08), UDim2.fromScale(0.02, 0.02), 30)
	title.Font = Enum.Font.GothamBold
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.Text = "The Hoarder's Ledger"
	title.Parent = book

	local closeButton = makeButton("Close", "X", UDim2.fromScale(0.08, 0.08))
	closeButton.AnchorPoint = Vector2.new(1, 0)
	closeButton.Position = UDim2.fromScale(0.98, 0.02)
	closeButton.Activated:Connect(LedgerUI.toggle)
	closeButton.Parent = book

	local progress =
		makeLabel("Progress", UDim2.fromScale(0.3, 0.05), UDim2.fromScale(0.02, 0.11), 20)
	progress.TextXAlignment = Enum.TextXAlignment.Left
	progress.Parent = book
	progressLabel = progress

	local free = makeLabel("FreeCount", UDim2.fromScale(0.3, 0.05), UDim2.fromScale(0.35, 0.11), 20)
	free.TextXAlignment = Enum.TextXAlignment.Left
	free.Parent = book
	freeLabel = free

	local vault =
		makeLabel("VaultCount", UDim2.fromScale(0.3, 0.05), UDim2.fromScale(0.68, 0.11), 20)
	vault.TextXAlignment = Enum.TextXAlignment.Left
	vault.Parent = book
	vaultLabel = vault

	local grid = Instance.new("ScrollingFrame")
	grid.Name = "Slots"
	grid.Position = UDim2.fromScale(0.02, 0.17)
	grid.Size = UDim2.fromScale(0.46, 0.8)
	grid.BackgroundTransparency = 1
	grid.BorderSizePixel = 0
	grid.ScrollBarThickness = 6
	grid.CanvasSize = UDim2.new()
	grid.AutomaticCanvasSize = Enum.AutomaticSize.Y
	local gridLayout = Instance.new("UIGridLayout")
	gridLayout.CellSize = UDim2.new(0.31, 0, 0, 78)
	gridLayout.CellPadding = UDim2.new(0.03, 0, 0, 8)
	gridLayout.SortOrder = Enum.SortOrder.LayoutOrder
	gridLayout.Parent = grid
	grid.Parent = book
	slotGrid = grid

	local list = Instance.new("ScrollingFrame")
	list.Name = "FreeCards"
	list.Position = UDim2.fromScale(0.52, 0.17)
	list.Size = UDim2.fromScale(0.46, 0.8)
	list.BackgroundTransparency = 1
	list.BorderSizePixel = 0
	list.ScrollBarThickness = 6
	list.CanvasSize = UDim2.new()
	list.AutomaticCanvasSize = Enum.AutomaticSize.Y
	local listLayout = Instance.new("UIListLayout")
	listLayout.Padding = UDim.new(0, 6)
	listLayout.SortOrder = Enum.SortOrder.LayoutOrder
	listLayout.Parent = list
	list.Parent = book
	freeList = list

	book.Parent = gui
	panel = book

	ContextActionService:BindAction("ToggleLedger", function(_name, state)
		if state == Enum.UserInputState.Begin then
			LedgerUI.toggle()
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.B)

	gui.Parent = playerGui
end

function LedgerUI.render(view: View)
	local grid = slotGrid
	local list = freeList
	if grid == nil or list == nil then
		return
	end
	if progressLabel ~= nil then
		progressLabel.Text = "Relics: "
			.. view.progressText
			.. (if view.complete then " (complete!)" else "")
	end
	if freeLabel ~= nil then
		freeLabel.Text = "Free slots: " .. view.freeText
	end
	if vaultLabel ~= nil then
		vaultLabel.Text = "Vault: " .. view.vaultText
	end

	clearRows(grid)
	for index, slot in view.slots do
		makeSlot(slot, index).Parent = grid
	end
	clearRows(list)
	for _, card in view.free do
		makeFreeRow(card).Parent = list
	end
end

function LedgerUI.isOpen(): boolean
	local book = panel
	return book ~= nil and book.Visible
end

function LedgerUI.toggle()
	local book = panel
	if book ~= nil then
		book.Visible = not book.Visible
	end
end

return LedgerUI
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="77">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--!strict
print("[IsleOfAvarice] client started")

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Rules = Shared:WaitForChild("Rules")
local Net = require(Shared:WaitForChild("Net"))
local Messages = require(Shared:WaitForChild("Catalog"):WaitForChild("Messages"))
local LedgerView = require(Rules:WaitForChild("LedgerView"))
local PathView = require(Rules:WaitForChild("PathView"))
local PlaceView = require(Rules:WaitForChild("PlaceView"))
local Protection = require(Rules:WaitForChild("Protection"))
local StatusView = require(Rules:WaitForChild("StatusView"))
local Atmosphere = require(script.Parent.Atmosphere)
local ClaimUI = require(script.Parent.ClaimUI)
local CombatController = require(script.Parent.CombatController)
local HazardController = require(script.Parent.HazardController)
local LedgerUI = require(script.Parent.LedgerUI)
local AbilityBar = require(script.Parent.AbilityBar)
local PathUI = require(script.Parent.PathUI)
local StatusHUD = require(script.Parent.StatusHUD)
local Toast = require(script.Parent.Toast)

local HUD_REFRESH_SECONDS = 0.5

local remotes = ReplicatedStorage:WaitForChild(Net.FOLDER)
local ledgerSync = remotes:WaitForChild(Net.LedgerSync) :: RemoteEvent
local ledgerAction = remotes:WaitForChild(Net.LedgerAction) :: RemoteEvent
local ledgerRequest = remotes:WaitForChild(Net.LedgerRequest) :: RemoteEvent
local notify = remotes:WaitForChild(Net.Notify) :: RemoteEvent
local vaultAction = remotes:WaitForChild(Net.VaultAction) :: RemoteEvent
local statusSync = remotes:WaitForChild(Net.StatusSync) :: RemoteEvent
local shieldDrop = remotes:WaitForChild(Net.ShieldDrop) :: RemoteEvent
local strikeRemote = remotes:WaitForChild(Net.Strike) :: RemoteEvent
local hitFx = remotes:WaitForChild(Net.HitFx) :: RemoteEvent
local claimUpdate = remotes:WaitForChild(Net.ClaimUpdate) :: RemoteEvent
local claimPick = remotes:WaitForChild(Net.ClaimPick) :: RemoteEvent
local pathSync = remotes:WaitForChild(Net.PathSync) :: RemoteEvent
local pickCalling = remotes:WaitForChild(Net.PickCalling) :: RemoteEvent
local changeCalling = remotes:WaitForChild(Net.ChangeCalling) :: RemoteEvent
local loadoutAction = remotes:WaitForChild(Net.LoadoutAction) :: RemoteEvent
local castAbility = remotes:WaitForChild(Net.CastAbility) :: RemoteEvent
local abilityCooldown = remotes:WaitForChild(Net.AbilityCooldown) :: RemoteEvent

local localPlayer = Players.LocalPlayer
local playerGui = localPlayer:WaitForChild("PlayerGui") :: PlayerGui

LedgerUI.mount(playerGui, function(request)
	ledgerAction:FireServer(request)
end, function(request)
	vaultAction:FireServer(request)
end)
Toast.mount(playerGui)
StatusHUD.mount(playerGui, function()
	shieldDrop:FireServer()
end)
ClaimUI.mount(playerGui, function(slot)
	claimPick:FireServer(slot)
end)
PathUI.mount(playerGui, {
	pick = function(path)
		pickCalling:FireServer(path)
	end,
	change = function(path)
		changeCalling:FireServer(path)
	end,
	loadout = function(request)
		loadoutAction:FireServer(request)
	end,
})
AbilityBar.mount(playerGui, function(slot)
	castAbility:FireServer(slot)
end)
CombatController.start(function()
	strikeRemote:FireServer()
end, function(slot)
	castAbility:FireServer(slot)
end, function()
	return LedgerUI.isOpen() or ClaimUI.isOpen() or PathUI.isOpen()
end)
HazardController.start()

ledgerSync.OnClientEvent:Connect(function(ledger, vault)
	LedgerUI.render(LedgerView.build(ledger, vault))
end)
notify.OnClientEvent:Connect(function(code, args)
	Toast.show(Messages.format(code, args))
end)
claimUpdate.OnClientEvent:Connect(function(payload)
	if payload == nil then
		ClaimUI.hide()
	else
		ClaimUI.show(payload.victimName, payload.claim, payload.secondsLeft)
	end
end)
hitFx.OnClientEvent:Connect(function(victimUserId)
	local victim = Players:GetPlayerByUserId(victimUserId)
	local character = if victim ~= nil then victim.Character else nil
	if character ~= nil then
		CombatController.flash(character)
	end
end)

-- The last path sync and when it arrived (local clock); cooldown text advances from it.
local lastPaths: any = nil
local lastCoin = 0
local lastServerNow = 0
local pathsAt = 0
local function renderPaths()
	if lastPaths ~= nil then
		local now = lastServerNow + (os.clock() - pathsAt)
		local view = PathView.build(lastPaths, lastCoin, now)
		PathUI.render(view)
		AbilityBar.render(view.slots)
	end
end
pathSync.OnClientEvent:Connect(function(progress, coin, serverNow)
	lastPaths = progress
	lastCoin = coin
	lastServerNow = serverNow
	pathsAt = os.clock()
	renderPaths()
end)
abilityCooldown.OnClientEvent:Connect(function(slot, seconds)
	AbilityBar.startCooldown(slot, seconds)
end)
task.spawn(function()
	while true do
		task.wait(60)
		renderPaths()
	end
end)

-- The last status from the server and when it arrived (local clock). Timers count down here.
local lastStatus: StatusView.Status? = nil
local statusAt = 0
statusSync.OnClientEvent:Connect(function(status)
	lastStatus = status
	statusAt = os.clock()
end)

local function localRoot(): BasePart?
	local character = localPlayer.Character
	local root = if character ~= nil then character:FindFirstChild("HumanoidRootPart") else nil
	if root == nil or not root:IsA("BasePart") then
		return nil
	end
	return root
end

local function localInSafeZone(): boolean
	local root = localRoot()
	if root == nil then
		return false
	end
	local p = root.Position
	return Protection.inSafeZone({ x = p.X, y = p.Y, z = p.Z })
end

-- The region and active hazards at the local character, or nil while it has none.
local function localPlace(): PlaceView.Place?
	local root = localRoot()
	if root == nil then
		return nil
	end
	local p = root.Position
	return PlaceView.at(p.X, p.Z, workspace:GetServerTimeNow())
end

-- The region last shown. Entering a new one changes the fog and shows its name and hint.
local lastRegionId: string? = nil

local function refreshHud()
	local status = lastStatus
	local shown: StatusView.Status? = nil
	if status ~= nil then
		local elapsed = os.clock() - statusAt
		shown = {
			newShield = status.newShield,
			respawnShieldSeconds = math.max(0, status.respawnShieldSeconds - elapsed),
			markedSeconds = math.max(0, status.markedSeconds - elapsed),
		}
	end
	local place = localPlace()
	if place ~= nil and place.regionId ~= lastRegionId then
		lastRegionId = place.regionId
		Atmosphere.set(place.regionId)
		Toast.show(place.name .. ": " .. place.hint)
	end
	StatusHUD.render(
		StatusView.build(shown, localInSafeZone(), place),
		shown ~= nil and shown.newShield
	)
end

task.spawn(function()
	while true do
		refreshHud()
		task.wait(HUD_REFRESH_SECONDS)
	end
end)

-- The first sync may have fired before this script connected; ask again.
ledgerRequest:FireServer()
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="78">
          <Properties>
            <string name="Name">PathUI</string>
            <string name="Source"><![CDATA[--!strict
-- Calling picker and Paths panel. Renders a PathView and sends requests; the server decides.
local ContextActionService = game:GetService("ContextActionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Paths = require(Shared:WaitForChild("Catalog"):WaitForChild("Paths"))
local PathProgress = require(Shared:WaitForChild("Rules"):WaitForChild("PathProgress"))
local PathView = require(Shared:WaitForChild("Rules"):WaitForChild("PathView"))
local Types = require(Shared:WaitForChild("Types"))

type View = PathView.View
type RowView = PathView.RowView

export type Handlers = {
	pick: (path: string) -> (),
	change: (path: string) -> (),
	loadout: (request: { [string]: any }) -> (),
}

local PathUI = {}

local TEXT_LIGHT = Color3.fromRGB(245, 235, 210)
local TEXT_DIM = Color3.fromRGB(130, 130, 135)
local PANEL_COLOR = Color3.fromRGB(32, 28, 38)
local CARD_COLOR = Color3.fromRGB(46, 40, 56)
local LOCKED_COLOR = Color3.fromRGB(55, 55, 60)
local BUTTON_COLOR = Color3.fromRGB(70, 60, 90)
local DARK_TEXT = Color3.fromRGB(20, 18, 24)
local ROW_HEIGHT = 196
local FALLBACK_COLOR = Color3.fromRGB(120, 120, 130)

local noop = function(_request: any) end
local handlers: Handlers = { pick = noop, change = noop, loadout = noop }

local panel: Frame? = nil
local picker: Frame? = nil
local confirm: Frame? = nil
local confirmQuestion: TextLabel? = nil
local rowList: ScrollingFrame? = nil
local pickerList: ScrollingFrame? = nil
local slotStrip: Frame? = nil
local callingLabel: TextLabel? = nil
local lastView: View? = nil
local pendingChange = ""
local pendingPick = ""
local dismissedPicker = false

local function pathColor(path: string): Color3
	local info = Paths.info[path :: Types.PathId]
	if info == nil then
		return FALLBACK_COLOR
	end
	return Color3.fromRGB(info.color.r, info.color.g, info.color.b)
end

local function addCorner(parent: Instance, radius: number)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius)
	corner.Parent = parent
end

local function limitText(parent: Instance, minSize: number, maxSize: number)
	local constraint = Instance.new("UITextSizeConstraint")
	constraint.MinTextSize = minSize
	constraint.MaxTextSize = maxSize
	constraint.Parent = parent
end

local function makeLabel(name: string, size: UDim2, position: UDim2, maxText: number): TextLabel
	local label = Instance.new("TextLabel")
	label.Name = name
	label.Size = size
	label.Position = position
	label.BackgroundTransparency = 1
	label.TextColor3 = TEXT_LIGHT
	label.TextScaled = true
	label.TextWrapped = true
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Font = Enum.Font.GothamMedium
	label.Text = ""
	limitText(label, 9, maxText)
	return label
end

local function makeButton(name: string, text: string, size: UDim2): TextButton
	local button = Instance.new("TextButton")
	button.Name = name
	button.Size = size
	button.BackgroundColor3 = BUTTON_COLOR
	button.TextColor3 = TEXT_LIGHT
	button.TextScaled = true
	button.Font = Enum.Font.GothamBold
	button.Text = text
	button.AutoButtonColor = true
	addCorner(button, 8)
	limitText(button, 10, 20)
	return button
end

local function makeScroller(name: string, size: UDim2, position: UDim2): ScrollingFrame
	local scroller = Instance.new("ScrollingFrame")
	scroller.Name = name
	scroller.Size = size
	scroller.Position = position
	scroller.BackgroundTransparency = 1
	scroller.BorderSizePixel = 0
	scroller.ScrollBarThickness = 6
	scroller.CanvasSize = UDim2.new()
	scroller.AutomaticCanvasSize = Enum.AutomaticSize.Y
	return scroller
end

local function clearRows(container: Instance)
	for _, child in container:GetChildren() do
		if not child:IsA("UIComponent") then
			child:Destroy()
		end
	end
end

-- The first empty loadout slot, or 4 when all are full (the server decides what happens then).
local function equipSlot(): number
	local view = lastView
	if view ~= nil then
		for _, slot in view.slots do
			if slot.abilityId == "" then
				return slot.slot
			end
		end
	end
	return 4
end

local function askChange(row: RowView)
	local dialog = confirm
	local question = confirmQuestion
	if dialog == nil or question == nil then
		return
	end
	pendingPick = ""
	pendingChange = row.path
	question.Text = "Change your Calling to "
		.. row.name
		.. "? Levels are kept; learning rates change."
	dialog.Visible = true
end

local function askPick(row: RowView)
	local dialog = confirm
	local question = confirmQuestion
	if dialog == nil or question == nil then
		return
	end
	pendingChange = ""
	pendingPick = row.path
	question.Text = "Make " .. row.name .. " your Calling?"
	dialog.Visible = true
end

-- "Learns: Gale, Bulwark 80% · Ember, Mend 60% · Mire 40%": the shared learning rate from this
-- Calling to every other Path, grouped by rate, nearest first.
local function learnsText(path: string): string
	local groups: { { rate: number, names: { string } } } = {}
	for _, other in Paths.order do
		if other == path then
			continue
		end
		local rate = PathProgress.learningRate(path, other)
		local group = nil
		for _, existing in groups do
			if existing.rate == rate then
				group = existing
			end
		end
		if group == nil then
			group = { rate = rate, names = {} }
			table.insert(groups, group)
		end
		table.insert(group.names, Paths.info[other].name)
	end
	table.sort(groups, function(a, b)
		return a.rate > b.rate
	end)
	local parts: { string } = {}
	for _, group in groups do
		table.insert(
			parts,
			table.concat(group.names, ", ") .. " " .. math.floor(group.rate * 100 + 0.5) .. "%"
		)
	end
	return "Learns: " .. table.concat(parts, " · ")
end

local function makeAbility(row: RowView, index: number): Frame
	local ability = row.abilities[index]
	local frame = Instance.new("Frame")
	frame.Name = "Ability" .. ability.id
	frame.Position = UDim2.new(0.01 + (index - 1) * 0.33, 0, 0, 62)
	frame.Size = UDim2.new(0.32, 0, 0, 126)
	frame.BackgroundColor3 = if ability.unlocked then CARD_COLOR else LOCKED_COLOR
	addCorner(frame, 8)

	local name = makeLabel("Name", UDim2.new(0.94, 0, 0, 22), UDim2.new(0.03, 0, 0, 4), 18)
	name.Font = Enum.Font.GothamBold
	name.TextColor3 = if ability.unlocked then TEXT_LIGHT else TEXT_DIM
	name.Text = ability.name
	name.Parent = frame

	local description =
		makeLabel("Description", UDim2.new(0.94, 0, 0, 60), UDim2.new(0.03, 0, 0, 28), 15)
	description.TextYAlignment = Enum.TextYAlignment.Top
	description.TextColor3 = if ability.unlocked then TEXT_LIGHT else TEXT_DIM
	description.Text = ability.description
	description.Parent = frame

	local bottomSize = UDim2.new(0.94, 0, 0, 28)
	local bottomPosition = UDim2.new(0.03, 0, 1, -32)
	if not ability.unlocked then
		local locked = makeLabel("Locked", bottomSize, bottomPosition, 16)
		locked.TextColor3 = TEXT_DIM
		locked.Text = "Level " .. ability.unlockLevel
		locked.Parent = frame
	elseif ability.equippedSlot > 0 then
		local equipped = makeLabel("Equipped", bottomSize, bottomPosition, 16)
		equipped.Text = "Equipped (slot " .. ability.equippedSlot .. ")"
		equipped.Parent = frame
	else
		local equip = makeButton("Equip" .. ability.id, "Equip", bottomSize)
		equip.Position = bottomPosition
		equip.Activated:Connect(function()
			handlers.loadout({ slot = equipSlot(), abilityId = ability.id })
		end)
		equip.Parent = frame
	end
	return frame
end

local function makeRow(row: RowView, order: number, needsCalling: boolean): Frame
	local frame = Instance.new("Frame")
	frame.Name = "Row" .. row.path
	frame.LayoutOrder = order
	frame.Size = UDim2.new(1, -8, 0, ROW_HEIGHT)
	frame.BackgroundColor3 = PANEL_COLOR
	addCorner(frame, 10)
	local stroke = Instance.new("UIStroke")
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Color = pathColor(row.path)
	stroke.Thickness = if row.isCalling then 3 else 1
	stroke.Parent = frame

	local header = makeLabel("Header", UDim2.new(0.6, 0, 0, 28), UDim2.new(0.02, 0, 0, 6), 22)
	header.Font = Enum.Font.GothamBold
	header.TextColor3 = pathColor(row.path)
	header.Text = row.name .. "  Lv " .. row.level .. (if row.isCalling then "  (Calling)" else "")
	header.Parent = frame

	local detail = makeLabel("Detail", UDim2.new(0.96, 0, 0, 22), UDim2.new(0.02, 0, 0, 36), 16)
	detail.Text = row.style .. "  |  XP " .. row.xpText .. "  |  Rate " .. row.rateText
	detail.Parent = frame

	for index = 1, #row.abilities do
		makeAbility(row, index).Parent = frame
	end

	if needsCalling then
		local choose = makeButton("Choose", "Choose", UDim2.new(0.3, 0, 0, 28))
		choose.AnchorPoint = Vector2.new(1, 0)
		choose.Position = UDim2.new(0.98, 0, 0, 6)
		choose.Activated:Connect(function()
			askPick(row)
		end)
		choose.Parent = frame
	elseif row.changeText ~= "" then
		local make = makeButton(
			"MakeCalling",
			"Make Calling (" .. row.changeText .. ")",
			UDim2.new(0.36, 0, 0, 28)
		)
		make.AnchorPoint = Vector2.new(1, 0)
		make.Position = UDim2.new(0.98, 0, 0, 6)
		make.Active = row.canChange
		make.AutoButtonColor = row.canChange
		if not row.canChange then
			make.BackgroundColor3 = LOCKED_COLOR
			make.TextColor3 = TEXT_DIM
		end
		make.Activated:Connect(function()
			if row.canChange then
				askChange(row)
			end
		end)
		make.Parent = frame
	end
	return frame
end

local function makeCard(row: RowView, order: number): Frame
	local card = Instance.new("Frame")
	card.Name = "Card" .. row.path
	card.LayoutOrder = order
	card.BackgroundColor3 = pathColor(row.path)
	addCorner(card, 10)

	local name = makeLabel("Name", UDim2.new(0.92, 0, 0, 26), UDim2.new(0.04, 0, 0, 6), 22)
	name.Font = Enum.Font.GothamBold
	name.TextColor3 = DARK_TEXT
	name.Text = row.name
	name.Parent = card

	local style = makeLabel("Style", UDim2.new(0.92, 0, 0, 20), UDim2.new(0.04, 0, 0, 32), 16)
	style.TextColor3 = DARK_TEXT
	style.Text = row.style
	style.Parent = card

	local lines: { string } = {}
	for _, ability in row.abilities do
		table.insert(lines, ability.name .. ": " .. ability.description)
	end
	local abilities =
		makeLabel("Abilities", UDim2.new(0.92, 0, 1, -128), UDim2.new(0.04, 0, 0, 56), 15)
	abilities.TextYAlignment = Enum.TextYAlignment.Top
	abilities.TextColor3 = DARK_TEXT
	abilities.Text = table.concat(lines, "\n")
	abilities.Parent = card

	local learns = makeLabel("Learns", UDim2.new(0.92, 0, 0, 30), UDim2.new(0.04, 0, 1, -68), 13)
	learns.AnchorPoint = Vector2.new(0, 0)
	learns.TextYAlignment = Enum.TextYAlignment.Top
	learns.TextColor3 = DARK_TEXT
	learns.Text = learnsText(row.path)
	learns.Parent = card

	local choose = makeButton("Choose", "Choose", UDim2.new(0.92, 0, 0, 30))
	choose.AnchorPoint = Vector2.new(0.5, 1)
	choose.Position = UDim2.new(0.5, 0, 1, -6)
	choose.Activated:Connect(function()
		askPick(row)
	end)
	choose.Parent = card
	return card
end

local function buildConfirm(gui: ScreenGui)
	local frame = Instance.new("Frame")
	frame.Name = "Confirm"
	frame.AnchorPoint = Vector2.new(0.5, 0.5)
	frame.Position = UDim2.fromScale(0.5, 0.5)
	frame.Size = UDim2.fromScale(0.5, 0.26)
	frame.BackgroundColor3 = PANEL_COLOR
	frame.Visible = false
	frame.ZIndex = 50
	addCorner(frame, 12)

	local question =
		makeLabel("Question", UDim2.fromScale(0.9, 0.5), UDim2.fromScale(0.05, 0.08), 24)
	question.TextXAlignment = Enum.TextXAlignment.Center
	question.ZIndex = 51
	question.Parent = frame
	confirmQuestion = question

	local yes = makeButton("Yes", "Yes", UDim2.fromScale(0.35, 0.25))
	yes.Position = UDim2.fromScale(0.1, 0.65)
	yes.ZIndex = 51
	yes.Activated:Connect(function()
		frame.Visible = false
		local pick = pendingPick
		local path = pendingChange
		pendingPick = ""
		pendingChange = ""
		if pick ~= "" then
			handlers.pick(pick)
		elseif path ~= "" then
			handlers.change(path)
		end
	end)
	yes.Parent = frame

	local no = makeButton("No", "No", UDim2.fromScale(0.35, 0.25))
	no.Position = UDim2.fromScale(0.55, 0.65)
	no.ZIndex = 51
	no.Activated:Connect(function()
		frame.Visible = false
		pendingChange = ""
		pendingPick = ""
	end)
	no.Parent = frame

	frame.Parent = gui
	confirm = frame
end

local function buildPicker(gui: ScreenGui)
	local frame = Instance.new("Frame")
	frame.Name = "Picker"
	frame.AnchorPoint = Vector2.new(0.5, 0.5)
	frame.Position = UDim2.fromScale(0.5, 0.5)
	frame.Size = UDim2.fromScale(0.9, 0.85)
	frame.BackgroundColor3 = PANEL_COLOR
	frame.Visible = false
	frame.ZIndex = 5
	addCorner(frame, 14)

	local title = makeLabel("Title", UDim2.fromScale(0.6, 0.08), UDim2.fromScale(0.02, 0.02), 30)
	title.Font = Enum.Font.GothamBold
	title.Text = "Choose your Calling"
	title.Parent = frame

	local later = makeButton("Later", "Later", UDim2.fromScale(0.14, 0.08))
	later.AnchorPoint = Vector2.new(1, 0)
	later.Position = UDim2.fromScale(0.98, 0.02)
	later.Activated:Connect(function()
		dismissedPicker = true
		frame.Visible = false
	end)
	later.Parent = frame

	local list = makeScroller("Cards", UDim2.fromScale(0.96, 0.84), UDim2.fromScale(0.02, 0.13))
	local grid = Instance.new("UIGridLayout")
	grid.CellSize = UDim2.new(0.32, 0, 0, 250)
	grid.CellPadding = UDim2.new(0.01, 0, 0, 8)
	grid.SortOrder = Enum.SortOrder.LayoutOrder
	grid.Parent = list
	list.Parent = frame
	pickerList = list

	frame.Parent = gui
	picker = frame
end

local function buildPanel(gui: ScreenGui)
	local book = Instance.new("Frame")
	book.Name = "Panel"
	book.AnchorPoint = Vector2.new(0.5, 0.5)
	book.Position = UDim2.fromScale(0.5, 0.5)
	book.Size = UDim2.fromScale(0.8, 0.85)
	book.BackgroundColor3 = PANEL_COLOR
	book.Visible = false
	addCorner(book, 14)

	local title =
		makeLabel("CallingText", UDim2.fromScale(0.6, 0.08), UDim2.fromScale(0.02, 0.02), 30)
	title.Font = Enum.Font.GothamBold
	title.Parent = book
	callingLabel = title

	local close = makeButton("Close", "X", UDim2.fromScale(0.08, 0.08))
	close.AnchorPoint = Vector2.new(1, 0)
	close.Position = UDim2.fromScale(0.98, 0.02)
	close.Activated:Connect(PathUI.toggle)
	close.Parent = book

	local strip = Instance.new("Frame")
	strip.Name = "Loadout"
	strip.BackgroundTransparency = 1
	strip.Position = UDim2.fromScale(0.02, 0.11)
	strip.Size = UDim2.fromScale(0.96, 0.09)
	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Horizontal
	layout.Padding = UDim.new(0.01, 0)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = strip
	strip.Parent = book
	slotStrip = strip

	local list = makeScroller("Rows", UDim2.fromScale(0.96, 0.77), UDim2.fromScale(0.02, 0.21))
	local listLayout = Instance.new("UIListLayout")
	listLayout.Padding = UDim.new(0, 8)
	listLayout.SortOrder = Enum.SortOrder.LayoutOrder
	listLayout.Parent = list
	list.Parent = book
	rowList = list

	book.Parent = gui
	panel = book
end

function PathUI.mount(playerGui: PlayerGui, given: Handlers)
	handlers = given

	local gui = Instance.new("ScreenGui")
	gui.Name = "PathGui"
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 12

	local openButton = makeButton("PathsButton", "Paths", UDim2.fromScale(0.14, 0.07))
	openButton.AnchorPoint = Vector2.new(0, 1)
	openButton.Position = UDim2.fromScale(0.02, 0.89)
	local openLimit = openButton:FindFirstChildOfClass("UITextSizeConstraint")
	if openLimit ~= nil then
		openLimit.MinTextSize = 12
	end
	openButton.Activated:Connect(PathUI.toggle)
	openButton.Parent = gui

	buildPicker(gui)
	buildPanel(gui)
	buildConfirm(gui)

	ContextActionService:BindAction("TogglePaths", function(_name, state)
		if state == Enum.UserInputState.Begin then
			PathUI.toggle()
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.P)

	gui.Parent = playerGui
end

function PathUI.render(view: View)
	lastView = view
	local rows = rowList
	local cards = pickerList
	local strip = slotStrip
	local pick = picker
	if rows == nil or cards == nil or strip == nil or pick == nil then
		return
	end
	if callingLabel ~= nil then
		callingLabel.Text = view.callingText
	end

	-- A pending first pick closes once a Calling has been chosen.
	local pickDialog = confirm
	if pendingPick ~= "" and not view.needsCalling and pickDialog ~= nil then
		pickDialog.Visible = false
		pendingPick = ""
	end

	-- A pending Calling change only stays open while the new view still allows it.
	local dialog = confirm
	local question = confirmQuestion
	if pendingChange ~= "" and dialog ~= nil and question ~= nil then
		local pending: RowView? = nil
		for _, row in view.rows do
			if row.path == pendingChange then
				pending = row
			end
		end
		if pending == nil or pending.changeText == "" or not pending.canChange then
			dialog.Visible = false
			pendingChange = ""
		else
			question.Text = "Change your Calling to "
				.. pending.name
				.. "? Levels are kept; learning rates change."
		end
	end

	clearRows(strip)
	for _, slot in view.slots do
		local empty = slot.abilityId == ""
		local cell = Instance.new("Frame")
		cell.Name = "Slot" .. slot.slot
		cell.LayoutOrder = slot.slot
		cell.Size = UDim2.new(0.2425, 0, 1, 0)
		cell.BackgroundColor3 = if empty then LOCKED_COLOR else CARD_COLOR
		addCorner(cell, 8)
		local text = makeLabel("Name", UDim2.new(0.74, 0, 1, 0), UDim2.fromScale(0.04, 0), 18)
		text.TextColor3 = if empty then TEXT_DIM else TEXT_LIGHT
		text.Text = slot.slot .. ": " .. (if empty then "Empty" else slot.name)
		text.Parent = cell
		if not empty then
			local clear = makeButton("Clear" .. slot.slot, "×", UDim2.new(0.2, 0, 0.8, 0))
			clear.AnchorPoint = Vector2.new(1, 0.5)
			clear.Position = UDim2.fromScale(0.98, 0.5)
			clear.Activated:Connect(function()
				handlers.loadout({ slot = slot.slot, abilityId = "" })
			end)
			clear.Parent = cell
		end
		cell.Parent = strip
	end

	clearRows(rows)
	for index, row in view.rows do
		makeRow(row, index, view.needsCalling).Parent = rows
	end

	clearRows(cards)
	if view.needsCalling then
		for index, row in view.rows do
			makeCard(row, index).Parent = cards
		end
	end
	pick.Visible = view.needsCalling and not dismissedPicker
end

function PathUI.isOpen(): boolean
	local book = panel
	local pick = picker
	return (book ~= nil and book.Visible) or (pick ~= nil and pick.Visible)
end

function PathUI.toggle()
	local book = panel
	if book ~= nil then
		book.Visible = not book.Visible
	end
end

return PathUI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="79">
          <Properties>
            <string name="Name">StatusHUD</string>
            <string name="Source"><![CDATA[--!strict
-- Top-left status lines (region, safe zone, shields, Marked, hazards) and the "Drop shield" button.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local StatusView = require(Shared:WaitForChild("Rules"):WaitForChild("StatusView"))

local StatusHUD = {}

local TEXT_LIGHT = Color3.fromRGB(245, 235, 210)
local BACKGROUND = Color3.fromRGB(25, 22, 30)
local BUTTON_COLOR = Color3.fromRGB(70, 60, 90)
local KIND_COLORS: { [string]: Color3 } = {
	region = Color3.fromRGB(245, 235, 210),
	hazard = Color3.fromRGB(255, 170, 60),
	safe = Color3.fromRGB(90, 200, 110),
	shield = Color3.fromRGB(110, 170, 255),
	marked = Color3.fromRGB(235, 70, 70),
}

local column: Frame? = nil
local dropButton: TextButton? = nil
local confirm: Frame? = nil
-- Text of the lines on screen, so an unchanged render does nothing.
local shownKey = ""

local function addCorner(parent: Instance, radius: number)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius)
	corner.Parent = parent
end

local function limitText(parent: Instance, minSize: number, maxSize: number)
	local constraint = Instance.new("UITextSizeConstraint")
	constraint.MinTextSize = minSize
	constraint.MaxTextSize = maxSize
	constraint.Parent = parent
end

local function makeButton(name: string, text: string, size: UDim2): TextButton
	local button = Instance.new("TextButton")
	button.Name = name
	button.Size = size
	button.BackgroundColor3 = BUTTON_COLOR
	button.TextColor3 = TEXT_LIGHT
	button.TextScaled = true
	button.Font = Enum.Font.GothamBold
	button.Text = text
	addCorner(button, 8)
	limitText(button, 10, 20)
	return button
end

local function buildConfirm(gui: ScreenGui, onDropShield: () -> ()): Frame
	local frame = Instance.new("Frame")
	frame.Name = "ConfirmDrop"
	frame.AnchorPoint = Vector2.new(0.5, 0.5)
	frame.Position = UDim2.fromScale(0.5, 0.5)
	frame.Size = UDim2.fromScale(0.4, 0.22)
	frame.BackgroundColor3 = BACKGROUND
	frame.Visible = false
	addCorner(frame, 12)

	local question = Instance.new("TextLabel")
	question.Name = "Question"
	question.BackgroundTransparency = 1
	question.Position = UDim2.fromScale(0.05, 0.08)
	question.Size = UDim2.fromScale(0.9, 0.5)
	question.TextColor3 = TEXT_LIGHT
	question.TextScaled = true
	question.TextWrapped = true
	question.Font = Enum.Font.GothamMedium
	question.Text = "Other players will be able to attack you. Drop it?"
	limitText(question, 10, 24)
	question.Parent = frame

	local yes = makeButton("Yes", "Yes", UDim2.fromScale(0.35, 0.25))
	yes.Position = UDim2.fromScale(0.1, 0.65)
	yes.Activated:Connect(function()
		frame.Visible = false
		onDropShield()
	end)
	yes.Parent = frame

	local no = makeButton("No", "No", UDim2.fromScale(0.35, 0.25))
	no.Position = UDim2.fromScale(0.55, 0.65)
	no.Activated:Connect(function()
		frame.Visible = false
	end)
	no.Parent = frame

	frame.Parent = gui
	return frame
end

function StatusHUD.mount(playerGui: PlayerGui, onDropShield: () -> ())
	local gui = Instance.new("ScreenGui")
	gui.Name = "StatusGui"
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 15

	local list = Instance.new("Frame")
	list.Name = "Lines"
	list.BackgroundTransparency = 1
	list.Position = UDim2.new(0, 12, 0, 12)
	list.Size = UDim2.new(0, 230, 0, 160)
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 4)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = list
	list.Parent = gui
	column = list

	local drop = makeButton("DropShield", "Drop shield", UDim2.new(0, 150, 0, 32))
	drop.Position = UDim2.new(0, 12, 0, 176)
	drop.Visible = false
	drop.Parent = gui
	dropButton = drop

	local dialog = buildConfirm(gui, onDropShield)
	confirm = dialog
	drop.Activated:Connect(function()
		dialog.Visible = true
	end)

	gui.Parent = playerGui
end

function StatusHUD.render(lines: { StatusView.Line }, showDropShield: boolean)
	local drop = dropButton
	if drop ~= nil then
		drop.Visible = showDropShield
	end
	local dialog = confirm
	if dialog ~= nil and not showDropShield then
		dialog.Visible = false
	end

	local list = column
	if list == nil then
		return
	end
	local parts: { string } = {}
	for _, line in lines do
		table.insert(parts, line.kind .. ":" .. line.text)
	end
	local key = table.concat(parts, "|")
	if key == shownKey then
		return
	end
	shownKey = key

	for _, child in list:GetChildren() do
		if not child:IsA("UIComponent") then
			child:Destroy()
		end
	end
	for index, line in lines do
		local label = Instance.new("TextLabel")
		label.Name = "Line" .. index
		label.LayoutOrder = index
		label.Size = UDim2.new(1, 0, 0, 28)
		label.BackgroundColor3 = BACKGROUND
		label.BackgroundTransparency = 0.3
		label.TextColor3 = KIND_COLORS[line.kind] or TEXT_LIGHT
		label.TextScaled = true
		label.TextXAlignment = Enum.TextXAlignment.Left
		label.Font = Enum.Font.GothamBold
		label.Text = line.text
		addCorner(label, 6)
		local padding = Instance.new("UIPadding")
		padding.PaddingLeft = UDim.new(0, 8)
		padding.PaddingTop = UDim.new(0, 4)
		padding.PaddingBottom = UDim.new(0, 4)
		padding.Parent = label
		limitText(label, 10, 20)
		label.Parent = list
	end
end

return StatusHUD
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="80">
          <Properties>
            <string name="Name">Toast</string>
            <string name="Source"><![CDATA[--!strict
-- One message at the top of the screen. A new message replaces the old one.
local SHOW_SECONDS = 3

local Toast = {}

local label: TextLabel? = nil
local generation = 0

function Toast.mount(playerGui: PlayerGui)
	local gui = Instance.new("ScreenGui")
	gui.Name = "ToastGui"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 20

	local text = Instance.new("TextLabel")
	text.Name = "Message"
	text.AnchorPoint = Vector2.new(0.5, 0)
	text.Position = UDim2.fromScale(0.5, 0.04)
	text.Size = UDim2.fromScale(0.6, 0.07)
	text.BackgroundColor3 = Color3.fromRGB(25, 22, 30)
	text.BackgroundTransparency = 0.15
	text.TextColor3 = Color3.fromRGB(245, 235, 210)
	text.TextScaled = true
	text.Font = Enum.Font.GothamMedium
	text.Text = ""
	text.Visible = false

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 10)
	corner.Parent = text
	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0, 6)
	padding.PaddingBottom = UDim.new(0, 6)
	padding.PaddingLeft = UDim.new(0, 12)
	padding.PaddingRight = UDim.new(0, 12)
	padding.Parent = text
	local constraint = Instance.new("UITextSizeConstraint")
	constraint.MinTextSize = 12
	constraint.MaxTextSize = 28
	constraint.Parent = text

	text.Parent = gui
	label = text
	gui.Parent = playerGui
end

function Toast.show(text: string)
	local current = label
	if current == nil then
		return
	end
	generation += 1
	local mine = generation
	current.Text = text
	current.Visible = true
	task.delay(SHOW_SECONDS, function()
		-- A newer message owns the label now.
		if generation == mine then
			current.Visible = false
		end
	end)
end

return Toast
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
