        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">Leaderboard</string>
            <string name="Source"><![CDATA[--!strict
-- The all-time board of the Crowned: parsing stored rows, merging them with this server's players,
-- and the text shown. Pure. Every check is written so that NaN refuses.
local Crown = require("./Crown")

export type Entry = { userId: number, crowns: number }
export type View = { title: string, subtitle: string, rows: { string } }

local Leaderboard = {}

Leaderboard.ROWS = 10
Leaderboard.REFRESH_SECONDS = 120
Leaderboard.RETRY_SECONDS = 60

local function isWhole(n: any): boolean
	return type(n) == "number" and n > -math.huge and n < math.huge and n == math.floor(n)
end

-- Turns the store's page into entries. Keeps only well-formed rows, never errors.
function Leaderboard.fromPage(raw: any): { Entry }
	local out: { Entry } = {}
	if type(raw) ~= "table" then
		return out
	end
	for _, item in raw :: { any } do
		if #out >= Leaderboard.ROWS then
			break
		end
		if type(item) ~= "table" then
			continue
		end
		local key, value = item.key, item.value
		if type(key) ~= "string" or #key > 19 or string.match(key, "^%d+$") == nil then
			continue
		end
		local userId = tonumber(key)
		if userId == nil or not (userId >= 1) then
			continue
		end
		if not isWhole(value) or not (value >= 1 and value <= Crown.MAX) then
			continue
		end
		table.insert(out, { userId = userId, crowns = value })
	end
	return out
end

-- One entry per player with the higher count, best first, ties to the lower id.
function Leaderboard.merge(stored: { Entry }, live: { Entry }): { Entry }
	local best: { [number]: number } = {}
	for _, list in { stored, live } do
		for _, entry in list do
			if entry.crowns >= 1 then
				local old = best[entry.userId]
				if old == nil or entry.crowns > old then
					best[entry.userId] = entry.crowns
				end
			end
		end
	end
	local out: { Entry } = {}
	for userId, crowns in best do
		table.insert(out, { userId = userId, crowns = crowns })
	end
	table.sort(out, function(a, b)
		if a.crowns ~= b.crowns then
			return a.crowns > b.crowns
		end
		return a.userId < b.userId
	end)
	while #out > Leaderboard.ROWS do
		table.remove(out)
	end
	return out
end

function Leaderboard.view(entries: { Entry }, names: { [string]: string }, online: boolean): View
	local rows: { string } = {}
	for rank, entry in entries do
		local name = names[tostring(entry.userId)] or `Claimant {entry.userId}`
		table.insert(rows, `{rank}. {name}: {Crown.title(entry.crowns, 0)}`)
	end
	if #rows == 0 then
		rows = { "Nobody has been Crowned yet." }
	end
	return {
		title = "The Crowned",
		subtitle = if online
			then "All time, every server"
			else "This server only: the all-time records cannot be reached",
		rows = rows,
	}
end

-- Write only a higher count, and not within a minute of a failed write.
function Leaderboard.shouldWrite(
	crowns: number,
	boardCrowns: number,
	lastFailAt: number?,
	now: number
): boolean
	if not (crowns > boardCrowns) then
		return false
	end
	return lastFailAt == nil or now - lastFailAt >= Leaderboard.RETRY_SECONDS
end

-- UpdateAsync's transform: a write never lowers the stored count.
function Leaderboard.keep(old: any, crowns: number): number
	if isWhole(old) and old >= 0 and old <= Crown.MAX then
		return math.max(old, crowns)
	end
	return crowns
end

return Leaderboard
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">Ledger</string>
            <string name="Source"><![CDATA[--!strict
local Cards = require("../Catalog/Cards")
local Relics = require("../Catalog/Relics")
local Types = require("../Types")

type CardId = Types.CardId
type Ledger = Types.Ledger

local Ledger = {}

Ledger.FREE_SLOTS = 20

local function copy(ledger: Ledger): Ledger
	return { claimed = table.clone(ledger.claimed), free = table.clone(ledger.free) }
end

local function validIndex(ledger: Ledger, index: number): boolean
	return index == math.floor(index) and index >= 1 and index <= #ledger.free
end

function Ledger.new(): Ledger
	return { claimed = {}, free = {} }
end

-- Puts a card (a Relic or an Edict) in a free slot.
function Ledger.add(ledger: Ledger, cardId: CardId): (Ledger?, string?)
	if Cards.info(cardId) == nil then
		return nil, "UNKNOWN_CARD"
	end
	if #ledger.free >= Ledger.FREE_SLOTS then
		return nil, "FREE_FULL"
	end
	local result = copy(ledger)
	table.insert(result.free, cardId)
	return result
end

function Ledger.claim(ledger: Ledger, freeIndex: number): (Ledger?, string?)
	if not validIndex(ledger, freeIndex) then
		return nil, "BAD_INDEX"
	end
	local cardId = ledger.free[freeIndex]
	-- Only a Relic has a numbered slot.
	if not Cards.isRelic(cardId) then
		return nil, "NOT_A_RELIC"
	end
	if ledger.claimed[cardId] then
		return nil, "ALREADY_CLAIMED"
	end
	local result = copy(ledger)
	table.remove(result.free, freeIndex)
	result.claimed[cardId] = true
	return result
end

function Ledger.unclaim(ledger: Ledger, cardId: CardId): (Ledger?, string?)
	if not ledger.claimed[cardId] then
		return nil, "NOT_CLAIMED"
	end
	if #ledger.free >= Ledger.FREE_SLOTS then
		return nil, "FREE_FULL"
	end
	local result = copy(ledger)
	result.claimed[cardId] = nil
	table.insert(result.free, cardId)
	return result
end

function Ledger.discard(ledger: Ledger, freeIndex: number): (Ledger?, string?)
	if not validIndex(ledger, freeIndex) then
		return nil, "BAD_INDEX"
	end
	local result = copy(ledger)
	table.remove(result.free, freeIndex)
	return result
end

function Ledger.count(ledger: Ledger, cardId: CardId): number
	local total = if ledger.claimed[cardId] then 1 else 0
	for _, id in ledger.free do
		if id == cardId then
			total += 1
		end
	end
	return total
end

-- Free slots still empty.
function Ledger.room(ledger: Ledger): number
	return math.max(0, Ledger.FREE_SLOTS - #ledger.free)
end

-- True when the free slots hold every card of the list, counting repeats.
function Ledger.holdsFree(ledger: Ledger, cardIds: { CardId }): boolean
	local need: { [CardId]: number } = {}
	for _, id in cardIds do
		need[id] = (need[id] or 0) + 1
	end
	for _, id in ledger.free do
		local left = need[id]
		if left ~= nil then
			need[id] = if left > 1 then left - 1 else nil
		end
	end
	return next(need) == nil
end

-- Takes the listed cards out of the free slots (the first copy of each first), keeping the
-- order of the rest. Nil when the free slots do not hold them all.
function Ledger.remove(ledger: Ledger, cardIds: { CardId }): Ledger?
	if not Ledger.holdsFree(ledger, cardIds) then
		return nil
	end
	local need: { [CardId]: number } = {}
	for _, id in cardIds do
		need[id] = (need[id] or 0) + 1
	end
	local free: { CardId } = {}
	for _, id in ledger.free do
		local left = need[id]
		if left ~= nil and left > 0 then
			need[id] = left - 1
		else
			table.insert(free, id)
		end
	end
	return { claimed = table.clone(ledger.claimed), free = free }
end

-- Edicts held (always in free slots).
function Ledger.edictCount(ledger: Ledger): number
	local total = 0
	for _, id in ledger.free do
		if Cards.isEdict(id) then
			total += 1
		end
	end
	return total
end

-- Relics held, claimed and spare.
function Ledger.relicCount(ledger: Ledger): number
	local total = Ledger.claimedCount(ledger)
	for _, id in ledger.free do
		if Cards.isRelic(id) then
			total += 1
		end
	end
	return total
end

function Ledger.claimedCount(ledger: Ledger): number
	local total = 0
	for _, value in ledger.claimed do
		if value then
			total += 1
		end
	end
	return total
end

function Ledger.isComplete(ledger: Ledger): boolean
	for _, relic in Relics.list do
		if not ledger.claimed[relic.id] then
			return false
		end
	end
	return true
end

-- Turns arbitrary saved data into a valid Ledger. Never errors.
function Ledger.sanitize(raw: any): Ledger
	local result = Ledger.new()
	if type(raw) ~= "table" then
		return result
	end
	local rawClaimed = raw.claimed
	if type(rawClaimed) == "table" then
		for key, value in rawClaimed do
			if type(key) == "string" and Relics.byId[key] ~= nil and value == true then
				result.claimed[key] = true
			end
		end
	end
	local rawFree = raw.free
	if type(rawFree) == "table" then
		for i = 1, #rawFree do
			if #result.free >= Ledger.FREE_SLOTS then
				break
			end
			local id = rawFree[i]
			if Cards.info(id) ~= nil then
				table.insert(result.free, id)
			end
		end
	end
	return result
end

return Ledger
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">LedgerActions</string>
            <string name="Source"><![CDATA[--!strict
local Ledger = require("./Ledger")
local Types = require("../Types")

type CardId = Types.CardId
type Ledger = Types.Ledger

local MAX_CARD_ID_LENGTH = 16

local LedgerActions = {}

-- Validates a raw client request and applies it to the ledger.
-- Request shapes:
--   { kind = "claim" | "discard", freeIndex = number, cardId = string }
--   { kind = "unclaim", cardId = string }
-- claim and discard carry the card the player saw on that row; if the free list has
-- shifted (a double click), the card at freeIndex differs and the request is BAD_INDEX.
-- Success: new ledger, "CLAIMED" | "UNCLAIMED" | "DISCARDED", affected card id.
-- Failure: nil, error code, nil. Never errors on hostile input.
function LedgerActions.apply(ledger: Ledger?, raw: any): (Ledger?, string, CardId?)
	if ledger == nil then
		return nil, "DATA_NOT_LOADED", nil
	end
	if type(raw) ~= "table" then
		return nil, "BAD_REQUEST", nil
	end
	local kind = raw.kind
	if kind == "claim" or kind == "discard" then
		local freeIndex = raw.freeIndex
		if type(freeIndex) ~= "number" then
			return nil, "BAD_REQUEST", nil
		end
		local shownCardId = raw.cardId
		if type(shownCardId) ~= "string" or #shownCardId > MAX_CARD_ID_LENGTH then
			return nil, "BAD_REQUEST", nil
		end
		local cardId = ledger.free[freeIndex]
		if cardId ~= shownCardId then
			return nil, "BAD_INDEX", nil
		end
		local result, err
		if kind == "claim" then
			result, err = Ledger.claim(ledger, freeIndex)
		else
			result, err = Ledger.discard(ledger, freeIndex)
		end
		if result == nil then
			return nil, err or "BAD_REQUEST", nil
		end
		return result, if kind == "claim" then "CLAIMED" else "DISCARDED", cardId
	elseif kind == "unclaim" then
		local cardId = raw.cardId
		if type(cardId) ~= "string" or #cardId > MAX_CARD_ID_LENGTH then
			return nil, "BAD_REQUEST", nil
		end
		local result, err = Ledger.unclaim(ledger, cardId)
		if result == nil then
			return nil, err or "BAD_REQUEST", nil
		end
		return result, "UNCLAIMED", cardId
	end
	return nil, "BAD_REQUEST", nil
end

return LedgerActions
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">LedgerView</string>
            <string name="Source"><![CDATA[--!strict
local Cards = require("../Catalog/Cards")
local Ledger = require("./Ledger")
local Relics = require("../Catalog/Relics")
local Vault = require("./Vault")
local Types = require("../Types")

type CardId = Types.CardId
type Tier = Types.Tier
type Ledger = Types.Ledger
type Vault = Types.Vault

export type SlotView = {
	slot: number,
	label: string,
	cardId: CardId,
	name: string,
	tier: Tier,
	claimed: boolean,
	spares: number,
	vaulted: boolean,
	canVault: boolean,
}
-- `tier` is nil for an Edict. An Edict can be used; only a Relic can be claimed.
export type FreeView = {
	index: number,
	cardId: CardId,
	name: string,
	tier: Tier?,
	kind: "relic" | "edict",
	canClaim: boolean,
	canUse: boolean,
}
export type View = {
	progressText: string,
	freeText: string,
	vaultText: string,
	complete: boolean,
	slots: { SlotView },
	free: { FreeView },
}

local LedgerView = {}

-- Turns a Ledger into display data. Pure: the client renders this and nothing else.
function LedgerView.build(ledger: Ledger, vault: Vault?): View
	local vaulted: Vault = vault or {}
	local spares: { [CardId]: number } = {}
	for _, cardId in ledger.free do
		spares[cardId] = (spares[cardId] or 0) + 1
	end

	local slots: { SlotView } = {}
	for _, relic in Relics.list do
		table.insert(slots, {
			slot = relic.slot,
			label = string.format("%03d", relic.slot),
			cardId = relic.id,
			name = relic.name,
			tier = relic.tier,
			claimed = ledger.claimed[relic.id] == true,
			spares = spares[relic.id] or 0,
			vaulted = vaulted[relic.id] == true,
			canVault = Ledger.count(ledger, relic.id) > 0
				and relic.tier ~= "Crown"
				and vaulted[relic.id] ~= true,
		})
	end

	local free: { FreeView } = {}
	for index, cardId in ledger.free do
		local card = Cards.info(cardId)
		if card ~= nil then
			local isRelic = card.kind == "relic"
			table.insert(free, {
				index = index,
				cardId = cardId,
				name = card.name,
				tier = card.tier,
				kind = card.kind,
				canClaim = isRelic and ledger.claimed[cardId] ~= true,
				canUse = not isRelic,
			})
		end
	end

	return {
		progressText = `{Ledger.claimedCount(ledger)} / {Relics.count}`,
		freeText = `{#ledger.free} / {Ledger.FREE_SLOTS}`,
		vaultText = `{Vault.size(vaulted)} / {Vault.MAX}`,
		complete = Ledger.isComplete(ledger),
		slots = slots,
		free = free,
	}
end

return LedgerView
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">Loadout</string>
            <string name="Source"><![CDATA[--!strict
local Abilities = require("../Catalog/Abilities")
local PathProgress = require("./PathProgress")
local Types = require("../Types")

type PathProgress = Types.PathProgress

local MAX_ABILITY_ID_LENGTH = 16

local Loadout = {}

Loadout.SLOTS = 4

local function copy(progress: PathProgress): PathProgress
	return {
		calling = progress.calling,
		xp = table.clone(progress.xp),
		loadout = table.clone(progress.loadout),
		callingChanges = progress.callingChanges,
		callingChangedAt = progress.callingChangedAt,
	}
end

-- request: { slot = number, abilityId = string }; "" clears the slot.
function Loadout.apply(
	progress: PathProgress?,
	raw: any,
	inSafeZone: boolean
): (PathProgress?, string)
	if progress == nil then
		return nil, "DATA_NOT_LOADED"
	end
	if type(raw) ~= "table" then
		return nil, "BAD_REQUEST"
	end
	local slot, abilityId = raw.slot, raw.abilityId
	if
		type(slot) ~= "number"
		or slot ~= slot
		or slot ~= math.floor(slot)
		or slot < 1
		or slot > Loadout.SLOTS
	then
		return nil, "BAD_REQUEST"
	end
	if type(abilityId) ~= "string" or #abilityId > MAX_ABILITY_ID_LENGTH then
		return nil, "BAD_REQUEST"
	end
	if abilityId ~= "" and Abilities.byId[abilityId] == nil then
		return nil, "BAD_REQUEST"
	end
	if progress.calling == "" then
		return nil, "NO_CALLING"
	end
	if not inSafeZone then
		return nil, "LOADOUT_SAFE_ZONE"
	end
	if abilityId ~= "" and not table.find(PathProgress.unlocked(progress), abilityId) then
		return nil, "NOT_UNLOCKED"
	end
	local result = copy(progress)
	if abilityId ~= "" then
		for i, id in result.loadout do
			if id == abilityId then
				result.loadout[i] = ""
			end
		end
	end
	result.loadout[slot] = abilityId
	return result, "LOADOUT_CHANGED"
end

-- Each id not yet equipped goes into the first empty slot, if any.
function Loadout.autoFill(progress: PathProgress, ids: { string }): PathProgress
	local result = copy(progress)
	for _, id in ids do
		if not table.find(result.loadout, id) then
			local empty = table.find(result.loadout, "")
			if empty ~= nil then
				result.loadout[empty] = id
			end
		end
	end
	return result
end

return Loadout
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">Party</string>
            <string name="Source"><![CDATA[--!strict
-- Parties as plain state (spec 3.14): up to four players who cannot hurt each other and whose
-- support abilities reach each other. Session state only, nothing is saved. Pure: every
-- function builds new tables and the server owns the state.
local Types = require("../Types")

type Vec3 = Types.Vec3

export type Party = { leader: number, members: { number } }
export type State = { Party }
export type Helper = { position: Vec3, protected: boolean }
export type Helped = { id: number, position: Vec3, inFight: boolean, inDuel: boolean }

local Party = {}

Party.MAX_SIZE = 4
Party.INVITE_SECONDS = 20
Party.FIGHT_SECONDS = 30

function Party.new(): State
	return {}
end

-- The index of the party userId is in. Numbers are compared with ==, so NaN is never a member.
local function indexOf(state: State, userId: number): number?
	for i, party in state do
		for _, member in party.members do
			if member == userId then
				return i
			end
		end
	end
	return nil
end

local function copyParty(party: Party): Party
	return { leader = party.leader, members = table.clone(party.members) }
end

function Party.find(state: State, userId: number): Party?
	local i = indexOf(state, userId)
	if i == nil then
		return nil
	end
	return copyParty(state[i])
end

function Party.allies(state: State, userId: number): { number }
	local i = indexOf(state, userId)
	if i == nil then
		return {}
	end
	local out = {}
	for _, member in state[i].members do
		if member ~= userId then
			table.insert(out, member)
		end
	end
	return out
end

function Party.allied(state: State, a: number, b: number): boolean
	if a == b then
		return false
	end
	local i = indexOf(state, a)
	return i ~= nil and i == indexOf(state, b)
end

function Party.canInvite(state: State, inviterId: number, targetId: number): (boolean, string)
	if inviterId == targetId then
		return false, "BAD_REQUEST"
	end
	local i = indexOf(state, inviterId)
	if i ~= nil then
		local party = state[i]
		if party.leader ~= inviterId then
			return false, "PARTY_NOT_LEADER"
		end
		if #party.members >= Party.MAX_SIZE then
			return false, "PARTY_FULL"
		end
	end
	if indexOf(state, targetId) ~= nil then
		return false, "PARTY_TARGET_IN_PARTY"
	end
	return true, "PARTY_INVITE_SENT"
end

function Party.join(state: State, inviterId: number, targetId: number): (State?, string)
	local can, code = Party.canInvite(state, inviterId, targetId)
	if not can then
		return nil, code
	end
	local out = table.clone(state)
	local i = indexOf(state, inviterId)
	if i == nil then
		table.insert(out, { leader = inviterId, members = { inviterId, targetId } })
	else
		local party = copyParty(state[i])
		table.insert(party.members, targetId)
		out[i] = party
	end
	return out, "PARTY_JOINED"
end

-- Takes userId out of the party at index i. A party left with one member is removed, and a
-- leader who left is replaced by the first remaining member.
local function removeMember(state: State, i: number, userId: number): State
	local out = table.clone(state)
	local party = copyParty(state[i])
	local at = table.find(party.members, userId)
	if at ~= nil then
		table.remove(party.members, at)
	end
	if #party.members <= 1 then
		table.remove(out, i)
		return out
	end
	if party.leader == userId then
		party.leader = party.members[1]
	end
	out[i] = party
	return out
end

function Party.leave(state: State, userId: number): (State?, string)
	local i = indexOf(state, userId)
	if i == nil then
		return nil, "PARTY_NOT_IN"
	end
	return removeMember(state, i, userId), "PARTY_LEFT"
end

-- The shared checks of kick and promote: the leader's party index and the target id, or a code.
local function leaderTarget(
	state: State,
	leaderId: number,
	rawTargetId: any
): (number?, number?, string?)
	local i = indexOf(state, leaderId)
	if i == nil then
		return nil, nil, "PARTY_NOT_IN"
	end
	local party = state[i]
	if party.leader ~= leaderId then
		return nil, nil, "PARTY_NOT_LEADER"
	end
	if type(rawTargetId) ~= "number" or rawTargetId == leaderId then
		return nil, nil, "BAD_REQUEST"
	end
	if table.find(party.members, rawTargetId) == nil then
		return nil, nil, "BAD_REQUEST"
	end
	return i, rawTargetId, nil
end

function Party.kick(state: State, leaderId: number, rawTargetId: any): (State?, string)
	local i, targetId, code = leaderTarget(state, leaderId, rawTargetId)
	if i == nil or targetId == nil then
		return nil, code :: string
	end
	return removeMember(state, i, targetId), "PARTY_MEMBER_KICKED"
end

function Party.promote(state: State, leaderId: number, rawTargetId: any): (State?, string)
	local i, targetId, code = leaderTarget(state, leaderId, rawTargetId)
	if i == nil or targetId == nil then
		return nil, code :: string
	end
	local out = table.clone(state)
	local party = copyParty(state[i])
	party.leader = targetId
	out[i] = party
	return out, "PARTY_NEW_LEADER"
end

function Party.reach(helper: Helper, allies: { Helped }, radius: number): ({ number }, boolean)
	local ids = {}
	local anyFight = false
	for _, ally in allies do
		local dx = ally.position.x - helper.position.x
		local dy = ally.position.y - helper.position.y
		local dz = ally.position.z - helper.position.z
		-- Written as <= so a NaN position or radius makes the test false and reaches nobody.
		local near = math.sqrt(dx * dx + dy * dy + dz * dz) <= radius
		if near and not ally.inDuel and not (helper.protected and ally.inFight) then
			table.insert(ids, ally.id)
			if ally.inFight then
				anyFight = true
			end
		end
	end
	return ids, anyFight
end

function Party.inFight(marked: boolean, lastFightAt: number?, now: number): boolean
	if marked then
		return true
	end
	-- Written with not (>=) so a NaN time counts as still fighting.
	return lastFightAt ~= nil and not (now - lastFightAt >= Party.FIGHT_SECONDS)
end

return Party
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">PartyView</string>
            <string name="Source"><![CDATA[--!strict
-- What the party panel shows (spec 3.15), from the server's PartySync and the health the client
-- already knows. Pure: the client draws it, and a missing or odd number never breaks a row.
local Party = require("./Party")

export type Member = { userId: number, name: string }
-- Members in join order.
export type Sync = { leader: number, members: { Member } }
export type Health = { health: number, max: number }
export type Row = {
	userId: number,
	name: string,
	isSelf: boolean,
	healthText: string,
	share: number,
	canRemove: boolean,
	canLead: boolean,
}

local PartyView = {}

local UNKNOWN = "—"

local function isFinite(n: any): boolean
	return type(n) == "number" and n == n and n > -math.huge and n < math.huge
end

local function healthOf(h: Health?): (string, number)
	if h == nil or not isFinite(h.health) or not isFinite(h.max) or h.max <= 0 then
		return UNKNOWN, 0
	end
	if h.health <= 0 then
		return "defeated", 0
	end
	local text = string.format("%d / %d", math.ceil(math.min(h.health, h.max)), math.floor(h.max))
	return text, math.clamp(h.health / h.max, 0, 1)
end

local function rowFor(
	member: Member,
	sync: Sync,
	selfId: number,
	healths: { [string]: Health }
): Row
	local text, share = healthOf(healths[tostring(member.userId)])
	local isSelf = member.userId == selfId
	local leads = sync.leader == selfId and not isSelf
	return {
		userId = member.userId,
		name = if member.userId == sync.leader then member.name .. " (leader)" else member.name,
		isSelf = isSelf,
		healthText = text,
		share = share,
		canRemove = leads,
		canLead = leads,
	}
end

function PartyView.title(sync: Sync?): string
	if sync == nil then
		return ""
	end
	return string.format("Party %d / %d", #sync.members, Party.MAX_SIZE)
end

function PartyView.rows(sync: Sync?, selfId: number, healths: { [string]: Health }): { Row }
	local rows: { Row } = {}
	if sync == nil then
		return rows
	end
	for _, member in sync.members do
		if member.userId == selfId then
			table.insert(rows, rowFor(member, sync, selfId, healths))
		end
	end
	for _, member in sync.members do
		if member.userId ~= selfId then
			table.insert(rows, rowFor(member, sync, selfId, healths))
		end
	end
	return rows
end

function PartyView.allyIds(sync: Sync?, selfId: number): { number }
	local ids: { number } = {}
	if sync == nil then
		return ids
	end
	for _, member in sync.members do
		if member.userId ~= selfId then
			table.insert(ids, member.userId)
		end
	end
	return ids
end

function PartyView.inviteText(from: string): string
	return from .. " invites you to their party"
end

return PartyView
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">PathProgress</string>
            <string name="Source"><![CDATA[--!strict
local Abilities = require("../Catalog/Abilities")
local Paths = require("../Catalog/Paths")
local Types = require("../Types")

type PathProgress = Types.PathProgress
type PathId = Types.PathId

local PathProgress = {}

PathProgress.MAX_LEVEL = 20
PathProgress.CALLING_START_LEVEL = 3
PathProgress.CHANGE_COST = 500
PathProgress.CHANGE_COOLDOWN = 604800

local RATES = { 1, 0.8, 0.6, 0.4 }
local LOADOUT_SIZE = 4

local function indexOf(path: string): number?
	for i, id in Paths.order do
		if id == path then
			return i
		end
	end
	return nil
end

local function finite(value: any): boolean
	return type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

function PathProgress.distance(a: PathId, b: PathId): number
	local ia, ib = indexOf(a), indexOf(b)
	if ia == nil or ib == nil then
		return 3
	end
	local d = math.abs(ia - ib)
	return math.min(d, #Paths.order - d)
end

function PathProgress.learningRate(calling: string, path: string): number
	if not Paths.isPath(calling) or not Paths.isPath(path) then
		return 0
	end
	return RATES[PathProgress.distance(calling :: PathId, path :: PathId) + 1] or 0
end

function PathProgress.totalXpForLevel(level: number): number
	return 100 * (level - 1) * level / 2
end

function PathProgress.maxXp(): number
	return PathProgress.totalXpForLevel(PathProgress.MAX_LEVEL)
end

function PathProgress.levelForXp(xp: number): number
	if type(xp) ~= "number" or not (xp > 0) then
		return 1
	end
	for level = PathProgress.MAX_LEVEL, 2, -1 do
		if xp >= PathProgress.totalXpForLevel(level) then
			return level
		end
	end
	return 1
end

function PathProgress.level(progress: PathProgress, path: string): number
	local xp = progress.xp[path]
	if xp == nil then
		return 1
	end
	return PathProgress.levelForXp(xp)
end

function PathProgress.new(): PathProgress
	local xp: { [string]: number } = {}
	for _, path in Paths.order do
		xp[path] = 0
	end
	return {
		calling = "",
		xp = xp,
		loadout = table.create(LOADOUT_SIZE, ""),
		callingChanges = 0,
		callingChangedAt = 0,
	}
end

local function copy(progress: PathProgress): PathProgress
	return {
		calling = progress.calling,
		xp = table.clone(progress.xp),
		loadout = table.clone(progress.loadout),
		callingChanges = progress.callingChanges,
		callingChangedAt = progress.callingChangedAt,
	}
end

function PathProgress.unlocked(progress: PathProgress): { string }
	local result = {}
	for _, ability in Abilities.list do
		if PathProgress.level(progress, ability.path) >= ability.unlockLevel then
			table.insert(result, ability.id)
		end
	end
	return result
end

local function unlockedBetween(path: string, before: number, after: number): { string }
	local result = {}
	for _, ability in Abilities.forPath(path :: PathId) do
		if ability.unlockLevel > before and ability.unlockLevel <= after then
			table.insert(result, ability.id)
		end
	end
	return result
end

function PathProgress.chooseCalling(
	progress: PathProgress,
	raw: any
): (PathProgress?, string, { string })
	if not Paths.isPath(raw) then
		return nil, "BAD_REQUEST", {}
	end
	if progress.calling ~= "" then
		return nil, "CALLING_ALREADY_SET", {}
	end
	local path = raw :: string
	local result = copy(progress)
	local before = PathProgress.level(progress, path)
	result.calling = path
	local start = PathProgress.totalXpForLevel(PathProgress.CALLING_START_LEVEL)
	result.xp[path] = math.max(result.xp[path] or 0, start)
	local after = PathProgress.level(result, path)
	return result, "CALLING_CHOSEN", unlockedBetween(path, before, after)
end

function PathProgress.changeCalling(
	progress: PathProgress,
	raw: any,
	coin: number,
	now: number
): (PathProgress?, string, number)
	if not Paths.isPath(raw) then
		return nil, "BAD_REQUEST", 0
	end
	if progress.calling == "" then
		return nil, "NO_CALLING", 0
	end
	if progress.calling == raw then
		return nil, "CALLING_SAME", 0
	end
	-- Written so NaN fails safe: only a clearly elapsed cooldown passes.
	if
		progress.callingChangedAt > 0
		and not (now - progress.callingChangedAt >= PathProgress.CHANGE_COOLDOWN)
	then
		return nil, "CALLING_COOLDOWN", 0
	end
	local cost = if progress.callingChanges == 0 then 0 else PathProgress.CHANGE_COST
	if not (coin >= cost) then
		return nil, "NOT_ENOUGH_COIN", 0
	end
	local result = copy(progress)
	result.calling = raw :: string
	result.callingChanges = progress.callingChanges + 1
	result.callingChangedAt = now
	return result, "CALLING_CHANGED", cost
end

function PathProgress.addXp(
	progress: PathProgress,
	path: string,
	base: number
): (PathProgress, number, number, { string })
	if not Paths.isPath(path) or progress.calling == "" or not finite(base) or not (base > 0) then
		return progress, 0, 0, {}
	end
	local rate = PathProgress.learningRate(progress.calling, path)
	local current = progress.xp[path] or 0
	local room = math.max(0, PathProgress.maxXp() - current)
	local gained = math.min(math.max(0, math.floor(base * rate)), room)
	if not (gained > 0) then
		return progress, 0, 0, {}
	end
	local result = copy(progress)
	result.xp[path] = current + gained
	local before = PathProgress.levelForXp(current)
	local after = PathProgress.levelForXp(current + gained)
	return result, gained, after - before, unlockedBetween(path, before, after)
end

-- Turns arbitrary saved data into valid PathProgress. Never errors.
function PathProgress.sanitize(raw: any): PathProgress
	local result = PathProgress.new()
	if type(raw) ~= "table" then
		return result
	end
	if Paths.isPath(raw.calling) then
		result.calling = raw.calling
	end
	local rawXp = raw.xp
	if type(rawXp) == "table" then
		for _, path in Paths.order do
			local value = rawXp[path]
			if finite(value) then
				result.xp[path] = math.clamp(value, 0, PathProgress.maxXp())
			end
		end
	end
	if finite(raw.callingChanges) and raw.callingChanges >= 0 then
		result.callingChanges = raw.callingChanges
	end
	if finite(raw.callingChangedAt) and raw.callingChangedAt >= 0 then
		result.callingChangedAt = raw.callingChangedAt
	end
	local rawLoadout = raw.loadout
	if type(rawLoadout) == "table" then
		local owned = {}
		for _, id in PathProgress.unlocked(result) do
			owned[id] = true
		end
		local used = {}
		for i = 1, LOADOUT_SIZE do
			local id = rawLoadout[i]
			if type(id) == "string" and owned[id] and not used[id] then
				used[id] = true
				result.loadout[i] = id
			end
		end
	end
	return result
end

return PathProgress
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">PathView</string>
            <string name="Source"><![CDATA[--!strict
local Abilities = require("../Catalog/Abilities")
local Loadout = require("./Loadout")
local PathProgress = require("./PathProgress")
local Paths = require("../Catalog/Paths")
local Types = require("../Types")

type PathProgress = Types.PathProgress

export type AbilityView = {
	id: string,
	name: string,
	description: string,
	unlockLevel: number,
	unlocked: boolean,
	equippedSlot: number,
}
export type RowView = {
	path: string,
	name: string,
	style: string,
	level: number,
	xpText: string,
	rateText: string,
	isCalling: boolean,
	abilities: { AbilityView },
	changeText: string,
	canChange: boolean,
}
export type SlotView = { slot: number, abilityId: string, name: string }
export type View = {
	needsCalling: boolean,
	callingText: string,
	rows: { RowView },
	slots: { SlotView },
}

local SECONDS_PER_DAY = 86400

local PathView = {}

local function xpText(xp: number, level: number): string
	if level >= PathProgress.MAX_LEVEL then
		return "MAX"
	end
	local floor = PathProgress.totalXpForLevel(level)
	local into = math.floor(xp - floor)
	local needed = PathProgress.totalXpForLevel(level + 1) - floor
	return `{into} / {needed}`
end

local function changeState(progress: PathProgress, coin: number, now: number): (string, boolean)
	-- Mirrors PathProgress.changeCalling: the cooldown applies once a change has been made.
	if
		progress.callingChangedAt > 0
		and not (now - progress.callingChangedAt >= PathProgress.CHANGE_COOLDOWN)
	then
		local left = progress.callingChangedAt + PathProgress.CHANGE_COOLDOWN - now
		return `Available in {math.ceil(left / SECONDS_PER_DAY)} days`, false
	end
	if progress.callingChanges == 0 then
		return "Free", true
	end
	return `{PathProgress.CHANGE_COST} Coin`, coin >= PathProgress.CHANGE_COST
end

function PathView.build(progress: PathProgress, coin: number, now: number): View
	local hasCalling = progress.calling ~= ""
	local slotOf: { [string]: number } = {}
	for slot, id in progress.loadout do
		if id ~= "" then
			slotOf[id] = slot
		end
	end

	local rows: { RowView } = {}
	for _, path in Paths.order do
		local info = Paths.info[path]
		local level = PathProgress.level(progress, path)
		local abilities: { AbilityView } = {}
		for _, ability in Abilities.forPath(path) do
			table.insert(abilities, {
				id = ability.id,
				name = ability.name,
				description = ability.description,
				unlockLevel = ability.unlockLevel,
				unlocked = level >= ability.unlockLevel,
				equippedSlot = slotOf[ability.id] or 0,
			})
		end
		local isCalling = hasCalling and progress.calling == path
		local changeText, canChange = "", false
		if hasCalling and not isCalling then
			changeText, canChange = changeState(progress, coin, now)
		end
		table.insert(rows, {
			path = path,
			name = info.name,
			style = info.style,
			level = level,
			xpText = xpText(progress.xp[path] or 0, level),
			rateText = if hasCalling
				then `{math.floor(PathProgress.learningRate(progress.calling, path) * 100 + 0.5)}%`
				else "—",
			isCalling = isCalling,
			abilities = abilities,
			changeText = changeText,
			canChange = canChange,
		})
	end

	local slots: { SlotView } = {}
	for slot = 1, Loadout.SLOTS do
		local id = progress.loadout[slot] or ""
		local ability = Abilities.byId[id]
		table.insert(
			slots,
			{ slot = slot, abilityId = id, name = if ability then ability.name else "" }
		)
	end

	return {
		needsCalling = not hasCalling,
		callingText = if hasCalling
			then `Calling: {Paths.info[progress.calling :: Types.PathId].name}`
			else "Choose your Calling",
		rows = rows,
		slots = slots,
	}
end

return PathView
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="49">
          <Properties>
            <string name="Name">PlaceView</string>
            <string name="Source"><![CDATA[--!strict
-- Where a point is and which hazards are in effect there. Pure: the client shows this.
local Geography = require("./Geography")
local Hazards = require("./Hazards")
local Regions = require("../Catalog/Regions")
local Sites = require("../Catalog/Sites")

export type Place = { regionId: string, name: string, hint: string, hazards: { string } }

local PlaceView = {}

-- The region at (x, z) and the names of the hazards active there at server time `now`.
-- A position that is not a finite number reads as Counting Fields with no hazards.
function PlaceView.at(x: number, z: number, now: number): Place
	local regionId = Geography.regionAt(x, z)
	local region = Regions.byId[regionId]
	local sample = Hazards.sample(Sites.hazards, x, z, now)
	return {
		regionId = regionId,
		name = region.name,
		hint = region.hint,
		hazards = sample.names,
	}
end

return PlaceView
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="50">
          <Properties>
            <string name="Name">Protection</string>
            <string name="Source"><![CDATA[--!strict
local World = require("../Catalog/World")
local Combat = require("./Combat")
local LedgerRules = require("./Ledger")
local Types = require("../Types")

type Vec3 = Types.Vec3
type Ledger = Types.Ledger

export type Status = {
	inSafeZone: boolean,
	newShield: boolean,
	respawnShieldUntil: number,
	markedUntil: number,
}
-- key: killerId .. ":" .. victimId -> time of last claim
export type ClaimHistory = { [string]: number }

local Protection = {}

Protection.SHIELD_RELICS = 3
Protection.RESPAWN_SHIELD_SECONDS = 60
Protection.MARKED_SECONDS = 300
Protection.RETALIATE_SECONDS = 30
Protection.CLAIM_COOLDOWN_SECONDS = 3600

local function claimKey(killerId: number, victimId: number): string
	return tostring(killerId) .. ":" .. tostring(victimId)
end

function Protection.inSafeZone(position: Vec3): boolean
	local distance = math.sqrt(position.x * position.x + position.z * position.z)
	-- Written as a negation so a NaN position counts as inside (protected), not outside.
	return not (distance > World.townRadius)
end

-- Claimed Relics plus spare ones. Edicts do not count.
function Protection.shouldEndShield(ledger: Ledger): boolean
	return LedgerRules.relicCount(ledger) >= Protection.SHIELD_RELICS
end

function Protection.isMarked(status: Status, now: number): boolean
	-- NaN compares false, so a NaN time reads as NOT Marked, which keeps safe-zone protection.
	return now < status.markedUntil
end

function Protection.isShielded(status: Status, now: number): boolean
	-- Written as a negation so a NaN time counts as still shielded (fails closed).
	return status.newShield or not (now >= status.respawnShieldUntil)
end

function Protection.canDamage(attacker: Status, victim: Status, now: number): (boolean, string?)
	if attacker.newShield then
		return false, "SHIELD_SELF"
	end
	if Protection.isShielded(victim, now) then
		return false, "TARGET_SHIELDED"
	end
	local victimMarked = Protection.isMarked(victim, now)
	if victim.inSafeZone and not victimMarked then
		return false, "SAFE_ZONE"
	end
	if attacker.inSafeZone and not victimMarked then
		return false, "SAFE_ZONE"
	end
	return true, nil
end

-- A creature hurting a player. The safe zone stops it, Marked or not, and so does the
-- respawn shield (a NaN time counts as shielded). The new-player shield does not.
function Protection.creatureCanHit(victim: Status, now: number): boolean
	if victim.inSafeZone then
		return false
	end
	return now >= victim.respawnShieldUntil
end

-- A player hurting a creature. Only standing in the safe zone stops it; the new-player
-- shield does not.
function Protection.canHitCreature(attacker: Status): (boolean, string?)
	if attacker.inSafeZone then
		return false, "SAFE_ZONE"
	end
	return true, nil
end

-- True when this hit starts a fight: the victim is not Marked and neither the victim nor
-- anyone in `victimAllies` hit the attacker recently.
function Protection.isAggressor(
	log: Combat.HitLog,
	attackerId: number,
	victimId: number,
	victimMarked: boolean,
	now: number,
	victimAllies: { number }?
): boolean
	if victimMarked then
		return false
	end
	local entry = log[tostring(attackerId)]
	if
		entry ~= nil
		and (entry.attackerId == victimId or (victimAllies ~= nil and table.find(
			victimAllies,
			entry.attackerId
		) ~= nil))
		and now - entry.at <= Protection.RETALIATE_SECONDS
	then
		return false
	end
	return true
end

function Protection.canClaim(
	history: ClaimHistory,
	killerId: number,
	victimId: number,
	now: number
): boolean
	local last = history[claimKey(killerId, victimId)]
	return last == nil or now - last >= Protection.CLAIM_COOLDOWN_SECONDS
end

function Protection.recordClaim(
	history: ClaimHistory,
	killerId: number,
	victimId: number,
	now: number
): ClaimHistory
	local newHistory = table.clone(history)
	newHistory[claimKey(killerId, victimId)] = now
	return newHistory
end

-- A claim for every killer id (the killer's whole party).
function Protection.recordClaims(
	history: ClaimHistory,
	killerIds: { number },
	victimId: number,
	now: number
): ClaimHistory
	local newHistory = table.clone(history)
	for _, killerId in killerIds do
		newHistory[claimKey(killerId, victimId)] = now
	end
	return newHistory
end

return Protection
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="51">
          <Properties>
            <string name="Name">RateLimiter</string>
            <string name="Source"><![CDATA[--!strict

-- Token bucket. `allow` mutates its bucket (the one deliberate exception to
-- the no-mutation rule for rules modules).
export type Bucket = { tokens: number, last: number }

local RateLimiter = {}

function RateLimiter.new(capacity: number, now: number): Bucket
	return { tokens = capacity, last = now }
end

function RateLimiter.allow(
	bucket: Bucket,
	now: number,
	capacity: number,
	refillPerSecond: number
): boolean
	local elapsed = math.max(0, now - bucket.last)
	bucket.tokens = math.min(capacity, bucket.tokens + elapsed * refillPerSecond)
	bucket.last = math.max(bucket.last, now)
	if bucket.tokens >= 1 then
		bucket.tokens -= 1
		return true
	end
	return false
end

return RateLimiter
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="52">
          <Properties>
            <string name="Name">Regen</string>
            <string name="Source"><![CDATA[--!strict
-- Health that returns slowly once a fighter has been left alone. Pure. Every check is written so
-- that NaN refuses.
local Regen = {}

Regen.DELAY = 10
Regen.PER_SECOND = 1
Regen.MAX_STEP = 1

function Regen.step(
	health: number,
	maxHealth: number,
	lastHurtAt: number,
	now: number,
	dt: number
): number
	if
		health > 0
		and maxHealth > 0
		and maxHealth < math.huge
		and health < maxHealth
		and now - lastHurtAt >= Regen.DELAY
		and dt > 0
		and dt < math.huge
	then
		return math.min(maxHealth, health + Regen.PER_SECOND * math.min(dt, Regen.MAX_STEP))
	end
	return health
end

return Regen
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="53">
          <Properties>
            <string name="Name">Renounce</string>
            <string name="Source"><![CDATA[--!strict
-- Renounce (spec 3.15): when it is allowed, the two-step offer and confirm, and what it
-- returns and keeps. Pure: the server gathers the facts and applies the result.
local Crown = require("./Crown")
local EdictRules = require("./EdictRules")
local Relics = require("../Catalog/Relics")
local Rounds = require("./Rounds")
local Types = require("../Types")

type CrownRecord = Types.CrownRecord
type Ledger = Types.Ledger
type RoundsRecord = Types.RoundsRecord
type TrialRecord = Types.TrialRecord
type Vault = Types.Vault

export type State = {
	loaded: boolean,
	complete: boolean,
	crowns: number,
	stars: number,
	alive: boolean,
	locked: boolean,
	claiming: boolean,
	trading: boolean,
	inTrial: boolean,
	inTown: boolean,
	marked: boolean,
	lastFightAt: number?,
}
export type Offer = { expiresAt: number }
export type Request = { kind: string, word: string? }
export type Parts = {
	ledger: Ledger,
	vault: Vault,
	crown: CrownRecord,
	trials: TrialRecord,
	rounds: RoundsRecord,
}

local Renounce = {}

Renounce.OFFER_SECONDS = 60
Renounce.FIGHT_SECONDS = 30
Renounce.WORD = "RENOUNCE"
Renounce.MAX_WORD_LENGTH = 32

-- The first refusal in spec order, or true, "RENOUNCE_OFFER". The Marked and fight refusals
-- are EdictRules.canDeal (its 30 s window equals FIGHT_SECONDS).
function Renounce.check(state: State, now: number): (boolean, string)
	if not state.loaded then
		return false, "DATA_NOT_LOADED"
	end
	if not state.complete or not (state.crowns > state.stars) then
		return false, "RENOUNCE_NOT_READY"
	end
	if not state.alive then
		return false, "EDICT_NOT_NOW"
	end
	if state.locked then
		return false, "LEDGER_LOCKED"
	end
	if state.claiming then
		return false, "RENOUNCE_CLAIMING"
	end
	if state.trading then
		return false, "RENOUNCE_TRADING"
	end
	if state.inTrial then
		return false, "EDICT_IN_TRIAL"
	end
	if not state.inTown then
		return false, "RENOUNCE_NOT_IN_TOWN"
	end
	local ok, code =
		EdictRules.canDeal({ marked = state.marked, lastFightAt = state.lastFightAt }, now)
	if not ok then
		return false, code or "EDICT_IN_COMBAT"
	end
	return true, "RENOUNCE_OFFER"
end

function Renounce.offer(now: number): Offer
	return { expiresAt = now + Renounce.OFFER_SECONDS }
end

function Renounce.parse(raw: any): (Request?, string)
	if type(raw) ~= "table" then
		return nil, "BAD_REQUEST"
	end
	if raw.kind == "cancel" then
		return { kind = "cancel" }, "OK"
	end
	if raw.kind == "confirm" then
		local word = raw.word
		if type(word) ~= "string" or #word > Renounce.MAX_WORD_LENGTH then
			word = ""
		end
		return { kind = "confirm", word = word }, "OK"
	end
	return nil, "BAD_REQUEST"
end

function Renounce.wordMatches(word: any): boolean
	if type(word) ~= "string" then
		return false
	end
	-- The same cap as parse, so a long string is not scanned.
	if #word > Renounce.MAX_WORD_LENGTH then
		return false
	end
	-- Spec 3.15: any case, and spaces anywhere are ignored.
	local squeezed = string.gsub(word, "%s", "")
	return string.upper(squeezed) == Renounce.WORD
end

function Renounce.confirm(offer: Offer?, word: string, now: number): (boolean, string)
	if offer == nil then
		return false, "RENOUNCE_NO_OFFER"
	end
	if not (now < offer.expiresAt) then
		return false, "RENOUNCE_EXPIRED"
	end
	if not Renounce.wordMatches(word) then
		return false, "RENOUNCE_WORD"
	end
	return true, "OK"
end

-- Every card goes back (claimed, spare and Edicts alike), the Vault empties, a star is
-- earned. Cooldowns and the other Crown fields are kept; the Unpaid Debt and the rounds restart.
function Renounce.apply(parts: Parts): Parts
	local crown = table.clone(parts.crown)
	crown.stars += 1
	local trials = table.clone(parts.trials)
	trials.cooldowns = table.clone(parts.trials.cooldowns)
	trials.questStep = 0
	return {
		ledger = { claimed = {}, free = {} },
		vault = {},
		crown = crown,
		trials = trials,
		rounds = Rounds.new(),
	}
end

function Renounce.offerLines(record: CrownRecord): { string }
	return {
		`Every card in your Ledger goes back to the island: all {Relics.count} claimed Relics, your spare Relics and your Edicts.`,
		"Your Vault empties. The Unpaid Debt, the Warden's Round and the Beast Tally start again.",
		"You keep your Coin, your Paths and abilities, your trial cooldowns and your Crowns.",
		`You earn a star and will show as "{Crown.title(record.crowns, record.stars + 1)}".`,
		"This cannot be undone.",
	}
end

return Renounce
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="54">
          <Properties>
            <string name="Name">Rewards</string>
            <string name="Source"><![CDATA[--!strict
-- Who is paid when a creature is defeated, which Path gets the XP, and which Relics drop.
local Paths = require("../Catalog/Paths")
local Scarcity = require("./Scarcity")
local Types = require("../Types")

-- Damage dealt to one creature, per attacker. Key: tostring(attacker id). lastAt is the last hit
-- or assist; hitAt is the last real hit only (nil for a helper who never hit).
export type Tally = {
	[string]: {
		lastAt: number,
		hitAt: number?,
		total: number,
		byPath: { [string]: number },
		assist: string?,
	},
}
-- room: free slots the player can still fill (0 when their Ledger is locked).
export type Recipient = { calling: string, room: number }
export type Award = {
	userId: number,
	coin: number,
	xpPath: string,
	xp: number,
	relics: { string },
	sealed: { string },
	lost: { string },
}
export type Reward = { coin: number, xp: number, drops: { Types.Drop } }

local Rewards = {}

Rewards.CONTRIBUTOR_SECONDS = 30
Rewards.STRIKE = "Strike"

-- Adds one hit. An amount that is not a positive finite number changes nothing.
function Rewards.record(
	tally: Tally,
	attackerId: number,
	path: string,
	amount: number,
	now: number
): Tally
	if not (amount > 0 and amount < math.huge) then
		return tally
	end
	local key = tostring(attackerId)
	local old = tally[key]
	local byPath = if old ~= nil then table.clone(old.byPath) else {}
	byPath[path] = (byPath[path] or 0) + amount
	local out = table.clone(tally)
	out[key] = {
		lastAt = now,
		hitAt = now,
		total = (if old ~= nil then old.total else 0) + amount,
		byPath = byPath,
	}
	return out
end

-- Support that reaches someone who hit the creature in the last 30 seconds makes the helper a
-- contributor too, with no damage. An assist never sets or changes hitAt. Anything else (self, no contributor reached, not a Path, NaN time) changes nothing.
function Rewards.assist(
	tally: Tally,
	helperId: number,
	helpedIds: { number },
	path: string,
	now: number
): Tally
	if not Paths.isPath(path) then
		return tally
	end
	local reached = false
	for _, id in helpedIds do
		local entry = tally[tostring(id)]
		-- Written positively so a NaN time helps nobody.
		if
			id ~= helperId
			and entry ~= nil
			and entry.hitAt ~= nil
			and now - entry.hitAt <= Rewards.CONTRIBUTOR_SECONDS
		then
			reached = true
			break
		end
	end
	if not reached then
		return tally
	end
	local key = tostring(helperId)
	local old = tally[key]
	local out = table.clone(tally)
	out[key] = {
		lastAt = now,
		hitAt = if old ~= nil then old.hitAt else nil,
		total = if old ~= nil then old.total else 0,
		byPath = if old ~= nil then table.clone(old.byPath) else {},
		assist = path,
	}
	return out
end

-- Everyone who hit within the last 30 seconds: most damage first, ties to the lower id.
function Rewards.contributors(tally: Tally, now: number): { number }
	local rows: { { id: number, total: number } } = {}
	for key, entry in tally do
		local id = tonumber(key)
		-- Written positively so a NaN time makes nobody a contributor.
		if id ~= nil and now - entry.lastAt <= Rewards.CONTRIBUTOR_SECONDS then
			table.insert(rows, { id = id, total = entry.total })
		end
	end
	table.sort(rows, function(a, b)
		if a.total ~= b.total then
			return a.total > b.total
		end
		return a.id < b.id
	end)
	local ids: { number } = {}
	for _, row in rows do
		table.insert(ids, row.id)
	end
	return ids
end

-- The Path the XP goes to: the one that dealt the most damage. The Strike counts as the
-- Calling; a tie with the Calling goes to the Calling, other ties to the earlier Path of the
-- hexagon. "" without a Calling. Keys that are not Paths are ignored.
function Rewards.xpPath(byPath: { [string]: number }, calling: string): string
	if calling == "" then
		return ""
	end
	local best, bestDamage = calling, -1
	for _, path in Paths.order do
		local damage = byPath[path] or 0
		if path == calling then
			damage += byPath[Rewards.STRIKE] or 0
		end
		if damage > bestDamage or (damage == bestDamage and path == calling) then
			best, bestDamage = path, damage
		end
	end
	return best
end

-- One Award per contributor found in `recipients`, in contributors() order (by damage, so an
-- assist-only contributor is served last). Each contributor rolls every drop once, in drop
-- order; a roll below the chance wins. A won Relic is sealed when the server already holds
-- its cap (`held` plus the copies given earlier in this call), else lost when the contributor
-- has no room left, else given.
function Rewards.awards(
	reward: Reward,
	tally: Tally,
	recipients: { [string]: Recipient },
	held: { [string]: number },
	now: number,
	rng: () -> number
): { Award }
	local given: { [string]: number } = {}
	local awards: { Award } = {}
	for _, id in Rewards.contributors(tally, now) do
		local recipient = recipients[tostring(id)]
		if recipient == nil then
			continue
		end
		local entry = tally[tostring(id)]
		local xpPath
		if entry.total == 0 and entry.assist ~= nil then
			-- Support only: paid in the Path of the support, but never without a Calling.
			xpPath = if recipient.calling == "" then "" else entry.assist
		else
			xpPath = Rewards.xpPath(entry.byPath, recipient.calling)
		end
		local award: Award = {
			userId = id,
			coin = reward.coin,
			xpPath = xpPath,
			xp = if xpPath == "" then 0 else reward.xp,
			relics = {},
			sealed = {},
			lost = {},
		}
		for _, drop in reward.drops do
			if rng() < drop.chance then
				local relicId = drop.relicId
				local copies = (held[relicId] or 0) + (given[relicId] or 0)
				if Scarcity.isSealed(relicId, copies) then
					table.insert(award.sealed, relicId)
				elseif #award.relics >= recipient.room then
					table.insert(award.lost, relicId)
				else
					table.insert(award.relics, relicId)
					given[relicId] = (given[relicId] or 0) + 1
				end
			end
		end
		table.insert(awards, award)
	end
	return awards
end

return Rewards
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="55">
          <Properties>
            <string name="Name">Rounds</string>
            <string name="Source"><![CDATA[--!strict
-- The two rounds (Warden's Round, Beast Tally): which steps are done this round. Each step
-- counts once; finishing the last one completes the round and empties its list. Pure.
local Trials = require("../Catalog/Trials")
local Types = require("../Types")

type RoundsRecord = Types.RoundsRecord

local Rounds = {}

function Rounds.new(): RoundsRecord
	local record: RoundsRecord = {}
	for _, round in Trials.rounds do
		record[round.id] = {}
	end
	return record
end

function Rounds.sanitize(raw: any): RoundsRecord
	local out = Rounds.new()
	if type(raw) ~= "table" then
		return out
	end
	for _, round in Trials.rounds do
		local saved = raw[round.id]
		if type(saved) == "table" then
			local isStep: { [string]: boolean } = {}
			for _, step in round.steps do
				isStep[step] = true
			end
			local seen: { [string]: boolean } = {}
			local kept: { string } = {}
			for _, entry in saved do
				if type(entry) == "string" and isStep[entry] and not seen[entry] then
					seen[entry] = true
					table.insert(kept, entry)
				end
			end
			if #kept < #round.steps then
				out[round.id] = kept
			end
		end
	end
	return out
end

-- Returns the new record and "ROUND_STEP" or "ROUND_COMPLETE"; the same record and "" when
-- nothing counts (unknown round, step not in it, step already done).
function Rounds.advance(
	record: RoundsRecord,
	roundId: string,
	stepId: string
): (RoundsRecord, string)
	local round = Trials.roundById[roundId]
	if round == nil or not table.find(round.steps, stepId) then
		return record, ""
	end
	local done = record[roundId] or {}
	if table.find(done, stepId) then
		return record, ""
	end
	local out = table.clone(record)
	local list = table.clone(done)
	table.insert(list, stepId)
	if #list >= #round.steps then
		out[roundId] = {}
		return out, "ROUND_COMPLETE"
	end
	out[roundId] = list
	return out, "ROUND_STEP"
end

function Rounds.line(raw: any): string
	local record = Rounds.sanitize(raw)
	local parts: { string } = {}
	for _, round in Trials.rounds do
		table.insert(parts, `{round.short} {#record[round.id]} / {#round.steps}`)
	end
	return table.concat(parts, ", ")
end

return Rounds
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="56">
          <Properties>
            <string name="Name">Scarcity</string>
            <string name="Source"><![CDATA[--!strict
local Ledger = require("./Ledger")
local Relics = require("../Catalog/Relics")
local Tiers = require("../Catalog/Tiers")
local Types = require("../Types")

type CardId = Types.CardId
type Ledger = Types.Ledger

local Scarcity = {}

-- Copies of one Relic held across the given ledgers, claimed and spare alike; a complete
-- Ledger counts only its spare copies.
function Scarcity.countHeld(ledgers: { Ledger }, relicId: CardId): number
	local total = 0
	for _, ledger in ledgers do
		if Ledger.isComplete(ledger) then
			-- A Crowned Ledger steps aside: its claimed copies do not hold a Relic back from others.
			for _, id in ledger.free do
				if id == relicId then
					total += 1
				end
			end
		else
			total += Ledger.count(ledger, relicId)
		end
	end
	return total
end

-- A cache is sealed once the server holds as many copies as the tier cap.
-- Tiers without a cap, and unknown ids, are never sealed.
function Scarcity.isSealed(relicId: CardId, held: number): boolean
	local relic = Relics.byId[relicId]
	if relic == nil then
		return false
	end
	local cap = Tiers.info[relic.tier].serverCap
	return cap ~= nil and held >= cap
end

return Scarcity
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="57">
          <Properties>
            <string name="Name">Shop</string>
            <string name="Source"><![CDATA[--!strict
-- The Edict Hall: buying a pack, buying a Copper Relic, selling a free-slot card, and the
-- shop window's display data (spec 3.13). Pure: the server checks where the player stands
-- and writes the result.
local Cards = require("../Catalog/Cards")
local Edicts = require("../Catalog/Edicts")
local Ledger = require("./Ledger")
local ShopCatalog = require("../Catalog/Shop")
local Types = require("../Types")

type Ledger = Types.Ledger

export type StockRow = { relicId: string, name: string, priceText: string, canBuy: boolean }
export type SellRow = { index: number, cardId: string, name: string, priceText: string }
export type View = {
	coinText: string,
	packText: string,
	oddsText: string,
	canBuyPack: boolean,
	stock: { StockRow },
	sell: { SellRow },
}

local MAX_CARD_ID_LENGTH = 16

local Shop = {}

-- Written positively so Coin that is not a real, non-negative number affords nothing.
local function affords(coin: number, price: number): boolean
	return coin >= price and coin < math.huge
end

-- The Edicts of one pack: one roll per card, each on its own, by the catalog's weights.
-- A roll outside 0..1 still gives a card.
function Shop.drawPack(rng: () -> number): { string }
	local total = 0
	for _, edict in Edicts.list do
		total += edict.weight
	end
	local cards: { string } = {}
	for _ = 1, ShopCatalog.PACK_SIZE do
		local roll = rng()
		if not (roll >= 0) then
			roll = 0
		end
		local mark = roll * total
		local picked = Edicts.list[#Edicts.list].id
		local sum = 0
		for _, edict in Edicts.list do
			sum += edict.weight
			if mark < sum then
				picked = edict.id
				break
			end
		end
		table.insert(cards, picked)
	end
	return cards
end

local function buyPack(
	ledger: Ledger,
	coin: number,
	rng: () -> number
): (Ledger?, number, string, { [string]: string }?)
	local price = ShopCatalog.PACK_PRICE
	if not affords(coin, price) then
		return nil, coin, "NOT_ENOUGH_COIN", { cost = tostring(price) }
	end
	if Ledger.room(ledger) < ShopCatalog.PACK_SIZE then
		return nil, coin, "SHOP_NO_ROOM", { count = tostring(ShopCatalog.PACK_SIZE) }
	end
	local cards = Shop.drawPack(rng)
	local free = table.clone(ledger.free)
	for _, id in cards do
		table.insert(free, id)
	end
	return { claimed = table.clone(ledger.claimed), free = free },
		coin - price,
		"SHOP_PACK",
		{ names = Cards.names(cards) }
end

local function buyRelic(
	ledger: Ledger,
	coin: number,
	relicId: any
): (Ledger?, number, string, { [string]: string }?)
	if type(relicId) ~= "string" or table.find(ShopCatalog.stock, relicId) == nil then
		return nil, coin, "NOT_FOR_SALE", nil
	end
	local price = ShopCatalog.RELIC_PRICE
	if not affords(coin, price) then
		return nil, coin, "NOT_ENOUGH_COIN", { cost = tostring(price) }
	end
	local result, err = Ledger.add(ledger, relicId)
	if result == nil then
		return nil, coin, err or "FREE_FULL", nil
	end
	return result, coin - price, "SHOP_BOUGHT", { name = Cards.name(relicId) }
end

-- The request carries the card the player saw on that row; if the free list has shifted (a
-- double click) the card there differs and nothing is sold.
local function sell(
	ledger: Ledger,
	coin: number,
	raw: any
): (Ledger?, number, string, { [string]: string }?)
	local freeIndex, cardId = raw.freeIndex, raw.cardId
	if type(freeIndex) ~= "number" then
		return nil, coin, "BAD_REQUEST", nil
	end
	if type(cardId) ~= "string" or #cardId > MAX_CARD_ID_LENGTH then
		return nil, coin, "BAD_REQUEST", nil
	end
	if freeIndex ~= math.floor(freeIndex) or ledger.free[freeIndex] ~= cardId then
		return nil, coin, "BAD_INDEX", nil
	end
	local price = ShopCatalog.sellPrice(cardId)
	if price == nil then
		return nil, coin, "NOT_FOR_SALE", nil
	end
	local result, err = Ledger.discard(ledger, freeIndex)
	if result == nil then
		return nil, coin, err or "BAD_INDEX", nil
	end
	local paid = if coin >= 0 and coin < math.huge then coin + price else coin
	return result, paid, "SHOP_SOLD", { name = Cards.name(cardId), coin = tostring(price) }
end

-- Validates a raw client request and applies it. Request shapes:
--   { kind = "pack" } | { kind = "relic", relicId = string }
--   | { kind = "sell", freeIndex = number, cardId = string }
-- Success: the new Ledger, the new Coin, a message code and its arguments.
-- Failure: nil, the same Coin, an error code (and arguments). Never errors on hostile input.
function Shop.apply(
	ledger: Ledger?,
	coin: number,
	raw: any,
	rng: () -> number
): (Ledger?, number, string, { [string]: string }?)
	if ledger == nil then
		return nil, coin, "DATA_NOT_LOADED", nil
	end
	if type(raw) ~= "table" then
		return nil, coin, "BAD_REQUEST", nil
	end
	local kind = raw.kind
	if kind == "pack" then
		return buyPack(ledger, coin, rng)
	elseif kind == "relic" then
		return buyRelic(ledger, coin, raw.relicId)
	elseif kind == "sell" then
		return sell(ledger, coin, raw)
	end
	return nil, coin, "BAD_REQUEST", nil
end

-- What the shop window shows for this player.
function Shop.view(ledger: Ledger, coin: number): View
	local held = if coin >= 0 and coin < math.huge then math.floor(coin) else 0
	local room = Ledger.room(ledger)
	local stock: { StockRow } = {}
	for _, relicId in ShopCatalog.stock do
		table.insert(stock, {
			relicId = relicId,
			name = Cards.name(relicId),
			priceText = `{ShopCatalog.RELIC_PRICE} Coin`,
			canBuy = held >= ShopCatalog.RELIC_PRICE and room >= 1,
		})
	end
	local sellRows: { SellRow } = {}
	for index, cardId in ledger.free do
		local price = ShopCatalog.sellPrice(cardId)
		if price ~= nil then
			table.insert(sellRows, {
				index = index,
				cardId = cardId,
				name = Cards.name(cardId),
				priceText = `+{price} Coin`,
			})
		end
	end
	return {
		coinText = `Coin: {held}`,
		packText = `Edict pack: {ShopCatalog.PACK_SIZE} Edicts for {ShopCatalog.PACK_PRICE} Coin`,
		oddsText = ShopCatalog.oddsText,
		canBuyPack = held >= ShopCatalog.PACK_PRICE and room >= ShopCatalog.PACK_SIZE,
		stock = stock,
		sell = sellRows,
	}
end

return Shop
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="58">
          <Properties>
            <string name="Name">Sources</string>
            <string name="Source"><![CDATA[--!strict
local Ledger = require("./Ledger")
local Relics = require("../Catalog/Relics")
local Tiers = require("../Catalog/Tiers")
local Types = require("../Types")

type Cache = Types.Cache
type Ledger = Types.Ledger

-- cache id -> time it becomes available
export type SourceState = { [string]: number }

local Sources = {}

Sources.MAX_DISTANCE = 15
-- Network and frame jitter allowed on a held prompt.
Sources.HOLD_SLACK = 0.3

-- Whether a held cache's prompt was held long enough and the hold was still running at `now` (or
-- ended within the slack). hold is nil for an ordinary cache; began and ended are the server's
-- own times for the prompt starting and ending. An old, released hold never counts.
function Sources.holdOk(hold: number?, began: number?, ended: number?, now: number): boolean
	if hold == nil then
		return true
	end
	if began == nil then
		return false
	end
	if ended ~= nil and not (now - ended <= Sources.HOLD_SLACK) then
		return false
	end
	return (ended or now) - began >= hold - Sources.HOLD_SLACK
end

function Sources.new(caches: { Cache }): SourceState
	local state: SourceState = {}
	for _, cache in caches do
		state[cache.id] = 0
	end
	return state
end

function Sources.isAvailable(state: SourceState, cacheId: string, now: number): boolean
	local availableAt = state[cacheId]
	return availableAt ~= nil and now >= availableAt
end

-- Puts a Relic in a free slot: the one way a cache, a creature, a trial or the quest gives
-- one. Checks run in order: data, locked ledger, unknown Relic, sealed, free slots.
function Sources.give(
	ledger: Ledger?,
	relicId: Types.CardId,
	sealed: boolean,
	locked: boolean
): (Ledger?, string)
	if ledger == nil then
		return nil, "DATA_NOT_LOADED"
	end
	if locked then
		return nil, "LEDGER_LOCKED"
	end
	if Relics.byId[relicId] == nil then
		return nil, "UNKNOWN_CARD"
	end
	if sealed then
		return nil, "SEALED"
	end
	local result, err = Ledger.add(ledger, relicId)
	if result == nil then
		return nil, err or "FREE_FULL"
	end
	return result, "GOT_CARD"
end

-- Checks run in order: data, locked ledger, distance, hold, cache, sealed, free slots. A failure returns the
-- same state untouched, so a refused attempt never consumes the cache.
-- On success the fourth value is the time the cache becomes available again.
function Sources.tryCollect(
	state: SourceState,
	ledger: Ledger?,
	cache: Cache,
	now: number,
	distance: number,
	sealed: boolean,
	locked: boolean,
	holdOk: boolean?
): (SourceState, Ledger?, string, number?)
	if ledger == nil then
		return state, nil, "DATA_NOT_LOADED", nil
	end
	if locked then
		return state, nil, "LEDGER_LOCKED", nil
	end
	if not (distance <= Sources.MAX_DISTANCE) then
		return state, nil, "TOO_FAR", nil
	end
	if holdOk == false then
		return state, nil, "HOLD_TOO_SHORT", nil
	end
	if not Sources.isAvailable(state, cache.id, now) then
		return state, nil, "CACHE_EMPTY", nil
	end
	local relic = Relics.byId[cache.relicId]
	if relic == nil then
		return state, nil, "CACHE_EMPTY", nil
	end
	local result, code = Sources.give(ledger, cache.relicId, sealed, locked)
	if result == nil then
		return state, nil, code, nil
	end
	local newState = table.clone(state)
	local availableAt = now + Tiers.info[relic.tier].cacheRespawnSeconds
	newState[cache.id] = availableAt
	return newState, result, "GOT_CARD", availableAt
end

return Sources
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="59">
          <Properties>
            <string name="Name">StatusView</string>
            <string name="Source"><![CDATA[--!strict
-- Status lines for the HUD. Pure: the client renders this and nothing else.

export type Line =
	{ text: string, kind: "region" | "safe" | "shield" | "marked" | "veil" | "hazard" }
export type Status = { newShield: boolean, respawnShieldSeconds: number, markedSeconds: number }

local StatusView = {}

-- Written so NaN and negative values read as "not running".
local function running(seconds: number): boolean
	return seconds > 0 and seconds < math.huge
end

-- The region comes first, then safe zone and status effects, then the hazards in effect.
-- Without a place there are no region or hazard lines.
function StatusView.build(
	status: Status?,
	inSafeZone: boolean,
	place: { name: string, hazards: { string } }?,
	veilSeconds: number?
): { Line }
	local lines: { Line } = {}
	if place ~= nil then
		table.insert(lines, { text = place.name, kind = "region" })
	end
	if inSafeZone then
		table.insert(lines, { text = "Safe zone", kind = "safe" })
	end
	if status ~= nil then
		if status.newShield then
			table.insert(lines, { text = "New-player shield", kind = "shield" })
		end
		if running(status.respawnShieldSeconds) then
			local seconds = math.ceil(status.respawnShieldSeconds)
			table.insert(lines, { text = `Respawn shield: {seconds}s`, kind = "shield" })
		end
		if running(status.markedSeconds) then
			local total = math.ceil(status.markedSeconds)
			local text = string.format("MARKED %d:%02d", total // 60, total % 60)
			table.insert(lines, { text = text, kind = "marked" })
		end
	end
	-- The Veil is an Edict effect, not part of the status, so it has its own input.
	if veilSeconds ~= nil and running(veilSeconds) then
		local total = math.ceil(veilSeconds)
		local text = string.format("Veiled %d:%02d", total // 60, total % 60)
		table.insert(lines, { text = text, kind = "veil" })
	end
	if place ~= nil then
		for _, name in place.hazards do
			table.insert(lines, { text = name, kind = "hazard" })
		end
	end
	return lines
end

return StatusView
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="60">
          <Properties>
            <string name="Name">Targeting</string>
            <string name="Source"><![CDATA[--!strict
local Types = require("../Types")
local Combat = require("./Combat")

type Vec3 = Types.Vec3
type Fighter = Combat.Fighter

local Targeting = {}

Targeting.SHOT_RADIUS = 2.5
Targeting.DASH_WIDTH = 3

-- Normalised horizontal look, or nil for a zero-length or non-finite look.
local function horizontalLook(attacker: Fighter): (number?, number?)
	local x, z = attacker.look.x, attacker.look.z
	local length = math.sqrt(x * x + z * z)
	if not (length > 0 and length < math.huge) then
		return nil, nil
	end
	return x / length, z / length
end

function Targeting.ahead(attacker: Fighter, distance: number): Vec3
	local x, z = horizontalLook(attacker)
	if x == nil or z == nil then
		return { x = attacker.position.x, y = attacker.position.y, z = attacker.position.z }
	end
	return {
		x = attacker.position.x + x * distance,
		y = attacker.position.y,
		z = attacker.position.z + z * distance,
	}
end

-- Fighters within reach of a ray (direction dirX, dirZ) from the attacker: distance along the
-- ray in (0, length], distance from the ray at most width. Returns the nearest along the ray, or
-- the taunter when it qualifies. Comparisons are written so NaN fails closed.
local function scanRay(
	attacker: Fighter,
	others: { Fighter },
	dirX: number,
	dirZ: number,
	length: number,
	width: number,
	taunter: number?
): number?
	local bestId: number? = nil
	local bestAlong = math.huge
	for _, other in others do
		if other.id == attacker.id then
			continue
		end
		if not (math.abs(other.position.y - attacker.position.y) <= Combat.STRIKE_MAX_HEIGHT) then
			continue
		end
		local dx = other.position.x - attacker.position.x
		local dz = other.position.z - attacker.position.z
		local along = dx * dirX + dz * dirZ
		local across = math.abs(dx * dirZ - dz * dirX)
		if not (along > 0 and along <= length and across <= width) then
			continue
		end
		if taunter ~= nil and other.id == taunter then
			return other.id
		end
		if along < bestAlong then
			bestAlong = along
			bestId = other.id
		end
	end
	return bestId
end

-- Positive angleDegrees turns the look clockwise seen from above (from -z towards +x).
function Targeting.shot(
	attacker: Fighter,
	others: { Fighter },
	range: number,
	angleDegrees: number,
	taunter: number?
): number?
	local lookX, lookZ = horizontalLook(attacker)
	if lookX == nil or lookZ == nil then
		return nil
	end
	local angle = math.rad(angleDegrees)
	local sin, cos = math.sin(angle), math.cos(angle)
	local dirX = lookX * cos - lookZ * sin
	local dirZ = lookX * sin + lookZ * cos
	return scanRay(attacker, others, dirX, dirZ, range, Targeting.SHOT_RADIUS, taunter)
end

function Targeting.inRadius(
	center: Vec3,
	others: { Fighter },
	radius: number,
	excludeId: number?
): { number }
	local ids: { number } = {}
	for _, other in others do
		if excludeId ~= nil and other.id == excludeId then
			continue
		end
		if not (math.abs(other.position.y - center.y) <= Combat.STRIKE_MAX_HEIGHT) then
			continue
		end
		local dx = other.position.x - center.x
		local dz = other.position.z - center.z
		if dx * dx + dz * dz <= radius * radius then
			table.insert(ids, other.id)
		end
	end
	table.sort(ids)
	return ids
end

function Targeting.dashHit(attacker: Fighter, others: { Fighter }, distance: number): number?
	local lookX, lookZ = horizontalLook(attacker)
	if lookX == nil or lookZ == nil then
		return nil
	end
	return scanRay(attacker, others, lookX, lookZ, distance, Targeting.DASH_WIDTH, nil)
end

return Targeting
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="61">
          <Properties>
            <string name="Name">Trade</string>
            <string name="Source"><![CDATA[--!strict
-- A trade between two players as a state machine (spec 3.13): each side's offer, the two
-- confirmations, and the swap. Offers are not held in escrow: `settle` re-checks both live
-- Ledgers and Coin, and swaps everything or nothing. Pure: the server owns the session.
local Cards = require("../Catalog/Cards")
local Ledger = require("./Ledger")
local Types = require("../Types")

type Ledger = Types.Ledger
type Vec3 = Types.Vec3

export type Offer = { cards: { string }, coin: number }
-- `offers` and `confirmed` are keyed by tostring(user id).
export type Session = {
	a: number,
	b: number,
	offers: { [string]: Offer },
	confirmed: { [string]: boolean },
	changedAt: number,
}
export type Body = { userId: number, position: Vec3 }
export type CardView = { cardId: string, name: string }
export type OfferView = { cards: { CardView }, coin: number }
export type FreeRow = { index: number, cardId: string, name: string, offered: boolean }
export type View = {
	otherName: string,
	mine: OfferView,
	theirs: OfferView,
	mineConfirmed: boolean,
	theirsConfirmed: boolean,
	-- Seconds until a confirmation is accepted; 0 when it is now.
	confirmIn: number,
	coinHeld: number,
	status: string,
	free: { FreeRow },
}

local Trade = {}

Trade.MAX_CARDS = 6
Trade.INVITE_RANGE = 15
Trade.KEEP_RANGE = 25
Trade.CONFIRM_DELAY = 2
Trade.INVITE_SECONDS = 20

local function isWholeAmount(n: any): boolean
	return type(n) == "number" and n >= 0 and n < math.huge and n == math.floor(n)
end

-- Written positively so Coin that is not a real number covers nothing.
local function covers(ledger: Ledger, coin: number, offer: Offer): boolean
	return Ledger.holdsFree(ledger, offer.cards) and coin >= offer.coin and coin < math.huge
end

function Trade.new(a: number, b: number, now: number): Session
	return {
		a = a,
		b = b,
		offers = {
			[tostring(a)] = { cards = {}, coin = 0 },
			[tostring(b)] = { cards = {}, coin = 0 },
		},
		confirmed = {},
		changedAt = now,
	}
end

function Trade.has(session: Session, userId: number): boolean
	return userId == session.a or userId == session.b
end

function Trade.other(session: Session, userId: number): number
	return if userId == session.a then session.b else session.a
end

local function withOffer(session: Session, userId: number, offer: Offer, now: number): Session
	local offers = table.clone(session.offers)
	offers[tostring(userId)] = offer
	-- Any change means both must look again.
	return { a = session.a, b = session.b, offers = offers, confirmed = {}, changedAt = now }
end

-- Replaces one side's offer. Raw request: { cards = { card id, ... }, coin = number }. The
-- cards must be in the player's free slots (counting repeats) and the Coin theirs. Both
-- confirmations are cleared, even when the offer is the same as before.
function Trade.setOffer(
	session: Session,
	userId: number,
	raw: any,
	ledger: Ledger?,
	coin: number,
	now: number
): (Session?, string)
	if not Trade.has(session, userId) then
		return nil, "TRADE_NOT_OPEN"
	end
	if ledger == nil then
		return nil, "DATA_NOT_LOADED"
	end
	if type(raw) ~= "table" or type(raw.cards) ~= "table" or not isWholeAmount(raw.coin) then
		return nil, "BAD_REQUEST"
	end
	-- Before the loop, so a huge client list is never walked.
	if #raw.cards > Trade.MAX_CARDS then
		return nil, "TRADE_BAD_OFFER"
	end
	local cards: { string } = {}
	local count = 0
	for key, id in raw.cards do
		count += 1
		-- A list only: keys 1..n in order.
		if key ~= count or Cards.info(id) == nil then
			return nil, "BAD_REQUEST"
		end
		table.insert(cards, id)
	end
	local offer: Offer = { cards = cards, coin = raw.coin }
	if #cards > Trade.MAX_CARDS or not covers(ledger, coin, offer) then
		return nil, "TRADE_BAD_OFFER"
	end
	return withOffer(session, userId, offer, now), "OK"
end

-- Both confirmations cleared and the wait restarted, for a trade that failed at the swap.
function Trade.unconfirm(session: Session, now: number): Session
	return {
		a = session.a,
		b = session.b,
		offers = session.offers,
		confirmed = {},
		changedAt = now,
	}
end

-- The nearest other player within the invite range, or nil. A NaN position is never near.
-- Ties go to the lower id.
function Trade.nearest(asker: Body, others: { Body }): number?
	local bestId: number? = nil
	local best = math.huge
	for _, other in others do
		if other.userId == asker.userId then
			continue
		end
		local a, b = asker.position, other.position
		local gap = math.sqrt((a.x - b.x) ^ 2 + (a.y - b.y) ^ 2 + (a.z - b.z) ^ 2)
		if not (gap <= Trade.INVITE_RANGE) then
			continue
		end
		if gap < best or (gap == best and bestId ~= nil and other.userId < bestId) then
			best = gap
			bestId = other.userId
		end
	end
	return bestId
end

-- Refused for 2 seconds after any change, so nobody confirms an offer they have not seen.
-- A clock that is not a number is refused too.
function Trade.confirm(session: Session, userId: number, now: number): (Session?, string)
	if not Trade.has(session, userId) then
		return nil, "TRADE_NOT_OPEN"
	end
	if not (now - session.changedAt >= Trade.CONFIRM_DELAY) then
		return nil, "TRADE_TOO_SOON"
	end
	local confirmed = table.clone(session.confirmed)
	confirmed[tostring(userId)] = true
	return {
		a = session.a,
		b = session.b,
		offers = session.offers,
		confirmed = confirmed,
		changedAt = session.changedAt,
	},
		"OK"
end

function Trade.ready(session: Session): boolean
	return session.confirmed[tostring(session.a)] == true
		and session.confirmed[tostring(session.b)] == true
end

-- Called when a trader's Ledger or Coin changed for any other reason: an offer its owner
-- can no longer cover is emptied (and both must confirm again). Otherwise nothing changes.
function Trade.prune(
	session: Session,
	userId: number,
	ledger: Ledger,
	coin: number,
	now: number
): Session
	if not Trade.has(session, userId) or covers(ledger, coin, session.offers[tostring(userId)]) then
		return session
	end
	return withOffer(session, userId, { cards = {}, coin = 0 }, now)
end

-- The swap. Both must have confirmed, both must still hold what they offered, and both must
-- have room for what they get. Success: both new Ledgers and Coin totals, "TRADE_DONE".
-- Failure: nil, the same Coin, nil, the same Coin, a code. Nothing is half-done.
function Trade.settle(
	session: Session,
	ledgerA: Ledger,
	coinA: number,
	ledgerB: Ledger,
	coinB: number
): (Ledger?, number, Ledger?, number, string)
	if not Trade.ready(session) then
		return nil, coinA, nil, coinB, "TRADE_NOT_OPEN"
	end
	local offerA, offerB = session.offers[tostring(session.a)], session.offers[tostring(session.b)]
	if not covers(ledgerA, coinA, offerA) or not covers(ledgerB, coinB, offerB) then
		return nil, coinA, nil, coinB, "TRADE_BAD_OFFER"
	end
	local leftA, leftB = Ledger.remove(ledgerA, offerA.cards), Ledger.remove(ledgerB, offerB.cards)
	if leftA == nil or leftB == nil then
		return nil, coinA, nil, coinB, "TRADE_BAD_OFFER"
	end
	if
		#leftA.free + #offerB.cards > Ledger.FREE_SLOTS
		or #leftB.free + #offerA.cards > Ledger.FREE_SLOTS
	then
		return nil, coinA, nil, coinB, "TRADE_NO_ROOM"
	end
	for _, id in offerB.cards do
		table.insert(leftA.free, id)
	end
	for _, id in offerA.cards do
		table.insert(leftB.free, id)
	end
	return leftA,
		coinA - offerA.coin + offerB.coin,
		leftB,
		coinB - offerB.coin + offerA.coin,
		"TRADE_DONE"
end

local function offerView(offer: Offer): OfferView
	local cards: { CardView } = {}
	for _, id in offer.cards do
		table.insert(cards, { cardId = id, name = Cards.name(id) })
	end
	return { cards = cards, coin = offer.coin }
end

-- What the trade window shows to `viewerId`: both offers, who has confirmed, and the
-- viewer's own free-slot cards with those on offer marked.
function Trade.view(
	session: Session,
	viewerId: number,
	otherName: string,
	ledger: Ledger,
	coin: number,
	now: number
): View
	local mine = session.offers[tostring(viewerId)]
	local otherId = Trade.other(session, viewerId)
	local mineConfirmed = session.confirmed[tostring(viewerId)] == true
	local theirsConfirmed = session.confirmed[tostring(otherId)] == true

	local onOffer: { [string]: number } = {}
	for _, id in mine.cards do
		onOffer[id] = (onOffer[id] or 0) + 1
	end
	local free: { FreeRow } = {}
	for index, id in ledger.free do
		local left = onOffer[id] or 0
		if left > 0 then
			onOffer[id] = left - 1
		end
		table.insert(
			free,
			{ index = index, cardId = id, name = Cards.name(id), offered = left > 0 }
		)
	end

	local status = "Check both offers, then confirm."
	if mineConfirmed then
		status = `You confirmed. Waiting for {otherName}.`
	elseif theirsConfirmed then
		status = `{otherName} has confirmed.`
	end
	local wait = Trade.CONFIRM_DELAY - (now - session.changedAt)
	return {
		otherName = otherName,
		mine = offerView(mine),
		theirs = offerView(session.offers[tostring(otherId)]),
		mineConfirmed = mineConfirmed,
		theirsConfirmed = theirsConfirmed,
		confirmIn = if wait > 0 then wait else 0,
		coinHeld = if coin >= 0 and coin < math.huge then math.floor(coin) else 0,
		status = status,
		free = free,
	}
end

return Trade
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="62">
          <Properties>
            <string name="Name">TrialRun</string>
            <string name="Source"><![CDATA[--!strict
-- A Warden's trial as a state machine: starting, progress, the clock, cooldowns, and the
-- Unpaid Debt quest. Run timers use os.clock(); cooldowns use os.time() and are saved.
local Trials = require("../Catalog/Trials")
local Types = require("../Types")
local World = require("../Catalog/World")

type TrialRecord = Types.TrialRecord

export type Run = { trialId: string, endsAt: number, progress: number, goal: number }

local TrialRun = {}

TrialRun.PASS_COOLDOWN = 300
TrialRun.FAIL_COOLDOWN = 30
TrialRun.MARKER_RADIUS = 6
TrialRun.DELIVERY_RADIUS = 10
TrialRun.WARDEN_REACH = 15

local function isFinite(n: number): boolean
	return n > -math.huge and n < math.huge
end

function TrialRun.newRecord(): TrialRecord
	return { cooldowns = {}, questStep = 0 }
end

-- Turns whatever was saved into a valid record. Never errors. Cooldowns keep only known
-- trials with a time still ahead, and never more than a pass cooldown ahead.
function TrialRun.sanitize(raw: any, realNow: number): TrialRecord
	local record = TrialRun.newRecord()
	if type(raw) ~= "table" then
		return record
	end
	local cooldowns = raw.cooldowns
	if type(cooldowns) == "table" and isFinite(realNow) then
		for _, trial in Trials.list do
			local readyAt = cooldowns[trial.id]
			if type(readyAt) == "number" and isFinite(readyAt) and readyAt > realNow then
				record.cooldowns[trial.id] = math.min(readyAt, realNow + TrialRun.PASS_COOLDOWN)
			end
		end
	end
	local step = raw.questStep
	if
		type(step) == "number"
		and step >= 0
		and step < #Trials.quest.steps
		and step == math.floor(step)
	then
		record.questStep = step
	end
	return record
end

-- How much there is to do: markers, creatures, or 1 for a delivery or a duel. 0 if unknown.
function TrialRun.goal(trialId: string): number
	local trial = Trials.byId[trialId]
	if trial == nil then
		return 0
	end
	if trial.kind == "course" then
		local markers = World.courses[trialId]
		return if markers ~= nil then #markers else 0
	elseif trial.kind == "hunt" then
		return trial.count or 1
	end
	return 1
end

-- Seconds until the trial may be taken again: 0 to 300. A time that is not a number reads
-- as the full 300, so a broken clock never opens a trial early.
function TrialRun.cooldownLeft(record: TrialRecord, trialId: string, realNow: number): number
	local readyAt = record.cooldowns[trialId]
	if readyAt == nil then
		return 0
	end
	local left = readyAt - realNow
	if left ~= left then
		return TrialRun.PASS_COOLDOWN
	end
	return math.clamp(left, 0, TrialRun.PASS_COOLDOWN)
end

-- Checks in order: BAD_REQUEST (not a trial id), TRIAL_BUSY, TRIAL_COOLDOWN.
function TrialRun.start(
	record: TrialRecord,
	current: Run?,
	rawId: any,
	clock: number,
	realNow: number
): (Run?, string)
	local trial = if type(rawId) == "string" then Trials.byId[rawId] else nil
	if trial == nil then
		return nil, "BAD_REQUEST"
	end
	if current ~= nil then
		return nil, "TRIAL_BUSY"
	end
	if TrialRun.cooldownLeft(record, trial.id, realNow) > 0 then
		return nil, "TRIAL_COOLDOWN"
	end
	return {
		trialId = trial.id,
		endsAt = clock + trial.seconds,
		progress = 0,
		goal = TrialRun.goal(trial.id),
	},
		"TRIAL_STARTED"
end

local function withProgress(run: Run, progress: number): Run
	local out = table.clone(run)
	out.progress = math.min(progress, run.goal)
	return out
end

-- A course counts marker `index` only when it is the next one.
function TrialRun.reachMarker(run: Run, index: number): Run
	local trial = Trials.byId[run.trialId]
	if trial == nil or trial.kind ~= "course" or index ~= run.progress + 1 then
		return run
	end
	return withProgress(run, run.progress + 1)
end

-- A hunt counts a defeat of its own quarry only.
function TrialRun.countDefeat(run: Run, creature: string): Run
	local trial = Trials.byId[run.trialId]
	if trial == nil or trial.kind ~= "hunt" or trial.creature ~= creature then
		return run
	end
	return withProgress(run, run.progress + 1)
end

-- A delivery made or a duel won.
function TrialRun.complete(run: Run): Run
	local trial = Trials.byId[run.trialId]
	if trial == nil or (trial.kind ~= "delivery" and trial.kind ~= "duel") then
		return run
	end
	return withProgress(run, run.goal)
end

function TrialRun.isPassed(run: Run): boolean
	return run.goal > 0 and run.progress >= run.goal
end

-- Written as a negation so a NaN clock counts as out of time.
function TrialRun.isExpired(run: Run, clock: number): boolean
	return not (clock < run.endsAt)
end

-- The record after a trial ends: its cooldown starts.
function TrialRun.finish(
	record: TrialRecord,
	trialId: string,
	passed: boolean,
	realNow: number
): TrialRecord
	local cooldowns = table.clone(record.cooldowns)
	cooldowns[trialId] = realNow
		+ (if passed then TrialRun.PASS_COOLDOWN else TrialRun.FAIL_COOLDOWN)
	return { cooldowns = cooldowns, questStep = record.questStep }
end

-- `event` is a passed trial's id, or "colossus". It counts only when it is the quest's next
-- step. Returns the new step and whether the quest was completed; a completed quest starts
-- again at step 0. A step that is not a whole number 0..3 reads as 0.
function TrialRun.advanceQuest(step: number, event: string): (number, boolean)
	local steps = Trials.quest.steps
	if not (step >= 0 and step < #steps and step == math.floor(step)) then
		return 0, false
	end
	if steps[step + 1] ~= event then
		return step, false
	end
	if step + 1 >= #steps then
		return 0, true
	end
	return step + 1, false
end

return TrialRun
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="63">
          <Properties>
            <string name="Name">TrialView</string>
            <string name="Source"><![CDATA[--!strict
-- Text for the Warden's offer window and the trial HUD.
local Relics = require("../Catalog/Relics")
local Scarcity = require("./Scarcity")
local TrialRun = require("./TrialRun")
local Trials = require("../Catalog/Trials")
local Types = require("../Types")

export type OfferView = {
	trialId: string,
	title: string,
	warden: string,
	goal: string,
	timeText: string,
	rewardText: string,
	relicText: string,
	sealed: boolean,
	canStart: boolean,
	note: string,
}
export type HudState = { trialId: string, progress: number, goal: number, secondsLeft: number }

local TrialView = {}

local QUEST_NEXT: { [string]: string } = {
	colossus = "defeat the Brine Colossus",
}

-- "M:SS", seconds rounded up. Below 0 or not a number reads 0:00.
local function clock(seconds: number): string
	local whole = if seconds > 0 and seconds < math.huge then math.ceil(seconds) else 0
	return string.format("%d:%02d", whole // 60, whole % 60)
end

-- `running`: the id of the trial the player is in, if any. `held`: copies of the trial's
-- Relic on the server. `freeSlots`: free slots the player can fill (0 with a locked Ledger).
function TrialView.offer(
	trialId: string,
	record: Types.TrialRecord,
	running: string?,
	realNow: number,
	held: number,
	freeSlots: number
): OfferView
	local trial = Trials.byId[trialId]
	if trial == nil then
		return {
			trialId = trialId,
			title = "",
			warden = "",
			goal = "",
			timeText = "",
			rewardText = "",
			relicText = "",
			sealed = false,
			canStart = false,
			note = "",
		}
	end
	local relic = Relics.byId[trial.relicId]
	local sealed = Scarcity.isSealed(trial.relicId, held)
	local relicText = if relic ~= nil then `Relic: {relic.name} ({relic.tier})` else "Relic: none"
	if sealed then
		relicText ..= " — sealed on this server"
	end

	local canStart, note = true, ""
	local left = TrialRun.cooldownLeft(record, trialId, realNow)
	if running ~= nil then
		canStart, note = false, "Finish your current trial first."
	elseif left > 0 then
		canStart, note = false, `Try again in {clock(left)}.`
	elseif not sealed and not (freeSlots > 0) then
		note = "Your free slots are full, so the Relic would be lost."
	end

	return {
		trialId = trialId,
		title = trial.name,
		warden = trial.warden,
		goal = trial.goal,
		timeText = `Time: {trial.seconds} seconds`,
		rewardText = `Reward: {trial.coin} Coin, {trial.xp} XP`,
		relicText = relicText,
		sealed = sealed,
		canStart = canStart,
		note = note,
	}
end

-- The HUD lines: the running trial and its clock, if any, then always the quest line.
function TrialView.hud(state: HudState?, questStep: number): { string }
	local lines: { string } = {}
	local trial = if state ~= nil then Trials.byId[state.trialId] else nil
	if state ~= nil and trial ~= nil then
		local progress: string
		if trial.kind == "course" then
			progress = `marker {state.progress} / {state.goal}`
		elseif trial.kind == "hunt" then
			progress = `defeated {state.progress} / {state.goal}`
		elseif trial.kind == "delivery" then
			progress = "carry the parcel to the Harbour Warden"
		else
			progress = "defeat the Drowned Tallyman"
		end
		table.insert(lines, `{trial.name}: {progress}`)
		table.insert(lines, `Time left {clock(state.secondsLeft)}`)
	end

	local steps = Trials.quest.steps
	local step = questStep
	if not (step >= 0 and step < #steps and step == math.floor(step)) then
		step = 0
	end
	local nextId = steps[step + 1]
	local nextTrial = Trials.byId[nextId]
	local nextText = if nextTrial ~= nil then nextTrial.name else QUEST_NEXT[nextId] or nextId
	table.insert(lines, `{Trials.quest.name}: {step} / {#steps}, next: {nextText}`)
	return lines
end

return TrialView
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="64">
          <Properties>
            <string name="Name">Vault</string>
            <string name="Source"><![CDATA[--!strict
local Ledger = require("./Ledger")
local Relics = require("../Catalog/Relics")
local Types = require("../Types")

type CardId = Types.CardId
type Ledger = Types.Ledger
type Vault = Types.Vault

local MAX_CARD_ID_LENGTH = 16

local Vault = {}

Vault.MAX = 3

function Vault.size(vault: Vault): number
	local total = 0
	for _, value in vault do
		if value then
			total += 1
		end
	end
	return total
end

-- Drops vaulted ids the ledger no longer holds.
function Vault.prune(vault: Vault, ledger: Ledger): Vault
	local result: Vault = {}
	for cardId, value in vault do
		if value and Ledger.count(ledger, cardId) > 0 then
			result[cardId] = true
		end
	end
	return result
end

-- Turns arbitrary saved data into a valid Vault. Never errors.
-- Keeps known, held, non-Crown ids whose value is true; at most MAX, lowest slot numbers first.
function Vault.sanitize(raw: any, ledger: Ledger): Vault
	local result: Vault = {}
	if type(raw) ~= "table" then
		return result
	end
	for _, relic in Relics.list do
		if Vault.size(result) >= Vault.MAX then
			break
		end
		if
			relic.tier ~= "Crown"
			and raw[relic.id] == true
			and Ledger.count(ledger, relic.id) > 0
		then
			result[relic.id] = true
		end
	end
	return result
end

-- Validates a raw client request and applies it to the vault.
-- Request shape: { kind = "add" | "remove", cardId = string }
-- Success: new vault, "VAULTED" | "UNVAULTED", card id.
-- Failure: nil, error code, nil. Never errors on hostile input.
function Vault.apply(
	vault: Vault?,
	ledger: Ledger?,
	raw: any,
	inSafeZone: boolean,
	locked: boolean
): (Vault?, string, CardId?)
	if vault == nil or ledger == nil then
		return nil, "DATA_NOT_LOADED", nil
	end
	if locked then
		return nil, "LEDGER_LOCKED", nil
	end
	if type(raw) ~= "table" then
		return nil, "BAD_REQUEST", nil
	end
	local kind = raw.kind
	local cardId = raw.cardId
	if kind ~= "add" and kind ~= "remove" then
		return nil, "BAD_REQUEST", nil
	end
	if type(cardId) ~= "string" or #cardId > MAX_CARD_ID_LENGTH then
		return nil, "BAD_REQUEST", nil
	end
	if not inSafeZone then
		return nil, "NOT_IN_SAFE_ZONE", nil
	end
	if kind == "add" then
		local relic = Relics.byId[cardId]
		if relic == nil then
			return nil, "UNKNOWN_CARD", nil
		end
		if relic.tier == "Crown" then
			return nil, "CROWN_NO_VAULT", nil
		end
		if Ledger.count(ledger, cardId) == 0 then
			return nil, "NOT_HELD", nil
		end
		if vault[cardId] then
			return nil, "ALREADY_VAULTED", nil
		end
		if Vault.size(vault) >= Vault.MAX then
			return nil, "VAULT_FULL", nil
		end
		local result = table.clone(vault)
		result[cardId] = true
		return result, "VAULTED", cardId
	end
	if not vault[cardId] then
		return nil, "NOT_VAULTED", nil
	end
	local result = table.clone(vault)
	result[cardId] = nil
	return result, "UNVAULTED", cardId
end

return Vault
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="65">
        <Properties>
          <string name="Name">Types</string>
          <string name="Source"><![CDATA[--!strict
export type CardId = string
export type Tier = "Copper" | "Silver" | "Gold" | "Platinum" | "Crown"
export type Relic = { id: CardId, slot: number, name: string, tier: Tier, description: string }
export type Ledger = { claimed: { [CardId]: boolean }, free: { CardId } }
export type Vec3 = { x: number, y: number, z: number }
export type Cache = { id: string, relicId: CardId, position: Vec3, hold: number? }
export type Vault = { [CardId]: boolean }
export type PathId = "Fang" | "Gale" | "Ember" | "Mire" | "Mend" | "Bulwark"
export type PathProgress = {
	calling: string, -- a PathId, or "" before the first choice
	xp: { [string]: number }, -- one entry per PathId
	loadout: { string }, -- exactly 4 entries; "" = empty slot
	callingChanges: number,
	callingChangedAt: number, -- os.time() of the last change, 0 if never
}
export type Ability = {
	id: string,
	name: string,
	path: PathId,
	unlockLevel: number,
	cooldown: number,
	description: string,
	kind: "melee" | "shot" | "dash" | "zone" | "self" | "burst",
	range: number?,
	damage: number?,
	hits: number?,
	interval: number?,
	shots: number?,
	spread: number?, -- shot fan: count, total angle in degrees
	distance: number?, -- dash length
	executeBelow: number?,
	executeDamage: number?,
	burn: { dps: number, duration: number }?,
	root: number?,
	slow: { factor: number, duration: number }?, -- factor = speed multiplier (0.7 = 30% slower)
	pull: number?,
	knockback: number?,
	taunt: number?,
	zone: { radius: number, duration: number, dps: number, slow: number?, ahead: number }?,
	radius: number?, -- burst radius
	heal: number?,
	healOnHit: boolean?,
	cleanse: boolean?,
	shield: { amount: number, duration: number }?,
	immune: number?,
	empower: { bonus: number, duration: number }?,
	reduction: { factor: number, duration: number }?, -- factor = damage multiplier (0.6 = 40% less)
	reflect: { factor: number, duration: number }?,
	allyRadius: number?,
}
export type Edict = {
	id: CardId,
	key: string,
	name: string,
	description: string,
	weight: number, -- percent chance per pack card
	needs: string, -- "relic", "player" or ""
}
export type Drop = { relicId: CardId, chance: number }
export type CreatureKind = {
	id: string,
	name: string,
	health: number,
	speed: number,
	sight: number,
	attack: {
		kind: "melee" | "shot" | "slam",
		name: string,
		damage: number,
		range: number,
		interval: number,
	},
	keepAway: number?,
	lunge: { distance: number, damage: number, interval: number }?,
	xp: number,
	coin: number,
	respawn: number,
	drops: { Drop },
	height: number, -- look only
	color: { r: number, g: number, b: number }, -- look only
}
export type TrialKind = "course" | "delivery" | "hunt" | "duel"
export type Trial = {
	id: string,
	name: string,
	warden: string,
	kind: TrialKind,
	goal: string,
	seconds: number,
	relicId: CardId,
	coin: number,
	xp: number,
	creature: string?,
	count: number?,
}
export type Round = {
	id: string, -- "wardens" | "beasts"
	name: string, -- shown in messages: "The Warden's Round"
	short: string, -- shown in the HUD line: "Warden's Round"
	relicId: CardId,
	coin: number,
	xp: number,
	steps: { string }, -- trial ids or creature kind ids
}
export type TrialRecord = { cooldowns: { [string]: number }, questStep: number } -- trial id -> os.time() it may be taken again
export type CrownRecord = {
	crowns: number,
	stars: number,
	boardCrowns: number,
	badgeAwarded: boolean,
}
export type RoundsRecord = { [string]: { string } } -- round id -> step ids done this round, in order
export type Den = { kind: string, count: number, position: Vec3 }
export type Ledge = { x: number, z: number, size: number, top: number }
export type PlayerData = {
	schemaVersion: number,
	ledger: Ledger,
	coin: number,
	vault: Vault,
	shieldEnded: boolean,
	paths: PathProgress,
	trials: TrialRecord,
	crown: CrownRecord,
	rounds: RoundsRecord,
}
export type RegionId =
	"Tallyport"
	| "CountingFields"
	| "Thornwood"
	| "SquallSteps"
	| "CinderFlats"
	| "DrownedFen"
	| "ReckoningRock"
	| "HushGardens"
	| "BastionReach"
export type Region = {
	id: RegionId,
	name: string,
	hint: string,
	bearing: number?, -- wild regions only
	ground: string, -- a look name
	fog: { r: number, g: number, b: number, start: number, finish: number },
}
-- Every field is always present; unused ones are 0 or "".
export type Shape = {
	kind: "circle" | "rect" | "region",
	x: number,
	z: number, -- centre; 0 for "region"
	radius: number, -- circle radius; for "region" the least distance from the island centre
	bearing: number,
	halfAlong: number,
	halfAcross: number, -- rect only
	region: string, -- "region" only
}
export type Cycle = { period: number, warn: number, active: number, offset: number }
export type Hazard = {
	id: string,
	region: RegionId,
	name: string,
	look: string,
	shape: Shape,
	holes: { Shape }?,
	cycle: Cycle?,
	dps: number?,
	damage: number?,
	heal: number?,
	slow: number?, -- speed multiplier, 0.5 = half speed
	push: { x: number, z: number }?, -- world velocity, studs per second
	markerY: number?, -- height of the visual marker; ground when nil
}
-- x, y, z is the centre. sx is the extent across the yaw bearing, sy the height, sz the
-- extent along it. A cylinder stands upright: sx = sz = diameter.
export type Feature = {
	look: string,
	shape: "block" | "cylinder",
	x: number,
	y: number,
	z: number,
	sx: number,
	sy: number,
	sz: number,
	yaw: number,
	solid: boolean,
	text: string?,
}
export type SiteCache = { relicId: CardId, x: number, y: number, z: number, hold: number? }
export type Site = {
	region: RegionId,
	hazards: { Hazard },
	features: { Feature },
	prize: SiteCache?,
	keepOut: { Shape },
}

return {}
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="66">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="67">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="68">
        <Properties>
          <string name="Name">AbilityService</string>
          <string name="Source"><![CDATA[--!strict
-- Turns a client's "cast slot N" into the effects of the 18 abilities. The client names only
-- a slot: the ability, targets, damage, movement and timing are all decided here, from the pure
-- Casting plan and the server's own view of the world. Every hit (player or post) goes through
-- CombatService.damage, and a hit's statuses, pull or knockback follow only when it landed.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Abilities = require(ReplicatedStorage.Shared.Catalog.Abilities)
local Casting = require(ReplicatedStorage.Shared.Rules.Casting)
local Combat = require(ReplicatedStorage.Shared.Rules.Combat)
local CreatureBrain = require(ReplicatedStorage.Shared.Rules.CreatureBrain)
local Effects = require(ReplicatedStorage.Shared.Rules.Effects)
local Net = require(ReplicatedStorage.Shared.Net)
local Party = require(ReplicatedStorage.Shared.Rules.Party)
local Paths = require(ReplicatedStorage.Shared.Catalog.Paths)
local Protection = require(ReplicatedStorage.Shared.Rules.Protection)
local RateLimiter = require(ReplicatedStorage.Shared.Rules.RateLimiter)
local Targeting = require(ReplicatedStorage.Shared.Rules.Targeting)
local Trials = require(ReplicatedStorage.Shared.Catalog.Trials)
local Types = require(ReplicatedStorage.Shared.Types)
local World = require(ReplicatedStorage.Shared.Catalog.World)
local CombatService = require(script.Parent.CombatService)
local CreatureService = require(script.Parent.CreatureService)
local Fighters = require(script.Parent.Fighters)
local Fx = require(script.Parent.Fx)
local LedgerService = require(script.Parent.LedgerService)
local PathService = require(script.Parent.PathService)
local ProtectionService = require(script.Parent.ProtectionService)
local Sight = require(script.Parent.Sight)
local StatusService = require(script.Parent.StatusService)
local TrialService = require(script.Parent.TrialService)

type Ability = Types.Ability
type Fighter = Combat.Fighter
type Plan = Casting.Plan
type Vec3 = Types.Vec3

local BUCKET_CAPACITY = 10
local BUCKET_REFILL_PER_SECOND = 5
local ZONE_WALL_MARGIN = 1 -- a zone's centre stops this far short of a wall
local RING_LIFT = 0.2 -- above the caster's feet
local DEFAULT_COLOR = Color3.fromRGB(200, 200, 200)

local AbilityService = {}

-- Cooldowns per player, on os.clock(). Kept across respawns, dropped when the player leaves.
local castStates: { [Player]: Casting.CastState } = {}
local buckets: { [Player]: RateLimiter.Bucket } = {}
local cooldownRemote: RemoteEvent

-- True if the player has a token left in their rate-limit bucket (takes one).
local function allowed(player: Player): boolean
	local now = os.clock()
	local bucket = buckets[player]
	if bucket == nil then
		bucket = RateLimiter.new(BUCKET_CAPACITY, now)
		buckets[player] = bucket
	end
	return RateLimiter.allow(bucket, now, BUCKET_CAPACITY, BUCKET_REFILL_PER_SECOND)
end

-- The Humanoid and HumanoidRootPart of a living character, or nil.
local function living(player: Player): (Humanoid?, BasePart?)
	return Fighters.body(player.UserId)
end

local function fighterOf(player: Player, humanoid: Humanoid, root: BasePart): Fighter
	local p = root.Position
	local look = root.CFrame.LookVector
	return {
		id = player.UserId,
		position = { x = p.X, y = p.Y, z = p.Z },
		look = { x = look.X, y = look.Y, z = look.Z },
		health = humanoid.Health,
	}
end

local function pathColor(path: string): Color3
	local info = Paths.info[path :: Types.PathId]
	if info == nil then
		return DEFAULT_COLOR
	end
	return Color3.fromRGB(info.color.r, info.color.g, info.color.b)
end

-- ---------------------------------------------------------------------------------------
-- World rays: movement (dash, pull, knockback) and line of sight
-- ---------------------------------------------------------------------------------------

-- ---------------------------------------------------------------------------------------
-- Effects on players
-- ---------------------------------------------------------------------------------------

local function heal(player: Player, amount: number)
	local humanoid = living(player)
	if humanoid == nil or not (amount > 0) then
		return
	end
	humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + amount)
end

-- Who a support effect (heal, cleanse, shield) reaches: the caster, and when the ability has an
-- ally radius, the caster's party members within it. Members in a duel are never reached, and a
-- protected caster does not reach members who are fighting (Party.reach). Reaching a member
-- who is fighting ends the caster's respawn shield; reaching one outside Tallyport counts the
-- caster as an assist on every creature that member hit lately. Writes nothing else.
local function supportTargets(player: Player, ability: Ability, now: number): { Player }
	local _, casterRoot = living(player)
	if casterRoot == nil then
		return {}
	end
	local targets: { Player } = { player }
	local radius = ability.allyRadius
	if radius == nil then
		return targets
	end
	local status = ProtectionService.status(player, now)
	if status == nil then
		return targets
	end
	local p = casterRoot.Position
	local helper: Party.Helper = {
		position = { x = p.X, y = p.Y, z = p.Z },
		protected = status.newShield
			or (status.inSafeZone and not Protection.isMarked(status, now)),
	}
	local helped: { Party.Helped } = {}
	local players: { [number]: Player } = {}
	for _, id in Fighters.allies(player.UserId) do
		local entry = Fighters.get(id)
		local ally = if entry ~= nil then entry.player else nil
		if ally == nil then
			continue
		end
		local allyStatus = ProtectionService.status(ally, now)
		local _, allyRoot = living(ally)
		if allyStatus == nil or allyRoot == nil then
			continue
		end
		local q = allyRoot.Position
		local run = TrialService.run(ally)
		local trial = if run ~= nil then Trials.byId[run.trialId] else nil
		table.insert(helped, {
			id = id,
			position = { x = q.X, y = q.Y, z = q.Z },
			inFight = Party.inFight(
				Protection.isMarked(allyStatus, now),
				CombatService.lastFightAt(ally),
				now
			),
			inDuel = trial ~= nil and trial.kind == "duel",
		})
		players[id] = ally
	end
	local reached, joined = Party.reach(helper, helped, radius)
	if joined then
		ProtectionService.endRespawnShield(player)
	end
	if #reached > 0 and not status.inSafeZone then
		CreatureService.assist(player.UserId, reached, ability.path)
	end
	for _, id in reached do
		local member = players[id]
		if member ~= nil then
			table.insert(targets, member)
		end
	end
	return targets
end

local function vector(v: Vec3): Vector3
	return Vector3.new(v.x, v.y, v.z)
end

-- True when nothing solid stands between the caster and the fighter `targetId`: one ray from
-- the root position the plan was made from (for a dash, where it started) to the target's
-- root or post position.
local function inSight(caster: Fighter, others: { Fighter }, targetId: number): boolean
	for _, other in others do
		if other.id == targetId then
			local target = Fighters.model(targetId)
			return Sight.obstruction(vector(caster.position), vector(other.position), target) == nil
		end
	end
	return false
end

-- Applies a plan's hits. A hit the caster has no line of sight to is skipped entirely. Every
-- hit goes through CombatService.damage (a post trains the ability's Path and ignores every
-- effect); its statuses and its pull or knockback follow only when that returned true.
-- Heal-on-hit heals the caster when any hit landed, and reaches allies (and counts as an
-- assist) only when a hit landed on a player or a creature, not on a training post alone.
local function applyHits(
	player: Player,
	ability: Ability,
	plan: Plan,
	caster: Fighter,
	others: { Fighter }
)
	local connected = false
	local struckFighter = false
	for _, hit in plan.hits do
		local id = hit.targetId
		if not inSight(caster, others, id) then
			continue
		end
		if not CombatService.damage(player.UserId, id, hit.damage, { path = ability.path }) then
			continue
		end
		connected = true
		local struck = Fighters.get(id)
		if struck ~= nil and struck.kind ~= "post" then
			struckFighter = true
		end
		StatusService.applyHit(player.UserId, id, ability)
		-- No ability both pulls and knocks back; each point is for the plan's one target.
		local destination = plan.pullTo or plan.knockbackTo
		if destination ~= nil then
			local humanoid, root = Fighters.body(id)
			if humanoid ~= nil and root ~= nil then
				-- No pull or knockback ever lands a creature inside Tallyport.
				local entry = Fighters.get(id)
				if entry ~= nil and entry.kind == "creature" then
					destination = CreatureBrain.outsideTown(destination)
				end
				Sight.move(humanoid, root, destination)
			end
		end
	end
	local amount = ability.heal
	if connected and ability.healOnHit == true and amount ~= nil then
		if struckFighter then
			for _, ally in supportTargets(player, ability, os.clock()) do
				heal(ally, amount)
			end
		else
			heal(player, amount)
		end
	end
end

-- The caster's own effects (immune, empower, reduction, reflect) land on the caster alone. The
-- support effects (heal unless it is a heal-on-hit, cleanse, shield) also reach the party
-- members in range.
local function applySelfEffects(player: Player, ability: Ability)
	local immune, empower = ability.immune, ability.empower
	local reduction, reflect = ability.reduction, ability.reflect
	if immune ~= nil or empower ~= nil or reduction ~= nil or reflect ~= nil then
		StatusService.update(player.UserId, function(status, now)
			local out = status
			if immune ~= nil then
				out = Effects.applyImmune(out, immune, now)
			end
			if empower ~= nil then
				out = Effects.applyEmpower(out, empower.bonus, empower.duration, now)
			end
			if reduction ~= nil then
				out = Effects.applyReduction(out, reduction.factor, reduction.duration, now)
			end
			if reflect ~= nil then
				out = Effects.applyReflect(out, reflect.factor, reflect.duration, now)
			end
			return out
		end)
	end

	local amount = if ability.healOnHit == true then nil else ability.heal
	local cleanse = ability.cleanse == true
	local shield = ability.shield
	if amount == nil and not cleanse and shield == nil then
		return
	end
	for _, ally in supportTargets(player, ability, os.clock()) do
		if amount ~= nil then
			heal(ally, amount)
		end
		if cleanse or shield ~= nil then
			StatusService.update(ally.UserId, function(status, now)
				local out = status
				if cleanse then
					out = Effects.cleanse(out)
				end
				if shield ~= nil then
					out = Effects.applyShield(out, shield.amount, shield.duration, now)
				end
				return out
			end)
		end
	end
end

-- ---------------------------------------------------------------------------------------
-- Visuals (server-made, short-lived, in workspace.Effects)
-- ---------------------------------------------------------------------------------------

-- One ray per shot, from the caster to the fighter that shot found, or to full range, cut
-- short where something solid blocks it (as the hit is). The fan and the target use the same
-- rules as the plan (Casting and Targeting.shot).
local function showShots(ability: Ability, caster: Fighter, others: { Fighter }, taunter: number?)
	local lx, lz = caster.look.x, caster.look.z
	local length = math.sqrt(lx * lx + lz * lz)
	if not (length > 0 and length < math.huge) then
		return
	end
	lx, lz = lx / length, lz / length
	local range = ability.range or 0
	local shots = ability.shots or 1
	local spread = ability.spread or 0
	local color = pathColor(ability.path)
	local from = Vector3.new(caster.position.x, caster.position.y, caster.position.z)
	for i = 1, shots do
		local angle = 0
		if shots > 1 then
			angle = -spread / 2 + spread * (i - 1) / (shots - 1)
		end
		-- Positive angles turn clockwise seen from above, as in Targeting.shot.
		local radians = math.rad(angle)
		local sin, cos = math.sin(radians), math.cos(radians)
		local to = from + Vector3.new(lx * cos - lz * sin, 0, lx * sin + lz * cos) * range
		local targetId = Targeting.shot(caster, others, range, angle, taunter)
		if targetId ~= nil then
			for _, other in others do
				if other.id == targetId then
					to = vector(other.position)
					break
				end
			end
		end
		local target = if targetId ~= nil then Fighters.model(targetId) else nil
		Fx.ray(from, Sight.obstruction(from, to, target) or to, color)
	end
end

-- ---------------------------------------------------------------------------------------
-- Casting
-- ---------------------------------------------------------------------------------------

-- The fighters a plan may pick from. A single-target melee or shot ability only sees what the
-- caster has a clear line to, so a target behind a corner never swallows the hit (and an
-- unseen taunter forces nothing). Area abilities keep everyone: applyHits skips unseen hits.
local function candidates(ability: Ability, caster: Fighter, others: { Fighter }): { Fighter }
	if ability.kind == "melee" or ability.kind == "shot" then
		return Sight.filter(vector(caster.position), others)
	end
	return others
end

-- Settles a planned zone on the server's own geometry. The centre never lands past a wall
-- (a level ray from the caster's root towards it stops ZONE_WALL_MARGIN short of the hit),
-- and its height is the ground under it, or World.groundY when there is none.
local function placeZone(zone: Casting.Zone, from: Vector3): Casting.Zone
	local params = Sight.rayParams()
	local x, z = zone.center.x, zone.center.z
	local dx, dz = x - from.X, z - from.Z
	local distance = math.sqrt(dx * dx + dz * dz)
	if distance > 0 and distance < math.huge then
		local blocked = workspace:Raycast(from, Vector3.new(dx, 0, dz), params)
		if blocked ~= nil then
			local travel = math.max(0, blocked.Distance - ZONE_WALL_MARGIN)
			x, z = from.X + dx / distance * travel, from.Z + dz / distance * travel
		end
	end
	-- Probe from above the caster's height so a centre on higher ground still finds its floor.
	local y = World.groundY
	local probeTop = from.Y + Combat.STRIKE_MAX_HEIGHT
	local ground = workspace:Raycast(
		Vector3.new(x, probeTop, z),
		Vector3.new(0, -(Sight.GROUND_PROBE + Combat.STRIKE_MAX_HEIGHT), 0),
		params
	)
	if ground ~= nil then
		y = ground.Position.Y
	end
	local placed = table.clone(zone)
	placed.center = { x = x, y = y, z = z }
	return placed
end

-- A later wave (Rending Flurry): re-planned from where the caster is now. Skipped if the caster
-- left, died or respawned since the cast.
local function runWave(player: Player, character: Model?, ability: Ability)
	if player.Parent ~= Players or player.Character ~= character then
		return
	end
	local humanoid, root = living(player)
	if humanoid == nil or root == nil then
		return
	end
	local now = os.clock()
	local others = Fighters.list(player.UserId)
	local taunter = Effects.tauntedBy(StatusService.get(player.UserId), now)
	local caster = fighterOf(player, humanoid, root)
	local plan = Casting.plan(ability, caster, candidates(ability, caster, others), taunter)
	applyHits(player, ability, plan, caster, others)
end

local function handleCast(player: Player, rawSlot: any)
	if player.Parent ~= Players then
		return
	end
	local humanoid, root = living(player)
	if humanoid == nil or root == nil or not allowed(player) then
		return
	end
	local progress = PathService.get(player)
	if progress == nil then
		LedgerService.notify(player, "DATA_NOT_LOADED")
		return
	end
	if progress.calling == "" then
		LedgerService.notify(player, "NO_CALLING")
		return
	end

	-- No yielding call from here to the commit: the cooldown check cannot go stale.
	local now = os.clock()
	local status = StatusService.get(player.UserId)
	local state = castStates[player] or Casting.new()
	local id, code = Casting.canCast(state, progress, rawSlot, now, Effects.isRooted(status, now))
	if id == nil then
		if code ~= "ON_COOLDOWN" then
			LedgerService.notify(player, code)
		end
		return
	end
	local ability = Abilities.byId[id]
	if ability == nil then
		return
	end
	castStates[player] = Casting.commit(state, id, now)
	-- canCast accepted the slot, so it is a whole number from 1 to 4.
	cooldownRemote:FireClient(player, rawSlot :: number, ability.cooldown)

	local character = player.Character
	local others = Fighters.list(player.UserId)
	local taunter = Effects.tauntedBy(status, now)
	local caster = fighterOf(player, humanoid, root)
	local targets = candidates(ability, caster, others)
	local plan = Casting.plan(ability, caster, targets, taunter)

	local moveTo = plan.moveTo
	if moveTo ~= nil then
		local clear = Sight.move(humanoid, root, moveTo)
		if ability.kind == "dash" then
			-- The plan scanned the dash's full length; a wall can stop it short. Only an enemy
			-- inside the stretch actually travelled, plus the gap to what stopped it (the move
			-- halts WALL_MARGIN short of it, and a post's centre is a further stud in), is
			-- passed, scanned from the start point. Line of sight still rules out anything
			-- behind a wall.
			local hits: { Casting.Hit } = {}
			local reach = math.min(ability.distance or 0, clear + Sight.WALL_MARGIN + 1.5)
			local targetId = Targeting.dashHit(caster, others, reach)
			if targetId ~= nil then
				table.insert(hits, { targetId = targetId, damage = ability.damage or 0 })
			end
			plan.hits = hits
		end
	end
	applyHits(player, ability, plan, caster, others)
	for k = 1, plan.waves - 1 do
		task.delay(plan.interval * k, runWave, player, character, ability)
	end
	local zone = plan.zone
	if zone ~= nil then
		StatusService.addZone(player.UserId, placeZone(zone, root.Position), ability.path)
	end
	applySelfEffects(player, ability)

	if ability.kind == "shot" then
		showShots(ability, caster, targets, taunter)
	elseif ability.kind == "burst" then
		local p = caster.position
		local center = Vector3.new(p.x, p.y - Sight.standHeight(humanoid, root) + RING_LIFT, p.z)
		Fx.ring(center, ability.radius or 0, pathColor(ability.path))
	end
end

function AbilityService.start()
	cooldownRemote = LedgerService.makeRemote(Net.AbilityCooldown)
	LedgerService.makeRemote(Net.CastAbility).OnServerEvent:Connect(handleCast)
	Fx.folder()

	Players.PlayerRemoving:Connect(function(player)
		castStates[player] = nil
		buckets[player] = nil
	end)
end

return AbilityService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="69">
        <Properties>
          <string name="Name">ClaimService</string>
          <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local BlindClaim = require(ReplicatedStorage.Shared.Rules.BlindClaim)
local Net = require(ReplicatedStorage.Shared.Net)
local Protection = require(ReplicatedStorage.Shared.Rules.Protection)
local RateLimiter = require(ReplicatedStorage.Shared.Rules.RateLimiter)
local Relics = require(ReplicatedStorage.Shared.Catalog.Relics)
local CombatService = require(script.Parent.CombatService)
local DataService = require(script.Parent.DataService)
local Fighters = require(script.Parent.Fighters)
local LedgerService = require(script.Parent.LedgerService)

local BUCKET_CAPACITY = 10
local BUCKET_REFILL_PER_SECOND = 5

local ClaimService = {}

local startedCallbacks: { (killer: Player, victim: Player) -> () } = {}

-- Registers a callback that runs (each in pcall) right after a claim opens.
function ClaimService.onClaimStarted(callback: (killer: Player, victim: Player) -> ())
	table.insert(startedCallbacks, callback)
end

-- One open claim, made by `killer` on `victim`. Names are kept because either may leave.
type Session = {
	killer: Player,
	victim: Player,
	killerName: string,
	victimName: string,
	claim: BlindClaim.Claim,
	release: () -> (),
	closed: boolean,
}

-- Open claims by killer. A killer has at most one; a victim is in at most one (they are locked).
local sessions: { [Player]: Session } = {}
-- Last claim time per killer and victim (UserIds), on the os.clock() clock.
local history: Protection.ClaimHistory = {}
local buckets: { [Player]: RateLimiter.Bucket } = {}
local claimUpdate: RemoteEvent

-- True while the player has an open, unclosed claim of their own.
function ClaimService.isClaiming(player: Player): boolean
	local s = sessions[player]
	return s ~= nil and not s.closed
end

-- True if the player has a token left in their rate-limit bucket (takes one).
local function allowed(player: Player): boolean
	local now = os.clock()
	local bucket = buckets[player]
	if bucket == nil then
		bucket = RateLimiter.new(BUCKET_CAPACITY, now)
		buckets[player] = bucket
	end
	return RateLimiter.allow(bucket, now, BUCKET_CAPACITY, BUCKET_REFILL_PER_SECOND)
end

local function sendUpdate(session: Session)
	if session.killer.Parent ~= Players then
		return
	end
	claimUpdate:FireClient(session.killer, {
		victimName = session.victimName,
		claim = session.claim,
		secondsLeft = math.max(0, session.claim.expiresAt - os.clock()),
	})
end

-- Ends a claim. Every path that ends a claim comes here; it runs once only.
local function close(session: Session)
	if session.closed then
		return
	end
	session.closed = true
	if sessions[session.killer] == session then
		sessions[session.killer] = nil
	end

	LedgerService.unlock(session.victim)
	session.release()

	if session.killer.Parent == Players then
		claimUpdate:FireClient(session.killer, nil)
		LedgerService.notify(session.killer, "CLAIM_OVER")
	end
	if session.victim.Parent == Players then
		local names: { string } = {}
		for _, id in session.claim.takenIds do
			local relic = Relics.byId[id]
			table.insert(names, if relic ~= nil then relic.name else id)
		end
		if #names > 0 then
			LedgerService.notify(session.victim, "CLAIM_LOST", {
				player = session.killerName,
				names = table.concat(names, ", "),
			})
		else
			LedgerService.notify(session.victim, "CLAIM_SAFE", { player = session.killerName })
		end
	end
end

-- Runs in the thread that reported the defeat. For a combat log that is the leaver's
-- PlayerRemoving, so the hold is taken before their profile can be released.
local function onDefeat(killer: Player, victim: Player)
	-- Credit never names an ally; this is the second lock on the same door.
	if Fighters.allied(killer.UserId, victim.UserId) then
		return
	end
	if sessions[killer] ~= nil or LedgerService.isLocked(victim) then
		return
	end
	if LedgerService.get(killer) == nil or LedgerService.get(victim) == nil then
		return
	end
	local now = os.clock()
	if not Protection.canClaim(history, killer.UserId, victim.UserId, now) then
		if killer.Parent == Players then
			LedgerService.notify(killer, "CLAIM_COOLDOWN", { player = victim.DisplayName })
		end
		return
	end

	-- Everyone in the killer's party gets the cooldown against this victim, so a party cannot
	-- take turns claiming the same player.
	local group: { number } = { killer.UserId }
	for _, allyId in Fighters.allies(killer.UserId) do
		table.insert(group, allyId)
	end
	history = Protection.recordClaims(history, group, victim.UserId, now)
	local session: Session = {
		killer = killer,
		victim = victim,
		killerName = killer.DisplayName,
		victimName = victim.DisplayName,
		claim = BlindClaim.start(now),
		release = DataService.hold(victim),
		closed = false,
	}
	LedgerService.lock(victim)
	sessions[killer] = session

	if victim.Parent == Players then
		LedgerService.notify(victim, "DEFEATED_BY", { player = session.killerName })
	end
	LedgerService.notify(killer, "CLAIM_STARTED", { player = session.victimName })
	sendUpdate(session)
	for _, callback in startedCallbacks do
		local ok, err = pcall(callback, killer, victim)
		if not ok then
			warn(`[IsleOfAvarice] onClaimStarted callback failed: {err}`)
		end
	end

	task.delay(BlindClaim.DURATION, close, session)
end

local function handlePick(player: Player, slot: any)
	if player.Parent ~= Players then
		return
	end
	if not allowed(player) then
		return
	end
	local session = sessions[player]
	if session == nil or session.closed then
		return
	end

	-- Read both sides and check both are loaded before writing either.
	-- No yielding call from here to the two writes.
	local victimLedger = LedgerService.get(session.victim)
	local victimVault = LedgerService.getVault(session.victim)
	local killerLedger = LedgerService.get(player)
	if victimLedger == nil or victimVault == nil or killerLedger == nil then
		close(session)
		return
	end

	local now = os.clock()
	local claim, newVictim, newKiller, code, cardId =
		BlindClaim.pick(session.claim, victimLedger, victimVault, killerLedger, slot, now)

	-- The new claim is stored only once the card has moved, so a failed write records nothing.
	if code == "TAKEN" then
		if not LedgerService.set(session.victim, newVictim) then
			close(session)
			return
		end
		if not LedgerService.set(player, newKiller) then
			-- Cannot happen after the check above; if it does, give the card back.
			LedgerService.set(session.victim, victimLedger)
			close(session)
			return
		end
		session.claim = claim
		local relic = if cardId ~= nil then Relics.byId[cardId] else nil
		LedgerService.notify(
			player,
			"CLAIM_TAKEN",
			{ name = if relic ~= nil then relic.name else "" }
		)
	elseif code == "MISS" then
		session.claim = claim
		LedgerService.notify(player, "CLAIM_MISS")
	else
		-- A refusal returns the claim unchanged and spends no pick.
		LedgerService.notify(player, code)
	end

	sendUpdate(session)
	if not BlindClaim.isOpen(session.claim, now) then
		close(session)
	end
end

function ClaimService.start()
	claimUpdate = LedgerService.makeRemote(Net.ClaimUpdate)
	local claimPick = LedgerService.makeRemote(Net.ClaimPick)
	claimPick.OnServerEvent:Connect(handlePick)

	CombatService.onDefeat(onDefeat)

	Players.PlayerRemoving:Connect(function(player)
		buckets[player] = nil
		-- A leaving killer's claim ends. A leaving victim's claim goes on: their profile is held.
		local session = sessions[player]
		if session ~= nil then
			close(session)
		end
	end)
end

return ClaimService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="70">
        <Properties>
          <string name="Name">CombatService</string>
          <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Combat = require(ReplicatedStorage.Shared.Rules.Combat)
local Effects = require(ReplicatedStorage.Shared.Rules.Effects)
local Net = require(ReplicatedStorage.Shared.Net)
local Protection = require(ReplicatedStorage.Shared.Rules.Protection)
local Types = require(ReplicatedStorage.Shared.Types)
local DataService = require(script.Parent.DataService)
local Fighters = require(script.Parent.Fighters)
local LedgerService = require(script.Parent.LedgerService)
local ProtectionService = require(script.Parent.ProtectionService)
local Sight = require(script.Parent.Sight)
local StatusService = require(script.Parent.StatusService)

-- `path`: the Path a post hit trains ("Strike" = the attacker's Calling, "" = none).
type DamageOpts = { reflected: boolean?, tick: boolean?, passive: boolean?, path: string? }

local STRIKE_PATH = "Strike"
-- Damage a creature takes from a player's reflect counts as this Path.
local REFLECT_PATH = "Bulwark"
local POST_XP = 10
local POST_XP_GAP = 0.5 -- seconds between paid hits, per post per attacker
local POST_FLASH_SECONDS = 0.15
local POST_FLASH_COLOR = Color3.fromRGB(255, 235, 150)

local CombatService = {}

-- Who last hit whom, keyed by victim UserId. Time from os.clock(). Player hits only.
local hitLog: Combat.HitLog = {}
-- When each player last dealt or took player damage (os.clock). Player versus player only.
local fightAt: { [Player]: number } = {}
-- The last creature to hit each player. Kept apart so a creature never takes a player's
-- defeat credit, never counts for combat logging and never makes anyone an aggressor.
local creatureLog: Combat.HitLog = {}
local hitCallbacks: { (attackerId: number, targetId: number, amount: number, path: string) -> () } =
	{}
local lastStrike: { [Player]: number } = {}
local defeatCallbacks: { (killer: Player, victim: Player) -> () } = {}
local hitFx: RemoteEvent
-- Last paid hit per attacker fighter id per post id, on os.clock().
local postHits: { [number]: { [number]: number } } = {}
local postBaseColor: { [BasePart]: Color3 } = {}
local postFlashToken: { [BasePart]: number } = {}

-- PathService.get and PathService.grant, passed in by Main.server.luau. PathService
-- requires ClaimService, which requires this module, so requiring it here would be a cycle.
local getPaths: ((Player) -> Types.PathProgress?)? = nil
local grantXp: ((Player, string, number) -> ())? = nil

-- A short flash on the post part. A newer flash takes over the restore.
local function flashPost(postId: number)
	local model = Fighters.model(postId)
	if model == nil or not model:IsA("BasePart") or not model:IsDescendantOf(workspace) then
		return
	end
	local part = model :: BasePart
	local base = postBaseColor[part] or part.Color
	postBaseColor[part] = base
	local token = (postFlashToken[part] or 0) + 1
	postFlashToken[part] = token
	part.Color = POST_FLASH_COLOR
	task.delay(POST_FLASH_SECONDS, function()
		if postFlashToken[part] == token then
			part.Color = base
		end
	end)
end

-- Runs every defeat callback now, in this thread, so a callback can take a DataService hold
-- inside PlayerRemoving before the leaver's profile is released.
local function fireDefeat(killer: Player, victim: Player)
	for _, callback in defeatCallbacks do
		local ok, err = pcall(callback, killer, victim)
		if not ok then
			warn(`[IsleOfAvarice] onDefeat callback failed: {err}`)
		end
	end
end

-- Gives the kill to whoever hit the victim within the window, if they are still here.
-- `byCreature`: when a creature struck the victim last, nobody gets it (a defeat by a
-- creature gives no claim and no XP). Leaving the game ignores creatures: combat logging
-- counts only damage between players.
local function creditDefeat(victim: Player, windowSeconds: number, byCreature: boolean)
	local now = os.clock()
	local killerId = Combat.creditFor(
		hitLog,
		victim.UserId,
		now,
		windowSeconds,
		if byCreature then creatureLog else nil,
		Fighters.allies(victim.UserId)
	)
	hitLog = Combat.clear(hitLog, victim.UserId)
	creatureLog = Combat.clear(creatureLog, victim.UserId)
	if killerId == nil then
		return
	end
	local entry = Fighters.get(killerId)
	local killer = if entry ~= nil then entry.player else nil
	if killer ~= nil and killer ~= victim then
		fireDefeat(killer, victim)
	end
end

-- A player hits a training post: Path XP, at most once per POST_XP_GAP per post per attacker,
-- and a flash. Posts have no protections and take no damage or effects. "Strike" trains the
-- attacker's Calling; without a Path (or a Calling) nothing happens.
local function hitPost(
	attacker: Player,
	attackerId: number,
	postId: number,
	opts: DamageOpts?
): boolean
	local path = if opts ~= nil and opts.path ~= nil then opts.path else ""
	if path == STRIKE_PATH then
		local paths = getPaths
		local progress = if paths ~= nil then paths(attacker) else nil
		path = if progress ~= nil then progress.calling else ""
	end
	if path == "" then
		return true
	end
	flashPost(postId)
	local now = os.clock()
	local hits = postHits[attackerId]
	if hits == nil then
		hits = {}
		postHits[attackerId] = hits
	end
	local last = hits[postId]
	-- Written so a NaN time pays nothing.
	if last ~= nil and not (now - last >= POST_XP_GAP) then
		return true
	end
	hits[postId] = now
	local grant = grantXp
	if grant ~= nil then
		grant(attacker, path, POST_XP)
	end
	return true
end

-- Player versus player: protections, Mark, empower, statuses, the hit log and the reflect.
local function damagePlayer(
	attacker: Player,
	victim: Player,
	amount: number,
	opts: DamageOpts?
): boolean
	local reflected = opts ~= nil and opts.reflected == true
	local tick = opts ~= nil and opts.tick == true
	local passive = opts ~= nil and opts.passive == true
	local victimHumanoid = Fighters.body(victim.UserId)
	if victimHumanoid == nil then
		return false
	end
	local now = os.clock()

	-- No yielding call from here to TakeDamage: statuses cannot go stale.
	if not reflected then
		local attackerStatus = ProtectionService.status(attacker, now)
		if attackerStatus == nil then
			-- A living attacker without loaded data is told; one without a living character
			-- (a burn or zone outliving its owner) cannot pass the protections either.
			if not tick and DataService.get(attacker) == nil then
				LedgerService.notify(attacker, "DATA_NOT_LOADED")
			end
			return false
		end
		local victimStatus = ProtectionService.status(victim, now)
		if victimStatus == nil then
			-- Victim's data is not loaded yet: treat them as shielded.
			if not tick then
				LedgerService.notify(attacker, "TARGET_SHIELDED")
			end
			return false
		end
		local ok, code = Protection.canDamage(attackerStatus, victimStatus, now)
		if not ok then
			if not tick then
				LedgerService.notify(attacker, code or "BAD_REQUEST")
			end
			return false
		end

		-- A passive hit (a zone on someone who walked into it) starts no fight for its owner.
		if not passive then
			ProtectionService.endRespawnShield(attacker)
			local victimMarked = Protection.isMarked(victimStatus, now)
			if
				Protection.isAggressor(
					hitLog,
					attacker.UserId,
					victim.UserId,
					victimMarked,
					now,
					Fighters.allies(victim.UserId)
				)
			then
				ProtectionService.mark(attacker, now)
			end
		end
	end

	local total = amount
	if not reflected and not tick then
		local bonus = 0
		StatusService.update(attacker.UserId, function(status, at)
			local out, taken = Effects.takeEmpower(status, at)
			bonus = taken
			return out
		end)
		total += bonus
	end

	local immune, health, reflectBack = false, 0, 0
	StatusService.update(victim.UserId, function(status, at)
		immune = Effects.isImmune(status, at)
		local out, toHealth, toReflect = Effects.resolveDamage(status, total, at)
		health, reflectBack = toHealth, toReflect
		return out
	end)
	if immune and not (health > 0) then
		return false
	end

	-- Record the hit before the damage: with immediate signal behaviour, Died can fire
	-- inside TakeDamage, and the kill must already be credited by then.
	hitLog = Combat.recordHit(hitLog, victim.UserId, attacker.UserId, now)
	fightAt[attacker] = now
	fightAt[victim] = now
	if health > 0 then
		victimHumanoid:TakeDamage(health)
	end
	CombatService.flash(victim.UserId)

	-- A player the hit defeated reflects nothing.
	if reflectBack > 0 and not reflected and victimHumanoid.Health > 0 then
		CombatService.damage(victim.UserId, attacker.UserId, reflectBack, { reflected = true })
	end
	return true
end

-- A creature hurts a player. The safe zone and the respawn shield stop it; the new-player
-- shield does not. Nobody is Marked, no fight starts, and the hit goes in the creature log.
-- The victim's own effects apply (immune, reduction, shield, reflect).
local function creatureHitsPlayer(creatureId: number, victim: Player, amount: number): boolean
	local victimHumanoid = Fighters.body(victim.UserId)
	if victimHumanoid == nil then
		return false
	end
	local now = os.clock()
	-- No yielding call from here to the health change: statuses cannot go stale.
	local victimStatus = ProtectionService.status(victim, now)
	if victimStatus == nil or not Protection.creatureCanHit(victimStatus, now) then
		return false
	end

	local immune, health, reflectBack = false, 0, 0
	StatusService.update(victim.UserId, function(status, at)
		immune = Effects.isImmune(status, at)
		local out, toHealth, toReflect = Effects.resolveDamage(status, amount, at)
		health, reflectBack = toHealth, toReflect
		return out
	end)
	if immune and not (health > 0) then
		return false
	end

	-- Recorded before the health change: Died can fire inside it.
	creatureLog = Combat.recordHit(creatureLog, victim.UserId, creatureId, now)
	if health > 0 then
		-- Not TakeDamage: the new-player shield shows a ForceField, which would block it.
		victimHumanoid.Health = math.max(0, victimHumanoid.Health - health)
	end
	CombatService.flash(victim.UserId)

	-- A player the hit defeated reflects nothing.
	if reflectBack > 0 and victimHumanoid.Health > 0 then
		CombatService.damage(
			victim.UserId,
			creatureId,
			reflectBack,
			{ reflected = true, path = REFLECT_PATH }
		)
	end
	return true
end

-- A player hurts a creature. Only standing in the safe zone stops it. It never Marks anyone;
-- it does end the attacker's respawn shield. A creature walking home is immune.
local function damageCreature(
	attacker: Player,
	creatureId: number,
	amount: number,
	opts: DamageOpts?
): boolean
	local reflected = opts ~= nil and opts.reflected == true
	local tick = opts ~= nil and opts.tick == true
	local passive = opts ~= nil and opts.passive == true
	local humanoid = Fighters.body(creatureId)
	if humanoid == nil then
		return false
	end
	local now = os.clock()

	-- No yielding call from here to TakeDamage: statuses cannot go stale.
	if not reflected then
		local attackerStatus = ProtectionService.status(attacker, now)
		if attackerStatus == nil then
			if not tick and DataService.get(attacker) == nil then
				LedgerService.notify(attacker, "DATA_NOT_LOADED")
			end
			return false
		end
		local ok, code = Protection.canHitCreature(attackerStatus)
		if not ok then
			if not tick then
				LedgerService.notify(attacker, code or "BAD_REQUEST")
			end
			return false
		end
		if not passive then
			ProtectionService.endRespawnShield(attacker)
		end
	end

	local total = amount
	if not reflected and not tick then
		local bonus = 0
		StatusService.update(attacker.UserId, function(status, at)
			local out, taken = Effects.takeEmpower(status, at)
			bonus = taken
			return out
		end)
		total += bonus
	end

	local immune, health = false, 0
	StatusService.update(creatureId, function(status, at)
		immune = Effects.isImmune(status, at)
		-- A creature reflects nothing.
		local out, toHealth = Effects.resolveDamage(status, total, at)
		health = toHealth
		return out
	end)
	if immune and not (health > 0) then
		return false
	end

	-- The tally is told before the damage: Died can fire inside TakeDamage, and the last
	-- hit must already count by then.
	if health > 0 then
		local path = if opts ~= nil and opts.path ~= nil then opts.path else ""
		for _, callback in hitCallbacks do
			local ok, err = pcall(callback, attacker.UserId, creatureId, health, path)
			if not ok then
				warn(`[IsleOfAvarice] onHit callback failed: {err}`)
			end
		end
		humanoid:TakeDamage(health)
	end
	CombatService.flash(creatureId)
	return true
end

-- HitFx to every client for the fighter `id`.
function CombatService.flash(id: number)
	hitFx:FireAllClients(id)
end

-- Damage from the island: no attacker, no protections (shields guard against players only),
-- no hit-log entry. The victim's own effects still apply: immunity cancels it; damage
-- reduction and ability shields absorb. Sets Humanoid.Health directly, so a ForceField does
-- not block it. `flash` also fires the HitFx remote. True when health was removed.
function CombatService.environmentDamage(victim: Player, amount: number, flash: boolean?): boolean
	-- Written positively so a NaN amount is refused too.
	if not (amount > 0) or victim.Parent ~= Players then
		return false
	end
	local humanoid = Fighters.body(victim.UserId)
	if humanoid == nil then
		return false
	end

	-- No yielding call from here to the health change: statuses cannot go stale.
	local immune, health = false, 0
	StatusService.update(victim.UserId, function(status, at)
		immune = Effects.isImmune(status, at)
		-- The reflect amount is dropped: the island has nothing to reflect at.
		local out, toHealth = Effects.resolveDamage(status, amount, at)
		health = toHealth
		return out
	end)
	if immune and not (health > 0) then
		return false
	end

	-- Not TakeDamage: a ForceField blocks that, and a shielded player is still hurt by the island.
	-- A defeat here is credited by the Died handler like any other.
	if health > 0 then
		humanoid.Health = math.max(0, humanoid.Health - health)
	end
	if flash == true then
		CombatService.flash(victim.UserId)
	end
	return health > 0
end

-- Defeats the victim outright (drowning). Ignores effects. The Died handler credits it.
function CombatService.environmentDefeat(victim: Player)
	if victim.Parent ~= Players then
		return
	end
	local humanoid = Fighters.body(victim.UserId)
	if humanoid ~= nil then
		humanoid.Health = 0
	end
end

-- The one way any fighter is hurt: the Strike, abilities, burns, zones and reflects, between
-- any two fighters in the registry that may fight. True only when the hit landed (a post
-- always counts; a player hit passed the protections and the victim was not immune); callers
-- apply statuses, pulls and knockbacks only then.
-- `reflected`: damage sent back by a reflect, so no protections, Mark or empower.
-- `tick`: burn or zone damage, so refusals are not notified and no empower is used.
-- `passive`: a zone tick on someone who walked in after it was placed; the damage and the
-- protections are unchanged, but the attacker is not Marked and keeps their respawn shield.
-- `path`: the Path a post hit trains and a creature hit is counted for ("Strike" = the
-- attacker's Calling).
function CombatService.damage(
	attackerId: number,
	targetId: number,
	amount: number,
	opts: DamageOpts?
): boolean
	local attacker, target = Fighters.get(attackerId), Fighters.get(targetId)
	if attacker == nil or target == nil or not Fighters.mayFight(attackerId, targetId) then
		return false
	end
	local attackerPlayer, victimPlayer = attacker.player, target.player
	if attacker.kind == "creature" then
		-- A creature hurts players only: never a post, never another creature.
		if target.kind == "player" and victimPlayer ~= nil then
			return creatureHitsPlayer(attackerId, victimPlayer, amount)
		end
		return false
	end
	if attacker.kind ~= "player" or attackerPlayer == nil then
		return false
	end
	if target.kind == "post" then
		return hitPost(attackerPlayer, attackerId, targetId, opts)
	elseif target.kind == "creature" then
		return damageCreature(attackerPlayer, targetId, amount, opts)
	elseif victimPlayer ~= nil then
		return damagePlayer(attackerPlayer, victimPlayer, amount, opts)
	end
	return false
end

-- The client only says "I swung". Target, reach, damage and timing are all decided here.
local function handleStrike(player: Player)
	if player.Parent ~= Players then
		return
	end
	local attacker = Fighters.fighter(player.UserId)
	if attacker == nil then
		return
	end
	local now = os.clock()
	if not Combat.canStrike(lastStrike[player], now) then
		return
	end
	lastStrike[player] = now

	-- Only what the attacker can see is a candidate, so a target behind a corner never
	-- swallows the swing, and an unseen taunter forces nothing.
	local p = attacker.position
	local others = Sight.filter(Vector3.new(p.x, p.y, p.z), Fighters.list(player.UserId))
	local taunter = Effects.tauntedBy(StatusService.get(player.UserId), now)
	local targetId = Combat.pickTarget(attacker, others, nil, taunter)
	if targetId == nil then
		return
	end
	-- A post trains the Calling; without a Calling the swing does nothing there.
	CombatService.damage(player.UserId, targetId, Combat.STRIKE_DAMAGE, { path = STRIKE_PATH })
end

local function onCharacterAdded(player: Player, character: Model)
	local humanoid = character:WaitForChild("Humanoid", 10)
	if humanoid == nil or not humanoid:IsA("Humanoid") then
		return
	end
	humanoid.MaxHealth = Combat.MAX_HEALTH
	humanoid.Health = Combat.MAX_HEALTH
	humanoid.Died:Connect(function()
		creditDefeat(player, Combat.KILL_CREDIT_SECONDS, true)
	end)
end

local function watchPlayer(player: Player)
	player.CharacterAdded:Connect(function(character)
		onCharacterAdded(player, character)
	end)
	local character = player.Character
	if character ~= nil then
		task.spawn(onCharacterAdded, player, character)
	end
end

-- Runs for every hit that takes health off a creature, just before the damage: the attacker
-- (a player), the creature, the health taken and the hit's Path ("Strike", a Path, or "").
-- Callbacks must not yield.
function CombatService.onHit(callback: (
	attackerId: number,
	targetId: number,
	amount: number,
	path: string
) -> ())
	table.insert(hitCallbacks, callback)
end

-- The os.clock() time the player last dealt or took player damage, or nil.
function CombatService.lastFightAt(player: Player): number?
	return fightAt[player]
end

-- Player-versus-player defeats, and leaving within the combat-log window after being hit.
function CombatService.onDefeat(callback: (killer: Player, victim: Player) -> ())
	table.insert(defeatCallbacks, callback)
end

-- `paths` and `grant` are PathService.get and PathService.grant (see getPaths above).
function CombatService.start(
	paths: (Player) -> Types.PathProgress?,
	grant: (Player, string, number) -> ()
)
	getPaths = paths
	grantXp = grant
	hitFx = LedgerService.makeRemote(Net.HitFx)
	local strike = LedgerService.makeRemote(Net.Strike)
	strike.OnServerEvent:Connect(handleStrike)

	Players.PlayerAdded:Connect(watchPlayer)
	for _, player in Players:GetPlayers() do
		watchPlayer(player)
	end

	-- Combat log: leaving soon after being hit counts as a defeat.
	DataService.beforeRelease(function(player)
		creditDefeat(player, Combat.COMBAT_LOG_SECONDS, false)
	end)
	Players.PlayerRemoving:Connect(function(player)
		lastStrike[player] = nil
		fightAt[player] = nil
		postHits[player.UserId] = nil
	end)
end

return CombatService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="71">
        <Properties>
          <string name="Name">CreatureService</string>
          <string name="Source"><![CDATA[--!strict
-- The island's creatures: builds them at their dens, runs each one's brain ten times a second
-- (CreatureBrain decides, this applies), carries out their attacks through the one damage
-- pipeline, and pays everyone who helped when one is defeated (Rewards decides who and what).
-- Also spawns the Drowned Tallyman for a duel: a creature only its owner can fight.
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Combat = require(ReplicatedStorage.Shared.Rules.Combat)
local CreatureBrain = require(ReplicatedStorage.Shared.Rules.CreatureBrain)
local Creatures = require(ReplicatedStorage.Shared.Catalog.Creatures)
local Effects = require(ReplicatedStorage.Shared.Rules.Effects)
local Geography = require(ReplicatedStorage.Shared.Rules.Geography)
local Ledger = require(ReplicatedStorage.Shared.Rules.Ledger)
local Protection = require(ReplicatedStorage.Shared.Rules.Protection)
local Rewards = require(ReplicatedStorage.Shared.Rules.Rewards)
local Targeting = require(ReplicatedStorage.Shared.Rules.Targeting)
local Types = require(ReplicatedStorage.Shared.Types)
local World = require(ReplicatedStorage.Shared.Catalog.World)
local CombatService = require(script.Parent.CombatService)
local DataService = require(script.Parent.DataService)
local Fighters = require(script.Parent.Fighters)
local Fx = require(script.Parent.Fx)
local LedgerService = require(script.Parent.LedgerService)
local Payout = require(script.Parent.Payout)
local ProtectionService = require(script.Parent.ProtectionService)
local Sight = require(script.Parent.Sight)
local SourceService = require(script.Parent.SourceService)
local StatusService = require(script.Parent.StatusService)

type CreatureKind = Types.CreatureKind
type Vec3 = Types.Vec3

export type Info = {
	kind: string,
	alive: boolean,
	mode: string,
	targetId: number,
	position: Vector3?,
	owner: Player?,
}

type Creature = {
	id: number,
	kind: CreatureKind,
	den: Vec3,
	owner: Player?,
	model: Model,
	humanoid: Humanoid,
	root: BasePart,
	brain: CreatureBrain.Brain,
	tally: Rewards.Tally,
	-- The last player to hit it since the previous brain tick.
	provoker: number?,
	-- True once it is standing still because it is not in the active set.
	parked: boolean,
	gone: boolean,
}

-- One piece of a creature's look. `at` is the piece's centre: x to its right, y above the
-- ground, z behind it (a creature faces -z).
type Piece = {
	name: string,
	size: Vector3,
	at: Vector3,
	color: Color3?, -- the kind's own colour when nil
	ball: boolean?,
}
-- `root` is the invisible body that walks and collides; `centre` its height above the ground.
type Look = { root: Vector3, centre: number, pieces: { Piece } }

local FOLDER_NAME = "Creatures"
local TAG = "Creature"
local MEMBER_SPACING = 4
local MELEE_SLACK = 1 -- a bite still lands if the target stepped this far past the reach
local LUNGE_SLACK = 1.5
local TIP_SECONDS = 1.5
local BAR_DISTANCE = 80
local SHOT_COLOR = Color3.fromRGB(150, 200, 90)
local SLAM_COLOR = Color3.fromRGB(120, 170, 200)
local PALE = Color3.fromRGB(215, 220, 205)
local DARK = Color3.fromRGB(35, 40, 45)
local GOLD = Color3.fromRGB(235, 190, 60)

