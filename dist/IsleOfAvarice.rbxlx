        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">World</string>
            <string name="Source"><![CDATA[--!strict
local Geography = require("../Rules/Geography")
local Sites = require("./Sites")
local Thornwood = require("./SiteData/Thornwood")
local Types = require("../Types")

type Cache = Types.Cache

local islandHalfSize = 1380
local groundY = 0
local spawn: Types.Vec3 = { x = 0, y = 0.7, z = 0 }
local townRadius = Geography.TOWN_RADIUS
-- The Edict Hall clerk, between the two north buildings of Tallyport.
local clerk: Types.Vec3 = { x = 0, y = 0, z = -24 }
-- The Tally Stone, on the south side of the plaza.
local tallyStone: Types.Vec3 = { x = 0, y = 0, z = 32 }

-- Caches C001 to C006 hold Relics R001 to R006 in the Counting Fields.
local fieldLayout: { { number } } = {
	{ 60, 40 },
	{ -70, 55 },
	{ 90, -60 },
	{ -50, -95 },
	{ 120, 20 },
	{ -130, -10 },
}

local caches: { Cache } = {}
local cacheById: { [string]: Cache } = {}
local function addCache(relicId: string, x: number, y: number, z: number, hold: number?)
	local cache: Cache = {
		id = string.format("C%03d", #caches + 1),
		relicId = relicId,
		position = { x = x, y = y, z = z },
		hold = hold,
	}
	table.insert(caches, cache)
	cacheById[cache.id] = cache
end

for i, xz in fieldLayout do
	addCache(string.format("R%03d", i), xz[1], 1, xz[2], nil)
end

-- Caches C007 to C012 hold Relics R007 to R012, each at the prize of the site that holds it.
local prizes: { [string]: Types.SiteCache } = {}
for _, site in Sites.list do
	if site.prize ~= nil then
		prizes[site.prize.relicId] = site.prize
	end
end
for n = 7, 12 do
	local relicId = string.format("R%03d", n)
	local prize = prizes[relicId]
	if prize == nil then
		error(`World: no site holds {relicId}`)
	end
	addCache(relicId, prize.x, prize.y, prize.z, prize.hold)
end

-- Caches C013 to C018 are the Copper caches out in the wild regions.
for _, extra in Sites.extras do
	addCache(extra.relicId, extra.x, extra.y, extra.z, extra.hold)
end

-- A spot in a wild region's own frame: `along` out from the island centre down the region's
-- bearing, `across` to the right of that line.
local function spot(regionId: string, along: number, across: number, y: number): Types.Vec3
	local x, z = Geography.place(regionId, along, across)
	return { x = x, y = y, z = z }
end

-- A stack of square ledges to jump up, centred on a spot. Ledges are 8 wide, 10 apart and
-- rise 4 each; they run in rows of `perRow` that double back, so the next ledge is always
-- the only one within a jump. Ledges are square to the world's axes whatever the region.
local LEDGE_SIZE = 8
local LEDGE_STEP = 10
local LEDGE_RISE = 4
local function climb(centre: Types.Vec3, count: number, perRow: number): { Types.Ledge }
	local rows = math.ceil(count / perRow)
	local ledges: { Types.Ledge } = {}
	for i = 0, count - 1 do
		local row = math.floor(i / perRow)
		local col = i % perRow
		if row % 2 == 1 then
			col = perRow - 1 - col
		end
		table.insert(ledges, {
			x = centre.x + (col - (perRow - 1) / 2) * LEDGE_STEP,
			z = centre.z + (row - (rows - 1) / 2) * LEDGE_STEP,
			size = LEDGE_SIZE,
			top = (i + 1) * LEDGE_RISE,
		})
	end
	return ledges
end

-- Caches C019 to C021 sit on top of climbs: R017 above Thornwood's north shore, R018 on the
-- far flank of Bastion Reach, and R026 on the Lookout's crag, the island's highest point.
local climbs: { [string]: { Types.Ledge } } = {}
local function addClimbCache(
	relicId: string,
	centre: Types.Vec3,
	count: number,
	perRow: number,
	hold: number?
)
	local ledges = climb(centre, count, perRow)
	local last = ledges[#ledges]
	addCache(relicId, last.x, last.top + 1, last.z, hold)
	climbs[caches[#caches].id] = ledges
end
addClimbCache("R017", spot("Thornwood", 870, 160, 0), 5, 3)
addClimbCache("R018", spot("BastionReach", 800, 290, 0), 6, 3)
addClimbCache("R026", spot("SquallSteps", 550, 220, 0), 16, 4)
-- The Cliff Warden's course: one straight flight beside the Squall Steps gate.
climbs.gullstep_climb = climb(spot("SquallSteps", 350, 100, 0), 7, 7)

-- Caches C022 to C024: Copper, in far corners of the wilds.
for _, far in
	{
		{ relicId = "R028", at = spot("SquallSteps", 440, -110, 1) },
		{ relicId = "R029", at = spot("DrownedFen", 885, -60, 1) },
		{ relicId = "R030", at = spot("Thornwood", 860, -150, 1) },
	}
do
	addCache(far.relicId, far.at.x, far.at.y, far.at.z, nil)
end

-- Caches C025 to C031 (M7): two more far Copper caches, one at the blight's edge, one in the
-- maze's dead end, one on the Rock (held), then two climbs (the second held, for the Crown).
local mazeAlong, mazeAcross = Thornwood.cellCentre(14, 8)
local m7Caches: { { relicId: string, at: Types.Vec3, hold: number? } } = {
	{ relicId = "R032", at = spot("CinderFlats", 700, -260, 1) },
	{ relicId = "R033", at = spot("BastionReach", 650, -260, 1) },
	{ relicId = "R034", at = spot("HushGardens", 245, -115, 1) },
	{ relicId = "R038", at = spot("Thornwood", mazeAlong, mazeAcross, 1) },
	{ relicId = "R044", at = { x = 0, y = 1, z = 1290 }, hold = 3 },
}
for _, extra in m7Caches do
	addCache(extra.relicId, extra.at.x, extra.at.y, extra.at.z, extra.hold)
end
addClimbCache("R039", spot("CinderFlats", 520, -270, 0), 6, 3)
addClimbCache("R050", spot("DrownedFen", 650, 230, 0), 12, 4, 10)

-- One Warden per trial, beside the road at a region's gate. The Harbour Warden stands at the
-- head of the west Sluice, inside the ring the Hush Gardens blight does not reach.
local harbour = spot("HushGardens", 285, 80, 0)
local wardens: { [string]: Types.Vec3 } = {
	tidewalk = harbour,
	gullstep_climb = spot("SquallSteps", 300, 45, 0),
	salt_post = spot("CinderFlats", 300, 45, 0),
	cull_the_pack = spot("Thornwood", 300, 45, 0),
	shellbreaker = spot("DrownedFen", 300, 45, 0),
	tallymans_duel = spot("BastionReach", 300, 45, 0),
	reed_run = spot("DrownedFen", 300, -45, 0),
	bellows_dance = spot("CinderFlats", 380, 55, 0),
	spitter_season = spot("CinderFlats", 300, -45, 0),
	-- The Crown Warden stands in Tallyport.
	grand_tally = { x = -14, y = 0, z = 24 },
}
local duelArena = spot("BastionReach", 330, 120, 0)

-- Course markers in order, at the height of a standing character's root (surface + 3).
local MARKER_LIFT = 3
local gullstep: { Types.Vec3 } = {}
do
	local first = climbs.gullstep_climb[1]
	table.insert(gullstep, { x = first.x - LEDGE_STEP, y = MARKER_LIFT, z = first.z })
	for _, ledge in climbs.gullstep_climb do
		table.insert(gullstep, { x = ledge.x, y = ledge.top + MARKER_LIFT, z = ledge.z })
	end
end
local courses: { [string]: { Types.Vec3 } } = {
	-- Along the blight-free edge of the Hush Gardens, away from the harbour.
	tidewalk = {
		spot("HushGardens", 305, 65, MARKER_LIFT),
		spot("HushGardens", 285, 30, MARKER_LIFT),
		spot("HushGardens", 305, -10, MARKER_LIFT),
		spot("HushGardens", 285, -35, MARKER_LIFT),
		spot("HushGardens", 295, -95, MARKER_LIFT),
		spot("HushGardens", 285, -125, MARKER_LIFT),
	},
	gullstep_climb = gullstep,
	-- Along the boardwalks of the Drowned Fen, above the bog (the boardwalk top is 0.6).
	reed_run = {
		spot("DrownedFen", 420, 0, 3.6),
		spot("DrownedFen", 510, 0, 3.6),
		spot("DrownedFen", 600, 0, 3.6),
		spot("DrownedFen", 700, 0, 3.6),
		spot("DrownedFen", 780, 0, 3.6),
		spot("DrownedFen", 850, 0, 3.6),
	},
	-- Across the vent centres of the Cinder Flats.
	bellows_dance = {
		spot("CinderFlats", 440, -80, 3),
		spot("CinderFlats", 520, -40, 3),
		spot("CinderFlats", 600, 0, 3),
		spot("CinderFlats", 520, 40, 3),
		spot("CinderFlats", 440, 80, 3),
	},
	-- One marker in every wild region, then Reckoning Rock.
	grand_tally = {
		spot("HushGardens", 440, 0, 3),
		spot("BastionReach", 470, 30, 3),
		spot("Thornwood", 450, 0, 3),
		spot("SquallSteps", 450, 0, 3),
		spot("CinderFlats", 410, 0, 3),
		spot("DrownedFen", 390, -60, 3),
		{ x = 40, y = 3, z = 1220 },
	},
}

-- Creature dens, out in the wilds. Order matters: creature ids follow it.
local function den(
	kind: string,
	count: number,
	regionId: string,
	along: number,
	across: number
): Types.Den
	return { kind = kind, count = count, position = spot(regionId, along, across, 0) }
end
local dens: { Types.Den } = {
	den("brinehound", 3, "Thornwood", 380, -110),
	den("brinehound", 3, "Thornwood", 570, -260),
	den("brinehound", 3, "BastionReach", 460, 190),
	den("brinehound", 3, "BastionReach", 420, -60),
	den("shellback", 2, "DrownedFen", 320, 130),
	den("shellback", 2, "DrownedFen", 560, 270),
	den("shellback", 2, "SquallSteps", 640, 200),
	den("bogspitter", 2, "DrownedFen", 760, 300),
	den("bogspitter", 2, "Thornwood", 900, 0),
	den("bogspitter", 2, "CinderFlats", 380, -140),
	den("brine_colossus", 1, "SquallSteps", 780, 240),
	den("gilded_bailiff", 1, "CinderFlats", 820, -230),
}

-- Den creature n (den order, then member order) has id CREATURE_ID_BASE - n. A duel champion
-- has an id below CHAMPION_ID_BASE. Both are negative and clear of posts and Studio test
-- players, so no fighter id is ever mistaken for another kind.
local CREATURE_ID_BASE = -2000000
local CHAMPION_ID_BASE = -3000000
local creatureSlots: { { id: number, den: number, kind: string } } = {}
for denIndex, entry in dens do
	for _ = 1, entry.count do
		table.insert(creatureSlots, {
			id = CREATURE_ID_BASE - (#creatureSlots + 1),
			den = denIndex,
			kind = entry.kind,
		})
	end
end

local function creatureIndex(id: number): number?
	local n = CREATURE_ID_BASE - id
	if n >= 1 and n <= #creatureSlots and n == math.floor(n) then
		return n
	end
	return nil
end

-- Written so NaN and infinities are refused.
local function isChampion(id: number): boolean
	local k = CHAMPION_ID_BASE - id
	return k >= 1 and k < math.huge and k == math.floor(k)
end

local trainingPosts: { Types.Vec3 } = {
	{ x = 55, y = 0, z = 0 },
	{ x = 28, y = 0, z = 48 },
	{ x = -28, y = 0, z = 48 },
	{ x = -55, y = 0, z = 0 },
	{ x = -28, y = 0, z = -48 },
	{ x = 28, y = 0, z = -48 },
}
-- Post i has id POST_ID_BASE - i; negative, so it never collides with a player UserId.
local POST_ID_BASE = -1000000

local function postIndex(id: number): number?
	local i = POST_ID_BASE - id
	if i >= 1 and i <= #trainingPosts and i == math.floor(i) then
		return i
	end
	return nil
end

return {
	trainingPosts = trainingPosts,
	POST_ID_BASE = POST_ID_BASE,
	postIndex = postIndex,
	islandHalfSize = islandHalfSize,
	groundY = groundY,
	spawn = spawn,
	townRadius = townRadius,
	clerk = clerk,
	tallyStone = tallyStone,
	caches = caches,
	cacheById = cacheById,
	climbs = climbs,
	wardens = wardens,
	harbour = harbour,
	duelArena = duelArena,
	courses = courses,
	dens = dens,
	CREATURE_ID_BASE = CREATURE_ID_BASE,
	creatureSlots = creatureSlots,
	creatureIndex = creatureIndex,
	CHAMPION_ID_BASE = CHAMPION_ID_BASE,
	isChampion = isChampion,
}
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="28">
        <Properties>
          <string name="Name">Net</string>
          <string name="Source"><![CDATA[--!strict
-- Names of the remotes the server creates under ReplicatedStorage.
return {
	FOLDER = "Remotes",
	-- server -> one client: (ledger: Ledger, vault: Vault)
	LedgerSync = "LedgerSync",
	-- client -> server: (request: table)
	LedgerAction = "LedgerAction",
	-- client -> server: () ask for the current Ledger (the first sync may have been missed)
	LedgerRequest = "LedgerRequest",
	-- server -> client(s): (code: string, args: { [string]: string }?)
	Notify = "Notify",
	-- client -> server: (request: table)
	VaultAction = "VaultAction",
	-- server -> one client: (status: { newShield: boolean, respawnShieldSeconds: number, markedSeconds: number })
	StatusSync = "StatusSync",
	-- client -> server: ()
	ShieldDrop = "ShieldDrop",
	-- client -> server: ()
	Strike = "Strike",
	-- server -> all clients: (victimId: number) any fighter id (a player user id or a creature id)
	HitFx = "HitFx",
	-- server -> one client: (payload: { victimName: string, claim: Claim, secondsLeft: number }?), nil closes the screen
	ClaimUpdate = "ClaimUpdate",
	-- client -> server: (slot: number)
	ClaimPick = "ClaimPick",
	-- server -> one client: (progress: PathProgress, coin: number, now: number) now = server os.time()
	PathSync = "PathSync",
	-- client -> server: (pathId: string)
	PickCalling = "PickCalling",
	-- client -> server: (pathId: string)
	ChangeCalling = "ChangeCalling",
	-- client -> server: (request: { slot: number, abilityId: string })
	LoadoutAction = "LoadoutAction",
	-- client -> server: (slot: number)
	CastAbility = "CastAbility",
	-- server -> one client: (slot: number, seconds: number)
	AbilityCooldown = "AbilityCooldown",
	-- server -> one client: (offer: TrialView.OfferView)
	TrialOffer = "TrialOffer",
	-- client -> server: (trialId: string)
	TrialAccept = "TrialAccept",
	-- server -> one client: (state: TrialView.HudState?, questStep: number, rounds: RoundsRecord)
	TrialSync = "TrialSync",
	-- server -> one client: (coin: number)
	CoinSync = "CoinSync",
	-- client -> server: (request: { freeIndex: number, cardId: string, relicId: string?, targetId: number? })
	EdictUse = "EdictUse",
	-- server -> one client: (result: { title: string, lines: { string } }) what a Summons or an Audit found
	EdictResult = "EdictResult",
	-- server -> one client: (veilSeconds: number, met: { { userId: number, name: string } })
	EdictSync = "EdictSync",
	-- server -> one client: (view: Shop.View)
	ShopOpen = "ShopOpen",
	-- client -> server: (request: { kind: "pack" } | { kind: "relic", relicId: string } | { kind: "sell", freeIndex: number, cardId: string })
	ShopAction = "ShopAction",
	-- client -> server: () ask the nearest player to trade
	TradeRequest = "TradeRequest",
	-- server -> one client: (invite: { from: string, seconds: number }?) nil withdraws it
	TradeInvite = "TradeInvite",
	-- client -> server: (accept: boolean)
	TradeReply = "TradeReply",
	-- client -> server: (request: { kind: "offer", cards: { string }, coin: number } | { kind: "confirm" } | { kind: "cancel" })
	TradeAction = "TradeAction",
	-- server -> one client: (view: Trade.View?) nil closes the window
	TradeSync = "TradeSync",
	-- client -> server: () invite the nearest player
	PartyRequest = "PartyRequest",
	-- server -> one client: (invite: { from: string, seconds: number }?) nil withdraws it
	PartyInvite = "PartyInvite",
	-- client -> server: (accept: boolean)
	PartyReply = "PartyReply",
	-- client -> server: (request: { kind: "leave" } | { kind: "kick", userId: number } | { kind: "promote", userId: number })
	PartyAction = "PartyAction",
	-- server -> one client: (sync: PartyView.Sync?) nil = not in a party
	PartySync = "PartySync",
	-- server -> all clients: (ceremony: { userId: number, name: string, crowns: number })
	Ceremony = "Ceremony",
	-- server -> one client: (offer: { lines: { string }, seconds: number }?) nil closes the window
	RenounceOffer = "RenounceOffer",
	-- client -> server: (request: { kind: "confirm", word: string } | { kind: "cancel" })
	RenounceAction = "RenounceAction",
}
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="29">
        <Properties>
          <string name="Name">Rules</string>
        </Properties>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">BlindClaim</string>
            <string name="Source"><![CDATA[--!strict
local Ledger = require("./Ledger")
local Relics = require("../Catalog/Relics")
local Types = require("../Types")

type CardId = Types.CardId
type Ledger = Types.Ledger
type Vault = Types.Vault

export type Claim = {
	picksLeft: number,
	expiresAt: number,
	taken: { [string]: number },
	picked: { [string]: string },
	takenIds: { CardId },
}

local BlindClaim = {}

BlindClaim.PICKS = 5
BlindClaim.DURATION = 30
BlindClaim.TIER_LIMIT = { Crown = 1, Platinum = 1, Gold = 2, Silver = 3, Copper = 3 }

function BlindClaim.start(now: number): Claim
	return {
		picksLeft = BlindClaim.PICKS,
		expiresAt = now + BlindClaim.DURATION,
		taken = {},
		picked = {},
		takenIds = {},
	}
end

function BlindClaim.isOpen(claim: Claim, now: number): boolean
	return claim.picksLeft > 0 and now < claim.expiresAt
end

-- Spends one pick on a slot. Refusals return the inputs untouched and spend nothing.
-- rawSlot comes straight from a client: any type, never raises.
function BlindClaim.pick(
	claim: Claim,
	victim: Ledger,
	victimVault: Vault,
	killer: Ledger,
	rawSlot: any,
	now: number
): (Claim, Ledger, Ledger, string, CardId?)
	if not BlindClaim.isOpen(claim, now) then
		return claim, victim, killer, "CLAIM_OVER"
	end
	if
		type(rawSlot) ~= "number"
		or rawSlot ~= rawSlot
		or rawSlot < 1
		or rawSlot > Relics.count
		or rawSlot ~= math.floor(rawSlot)
	then
		return claim, victim, killer, "BAD_SLOT"
	end
	local slot: number = rawSlot
	local key = tostring(slot)
	if claim.picked[key] ~= nil then
		return claim, victim, killer, "ALREADY_PICKED"
	end
	local relic = Relics.list[slot]
	local limit = BlindClaim.TIER_LIMIT[relic.tier] or 0
	if (claim.taken[relic.tier] or 0) >= limit then
		return claim, victim, killer, "TIER_LIMIT"
	end

	local result: Claim = {
		picksLeft = claim.picksLeft - 1,
		expiresAt = claim.expiresAt,
		taken = table.clone(claim.taken),
		picked = table.clone(claim.picked),
		takenIds = table.clone(claim.takenIds),
	}

	local newKiller = nil
	if Ledger.count(victim, relic.id) > 0 and victimVault[relic.id] ~= true then
		newKiller = Ledger.add(killer, relic.id)
	end
	if newKiller == nil then
		result.picked[key] = "MISS"
		return result, victim, killer, "MISS"
	end

	local newVictim: Ledger =
		{ claimed = table.clone(victim.claimed), free = table.clone(victim.free) }
	local index = table.find(newVictim.free, relic.id)
	if index ~= nil then
		table.remove(newVictim.free, index)
	else
		newVictim.claimed[relic.id] = nil
	end
	result.picked[key] = "TAKEN"
	result.taken[relic.tier] = (result.taken[relic.tier] or 0) + 1
	table.insert(result.takenIds, relic.id)
	return result, newVictim, newKiller, "TAKEN", relic.id
end

return BlindClaim
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">Casting</string>
            <string name="Source"><![CDATA[--!strict
local Abilities = require("../Catalog/Abilities")
local Combat = require("./Combat")
local PathProgress = require("./PathProgress")
local Targeting = require("./Targeting")
local Types = require("../Types")

type Vec3 = Types.Vec3
type Ability = Types.Ability
type PathProgress = Types.PathProgress
type Fighter = Combat.Fighter

export type CastState = { cooldowns: { [string]: number }, lastCast: number } -- ability id -> time it is ready
export type Hit = { targetId: number, damage: number }
export type Zone = { center: Vec3, radius: number, duration: number, dps: number, slow: number? }
export type Plan = {
	hits: { Hit },
	waves: number,
	interval: number,
	moveTo: Vec3?,
	pullTo: Vec3?,
	knockbackTo: Vec3?,
	zone: Zone?,
}

local Casting = {}

Casting.GLOBAL_GAP = 0.3

function Casting.new(): CastState
	return { cooldowns = {}, lastCast = -math.huge }
end

function Casting.canCast(
	state: CastState,
	progress: PathProgress,
	rawSlot: any,
	now: number,
	rooted: boolean
): (string?, string)
	if
		type(rawSlot) ~= "number"
		or rawSlot ~= rawSlot
		or rawSlot ~= math.floor(rawSlot)
		or rawSlot < 1
		or rawSlot > 4
	then
		return nil, "BAD_REQUEST"
	end
	local id = progress.loadout[rawSlot :: number]
	if id == nil or id == "" then
		return nil, "NO_ABILITY"
	end
	local ability = Abilities.byId[id]
	if ability == nil or table.find(PathProgress.unlocked(progress), id) == nil then
		return nil, "NOT_UNLOCKED"
	end
	-- Written so NaN fails safe: only a clearly elapsed time passes.
	local readyAt = state.cooldowns[id] or -math.huge
	if not (now >= readyAt) or not (now - state.lastCast >= Casting.GLOBAL_GAP) then
		return nil, "ON_COOLDOWN"
	end
	if rooted and ability.kind == "dash" then
		return nil, "ROOTED"
	end
	return id, "OK"
end

function Casting.commit(state: CastState, abilityId: string, now: number): CastState
	local cooldowns = table.clone(state.cooldowns)
	local ability = Abilities.byId[abilityId]
	if ability ~= nil then
		cooldowns[abilityId] = now + ability.cooldown
	end
	return { cooldowns = cooldowns, lastCast = now }
end

local function fighterById(others: { Fighter }, id: number): Fighter?
	for _, other in others do
		if other.id == id then
			return other
		end
	end
	return nil
end

local function emptyPlan(): Plan
	return { hits = {}, waves = 1, interval = 0 }
end

local function planMelee(
	ability: Ability,
	caster: Fighter,
	others: { Fighter },
	taunter: number?
): Plan
	local plan = emptyPlan()
	plan.waves = ability.hits or 1
	plan.interval = ability.interval or 0
	local targetId = Combat.pickTarget(caster, others, ability.range, taunter)
	if targetId == nil then
		return plan
	end
	local target = fighterById(others, targetId)
	local damage = ability.damage or 0
	if
		target ~= nil
		and target.health ~= nil
		and ability.executeBelow ~= nil
		and ability.executeDamage ~= nil
		and target.health <= ability.executeBelow
	then
		damage = ability.executeDamage
	end
	table.insert(plan.hits, { targetId = targetId, damage = damage })
	if target ~= nil and ability.knockback ~= nil then
		local lx, lz = caster.look.x, caster.look.z
		local length = math.sqrt(lx * lx + lz * lz)
		if length > 0 and length < math.huge then
			plan.knockbackTo = {
				x = target.position.x + lx / length * ability.knockback,
				y = target.position.y,
				z = target.position.z + lz / length * ability.knockback,
			}
		end
	end
	return plan
end

local function planShot(
	ability: Ability,
	caster: Fighter,
	others: { Fighter },
	taunter: number?
): Plan
	local plan = emptyPlan()
	local shots = ability.shots or 1
	local spread = ability.spread or 0
	for i = 1, shots do
		local angle = 0
		if shots > 1 then
			angle = -spread / 2 + spread * (i - 1) / (shots - 1)
		end
		local targetId = Targeting.shot(caster, others, ability.range or 0, angle, taunter)
		if targetId ~= nil then
			table.insert(plan.hits, { targetId = targetId, damage = ability.damage or 0 })
		end
	end
	if ability.pull ~= nil then
		plan.pullTo = Targeting.ahead(caster, ability.pull)
	end
	return plan
end

function Casting.plan(
	ability: Ability,
	caster: Fighter,
	others: { Fighter },
	taunter: number?
): Plan
	local kind = ability.kind
	if kind == "melee" then
		return planMelee(ability, caster, others, taunter)
	elseif kind == "shot" then
		return planShot(ability, caster, others, taunter)
	end
	local plan = emptyPlan()
	if kind == "dash" then
		local distance = ability.distance or 0
		plan.moveTo = Targeting.ahead(caster, distance)
		local targetId = Targeting.dashHit(caster, others, distance)
		if targetId ~= nil then
			table.insert(plan.hits, { targetId = targetId, damage = ability.damage or 0 })
		end
	elseif kind == "zone" and ability.zone ~= nil then
		local z = ability.zone
		plan.zone = {
			center = Targeting.ahead(caster, z.ahead),
			radius = z.radius,
			duration = z.duration,
			dps = z.dps,
			slow = z.slow,
		}
	elseif kind == "burst" then
		for _, id in Targeting.inRadius(caster.position, others, ability.radius or 0, caster.id) do
			table.insert(plan.hits, { targetId = id, damage = ability.damage or 0 })
		end
	end
	return plan
end

return Casting
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">ClaimView</string>
            <string name="Source"><![CDATA[--!strict
local BlindClaim = require("./BlindClaim")
local Relics = require("../Catalog/Relics")
local Types = require("../Types")

type Tier = Types.Tier

export type SlotView = {
	slot: number,
	label: string,
	name: string,
	tier: Tier,
	state: "open" | "taken" | "miss" | "locked",
}
export type View = {
	title: string,
	picksText: string,
	secondsLeft: number,
	open: boolean,
	slots: { SlotView },
}

local ClaimView = {}

-- Turns a claim into display data. Pure: slot contents stay hidden, only outcomes show.
function ClaimView.build(victimName: string, claim: BlindClaim.Claim, now: number): View
	local open = BlindClaim.isOpen(claim, now)
	local slots: { SlotView } = {}
	for _, relic in Relics.list do
		local outcome = claim.picked[tostring(relic.slot)]
		local state: "open" | "taken" | "miss" | "locked"
		if outcome == "TAKEN" then
			state = "taken"
		elseif outcome == "MISS" then
			state = "miss"
		elseif
			not open
			or (claim.taken[relic.tier] or 0) >= (BlindClaim.TIER_LIMIT[relic.tier] or 0)
		then
			state = "locked"
		else
			state = "open"
		end
		table.insert(slots, {
			slot = relic.slot,
			label = string.format("%03d", relic.slot),
			name = relic.name,
			tier = relic.tier,
			state = state,
		})
	end
	return {
		title = `Claim on {victimName}`,
		picksText = `Picks left: {claim.picksLeft}`,
		secondsLeft = math.max(0, math.ceil(claim.expiresAt - now)),
		open = open,
		slots = slots,
	}
end

return ClaimView
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">Combat</string>
            <string name="Source"><![CDATA[--!strict
local Types = require("../Types")

type Vec3 = Types.Vec3

export type Fighter = { id: number, position: Vec3, look: Vec3, health: number? }
-- key: tostring(victim id)
export type HitLog = { [string]: { attackerId: number, at: number } }

local Combat = {}

Combat.MAX_HEALTH = 100
Combat.STRIKE_DAMAGE = 20
Combat.STRIKE_COOLDOWN = 0.8
Combat.STRIKE_RANGE = 8
Combat.STRIKE_MIN_DOT = 0.5 -- target must be within 60 degrees of straight ahead
Combat.STRIKE_MAX_HEIGHT = 6 -- maximum vertical gap
Combat.KILL_CREDIT_SECONDS = 15
Combat.COMBAT_LOG_SECONDS = 30

function Combat.canStrike(lastStrikeAt: number?, now: number): boolean
	return lastStrikeAt == nil or now - lastStrikeAt >= Combat.STRIKE_COOLDOWN
end

-- Distance and direction ignore the y axis. Returns the id of the nearest fighter in reach and arc.
-- range defaults to STRIKE_RANGE. A taunter that passes every check wins over a nearer fighter.
function Combat.pickTarget(
	attacker: Fighter,
	others: { Fighter },
	range: number?,
	taunter: number?
): number?
	local lookLength =
		math.sqrt(attacker.look.x * attacker.look.x + attacker.look.z * attacker.look.z)
	if not (lookLength > 0 and lookLength < math.huge) then
		return nil
	end
	local lookX = attacker.look.x / lookLength
	local lookZ = attacker.look.z / lookLength

	local reach = range or Combat.STRIKE_RANGE
	local bestId: number? = nil
	local bestDistance = math.huge
	for _, other in others do
		if other.id == attacker.id then
			continue
		end
		if not (math.abs(other.position.y - attacker.position.y) <= Combat.STRIKE_MAX_HEIGHT) then
			continue
		end
		local dx = other.position.x - attacker.position.x
		local dz = other.position.z - attacker.position.z
		local distance = math.sqrt(dx * dx + dz * dz)
		if not (distance <= reach) then
			continue
		end
		-- Standing on the attacker counts as in the arc.
		if not (distance == 0 or (dx * lookX + dz * lookZ) / distance >= Combat.STRIKE_MIN_DOT) then
			continue
		end
		if taunter ~= nil and other.id == taunter then
			return other.id
		end
		if distance < bestDistance then
			bestDistance = distance
			bestId = other.id
		end
	end
	return bestId
end

function Combat.recordHit(log: HitLog, victimId: number, attackerId: number, now: number): HitLog
	local newLog = table.clone(log)
	newLog[tostring(victimId)] = { attackerId = attackerId, at = now }
	return newLog
end

-- Who gets the defeat: the last player to hit the victim within the window. With
-- `creatureLog` (creature hits on players), a creature hit within the window that is at
-- least as recent as the player's makes it a creature defeat: nobody gets it. A hitter in
-- `allies` (the victim's party) never gets it.
function Combat.creditFor(
	log: HitLog,
	victimId: number,
	now: number,
	windowSeconds: number,
	creatureLog: HitLog?,
	allies: { number }?
): number?
	local entry = log[tostring(victimId)]
	if entry == nil or not (now - entry.at <= windowSeconds) then
		return nil
	end
	if creatureLog ~= nil then
		local bite = creatureLog[tostring(victimId)]
		if bite ~= nil and now - bite.at <= windowSeconds and bite.at >= entry.at then
			return nil
		end
	end
	if allies ~= nil and table.find(allies, entry.attackerId) ~= nil then
		return nil
	end
	return entry.attackerId
end

function Combat.clear(log: HitLog, victimId: number): HitLog
	local newLog = table.clone(log)
	newLog[tostring(victimId)] = nil
	return newLog
end

return Combat
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">CreatureBrain</string>
            <string name="Source"><![CDATA[--!strict
-- What a creature does each tick: wander near its den, chase a player, attack, or walk home.
-- Pure: the server passes in what the creature can see and applies the decision.
local Combat = require("./Combat")
local Geography = require("./Geography")
local Types = require("../Types")
local World = require("../Catalog/World")

type Vec3 = Types.Vec3
type CreatureKind = Types.CreatureKind

export type Brain = {
	mode: "wander" | "chase" | "return",
	targetId: number,
	nextAttackAt: number,
	nextLungeAt: number,
	nextWanderAt: number,
	wanderTo: Vec3?,
}
-- valid: alive, outside the safe zone, no respawn shield (the server decides).
-- visible: clear line of sight from the creature.
export type Seen = { id: number, position: Vec3, visible: boolean, valid: boolean }
export type Body = { position: Vec3, den: Vec3, rooted: boolean }
export type Action = { kind: "attack" | "lunge", targetId: number }
export type Decision = {
	brain: Brain,
	moveTo: Vec3?,
	faceTo: Vec3?,
	action: Action?,
	home: boolean,
}

local CreatureBrain = {}

CreatureBrain.TICK_SECONDS = 0.1
CreatureBrain.WANDER_RADIUS = 12
CreatureBrain.LEASH = 60
CreatureBrain.HOME_RADIUS = 3
CreatureBrain.TOWN_MARGIN = 4
CreatureBrain.STOP_FRACTION = 0.6

local WANDER_MIN_SECONDS = 3
local WANDER_EXTRA_SECONDS = 3
-- How far ahead of its feet a creature checks for land before it steps.
local LOOK_AHEAD = 6

local function flat(a: Vec3, b: Vec3): number
	local dx, dz = a.x - b.x, a.z - b.z
	return math.sqrt(dx * dx + dz * dz)
end

function CreatureBrain.new(): Brain
	return { mode = "wander", targetId = 0, nextAttackAt = 0, nextLungeAt = 0, nextWanderAt = 0 }
end

-- A point inside Tallyport or its margin is pushed out along its bearing from the centre
-- (+x for the centre itself). Height is kept.
function CreatureBrain.outsideTown(point: Vec3): Vec3
	local limit = World.townRadius + CreatureBrain.TOWN_MARGIN
	local distance = math.sqrt(point.x * point.x + point.z * point.z)
	-- Written positively so a NaN point is pushed out too.
	if distance >= limit then
		return point
	end
	if not (distance > 0) then
		return { x = limit, y = point.y, z = 0 }
	end
	return { x = point.x / distance * limit, y = point.y, z = point.z / distance * limit }
end

-- The one entry of `seen` with this id that is a target: valid and within the leash of the den.
local function targetOf(seen: { Seen }, id: number?, den: Vec3): Seen?
	if id == nil then
		return nil
	end
	for _, other in seen do
		if other.id == id then
			if other.valid and flat(other.position, den) <= CreatureBrain.LEASH then
				return other
			end
			return nil
		end
	end
	return nil
end

-- The step towards `goal`, or nil when it would leave the land (a Sluice or the sea) or the
-- creature is already there. Every step ends outside Tallyport.
local function step(from: Vec3, goal: Vec3?): Vec3?
	if goal == nil then
		return nil
	end
	local to = CreatureBrain.outsideTown(goal)
	local distance = flat(from, to)
	if distance > 0 then
		local reach = math.min(distance, LOOK_AHEAD)
		local x = from.x + (to.x - from.x) / distance * reach
		local z = from.z + (to.z - from.z) / distance * reach
		if not Geography.isLand(x, z) then
			return nil
		end
	end
	return to
end

function CreatureBrain.tick(
	kind: CreatureKind,
	brain: Brain,
	body: Body,
	seen: { Seen },
	taunter: number?,
	provoker: number?,
	now: number,
	rng: () -> number
): Decision
	local next: Brain = table.clone(brain)
	local position, den = body.position, body.den

	if next.mode == "return" then
		if flat(position, den) <= CreatureBrain.HOME_RADIUS then
			next.mode = "wander"
			next.targetId = 0
			next.nextWanderAt = now
			next.wanderTo = nil
			return { brain = next, moveTo = nil, faceTo = nil, action = nil, home = true }
		end
		return {
			brain = next,
			moveTo = step(position, den),
			faceTo = nil,
			action = nil,
			home = false,
		}
	end

	local target: Seen? = nil
	if next.mode == "chase" then
		target = targetOf(seen, next.targetId, den)
		if target == nil then
			next.mode = "return"
			next.targetId = 0
			next.wanderTo = nil
			return {
				brain = next,
				moveTo = step(position, den),
				faceTo = nil,
				action = nil,
				home = false,
			}
		end
		-- Only a taunt pulls a chasing creature off its target; a hit from someone else does not.
		local forced = targetOf(seen, taunter, den)
		if forced ~= nil then
			target = forced
		end
	else
		target = targetOf(seen, taunter, den) or targetOf(seen, provoker, den)
		if target == nil then
			local best = math.huge
			for _, other in seen do
				if
					other.valid
					and other.visible
					and flat(other.position, den) <= CreatureBrain.LEASH
				then
					local distance = flat(other.position, position)
					if distance <= kind.sight and distance < best then
						best = distance
						target = other
					end
				end
			end
		end
		if target == nil then
			if now >= next.nextWanderAt then
				local angle = rng() * 2 * math.pi
				local radius = rng() * CreatureBrain.WANDER_RADIUS
				next.wanderTo = {
					x = den.x + math.cos(angle) * radius,
					y = den.y,
					z = den.z + math.sin(angle) * radius,
				}
				next.nextWanderAt = now + WANDER_MIN_SECONDS + rng() * WANDER_EXTRA_SECONDS
			end
			return {
				brain = next,
				moveTo = step(position, next.wanderTo),
				faceTo = nil,
				action = nil,
				home = false,
			}
		end
		next.mode = "chase"
		next.wanderTo = nil
	end

	local chased = target :: Seen
	next.targetId = chased.id
	local goal = chased.position
	local distance = flat(position, goal)
	local attack = kind.attack

	local moveTo: Vec3? = nil
	local keepAway = kind.keepAway
	if keepAway ~= nil and distance < keepAway then
		-- Back off to keepAway from the target, on the line through the creature.
		local dx, dz = position.x - goal.x, position.z - goal.z
		if not (distance > 0) then
			dx, dz, distance = 1, 0, 1
		end
		moveTo = {
			x = goal.x + dx / distance * keepAway,
			y = position.y,
			z = goal.z + dz / distance * keepAway,
		}
		distance = flat(position, goal)
	elseif keepAway ~= nil and distance <= attack.range then
		moveTo = nil
	elseif distance > attack.range * CreatureBrain.STOP_FRACTION then
		moveTo = goal
	end

	local action: Action? = nil
	local lunge = kind.lunge
	if
		distance <= attack.range
		and math.abs(goal.y - position.y) <= Combat.STRIKE_MAX_HEIGHT
		and now >= next.nextAttackAt
	then
		action = { kind = "attack", targetId = chased.id }
		next.nextAttackAt = now + attack.interval
	elseif
		lunge ~= nil
		and not body.rooted
		and now >= next.nextLungeAt
		and distance > attack.range
		and distance <= lunge.distance
	then
		action = { kind = "lunge", targetId = chased.id }
		next.nextLungeAt = now + lunge.interval
	end

	return {
		brain = next,
		moveTo = step(position, moveTo),
		faceTo = goal,
		action = action,
		home = false,
	}
end

return CreatureBrain
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">Crown</string>
            <string name="Source"><![CDATA[--!strict
-- The Crown (spec 3.15): one per run for a complete Ledger, the saved record, the title and
-- the lines shown for it. Pure. Every check is written so that NaN refuses.
local Ledger = require("./Ledger")
local Types = require("../Types")

type CrownRecord = Types.CrownRecord
type Ledger = Types.Ledger

local Crown = {}

Crown.MAX = 1000000
Crown.MAX_GEMS = 6
Crown.RENOUNCE_HINT = "You may Renounce at the Tally Stone in Tallyport."

local function isWhole(n: any): boolean
	return type(n) == "number" and n > -math.huge and n < math.huge and n == math.floor(n)
end

function Crown.newRecord(): CrownRecord
	return { crowns = 0, stars = 0, boardCrowns = 0, badgeAwarded = false }
end

-- Turns arbitrary saved data into a valid record. Never errors. A damaged star count reads
-- as "Crowned this run" (crowns - 1) so a bad save can never hand out a free Crown.
function Crown.sanitize(raw: any): CrownRecord
	if type(raw) ~= "table" then
		return Crown.newRecord()
	end
	local crowns = 0
	if isWhole(raw.crowns) and raw.crowns >= 0 and raw.crowns <= Crown.MAX then
		crowns = raw.crowns
	end
	local low = math.max(0, crowns - 1)
	local stars = low
	if isWhole(raw.stars) then
		stars = math.clamp(raw.stars, low, crowns)
	end
	local boardCrowns = 0
	if isWhole(raw.boardCrowns) then
		boardCrowns = math.clamp(raw.boardCrowns, 0, crowns)
	end
	return {
		crowns = crowns,
		stars = stars,
		boardCrowns = boardCrowns,
		badgeAwarded = raw.badgeAwarded == true,
	}
end

function Crown.crownedThisRun(record: CrownRecord): boolean
	return record.crowns > record.stars
end

function Crown.canCrown(record: CrownRecord, ledger: Ledger): boolean
	return Ledger.isComplete(ledger) and record.crowns == record.stars and record.crowns < Crown.MAX
end

-- Adds the Crown only when canCrown holds; otherwise an unchanged copy.
function Crown.crown(record: CrownRecord, ledger: Ledger): CrownRecord
	local out = table.clone(record)
	if Crown.canCrown(record, ledger) then
		out.crowns = record.crowns + 1
	end
	return out
end

function Crown.title(crowns: any, stars: any): string
	if not isWhole(crowns) or crowns < 1 or crowns > Crown.MAX then
		return ""
	end
	local text = "Crowned"
	if crowns == 2 then
		text = "Crowned twice"
	elseif crowns > 2 then
		text = `Crowned {crowns} times`
	end
	if isWhole(stars) and stars >= 1 then
		text ..= ` ★{math.min(stars, crowns)}`
	end
	return text
end

function Crown.bookLine(crowns: any, stars: any, complete: boolean): string
	local title = Crown.title(crowns, stars)
	if title ~= "" and complete and isWhole(stars) and crowns > stars then
		return title .. ". " .. Crown.RENOUNCE_HINT
	end
	return title
end

function Crown.ceremonyLines(name: string, crowns: any): { string }
	local first = `{name} is Crowned!`
	if isWhole(crowns) and crowns >= 2 then
		first = `{name} is Crowned again: {crowns} Crowns!`
	end
	return { first, "Every Relic of the Ledger is claimed." }
end

function Crown.gems(stars: any): number
	if isWhole(stars) then
		return math.clamp(stars, 0, Crown.MAX_GEMS)
	end
	return 0
end

function Crown.wantsBadge(record: CrownRecord, badgeId: any): boolean
	return isWhole(badgeId) and badgeId >= 1 and record.crowns >= 1 and not record.badgeAwarded
end

return Crown
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">EdictRules</string>
            <string name="Source"><![CDATA[--!strict
-- The rules of the five Edicts (spec 3.13): checking a "use" request, who a Summons lists,
-- who an Audit looks at and what it shows, the Veil, where a Passage arrives, when travel is
-- refused, and what a defeat destroys. Pure: the server gathers the facts and applies results.
local Cards = require("../Catalog/Cards")
local Edicts = require("../Catalog/Edicts")
local Ledger = require("./Ledger")
local Relics = require("../Catalog/Relics")
local Types = require("../Types")

type Ledger = Types.Ledger
type Vec3 = Types.Vec3

export type Use = {
	freeIndex: number,
	cardId: string,
	key: string,
	relicId: string?,
	targetId: number?,
}
export type DealState = { marked: boolean, lastFightAt: number? }
export type TravelState = { marked: boolean, inTrial: boolean, lastFightAt: number? }
export type Person = { userId: number, name: string, ledger: Ledger, veiled: boolean }
export type Body = { userId: number, position: Vec3 }
-- What the result window shows.
export type Result = { title: string, lines: { string } }

local MAX_CARD_ID_LENGTH = 16
local RING_SPOTS = 8

local EdictRules = {}

EdictRules.VEIL_SECONDS = 600
EdictRules.AUDIT_RANGE = 20
EdictRules.MEET_RANGE = 30
EdictRules.PASSAGE_DISTANCE = 8
EdictRules.COMBAT_SECONDS = 30

local function isWhole(n: any): boolean
	return type(n) == "number" and n > -math.huge and n < math.huge and n == math.floor(n)
end

-- Checks a raw client request to use the Edict on one free-slot row. The request carries
-- the card the player saw there; if the row has shifted (a double click) it is BAD_INDEX.
-- Summons must name a Relic and Passage a player; anything an Edict does not need is dropped.
-- Success: the request, "OK". Never errors on hostile input.
function EdictRules.parseUse(ledger: Ledger?, raw: any): (Use?, string)
	if ledger == nil then
		return nil, "DATA_NOT_LOADED"
	end
	if type(raw) ~= "table" then
		return nil, "BAD_REQUEST"
	end
	local freeIndex, cardId = raw.freeIndex, raw.cardId
	if type(freeIndex) ~= "number" then
		return nil, "BAD_REQUEST"
	end
	if type(cardId) ~= "string" or #cardId > MAX_CARD_ID_LENGTH then
		return nil, "BAD_REQUEST"
	end
	if not isWhole(freeIndex) or ledger.free[freeIndex] ~= cardId then
		return nil, "BAD_INDEX"
	end
	local edict = Edicts.byId[cardId]
	if edict == nil then
		return nil, "BAD_REQUEST"
	end
	local use: Use = { freeIndex = freeIndex, cardId = cardId, key = edict.key }
	if edict.needs == "relic" then
		if not Cards.isRelic(raw.relicId) then
			return nil, "BAD_REQUEST"
		end
		use.relicId = raw.relicId
	elseif edict.needs == "player" then
		if not isWhole(raw.targetId) then
			return nil, "BAD_REQUEST"
		end
		use.targetId = raw.targetId
	end
	return use, "OK"
end

-- Dealing (trades, sales to the clerk): refused while Marked and within 30 seconds of dealing
-- or taking player damage, so cards cannot leave reach of a blind claim mid-fight. A clock
-- that is not a number counts as "in combat".
function EdictRules.canDeal(state: DealState, now: number): (boolean, string?)
	if state.marked then
		return false, "EDICT_MARKED"
	end
	local lastFightAt = state.lastFightAt
	if lastFightAt ~= nil and not (now - lastFightAt >= EdictRules.COMBAT_SECONDS) then
		return false, "EDICT_IN_COMBAT"
	end
	return true, nil
end

-- Passage and Homecoming: the same refusals as dealing, plus during a trial.
function EdictRules.canTravel(state: TravelState, now: number): (boolean, string?)
	local ok, code = EdictRules.canDeal(state, now)
	if not ok then
		return false, code
	end
	if state.inTrial then
		return false, "EDICT_IN_TRIAL"
	end
	return true, nil
end

-- Names of the other players who hold the Relic, claimed or spare, in name order. Veiled
-- players are left out.
function EdictRules.holders(people: { Person }, relicId: string, askerId: number): { string }
	local names: { string } = {}
	for _, person in people do
		if
			person.userId ~= askerId
			and not person.veiled
			and Ledger.count(person.ledger, relicId) > 0
		then
			table.insert(names, person.name)
		end
	end
	table.sort(names)
	return names
end

function EdictRules.summonsResult(relicId: string, names: { string }): Result
	local lines: { string } = {}
	if #names == 0 then
		-- Says nothing about whether anyone is veiled.
		table.insert(lines, "Nobody else here holds it, or they are veiled.")
	else
		table.insert(lines, "Held on this server by:")
		for _, name in names do
			table.insert(lines, name)
		end
	end
	return { title = "Summons: " .. Cards.name(relicId), lines = lines }
end

local function distance(a: Vec3, b: Vec3): number
	return math.sqrt((a.x - b.x) ^ 2 + (a.y - b.y) ^ 2 + (a.z - b.z) ^ 2)
end

-- True when the two points are within `range` of each other. A NaN position is not near.
function EdictRules.near(a: Vec3, b: Vec3, range: number): boolean
	return distance(a, b) <= range
end

-- The nearest other player within the Audit's range, or nil. Ties go to the lower id.
function EdictRules.auditTarget(asker: Body, others: { Body }): number?
	local bestId: number? = nil
	local best = math.huge
	for _, other in others do
		if other.userId == asker.userId then
			continue
		end
		local gap = distance(asker.position, other.position)
		if not (gap <= EdictRules.AUDIT_RANGE) then
			continue
		end
		if gap < best or (gap == best and bestId ~= nil and other.userId < bestId) then
			best = gap
			bestId = other.userId
		end
	end
	return bestId
end

-- What an Audit shows: claimed Relics in slot order (and which are Vaulted), then the
-- free-slot cards in the order first held, with a count when there are several.
function EdictRules.auditResult(name: string, ledger: Ledger, vault: Types.Vault): Result
	local lines: { string } = {}
	table.insert(lines, `Claimed: {Ledger.claimedCount(ledger)} of {Relics.count}`)
	for _, relic in Relics.list do
		if ledger.claimed[relic.id] then
			local line = string.format("%03d %s (%s)", relic.slot, relic.name, relic.tier)
			if vault[relic.id] then
				line ..= ", Vaulted"
			end
			table.insert(lines, line)
		end
	end
	table.insert(lines, `Free slots: {#ledger.free} of {Ledger.FREE_SLOTS}`)
	local counts: { [string]: number } = {}
	local order: { string } = {}
	for _, id in ledger.free do
		if counts[id] == nil then
			table.insert(order, id)
		end
		counts[id] = (counts[id] or 0) + 1
	end
	for _, id in order do
		local cardName = Cards.name(id)
		table.insert(lines, if counts[id] > 1 then `{cardName} x{counts[id]}` else cardName)
	end
	return { title = "Audit: " .. name, lines = lines }
end

function EdictRules.veiledResult(name: string): Result
	return { title = "Audit: " .. name, lines = { "Their Ledger is veiled." } }
end

-- Written so a NaN time or a NaN end both read as "not veiled".
function EdictRules.isVeiled(veilUntil: number?, now: number): boolean
	return veilUntil ~= nil and now < veilUntil
end

-- Seconds of Veil left, 0 when none.
function EdictRules.veilSeconds(veilUntil: number?, now: number): number
	if veilUntil == nil or not (now < veilUntil) then
		return 0
	end
	return veilUntil - now
end

-- Where a Passage sets the traveller down: the first of eight spots on a ring around the
-- target (starting at +x) for which `isClear(x, z)` is true, at the target's height. With no
-- clear spot, the target's own position.
function EdictRules.arrival(target: Vec3, isClear: (x: number, z: number) -> boolean): Vec3
	for i = 0, RING_SPOTS - 1 do
		local angle = i / RING_SPOTS * 2 * math.pi
		local x = target.x + math.cos(angle) * EdictRules.PASSAGE_DISTANCE
		local z = target.z + math.sin(angle) * EdictRules.PASSAGE_DISTANCE
		if isClear(x, z) then
			return { x = x, y = target.y, z = z }
		end
	end
	return target
end

-- A defeat destroys one third of the Edicts held, rounded down, picked at random (one roll
-- per card lost). Relics are never touched. Returns the new Ledger and the lost cards.
function EdictRules.defeatLoss(ledger: Ledger, rng: () -> number): (Ledger, { string })
	local free = table.clone(ledger.free)
	local lost: { string } = {}
	for _ = 1, Ledger.edictCount(ledger) // 3 do
		local positions: { number } = {}
		for index, id in free do
			if Cards.isEdict(id) then
				table.insert(positions, index)
			end
		end
		if #positions == 0 then
			break
		end
		local roll = rng()
		-- A roll outside 0..1, or one that is not a number, still picks a card.
		if not (roll >= 0) then
			roll = 0
		end
		local pick = math.clamp(math.floor(roll * #positions) + 1, 1, #positions)
		table.insert(lost, table.remove(free, positions[pick]) :: string)
	end
	return { claimed = table.clone(ledger.claimed), free = free }, lost
end

return EdictRules
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">Effects</string>
            <string name="Source"><![CDATA[--!strict
-- Pure status-effect rules. Every "until" is exclusive: active while now < until.
-- Comparisons are written so a NaN time reads as "not active" and never grants anything.
local Types = require("../Types")

export type Status = {
	immuneUntil: number,
	reduceUntil: number,
	reduceFactor: number,
	shield: number,
	shieldUntil: number,
	reflectUntil: number,
	reflectFactor: number,
	slowUntil: number,
	slowFactor: number,
	rootUntil: number,
	burnUntil: number,
	burnDps: number,
	burnBy: number,
	tauntUntil: number,
	tauntBy: number,
	empowerUntil: number,
	empowerBonus: number,
}

local Effects = {}

function Effects.new(): Status
	return {
		immuneUntil = 0,
		reduceUntil = 0,
		reduceFactor = 1,
		shield = 0,
		shieldUntil = 0,
		reflectUntil = 0,
		reflectFactor = 1,
		slowUntil = 0,
		slowFactor = 1,
		rootUntil = 0,
		burnUntil = 0,
		burnDps = 0,
		burnBy = 0,
		tauntUntil = 0,
		tauntBy = 0,
		empowerUntil = 0,
		empowerBonus = 0,
	}
end

function Effects.isImmune(s: Status, now: number): boolean
	return now < s.immuneUntil
end

function Effects.resolveDamage(s: Status, amount: number, now: number): (Status, number, number)
	-- Written positively so NaN, zero, negative and infinite amounts all fall out as no damage.
	if not (amount > 0 and amount < math.huge) then
		return s, 0, 0
	end
	if now < s.immuneUntil then
		return s, 0, 0
	end
	local after = amount
	if now < s.reduceUntil then
		after = amount * s.reduceFactor
	end
	local reflected = 0
	if now < s.reflectUntil then
		reflected = after * s.reflectFactor
	end
	local health = after
	local out = s
	if now < s.shieldUntil and s.shield > 0 then
		local absorbed = math.min(after, s.shield)
		health = after - absorbed
		out = table.clone(s)
		out.shield = s.shield - absorbed
	end
	-- A NaN factor would poison the result; fail to zero rather than to extra damage.
	if not (health >= 0) then
		health = 0
	end
	if not (reflected >= 0) then
		reflected = 0
	end
	return out, health, reflected
end

function Effects.applyImmune(s: Status, duration: number, now: number): Status
	local out = table.clone(s)
	out.immuneUntil = now + duration
	return out
end

function Effects.applyReduction(s: Status, factor: number, duration: number, now: number): Status
	local out = table.clone(s)
	out.reduceFactor = factor
	out.reduceUntil = now + duration
	return out
end

-- Replaces any current shield.
function Effects.applyShield(s: Status, amount: number, duration: number, now: number): Status
	local out = table.clone(s)
	out.shield = amount
	out.shieldUntil = now + duration
	return out
end

function Effects.applyReflect(s: Status, factor: number, duration: number, now: number): Status
	local out = table.clone(s)
	out.reflectFactor = factor
	out.reflectUntil = now + duration
	return out
end

-- Strongest (lowest factor) slow wins. An equal or stronger one replaces and refreshes;
-- a weaker one neither replaces nor extends the active slow.
function Effects.applySlow(s: Status, factor: number, duration: number, now: number): Status
	local out = table.clone(s)
	-- A NaN factor is rejected (it would otherwise read as stronger than anything).
	if not (factor >= 0) then
		return out
	end
	if now < s.slowUntil and not (factor <= s.slowFactor) then
		return out
	end
	out.slowFactor = factor
	out.slowUntil = now + duration
	return out
end

-- The slow the ground puts on a player standing in it (bog, briars), refreshed tick after tick.
-- An immune player is not slowed. A slow already in effect that is at least as strong and lasts at
-- least as long is left alone, so the ground never cuts an ability's slow short.
function Effects.applyAmbientSlow(s: Status, factor: number, duration: number, now: number): Status
	if Effects.isImmune(s, now) then
		return s
	end
	if now < s.slowUntil and s.slowFactor <= factor and s.slowUntil >= now + duration then
		return s
	end
	return Effects.applySlow(s, factor, duration, now)
end

function Effects.applyRoot(s: Status, duration: number, now: number): Status
	local out = table.clone(s)
	out.rootUntil = now + duration
	return out
end

function Effects.applyBurn(
	s: Status,
	dps: number,
	duration: number,
	byId: number,
	now: number
): Status
	local out = table.clone(s)
	out.burnDps = dps
	out.burnBy = byId
	out.burnUntil = now + duration
	return out
end

function Effects.applyTaunt(s: Status, byId: number, duration: number, now: number): Status
	local out = table.clone(s)
	out.tauntBy = byId
	out.tauntUntil = now + duration
	return out
end

function Effects.applyEmpower(s: Status, bonus: number, duration: number, now: number): Status
	local out = table.clone(s)
	out.empowerBonus = bonus
	out.empowerUntil = now + duration
	return out
end

-- Clears slow, root and burn.
function Effects.cleanse(s: Status): Status
	local out = table.clone(s)
	out.slowUntil = 0
	out.slowFactor = 1
	out.rootUntil = 0
	out.burnUntil = 0
	out.burnDps = 0
	out.burnBy = 0
	return out
end

function Effects.isRooted(s: Status, now: number): boolean
	return now < s.rootUntil
end

function Effects.speedFactor(s: Status, now: number): number
	if now < s.rootUntil then
		return 0
	end
	if now < s.slowUntil then
		return s.slowFactor
	end
	return 1
end

function Effects.burnTick(s: Status, now: number): (number, number)
	if now < s.burnUntil then
		return s.burnDps, s.burnBy
	end
	return 0, 0
end

function Effects.tauntedBy(s: Status, now: number): number?
	if now < s.tauntUntil then
		return s.tauntBy
	end
	return nil
end

-- The statuses an ability's landed hit leaves on its target, from the fighter `byId`: burn,
-- root, slow and taunt, in that order. An ability with none of them returns `s` unchanged.
function Effects.applyHit(s: Status, ability: Types.Ability, byId: number, now: number): Status
	local out = s
	local burn, rootFor, slow, taunt = ability.burn, ability.root, ability.slow, ability.taunt
	if burn ~= nil then
		out = Effects.applyBurn(out, burn.dps, burn.duration, byId, now)
	end
	if rootFor ~= nil then
		out = Effects.applyRoot(out, rootFor, now)
	end
	if slow ~= nil then
		out = Effects.applySlow(out, slow.factor, slow.duration, now)
	end
	if taunt ~= nil then
		out = Effects.applyTaunt(out, byId, taunt, now)
	end
	return out
end

-- Returns the bonus while active and consumes it.
function Effects.takeEmpower(s: Status, now: number): (Status, number)
	if now < s.empowerUntil then
		local out = table.clone(s)
		out.empowerUntil = 0
		out.empowerBonus = 0
		return out, s.empowerBonus
	end
	return s, 0
end

return Effects
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">Geography</string>
            <string name="Source"><![CDATA[--!strict
local Types = require("../Types")
local Regions = require("../Catalog/Regions")

export type Strip = { z: number, x1: number, x2: number, region: Types.RegionId }
export type Bridge = { x: number, z: number, yaw: number, length: number, width: number }

local Geography = {}

Geography.CELL = 40
Geography.GRID = 34
Geography.TOWN_RADIUS = 40
Geography.FIELDS_RADIUS = 260
Geography.DROWN_Y = -6
Geography.ROCK = { x = 0, z = 1240, radius = 80 }

local CELL = Geography.CELL
local GRID = Geography.GRID
local ROCK = Geography.ROCK
local CAUSEWAY_MIN_Z = 940
local CAUSEWAY_MAX_Z = 1160
local RIVER_BEARINGS = { 30, 150, 270 }
local RIVER_START = 300
local RIVER_HALF_WIDTH = 50
local BRIDGE_ALONG = { 420, 760 }
local BRIDGE_LENGTH = 180
local BRIDGE_WIDTH = 16

local function isFinite(n: number): boolean
	return n > -math.huge and n < math.huge
end

-- Degrees clockwise from north (-Z), in [0, 360). The centre has no direction and reads as 0.
function Geography.bearingOf(x: number, z: number): number
	if x == 0 and z == 0 then
		return 0
	end
	local b = math.deg(math.atan2(x, -z))
	if b < 0 then
		b += 360
		-- A tiny negative angle rounds up to exactly 360.
		if b >= 360 then
			b = 0
		end
	end
	return b
end

function Geography.coastRadius(bearing: number): number
	local t = math.rad(bearing)
	return 960 + 60 * math.sin(3 * t) + 40 * math.sin(5 * t + 1)
end

-- World x, z to a region frame: distance down the bearing, distance to the right of it.
function Geography.toFrame(bearing: number, x: number, z: number): (number, number)
	local t = math.rad(bearing)
	local s, c = math.sin(t), math.cos(t)
	return x * s - z * c, x * c + z * s
end

function Geography.fromFrame(bearing: number, along: number, across: number): (number, number)
	local t = math.rad(bearing)
	local s, c = math.sin(t), math.cos(t)
	return along * s + across * c, -along * c + across * s
end

local function bearingOfRegion(regionId: string): number
	local region = Regions.byId[regionId]
	local bearing = if region then region.bearing else nil
	if bearing == nil then
		error(`Geography: region {regionId} has no bearing`)
	end
	return bearing
end

function Geography.place(regionId: string, along: number, across: number): (number, number)
	return Geography.fromFrame(bearingOfRegion(regionId), along, across)
end

function Geography.cellOf(x: number, z: number): (number, number)
	return math.floor(x / CELL + 0.5), math.floor(z / CELL + 0.5)
end

-- The region owning cell (i, j), judged at the cell centre. Tallyport is not a cell region:
-- its circle is smaller than a cell and regionAt answers for it.
function Geography.cellRegion(i: number, j: number): Types.RegionId
	local x, z = CELL * i, CELL * j
	local rx, rz = x - ROCK.x, z - ROCK.z
	if rx * rx + rz * rz <= ROCK.radius * ROCK.radius then
		return "ReckoningRock"
	end
	if i == 0 and CAUSEWAY_MIN_Z <= z and z <= CAUSEWAY_MAX_Z then
		return "ReckoningRock"
	end
	if math.sqrt(x * x + z * z) <= Geography.FIELDS_RADIUS then
		return "CountingFields"
	end
	return Regions.wild[math.floor((Geography.bearingOf(x, z) + 30) / 60) % 6 + 1]
end

function Geography.cellIsLand(i: number, j: number): boolean
	if math.abs(i) > GRID or math.abs(j) > GRID then
		return false
	end
	if Geography.cellRegion(i, j) == "ReckoningRock" then
		return true
	end
	local x, z = CELL * i, CELL * j
	if math.sqrt(x * x + z * z) > Geography.coastRadius(Geography.bearingOf(x, z)) then
		return false
	end
	for _, bearing in RIVER_BEARINGS do
		local along, across = Geography.toFrame(bearing, x, z)
		if along >= RIVER_START and math.abs(across) < RIVER_HALF_WIDTH then
			return false
		end
	end
	return true
end

-- A position that is not a finite number reads as Counting Fields.
function Geography.regionAt(x: number, z: number): Types.RegionId
	if not (isFinite(x) and isFinite(z)) then
		return "CountingFields"
	end
	if x * x + z * z <= Geography.TOWN_RADIUS * Geography.TOWN_RADIUS then
		return "Tallyport"
	end
	return Geography.cellRegion(Geography.cellOf(x, z))
end

function Geography.isLand(x: number, z: number): boolean
	if not (isFinite(x) and isFinite(z)) then
		return false
	end
	return Geography.cellIsLand(Geography.cellOf(x, z))
end

-- Every land cell exactly once, as horizontal runs of one region: row z = 40j, from x1 to x2.
function Geography.strips(): { Strip }
	local strips: { Strip } = {}
	for j = -GRID, GRID do
		local runStart: number? = nil
		local runRegion: Types.RegionId = "CountingFields"
		-- One cell past the grid is never land, so it closes a run that reaches the edge.
		for i = -GRID, GRID + 1 do
			local region = if Geography.cellIsLand(i, j) then Geography.cellRegion(i, j) else nil
			if runStart ~= nil and region ~= runRegion then
				table.insert(strips, {
					z = CELL * j,
					x1 = CELL * runStart - CELL / 2,
					x2 = CELL * (i - 1) + CELL / 2,
					region = runRegion,
				})
				runStart = nil
			end
			if region ~= nil and runStart == nil then
				runStart = i
				runRegion = region
			end
		end
	end
	return strips
end

-- One bridge over each river at 420 and 760 out, lying across the river.
function Geography.bridges(): { Bridge }
	local bridges: { Bridge } = {}
	for _, bearing in RIVER_BEARINGS do
		for _, along in BRIDGE_ALONG do
			local x, z = Geography.fromFrame(bearing, along, 0)
			table.insert(bridges, {
				x = x,
				z = z,
				yaw = (bearing + 90) % 360,
				length = BRIDGE_LENGTH,
				width = BRIDGE_WIDTH,
			})
		end
	end
	return bridges
end

function Geography.circle(
	regionId: string,
	along: number,
	across: number,
	radius: number
): Types.Shape
	local x, z = Geography.place(regionId, along, across)
	return {
		kind = "circle",
		x = x,
		z = z,
		radius = radius,
		bearing = 0,
		halfAlong = 0,
		halfAcross = 0,
		region = "",
	}
end

function Geography.rect(
	regionId: string,
	a1: number,
	a2: number,
	c1: number,
	c2: number
): Types.Shape
	local x, z = Geography.place(regionId, (a1 + a2) / 2, (c1 + c2) / 2)
	return {
		kind = "rect",
		x = x,
		z = z,
		radius = 0,
		bearing = bearingOfRegion(regionId),
		halfAlong = (a2 - a1) / 2,
		halfAcross = (c2 - c1) / 2,
		region = "",
	}
end

-- Everything of the region at least minRadius from the island centre.
function Geography.regionShape(regionId: string, minRadius: number): Types.Shape
	return {
		kind = "region",
		x = 0,
		z = 0,
		radius = minRadius,
		bearing = 0,
		halfAlong = 0,
		halfAcross = 0,
		region = regionId,
	}
end

return Geography
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">Hazards</string>
            <string name="Source"><![CDATA[--!strict
local Geography = require("./Geography")
local Types = require("../Types")

export type Phase = "idle" | "warn" | "active"
export type Burst = { id: string, damage: number, cycle: number }
export type Sample = {
	dps: number,
	heal: number,
	slow: number, -- smallest speed multiplier in effect; 1 when none
	pushX: number,
	pushZ: number,
	bursts: { Burst },
	names: { string },
}

local Hazards = {}

Hazards.TICK_SECONDS = 0.25
Hazards.SLOW_SECONDS = 1

local function isFinite(n: number): boolean
	return n > -math.huge and n < math.huge
end

-- A point that is not a finite number is inside nothing.
function Hazards.contains(shape: Types.Shape, x: number, z: number): boolean
	if not (isFinite(x) and isFinite(z)) then
		return false
	end
	if shape.kind == "circle" then
		local dx, dz = x - shape.x, z - shape.z
		return dx * dx + dz * dz <= shape.radius * shape.radius
	elseif shape.kind == "rect" then
		local along, across = Geography.toFrame(shape.bearing, x - shape.x, z - shape.z)
		return math.abs(along) <= shape.halfAlong and math.abs(across) <= shape.halfAcross
	elseif shape.kind == "region" then
		return Geography.regionAt(x, z) == shape.region and math.sqrt(x * x + z * z) >= shape.radius
	end
	return false
end

-- Inside the shape and inside none of its holes.
function Hazards.affects(hazard: Types.Hazard, x: number, z: number): boolean
	if not Hazards.contains(hazard.shape, x, z) then
		return false
	end
	if hazard.holes then
		for _, hole in hazard.holes do
			if Hazards.contains(hole, x, z) then
				return false
			end
		end
	end
	return true
end

-- The phase, the cycle index, and the fraction of the current phase already elapsed (0..1).
function Hazards.phase(hazard: Types.Hazard, now: number): (Phase, number, number)
	local cycle = hazard.cycle
	if cycle == nil then
		return "active", 0, 0
	end
	if not isFinite(now) then
		return "idle", 0, 0
	end
	local shifted = now + cycle.offset
	local t = shifted % cycle.period
	local index = math.floor(shifted / cycle.period)
	local idle = cycle.period - cycle.warn - cycle.active
	if t < idle then
		return "idle", index, t / idle
	elseif t < idle + cycle.warn then
		return "warn", index, (t - idle) / cycle.warn
	end
	return "active", index, math.min((t - idle - cycle.warn) / cycle.active, 1)
end

-- The combined effect on a point at time now. Only active hazards that affect the point count.
function Hazards.sample(list: { Types.Hazard }, x: number, z: number, now: number): Sample
	local sample: Sample = {
		dps = 0,
		heal = 0,
		slow = 1,
		pushX = 0,
		pushZ = 0,
		bursts = {},
		names = {},
	}
	for _, hazard in list do
		if Hazards.affects(hazard, x, z) then
			local phase, index = Hazards.phase(hazard, now)
			if phase == "active" then
				sample.dps += hazard.dps or 0
				sample.heal += hazard.heal or 0
				if hazard.slow ~= nil then
					sample.slow = math.min(sample.slow, hazard.slow)
				end
				if hazard.push ~= nil then
					sample.pushX += hazard.push.x
					sample.pushZ += hazard.push.z
				end
				if hazard.damage ~= nil then
					table.insert(
						sample.bursts,
						{ id = hazard.id, damage = hazard.damage, cycle = index }
					)
				end
				if not table.find(sample.names, hazard.name) then
					table.insert(sample.names, hazard.name)
				end
			end
		end
	end
	return sample
end

return Hazards
]]></string>
          </Properties>
