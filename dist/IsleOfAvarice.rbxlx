    <Item class="StarterPlayerScripts" referent="103">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="104">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="105">
          <Properties>
            <string name="Name">AbilityBar</string>
            <string name="Source"><![CDATA[--!strict
-- Bottom-centre ability bar: four slots (keys 1-4), tap or click to cast.
-- The server decides whether a cast works; the cooldown overlay here is display only.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local PathView = require(Shared:WaitForChild("Rules"):WaitForChild("PathView"))

local AbilityBar = {}

local SLOT_COUNT = 4
local TEXT_LIGHT = Color3.fromRGB(245, 235, 210)
local BUTTON_COLOR = Color3.fromRGB(70, 60, 90)
local DIM_COLOR = Color3.fromRGB(45, 42, 52)
local OVERLAY_COLOR = Color3.fromRGB(10, 8, 14)

type Slot = {
	button: TextButton,
	overlay: Frame,
	timeLabel: TextLabel,
	nameLabel: TextLabel,
	endsAt: number,
	total: number,
}

local slots: { [number]: Slot } = {}
local ticking: RBXScriptConnection? = nil

local function addCorner(parent: Instance, radius: number)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius)
	corner.Parent = parent
end

local function limitText(parent: Instance, minSize: number, maxSize: number)
	local constraint = Instance.new("UITextSizeConstraint")
	constraint.MinTextSize = minSize
	constraint.MaxTextSize = maxSize
	constraint.Parent = parent
end

local function tick()
	local now = os.clock()
	local anyActive = false
	for _, slot in slots do
		local remaining = slot.endsAt - now
		if remaining > 0 and slot.total > 0 then
			anyActive = true
			slot.overlay.Visible = true
			slot.overlay.Size = UDim2.fromScale(1, math.min(1, remaining / slot.total))
			slot.timeLabel.Text = tostring(math.ceil(remaining))
		elseif slot.overlay.Visible then
			slot.overlay.Visible = false
			slot.timeLabel.Text = ""
		end
	end
	if not anyActive and ticking ~= nil then
		ticking:Disconnect()
		ticking = nil
	end
end

local function buildSlot(parent: Frame, index: number, onCast: (slot: number) -> ()): Slot
	local button = Instance.new("TextButton")
	button.Name = "Slot" .. index
	button.LayoutOrder = index
	button.Size = UDim2.fromScale(1, 1)
	button.SizeConstraint = Enum.SizeConstraint.RelativeYY
	button.BackgroundColor3 = DIM_COLOR
	button.Text = ""
	addCorner(button, 8)

	local key = Instance.new("TextLabel")
	key.Name = "Key"
	key.BackgroundTransparency = 1
	key.Position = UDim2.fromScale(0.06, 0.04)
	key.Size = UDim2.fromScale(0.3, 0.3)
	key.TextColor3 = TEXT_LIGHT
	key.TextScaled = true
	key.TextXAlignment = Enum.TextXAlignment.Left
	key.Font = Enum.Font.GothamBold
	key.Text = tostring(index)
	limitText(key, 8, 18)
	key.Parent = button

	local nameLabel = Instance.new("TextLabel")
	nameLabel.Name = "AbilityName"
	nameLabel.BackgroundTransparency = 1
	nameLabel.Position = UDim2.fromScale(0.05, 0.32)
	nameLabel.Size = UDim2.fromScale(0.9, 0.62)
	nameLabel.TextColor3 = TEXT_LIGHT
	nameLabel.TextScaled = true
	nameLabel.TextWrapped = true
	nameLabel.Font = Enum.Font.GothamMedium
	nameLabel.Text = "—"
	nameLabel.TextTransparency = 0.6
	limitText(nameLabel, 8, 16)
	nameLabel.Parent = button

	local overlay = Instance.new("Frame")
	overlay.Name = "Cooldown"
	overlay.AnchorPoint = Vector2.new(0, 1)
	overlay.Position = UDim2.fromScale(0, 1)
	overlay.Size = UDim2.fromScale(1, 1)
	overlay.BackgroundColor3 = OVERLAY_COLOR
	overlay.BackgroundTransparency = 0.35
	overlay.BorderSizePixel = 0
	overlay.Visible = false
	addCorner(overlay, 8)
	overlay.Parent = button

	local timeLabel = Instance.new("TextLabel")
	timeLabel.Name = "Seconds"
	timeLabel.AnchorPoint = Vector2.new(0.5, 0.5)
	timeLabel.Position = UDim2.fromScale(0.5, 0.5)
	timeLabel.Size = UDim2.fromScale(0.6, 0.4)
	timeLabel.BackgroundTransparency = 1
	timeLabel.TextColor3 = TEXT_LIGHT
	timeLabel.TextScaled = true
	timeLabel.Font = Enum.Font.GothamBold
	timeLabel.Text = ""
	limitText(timeLabel, 10, 24)
	timeLabel.ZIndex = 3
	timeLabel.Parent = button

	button.Activated:Connect(function()
		onCast(index)
	end)
	button.Parent = parent
	return {
		button = button,
		overlay = overlay,
		timeLabel = timeLabel,
		nameLabel = nameLabel,
		endsAt = 0,
		total = 0,
	}
end

function AbilityBar.mount(playerGui: PlayerGui, onCast: (slot: number) -> ())
	local gui = Instance.new("ScreenGui")
	gui.Name = "AbilityGui"
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 11

	local bar = Instance.new("Frame")
	bar.Name = "Bar"
	bar.AnchorPoint = Vector2.new(0.5, 1)
	bar.Position = UDim2.fromScale(0.5, 0.97)
	bar.Size = UDim2.fromScale(0.34, 0.1)
	bar.BackgroundTransparency = 1
	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Horizontal
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.VerticalAlignment = Enum.VerticalAlignment.Center
	layout.Padding = UDim.new(0, 6)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = bar

	for index = 1, SLOT_COUNT do
		slots[index] = buildSlot(bar, index, onCast)
	end
	bar.Parent = gui
	gui.Parent = playerGui
end

function AbilityBar.render(views: { PathView.SlotView })
	for _, view in views do
		local slot = slots[view.slot]
		if slot ~= nil then
			local empty = view.name == ""
			slot.nameLabel.Text = if empty then "—" else view.name
			slot.button.BackgroundColor3 = if empty then DIM_COLOR else BUTTON_COLOR
			slot.nameLabel.TextTransparency = if empty then 0.6 else 0
		end
	end
end

function AbilityBar.startCooldown(slotIndex: number, seconds: number)
	local slot = slots[slotIndex]
	if slot == nil or seconds <= 0 then
		return
	end
	slot.total = seconds
	slot.endsAt = os.clock() + seconds
	tick()
	if ticking == nil then
		ticking = RunService.RenderStepped:Connect(tick)
	end
end

return AbilityBar
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="106">
          <Properties>
            <string name="Name">Atmosphere</string>
            <string name="Source"><![CDATA[--!strict
-- Fades the fog to the colour and range of the region the player is in.
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Regions = require(Shared:WaitForChild("Catalog"):WaitForChild("Regions"))

local FADE_SECONDS = 1.5

local Atmosphere = {}

-- The fade in progress, so a new region can replace it.
local current: Tween? = nil

-- An unknown region id changes nothing.
function Atmosphere.set(regionId: string)
	local region = Regions.byId[regionId]
	if region == nil then
		return
	end
	local fog = region.fog
	local previous = current
	if previous ~= nil then
		previous:Cancel()
	end
	local tween = TweenService:Create(Lighting, TweenInfo.new(FADE_SECONDS), {
		FogColor = Color3.fromRGB(fog.r, fog.g, fog.b),
		FogStart = fog.start,
		FogEnd = fog.finish,
	})
	current = tween
	tween:Play()
end

return Atmosphere
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="107">
          <Properties>
            <string name="Name">CeremonyUI</string>
            <string name="Source"><![CDATA[--!strict
-- The banner every player sees when someone is Crowned. It only shows the lines the Crown
-- rules make from what the server sent.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Crown = require(Shared:WaitForChild("Rules"):WaitForChild("Crown"))

local SHOW_SECONDS = 6

local TEXT_LIGHT = Color3.fromRGB(245, 235, 210)
local TEXT_GOLD = Color3.fromRGB(255, 215, 90)
local BACKGROUND = Color3.fromRGB(25, 22, 30)

local CeremonyUI = {}

local banner: Frame? = nil
local line1: TextLabel? = nil
local line2: TextLabel? = nil
-- Bumped on every show, so an old banner's timer cannot hide a newer one.
local token = 0

local function limitText(parent: Instance, minSize: number, maxSize: number)
	local constraint = Instance.new("UITextSizeConstraint")
	constraint.MinTextSize = minSize
	constraint.MaxTextSize = maxSize
	constraint.Parent = parent
end

local function makeLine(
	name: string,
	size: UDim2,
	position: UDim2,
	color: Color3,
	font: Enum.Font,
	maxText: number
): TextLabel
	local label = Instance.new("TextLabel")
	label.Name = name
	label.Size = size
	label.Position = position
	label.BackgroundTransparency = 1
	label.TextColor3 = color
	label.TextScaled = true
	label.TextWrapped = true
	label.Font = font
	label.Text = ""
	limitText(label, 9, maxText)
	return label
end

function CeremonyUI.mount(playerGui: PlayerGui)
	local gui = Instance.new("ScreenGui")
	gui.Name = "CeremonyGui"
	gui.ResetOnSpawn = false
	-- Above the status HUD (15) and messages (20), below the Renounce window (26).
	gui.DisplayOrder = 25

	local frame = Instance.new("Frame")
	frame.Name = "Banner"
	frame.AnchorPoint = Vector2.new(0.5, 0)
	frame.Position = UDim2.fromScale(0.5, 0.2)
	frame.Size = UDim2.fromScale(0.6, 0.14)
	frame.BackgroundColor3 = BACKGROUND
	frame.BackgroundTransparency = 0.2
	frame.Visible = false
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 12)
	corner.Parent = frame
	local minimum = Instance.new("UISizeConstraint")
	minimum.MinSize = Vector2.new(280, 70)
	minimum.Parent = frame

	local first = makeLine(
		"Line1",
		UDim2.fromScale(0.94, 0.58),
		UDim2.fromScale(0.03, 0),
		TEXT_GOLD,
		Enum.Font.GothamBold,
		30
	)
	first.Parent = frame
	line1 = first

	local second = makeLine(
		"Line2",
		UDim2.fromScale(0.94, 0.36),
		UDim2.fromScale(0.03, 0.62),
		TEXT_LIGHT,
		Enum.Font.GothamMedium,
		20
	)
	second.Parent = frame
	line2 = second

	frame.Parent = gui
	banner = frame
	gui.Parent = playerGui
end

function CeremonyUI.show(ceremony: { userId: number, name: string, crowns: number })
	local frame = banner
	local top = line1
	local bottom = line2
	if frame == nil or top == nil or bottom == nil then
		return
	end
	local lines = Crown.ceremonyLines(ceremony.name, ceremony.crowns)
	top.Text = lines[1] or ""
	bottom.Text = lines[2] or ""
	frame.Visible = true
	token += 1
	local mine = token
	task.delay(SHOW_SECONDS, function()
		if token == mine then
			frame.Visible = false
		end
	end)
end

return CeremonyUI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="108">
          <Properties>
            <string name="Name">ClaimUI</string>
            <string name="Source"><![CDATA[--!strict
-- The blind-claim screen. It shows every numbered slot face down: nothing tells the
-- killer whether the victim holds a Relic, only what each pick turned out to be.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Tiers = require(Shared:WaitForChild("Catalog"):WaitForChild("Tiers"))
local Rules = Shared:WaitForChild("Rules")
local BlindClaim = require(Rules:WaitForChild("BlindClaim"))
local ClaimView = require(Rules:WaitForChild("ClaimView"))
local Types = require(Shared:WaitForChild("Types"))

local TICK_SECONDS = 0.25

local TEXT_LIGHT = Color3.fromRGB(245, 235, 210)
local TEXT_DARK = Color3.fromRGB(20, 18, 24)
local TEXT_DIM = Color3.fromRGB(130, 130, 135)
local PANEL_COLOR = Color3.fromRGB(32, 28, 38)
local MISS_COLOR = Color3.fromRGB(40, 40, 45)
local LOCKED_COLOR = Color3.fromRGB(70, 70, 75)
local BUTTON_COLOR = Color3.fromRGB(70, 60, 90)

local ClaimUI = {}

local panel: Frame? = nil
local titleLabel: TextLabel? = nil
local picksLabel: TextLabel? = nil
local timerLabel: TextLabel? = nil
local grid: Frame? = nil
local pickHandler: (slot: number) -> () = function(_slot: number) end

-- What is on screen. The deadline is on the local clock: the server's expiresAt is on the
-- server's clock and is never compared with local time.
local victimName = ""
local currentClaim: BlindClaim.Claim? = nil
local deadline = 0
local shownOpen = false
local ticking = false

local function tierColor(tier: Types.Tier): Color3
	local color = Tiers.info[tier].color
	return Color3.fromRGB(color.r, color.g, color.b)
end

local function addCorner(parent: Instance, radius: number)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius)
	corner.Parent = parent
end

local function limitText(parent: Instance, minSize: number, maxSize: number)
	local constraint = Instance.new("UITextSizeConstraint")
	constraint.MinTextSize = minSize
	constraint.MaxTextSize = maxSize
	constraint.Parent = parent
end

local function makeLabel(name: string, size: UDim2, position: UDim2, maxText: number): TextLabel
	local label = Instance.new("TextLabel")
	label.Name = name
	label.Size = size
	label.Position = position
	label.BackgroundTransparency = 1
	label.TextColor3 = TEXT_LIGHT
	label.TextScaled = true
	label.TextWrapped = true
	label.Font = Enum.Font.GothamMedium
	label.Text = ""
	limitText(label, 10, maxText)
	return label
end

local function secondsRemaining(): number
	return math.max(0, deadline - os.clock())
end

local function buildView(claim: BlindClaim.Claim): ClaimView.View
	return ClaimView.build(victimName, claim, claim.expiresAt - secondsRemaining())
end

local function makeCell(slot: ClaimView.SlotView): TextButton
	local cell = Instance.new("TextButton")
	cell.Name = "Slot" .. slot.label
	cell.LayoutOrder = slot.slot
	cell.Font = Enum.Font.GothamMedium
	cell.TextScaled = true
	cell.TextWrapped = true
	cell.AutoButtonColor = slot.state == "open"
	addCorner(cell, 8)
	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0, 2)
	padding.PaddingBottom = UDim.new(0, 2)
	padding.PaddingLeft = UDim.new(0, 2)
	padding.PaddingRight = UDim.new(0, 2)
	padding.Parent = cell
	limitText(cell, 7, 18)

	-- Two lines so the text fits a small cell: the label, then the status or the Relic name.
	local text = slot.label .. "\n" .. slot.name
	if slot.state == "open" then
		cell.BackgroundColor3 = tierColor(slot.tier)
		cell.BackgroundTransparency = 0.35
		cell.TextColor3 = TEXT_DARK
	elseif slot.state == "taken" then
		cell.BackgroundColor3 = tierColor(slot.tier)
		cell.TextColor3 = TEXT_DARK
		cell.Font = Enum.Font.GothamBold
		text = slot.label .. "\nTaken!"
		local stroke = Instance.new("UIStroke")
		stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		stroke.Color = Color3.new(1, 1, 1)
		stroke.Thickness = 3
		stroke.Parent = cell
	elseif slot.state == "miss" then
		cell.BackgroundColor3 = MISS_COLOR
		cell.TextColor3 = TEXT_DIM
		text = slot.label .. "\nNothing"
	else
		cell.BackgroundColor3 = LOCKED_COLOR
		cell.BackgroundTransparency = 0.4
		cell.TextColor3 = TEXT_DIM
		cell.TextTransparency = 0.4
	end
	cell.Text = text

	if slot.state == "open" then
		cell.Activated:Connect(function()
			pickHandler(slot.slot)
		end)
	end
	return cell
end

local function render()
	local claim = currentClaim
	local cells = grid
	if claim == nil or cells == nil then
		return
	end
	local view = buildView(claim)
	shownOpen = view.open
	if titleLabel ~= nil then
		titleLabel.Text = view.title
	end
	if picksLabel ~= nil then
		picksLabel.Text = view.picksText
	end
	if timerLabel ~= nil then
		timerLabel.Text = `{view.secondsLeft}s`
	end
	for _, child in cells:GetChildren() do
		if not child:IsA("UIComponent") then
			child:Destroy()
		end
	end
	for _, slot in view.slots do
		makeCell(slot).Parent = cells
	end
end

-- Counts down locally while the screen is open; redraws the slots when time runs out.
local function startTicking()
	if ticking then
		return
	end
	ticking = true
	task.spawn(function()
		while ClaimUI.isOpen() do
			local claim = currentClaim
			if claim ~= nil then
				local view = buildView(claim)
				if view.open ~= shownOpen then
					render()
				elseif timerLabel ~= nil then
					timerLabel.Text = `{view.secondsLeft}s`
				end
			end
			task.wait(TICK_SECONDS)
		end
		ticking = false
	end)
end

function ClaimUI.mount(playerGui: PlayerGui, onPick: (slot: number) -> ())
	pickHandler = onPick

	local gui = Instance.new("ScreenGui")
	gui.Name = "ClaimGui"
	gui.ResetOnSpawn = false
	-- Above the Ledger book (10), the status HUD (15) and messages (20).
	gui.DisplayOrder = 30

	local frame = Instance.new("Frame")
	frame.Name = "Claim"
	frame.AnchorPoint = Vector2.new(0.5, 0.5)
	frame.Position = UDim2.fromScale(0.5, 0.5)
	frame.Size = UDim2.fromScale(0.9, 0.9)
	frame.BackgroundColor3 = PANEL_COLOR
	frame.Visible = false
	addCorner(frame, 14)
	-- A phone (640x360) gets a 576x324 screen; the 50 cells need at least that.
	local minimum = Instance.new("UISizeConstraint")
	minimum.MinSize = Vector2.new(560, 320)
	minimum.Parent = frame

	local title = makeLabel("Title", UDim2.fromScale(0.6, 0.08), UDim2.fromScale(0.03, 0.02), 30)
	title.Font = Enum.Font.GothamBold
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.Parent = frame
	titleLabel = title

	local timer = makeLabel("Timer", UDim2.fromScale(0.15, 0.08), UDim2.fromScale(0.82, 0.02), 30)
	timer.Font = Enum.Font.GothamBold
	timer.TextXAlignment = Enum.TextXAlignment.Right
	timer.Parent = frame
	timerLabel = timer

	local hint = makeLabel("Hint", UDim2.fromScale(0.94, 0.06), UDim2.fromScale(0.03, 0.1), 18)
	hint.TextXAlignment = Enum.TextXAlignment.Left
	hint.TextColor3 = TEXT_DIM
	hint.Text = "Pick the Relics you think they hold. You are not told why a pick misses."
	hint.Parent = frame

	local picks = makeLabel("Picks", UDim2.fromScale(0.4, 0.05), UDim2.fromScale(0.03, 0.16), 20)
	picks.TextXAlignment = Enum.TextXAlignment.Left
	picks.Parent = frame
	picksLabel = picks

	local cells = Instance.new("Frame")
	cells.Name = "Slots"
	cells.BackgroundTransparency = 1
	cells.Position = UDim2.fromScale(0.03, 0.22)
	cells.Size = UDim2.fromScale(0.94, 0.68)
	local layout = Instance.new("UIGridLayout")
	-- 50 slots: ten columns by five rows. Cell text keeps a minimum of 7 so a phone can read it.
	layout.CellSize = UDim2.fromScale(0.088, 0.17)
	layout.CellPadding = UDim2.fromScale(0.0133, 0.035)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = cells
	cells.Parent = frame
	grid = cells

	local done = Instance.new("TextButton")
	done.Name = "Done"
	done.AnchorPoint = Vector2.new(0.5, 1)
	done.Position = UDim2.fromScale(0.5, 0.98)
	done.Size = UDim2.fromScale(0.2, 0.08)
	done.BackgroundColor3 = BUTTON_COLOR
	done.TextColor3 = TEXT_LIGHT
	done.TextScaled = true
	done.Font = Enum.Font.GothamBold
	done.Text = "Done"
	addCorner(done, 8)
	limitText(done, 10, 22)
	-- Hides the screen here only; the server ends the claim on its own timer.
	done.Activated:Connect(ClaimUI.hide)
	done.Parent = frame

	frame.Parent = gui
	panel = frame
	gui.Parent = playerGui
end

function ClaimUI.show(name: string, claim: BlindClaim.Claim, secondsLeft: number)
	local frame = panel
	if frame == nil then
		return
	end
	victimName = name
	currentClaim = claim
	deadline = os.clock() + math.max(0, secondsLeft)
	frame.Visible = true
	render()
	startTicking()
end

function ClaimUI.hide()
	currentClaim = nil
	local frame = panel
	if frame ~= nil then
		frame.Visible = false
	end
end

function ClaimUI.isOpen(): boolean
	local frame = panel
	return frame ~= nil and frame.Visible
end

return ClaimUI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="109">
          <Properties>
            <string name="Name">CombatController</string>
            <string name="Source"><![CDATA[--!strict
-- Strike input and the hit flash. The client only asks to Strike; the server decides the rest.
local ContextActionService = game:GetService("ContextActionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Combat = require(Shared:WaitForChild("Rules"):WaitForChild("Combat"))

local FLASH_SECONDS = 0.15

local CombatController = {}

function CombatController.start(
	strike: () -> (),
	cast: (slot: number) -> (),
	isBlocked: () -> boolean
)
	local lastStrike = -math.huge
	ContextActionService:BindAction("Strike", function(_name, state, _input)
		if state == Enum.UserInputState.Begin and not isBlocked() then
			local now = os.clock()
			if now - lastStrike >= Combat.STRIKE_COOLDOWN then
				lastStrike = now
				strike()
			end
		end
		-- Pass, so clicks still reach the camera and other controls.
		return Enum.ContextActionResult.Pass
	end, true, Enum.UserInputType.MouseButton1, Enum.KeyCode.F)
	ContextActionService:SetTitle("Strike", "Strike")

	-- Keys 1-4 cast ability slots; the bar itself is the touch control. The server decides.
	local keys = { Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three, Enum.KeyCode.Four }
	for slot, key in keys do
		ContextActionService:BindAction("Cast" .. slot, function(_name, state, _input)
			if state == Enum.UserInputState.Begin and not isBlocked() then
				cast(slot)
			end
			return Enum.ContextActionResult.Pass
		end, false, key)
	end
end

-- A brief white flash on a character that was hit.
function CombatController.flash(character: Model)
	local highlight = Instance.new("Highlight")
	highlight.Name = "HitFlash"
	highlight.FillColor = Color3.new(1, 1, 1)
	highlight.FillTransparency = 0.3
	highlight.OutlineColor = Color3.new(1, 1, 1)
	highlight.OutlineTransparency = 0
	highlight.Adornee = character
	highlight.Parent = character
	task.delay(FLASH_SECONDS, function()
		highlight:Destroy()
	end)
end

return CombatController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="110">
          <Properties>
            <string name="Name">CreatureFx</string>
            <string name="Source"><![CDATA[--!strict
-- Creatures on this client: the hit flash, and hiding the Drowned Tallyman of someone else's
-- duel. The server already keeps a champion from touching anyone but its duellist; here it
-- is only made invisible and walk-through for everyone else.
local CollectionService = game:GetService("CollectionService")

local TAG = "Creature"
local FLASH_SECONDS = 0.15

local CreatureFx = {}

-- Champions this client does not draw.
local hidden: { [Instance]: boolean } = {}

local function hidePart(instance: Instance)
	if instance:IsA("BasePart") then
		instance.LocalTransparencyModifier = 1
		instance.CanCollide = false
	elseif instance:IsA("BillboardGui") then
		instance.Enabled = false
	end
end

local function watch(model: Instance, localUserId: number)
	local owner = model:GetAttribute("OwnerUserId")
	if type(owner) ~= "number" or owner == 0 or owner == localUserId then
		return
	end
	hidden[model] = true
	for _, descendant in model:GetDescendants() do
		hidePart(descendant)
	end
	model.DescendantAdded:Connect(hidePart)
end

-- Hides champions owned by another player, now and as they appear.
function CreatureFx.start(localPlayer: Player)
	local localUserId = localPlayer.UserId
	for _, model in CollectionService:GetTagged(TAG) do
		watch(model, localUserId)
	end
	CollectionService:GetInstanceAddedSignal(TAG):Connect(function(model)
		watch(model, localUserId)
	end)
	CollectionService:GetInstanceRemovedSignal(TAG):Connect(function(model)
		hidden[model] = nil
	end)
end

-- True when this client draws the creature model (play-test seam).
function CreatureFx.isShown(model: Instance): boolean
	return hidden[model] ~= true
end

-- A brief white flash on the creature with that id. A hidden champion does not flash.
function CreatureFx.flash(id: number)
	for _, model in CollectionService:GetTagged(TAG) do
		if model:GetAttribute("CreatureId") == id then
			if hidden[model] then
				return
			end
			local highlight = Instance.new("Highlight")
			highlight.Name = "HitFlash"
			highlight.FillColor = Color3.new(1, 1, 1)
			highlight.FillTransparency = 0.3
			highlight.OutlineColor = Color3.new(1, 1, 1)
			highlight.OutlineTransparency = 0
			highlight.Adornee = model
			highlight.Parent = model
			task.delay(FLASH_SECONDS, function()
				highlight:Destroy()
			end)
			return
		end
	end
end

return CreatureFx
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="111">
          <Properties>
            <string name="Name">EdictUI</string>
            <string name="Source"><![CDATA[--!strict
-- Using an Edict: the Relic picker (Summons), the player picker (Passage) and the result
-- window (Summons and Audit). It sends what the player picked; the server decides the rest.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Catalog = Shared:WaitForChild("Catalog")
local Edicts = require(Catalog:WaitForChild("Edicts"))
local Relics = require(Catalog:WaitForChild("Relics"))
local Tiers = require(Catalog:WaitForChild("Tiers"))
local LedgerView = require(Shared:WaitForChild("Rules"):WaitForChild("LedgerView"))

local TEXT_LIGHT = Color3.fromRGB(245, 235, 210)
local TEXT_DIM = Color3.fromRGB(170, 165, 160)
local TEXT_DARK = Color3.fromRGB(20, 18, 24)
local PANEL_COLOR = Color3.fromRGB(32, 28, 38)
local BUTTON_COLOR = Color3.fromRGB(70, 60, 90)
local ROW_HEIGHT = 40

local EdictUI = {}

local relicWindow: Frame? = nil
local playerWindow: Frame? = nil
local resultWindow: Frame? = nil
local playerList: ScrollingFrame? = nil
local resultList: ScrollingFrame? = nil
local resultTitle: TextLabel? = nil
local useHandler: (request: { [string]: any }) -> () = function(_request: { [string]: any }) end
-- The Edict the open picker was opened for.
local pending: LedgerView.FreeView? = nil
local met: { { userId: number, name: string } } = {}

local function addCorner(parent: Instance, radius: number)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius)
	corner.Parent = parent
end

local function limitText(parent: Instance, minSize: number, maxSize: number)
	local constraint = Instance.new("UITextSizeConstraint")
	constraint.MinTextSize = minSize
	constraint.MaxTextSize = maxSize
	constraint.Parent = parent
end

local function makeLabel(name: string, text: string, size: UDim2, position: UDim2): TextLabel
	local label = Instance.new("TextLabel")
	label.Name = name
	label.Size = size
	label.Position = position
	label.BackgroundTransparency = 1
	label.TextColor3 = TEXT_LIGHT
	label.TextScaled = true
	label.TextWrapped = true
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Font = Enum.Font.GothamMedium
	label.Text = text
	limitText(label, 10, 22)
	return label
end

local function makeButton(name: string, text: string, color: Color3): TextButton
	local button = Instance.new("TextButton")
	button.Name = name
	button.BackgroundColor3 = color
	button.TextColor3 = TEXT_LIGHT
	button.TextScaled = true
	button.TextWrapped = true
	button.Font = Enum.Font.GothamBold
	button.Text = text
	addCorner(button, 8)
	limitText(button, 9, 20)
	return button
end

local function makeScroller(): ScrollingFrame
	local scroller = Instance.new("ScrollingFrame")
	scroller.Name = "List"
	scroller.Position = UDim2.fromScale(0.04, 0.15)
	scroller.Size = UDim2.fromScale(0.92, 0.66)
	scroller.BackgroundTransparency = 1
	scroller.BorderSizePixel = 0
	scroller.ScrollBarThickness = 6
	scroller.CanvasSize = UDim2.new()
	scroller.AutomaticCanvasSize = Enum.AutomaticSize.Y
	return scroller
end

local function clearRows(container: Instance)
	for _, child in container:GetChildren() do
		if not child:IsA("UIComponent") then
			child:Destroy()
		end
	end
end

-- A hidden, centred window with a title and a bottom button.
local function makeWindow(
	gui: ScreenGui,
	name: string,
	title: string,
	bottomText: string,
	onBottom: () -> ()
): Frame
	local frame = Instance.new("Frame")
	frame.Name = name
	frame.AnchorPoint = Vector2.new(0.5, 0.5)
	frame.Position = UDim2.fromScale(0.5, 0.5)
	frame.Size = UDim2.fromScale(0.6, 0.64)
	frame.BackgroundColor3 = PANEL_COLOR
	frame.Visible = false
	addCorner(frame, 14)
	local minimum = Instance.new("UISizeConstraint")
	minimum.MinSize = Vector2.new(300, 260)
	minimum.Parent = frame

	local heading =
		makeLabel("Title", title, UDim2.fromScale(0.92, 0.1), UDim2.fromScale(0.04, 0.03))
	heading.Font = Enum.Font.GothamBold
	heading.Parent = frame

	local bottom = makeButton(bottomText, bottomText, BUTTON_COLOR)
	bottom.AnchorPoint = Vector2.new(0.5, 1)
	bottom.Position = UDim2.fromScale(0.5, 0.97)
	bottom.Size = UDim2.fromScale(0.4, 0.1)
	bottom.Activated:Connect(onBottom)
	bottom.Parent = frame

	frame.Parent = gui
	return frame
end

local function hide(frame: Frame?)
	if frame ~= nil then
		frame.Visible = false
	end
end

-- Closing a picker also forgets the card it was for.
local function closePicker(frame: Frame?)
	hide(frame)
	pending = nil
end

local function fillPlayers()
	local list = playerList
	if list == nil then
		return
	end
	clearRows(list)
	local card = pending
	if #met == 0 then
		local none = makeLabel(
			"None",
			"You have not met anyone this session.",
			UDim2.new(1, 0, 0, ROW_HEIGHT * 2),
			UDim2.new()
		)
		none.TextColor3 = TEXT_DIM
		none.Parent = list
		return
	end
	for index, person in met do
		local button = makeButton("Player" .. index, person.name, BUTTON_COLOR)
		button.LayoutOrder = index
		button.Size = UDim2.new(1, -8, 0, ROW_HEIGHT)
		button.Activated:Connect(function()
			-- Closing first, so a second click cannot send twice.
			closePicker(playerWindow)
			if card ~= nil then
				useHandler({
					freeIndex = card.index,
					cardId = card.cardId,
					targetId = person.userId,
				})
			end
		end)
		button.Parent = list
	end
end

function EdictUI.mount(playerGui: PlayerGui, onUse: (request: { [string]: any }) -> ())
	useHandler = onUse

	local gui = Instance.new("ScreenGui")
	gui.Name = "EdictGui"
	gui.ResetOnSpawn = false
	-- With the other windows; below the messages (20).
	gui.DisplayOrder = 16

	-- Relic picker: a grid of every Relic, six to a row.
	local relics = makeWindow(gui, "RelicPicker", "Summons: which Relic?", "Cancel", function()
		closePicker(relicWindow)
	end)
	local grid = makeScroller()
	local gridLayout = Instance.new("UIGridLayout")
	gridLayout.CellSize = UDim2.new(0.155, 0, 0, 64)
	gridLayout.CellPadding = UDim2.new(0.012, 0, 0, 6)
	gridLayout.SortOrder = Enum.SortOrder.LayoutOrder
	gridLayout.Parent = grid
	for index, relic in Relics.list do
		local color = Tiers.info[relic.tier].color
		local text = string.sub(relic.id, 2) .. "\n" .. relic.name
		local button =
			makeButton("Relic" .. relic.id, text, Color3.fromRGB(color.r, color.g, color.b))
		button.LayoutOrder = index
		button.TextColor3 = TEXT_DARK
		button.Activated:Connect(function()
			local card = pending
			closePicker(relicWindow)
			if card ~= nil then
				useHandler({ freeIndex = card.index, cardId = card.cardId, relicId = relic.id })
			end
		end)
		button.Parent = grid
	end
	grid.Parent = relics
	relicWindow = relics

	-- Player picker: one button per player met this session.
	local players = makeWindow(gui, "PlayerPicker", "Passage: to whom?", "Cancel", function()
		closePicker(playerWindow)
	end)
	local people = makeScroller()
	local peopleLayout = Instance.new("UIListLayout")
	peopleLayout.Padding = UDim.new(0, 6)
	peopleLayout.SortOrder = Enum.SortOrder.LayoutOrder
	peopleLayout.Parent = people
	people.Parent = players
	playerList = people
	playerWindow = players

	-- Result: what a Summons or an Audit found.
	local result = makeWindow(gui, "Result", "", "Close", function()
		hide(resultWindow)
	end)
	local heading = result:FindFirstChild("Title")
	if heading ~= nil and heading:IsA("TextLabel") then
		resultTitle = heading
	end
	local lines = makeScroller()
	local linesLayout = Instance.new("UIListLayout")
	linesLayout.Padding = UDim.new(0, 4)
	linesLayout.SortOrder = Enum.SortOrder.LayoutOrder
	linesLayout.Parent = lines
	lines.Parent = result
	resultList = lines
	resultWindow = result

	gui.Parent = playerGui
end

-- The Ledger's "Use" button: ask for what the Edict needs, or use it at once.
function EdictUI.use(card: LedgerView.FreeView)
	local edict = Edicts.byId[card.cardId]
	if edict == nil then
		return
	end
	if edict.needs == "relic" then
		local frame = relicWindow
		if frame ~= nil then
			pending = card
			frame.Visible = true
		end
	elseif edict.needs == "player" then
		local frame = playerWindow
		if frame ~= nil then
			pending = card
			fillPlayers()
			frame.Visible = true
		end
	else
		useHandler({ freeIndex = card.index, cardId = card.cardId })
	end
end

-- The players met this session; the picker refreshes when it is open.
function EdictUI.setMet(list: { { userId: number, name: string } })
	met = list
	local frame = playerWindow
	if frame ~= nil and frame.Visible then
		fillPlayers()
	end
end

function EdictUI.showResult(result: { title: string, lines: { string } })
	local frame = resultWindow
	local list = resultList
	if frame == nil or list == nil then
		return
	end
	local heading = resultTitle
	if heading ~= nil then
		heading.Text = result.title
	end
	clearRows(list)
	for index, line in result.lines do
		local label = makeLabel("Line" .. index, line, UDim2.new(1, -8, 0, 28), UDim2.new())
		label.LayoutOrder = index
		label.Parent = list
	end
	frame.Visible = true
end

function EdictUI.isOpen(): boolean
	local relics = relicWindow
	local players = playerWindow
	local result = resultWindow
	return (relics ~= nil and relics.Visible)
		or (players ~= nil and players.Visible)
		or (result ~= nil and result.Visible)
end

return EdictUI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="112">
          <Properties>
            <string name="Name">HazardController</string>
            <string name="Source"><![CDATA[--!strict
-- Hazard visuals and the one hazard effect the client applies itself: the gust push on the
-- local character. The server decides every hazard's damage, healing, slow and drowning.
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Catalog = Shared:WaitForChild("Catalog")
local Hazards = require(Shared:WaitForChild("Rules"):WaitForChild("Hazards"))
local Looks = require(Catalog:WaitForChild("Looks"))
local Sites = require(Catalog:WaitForChild("Sites"))
local Types = require(Shared:WaitForChild("Types"))

local MARKER_TAG = "Hazard"
local VISUAL_SECONDS = 0.1
local WARN_BRIGHT = 0.35
local WARN_DIM = 0.6
local ACTIVE_TRANSPARENCY = 0.05
-- The warning flips between bright and dim this many times a second.
local WARN_FLIPS_PER_SECOND = 4

local HazardController = {}

-- What a marker looked like before the controller touched it.
type Rest = { cframe: CFrame, transparency: number }

-- The rest is kept on the marker itself, in client-local attributes. A table keyed by the part
-- can lose its entry when the part's Lua wrapper is collected, and a marker that is lifted at
-- that moment would then be taken for its resting self and lifted again, pass after pass.
-- Both values are written together, on the first pass, before anything has moved the marker.
local function restOf(marker: BasePart, hazard: Types.Hazard): Rest
	local cframe = marker:GetAttribute("RestCFrame")
	local transparency = marker:GetAttribute("RestTransparency")
	if typeof(cframe) == "CFrame" and type(transparency) == "number" then
		return { cframe = cframe, transparency = transparency }
	end
	local look = Looks.byName[hazard.look]
	local rest: Rest = {
		cframe = marker.CFrame,
		transparency = if look ~= nil then look.transparency else marker.Transparency,
	}
	-- Client-local: lost if the server ever changed a marker's attributes at run time (it does not).
	marker:SetAttribute("RestCFrame", rest.cframe)
	marker:SetAttribute("RestTransparency", rest.transparency)
	return rest
end

-- Idle markers sit at rest, a warning flashes, and an active hazard is nearly solid. A
-- marker with a Rise attribute (the tide) lifts by that much as the hazard goes active.
local function showMarker(marker: BasePart, hazard: Types.Hazard, now: number)
	local rest = restOf(marker, hazard)
	local phase, _, elapsed = Hazards.phase(hazard, now)
	local lift = 0
	if phase == "idle" then
		marker.Transparency = rest.transparency
	elseif phase == "warn" then
		local bright = math.floor(now * WARN_FLIPS_PER_SECOND) % 2 == 0
		marker.Transparency = if bright then WARN_BRIGHT else WARN_DIM
		lift = elapsed
	else
		marker.Transparency = ACTIVE_TRANSPARENCY
		lift = 1
	end
	local rise = marker:GetAttribute("Rise")
	if type(rise) == "number" then
		marker.CFrame = rest.cframe + Vector3.new(0, rise * lift, 0)
	end
end

-- Read the tagged list afresh each pass: a marker may appear after this runs.
local function showMarkers(now: number)
	for _, instance in CollectionService:GetTagged(MARKER_TAG) do
		if instance:IsA("BasePart") then
			local id = instance:GetAttribute("HazardId")
			local hazard = if type(id) == "string" then Sites.hazardById[id] else nil
			-- A hazard without a cycle has nothing to count down to; leave its marker alone.
			if hazard ~= nil and hazard.cycle ~= nil then
				showMarker(instance, hazard, now)
			end
		end
	end
end

-- Moves the local character along any gust it stands in, while it is alive.
local function pushLocalCharacter(dt: number, now: number)
	local character = Players.LocalPlayer.Character
	if character == nil then
		return
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	if humanoid == nil or humanoid.Health <= 0 or root == nil or not root:IsA("BasePart") then
		return
	end
	local position = root.Position
	local sample = Hazards.sample(Sites.hazards, position.X, position.Z, now)
	if sample.pushX ~= 0 or sample.pushZ ~= 0 then
		root.CFrame += Vector3.new(sample.pushX, 0, sample.pushZ) * dt
	end
end

function HazardController.start()
	local sinceVisuals = 0
	RunService.RenderStepped:Connect(function(dt)
		local now = workspace:GetServerTimeNow()
		pushLocalCharacter(dt, now)
		sinceVisuals += dt
		if sinceVisuals >= VISUAL_SECONDS then
			sinceVisuals = 0
			showMarkers(now)
		end
	end)
end

return HazardController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="113">
          <Properties>
            <string name="Name">LedgerUI</string>
            <string name="Source"><![CDATA[--!strict
local ContextActionService = game:GetService("ContextActionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Tiers = require(Shared:WaitForChild("Catalog"):WaitForChild("Tiers"))
local Crown = require(Shared:WaitForChild("Rules"):WaitForChild("Crown"))
local LedgerView = require(Shared:WaitForChild("Rules"):WaitForChild("LedgerView"))
local Types = require(Shared:WaitForChild("Types"))

type View = LedgerView.View

local LedgerUI = {}

local TEXT_LIGHT = Color3.fromRGB(245, 235, 210)
local TEXT_DIM = Color3.fromRGB(130, 130, 135)
local PANEL_COLOR = Color3.fromRGB(32, 28, 38)
local LOCKED_COLOR = Color3.fromRGB(55, 55, 60)
local BUTTON_COLOR = Color3.fromRGB(70, 60, 90)
local VAULT_GOLD = Color3.fromRGB(255, 200, 40)
-- An Edict has no tier, so it gets the colour of old paper.
local PARCHMENT = Color3.fromRGB(214, 196, 150)
local CROWN_GOLD = Color3.fromRGB(255, 215, 90)

local panel: Frame? = nil
local slotGrid: ScrollingFrame? = nil
local freeList: ScrollingFrame? = nil
local progressLabel: TextLabel? = nil
local freeLabel: TextLabel? = nil
local vaultLabel: TextLabel? = nil
local crownLabel: TextLabel? = nil
-- What the Crown line is drawn from: the attributes as last given, and whether the last
-- Ledger view was complete.
local shownCrowns: number? = nil
local shownStars: number? = nil
local lastComplete = false
local actionHandler: (request: { [string]: any }) -> () = function(_request: { [string]: any }) end
local vaultHandler: (request: { [string]: any }) -> () = function(_request: { [string]: any }) end
local useHandler: (card: LedgerView.FreeView) -> () = function(_card: LedgerView.FreeView) end

local function tierColor(tier: Types.Tier): Color3
	local color = Tiers.info[tier].color
	return Color3.fromRGB(color.r, color.g, color.b)
end

local function addCorner(parent: Instance, radius: number)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius)
	corner.Parent = parent
end

local function addPadding(parent: Instance, pixels: number)
	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0, pixels)
	padding.PaddingBottom = UDim.new(0, pixels)
	padding.PaddingLeft = UDim.new(0, pixels)
	padding.PaddingRight = UDim.new(0, pixels)
	padding.Parent = parent
end

local function limitText(parent: Instance, minSize: number, maxSize: number)
	local constraint = Instance.new("UITextSizeConstraint")
	constraint.MinTextSize = minSize
	constraint.MaxTextSize = maxSize
	constraint.Parent = parent
end

local function makeLabel(name: string, size: UDim2, position: UDim2, maxText: number): TextLabel
	local label = Instance.new("TextLabel")
	label.Name = name
	label.Size = size
	label.Position = position
	label.BackgroundTransparency = 1
	label.TextColor3 = TEXT_LIGHT
	label.TextScaled = true
	label.Font = Enum.Font.GothamMedium
	label.Text = ""
	limitText(label, 10, maxText)
	return label
end

local function makeButton(name: string, text: string, size: UDim2): TextButton
	local button = Instance.new("TextButton")
	button.Name = name
	button.Size = size
	button.BackgroundColor3 = BUTTON_COLOR
	button.TextColor3 = TEXT_LIGHT
	button.TextScaled = true
	button.Font = Enum.Font.GothamBold
	button.Text = text
	button.AutoButtonColor = true
	addCorner(button, 8)
	limitText(button, 10, 22)
	return button
end

-- Destroys every child except layout objects.
local function clearRows(container: Instance)
	for _, child in container:GetChildren() do
		if not child:IsA("UIComponent") then
			child:Destroy()
		end
	end
end

local function makeSlot(slot: LedgerView.SlotView, order: number): TextButton
	local button = Instance.new("TextButton")
	button.Name = "Slot" .. slot.label
	button.LayoutOrder = order
	button.AutoButtonColor = slot.claimed
	button.Font = Enum.Font.GothamMedium
	button.TextScaled = true
	button.TextWrapped = true
	if slot.claimed then
		button.BackgroundColor3 = tierColor(slot.tier)
		button.TextColor3 = Color3.fromRGB(20, 18, 24)
	else
		button.BackgroundColor3 = LOCKED_COLOR
		button.TextColor3 = TEXT_DIM
	end
	local text = slot.label .. "\n" .. slot.name
	if slot.spares > 0 then
		text ..= "\nx" .. slot.spares
	end
	button.Text = text
	addCorner(button, 8)
	addPadding(button, 4)
	limitText(button, 9, 20)
	if slot.claimed then
		button.Activated:Connect(function()
			actionHandler({ kind = "unclaim", cardId = slot.cardId })
		end)
	end
	if slot.vaulted then
		local stroke = Instance.new("UIStroke")
		stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		stroke.Color = VAULT_GOLD
		stroke.Thickness = 3
		stroke.Parent = button
	end
	if slot.vaulted or slot.canVault then
		-- A button on top of the slot takes the click, so the slot's unclaim does not fire.
		local vaultButton = makeButton(
			"Vault",
			if slot.vaulted then "Vaulted" else "Vault",
			UDim2.new(0.55, 0, 0, 18)
		)
		vaultButton.AnchorPoint = Vector2.new(1, 1)
		vaultButton.Position = UDim2.fromScale(1, 1)
		vaultButton.ZIndex = button.ZIndex + 1
		if slot.vaulted then
			vaultButton.BackgroundColor3 = VAULT_GOLD
			vaultButton.TextColor3 = Color3.fromRGB(20, 18, 24)
		end
		vaultButton.Activated:Connect(function()
			vaultHandler({ kind = if slot.vaulted then "remove" else "add", cardId = slot.cardId })
		end)
		vaultButton.Parent = button
	end
	return button
end

local function makeFreeRow(card: LedgerView.FreeView): Frame
	local row = Instance.new("Frame")
	row.Name = "Free" .. card.index
	row.LayoutOrder = card.index
	row.Size = UDim2.new(1, 0, 0, 52)
	local tier = card.tier
	row.BackgroundColor3 = if tier ~= nil then tierColor(tier) else PARCHMENT
	addCorner(row, 8)

	local name = makeLabel("Name", UDim2.fromScale(0.5, 1), UDim2.fromScale(0, 0), 22)
	name.TextColor3 = Color3.fromRGB(20, 18, 24)
	name.TextXAlignment = Enum.TextXAlignment.Left
	name.Text = card.name
	addPadding(name, 6)
	name.Parent = row

	-- One request per row: a second click before the Ledger sync would pass the server's
	-- "card on that row" check with the identical card next to it. The row is rebuilt on sync.
	local sent = false
	local buttons: { TextButton } = {}
	local function setInert(inert: boolean)
		sent = inert
		for _, button in buttons do
			button.Active = not inert
			button.AutoButtonColor = not inert
			button.BackgroundTransparency = if inert then 0.6 else 0
			button.TextTransparency = if inert then 0.5 else 0
		end
	end
	-- `rearmAfter`: for a button that only opens a picker, which may be cancelled with no
	-- sync to rebuild the row.
	local function once(send: () -> (), rearmAfter: number?): () -> ()
		return function()
			if sent then
				return
			end
			setInert(true)
			send()
			if rearmAfter ~= nil then
				task.delay(rearmAfter, function()
					setInert(false)
				end)
			end
		end
	end

	local discard = makeButton("Discard", "Discard", UDim2.new(0.22, 0, 1, -8))
	discard.AnchorPoint = Vector2.new(1, 0.5)
	discard.Position = UDim2.new(0.99, 0, 0.5, 0)
	table.insert(buttons, discard)
	discard.Activated:Connect(once(function()
		actionHandler({ kind = "discard", freeIndex = card.index, cardId = card.cardId })
	end))
	discard.Parent = row

	if card.canClaim then
		local claim = makeButton("Claim", "Claim", UDim2.new(0.22, 0, 1, -8))
		claim.AnchorPoint = Vector2.new(1, 0.5)
		claim.Position = UDim2.new(0.75, 0, 0.5, 0)
		table.insert(buttons, claim)
		claim.Activated:Connect(once(function()
			actionHandler({ kind = "claim", freeIndex = card.index, cardId = card.cardId })
		end))
		claim.Parent = row
	elseif card.canUse then
		-- An Edict is used, not claimed; the button sits where Claim would.
		local use = makeButton("Use", "Use", UDim2.new(0.22, 0, 1, -8))
		use.AnchorPoint = Vector2.new(1, 0.5)
		use.Position = UDim2.new(0.75, 0, 0.5, 0)
		table.insert(buttons, use)
		use.Activated:Connect(once(function()
			useHandler(card)
		end, 1))
		use.Parent = row
	end
	return row
end

-- What the "Use" button on an Edict row calls.
function LedgerUI.setUseHandler(handler: (card: LedgerView.FreeView) -> ())
	useHandler = handler
end

-- Redraws the Crown line from the last attributes and the last Ledger view.
local function drawCrown()
	local label = crownLabel
	if label ~= nil then
		label.Text = Crown.bookLine(shownCrowns, shownStars, lastComplete)
	end
end

function LedgerUI.mount(
	playerGui: PlayerGui,
	onAction: (request: { [string]: any }) -> (),
	onVault: (request: { [string]: any }) -> ()
)
	actionHandler = onAction
	vaultHandler = onVault

	local gui = Instance.new("ScreenGui")
	gui.Name = "LedgerGui"
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 10

	local openButton = makeButton("OpenButton", "Ledger", UDim2.fromScale(0.14, 0.07))
	openButton.AnchorPoint = Vector2.new(0, 1)
	openButton.Position = UDim2.fromScale(0.02, 0.97)
	local openLimit = openButton:FindFirstChildOfClass("UITextSizeConstraint")
	if openLimit ~= nil then
		openLimit.MinTextSize = 12
	end
	openButton.Activated:Connect(LedgerUI.toggle)
	openButton.Parent = gui

	local book = Instance.new("Frame")
	book.Name = "Book"
	book.AnchorPoint = Vector2.new(0.5, 0.5)
	book.Position = UDim2.fromScale(0.5, 0.5)
	book.Size = UDim2.fromScale(0.7, 0.7)
	book.BackgroundColor3 = PANEL_COLOR
	book.Visible = false
	addCorner(book, 14)

	local title = makeLabel("Title", UDim2.fromScale(0.6, 0.08), UDim2.fromScale(0.02, 0.02), 30)
	title.Font = Enum.Font.GothamBold
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.Text = "The Hoarder's Ledger"
	title.Parent = book

	local closeButton = makeButton("Close", "X", UDim2.fromScale(0.08, 0.08))
	closeButton.AnchorPoint = Vector2.new(1, 0)
	closeButton.Position = UDim2.fromScale(0.98, 0.02)
	closeButton.Activated:Connect(LedgerUI.toggle)
	closeButton.Parent = book

	local progress =
		makeLabel("Progress", UDim2.fromScale(0.3, 0.05), UDim2.fromScale(0.02, 0.11), 20)
	progress.TextXAlignment = Enum.TextXAlignment.Left
	progress.Parent = book
	progressLabel = progress

	local free = makeLabel("FreeCount", UDim2.fromScale(0.3, 0.05), UDim2.fromScale(0.35, 0.11), 20)
	free.TextXAlignment = Enum.TextXAlignment.Left
	free.Parent = book
	freeLabel = free

	local vault =
		makeLabel("VaultCount", UDim2.fromScale(0.3, 0.05), UDim2.fromScale(0.68, 0.11), 20)
	vault.TextXAlignment = Enum.TextXAlignment.Left
	vault.Parent = book
	vaultLabel = vault

	local crownLine =
		makeLabel("CrownLine", UDim2.fromScale(0.96, 0.04), UDim2.fromScale(0.02, 0.165), 18)
	crownLine.TextColor3 = CROWN_GOLD
	crownLine.TextXAlignment = Enum.TextXAlignment.Left
	crownLine.Parent = book
	crownLabel = crownLine
	drawCrown()

	local grid = Instance.new("ScrollingFrame")
	grid.Name = "Slots"
	grid.Position = UDim2.fromScale(0.02, 0.21)
	grid.Size = UDim2.fromScale(0.46, 0.76)
	grid.BackgroundTransparency = 1
	grid.BorderSizePixel = 0
	grid.ScrollBarThickness = 6
	grid.CanvasSize = UDim2.new()
	grid.AutomaticCanvasSize = Enum.AutomaticSize.Y
	local gridLayout = Instance.new("UIGridLayout")
	gridLayout.CellSize = UDim2.new(0.31, 0, 0, 78)
	gridLayout.CellPadding = UDim2.new(0.03, 0, 0, 8)
	gridLayout.SortOrder = Enum.SortOrder.LayoutOrder
	gridLayout.Parent = grid
	grid.Parent = book
	slotGrid = grid

	local list = Instance.new("ScrollingFrame")
	list.Name = "FreeCards"
	list.Position = UDim2.fromScale(0.52, 0.21)
	list.Size = UDim2.fromScale(0.46, 0.76)
	list.BackgroundTransparency = 1
	list.BorderSizePixel = 0
	list.ScrollBarThickness = 6
	list.CanvasSize = UDim2.new()
	list.AutomaticCanvasSize = Enum.AutomaticSize.Y
	local listLayout = Instance.new("UIListLayout")
	listLayout.Padding = UDim.new(0, 6)
	listLayout.SortOrder = Enum.SortOrder.LayoutOrder
	listLayout.Parent = list
	list.Parent = book
	freeList = list

	book.Parent = gui
	panel = book

	ContextActionService:BindAction("ToggleLedger", function(_name, state)
		if state == Enum.UserInputState.Begin then
			LedgerUI.toggle()
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.B)

	gui.Parent = playerGui
end

function LedgerUI.render(view: View)
	local grid = slotGrid
	local list = freeList
	if grid == nil or list == nil then
		return
	end
	if progressLabel ~= nil then
		progressLabel.Text = "Relics: "
			.. view.progressText
			.. (if view.complete then " (complete!)" else "")
	end
	if freeLabel ~= nil then
		freeLabel.Text = "Free slots: " .. view.freeText
	end
	if vaultLabel ~= nil then
		vaultLabel.Text = "Vault: " .. view.vaultText
	end

	lastComplete = view.complete
	drawCrown()

	clearRows(grid)
	for index, slot in view.slots do
		makeSlot(slot, index).Parent = grid
	end
	clearRows(list)
	for _, card in view.free do
		makeFreeRow(card).Parent = list
	end
end

-- The player's Crowns and Stars attributes (nil while not set yet).
function LedgerUI.setCrown(crowns: number?, stars: number?)
	shownCrowns = crowns
	shownStars = stars
	drawCrown()
end

function LedgerUI.isOpen(): boolean
	local book = panel
	return book ~= nil and book.Visible
end

function LedgerUI.toggle()
	local book = panel
	if book ~= nil then
		book.Visible = not book.Visible
	end
end

return LedgerUI
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="114">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--!strict
print("[IsleOfAvarice] client started")

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Rules = Shared:WaitForChild("Rules")
local Net = require(Shared:WaitForChild("Net"))
local Messages = require(Shared:WaitForChild("Catalog"):WaitForChild("Messages"))
local LedgerView = require(Rules:WaitForChild("LedgerView"))
local PathView = require(Rules:WaitForChild("PathView"))
local PlaceView = require(Rules:WaitForChild("PlaceView"))
local Rounds = require(Rules:WaitForChild("Rounds"))
local Protection = require(Rules:WaitForChild("Protection"))
local StatusView = require(Rules:WaitForChild("StatusView"))
local TrialView = require(Rules:WaitForChild("TrialView"))
local World = require(Shared:WaitForChild("Catalog"):WaitForChild("World"))
local Atmosphere = require(script.Parent.Atmosphere)
local ClaimUI = require(script.Parent.ClaimUI)
local CeremonyUI = require(script.Parent.CeremonyUI)
local CombatController = require(script.Parent.CombatController)
local CreatureFx = require(script.Parent.CreatureFx)
local EdictUI = require(script.Parent.EdictUI)
local HazardController = require(script.Parent.HazardController)
local LedgerUI = require(script.Parent.LedgerUI)
local AbilityBar = require(script.Parent.AbilityBar)
local PartyUI = require(script.Parent.PartyUI)
local PathUI = require(script.Parent.PathUI)
local RenounceUI = require(script.Parent.RenounceUI)
local ShopUI = require(script.Parent.ShopUI)
local StatusHUD = require(script.Parent.StatusHUD)
local Toast = require(script.Parent.Toast)
local TradeUI = require(script.Parent.TradeUI)
local TrialUI = require(script.Parent.TrialUI)

local HUD_REFRESH_SECONDS = 0.5

local remotes = ReplicatedStorage:WaitForChild(Net.FOLDER)
local ledgerSync = remotes:WaitForChild(Net.LedgerSync) :: RemoteEvent
local ledgerAction = remotes:WaitForChild(Net.LedgerAction) :: RemoteEvent
local ledgerRequest = remotes:WaitForChild(Net.LedgerRequest) :: RemoteEvent
local notify = remotes:WaitForChild(Net.Notify) :: RemoteEvent
local vaultAction = remotes:WaitForChild(Net.VaultAction) :: RemoteEvent
local statusSync = remotes:WaitForChild(Net.StatusSync) :: RemoteEvent
local shieldDrop = remotes:WaitForChild(Net.ShieldDrop) :: RemoteEvent
local strikeRemote = remotes:WaitForChild(Net.Strike) :: RemoteEvent
local hitFx = remotes:WaitForChild(Net.HitFx) :: RemoteEvent
local claimUpdate = remotes:WaitForChild(Net.ClaimUpdate) :: RemoteEvent
local claimPick = remotes:WaitForChild(Net.ClaimPick) :: RemoteEvent
local pathSync = remotes:WaitForChild(Net.PathSync) :: RemoteEvent
local pickCalling = remotes:WaitForChild(Net.PickCalling) :: RemoteEvent
local changeCalling = remotes:WaitForChild(Net.ChangeCalling) :: RemoteEvent
local loadoutAction = remotes:WaitForChild(Net.LoadoutAction) :: RemoteEvent
local castAbility = remotes:WaitForChild(Net.CastAbility) :: RemoteEvent
local abilityCooldown = remotes:WaitForChild(Net.AbilityCooldown) :: RemoteEvent
local trialOffer = remotes:WaitForChild(Net.TrialOffer) :: RemoteEvent
local trialAccept = remotes:WaitForChild(Net.TrialAccept) :: RemoteEvent
local trialSync = remotes:WaitForChild(Net.TrialSync) :: RemoteEvent
local coinSync = remotes:WaitForChild(Net.CoinSync) :: RemoteEvent
local edictUse = remotes:WaitForChild(Net.EdictUse) :: RemoteEvent
local edictResult = remotes:WaitForChild(Net.EdictResult) :: RemoteEvent
local edictSync = remotes:WaitForChild(Net.EdictSync) :: RemoteEvent
local shopOpen = remotes:WaitForChild(Net.ShopOpen) :: RemoteEvent
local shopAction = remotes:WaitForChild(Net.ShopAction) :: RemoteEvent
local tradeRequest = remotes:WaitForChild(Net.TradeRequest) :: RemoteEvent
local tradeInvite = remotes:WaitForChild(Net.TradeInvite) :: RemoteEvent
local tradeReply = remotes:WaitForChild(Net.TradeReply) :: RemoteEvent
local tradeAction = remotes:WaitForChild(Net.TradeAction) :: RemoteEvent
local tradeSync = remotes:WaitForChild(Net.TradeSync) :: RemoteEvent
local partyRequest = remotes:WaitForChild(Net.PartyRequest) :: RemoteEvent
local partyInvite = remotes:WaitForChild(Net.PartyInvite) :: RemoteEvent
local partyReply = remotes:WaitForChild(Net.PartyReply) :: RemoteEvent
local partyAction = remotes:WaitForChild(Net.PartyAction) :: RemoteEvent
local partySync = remotes:WaitForChild(Net.PartySync) :: RemoteEvent
local ceremonyRemote = remotes:WaitForChild(Net.Ceremony) :: RemoteEvent
local renounceOffer = remotes:WaitForChild(Net.RenounceOffer) :: RemoteEvent
local renounceAction = remotes:WaitForChild(Net.RenounceAction) :: RemoteEvent

local localPlayer = Players.LocalPlayer
local playerGui = localPlayer:WaitForChild("PlayerGui") :: PlayerGui

LedgerUI.mount(playerGui, function(request)
	ledgerAction:FireServer(request)
end, function(request)
	vaultAction:FireServer(request)
end)
LedgerUI.setUseHandler(EdictUI.use)
Toast.mount(playerGui)
StatusHUD.mount(playerGui, function()
	shieldDrop:FireServer()
end)
ClaimUI.mount(playerGui, function(slot)
	claimPick:FireServer(slot)
end)
PathUI.mount(playerGui, {
	pick = function(path)
		pickCalling:FireServer(path)
	end,
	change = function(path)
		changeCalling:FireServer(path)
	end,
	loadout = function(request)
		loadoutAction:FireServer(request)
	end,
})
AbilityBar.mount(playerGui, function(slot)
	castAbility:FireServer(slot)
end)
TrialUI.mount(playerGui, function(trialId)
	trialAccept:FireServer(trialId)
end)
EdictUI.mount(playerGui, function(request)
	edictUse:FireServer(request)
end)
ShopUI.mount(playerGui, function(request)
	shopAction:FireServer(request)
end)
TradeUI.mount(playerGui, {
	request = function()
		tradeRequest:FireServer()
	end,
	reply = function(accept)
		tradeReply:FireServer(accept)
	end,
	action = function(request)
		tradeAction:FireServer(request)
	end,
})
PartyUI.mount(playerGui, {
	request = function()
		partyRequest:FireServer()
	end,
	reply = function(accept)
		partyReply:FireServer(accept)
	end,
	action = function(request)
		partyAction:FireServer(request)
	end,
})
RenounceUI.mount(playerGui, function(request)
	renounceAction:FireServer(request)
end)
CeremonyUI.mount(playerGui)
CombatController.start(function()
	strikeRemote:FireServer()
end, function(slot)
	castAbility:FireServer(slot)
end, function()
	return LedgerUI.isOpen()
		or ClaimUI.isOpen()
		or PathUI.isOpen()
		or TrialUI.isOpen()
		or EdictUI.isOpen()
		or ShopUI.isOpen()
		or TradeUI.isOpen()
		or RenounceUI.isOpen()
end)
HazardController.start()
CreatureFx.start(localPlayer)

-- The Tally Stone's Renounce prompt is enabled on this client only while Crowned this run
-- with a complete Ledger. The server checks again on every use.
local ledgerComplete = false
local renouncePrompt: ProximityPrompt? = nil
local function refreshRenouncePrompt()
	local prompt = renouncePrompt
	if prompt ~= nil then
		local crowns = localPlayer:GetAttribute("Crowns")
		local stars = localPlayer:GetAttribute("Stars")
		prompt.Enabled = ledgerComplete
			and type(crowns) == "number"
			and type(stars) == "number"
			and crowns > stars
	end
end

ledgerSync.OnClientEvent:Connect(function(ledger, vault)
	local view = LedgerView.build(ledger, vault)
	LedgerUI.render(view)
	ledgerComplete = view.complete
	refreshRenouncePrompt()
end)
notify.OnClientEvent:Connect(function(code, args)
	Toast.show(Messages.format(code, args))
end)
claimUpdate.OnClientEvent:Connect(function(payload)
	if payload == nil then
		ClaimUI.hide()
	else
		ClaimUI.show(payload.victimName, payload.claim, payload.secondsLeft)
	end
end)
hitFx.OnClientEvent:Connect(function(fighterId)
	-- A player's character flashes; any other id is a creature's.
	local victim = Players:GetPlayerByUserId(fighterId)
	if victim ~= nil then
		local character = victim.Character
		if character ~= nil then
			CombatController.flash(character)
		end
	else
		CreatureFx.flash(fighterId)
	end
end)
trialOffer.OnClientEvent:Connect(function(view)
	TrialUI.showOffer(view)
end)
edictResult.OnClientEvent:Connect(function(result)
	EdictUI.showResult(result)
end)
shopOpen.OnClientEvent:Connect(function(view)
	ShopUI.show(view)
end)
tradeInvite.OnClientEvent:Connect(function(invite)
	TradeUI.showInvite(invite)
end)
tradeSync.OnClientEvent:Connect(function(view)
	TradeUI.render(view)
end)
partyInvite.OnClientEvent:Connect(function(invite)
	PartyUI.showInvite(invite)
end)
partySync.OnClientEvent:Connect(function(view)
	PartyUI.setParty(view)
end)

ceremonyRemote.OnClientEvent:Connect(function(ceremony)
	CeremonyUI.show(ceremony)
end)
renounceOffer.OnClientEvent:Connect(function(offer)
	RenounceUI.show(offer)
end)

local function refreshCrown()
	local crowns = localPlayer:GetAttribute("Crowns")
	local stars = localPlayer:GetAttribute("Stars")
	LedgerUI.setCrown(
		if type(crowns) == "number" then crowns else nil,
		if type(stars) == "number" then stars else nil
	)
	refreshRenouncePrompt()
end
localPlayer:GetAttributeChangedSignal("Crowns"):Connect(refreshCrown)
localPlayer:GetAttributeChangedSignal("Stars"):Connect(refreshCrown)
refreshCrown()
task.spawn(function()
	local island = workspace:WaitForChild("Island")
	local town = island:WaitForChild("Tallyport")
	local stone = town:WaitForChild("TallyStone"):WaitForChild("Stone")
	local prompt = stone:WaitForChild("RenouncePrompt")
	if prompt:IsA("ProximityPrompt") then
		renouncePrompt = prompt
		refreshRenouncePrompt()
	end
end)

-- The Veil's seconds left when the last sync arrived (local clock); it counts down here.
local veilSeconds = 0
local veilAt = 0
edictSync.OnClientEvent:Connect(function(seconds, met)
	veilSeconds = seconds
	veilAt = os.clock()
	EdictUI.setMet(met)
end)

-- The last path sync and when it arrived (local clock); cooldown text advances from it.
local lastPaths: any = nil
local lastCoin = 0
local lastServerNow = 0
local pathsAt = 0
local function renderPaths()
	if lastPaths ~= nil then
		local now = lastServerNow + (os.clock() - pathsAt)
		local view = PathView.build(lastPaths, lastCoin, now)
		PathUI.render(view)
		AbilityBar.render(view.slots)
	end
end
pathSync.OnClientEvent:Connect(function(progress, coin, serverNow)
	lastPaths = progress
	lastCoin = coin
	lastServerNow = serverNow
	pathsAt = os.clock()
	StatusHUD.setCoin(coin)
	renderPaths()
end)
-- Coin changed (a creature, a trial, a Calling change): the Coin line and the Paths panel.
coinSync.OnClientEvent:Connect(function(coin)
	lastCoin = coin
	StatusHUD.setCoin(coin)
	renderPaths()
end)

-- The last trial sync and when it arrived (local clock); the trial clock counts down here.
local trialState: TrialView.HudState? = nil
local questStep = 0
-- The rounds record from the last TrialSync; Rounds.line sanitises whatever arrived.
local roundsRecord: any = nil
local trialAt = 0
local function renderTrial()
	local state = trialState
	local shown: TrialView.HudState? = nil
	local nextMarker = nil
	if state ~= nil then
		shown = {
			trialId = state.trialId,
			progress = state.progress,
			goal = state.goal,
			secondsLeft = state.secondsLeft - (os.clock() - trialAt),
		}
		local markers = World.courses[state.trialId]
		if markers ~= nil then
			nextMarker = markers[state.progress + 1]
		end
	end
	local lines = TrialView.hud(shown, questStep)
	table.insert(lines, Rounds.line(roundsRecord))
	TrialUI.renderHud(lines)
	TrialUI.setBeacon(nextMarker)
end
trialSync.OnClientEvent:Connect(function(state, step, rounds)
	trialState = state
	questStep = step
	roundsRecord = rounds
	trialAt = os.clock()
	renderTrial()
end)
abilityCooldown.OnClientEvent:Connect(function(slot, seconds)
	AbilityBar.startCooldown(slot, seconds)
end)
task.spawn(function()
	while true do
		task.wait(60)
		renderPaths()
	end
end)

-- The last status from the server and when it arrived (local clock). Timers count down here.
local lastStatus: StatusView.Status? = nil
local statusAt = 0
statusSync.OnClientEvent:Connect(function(status)
	lastStatus = status
	statusAt = os.clock()
end)

local function localRoot(): BasePart?
	local character = localPlayer.Character
	local root = if character ~= nil then character:FindFirstChild("HumanoidRootPart") else nil
	if root == nil or not root:IsA("BasePart") then
		return nil
	end
	return root
end

local function localInSafeZone(): boolean
	local root = localRoot()
	if root == nil then
		return false
	end
	local p = root.Position
	return Protection.inSafeZone({ x = p.X, y = p.Y, z = p.Z })
end

-- The region and active hazards at the local character, or nil while it has none.
local function localPlace(): PlaceView.Place?
	local root = localRoot()
	if root == nil then
		return nil
	end
	local p = root.Position
	return PlaceView.at(p.X, p.Z, workspace:GetServerTimeNow())
end

-- The region last shown. Entering a new one changes the fog and shows its name and hint.
local lastRegionId: string? = nil

local function refreshHud()
	local status = lastStatus
	local shown: StatusView.Status? = nil
	if status ~= nil then
		local elapsed = os.clock() - statusAt
		shown = {
			newShield = status.newShield,
			respawnShieldSeconds = math.max(0, status.respawnShieldSeconds - elapsed),
			markedSeconds = math.max(0, status.markedSeconds - elapsed),
		}
	end
	local place = localPlace()
	if place ~= nil and place.regionId ~= lastRegionId then
		lastRegionId = place.regionId
		Atmosphere.set(place.regionId)
		Toast.show(place.name .. ": " .. place.hint)
	end
	StatusHUD.render(
		StatusView.build(
			shown,
			localInSafeZone(),
			place,
			math.max(0, veilSeconds - (os.clock() - veilAt))
		),
		shown ~= nil and shown.newShield
	)
end

task.spawn(function()
	while true do
		refreshHud()
		renderTrial()
		PartyUI.refresh(localPlayer)
		task.wait(HUD_REFRESH_SECONDS)
	end
end)

-- The first sync may have fired before this script connected; ask again.
ledgerRequest:FireServer()
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="115">
          <Properties>
            <string name="Name">PartyUI</string>
            <string name="Source"><![CDATA[--!strict
-- Parties: the "Party" button, the invite banner, the party panel and the ally markers. It shows
-- what the server sent and names things in its requests; the server checks every one.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local PartyView = require(Shared:WaitForChild("Rules"):WaitForChild("PartyView"))
local Crown = require(Shared:WaitForChild("Rules"):WaitForChild("Crown"))

local TEXT_LIGHT = Color3.fromRGB(245, 235, 210)
local PANEL_COLOR = Color3.fromRGB(32, 28, 38)
local ROW_COLOR = Color3.fromRGB(42, 37, 50)
local BUTTON_COLOR = Color3.fromRGB(70, 60, 90)
local ACCEPT_COLOR = Color3.fromRGB(60, 130, 80)
local BAR_BACK_COLOR = Color3.fromRGB(20, 18, 24)
local BAR_COLOR = Color3.fromRGB(80, 190, 110)
local ALLY_COLOR = Color3.fromRGB(110, 220, 140)
local TITLE_COLOR = Color3.fromRGB(255, 215, 90)

local PANEL_WIDTH = 280
local PANEL_PAD = 8
local TITLE_HEIGHT = 26
local ROW_HEIGHT = 48
local ROW_GAP = 4
local LEAVE_WIDTH = 64
-- Kept free below the panel so it never reaches the bottom edge of the screen.
local PANEL_BOTTOM_MARGIN = 12
-- The trial HUD at the top right is four 28-pixel lines with 4 between (128); stay under it.
local PANEL_TOP_OFFSET = 146
-- A refused request sends only a message, not a sync; buttons come back after this long.
local REARM_SECONDS = 1

local PartyUI = {}

type Handlers = {
	request: () -> (),
	reply: (accept: boolean) -> (),
	action: (request: { [string]: any }) -> (),
}

local handlers: Handlers = {
	request = function() end,
	reply = function(_accept: boolean) end,
	action = function(_request: { [string]: any }) end,
}
local inviteBanner: Frame? = nil
local inviteLabel: TextLabel? = nil
local panel: Frame? = nil
local titleLabel: TextLabel? = nil
local rowsFrame: ScrollingFrame? = nil
local leaveButton: TextButton? = nil
local screenGui: ScreenGui? = nil
-- The drawn rows by member id, so health updates in place.
local rowFrames: { [number]: Frame } = {}
-- Bumped on every invite change, so an old invite's timer cannot hide a newer one.
local inviteToken = 0

local current: PartyView.Sync? = nil
local selfId = 0
-- Who is drawn, in what order, with which buttons, as one string: rows are rebuilt only when
-- it changes; health changes update the rows in place.
local drawnKey = ""
-- One request per render: set on a click, cleared by the next sync or the re-arm timer.
local pending = false
local pendingToken = 0
local markers: { [number]: BillboardGui } = {}

local function addCorner(parent: Instance, radius: number)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius)
	corner.Parent = parent
end

local function limitText(parent: Instance, minSize: number, maxSize: number)
	local constraint = Instance.new("UITextSizeConstraint")
	constraint.MinTextSize = minSize
	constraint.MaxTextSize = maxSize
	constraint.Parent = parent
end

local function makeLabel(
	name: string,
	text: string,
	size: UDim2,
	position: UDim2,
	maxText: number
): TextLabel
	local label = Instance.new("TextLabel")
	label.Name = name
	label.Size = size
	label.Position = position
	label.BackgroundTransparency = 1
	label.TextColor3 = TEXT_LIGHT
	label.TextScaled = true
	label.TextWrapped = true
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Font = Enum.Font.GothamMedium
	label.Text = text
	limitText(label, 9, maxText)
	return label
end

local function makeButton(name: string, text: string, color: Color3): TextButton
	local button = Instance.new("TextButton")
	button.Name = name
	button.BackgroundColor3 = color
	button.TextColor3 = TEXT_LIGHT
	button.TextScaled = true
	button.Font = Enum.Font.GothamBold
	button.Text = text
	addCorner(button, 8)
	limitText(button, 9, 20)
	return button
end

-- Dimmed and inert unless `enabled`, as in the trade window.
local function setEnabled(button: TextButton, enabled: boolean)
	button.Active = enabled
	button.AutoButtonColor = enabled
	button.BackgroundTransparency = if enabled then 0 else 0.6
	button.TextTransparency = if enabled then 0 else 0.5
end

-- Destroys the children of the given class (the rows, not the list layout).
local function clearChildren(container: Instance, className: string)
	for _, child in container:GetChildren() do
		if child:IsA(className) then
			child:Destroy()
		end
	end
end

-- Every panel button, so one click can make them all inert.
local function setPanelEnabled(enabled: boolean)
	local rows = rowsFrame
	if rows ~= nil then
		for _, row in rows:GetChildren() do
			for _, child in row:GetChildren() do
				if child:IsA("TextButton") then
					setEnabled(child, enabled)
				end
			end
		end
	end
	if leaveButton ~= nil then
		setEnabled(leaveButton, enabled)
	end
end

-- Sends one request, then waits for the next sync (or one second) before another.
local function send(request: { [string]: any })
	if pending then
		return
	end
	pending = true
	pendingToken += 1
	local token = pendingToken
	setPanelEnabled(false)
	handlers.action(request)
	task.delay(REARM_SECONDS, function()
		if pendingToken == token and pending then
			pending = false
			setPanelEnabled(true)
		end
	end)
end

local function hideInvite()
	inviteToken += 1
	local banner = inviteBanner
	if banner ~= nil then
		banner.Visible = false
	end
end

local function buildInvite(gui: ScreenGui)
	local banner = Instance.new("Frame")
	banner.Name = "Invite"
	banner.AnchorPoint = Vector2.new(0.5, 0)
	-- Below the trade banner (12% to 21%) so both can show.
	banner.Position = UDim2.fromScale(0.5, 0.22)
	banner.Size = UDim2.fromScale(0.5, 0.09)
	banner.BackgroundColor3 = PANEL_COLOR
	banner.Visible = false
	addCorner(banner, 10)
	local minimum = Instance.new("UISizeConstraint")
	minimum.MinSize = Vector2.new(300, 44)
	minimum.Parent = banner

	local label = makeLabel("Text", "", UDim2.fromScale(0.44, 0.8), UDim2.fromScale(0.03, 0.1), 20)
	label.Parent = banner
	inviteLabel = label

	local accept = makeButton("Accept", "Accept", ACCEPT_COLOR)
	accept.Position = UDim2.fromScale(0.49, 0.12)
	accept.Size = UDim2.fromScale(0.24, 0.76)
	accept.Activated:Connect(function()
		hideInvite()
		handlers.reply(true)
	end)
	accept.Parent = banner

	local decline = makeButton("Decline", "Decline", BUTTON_COLOR)
	decline.Position = UDim2.fromScale(0.74, 0.12)
	decline.Size = UDim2.fromScale(0.24, 0.76)
	decline.Activated:Connect(function()
		hideInvite()
		handlers.reply(false)
	end)
	decline.Parent = banner

	banner.Parent = gui
	inviteBanner = banner
end

local function buildPanel(gui: ScreenGui)
	local frame = Instance.new("Frame")
	frame.Name = "Panel"
	-- Under the trial HUD (anchor top right, 16% down, 128 pixels tall).
	frame.AnchorPoint = Vector2.new(1, 0)
	frame.Position = UDim2.new(1, -12, 0.16, PANEL_TOP_OFFSET)
	frame.Size = UDim2.fromOffset(PANEL_WIDTH, 100)
	frame.BackgroundColor3 = PANEL_COLOR
	frame.BackgroundTransparency = 0.15
	frame.Visible = false
	addCorner(frame, 10)
	local minimum = Instance.new("UISizeConstraint")
	minimum.MinSize = Vector2.new(PANEL_WIDTH, 0)
	minimum.Parent = frame

	local title = makeLabel(
		"Title",
		"",
		UDim2.new(1, -(3 * PANEL_PAD + LEAVE_WIDTH), 0, TITLE_HEIGHT),
		UDim2.fromOffset(PANEL_PAD, PANEL_PAD),
		20
	)
	title.Font = Enum.Font.GothamBold
	title.Parent = frame
	titleLabel = title

	-- In the title row, so it shows whenever the panel does.
	local leave = makeButton("Leave", "Leave", BUTTON_COLOR)
	leave.AnchorPoint = Vector2.new(1, 0)
	leave.Position = UDim2.new(1, -PANEL_PAD, 0, PANEL_PAD)
	leave.Size = UDim2.fromOffset(LEAVE_WIDTH, TITLE_HEIGHT)
	leave.Activated:Connect(function()
		send({ kind = "leave" })
	end)
	leave.Parent = frame
	leaveButton = leave

	local rows = Instance.new("ScrollingFrame")
	rows.Name = "Rows"
	rows.BackgroundTransparency = 1
	rows.BorderSizePixel = 0
	rows.Position = UDim2.fromOffset(PANEL_PAD, PANEL_PAD + TITLE_HEIGHT + ROW_GAP)
	rows.Size = UDim2.new(1, -2 * PANEL_PAD, 0, 0)
	rows.CanvasSize = UDim2.new()
	rows.AutomaticCanvasSize = Enum.AutomaticSize.Y
	rows.ScrollingDirection = Enum.ScrollingDirection.Y
	rows.ScrollBarThickness = 4
	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, ROW_GAP)
	layout.Parent = rows
	rows.Parent = frame
	rowsFrame = rows

	frame.Parent = gui
	panel = frame
end

-- The Crowned title of a member, from the attributes the server keeps on their Player (empty
-- when not Crowned or when the Player is gone).
local function titleOf(userId: number): string
	local player = Players:GetPlayerByUserId(userId)
	if player == nil then
		return ""
	end
	return Crown.title(player:GetAttribute("Crowns"), player:GetAttribute("Stars"))
end

local function buildRow(row: PartyView.Row, index: number, parent: Instance)
	local frame = Instance.new("Frame")
	frame.Name = "Row" .. row.userId
	frame.LayoutOrder = index
	-- Leaves room for the scroll bar.
	frame.Size = UDim2.new(1, -6, 0, ROW_HEIGHT)
	frame.BackgroundColor3 = ROW_COLOR
	addCorner(frame, 8)

	local name = makeLabel("Name", row.name, UDim2.fromOffset(98, 18), UDim2.fromOffset(6, 3), 14)
	name.Parent = frame

	local health =
		makeLabel("Health", row.healthText, UDim2.fromOffset(60, 18), UDim2.fromOffset(104, 3), 14)
	health.TextXAlignment = Enum.TextXAlignment.Right
	health.Parent = frame

	-- Under the name; empty (and so invisible) unless the member is Crowned.
	local crowned = makeLabel(
		"Title",
		titleOf(row.userId),
		UDim2.new(1, -12, 0, 14),
		UDim2.fromOffset(6, 22),
		12
	)
	crowned.TextColor3 = TITLE_COLOR
	crowned.Parent = frame

	local bar = Instance.new("Frame")
	bar.Name = "Bar"
	bar.Position = UDim2.fromOffset(6, 38)
	bar.Size = UDim2.new(1, -12, 0, 6)
	bar.BackgroundColor3 = BAR_BACK_COLOR
	addCorner(bar, 3)
	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(row.share, 1)
	fill.BackgroundColor3 = BAR_COLOR
	addCorner(fill, 3)
	fill.Parent = bar
	bar.Parent = frame

	if row.canRemove then
		local remove = makeButton("Remove", "Remove", BUTTON_COLOR)
		remove.AnchorPoint = Vector2.new(1, 0)
		remove.Position = UDim2.new(1, -4, 0, 3)
		remove.Size = UDim2.fromOffset(46, 18)
		setEnabled(remove, not pending)
		remove.Activated:Connect(function()
			send({ kind = "kick", userId = row.userId })
		end)
		remove.Parent = frame
	end
	if row.canLead then
		local lead = makeButton("MakeLeader", "Lead", BUTTON_COLOR)
		lead.AnchorPoint = Vector2.new(1, 0)
		lead.Position = UDim2.new(1, -54, 0, 3)
		lead.Size = UDim2.fromOffset(40, 18)
		setEnabled(lead, not pending)
		lead.Activated:Connect(function()
			send({ kind = "promote", userId = row.userId })
		end)
		lead.Parent = frame
	end
	frame.Parent = parent
	rowFrames[row.userId] = frame
end

local function removeMarker(userId: number)
	local marker = markers[userId]
	if marker ~= nil then
		marker:Destroy()
		markers[userId] = nil
	end
end

local function clearMarkers()
	for userId in markers do
		removeMarker(userId)
	end
end

local function makeMarker(userId: number, name: string, head: BasePart, character: Model)
	local gui = Instance.new("BillboardGui")
	gui.Name = "AllyMarker_" .. userId
	gui.Adornee = head
	gui.AlwaysOnTop = true
	gui.MaxDistance = 250
	-- Above the MARKED tag.
	gui.StudsOffset = Vector3.new(0, 4, 0)
	gui.Size = UDim2.fromOffset(140, 26)
	local label = makeLabel("Label", name, UDim2.fromScale(1, 1), UDim2.new(), 20)
	label.TextColor3 = ALLY_COLOR
	label.TextXAlignment = Enum.TextXAlignment.Center
	label.Font = Enum.Font.GothamBold
	label.TextStrokeTransparency = 0.4
	label.Parent = gui
	gui.Parent = character
	markers[userId] = gui
end

-- One marker per ally whose character has a Head; re-pointed after a respawn, dropped when the
-- ally leaves the party. The name is the plain one from the last sync.
local function updateMarkers(sync: PartyView.Sync)
	local wanted: { [number]: boolean } = {}
	for _, userId in PartyView.allyIds(sync, selfId) do
		local name = ""
		for _, member in sync.members do
			if member.userId == userId then
				name = member.name
			end
		end
		local player = Players:GetPlayerByUserId(userId)
		local character = if player ~= nil then player.Character else nil
		local head = if character ~= nil then character:FindFirstChild("Head") else nil
		if character ~= nil and head ~= nil and head:IsA("BasePart") then
			wanted[userId] = true
			local marker = markers[userId]
			if marker ~= nil and (marker.Adornee ~= head or marker.Parent ~= character) then
				removeMarker(userId)
				marker = nil
			end
			if marker == nil then
				makeMarker(userId, name, head, character)
			else
				local label = marker:FindFirstChild("Label")
				if label ~= nil and label:IsA("TextLabel") and label.Text ~= name then
					label.Text = name
				end
			end
		end
	end
	for userId in markers do
		if not wanted[userId] then
			removeMarker(userId)
		end
	end
end

-- Each member's health from their character, if it has one; a missing entry shows as unknown.
local function readHealths(sync: PartyView.Sync): { [string]: PartyView.Health }
	local healths: { [string]: PartyView.Health } = {}
	for _, member in sync.members do
		local player = Players:GetPlayerByUserId(member.userId)
		local character = if player ~= nil then player.Character else nil
		local humanoid = if character ~= nil
			then character:FindFirstChildOfClass("Humanoid")
			else nil
		if humanoid ~= nil then
			healths[tostring(member.userId)] =
				{ health = humanoid.Health, max = humanoid.MaxHealth }
		end
	end
	return healths
end

-- What decides the rows' shape: who, in what order, the leader mark and the buttons. Health is
-- not part of it.
local function rowsKey(rows: { PartyView.Row }): string
	local parts: { string } = {}
	for _, row in rows do
		table.insert(
			parts,
			string.format(
				"%d|%s|%s|%s",
				row.userId,
				row.name,
				tostring(row.canRemove),
				tostring(row.canLead)
			)
		)
	end
	return table.concat(parts, ";")
end

-- Sets the panel's height: all the rows, but no lower than the screen allows (the rows then
-- scroll, and the title row with Leave stays on screen).
local function sizePanel(frame: Frame, rowsHolder: ScrollingFrame, count: number)
	local wanted = count * (ROW_HEIGHT + ROW_GAP) - ROW_GAP
	local fixed = PANEL_PAD + TITLE_HEIGHT + ROW_GAP + PANEL_PAD
	local gui = screenGui
	local height = if gui ~= nil then gui.AbsoluteSize.Y else 0
	local rowsHeight = wanted
	if height > 0 then
		local top = 0.16 * height + PANEL_TOP_OFFSET
		local room = height - top - PANEL_BOTTOM_MARGIN - fixed
		rowsHeight = math.min(wanted, math.max(room, ROW_HEIGHT))
	end
	rowsHolder.Size = UDim2.new(1, -2 * PANEL_PAD, 0, rowsHeight)
	frame.Size = UDim2.fromOffset(PANEL_WIDTH, fixed + rowsHeight)
end

-- Redraws the panel and markers from the current party. Rows are rebuilt only when who is in
-- the party, the order, the leader or the viewer's buttons changed; otherwise each row's health
-- text and bar are updated where they stand, so a tap on a button is never lost to a rebuild.
local function redraw()
	local frame = panel
	local rowsHolder = rowsFrame
	local sync = current
	if frame == nil or rowsHolder == nil or sync == nil then
		return
	end
	local rows = PartyView.rows(sync, selfId, readHealths(sync))
	local key = rowsKey(rows)
	if titleLabel ~= nil then
		local title = PartyView.title(sync)
		if titleLabel.Text ~= title then
			titleLabel.Text = title
		end
	end
	if key ~= drawnKey then
		drawnKey = key
		clearChildren(rowsHolder, "Frame")
		table.clear(rowFrames)
		for index, row in rows do
			buildRow(row, index, rowsHolder)
		end
	else
		for _, row in rows do
			local frameOfRow = rowFrames[row.userId]
			if frameOfRow == nil then
				continue
			end
			local health = frameOfRow:FindFirstChild("Health")
			if health ~= nil and health:IsA("TextLabel") and health.Text ~= row.healthText then
				health.Text = row.healthText
			end
			-- Titles can change without a rebuild.
			local crowned = frameOfRow:FindFirstChild("Title")
			if crowned ~= nil and crowned:IsA("TextLabel") then
				local title = titleOf(row.userId)
				if crowned.Text ~= title then
					crowned.Text = title
				end
			end
			local bar = frameOfRow:FindFirstChild("Bar")
			local fill = if bar ~= nil then bar:FindFirstChild("Fill") else nil
			if fill ~= nil and fill:IsA("Frame") then
				fill.Size = UDim2.fromScale(row.share, 1)
			end
		end
	end
	sizePanel(frame, rowsHolder, #rows)
	frame.Visible = true
	updateMarkers(sync)
end

function PartyUI.mount(playerGui: PlayerGui, given: Handlers)
	handlers = given
	selfId = Players.LocalPlayer.UserId

	local gui = Instance.new("ScreenGui")
	gui.Name = "PartyGui"
	gui.ResetOnSpawn = false
	-- With the other windows; below the messages (20).
	gui.DisplayOrder = 16
	screenGui = gui

	-- Above the Trade button: the Ledger button fills 90% to 97% (bottom left), Paths 82% to 89%,
	-- Trade 74% to 81%, and this one 66% to 73%.
	local button = makeButton("PartyButton", "Party", BUTTON_COLOR)
	button.AnchorPoint = Vector2.new(0, 1)
	button.Position = UDim2.fromScale(0.02, 0.73)
	button.Size = UDim2.fromScale(0.14, 0.07)
	local limit = button:FindFirstChildOfClass("UITextSizeConstraint")
	if limit ~= nil then
		limit.MinTextSize = 12
	end
	button.Activated:Connect(function()
		handlers.request()
	end)
	button.Parent = gui

	buildInvite(gui)
	buildPanel(gui)
	gui.Parent = playerGui
end

-- A banner asking to join a party; it goes away by itself after `seconds`. nil hides it.
function PartyUI.showInvite(invite: { from: string, seconds: number }?)
	local banner = inviteBanner
	local label = inviteLabel
	if banner == nil or label == nil then
		return
	end
	hideInvite()
	if invite == nil then
		return
	end
	label.Text = PartyView.inviteText(invite.from)
	banner.Visible = true
	local token = inviteToken
	task.delay(invite.seconds, function()
		if inviteToken == token then
			hideInvite()
		end
	end)
end

-- The party as the server sees it. nil hides the panel and removes every marker.
function PartyUI.setParty(sync: PartyView.Sync?)
	current = sync
	-- A new sync answers whatever was sent: the buttons come back.
	pending = false
	pendingToken += 1
	-- Rows are no longer rebuilt on every sync, so the buttons are re-enabled explicitly.
	setPanelEnabled(true)
	if sync == nil then
		drawnKey = ""
		if panel ~= nil then
			panel.Visible = false
		end
		if rowsFrame ~= nil then
			clearChildren(rowsFrame, "Frame")
		end
		table.clear(rowFrames)
		clearMarkers()
		return
	end
	redraw()
end

-- Called a few times a second: re-reads ally health, updates the rows in place, keeps markers right.
function PartyUI.refresh(localPlayer: Player)
	selfId = localPlayer.UserId
	redraw()
end

return PartyUI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="116">
          <Properties>
            <string name="Name">PathUI</string>
            <string name="Source"><![CDATA[--!strict
-- Calling picker and Paths panel. Renders a PathView and sends requests; the server decides.
local ContextActionService = game:GetService("ContextActionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Paths = require(Shared:WaitForChild("Catalog"):WaitForChild("Paths"))
local PathProgress = require(Shared:WaitForChild("Rules"):WaitForChild("PathProgress"))
local PathView = require(Shared:WaitForChild("Rules"):WaitForChild("PathView"))
local Types = require(Shared:WaitForChild("Types"))

type View = PathView.View
type RowView = PathView.RowView

export type Handlers = {
	pick: (path: string) -> (),
	change: (path: string) -> (),
	loadout: (request: { [string]: any }) -> (),
}

local PathUI = {}

local TEXT_LIGHT = Color3.fromRGB(245, 235, 210)
local TEXT_DIM = Color3.fromRGB(130, 130, 135)
local PANEL_COLOR = Color3.fromRGB(32, 28, 38)
local CARD_COLOR = Color3.fromRGB(46, 40, 56)
local LOCKED_COLOR = Color3.fromRGB(55, 55, 60)
local BUTTON_COLOR = Color3.fromRGB(70, 60, 90)
local DARK_TEXT = Color3.fromRGB(20, 18, 24)
local ROW_HEIGHT = 196
local FALLBACK_COLOR = Color3.fromRGB(120, 120, 130)

local noop = function(_request: any) end
local handlers: Handlers = { pick = noop, change = noop, loadout = noop }

local panel: Frame? = nil
local picker: Frame? = nil
local confirm: Frame? = nil
local confirmQuestion: TextLabel? = nil
local rowList: ScrollingFrame? = nil
local pickerList: ScrollingFrame? = nil
local slotStrip: Frame? = nil
local callingLabel: TextLabel? = nil
local lastView: View? = nil
local pendingChange = ""
local pendingPick = ""
local dismissedPicker = false

local function pathColor(path: string): Color3
	local info = Paths.info[path :: Types.PathId]
	if info == nil then
		return FALLBACK_COLOR
	end
	return Color3.fromRGB(info.color.r, info.color.g, info.color.b)
end

local function addCorner(parent: Instance, radius: number)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius)
	corner.Parent = parent
end

local function limitText(parent: Instance, minSize: number, maxSize: number)
	local constraint = Instance.new("UITextSizeConstraint")
	constraint.MinTextSize = minSize
	constraint.MaxTextSize = maxSize
	constraint.Parent = parent
end

local function makeLabel(name: string, size: UDim2, position: UDim2, maxText: number): TextLabel
	local label = Instance.new("TextLabel")
	label.Name = name
	label.Size = size
	label.Position = position
	label.BackgroundTransparency = 1
	label.TextColor3 = TEXT_LIGHT
	label.TextScaled = true
	label.TextWrapped = true
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Font = Enum.Font.GothamMedium
	label.Text = ""
	limitText(label, 9, maxText)
	return label
end

local function makeButton(name: string, text: string, size: UDim2): TextButton
	local button = Instance.new("TextButton")
	button.Name = name
	button.Size = size
	button.BackgroundColor3 = BUTTON_COLOR
	button.TextColor3 = TEXT_LIGHT
	button.TextScaled = true
	button.Font = Enum.Font.GothamBold
	button.Text = text
	button.AutoButtonColor = true
	addCorner(button, 8)
	limitText(button, 10, 20)
	return button
end

local function makeScroller(name: string, size: UDim2, position: UDim2): ScrollingFrame
	local scroller = Instance.new("ScrollingFrame")
	scroller.Name = name
	scroller.Size = size
	scroller.Position = position
	scroller.BackgroundTransparency = 1
	scroller.BorderSizePixel = 0
	scroller.ScrollBarThickness = 6
	scroller.CanvasSize = UDim2.new()
	scroller.AutomaticCanvasSize = Enum.AutomaticSize.Y
	return scroller
end

local function clearRows(container: Instance)
	for _, child in container:GetChildren() do
		if not child:IsA("UIComponent") then
			child:Destroy()
		end
	end
end

-- The first empty loadout slot, or 4 when all are full (the server decides what happens then).
local function equipSlot(): number
	local view = lastView
	if view ~= nil then
		for _, slot in view.slots do
			if slot.abilityId == "" then
				return slot.slot
			end
		end
	end
	return 4
end

local function askChange(row: RowView)
	local dialog = confirm
	local question = confirmQuestion
	if dialog == nil or question == nil then
		return
	end
	pendingPick = ""
	pendingChange = row.path
	question.Text = "Change your Calling to "
		.. row.name
		.. "? Levels are kept; learning rates change."
	dialog.Visible = true
end

local function askPick(row: RowView)
	local dialog = confirm
	local question = confirmQuestion
	if dialog == nil or question == nil then
		return
	end
	pendingChange = ""
	pendingPick = row.path
	question.Text = "Make " .. row.name .. " your Calling?"
	dialog.Visible = true
end

-- "Learns: Gale, Bulwark 80% · Ember, Mend 60% · Mire 40%": the shared learning rate from this
-- Calling to every other Path, grouped by rate, nearest first.
local function learnsText(path: string): string
	local groups: { { rate: number, names: { string } } } = {}
	for _, other in Paths.order do
		if other == path then
			continue
		end
		local rate = PathProgress.learningRate(path, other)
		local group = nil
		for _, existing in groups do
			if existing.rate == rate then
				group = existing
			end
		end
		if group == nil then
			group = { rate = rate, names = {} }
			table.insert(groups, group)
		end
		table.insert(group.names, Paths.info[other].name)
	end
	table.sort(groups, function(a, b)
		return a.rate > b.rate
	end)
	local parts: { string } = {}
	for _, group in groups do
		table.insert(
			parts,
			table.concat(group.names, ", ") .. " " .. math.floor(group.rate * 100 + 0.5) .. "%"
		)
	end
	return "Learns: " .. table.concat(parts, " · ")
end

local function makeAbility(row: RowView, index: number): Frame
	local ability = row.abilities[index]
	local frame = Instance.new("Frame")
	frame.Name = "Ability" .. ability.id
	frame.Position = UDim2.new(0.01 + (index - 1) * 0.33, 0, 0, 62)
	frame.Size = UDim2.new(0.32, 0, 0, 126)
	frame.BackgroundColor3 = if ability.unlocked then CARD_COLOR else LOCKED_COLOR
	addCorner(frame, 8)

	local name = makeLabel("Name", UDim2.new(0.94, 0, 0, 22), UDim2.new(0.03, 0, 0, 4), 18)
	name.Font = Enum.Font.GothamBold
	name.TextColor3 = if ability.unlocked then TEXT_LIGHT else TEXT_DIM
	name.Text = ability.name
	name.Parent = frame

	local description =
		makeLabel("Description", UDim2.new(0.94, 0, 0, 60), UDim2.new(0.03, 0, 0, 28), 15)
	description.TextYAlignment = Enum.TextYAlignment.Top
	description.TextColor3 = if ability.unlocked then TEXT_LIGHT else TEXT_DIM
	description.Text = ability.description
	description.Parent = frame

	local bottomSize = UDim2.new(0.94, 0, 0, 28)
	local bottomPosition = UDim2.new(0.03, 0, 1, -32)
	if not ability.unlocked then
		local locked = makeLabel("Locked", bottomSize, bottomPosition, 16)
		locked.TextColor3 = TEXT_DIM
		locked.Text = "Level " .. ability.unlockLevel
		locked.Parent = frame
	elseif ability.equippedSlot > 0 then
		local equipped = makeLabel("Equipped", bottomSize, bottomPosition, 16)
		equipped.Text = "Equipped (slot " .. ability.equippedSlot .. ")"
		equipped.Parent = frame
	else
		local equip = makeButton("Equip" .. ability.id, "Equip", bottomSize)
		equip.Position = bottomPosition
		equip.Activated:Connect(function()
			handlers.loadout({ slot = equipSlot(), abilityId = ability.id })
		end)
		equip.Parent = frame
	end
	return frame
end

local function makeRow(row: RowView, order: number, needsCalling: boolean): Frame
	local frame = Instance.new("Frame")
	frame.Name = "Row" .. row.path
	frame.LayoutOrder = order
	frame.Size = UDim2.new(1, -8, 0, ROW_HEIGHT)
	frame.BackgroundColor3 = PANEL_COLOR
	addCorner(frame, 10)
	local stroke = Instance.new("UIStroke")
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Color = pathColor(row.path)
	stroke.Thickness = if row.isCalling then 3 else 1
	stroke.Parent = frame

	local header = makeLabel("Header", UDim2.new(0.6, 0, 0, 28), UDim2.new(0.02, 0, 0, 6), 22)
	header.Font = Enum.Font.GothamBold
	header.TextColor3 = pathColor(row.path)
	header.Text = row.name .. "  Lv " .. row.level .. (if row.isCalling then "  (Calling)" else "")
	header.Parent = frame

	local detail = makeLabel("Detail", UDim2.new(0.96, 0, 0, 22), UDim2.new(0.02, 0, 0, 36), 16)
	detail.Text = row.style .. "  |  XP " .. row.xpText .. "  |  Rate " .. row.rateText
	detail.Parent = frame

	for index = 1, #row.abilities do
		makeAbility(row, index).Parent = frame
	end

	if needsCalling then
		local choose = makeButton("Choose", "Choose", UDim2.new(0.3, 0, 0, 28))
		choose.AnchorPoint = Vector2.new(1, 0)
		choose.Position = UDim2.new(0.98, 0, 0, 6)
		choose.Activated:Connect(function()
			askPick(row)
		end)
		choose.Parent = frame
	elseif row.changeText ~= "" then
		local make = makeButton(
			"MakeCalling",
			"Make Calling (" .. row.changeText .. ")",
			UDim2.new(0.36, 0, 0, 28)
		)
		make.AnchorPoint = Vector2.new(1, 0)
		make.Position = UDim2.new(0.98, 0, 0, 6)
		make.Active = row.canChange
		make.AutoButtonColor = row.canChange
		if not row.canChange then
			make.BackgroundColor3 = LOCKED_COLOR
			make.TextColor3 = TEXT_DIM
		end
		make.Activated:Connect(function()
			if row.canChange then
				askChange(row)
			end
		end)
		make.Parent = frame
	end
	return frame
end

local function makeCard(row: RowView, order: number): Frame
	local card = Instance.new("Frame")
	card.Name = "Card" .. row.path
	card.LayoutOrder = order
	card.BackgroundColor3 = pathColor(row.path)
	addCorner(card, 10)

	local name = makeLabel("Name", UDim2.new(0.92, 0, 0, 26), UDim2.new(0.04, 0, 0, 6), 22)
	name.Font = Enum.Font.GothamBold
	name.TextColor3 = DARK_TEXT
	name.Text = row.name
	name.Parent = card

	local style = makeLabel("Style", UDim2.new(0.92, 0, 0, 20), UDim2.new(0.04, 0, 0, 32), 16)
	style.TextColor3 = DARK_TEXT
	style.Text = row.style
	style.Parent = card

	local lines: { string } = {}
	for _, ability in row.abilities do
		table.insert(lines, ability.name .. ": " .. ability.description)
	end
	local abilities =
		makeLabel("Abilities", UDim2.new(0.92, 0, 1, -128), UDim2.new(0.04, 0, 0, 56), 15)
	abilities.TextYAlignment = Enum.TextYAlignment.Top
	abilities.TextColor3 = DARK_TEXT
	abilities.Text = table.concat(lines, "\n")
	abilities.Parent = card

	local learns = makeLabel("Learns", UDim2.new(0.92, 0, 0, 30), UDim2.new(0.04, 0, 1, -68), 13)
	learns.AnchorPoint = Vector2.new(0, 0)
	learns.TextYAlignment = Enum.TextYAlignment.Top
	learns.TextColor3 = DARK_TEXT
	learns.Text = learnsText(row.path)
	learns.Parent = card

	local choose = makeButton("Choose", "Choose", UDim2.new(0.92, 0, 0, 30))
	choose.AnchorPoint = Vector2.new(0.5, 1)
	choose.Position = UDim2.new(0.5, 0, 1, -6)
	choose.Activated:Connect(function()
		askPick(row)
	end)
	choose.Parent = card
	return card
end

local function buildConfirm(gui: ScreenGui)
	local frame = Instance.new("Frame")
	frame.Name = "Confirm"
	frame.AnchorPoint = Vector2.new(0.5, 0.5)
	frame.Position = UDim2.fromScale(0.5, 0.5)
	frame.Size = UDim2.fromScale(0.5, 0.26)
	frame.BackgroundColor3 = PANEL_COLOR
	frame.Visible = false
	frame.ZIndex = 50
	addCorner(frame, 12)

	local question =
		makeLabel("Question", UDim2.fromScale(0.9, 0.5), UDim2.fromScale(0.05, 0.08), 24)
	question.TextXAlignment = Enum.TextXAlignment.Center
	question.ZIndex = 51
	question.Parent = frame
	confirmQuestion = question

	local yes = makeButton("Yes", "Yes", UDim2.fromScale(0.35, 0.25))
	yes.Position = UDim2.fromScale(0.1, 0.65)
	yes.ZIndex = 51
	yes.Activated:Connect(function()
		frame.Visible = false
		local pick = pendingPick
		local path = pendingChange
		pendingPick = ""
		pendingChange = ""
		if pick ~= "" then
			handlers.pick(pick)
		elseif path ~= "" then
			handlers.change(path)
		end
	end)
	yes.Parent = frame

	local no = makeButton("No", "No", UDim2.fromScale(0.35, 0.25))
	no.Position = UDim2.fromScale(0.55, 0.65)
	no.ZIndex = 51
	no.Activated:Connect(function()
		frame.Visible = false
		pendingChange = ""
		pendingPick = ""
	end)
	no.Parent = frame

	frame.Parent = gui
	confirm = frame
end

local function buildPicker(gui: ScreenGui)
	local frame = Instance.new("Frame")
	frame.Name = "Picker"
	frame.AnchorPoint = Vector2.new(0.5, 0.5)
	frame.Position = UDim2.fromScale(0.5, 0.5)
	frame.Size = UDim2.fromScale(0.9, 0.85)
	frame.BackgroundColor3 = PANEL_COLOR
	frame.Visible = false
	frame.ZIndex = 5
	addCorner(frame, 14)

	local title = makeLabel("Title", UDim2.fromScale(0.6, 0.08), UDim2.fromScale(0.02, 0.02), 30)
	title.Font = Enum.Font.GothamBold
	title.Text = "Choose your Calling"
	title.Parent = frame

	local later = makeButton("Later", "Later", UDim2.fromScale(0.14, 0.08))
	later.AnchorPoint = Vector2.new(1, 0)
	later.Position = UDim2.fromScale(0.98, 0.02)
	later.Activated:Connect(function()
		dismissedPicker = true
		frame.Visible = false
	end)
	later.Parent = frame

	local list = makeScroller("Cards", UDim2.fromScale(0.96, 0.84), UDim2.fromScale(0.02, 0.13))
	local grid = Instance.new("UIGridLayout")
	grid.CellSize = UDim2.new(0.32, 0, 0, 250)
	grid.CellPadding = UDim2.new(0.01, 0, 0, 8)
	grid.SortOrder = Enum.SortOrder.LayoutOrder
	grid.Parent = list
	list.Parent = frame
	pickerList = list

	frame.Parent = gui
	picker = frame
end

local function buildPanel(gui: ScreenGui)
	local book = Instance.new("Frame")
	book.Name = "Panel"
	book.AnchorPoint = Vector2.new(0.5, 0.5)
	book.Position = UDim2.fromScale(0.5, 0.5)
	book.Size = UDim2.fromScale(0.8, 0.85)
	book.BackgroundColor3 = PANEL_COLOR
	book.Visible = false
	addCorner(book, 14)

	local title =
		makeLabel("CallingText", UDim2.fromScale(0.6, 0.08), UDim2.fromScale(0.02, 0.02), 30)
	title.Font = Enum.Font.GothamBold
	title.Parent = book
	callingLabel = title

	local close = makeButton("Close", "X", UDim2.fromScale(0.08, 0.08))
	close.AnchorPoint = Vector2.new(1, 0)
	close.Position = UDim2.fromScale(0.98, 0.02)
	close.Activated:Connect(PathUI.toggle)
	close.Parent = book

	local strip = Instance.new("Frame")
	strip.Name = "Loadout"
	strip.BackgroundTransparency = 1
	strip.Position = UDim2.fromScale(0.02, 0.11)
	strip.Size = UDim2.fromScale(0.96, 0.09)
	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Horizontal
	layout.Padding = UDim.new(0.01, 0)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = strip
	strip.Parent = book
	slotStrip = strip

	local list = makeScroller("Rows", UDim2.fromScale(0.96, 0.77), UDim2.fromScale(0.02, 0.21))
	local listLayout = Instance.new("UIListLayout")
	listLayout.Padding = UDim.new(0, 8)
	listLayout.SortOrder = Enum.SortOrder.LayoutOrder
	listLayout.Parent = list
	list.Parent = book
	rowList = list

	book.Parent = gui
	panel = book
end

function PathUI.mount(playerGui: PlayerGui, given: Handlers)
	handlers = given

	local gui = Instance.new("ScreenGui")
	gui.Name = "PathGui"
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 12

	local openButton = makeButton("PathsButton", "Paths", UDim2.fromScale(0.14, 0.07))
	openButton.AnchorPoint = Vector2.new(0, 1)
	openButton.Position = UDim2.fromScale(0.02, 0.89)
	local openLimit = openButton:FindFirstChildOfClass("UITextSizeConstraint")
	if openLimit ~= nil then
		openLimit.MinTextSize = 12
	end
	openButton.Activated:Connect(PathUI.toggle)
	openButton.Parent = gui

	buildPicker(gui)
	buildPanel(gui)
	buildConfirm(gui)

	ContextActionService:BindAction("TogglePaths", function(_name, state)
		if state == Enum.UserInputState.Begin then
			PathUI.toggle()
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.P)

	gui.Parent = playerGui
end

function PathUI.render(view: View)
	lastView = view
	local rows = rowList
	local cards = pickerList
	local strip = slotStrip
	local pick = picker
	if rows == nil or cards == nil or strip == nil or pick == nil then
		return
	end
	if callingLabel ~= nil then
		callingLabel.Text = view.callingText
	end

	-- A pending first pick closes once a Calling has been chosen.
	local pickDialog = confirm
	if pendingPick ~= "" and not view.needsCalling and pickDialog ~= nil then
		pickDialog.Visible = false
		pendingPick = ""
	end

	-- A pending Calling change only stays open while the new view still allows it.
	local dialog = confirm
	local question = confirmQuestion
	if pendingChange ~= "" and dialog ~= nil and question ~= nil then
		local pending: RowView? = nil
		for _, row in view.rows do
			if row.path == pendingChange then
				pending = row
			end
		end
		if pending == nil or pending.changeText == "" or not pending.canChange then
			dialog.Visible = false
			pendingChange = ""
		else
			question.Text = "Change your Calling to "
				.. pending.name
				.. "? Levels are kept; learning rates change."
		end
	end

	clearRows(strip)
	for _, slot in view.slots do
		local empty = slot.abilityId == ""
		local cell = Instance.new("Frame")
		cell.Name = "Slot" .. slot.slot
		cell.LayoutOrder = slot.slot
		cell.Size = UDim2.new(0.2425, 0, 1, 0)
		cell.BackgroundColor3 = if empty then LOCKED_COLOR else CARD_COLOR
		addCorner(cell, 8)
		local text = makeLabel("Name", UDim2.new(0.74, 0, 1, 0), UDim2.fromScale(0.04, 0), 18)
		text.TextColor3 = if empty then TEXT_DIM else TEXT_LIGHT
		text.Text = slot.slot .. ": " .. (if empty then "Empty" else slot.name)
		text.Parent = cell
		if not empty then
			local clear = makeButton("Clear" .. slot.slot, "×", UDim2.new(0.2, 0, 0.8, 0))
			clear.AnchorPoint = Vector2.new(1, 0.5)
			clear.Position = UDim2.fromScale(0.98, 0.5)
			clear.Activated:Connect(function()
				handlers.loadout({ slot = slot.slot, abilityId = "" })
			end)
			clear.Parent = cell
		end
		cell.Parent = strip
	end

	clearRows(rows)
	for index, row in view.rows do
		makeRow(row, index, view.needsCalling).Parent = rows
	end

	clearRows(cards)
	if view.needsCalling then
		for index, row in view.rows do
			makeCard(row, index).Parent = cards
		end
	end
	pick.Visible = view.needsCalling and not dismissedPicker
end

function PathUI.isOpen(): boolean
	local book = panel
	local pick = picker
	return (book ~= nil and book.Visible) or (pick ~= nil and pick.Visible)
end

function PathUI.toggle()
	local book = panel
	if book ~= nil then
		book.Visible = not book.Visible
	end
end

return PathUI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="117">
          <Properties>
            <string name="Name">RenounceUI</string>
            <string name="Source"><![CDATA[--!strict
-- The Renounce window: the server's offer lines, the word to type, a countdown, Confirm and
-- Keep. It sends what was typed; the server checks the word, the time and everything else.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Renounce = require(Shared:WaitForChild("Rules"):WaitForChild("Renounce"))

-- After a click the buttons stay inert until the next offer arrives or this long passes.
local REARM_SECONDS = 1

local TEXT_LIGHT = Color3.fromRGB(245, 235, 210)
local TEXT_DIM = Color3.fromRGB(170, 165, 160)
local PANEL_COLOR = Color3.fromRGB(32, 28, 38)
local BUTTON_COLOR = Color3.fromRGB(70, 60, 90)
local CONFIRM_COLOR = Color3.fromRGB(170, 55, 55)
local BOX_COLOR = Color3.fromRGB(20, 18, 24)

local RenounceUI = {}

local window: Frame? = nil
local linesFrame: Frame? = nil
local wordBox: TextBox? = nil
local timerLabel: TextLabel? = nil
local confirmButton: TextButton? = nil
local keepButton: TextButton? = nil
local actionHandler: (request: { [string]: any }) -> () = function(_request: { [string]: any }) end

-- Bumped on every show and every close: stops an old countdown and an old re-arm timer.
local serial = 0
-- One request per render: set on a click, cleared by the next show or the re-arm timer.
local sent = false

local function addCorner(parent: Instance, radius: number)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius)
	corner.Parent = parent
end

local function limitText(parent: Instance, minSize: number, maxSize: number)
	local constraint = Instance.new("UITextSizeConstraint")
	constraint.MinTextSize = minSize
	constraint.MaxTextSize = maxSize
	constraint.Parent = parent
end

local function makeLabel(name: string, size: UDim2, position: UDim2, maxText: number): TextLabel
	local label = Instance.new("TextLabel")
	label.Name = name
	label.Size = size
	label.Position = position
	label.BackgroundTransparency = 1
	label.TextColor3 = TEXT_LIGHT
	label.TextScaled = true
	label.TextWrapped = true
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Font = Enum.Font.GothamMedium
	label.Text = ""
	limitText(label, 9, maxText)
	return label
end

local function makeButton(name: string, text: string, color: Color3, position: UDim2): TextButton
	local button = Instance.new("TextButton")
	button.Name = name
	button.Position = position
	button.Size = UDim2.fromScale(0.46, 0.12)
	button.BackgroundColor3 = color
	button.TextColor3 = TEXT_LIGHT
	button.TextScaled = true
	button.Font = Enum.Font.GothamBold
	button.Text = text
	addCorner(button, 8)
	limitText(button, 10, 22)
	return button
end

-- Dimmed and inert unless `enabled`, as in the trade window.
local function setEnabled(button: TextButton, enabled: boolean)
	button.Active = enabled
	button.AutoButtonColor = enabled
	button.BackgroundTransparency = if enabled then 0 else 0.6
	button.TextTransparency = if enabled then 0 else 0.5
end

local function typedWord(): string
	local box = wordBox
	return if box ~= nil then box.Text else ""
end

-- Confirm needs the typed word and no request in flight; Keep needs no request in flight.
local function refreshButtons()
	local confirm = confirmButton
	local keep = keepButton
	if confirm ~= nil then
		setEnabled(confirm, not sent and Renounce.wordMatches(typedWord()))
	end
	if keep ~= nil then
		setEnabled(keep, not sent)
	end
end

-- Sends one request, then waits for the next offer (or one second) before another.
local function send(request: { [string]: any })
	if sent then
		return
	end
	sent = true
	refreshButtons()
	actionHandler(request)
	local mine = serial
	task.delay(REARM_SECONDS, function()
		if serial == mine and sent then
			sent = false
			refreshButtons()
		end
	end)
end

local function clock(seconds: number): string
	local whole = math.max(0, math.ceil(seconds))
	return string.format("%d:%02d", whole // 60, whole % 60)
end

function RenounceUI.mount(playerGui: PlayerGui, onAction: (request: { [string]: any }) -> ())
	actionHandler = onAction

	local gui = Instance.new("ScreenGui")
	gui.Name = "RenounceGui"
	gui.ResetOnSpawn = false
	-- Above the Ceremony banner (25) and every other window.
	gui.DisplayOrder = 26

	local frame = Instance.new("Frame")
	frame.Name = "Renounce"
	frame.AnchorPoint = Vector2.new(0.5, 0.5)
	frame.Position = UDim2.fromScale(0.5, 0.5)
	frame.Size = UDim2.fromScale(0.5, 0.6)
	frame.BackgroundColor3 = PANEL_COLOR
	frame.Visible = false
	addCorner(frame, 14)
	local minimum = Instance.new("UISizeConstraint")
	minimum.MinSize = Vector2.new(300, 320)
	minimum.Parent = frame

	local title = makeLabel("Title", UDim2.fromScale(0.94, 0.09), UDim2.fromScale(0.03, 0.02), 28)
	title.Font = Enum.Font.GothamBold
	title.Text = "Renounce the Ledger?"
	title.Parent = frame

	local lines = Instance.new("Frame")
	lines.Name = "Lines"
	lines.BackgroundTransparency = 1
	lines.Position = UDim2.fromScale(0.03, 0.12)
	lines.Size = UDim2.fromScale(0.94, 0.46)
	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, 2)
	layout.Parent = lines
	lines.Parent = frame
	linesFrame = lines

	local word = Instance.new("TextBox")
	word.Name = "Word"
	word.Position = UDim2.fromScale(0.03, 0.6)
	word.Size = UDim2.fromScale(0.94, 0.1)
	word.BackgroundColor3 = BOX_COLOR
	word.TextColor3 = TEXT_LIGHT
	word.PlaceholderText = "Type RENOUNCE"
	word.PlaceholderColor3 = TEXT_DIM
	word.ClearTextOnFocus = false
	word.TextScaled = true
	word.Font = Enum.Font.GothamBold
	word.Text = ""
	addCorner(word, 8)
	limitText(word, 10, 22)
	word:GetPropertyChangedSignal("Text"):Connect(refreshButtons)
	word.Parent = frame
	wordBox = word

	local timer = makeLabel("Timer", UDim2.fromScale(0.94, 0.07), UDim2.fromScale(0.03, 0.72), 20)
	timer.TextColor3 = TEXT_DIM
	timer.Parent = frame
	timerLabel = timer

	local confirm = makeButton("Confirm", "Renounce", CONFIRM_COLOR, UDim2.fromScale(0.03, 0.85))
	confirm.Activated:Connect(function()
		if sent or not Renounce.wordMatches(typedWord()) then
			return
		end
		send({ kind = "confirm", word = typedWord() })
	end)
	confirm.Parent = frame
	confirmButton = confirm

	local keep = makeButton("Keep", "Keep my Ledger", BUTTON_COLOR, UDim2.fromScale(0.51, 0.85))
	keep.Activated:Connect(function()
		send({ kind = "cancel" })
	end)
	keep.Parent = frame
	keepButton = keep

	frame.Parent = gui
	window = frame
	gui.Parent = playerGui
end

-- Opens the window on the offer, or closes it on nil. The window closes only here: the server
-- answers every action.
function RenounceUI.show(offer: { lines: { string }, seconds: number }?)
	local frame = window
	local list = linesFrame
	local box = wordBox
	local timer = timerLabel
	if frame == nil or list == nil or box == nil or timer == nil then
		return
	end
	serial += 1
	sent = false
	if offer == nil then
		frame.Visible = false
		return
	end

	for _, child in list:GetChildren() do
		if not child:IsA("UIComponent") then
			child:Destroy()
		end
	end
	local count = math.max(1, #offer.lines)
	for index, text in offer.lines do
		local label = makeLabel("Line" .. index, UDim2.new(1, 0, 1 / count, -2), UDim2.new(), 16)
		label.LayoutOrder = index
		label.Text = text
		label.Parent = list
	end
	box.Text = ""
	refreshButtons()

	local mine = serial
	local deadline = os.clock() + math.max(0, offer.seconds)
	timer.Text = "Ends in " .. clock(offer.seconds)
	frame.Visible = true
	task.spawn(function()
		while serial == mine and frame.Visible do
			local left = deadline - os.clock()
			timer.Text = "Ends in " .. clock(left)
			if left <= 0 then
				-- The server dropped the offer at the same moment.
				frame.Visible = false
				break
			end
			task.wait(0.25)
		end
	end)
end

function RenounceUI.isOpen(): boolean
	local frame = window
	return frame ~= nil and frame.Visible
end

return RenounceUI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="118">
          <Properties>
            <string name="Name">ShopUI</string>
            <string name="Source"><![CDATA[--!strict
-- The Edict Hall window: buy a pack, buy a Relic from the stock, or sell a free-slot card.
-- It shows the view the server sent and asks; the server checks prices and holdings.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Shop = require(Shared:WaitForChild("Rules"):WaitForChild("Shop"))

local TEXT_LIGHT = Color3.fromRGB(245, 235, 210)
local TEXT_DIM = Color3.fromRGB(170, 165, 160)
local COIN_COLOR = Color3.fromRGB(255, 215, 90)
local PANEL_COLOR = Color3.fromRGB(32, 28, 38)
local ROW_COLOR = Color3.fromRGB(45, 40, 55)
local BUTTON_COLOR = Color3.fromRGB(70, 60, 90)
local BUY_COLOR = Color3.fromRGB(60, 130, 80)
local ROW_HEIGHT = 40

local ShopUI = {}

local window: Frame? = nil
local coinLabel: TextLabel? = nil
local packLabel: TextLabel? = nil
local oddsLabel: TextLabel? = nil
local packButton: TextButton? = nil
local stockList: ScrollingFrame? = nil
local sellList: ScrollingFrame? = nil
local actionHandler: (request: { [string]: any }) -> () = function(_request: { [string]: any }) end
-- One request per rendered view: a second click before the new view arrives would spend a
-- second identical card or a second purchase.
local lastView: Shop.View? = nil
local viewSerial = 0
local requestSent = false
local RETRY_SECONDS = 1

local function addCorner(parent: Instance, radius: number)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius)
	corner.Parent = parent
end

local function limitText(parent: Instance, minSize: number, maxSize: number)
	local constraint = Instance.new("UITextSizeConstraint")
	constraint.MinTextSize = minSize
	constraint.MaxTextSize = maxSize
	constraint.Parent = parent
end

local function makeLabel(
	name: string,
	text: string,
	size: UDim2,
	position: UDim2,
	maxText: number
): TextLabel
	local label = Instance.new("TextLabel")
	label.Name = name
	label.Size = size
	label.Position = position
	label.BackgroundTransparency = 1
	label.TextColor3 = TEXT_LIGHT
	label.TextScaled = true
	label.TextWrapped = true
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Font = Enum.Font.GothamMedium
	label.Text = text
	limitText(label, 9, maxText)
	return label
end

local function makeButton(name: string, text: string, color: Color3): TextButton
	local button = Instance.new("TextButton")
	button.Name = name
	button.BackgroundColor3 = color
	button.TextColor3 = TEXT_LIGHT
	button.TextScaled = true
	button.Font = Enum.Font.GothamBold
	button.Text = text
	addCorner(button, 8)
	limitText(button, 9, 20)
	return button
end

-- Dimmed and inert unless `enabled`, as in the trial window.
local function setEnabled(button: TextButton, enabled: boolean)
	button.Active = enabled
	button.AutoButtonColor = enabled
	button.BackgroundTransparency = if enabled then 0 else 0.6
	button.TextTransparency = if enabled then 0 else 0.5
end

local function makeScroller(name: string, position: UDim2, size: UDim2): ScrollingFrame
	local scroller = Instance.new("ScrollingFrame")
	scroller.Name = name
	scroller.Position = position
	scroller.Size = size
	scroller.BackgroundTransparency = 1
	scroller.BorderSizePixel = 0
	scroller.ScrollBarThickness = 6
	scroller.CanvasSize = UDim2.new()
	scroller.AutomaticCanvasSize = Enum.AutomaticSize.Y
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 4)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = scroller
	return scroller
end

local function clearRows(container: Instance)
	for _, child in container:GetChildren() do
		if not child:IsA("UIComponent") then
			child:Destroy()
		end
	end
end

-- One list row: name on the left, price, then the button.
local function makeRow(
	name: string,
	order: number,
	text: string,
	priceText: string,
	buttonText: string
): (Frame, TextButton)
	local row = Instance.new("Frame")
	row.Name = name
	row.LayoutOrder = order
	row.Size = UDim2.new(1, -8, 0, ROW_HEIGHT)
	row.BackgroundColor3 = ROW_COLOR
	addCorner(row, 8)

	local label =
		makeLabel("Name", text, UDim2.fromScale(0.46, 0.8), UDim2.fromScale(0.02, 0.1), 20)
	label.Parent = row

	local price =
		makeLabel("Price", priceText, UDim2.fromScale(0.25, 0.8), UDim2.fromScale(0.49, 0.1), 18)
	price.TextColor3 = COIN_COLOR
	price.Parent = row

	local button = makeButton("Action", buttonText, BUY_COLOR)
	button.AnchorPoint = Vector2.new(1, 0.5)
	button.Position = UDim2.fromScale(0.98, 0.5)
	button.Size = UDim2.fromScale(0.21, 0.8)
	button.Parent = row
	return row, button
end

local function dimButtons()
	for _, container in { stockList, sellList } do
		if container ~= nil then
			for _, descendant in container:GetDescendants() do
				if descendant:IsA("TextButton") then
					setEnabled(descendant, false)
				end
			end
		end
	end
	if packButton ~= nil then
		setEnabled(packButton, false)
	end
end

-- Sends at most one request per view. The server answers every request, but only a success
-- sends a new view; so after a second without one the old view is drawn again, and a refused
-- purchase does not leave the window dead.
local function send(request: { [string]: any })
	if requestSent then
		return
	end
	requestSent = true
	dimButtons()
	actionHandler(request)
	local serial = viewSerial
	task.delay(RETRY_SECONDS, function()
		local view = lastView
		if requestSent and serial == viewSerial and view ~= nil and ShopUI.isOpen() then
			ShopUI.show(view)
		end
	end)
end

local function hide()
	local frame = window
	if frame ~= nil then
		frame.Visible = false
	end
end

function ShopUI.mount(playerGui: PlayerGui, onAction: (request: { [string]: any }) -> ())
	actionHandler = onAction

	local gui = Instance.new("ScreenGui")
	gui.Name = "ShopGui"
	gui.ResetOnSpawn = false
	-- With the other windows; below the messages (20).
	gui.DisplayOrder = 16

	local frame = Instance.new("Frame")
	frame.Name = "Shop"
	frame.AnchorPoint = Vector2.new(0.5, 0.5)
	frame.Position = UDim2.fromScale(0.5, 0.5)
	frame.Size = UDim2.fromScale(0.7, 0.82)
	frame.BackgroundColor3 = PANEL_COLOR
	frame.Visible = false
	addCorner(frame, 14)
	local minimum = Instance.new("UISizeConstraint")
	minimum.MinSize = Vector2.new(320, 340)
	minimum.Parent = frame

	local title = makeLabel(
		"Title",
		"Edict Hall",
		UDim2.fromScale(0.5, 0.07),
		UDim2.fromScale(0.04, 0.02),
		30
	)
	title.Font = Enum.Font.GothamBold
	title.Parent = frame

	local coin = makeLabel("Coin", "", UDim2.fromScale(0.4, 0.07), UDim2.fromScale(0.56, 0.02), 24)
	coin.TextColor3 = COIN_COLOR
	coin.TextXAlignment = Enum.TextXAlignment.Right
	coin.Parent = frame
	coinLabel = coin

	-- The pack row.
	local pack = makeLabel("Pack", "", UDim2.fromScale(0.62, 0.06), UDim2.fromScale(0.04, 0.1), 22)
	pack.Parent = frame
	packLabel = pack
	local odds = makeLabel("Odds", "", UDim2.fromScale(0.62, 0.05), UDim2.fromScale(0.04, 0.16), 14)
	odds.TextColor3 = TEXT_DIM
	odds.Parent = frame
	oddsLabel = odds
	local buyPack = makeButton("BuyPack", "Buy", BUY_COLOR)
	buyPack.AnchorPoint = Vector2.new(1, 0)
	buyPack.Position = UDim2.fromScale(0.96, 0.105)
	buyPack.Size = UDim2.fromScale(0.24, 0.09)
	buyPack.Activated:Connect(function()
		if buyPack.Active then
			send({ kind = "pack" })
		end
	end)
	buyPack.Parent = frame
	packButton = buyPack

	-- Relics for sale.
	makeLabel(
		"StockHeading",
		"Relics for sale",
		UDim2.fromScale(0.9, 0.05),
		UDim2.fromScale(0.04, 0.23),
		18
	).Parent =
		frame
	local stock = makeScroller("Stock", UDim2.fromScale(0.04, 0.285), UDim2.fromScale(0.92, 0.27))
	stock.Parent = frame
	stockList = stock

	-- Cards to sell.
	makeLabel(
		"SellHeading",
		"Sell a free-slot card",
		UDim2.fromScale(0.9, 0.05),
		UDim2.fromScale(0.04, 0.575),
		18
	).Parent =
		frame
	local sell = makeScroller("Sell", UDim2.fromScale(0.04, 0.63), UDim2.fromScale(0.92, 0.22))
	sell.Parent = frame
	sellList = sell

	local close = makeButton("Close", "Close", BUTTON_COLOR)
	close.AnchorPoint = Vector2.new(0.5, 1)
	close.Position = UDim2.fromScale(0.5, 0.97)
	close.Size = UDim2.fromScale(0.36, 0.09)
	close.Activated:Connect(hide)
	close.Parent = frame

	frame.Parent = gui
	window = frame
	gui.Parent = playerGui
end

-- Opens the window, or refreshes it when it is already open.
function ShopUI.show(view: Shop.View)
	local frame = window
	local stock = stockList
	local sell = sellList
	if frame == nil or stock == nil or sell == nil then
		return
	end
	lastView = view
	viewSerial += 1
	requestSent = false
	if coinLabel ~= nil then
		coinLabel.Text = view.coinText
	end
	if packLabel ~= nil then
		packLabel.Text = view.packText
	end
	if oddsLabel ~= nil then
		oddsLabel.Text = view.oddsText
	end
	local pack = packButton
	if pack ~= nil then
		setEnabled(pack, view.canBuyPack)
	end

	clearRows(stock)
	for index, row in view.stock do
		local made, button = makeRow("Stock_" .. row.relicId, index, row.name, row.priceText, "Buy")
		setEnabled(button, row.canBuy)
		button.Activated:Connect(function()
			if button.Active then
				send({ kind = "relic", relicId = row.relicId })
			end
		end)
		made.Parent = stock
	end

	clearRows(sell)
	if #view.sell == 0 then
		local none = makeLabel(
			"Nothing",
			"Nothing to sell.",
			UDim2.new(1, 0, 0, ROW_HEIGHT),
			UDim2.new(),
			18
		)
		none.TextColor3 = TEXT_DIM
		none.Parent = sell
	end
	for order, row in view.sell do
		local made, button = makeRow("Sell" .. row.index, order, row.name, row.priceText, "Sell")
		button.Activated:Connect(function()
			if button.Active then
				send({ kind = "sell", freeIndex = row.index, cardId = row.cardId })
			end
		end)
		made.Parent = sell
	end
	frame.Visible = true
end

function ShopUI.isOpen(): boolean
	local frame = window
	return frame ~= nil and frame.Visible
end

return ShopUI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="119">
          <Properties>
            <string name="Name">StatusHUD</string>
            <string name="Source"><![CDATA[--!strict
-- Top-left: the Coin line, the status lines (region, safe zone, shields, Marked, Veil, hazards) and
-- the "Drop shield" button.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local StatusView = require(Shared:WaitForChild("Rules"):WaitForChild("StatusView"))

local StatusHUD = {}

local TEXT_LIGHT = Color3.fromRGB(245, 235, 210)
local BACKGROUND = Color3.fromRGB(25, 22, 30)
local BUTTON_COLOR = Color3.fromRGB(70, 60, 90)
local KIND_COLORS: { [string]: Color3 } = {
	region = Color3.fromRGB(245, 235, 210),
	hazard = Color3.fromRGB(255, 170, 60),
	safe = Color3.fromRGB(90, 200, 110),
	shield = Color3.fromRGB(110, 170, 255),
	marked = Color3.fromRGB(235, 70, 70),
	veil = Color3.fromRGB(170, 140, 220),
}

local COIN_COLOR = Color3.fromRGB(255, 215, 90)
local COIN_HEIGHT = 28

local column: Frame? = nil
local coinLabel: TextLabel? = nil
local dropButton: TextButton? = nil
local confirm: Frame? = nil
-- Text of the lines on screen, so an unchanged render does nothing.
local shownKey = ""

local function addCorner(parent: Instance, radius: number)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius)
	corner.Parent = parent
end

local function limitText(parent: Instance, minSize: number, maxSize: number)
	local constraint = Instance.new("UITextSizeConstraint")
	constraint.MinTextSize = minSize
	constraint.MaxTextSize = maxSize
	constraint.Parent = parent
end

local function makeButton(name: string, text: string, size: UDim2): TextButton
	local button = Instance.new("TextButton")
	button.Name = name
	button.Size = size
	button.BackgroundColor3 = BUTTON_COLOR
	button.TextColor3 = TEXT_LIGHT
	button.TextScaled = true
	button.Font = Enum.Font.GothamBold
	button.Text = text
	addCorner(button, 8)
	limitText(button, 10, 20)
	return button
end

local function buildConfirm(gui: ScreenGui, onDropShield: () -> ()): Frame
	local frame = Instance.new("Frame")
	frame.Name = "ConfirmDrop"
	frame.AnchorPoint = Vector2.new(0.5, 0.5)
	frame.Position = UDim2.fromScale(0.5, 0.5)
	frame.Size = UDim2.fromScale(0.4, 0.22)
	frame.BackgroundColor3 = BACKGROUND
	frame.Visible = false
	addCorner(frame, 12)

	local question = Instance.new("TextLabel")
	question.Name = "Question"
	question.BackgroundTransparency = 1
	question.Position = UDim2.fromScale(0.05, 0.08)
	question.Size = UDim2.fromScale(0.9, 0.5)
	question.TextColor3 = TEXT_LIGHT
	question.TextScaled = true
	question.TextWrapped = true
	question.Font = Enum.Font.GothamMedium
	question.Text = "Other players will be able to attack you. Drop it?"
	limitText(question, 10, 24)
	question.Parent = frame

	local yes = makeButton("Yes", "Yes", UDim2.fromScale(0.35, 0.25))
	yes.Position = UDim2.fromScale(0.1, 0.65)
	yes.Activated:Connect(function()
		frame.Visible = false
		onDropShield()
	end)
	yes.Parent = frame

	local no = makeButton("No", "No", UDim2.fromScale(0.35, 0.25))
	no.Position = UDim2.fromScale(0.55, 0.65)
	no.Activated:Connect(function()
		frame.Visible = false
	end)
	no.Parent = frame

	frame.Parent = gui
	return frame
end

function StatusHUD.mount(playerGui: PlayerGui, onDropShield: () -> ())
	local gui = Instance.new("ScreenGui")
	gui.Name = "StatusGui"
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 15

	local coin = Instance.new("TextLabel")
	coin.Name = "Coin"
	coin.Position = UDim2.new(0, 12, 0, 12)
	coin.Size = UDim2.new(0, 230, 0, COIN_HEIGHT)
	coin.BackgroundColor3 = BACKGROUND
	coin.BackgroundTransparency = 0.3
	coin.TextColor3 = COIN_COLOR
	coin.TextScaled = true
	coin.TextXAlignment = Enum.TextXAlignment.Left
	coin.Font = Enum.Font.GothamBold
	coin.Text = "Coin: 0"
	addCorner(coin, 6)
	local coinPadding = Instance.new("UIPadding")
	coinPadding.PaddingLeft = UDim.new(0, 8)
	coinPadding.PaddingTop = UDim.new(0, 4)
	coinPadding.PaddingBottom = UDim.new(0, 4)
	coinPadding.Parent = coin
	limitText(coin, 10, 20)
	coin.Parent = gui
	coinLabel = coin

	local list = Instance.new("Frame")
	list.Name = "Lines"
	list.BackgroundTransparency = 1
	list.Position = UDim2.new(0, 12, 0, 12 + COIN_HEIGHT + 4)
	list.Size = UDim2.new(0, 230, 0, 192)
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 4)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = list
	list.Parent = gui
	column = list

	local drop = makeButton("DropShield", "Drop shield", UDim2.new(0, 150, 0, 32))
	drop.Position = UDim2.new(0, 12, 0, 208 + COIN_HEIGHT + 4)
	drop.Visible = false
	drop.Parent = gui
	dropButton = drop

	local dialog = buildConfirm(gui, onDropShield)
	confirm = dialog
	drop.Activated:Connect(function()
		dialog.Visible = true
	end)

	gui.Parent = playerGui
end

-- "Coin: 120" above the status lines.
function StatusHUD.setCoin(coin: number)
	local label = coinLabel
	if label ~= nil then
		label.Text = "Coin: " .. tostring(math.floor(coin))
	end
end

function StatusHUD.render(lines: { StatusView.Line }, showDropShield: boolean)
	local drop = dropButton
	if drop ~= nil then
		drop.Visible = showDropShield
	end
	local dialog = confirm
	if dialog ~= nil and not showDropShield then
		dialog.Visible = false
	end

	local list = column
	if list == nil then
		return
	end
	local parts: { string } = {}
	for _, line in lines do
		table.insert(parts, line.kind .. ":" .. line.text)
	end
	local key = table.concat(parts, "|")
	if key == shownKey then
		return
	end
	shownKey = key

	for _, child in list:GetChildren() do
		if not child:IsA("UIComponent") then
			child:Destroy()
		end
	end
	for index, line in lines do
		local label = Instance.new("TextLabel")
		label.Name = "Line" .. index
		label.LayoutOrder = index
		label.Size = UDim2.new(1, 0, 0, 28)
		label.BackgroundColor3 = BACKGROUND
		label.BackgroundTransparency = 0.3
		label.TextColor3 = KIND_COLORS[line.kind] or TEXT_LIGHT
		label.TextScaled = true
		label.TextXAlignment = Enum.TextXAlignment.Left
		label.Font = Enum.Font.GothamBold
		label.Text = line.text
		addCorner(label, 6)
		local padding = Instance.new("UIPadding")
		padding.PaddingLeft = UDim.new(0, 8)
		padding.PaddingTop = UDim.new(0, 4)
		padding.PaddingBottom = UDim.new(0, 4)
		padding.Parent = label
		limitText(label, 10, 20)
		label.Parent = list
	end
end

return StatusHUD
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="120">
          <Properties>
            <string name="Name">Toast</string>
            <string name="Source"><![CDATA[--!strict
-- Messages at the top of the screen, one at a time. A message stays 3 seconds, or 1.5 when
-- another is waiting. At most 4 wait; a fifth pushes out the one that has waited longest.
local SHOW_SECONDS = 3
local SHORT_SECONDS = 1.5
local MAX_WAITING = 4
local STEP_SECONDS = 0.1

local Toast = {}

local label: TextLabel? = nil
local waiting: { string } = {}
local showing = false

function Toast.mount(playerGui: PlayerGui)
	local gui = Instance.new("ScreenGui")
	gui.Name = "ToastGui"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 20

	local text = Instance.new("TextLabel")
	text.Name = "Message"
	text.AnchorPoint = Vector2.new(0.5, 0)
	text.Position = UDim2.fromScale(0.5, 0.04)
	text.Size = UDim2.fromScale(0.6, 0.07)
	text.BackgroundColor3 = Color3.fromRGB(25, 22, 30)
	text.BackgroundTransparency = 0.15
	text.TextColor3 = Color3.fromRGB(245, 235, 210)
	text.TextScaled = true
	text.Font = Enum.Font.GothamMedium
	text.Text = ""
	text.Visible = false

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 10)
	corner.Parent = text
	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0, 6)
	padding.PaddingBottom = UDim.new(0, 6)
	padding.PaddingLeft = UDim.new(0, 12)
	padding.PaddingRight = UDim.new(0, 12)
	padding.Parent = text
	local constraint = Instance.new("UITextSizeConstraint")
	constraint.MinTextSize = 12
	constraint.MaxTextSize = 28
	constraint.Parent = text

	text.Parent = gui
	label = text
	gui.Parent = playerGui
end

-- Shows `first`, then everything that queues up behind it, then hides the label.
local function run(current: TextLabel, first: string)
	local text: string? = first
	while text ~= nil do
		current.Text = text
		current.Visible = true
		local shownFor = 0
		while shownFor < SHOW_SECONDS and not (#waiting > 0 and shownFor >= SHORT_SECONDS) do
			shownFor += task.wait(STEP_SECONDS)
		end
		text = table.remove(waiting, 1)
	end
	current.Visible = false
	showing = false
end

function Toast.show(text: string)
	local current = label
	if current == nil then
		return
	end
	if showing then
		if #waiting >= MAX_WAITING then
			table.remove(waiting, 1)
		end
		table.insert(waiting, text)
		return
	end
	showing = true
	task.spawn(run, current, text)
end

-- The message on screen and those waiting, oldest first (play-test seam).
function Toast.pending(): { string }
	local list = table.clone(waiting)
	local current = label
	if showing and current ~= nil then
		table.insert(list, 1, current.Text)
	end
	return list
end

return Toast
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="121">
          <Properties>
            <string name="Name">TradeUI</string>
            <string name="Source"><![CDATA[--!strict
-- Trading: the "Trade" button, the invite banner and the trade window. It shows the view the
-- server sent and sends the player's whole new offer on every change; the server checks it.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Trade = require(Shared:WaitForChild("Rules"):WaitForChild("Trade"))

local TEXT_LIGHT = Color3.fromRGB(245, 235, 210)
local TEXT_DIM = Color3.fromRGB(170, 165, 160)
local TEXT_DARK = Color3.fromRGB(20, 18, 24)
local COIN_COLOR = Color3.fromRGB(255, 215, 90)
local PANEL_COLOR = Color3.fromRGB(32, 28, 38)
local COLUMN_COLOR = Color3.fromRGB(42, 37, 50)
local BUTTON_COLOR = Color3.fromRGB(70, 60, 90)
local ACCEPT_COLOR = Color3.fromRGB(60, 130, 80)
local FREE_COLOR = Color3.fromRGB(214, 196, 150)
local OFFERED_COLOR = Color3.fromRGB(110, 190, 120)
local COIN_STEPS = { -10, -1, 1, 10 }
local ROW_HEIGHT = 36
local TICK_SECONDS = 0.2

local TradeUI = {}

type Handlers = {
	request: () -> (),
	reply: (accept: boolean) -> (),
	action: (request: { [string]: any }) -> (),
}

local handlers: Handlers = {
	request = function() end,
	reply = function(_accept: boolean) end,
	action = function(_request: { [string]: any }) end,
}
local window: Frame? = nil
local inviteBanner: Frame? = nil
local inviteLabel: TextLabel? = nil
local titleLabel: TextLabel? = nil
local statusLabel: TextLabel? = nil
local freeList: ScrollingFrame? = nil
local mineCards: ScrollingFrame? = nil
local theirCards: ScrollingFrame? = nil
local mineCoin: TextLabel? = nil
local theirCoin: TextLabel? = nil
local confirmButton: TextButton? = nil
-- The view on screen and when it arrived (local clock); the confirm wait counts down from it.
local current: Trade.View? = nil
local arrivedAt = 0
-- Bumped on every invite change, so an old invite's timer cannot hide a newer one.
local inviteToken = 0

local function addCorner(parent: Instance, radius: number)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius)
	corner.Parent = parent
end

local function limitText(parent: Instance, minSize: number, maxSize: number)
	local constraint = Instance.new("UITextSizeConstraint")
	constraint.MinTextSize = minSize
	constraint.MaxTextSize = maxSize
	constraint.Parent = parent
end

local function makeLabel(
	name: string,
	text: string,
	size: UDim2,
	position: UDim2,
	maxText: number
): TextLabel
	local label = Instance.new("TextLabel")
	label.Name = name
	label.Size = size
	label.Position = position
	label.BackgroundTransparency = 1
	label.TextColor3 = TEXT_LIGHT
	label.TextScaled = true
	label.TextWrapped = true
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Font = Enum.Font.GothamMedium
	label.Text = text
	limitText(label, 9, maxText)
	return label
end

local function makeButton(name: string, text: string, color: Color3): TextButton
	local button = Instance.new("TextButton")
	button.Name = name
	button.BackgroundColor3 = color
	button.TextColor3 = TEXT_LIGHT
	button.TextScaled = true
	button.Font = Enum.Font.GothamBold
	button.Text = text
	addCorner(button, 8)
	limitText(button, 9, 20)
	return button
end

-- Dimmed and inert unless `enabled`, as in the trial window.
local function setEnabled(button: TextButton, enabled: boolean)
	button.Active = enabled
	button.AutoButtonColor = enabled
	button.BackgroundTransparency = if enabled then 0 else 0.6
	button.TextTransparency = if enabled then 0 else 0.5
end

local function makeList(parent: Instance, position: UDim2, size: UDim2): ScrollingFrame
	local scroller = Instance.new("ScrollingFrame")
	scroller.Name = "Cards"
	scroller.Position = position
	scroller.Size = size
	scroller.BackgroundTransparency = 1
	scroller.BorderSizePixel = 0
	scroller.ScrollBarThickness = 5
	scroller.CanvasSize = UDim2.new()
	scroller.AutomaticCanvasSize = Enum.AutomaticSize.Y
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 4)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = scroller
	scroller.Parent = parent
	return scroller
end

local function clearRows(container: Instance)
	for _, child in container:GetChildren() do
		if not child:IsA("UIComponent") then
			child:Destroy()
		end
	end
end

-- A column frame with its heading; the caller adds the rest.
local function makeColumn(
	parent: Instance,
	name: string,
	heading: string,
	position: UDim2,
	size: UDim2
): Frame
	local column = Instance.new("Frame")
	column.Name = name
	column.Position = position
	column.Size = size
	column.BackgroundColor3 = COLUMN_COLOR
	addCorner(column, 10)
	local title =
		makeLabel("Heading", heading, UDim2.fromScale(0.92, 0.09), UDim2.fromScale(0.04, 0.02), 18)
	title.Font = Enum.Font.GothamBold
	title.Parent = column
	column.Parent = parent
	return column
end

local function cardNames(cards: { Trade.CardView }, list: ScrollingFrame)
	clearRows(list)
	for index, card in cards do
		local label =
			makeLabel("Card" .. index, card.name, UDim2.new(1, -6, 0, 28), UDim2.new(), 18)
		label.LayoutOrder = index
		label.Parent = list
	end
end

-- The whole offer as it is now, as plain card ids.
local function offerIds(view: Trade.View): { string }
	local ids: { string } = {}
	for _, card in view.mine.cards do
		table.insert(ids, card.cardId)
	end
	return ids
end

local function sendOffer(cards: { string }, coin: number)
	handlers.action({ kind = "offer", cards = cards, coin = coin })
end

-- A free-slot click adds that card to the offer, or takes it out again.
local function toggleCard(row: Trade.FreeRow)
	local view = current
	if view == nil then
		return
	end
	local ids = offerIds(view)
	if row.offered then
		local at = table.find(ids, row.cardId)
		if at ~= nil then
			table.remove(ids, at)
		end
	elseif #ids >= Trade.MAX_CARDS then
		return
	else
		table.insert(ids, row.cardId)
	end
	sendOffer(ids, view.mine.coin)
end

local function changeCoin(step: number)
	local view = current
	if view == nil then
		return
	end
	local coin = math.clamp(view.mine.coin + step, 0, math.max(0, view.coinHeld))
	-- Already at the limit: nothing to send.
	if coin == view.mine.coin then
		return
	end
	sendOffer(offerIds(view), coin)
end

-- Confirm is inert after you confirmed and while the server's wait has not passed.
local function updateConfirm()
	local view = current
	local button = confirmButton
	if view == nil or button == nil then
		return
	end
	local waited = os.clock() - arrivedAt
	local ready = not view.mineConfirmed and waited >= view.confirmIn
	setEnabled(button, ready)
	if view.mineConfirmed then
		button.Text = "Confirmed"
	elseif ready then
		button.Text = "Confirm"
	else
		button.Text = "Confirm (" .. math.ceil(view.confirmIn - waited) .. ")"
	end
end

local function hideInvite()
	inviteToken += 1
	local banner = inviteBanner
	if banner ~= nil then
		banner.Visible = false
	end
end

local function buildInvite(gui: ScreenGui)
	local banner = Instance.new("Frame")
	banner.Name = "Invite"
	banner.AnchorPoint = Vector2.new(0.5, 0)
	-- Below the message line (top 4% to 11%).
	banner.Position = UDim2.fromScale(0.5, 0.12)
	banner.Size = UDim2.fromScale(0.5, 0.09)
	banner.BackgroundColor3 = PANEL_COLOR
	banner.Visible = false
	addCorner(banner, 10)
	local minimum = Instance.new("UISizeConstraint")
	minimum.MinSize = Vector2.new(300, 44)
	minimum.Parent = banner

	local label = makeLabel("Text", "", UDim2.fromScale(0.44, 0.8), UDim2.fromScale(0.03, 0.1), 20)
	label.Parent = banner
	inviteLabel = label

	local accept = makeButton("Accept", "Accept", ACCEPT_COLOR)
	accept.Position = UDim2.fromScale(0.49, 0.12)
	accept.Size = UDim2.fromScale(0.24, 0.76)
	accept.Activated:Connect(function()
		hideInvite()
		handlers.reply(true)
	end)
	accept.Parent = banner

	local decline = makeButton("Decline", "Decline", BUTTON_COLOR)
	decline.Position = UDim2.fromScale(0.74, 0.12)
	decline.Size = UDim2.fromScale(0.24, 0.76)
	decline.Activated:Connect(function()
		hideInvite()
		handlers.reply(false)
	end)
	decline.Parent = banner

	banner.Parent = gui
	inviteBanner = banner
end

local function buildWindow(gui: ScreenGui)
	local frame = Instance.new("Frame")
	frame.Name = "Trade"
	frame.AnchorPoint = Vector2.new(0.5, 0.5)
	frame.Position = UDim2.fromScale(0.5, 0.5)
	frame.Size = UDim2.fromScale(0.82, 0.8)
	frame.BackgroundColor3 = PANEL_COLOR
	frame.Visible = false
	addCorner(frame, 14)
	local minimum = Instance.new("UISizeConstraint")
	minimum.MinSize = Vector2.new(340, 320)
	minimum.Parent = frame

	local title =
		makeLabel("Title", "", UDim2.fromScale(0.92, 0.08), UDim2.fromScale(0.04, 0.02), 28)
	title.Font = Enum.Font.GothamBold
	title.Parent = frame
	titleLabel = title

	-- Left: your free-slot cards, click to offer.
	local free = makeColumn(
		frame,
		"FreeSlots",
		"Your free slots",
		UDim2.fromScale(0.02, 0.12),
		UDim2.fromScale(0.3, 0.6)
	)
	freeList = makeList(free, UDim2.fromScale(0.04, 0.12), UDim2.fromScale(0.92, 0.86))

	-- Middle: what you give, with the Coin steps.
	local mine = makeColumn(
		frame,
		"Mine",
		"You give",
		UDim2.fromScale(0.34, 0.12),
		UDim2.fromScale(0.32, 0.6)
	)
	mineCards = makeList(mine, UDim2.fromScale(0.04, 0.12), UDim2.fromScale(0.92, 0.46))
	local give = makeLabel("Coin", "", UDim2.fromScale(0.92, 0.1), UDim2.fromScale(0.04, 0.6), 18)
	give.TextColor3 = COIN_COLOR
	give.Parent = mine
	mineCoin = give
	for index, step in COIN_STEPS do
		local text = if step > 0 then "+" .. step else tostring(step)
		local button = makeButton("Coin" .. text, text, BUTTON_COLOR)
		button.Position = UDim2.fromScale(0.04 + (index - 1) * 0.24, 0.73)
		button.Size = UDim2.fromScale(0.22, 0.2)
		button.Activated:Connect(function()
			changeCoin(step)
		end)
		button.Parent = mine
	end

	-- Right: what you get.
	local theirs = makeColumn(
		frame,
		"Theirs",
		"You get",
		UDim2.fromScale(0.68, 0.12),
		UDim2.fromScale(0.3, 0.6)
	)
	theirCards = makeList(theirs, UDim2.fromScale(0.04, 0.12), UDim2.fromScale(0.92, 0.46))
	local get = makeLabel("Coin", "", UDim2.fromScale(0.92, 0.1), UDim2.fromScale(0.04, 0.6), 18)
	get.TextColor3 = COIN_COLOR
	get.Parent = theirs
	theirCoin = get

	local status =
		makeLabel("Status", "", UDim2.fromScale(0.96, 0.08), UDim2.fromScale(0.02, 0.74), 18)
	status.TextColor3 = TEXT_DIM
	status.Parent = frame
	statusLabel = status

	local confirm = makeButton("Confirm", "Confirm", ACCEPT_COLOR)
	confirm.AnchorPoint = Vector2.new(0, 1)
	confirm.Position = UDim2.fromScale(0.1, 0.96)
	confirm.Size = UDim2.fromScale(0.35, 0.1)
	confirm.Activated:Connect(function()
		if confirm.Active then
			handlers.action({ kind = "confirm" })
		end
	end)
	confirm.Parent = frame
	confirmButton = confirm

	local cancel = makeButton("Cancel", "Cancel", BUTTON_COLOR)
	cancel.AnchorPoint = Vector2.new(1, 1)
	cancel.Position = UDim2.fromScale(0.9, 0.96)
	cancel.Size = UDim2.fromScale(0.35, 0.1)
	cancel.Activated:Connect(function()
		handlers.action({ kind = "cancel" })
	end)
	cancel.Parent = frame

	frame.Parent = gui
	window = frame
end

function TradeUI.mount(playerGui: PlayerGui, given: Handlers)
	handlers = given

	local gui = Instance.new("ScreenGui")
	gui.Name = "TradeGui"
	gui.ResetOnSpawn = false
	-- With the other windows; below the messages (20).
	gui.DisplayOrder = 16

	-- Above the Ledger button (bottom 97%, height 7%) and the Paths button (bottom 89%).
	local button = makeButton("TradeButton", "Trade", BUTTON_COLOR)
	button.AnchorPoint = Vector2.new(0, 1)
	button.Position = UDim2.fromScale(0.02, 0.81)
	button.Size = UDim2.fromScale(0.14, 0.07)
	local limit = button:FindFirstChildOfClass("UITextSizeConstraint")
	if limit ~= nil then
		limit.MinTextSize = 12
	end
	button.Activated:Connect(function()
		handlers.request()
	end)
	button.Parent = gui

	buildInvite(gui)
	buildWindow(gui)
	gui.Parent = playerGui

	-- The confirm wait counts down here, not on the server.
	task.spawn(function()
		while true do
			task.wait(TICK_SECONDS)
			updateConfirm()
		end
	end)
end

-- A banner asking to trade; it goes away by itself after `seconds`. nil hides it.
function TradeUI.showInvite(invite: { from: string, seconds: number }?)
	local banner = inviteBanner
	local label = inviteLabel
	if banner == nil or label == nil then
		return
	end
	hideInvite()
	if invite == nil then
		return
	end
	label.Text = invite.from .. " wants to trade"
	banner.Visible = true
	local token = inviteToken
	task.delay(invite.seconds, function()
		if inviteToken == token then
			hideInvite()
		end
	end)
end

-- Shows the trade as the server sees it. nil closes the window.
function TradeUI.render(view: Trade.View?)
	local frame = window
	local free = freeList
	local mine = mineCards
	local theirs = theirCards
	if frame == nil or free == nil or mine == nil or theirs == nil then
		return
	end
	current = view
	if view == nil then
		frame.Visible = false
		return
	end
	arrivedAt = os.clock()
	if titleLabel ~= nil then
		titleLabel.Text = "Trade with " .. view.otherName
	end
	if statusLabel ~= nil then
		statusLabel.Text = view.status
	end
	if mineCoin ~= nil then
		mineCoin.Text = "Coin: " .. view.mine.coin .. " (of " .. view.coinHeld .. ")"
	end
	if theirCoin ~= nil then
		theirCoin.Text = "Coin: " .. view.theirs.coin
	end
	cardNames(view.mine.cards, mine)
	cardNames(view.theirs.cards, theirs)

	clearRows(free)
	for _, row in view.free do
		local button = makeButton("Free" .. row.index, row.name, FREE_COLOR)
		button.LayoutOrder = row.index
		button.Size = UDim2.new(1, -6, 0, ROW_HEIGHT)
		button.TextColor3 = TEXT_DARK
		if row.offered then
			-- The marked look: green with a border.
			button.BackgroundColor3 = OFFERED_COLOR
			local stroke = Instance.new("UIStroke")
			stroke.Color = TEXT_LIGHT
			stroke.Thickness = 2
			stroke.Parent = button
		end
		button.Activated:Connect(function()
			toggleCard(row)
		end)
		button.Parent = free
	end
	updateConfirm()
	frame.Visible = true
end

function TradeUI.isOpen(): boolean
	local frame = window
	return frame ~= nil and frame.Visible
end

return TradeUI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="122">
          <Properties>
            <string name="Name">TrialUI</string>
            <string name="Source"><![CDATA[--!strict
-- The Warden's offer window, the trial HUD (top right) and the beacon over the next course
-- marker. It only shows what the server sent and asks to accept; the server decides the rest.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local TrialView = require(Shared:WaitForChild("Rules"):WaitForChild("TrialView"))
local Types = require(Shared:WaitForChild("Types"))

local TEXT_LIGHT = Color3.fromRGB(245, 235, 210)
local TEXT_DIM = Color3.fromRGB(170, 165, 160)
local TEXT_SEALED = Color3.fromRGB(235, 90, 90)
local TEXT_NOTE = Color3.fromRGB(255, 190, 70)
local PANEL_COLOR = Color3.fromRGB(32, 28, 38)
local BACKGROUND = Color3.fromRGB(25, 22, 30)
local BUTTON_COLOR = Color3.fromRGB(70, 60, 90)
local ACCEPT_COLOR = Color3.fromRGB(60, 130, 80)
local BEACON_COLOR = Color3.fromRGB(120, 230, 255)
local BEACON_HEIGHT = 40
local HUD_LINE_HEIGHT = 28

local TrialUI = {}

local window: Frame? = nil
local labels: { [string]: TextLabel } = {}
local acceptButton: TextButton? = nil
local hud: Frame? = nil
local beacon: Part? = nil
local acceptHandler: (trialId: string) -> () = function(_trialId: string) end
-- The offer on screen: Accept sends its trial id.
local offered: TrialView.OfferView? = nil
-- Text of the HUD lines on screen, so an unchanged render does nothing.
local shownKey = ""

local function addCorner(parent: Instance, radius: number)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius)
	corner.Parent = parent
end

local function limitText(parent: Instance, minSize: number, maxSize: number)
	local constraint = Instance.new("UITextSizeConstraint")
	constraint.MinTextSize = minSize
	constraint.MaxTextSize = maxSize
	constraint.Parent = parent
end

local function makeLabel(name: string, order: number, height: number, maxText: number): TextLabel
	local label = Instance.new("TextLabel")
	label.Name = name
	label.LayoutOrder = order
	label.Size = UDim2.fromScale(1, height)
	label.BackgroundTransparency = 1
	label.TextColor3 = TEXT_LIGHT
	label.TextScaled = true
	label.TextWrapped = true
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Font = Enum.Font.GothamMedium
	label.Text = ""
	limitText(label, 9, maxText)
	return label
end

local function makeButton(name: string, text: string, color: Color3): TextButton
	local button = Instance.new("TextButton")
	button.Name = name
	button.Size = UDim2.fromScale(0.44, 1)
	button.BackgroundColor3 = color
	button.TextColor3 = TEXT_LIGHT
	button.TextScaled = true
	button.Font = Enum.Font.GothamBold
	button.Text = text
	addCorner(button, 8)
	limitText(button, 10, 22)
	return button
end

local function close()
	local frame = window
	if frame ~= nil then
		frame.Visible = false
	end
	offered = nil
end

function TrialUI.mount(playerGui: PlayerGui, onAccept: (trialId: string) -> ())
	acceptHandler = onAccept

	local gui = Instance.new("ScreenGui")
	gui.Name = "TrialGui"
	gui.ResetOnSpawn = false
	-- Below the status HUD (15) and messages (20), above the Ledger book (10).
	gui.DisplayOrder = 14

	local frame = Instance.new("Frame")
	frame.Name = "Offer"
	frame.AnchorPoint = Vector2.new(0.5, 0.5)
	frame.Position = UDim2.fromScale(0.5, 0.5)
	frame.Size = UDim2.fromScale(0.46, 0.56)
	frame.BackgroundColor3 = PANEL_COLOR
	frame.Visible = false
	addCorner(frame, 14)
	local minimum = Instance.new("UISizeConstraint")
	minimum.MinSize = Vector2.new(280, 230)
	minimum.Parent = frame

	local body = Instance.new("Frame")
	body.Name = "Body"
	body.BackgroundTransparency = 1
	body.Position = UDim2.fromScale(0.05, 0.04)
	body.Size = UDim2.fromScale(0.9, 0.74)
	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0.01, 0)
	layout.Parent = body
	body.Parent = frame

	-- name, share of the body's height, largest text size
	local rows: { { any } } = {
		{ "Title", 0.18, 30 },
		{ "Warden", 0.1, 18 },
		{ "Goal", 0.14, 22 },
		{ "Time", 0.11, 20 },
		{ "Reward", 0.11, 20 },
		{ "Relic", 0.14, 20 },
		{ "Note", 0.14, 20 },
	}
	for order, row in rows do
		local label = makeLabel(row[1], order, row[2], row[3])
		label.Parent = body
		labels[row[1]] = label
	end
	labels.Title.Font = Enum.Font.GothamBold
	labels.Warden.TextColor3 = TEXT_DIM
	labels.Note.TextColor3 = TEXT_NOTE

	local buttons = Instance.new("Frame")
	buttons.Name = "Buttons"
	buttons.BackgroundTransparency = 1
	buttons.AnchorPoint = Vector2.new(0.5, 1)
	buttons.Position = UDim2.fromScale(0.5, 0.96)
	buttons.Size = UDim2.fromScale(0.9, 0.14)
	buttons.Parent = frame

	local accept = makeButton("Accept", "Accept", ACCEPT_COLOR)
	accept.Position = UDim2.fromScale(0, 0)
	accept.Activated:Connect(function()
		local view = offered
		if view ~= nil and view.canStart then
			close()
			acceptHandler(view.trialId)
		end
	end)
	accept.Parent = buttons
	acceptButton = accept

	local dismiss = makeButton("Close", "Close", BUTTON_COLOR)
	dismiss.AnchorPoint = Vector2.new(1, 0)
	dismiss.Position = UDim2.fromScale(1, 0)
	dismiss.Activated:Connect(close)
	dismiss.Parent = buttons

	frame.Parent = gui
	window = frame

	local lines = Instance.new("Frame")
	lines.Name = "Hud"
	lines.BackgroundTransparency = 1
	lines.AnchorPoint = Vector2.new(1, 0)
	lines.Position = UDim2.new(1, -12, 0.16, 0)
	lines.Size = UDim2.new(0, 300, 0, 4 * (HUD_LINE_HEIGHT + 4))
	local hudLayout = Instance.new("UIListLayout")
	hudLayout.Padding = UDim.new(0, 4)
	hudLayout.SortOrder = Enum.SortOrder.LayoutOrder
	hudLayout.Parent = lines
	lines.Parent = gui
	hud = lines

	gui.Parent = playerGui
end

function TrialUI.showOffer(view: TrialView.OfferView)
	local frame = window
	if frame == nil then
		return
	end
	offered = view
	labels.Title.Text = view.title
	labels.Warden.Text = view.warden
	labels.Goal.Text = view.goal
	labels.Time.Text = view.timeText
	labels.Reward.Text = view.rewardText
	labels.Relic.Text = view.relicText
	labels.Relic.TextColor3 = if view.sealed then TEXT_SEALED else TEXT_LIGHT
	labels.Note.Text = view.note
	local accept = acceptButton
	if accept ~= nil then
		-- Dimmed and inert unless the trial can start.
		accept.Active = view.canStart
		accept.AutoButtonColor = view.canStart
		accept.BackgroundTransparency = if view.canStart then 0 else 0.6
		accept.TextTransparency = if view.canStart then 0 else 0.5
	end
	frame.Visible = true
end

function TrialUI.renderHud(lines: { string })
	local list = hud
	if list == nil then
		return
	end
	local key = table.concat(lines, "|")
	if key == shownKey then
		return
	end
	shownKey = key
	for _, child in list:GetChildren() do
		if not child:IsA("UIComponent") then
			child:Destroy()
		end
	end
	for index, text in lines do
		local label = Instance.new("TextLabel")
		label.Name = "Line" .. index
		label.LayoutOrder = index
		label.Size = UDim2.new(1, 0, 0, HUD_LINE_HEIGHT)
		label.BackgroundColor3 = BACKGROUND
		label.BackgroundTransparency = 0.3
		label.TextColor3 = TEXT_LIGHT
		label.TextScaled = true
		label.TextXAlignment = Enum.TextXAlignment.Right
		label.Font = Enum.Font.GothamBold
		label.Text = text
		addCorner(label, 6)
		local padding = Instance.new("UIPadding")
		padding.PaddingLeft = UDim.new(0, 8)
		padding.PaddingRight = UDim.new(0, 8)
		padding.PaddingTop = UDim.new(0, 4)
		padding.PaddingBottom = UDim.new(0, 4)
		padding.Parent = label
		limitText(label, 9, 18)
		label.Parent = list
	end
end

-- A glowing column over the next course marker, on this client only. nil removes it.
function TrialUI.setBeacon(position: Types.Vec3?)
	if position == nil then
		if beacon ~= nil then
			beacon:Destroy()
			beacon = nil
		end
		return
	end
	local part = beacon
	if part == nil then
		local made = Instance.new("Part")
		made.Name = "TrialBeacon"
		made.Anchored = true
		made.CanCollide = false
		made.CanQuery = false
		made.CanTouch = false
		made.CastShadow = false
		made.Material = Enum.Material.Neon
		made.Color = BEACON_COLOR
		made.Transparency = 0.5
		made.Size = Vector3.new(1.2, BEACON_HEIGHT, 1.2)
		made.Parent = workspace
		beacon = made
		part = made
	end
	-- The marker is at standing-root height; the column rises from the surface under it.
	local target = CFrame.new(position.x, position.y - 3 + BEACON_HEIGHT / 2, position.z)
	if part.CFrame ~= target then
		part.CFrame = target
	end
end

function TrialUI.isOpen(): boolean
	local frame = window
	return frame ~= nil and frame.Visible
end

return TrialUI
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="123">
    <Properties>
      <string name="Name">Workspace</string>
      <float name="FallenPartsDestroyHeight">-60</float>
      <bool name="NeedsPivotMigration">false</bool>
    </Properties>
  </Item>
</roblox>