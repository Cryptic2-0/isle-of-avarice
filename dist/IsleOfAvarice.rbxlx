	PARTY_MEMBER_KICKED = "{player} was removed from your party.",
	PARTY_NEW_LEADER = "{player} now leads your party.",
	PARTY_DISBANDED = "Your party broke up.",
	PARTY_FULL = "Your party is full.",
	PARTY_NOT_LEADER = "Only the party leader can do that.",
	PARTY_TARGET_IN_PARTY = "{player} is already in a party.",
	PARTY_NOT_IN = "You are not in a party.",
	PARTY_JOIN_FAILED = "You could not join {player}'s party.",
	CROWNED_YOU = "You are {title}! Your name goes on the Tally Stone in Tallyport.",
	RENOUNCE_NOT_READY = "Only a Crowned Claimant with every Relic claimed can Renounce.",
	RENOUNCE_NOT_IN_TOWN = "You can Renounce only in Tallyport.",
	RENOUNCE_CLAIMING = "Finish your claim first.",
	RENOUNCE_TRADING = "Finish your trade first.",
	RENOUNCE_WORD = "Type RENOUNCE to confirm.",
	RENOUNCE_EXPIRED = "That took too long. Start again at the Tally Stone.",
	RENOUNCE_NO_OFFER = "Start at the Tally Stone in Tallyport.",
	RENOUNCE_CANCELLED = "You kept your Ledger.",
	RENOUNCE_DONE = "You Renounced. Every card went back to the island, and you earned a star.",
	RENOUNCED = "{player} has Renounced the Ledger and starts again.",
	HOLD_TOO_SHORT = "Hold the cache open until it is done.",
	ROUND_STEP = "{name}: {n} of {total} done.",
	ROUND_COMPLETE = "{name} complete! +{coin} Coin.",
}

local function format(code: string, args: { [string]: string }?): string
	local template = templates[code]
	if template == nil then
		return code
	end
	local values = args
	if values == nil then
		return template
	end
	local text = string.gsub(template, "{(%w+)}", function(key: string): string?
		return values[key]
	end)
	return text
end

return {
	format = format,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">Paths</string>
            <string name="Source"><![CDATA[--!strict
local Types = require("../Types")

type PathId = Types.PathId

local order: { PathId } = { "Fang", "Gale", "Ember", "Mire", "Mend", "Bulwark" }

local info: { [PathId]: { name: string, style: string, color: { r: number, g: number, b: number } } } =
	{
		Fang = {
			name = "Fang",
			style = "Close-range burst damage",
			color = { r = 200, g = 50, b = 50 },
		},
		Gale = { name = "Gale", style = "Speed and evasion", color = { r = 120, g = 210, b = 230 } },
		Ember = {
			name = "Ember",
			style = "Ranged and area damage",
			color = { r = 240, g = 140, b = 40 },
		},
		Mire = { name = "Mire", style = "Control", color = { r = 100, g = 140, b = 60 } },
		Mend = {
			name = "Mend",
			style = "Healing and support",
			color = { r = 240, g = 230, b = 150 },
		},
		Bulwark = {
			name = "Bulwark",
			style = "Defence and counter",
			color = { r = 90, g = 100, b = 180 },
		},
	}

local function isPath(value: any): boolean
	if type(value) ~= "string" then
		return false
	end
	for _, path in order do
		if path == value then
			return true
		end
	end
	return false
end

return {
	order = order,
	info = info,
	isPath = isPath,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">Regions</string>
            <string name="Source"><![CDATA[--!strict
local Types = require("../Types")

type Region = Types.Region
type RegionId = Types.RegionId

local list: { Region } = {
	{
		id = "Tallyport",
		name = "Tallyport",
		hint = "Safe ground. No fighting here.",
		ground = "grass",
		fog = { r = 200, g = 215, b = 230, start = 200, finish = 2500 },
	},
	{
		id = "CountingFields",
		name = "Counting Fields",
		hint = "Quiet fields. Nothing here will hurt you.",
		ground = "grass",
		fog = { r = 200, g = 215, b = 230, start = 200, finish = 2500 },
	},
	{
		id = "Thornwood",
		name = "Thornwood",
		hint = "A hedge maze. Briars are a shortcut that costs health.",
		bearing = 0,
		ground = "thorngrass",
		fog = { r = 60, g = 90, b = 60, start = 80, finish = 900 },
	},
	{
		id = "SquallSteps",
		name = "Squall Steps",
		hint = "Climb the pillars. Brace when the wind lanes glow.",
		bearing = 60,
		ground = "slate",
		fog = { r = 210, g = 225, b = 240, start = 300, finish = 3000 },
	},
	{
		id = "CinderFlats",
		name = "Cinder Flats",
		hint = "Vents glow before they erupt. Lava burns fast.",
		bearing = 120,
		ground = "ash",
		fog = { r = 120, g = 50, b = 30, start = 120, finish = 1200 },
	},
	{
		id = "DrownedFen",
		name = "Drowned Fen",
		hint = "Stay on the boardwalk. The bog slows and drains you.",
		bearing = 180,
		ground = "mud",
		fog = { r = 110, g = 125, b = 110, start = 30, finish = 450 },
	},
	{
		id = "ReckoningRock",
		name = "Reckoning Rock",
		hint = "The causeway floods at high tide. The Rock is safe.",
		ground = "shale",
		fog = { r = 150, g = 170, b = 190, start = 100, finish = 1500 },
	},
	{
		id = "HushGardens",
		name = "Hush Gardens",
		hint = "The blight drains you. Springs heal.",
		bearing = 240,
		ground = "palegrass",
		fog = { r = 170, g = 150, b = 190, start = 100, finish = 1000 },
	},
	{
		id = "BastionReach",
		name = "Bastion Reach",
		hint = "Rocks fall where the ground glows. Shelter under the roofs.",
		bearing = 300,
		ground = "gravel",
		fog = { r = 150, g = 150, b = 160, start = 150, finish = 1600 },
	},
}

local byId: { [string]: Region } = {}
for _, region in list do
	byId[region.id] = region
end

-- The six regions with a bearing, in bearing order (0, 60, ... 300).
local wild: { RegionId } = {
	"Thornwood",
	"SquallSteps",
	"CinderFlats",
	"DrownedFen",
	"HushGardens",
	"BastionReach",
}

return {
	list = list,
	byId = byId,
	wild = wild,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
