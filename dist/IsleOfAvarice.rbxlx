          <Item class="ModuleScript" referent="17">
            <Properties>
              <string name="Name">Scenery</string>
              <string name="Source"><![CDATA[--!strict
local Geography = require("../../Rules/Geography")
local Hazards = require("../../Rules/Hazards")
local Types = require("../../Types")
local Make = require("./Make")

local Scenery = {}

local TRIES = 400
local PROPS = 36
local SEED_BASE = 1000
local MIN_ALONG = 300
local ALONG_SPAN = 600
local CLEARANCE = 12 -- a prop's footprint is checked this far out in each direction
local ROAD_HALF_WIDTH = 16
local ROAD_END = 480
local CACHE_CLEARANCE = 30
-- Where Sites puts the region's extra Copper cache.
local COPPER_ALONG = 310
local COPPER_ACROSS = -60

-- One piece of a prop: a block sx across by sz along, or a cylinder of diameter sx = sz, standing
-- on the piece below it. Heights are multiplied by the prop's scale.
type Part = {
	shape: "block" | "cylinder",
	sx: number,
	sz: number,
	height: number,
	look: string,
	solid: boolean,
}
type Kind = { Part }

local function cylinder(diameter: number, height: number, look: string, solid: boolean): Part
	return {
		shape = "cylinder",
		sx = diameter,
		sz = diameter,
		height = height,
		look = look,
		solid = solid,
	}
end

local function block(sx: number, sz: number, height: number, look: string, solid: boolean): Part
	return { shape = "block", sx = sx, sz = sz, height = height, look = look, solid = solid }
end

local deadTree: Kind = { cylinder(2.5, 16, "deadwood", true) }

local kindsByRegion: { [string]: { Kind } } = {
	Thornwood = {
		{ cylinder(3, 14, "trunk", true), cylinder(14, 8, "leaf", false) },
		{ cylinder(8, 4, "leaf", true) },
	},
	SquallSteps = {
		{ block(6, 6, 18, "pillar", true) },
		{ block(8, 8, 5, "rock", true) },
	},
	CinderFlats = {
		{ cylinder(6, 12, "basalt", true) },
		{ cylinder(14, 3, "basalt", true) },
	},
	DrownedFen = {
		deadTree,
		{ cylinder(10, 5, "reed", false) },
	},
	HushGardens = {
		deadTree,
		{ cylinder(12, 0.4, "flower", false) },
	},
	BastionReach = {
		{ block(8, 6, 4, "rubble", true) },
		{ cylinder(4, 10, "wall", true) },
	},
}

-- Land of the site's own region, clear of its keep-out shapes and of every hazard that has a
-- footprint of its own.
local function usable(site: Types.Site, x: number, z: number): boolean
	if not Geography.isLand(x, z) or Geography.regionAt(x, z) ~= site.region then
		return false
	end
	for _, shape in site.keepOut do
		if Hazards.contains(shape, x, z) then
			return false
		end
	end
	for _, hazard in site.hazards do
		if hazard.shape.kind ~= "region" and Hazards.affects(hazard, x, z) then
			return false
		end
	end
	return true
end

-- The features of one prop standing at (along, across), its parts stacked from the ground up.
local function build(
	region: string,
	kind: Kind,
	along: number,
	across: number,
	scale: number
): { Types.Feature }
	local features: { Types.Feature } = {}
	local base = 0
	for _, part in kind do
		local top = base + part.height * scale
		if part.shape == "cylinder" then
			table.insert(
				features,
				Make.disc(region, along, across, part.sx / 2, base, top, part.look, part.solid)
			)
		else
			table.insert(
				features,
				Make.block(
					region,
					along - part.sz / 2,
					along + part.sz / 2,
					across - part.sx / 2,
					across + part.sx / 2,
					base,
					top,
					part.look,
					part.solid
				)
			)
		end
		base = top
	end
	return features
end

-- Trees, rocks and the like scattered over a wild region, the same every time. index is the
-- region's place in Regions.wild; it seeds the pseudo-random sequence.
function Scenery.scatter(site: Types.Site, index: number): { Types.Feature }
	local kinds = kindsByRegion[site.region]
	if kinds == nil then
		error(`Scenery: region {site.region} has no scenery`)
	end

	local seed = SEED_BASE + index
	local function draw(): number
		seed = (seed * 1103515245 + 12345) % 2147483648
		return seed / 2147483648
	end

	-- The caches no prop may crowd: the site's prize, if it has one, and the Copper cache.
	local caches: { { number } } = {}
	local prize = site.prize
	if prize ~= nil then
		table.insert(caches, { prize.x, prize.z })
	end
	local copperX, copperZ = Geography.place(site.region, COPPER_ALONG, COPPER_ACROSS)
	table.insert(caches, { copperX, copperZ })

	local features: { Types.Feature } = {}
	local placed = 0
	for _ = 1, TRIES do
		if placed >= PROPS then
			break
		end
		-- Four draws a try, whether or not the spot is used.
		local along = MIN_ALONG + ALONG_SPAN * draw()
		local across = (2 * draw() - 1) * 0.5 * along
		local kind = kinds[math.floor(draw() * #kinds) + 1]
		local scale = 0.8 + 0.6 * draw()

		local onRoad = math.abs(across) < ROAD_HALF_WIDTH and along < ROAD_END
		local nearCache = false
		local x, z = Geography.place(site.region, along, across)
		for _, point in caches do
			if math.sqrt((x - point[1]) ^ 2 + (z - point[2]) ^ 2) <= CACHE_CLEARANCE then
				nearCache = true
			end
		end

		local ok = not onRoad and not nearCache and usable(site, x, z)
		if ok then
			for _, offset in { { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } } do
				local px, pz = Geography.place(
					site.region,
					along + offset[1] * CLEARANCE,
					across + offset[2] * CLEARANCE
				)
				if not usable(site, px, pz) then
					ok = false
					break
				end
			end
		end

		if ok then
			placed += 1
			for _, feature in build(site.region, kind, along, across, scale) do
				table.insert(features, feature)
			end
		end
	end
	return features
end

return Scenery
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="18">
            <Properties>
              <string name="Name">SquallSteps</string>
              <string name="Source"><![CDATA[--!strict
local Geography = require("../../Rules/Geography")
local Types = require("../../Types")
local Make = require("./Make")

local REGION: Types.RegionId = "SquallSteps"
local BEARING = 60
local PILLARS = 18
local PILLAR_SIZE = 14
local PILLAR_SPACING = 19
local FIRST_PILLAR_ALONG = 480
local RISE = 3
local GUST_SPEED = 11

export type Pillar = { along: number, across: number, top: number }
export type SquallStepsSite = Types.Site & { pillars: { Pillar } }

local pillars: { Pillar } = {}
local features: { Types.Feature } = {}
for k = 1, PILLARS do
	local along = FIRST_PILLAR_ALONG + PILLAR_SPACING * (k - 1)
	local across = if k % 2 == 1 then 6 else -6
	local half = PILLAR_SIZE / 2
	table.insert(pillars, { along = along, across = across, top = RISE * k })
	table.insert(
		features,
		Make.block(
			REGION,
			along - half,
			along + half,
			across - half,
			across + half,
			0,
			RISE * k,
			"pillar",
			true
		)
	)
end
-- The summit, one rise above the last pillar.
table.insert(features, Make.block(REGION, 815, 875, -30, 30, 0, 57, "pillar", true))

-- The world velocity of a gust blowing along and across the region's bearing.
local function push(along: number, across: number): { x: number, z: number }
	local x, z = Geography.fromFrame(BEARING, along, across)
	return { x = x * GUST_SPEED, z = z * GUST_SPEED }
end

local function gust(
	n: number,
	a1: number,
	a2: number,
	c1: number,
	c2: number,
	pushing: { x: number, z: number },
	offset: number,
	markerY: number?
): Types.Hazard
	return {
		id = `SquallGust{n}`,
		region = REGION,
		name = "Gust",
		look = "gust",
		shape = Geography.rect(REGION, a1, a2, c1, c2),
		cycle = { period = 7, warn = 1.5, active = 2, offset = offset },
		push = pushing,
		markerY = markerY,
	}
end

local hazards: { Types.Hazard } = {
	gust(1, 530, 600, -40, 40, push(0, 1), 0, nil),
	gust(2, 625, 695, -40, 40, push(0, -1), 2.3, nil),
	gust(3, 720, 790, -40, 40, push(0, 1), 4.6, nil),
	gust(4, 815, 875, -30, 30, push(1, 0), 1.2, 57.2),
}

local prizeX, prizeZ = Geography.place(REGION, 845, 0)

local site: SquallStepsSite = {
	region = REGION,
	hazards = hazards,
	features = features,
	prize = { relicId = "R007", x = prizeX, y = 58, z = prizeZ, hold = 3 },
	keepOut = { Geography.rect(REGION, 470, 880, -45, 45) },
	pillars = pillars,
}

return site
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="19">
            <Properties>
              <string name="Name">Thornwood</string>
              <string name="Source"><![CDATA[--!strict
local Geography = require("../../Rules/Geography")
local Types = require("../../Types")
local Make = require("./Make")

export type ThornwoodSite = Types.Site & {
	MAZE: { string },
	cellCentre: (number, number) -> (number, number),
}

local REGION: Types.RegionId = "Thornwood"
local FIRST_ROW_ALONG = 490
local SQUARE = 20
local HALF = SQUARE / 2
local HEDGE_HEIGHT = 14

-- Nearest row first. "#" hedge, "b" briar gap, "P" the prize square, "." open ground.
local MAZE = {
	"#######.#########",
	"#...#...#...#...#",
	"#.#.#.#b#.#.#.#.#",
	"#.#.#.#...#...#.#",
	"#.###.#.#######.#",
	"#.#...#.......#.#",
	"#.#.#########.#.#",
	"..#...b.....#.#.#",
	"#.###.#.P.#.#.b.#",
	"#.....#.....#.#..",
	"#.#####.#.#.#.#.#",
	"#.....#.#.#.#.#.#",
	"#####.b.#.###.#.#",
	"#...#.#.#.....b.#",
	"#.###.###b#####.#",
	"#...............#",
	"#################",
}

-- Square (r, c), both from 1, as the along and across of its centre in the region frame.
local function cellCentre(r: number, c: number): (number, number)
	return FIRST_ROW_ALONG + SQUARE * (r - 1), SQUARE * (c - 9)
end

local function squareShape(r: number, c: number): Types.Shape
	local along, across = cellCentre(r, c)
	return Geography.rect(REGION, along - HALF, along + HALF, across - HALF, across + HALF)
end

local function briars(id: string, shape: Types.Shape): Types.Hazard
	return {
		id = id,
		region = REGION,
		name = "Briars",
		look = "briar",
		shape = shape,
		dps = 12,
		slow = 0.6,
	}
end

local features: { Types.Feature } = {}
local hazards: { Types.Hazard } = {}
local prize: Types.SiteCache? = nil

for r, row in MAZE do
	local along = cellCentre(r, 1)
	-- Each maximal run of hedge is one block. The column after the row's end closes a last run.
	local runStart: number? = nil
	for c = 1, #row + 1 do
		local char = string.sub(row, c, c)
		if char == "#" and runStart == nil then
			runStart = c
		elseif char ~= "#" and runStart ~= nil then
			local _, firstAcross = cellCentre(r, runStart)
			local _, lastAcross = cellCentre(r, c - 1)
			table.insert(
				features,
				Make.block(
					REGION,
					along - HALF,
					along + HALF,
					firstAcross - HALF,
					lastAcross + HALF,
					0,
					HEDGE_HEIGHT,
					"hedge",
					true
				)
			)
			runStart = nil
		end
		if char == "b" then
			table.insert(hazards, briars(`ThornBriar{#hazards + 1}`, squareShape(r, c)))
		elseif char == "P" then
			local x, z = Geography.place(REGION, cellCentre(r, c))
			prize = { relicId = "R009", x = x, y = 1, z = z, hold = 3 }
		end
	end
end

-- Briars growing in the open, outside the maze: along, across.
local thickets = {
	{ 350, -100 },
	{ 380, 110 },
	{ 420, -150 },
	{ 440, 60 },
	{ 455, -60 },
	{ 415, -35 },
}
for i, at in thickets do
	table.insert(hazards, briars(`ThornThicket{i}`, Geography.circle(REGION, at[1], at[2], 14)))
end

local site: ThornwoodSite = {
	region = REGION,
	hazards = hazards,
	features = features,
	prize = prize,
	keepOut = { Geography.rect(REGION, 480, 820, -170, 170) },
	MAZE = MAZE,
	cellCentre = cellCentre,
}

return site
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">Sites</string>
            <string name="Source"><![CDATA[--!strict
local Geography = require("../Rules/Geography")
local Regions = require("./Regions")
local Types = require("../Types")
local BastionReach = require("./SiteData/BastionReach")
local CinderFlats = require("./SiteData/CinderFlats")
local DrownedFen = require("./SiteData/DrownedFen")
local HushGardens = require("./SiteData/HushGardens")
local Make = require("./SiteData/Make")
local ReckoningRock = require("./SiteData/ReckoningRock")
local Scenery = require("./SiteData/Scenery")
local SquallSteps = require("./SiteData/SquallSteps")
local Thornwood = require("./SiteData/Thornwood")

-- In the order the sites were added.
local list: { Types.Site } = {
	Thornwood,
	SquallSteps,
	CinderFlats,
	DrownedFen,
	ReckoningRock,
	HushGardens,
	BastionReach,
}

local hazards: { Types.Hazard } = {}
local hazardById: { [string]: Types.Hazard } = {}
local features: { Types.Feature } = {}
local siteByRegion: { [string]: Types.Site } = {}
for _, site in list do
	siteByRegion[site.region] = site
	for _, hazard in site.hazards do
		table.insert(hazards, hazard)
		hazardById[hazard.id] = hazard
	end
	for _, feature in site.features do
		table.insert(features, feature)
	end
end

-- A road from the Fields to each wild region's site, a signpost beside it, and the bridges.
local common: { Types.Feature } = {}
for _, regionId in Regions.wild do
	local region = Regions.byId[regionId]
	table.insert(common, Make.block(regionId, 45, 470, -6, 6, 0.02, 0.12, "road", false))
	table.insert(common, Make.disc(regionId, 285, 14, 0.5, 0, 7, "sign", true))
	local board = Make.block(regionId, 284.5, 285.5, 10, 18, 5, 8, "sign", false)
	board.text = region.name .. "\n" .. region.hint
	table.insert(common, board)
end
for _, bridge in Geography.bridges() do
	table.insert(common, {
		look = "wood",
		shape = "block",
		x = bridge.x,
		y = -0.7,
		z = bridge.z,
		sx = bridge.width,
		sy = 2,
		sz = bridge.length,
		yaw = bridge.yaw,
		solid = true,
	})
end

-- Props scattered over each wild region.
local scenery: { Types.Feature } = {}
for index, regionId in Regions.wild do
	for _, feature in Scenery.scatter(siteByRegion[regionId], index) do
		table.insert(scenery, feature)
	end
end

-- Off the road in each wild region, a Copper cache holding Relics R001 to R006 in turn.
local extras: { Types.SiteCache } = {}
for k, regionId in Regions.wild do
	local x, z = Geography.place(regionId, 310, -60)
	table.insert(extras, { relicId = string.format("R%03d", k), x = x, y = 1, z = z })
end

-- Every site's features, then the common ones, then the scenery.
for _, feature in common do
	table.insert(features, feature)
end
for _, feature in scenery do
	table.insert(features, feature)
end

return {
	list = list,
	hazards = hazards,
	hazardById = hazardById,
	features = features,
	common = common,
	scenery = scenery,
	extras = extras,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">Tiers</string>
            <string name="Source"><![CDATA[--!strict
local Types = require("../Types")

type Tier = Types.Tier

export type TierInfo = {
	serverCap: number?,
	cacheRespawnSeconds: number,
	color: { r: number, g: number, b: number },
}

local order: { Tier } = { "Copper", "Silver", "Gold", "Platinum", "Crown" }

local info: { [Tier]: TierInfo } = {
	Copper = { serverCap = nil, cacheRespawnSeconds = 30, color = { r = 184, g = 115, b = 51 } },
	Silver = { serverCap = 8, cacheRespawnSeconds = 120, color = { r = 192, g = 192, b = 192 } },
	Gold = { serverCap = 4, cacheRespawnSeconds = 300, color = { r = 255, g = 200, b = 40 } },
	Platinum = { serverCap = 2, cacheRespawnSeconds = 600, color = { r = 210, g = 230, b = 235 } },
	Crown = { serverCap = 1, cacheRespawnSeconds = 900, color = { r = 150, g = 60, b = 200 } },
}

return {
	order = order,
	info = info,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">World</string>
            <string name="Source"><![CDATA[--!strict
local Geography = require("../Rules/Geography")
local Sites = require("./Sites")
local Types = require("../Types")

type Cache = Types.Cache

local islandHalfSize = 1380
local groundY = 0
local spawn: Types.Vec3 = { x = 0, y = 0.7, z = 0 }
local townRadius = Geography.TOWN_RADIUS

-- Caches C001 to C006 hold Relics R001 to R006 in the Counting Fields.
local fieldLayout: { { number } } = {
	{ 60, 40 },
	{ -70, 55 },
	{ 90, -60 },
	{ -50, -95 },
	{ 120, 20 },
	{ -130, -10 },
}

local caches: { Cache } = {}
local cacheById: { [string]: Cache } = {}
local function addCache(relicId: string, x: number, y: number, z: number, hold: number?)
	local cache: Cache = {
		id = string.format("C%03d", #caches + 1),
		relicId = relicId,
		position = { x = x, y = y, z = z },
		hold = hold,
	}
	table.insert(caches, cache)
	cacheById[cache.id] = cache
end

for i, xz in fieldLayout do
	addCache(string.format("R%03d", i), xz[1], 1, xz[2], nil)
end

-- Caches C007 to C012 hold Relics R007 to R012, each at the prize of the site that holds it.
local prizes: { [string]: Types.SiteCache } = {}
for _, site in Sites.list do
	if site.prize ~= nil then
		prizes[site.prize.relicId] = site.prize
	end
end
for n = 7, 12 do
	local relicId = string.format("R%03d", n)
	local prize = prizes[relicId]
	if prize == nil then
		error(`World: no site holds {relicId}`)
	end
	addCache(relicId, prize.x, prize.y, prize.z, prize.hold)
end

-- Caches C013 to C018 are the Copper caches out in the wild regions.
for _, extra in Sites.extras do
	addCache(extra.relicId, extra.x, extra.y, extra.z, extra.hold)
end

local trainingPosts: { Types.Vec3 } = {
	{ x = 55, y = 0, z = 0 },
	{ x = 28, y = 0, z = 48 },
	{ x = -28, y = 0, z = 48 },
	{ x = -55, y = 0, z = 0 },
	{ x = -28, y = 0, z = -48 },
	{ x = 28, y = 0, z = -48 },
}
-- Post i has id POST_ID_BASE - i; negative, so it never collides with a player UserId.
local POST_ID_BASE = -1000000

local function postIndex(id: number): number?
	local i = POST_ID_BASE - id
	if i >= 1 and i <= #trainingPosts and i == math.floor(i) then
		return i
	end
	return nil
end

return {
	trainingPosts = trainingPosts,
	POST_ID_BASE = POST_ID_BASE,
	postIndex = postIndex,
	islandHalfSize = islandHalfSize,
	groundY = groundY,
	spawn = spawn,
	townRadius = townRadius,
	caches = caches,
	cacheById = cacheById,
}
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">Net</string>
          <string name="Source"><![CDATA[--!strict
-- Names of the remotes the server creates under ReplicatedStorage.
return {
	FOLDER = "Remotes",
	-- server -> one client: (ledger: Ledger, vault: Vault)
	LedgerSync = "LedgerSync",
	-- client -> server: (request: table)
	LedgerAction = "LedgerAction",
	-- client -> server: () ask for the current Ledger (the first sync may have been missed)
	LedgerRequest = "LedgerRequest",
	-- server -> client(s): (code: string, args: { [string]: string }?)
	Notify = "Notify",
	-- client -> server: (request: table)
	VaultAction = "VaultAction",
	-- server -> one client: (status: { newShield: boolean, respawnShieldSeconds: number, markedSeconds: number })
	StatusSync = "StatusSync",
	-- client -> server: ()
	ShieldDrop = "ShieldDrop",
	-- client -> server: ()
	Strike = "Strike",
	-- server -> all clients: (victimUserId: number)
	HitFx = "HitFx",
	-- server -> one client: (payload: { victimName: string, claim: Claim, secondsLeft: number }?), nil closes the screen
	ClaimUpdate = "ClaimUpdate",
	-- client -> server: (slot: number)
	ClaimPick = "ClaimPick",
	-- server -> one client: (progress: PathProgress, coin: number, now: number) now = server os.time()
	PathSync = "PathSync",
	-- client -> server: (pathId: string)
	PickCalling = "PickCalling",
	-- client -> server: (pathId: string)
	ChangeCalling = "ChangeCalling",
	-- client -> server: (request: { slot: number, abilityId: string })
	LoadoutAction = "LoadoutAction",
	-- client -> server: (slot: number)
	CastAbility = "CastAbility",
	-- server -> one client: (slot: number, seconds: number)
	AbilityCooldown = "AbilityCooldown",
}
]]></string>
