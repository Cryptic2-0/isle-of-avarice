local CreatureService = {}

local creatures: { [number]: Creature } = {}
-- Counts spawns and forced respawns per den creature, so a stale respawn timer does nothing.
local generations: { [number]: number } = {}
-- nil: every creature thinks. A set: only those den creatures (champions always think).
local active: { [number]: boolean }? = nil
local championCount = 0
local accumulated = 0
local defeatCallbacks: { (kind: string, id: number, contributors: { Player }, owner: Player?) -> () } =
	{}

local rng: () -> number = function()
	return math.random()
end

local function folder(): Folder
	local existing = workspace:FindFirstChild(FOLDER_NAME)
	if existing ~= nil and existing:IsA("Folder") then
		return existing
	end
	local made = Instance.new("Folder")
	made.Name = FOLDER_NAME
	made.Parent = workspace
	return made
end

local function vec(v: Vector3): Vec3
	return { x = v.X, y = v.Y, z = v.Z }
end

local function flat(a: Vector3, b: Vector3): number
	return Vector3.new(a.X - b.X, 0, a.Z - b.Z).Magnitude
end

-- ---------------------------------------------------------------------------------------
-- Building a creature
-- ---------------------------------------------------------------------------------------

local function addBar(root: BasePart, humanoid: Humanoid, kind: CreatureKind, look: Look)
	local gui = Instance.new("BillboardGui")
	gui.Name = "Bar"
	gui.Size = UDim2.fromOffset(120, 34)
	gui.StudsOffset = Vector3.new(0, kind.height - look.centre + 2, 0)
	gui.MaxDistance = BAR_DISTANCE
	gui.AlwaysOnTop = true

	local name = Instance.new("TextLabel")
	name.Name = "Name"
	name.Size = UDim2.fromScale(1, 0.6)
	name.BackgroundTransparency = 1
	name.Text = kind.name
	name.TextColor3 = Color3.new(1, 1, 1)
	name.TextStrokeTransparency = 0.5
	name.TextScaled = true
	name.Font = Enum.Font.GothamBold
	name.Parent = gui

	local back = Instance.new("Frame")
	back.Name = "Back"
	back.Position = UDim2.fromScale(0, 0.7)
	back.Size = UDim2.fromScale(1, 0.25)
	back.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
	back.BorderSizePixel = 0
	back.Parent = gui
	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = Color3.fromRGB(200, 60, 60)
	fill.BorderSizePixel = 0
	fill.Parent = back

	humanoid.HealthChanged:Connect(function(health)
		local share = if humanoid.MaxHealth > 0 then health / humanoid.MaxHealth else 0
		fill.Size = UDim2.fromScale(math.clamp(share, 0, 1), 1)
	end)
	gui.Parent = root
end

-- The model, standing at `position` on the ground. Not yet parented.
local function buildModel(
	id: number,
	kind: CreatureKind,
	position: Vec3,
	owner: Player?
): (Model, Humanoid, BasePart)
	local look = LOOKS[kind.id] or LOOKS.brinehound
	local model = Instance.new("Model")
	model.Name = kind.name

	local root = Instance.new("Part")
	root.Name = "HumanoidRootPart"
	root.Size = look.root
	root.Transparency = 1
	root.CanCollide = true
	root.CanTouch = false
	root.CFrame = CFrame.new(position.x, World.groundY + look.centre, position.z)
	root.Parent = model
	model.PrimaryPart = root

	local color = Color3.fromRGB(kind.color.r, kind.color.g, kind.color.b)
	for _, piece in look.pieces do
		local part = Instance.new("Part")
		part.Name = piece.name
		part.Size = piece.size
		if piece.ball == true then
			part.Shape = Enum.PartType.Ball
		end
		part.Color = piece.color or color
		part.Material = Enum.Material.SmoothPlastic
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.Massless = true
		part.CFrame = root.CFrame * CFrame.new(piece.at.X, piece.at.Y - look.centre, piece.at.Z)
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = root
		weld.Part1 = part
		weld.Parent = part
		part.Parent = model
	end

	local humanoid = Instance.new("Humanoid")
	humanoid.RigType = Enum.HumanoidRigType.R15
	humanoid.HipHeight = look.centre - look.root.Y / 2
	humanoid.MaxHealth = kind.health
	humanoid.Health = kind.health
	humanoid.WalkSpeed = kind.speed
	humanoid.BreakJointsOnDeath = false
	humanoid.RequiresNeck = false
	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	-- A one-part body must never tip over, climb or swim.
	for _, state in
		{
			Enum.HumanoidStateType.FallingDown,
			Enum.HumanoidStateType.Ragdoll,
			Enum.HumanoidStateType.Climbing,
			Enum.HumanoidStateType.Swimming,
			Enum.HumanoidStateType.Jumping,
		}
	do
		humanoid:SetStateEnabled(state, false)
	end
	humanoid.Parent = model

	model:SetAttribute("CreatureId", id)
	model:SetAttribute("Kind", kind.id)
	model:SetAttribute("OwnerUserId", if owner ~= nil then owner.UserId else 0)
	CollectionService:AddTag(model, TAG)
	addBar(root, humanoid, kind, look)
	return model, humanoid, root
end

-- ---------------------------------------------------------------------------------------
-- Leaving the world
-- ---------------------------------------------------------------------------------------

local spawnSlot: (slotIndex: number) -> ()

-- Brings a den creature back after its kind's respawn time, unless it was respawned or
-- defeated again in the meantime.
local function scheduleRespawn(id: number, kind: CreatureKind)
	local slotIndex = World.creatureIndex(id)
	if slotIndex == nil then
		return
	end
	local generation = (generations[id] or 0) + 1
	generations[id] = generation
	task.delay(kind.respawn, function()
		if generations[id] == generation and creatures[id] == nil then
			spawnSlot(slotIndex)
		end
	end)
end

-- Takes the creature out of every registry. The model is left to the caller.
local function forget(creature: Creature)
	creature.gone = true
	if creatures[creature.id] == creature then
		creatures[creature.id] = nil
	end
	local entry = Fighters.get(creature.id)
	if entry ~= nil and entry.model == creature.model then
		Fighters.remove(creature.id)
		StatusService.drop(creature.id)
	end
end

-- Gone without a defeat (fell into the water, removed by something else, despawned): no
-- rewards. A den creature comes back on its timer when `respawn`.
local function remove(creature: Creature, respawn: boolean)
	if creature.gone then
		return
	end
	forget(creature)
	creature.model:Destroy()
	if respawn then
		scheduleRespawn(creature.id, creature.kind)
	end
end

local function playerOf(id: number): Player?
	local entry = Fighters.get(id)
	return if entry ~= nil then entry.player else nil
end

-- Pays every contributor (Rewards decides who, what and which drops) and returns them.
local function payOut(creature: Creature, now: number): { Player }
	local kind = creature.kind
	local recipients: { [string]: Rewards.Recipient } = {}
	for _, player in Players:GetPlayers() do
		local data = DataService.get(player)
		if data ~= nil then
			local room = Ledger.FREE_SLOTS - #data.ledger.free
			recipients[tostring(player.UserId)] = {
				calling = data.paths.calling,
				room = if LedgerService.isLocked(player) then 0 else math.max(0, room),
			}
		end
	end
	local held: { [string]: number } = {}
	for _, drop in kind.drops do
		held[drop.relicId] = SourceService.held(drop.relicId)
	end

	local contributors: { Player } = {}
	for _, award in Rewards.awards(kind, creature.tally, recipients, held, now, rng) do
		local player = playerOf(award.userId)
		if player == nil then
			continue
		end
		table.insert(contributors, player)
		LedgerService.notify(
			player,
			"CREATURE_DEFEATED",
			{ creature = kind.name, coin = tostring(award.coin) }
		)
		-- Every Relic the roll won goes to award(): it gives it, or says why not.
		local relics: { string } = {}
		for _, list in { award.relics, award.sealed, award.lost } do
			for _, relicId in list do
				table.insert(relics, relicId)
			end
		end
		Payout.give(
			player,
			{ coin = award.coin, xp = award.xp, path = award.xpPath, relics = relics }
		)
	end
	return contributors
end

local function onDied(creature: Creature)
	if creature.gone then
		return
	end
	local contributors: { Player } = {}
	-- A champion pays nothing and never comes back.
	if creature.owner == nil then
		local ok, result = pcall(payOut, creature, os.clock())
		if ok then
			contributors = result
		else
			warn(`[IsleOfAvarice] creature payout failed: {result}`)
		end
	end
	forget(creature)
	for _, callback in defeatCallbacks do
		local ok, err = pcall(callback, creature.kind.id, creature.id, contributors, creature.owner)
		if not ok then
			warn(`[IsleOfAvarice] onDefeated callback failed: {err}`)
		end
	end

	-- It tips over, then vanishes.
	local root, model = creature.root, creature.model
	root.Anchored = true
	root.CFrame = root.CFrame * CFrame.Angles(0, 0, math.rad(90))
	task.delay(TIP_SECONDS, function()
		model:Destroy()
	end)
	if creature.owner == nil then
		scheduleRespawn(creature.id, creature.kind)
	end
end

-- ---------------------------------------------------------------------------------------
-- Spawning
-- ---------------------------------------------------------------------------------------

local function spawn(id: number, kind: CreatureKind, den: Vec3, at: Vec3, owner: Player?)
	local old = creatures[id]
	if old ~= nil then
		remove(old, false)
	end
	local model, humanoid, root = buildModel(id, kind, at, owner)
	local creature: Creature = {
		id = id,
		kind = kind,
		den = den,
		owner = owner,
		model = model,
		humanoid = humanoid,
		root = root,
		brain = CreatureBrain.new(),
		tally = {},
		provoker = nil,
		parked = false,
		gone = false,
	}
	creatures[id] = creature
	model.Parent = folder()
	-- The server moves it: no client ever simulates a creature.
	root:SetNetworkOwner(nil)
	Fighters.add({
		id = id,
		kind = "creature",
		model = model,
		baseSpeed = kind.speed,
		owner = if owner ~= nil then owner.UserId else nil,
	})
	StatusService.reset(id)

	humanoid.Died:Connect(function()
		onDied(creature)
	end)
	-- Removed by anything else (fell out of the world): no rewards; a den creature returns.
	model.AncestryChanged:Connect(function(_, parent)
		if parent == nil and not creature.gone then
			remove(creature, creature.owner == nil)
		end
	end)
end

function spawnSlot(slotIndex: number)
	local slot = World.creatureSlots[slotIndex]
	local den = World.dens[slot.den]
	local kind = Creatures.byId[slot.kind]
	if den == nil or kind == nil then
		return
	end
	-- Members stand in a ring around the den, MEMBER_SPACING apart.
	local member = 0
	for i = 1, slotIndex do
		if World.creatureSlots[i].den == slot.den then
			member += 1
		end
	end
	local at = den.position
	if den.count > 1 then
		local angle = (member - 1) / den.count * 2 * math.pi
		local radius = MEMBER_SPACING / (2 * math.sin(math.pi / den.count))
		at = {
			x = den.position.x + math.cos(angle) * radius,
			y = den.position.y,
			z = den.position.z + math.sin(angle) * radius,
		}
	end
	spawn(slot.id, kind, den.position, at, nil)
end

-- ---------------------------------------------------------------------------------------
-- Attacks
-- ---------------------------------------------------------------------------------------

-- True when the creature has a clear line to the target and it is within `reach` (level).
local function canReach(creature: Creature, targetId: number, reach: number): boolean
	local _, targetRoot = Fighters.body(targetId)
	if targetRoot == nil then
		return false
	end
	local from, to = creature.root.Position, targetRoot.Position
	return flat(from, to) <= reach and Sight.inSight(from, to, Fighters.model(targetId))
end

local function attack(creature: Creature, targetId: number)
	local kind = creature.kind
	local strike = kind.attack
	local id = creature.id
	if strike.kind == "slam" then
		-- Everyone near, not just the target.
		local self = Fighters.fighter(id)
		if self == nil then
			return
		end
		local feet = creature.root.Position - Vector3.new(0, creature.root.Size.Y / 2, 0)
		Fx.ring(feet + Vector3.new(0, 0.3, 0), strike.range, SLAM_COLOR)
		local others = Fighters.list(id)
		for _, otherId in Targeting.inRadius(self.position, others, strike.range, id) do
			local entry = Fighters.get(otherId)
			if
				entry ~= nil
				and entry.kind == "player"
				and canReach(creature, otherId, math.huge)
			then
				CombatService.damage(id, otherId, strike.damage)
			end
		end
		return
	end
	if not canReach(creature, targetId, strike.range + MELEE_SLACK) then
		return
	end
	if strike.kind == "shot" then
		local _, targetRoot = Fighters.body(targetId)
		if targetRoot ~= nil then
			Fx.ray(creature.root.Position, targetRoot.Position, SHOT_COLOR)
		end
	end
	CombatService.damage(id, targetId, strike.damage)
end

-- A dash at the target: it hits when the target is in the dash's path.
local function lunge(creature: Creature, targetId: number)
	local dash = creature.kind.lunge
	local target = Fighters.fighter(targetId)
	local self = Fighters.fighter(creature.id)
	if dash == nil or target == nil or self == nil then
		return
	end
	local dx, dz = target.position.x - self.position.x, target.position.z - self.position.z
	local distance = math.sqrt(dx * dx + dz * dz)
	if not (distance > 0 and distance < math.huge) then
		return
	end
	dx, dz = dx / distance, dz / distance
	if
		not Sight.inSight(
			creature.root.Position,
			creature.root.Position + Vector3.new(dx, 0, dz) * distance,
			Fighters.model(targetId)
		)
	then
		return
	end
	local destination = CreatureBrain.outsideTown({
		x = self.position.x + dx * dash.distance,
		y = self.position.y,
		z = self.position.z + dz * dash.distance,
	})
	local travelled = Sight.move(creature.humanoid, creature.root, destination)
	-- Judged from where the dash began, facing the way it went.
	local dasher: Combat.Fighter =
		{ id = creature.id, position = self.position, look = { x = dx, y = 0, z = dz } }
	if Targeting.dashHit(dasher, { target }, travelled + LUNGE_SLACK) == targetId then
		CombatService.damage(creature.id, targetId, dash.damage)
	end
end

-- ---------------------------------------------------------------------------------------
-- The brain loop
-- ---------------------------------------------------------------------------------------

type Sighted =
	{ id: number, player: Player, position: Vector3, character: Instance?, valid: boolean }

-- Every living player, and whether a creature may go for them at all.
local function sightedPlayers(now: number): { Sighted }
	local list: { Sighted } = {}
	for _, player in Players:GetPlayers() do
		local _, root = Fighters.body(player.UserId)
		if root == nil then
			continue
		end
		local status = ProtectionService.status(player, now)
		table.insert(list, {
			id = player.UserId,
			player = player,
			position = root.Position,
			character = player.Character,
			valid = status ~= nil and Protection.creatureCanHit(status, now),
		})
	end
	return list
end

local function think(creature: Creature, players: { Sighted }, now: number)
	local id, kind, humanoid, root = creature.id, creature.kind, creature.humanoid, creature.root
	local here = root.Position
	if here.Y < Geography.DROWN_Y then
		remove(creature, creature.owner == nil)
		return
	end

	local seen: { CreatureBrain.Seen } = {}
	for _, other in players do
		-- A champion sees only its duellist.
		if creature.owner ~= nil and other.player ~= creature.owner then
			continue
		end
		local visible = other.valid
			and flat(here, other.position) <= kind.sight
			and Sight.inSight(here, other.position, other.character)
		table.insert(seen, {
			id = other.id,
			position = vec(other.position),
			visible = visible,
			valid = other.valid,
		})
	end

	local status = StatusService.get(id)
	local provoker = creature.provoker
	creature.provoker = nil
	local body: CreatureBrain.Body =
		{ position = vec(here), den = creature.den, rooted = Effects.isRooted(status, now) }
	local wasReturning = creature.brain.mode == "return"
	local decision = CreatureBrain.tick(
		kind,
		creature.brain,
		body,
		seen,
		Effects.tauntedBy(status, now),
		provoker,
		now,
		rng
	)
	creature.brain = decision.brain

	-- Walking home it cannot be hurt; once home it is whole again and owes nobody anything.
	if decision.brain.mode == "return" and not wasReturning then
		StatusService.update(id, function(current, at)
			return Effects.applyImmune(current, math.huge, at)
		end)
	end
	if decision.home then
		humanoid.Health = humanoid.MaxHealth
		StatusService.reset(id)
		creature.tally = {}
	end

	local moveTo = decision.moveTo
	if moveTo ~= nil then
		humanoid:MoveTo(Vector3.new(moveTo.x, here.Y, moveTo.z))
	else
		humanoid:MoveTo(here)
		local faceTo = decision.faceTo
		if faceTo ~= nil then
			local at = Vector3.new(faceTo.x, here.Y, faceTo.z)
			if (at - here).Magnitude > 0.1 then
				root.CFrame = CFrame.lookAt(here, at)
			end
		end
	end

	local action = decision.action
	if action ~= nil then
		if action.kind == "lunge" then
			lunge(creature, action.targetId)
		else
			attack(creature, action.targetId)
		end
	end
end

local function runTick()
	local now = os.clock()
	local players = sightedPlayers(now)
	local set = active
	-- A snapshot: a defeat or a respawn mid-tick must not change the table under us.
	local list: { Creature } = {}
	for _, creature in creatures do
		table.insert(list, creature)
	end
	for _, creature in list do
		if creature.gone or creature.humanoid.Health <= 0 then
			continue
		end
		if set ~= nil and creature.owner == nil and not set[creature.id] then
			if not creature.parked then
				creature.parked = true
				creature.humanoid:MoveTo(creature.root.Position)
			end
			continue
		end
		creature.parked = false
		local ok, err = pcall(think, creature, players, now)
		if not ok then
			warn(`[IsleOfAvarice] creature {creature.id} failed to think: {err}`)
		end
	end
end

local function onHeartbeat(deltaTime: number)
	accumulated += deltaTime
	if accumulated < CreatureBrain.TICK_SECONDS then
		return
	end
	accumulated = 0
	runTick()
end

-- ---------------------------------------------------------------------------------------
-- Public
-- ---------------------------------------------------------------------------------------

-- Runs when a creature is defeated, after its rewards: the kind id, the creature id, the
-- players who were paid, and for a duel champion its duellist (with no contributors).
function CreatureService.onDefeated(callback: (
	kind: string,
	id: number,
	contributors: { Player },
	owner: Player?
) -> ())
	table.insert(defeatCallbacks, callback)
end

-- A Drowned Tallyman at `at` that only `owner` can fight. Returns its fighter id.
function CreatureService.spawnChampion(owner: Player, at: Vec3): number
	championCount += 1
	local id = World.CHAMPION_ID_BASE - championCount
	spawn(id, Creatures.byId.drowned_tallyman, at, at, owner)
	return id
end

-- Support that reached allies: every live den creature notes the helper as an assist when one of
-- `helpedIds` really hit it lately (Rewards.assist). Champions never take assists. Never yields.
function CreatureService.assist(helperId: number, helpedIds: { number }, path: string)
	local now = os.clock()
	for _, creature in creatures do
		if creature.owner == nil and not creature.gone then
			creature.tally = Rewards.assist(creature.tally, helperId, helpedIds, path, now)
		end
	end
end

-- Removes a creature: no rewards, no respawn.
function CreatureService.despawn(id: number)
	local creature = creatures[id]
	if creature ~= nil then
		remove(creature, false)
	end
end

-- Play-test seam. nil: every creature thinks. A list: only those den creatures think; the
-- rest stand still (champions always think).
function CreatureService.setActive(ids: { number }?)
	if ids == nil then
		active = nil
		return
	end
	local set: { [number]: boolean } = {}
	for _, id in ids do
		set[id] = true
	end
	active = set
end

-- Play-test seam: the source of wander and drop rolls.
function CreatureService.setRng(source: () -> number)
	rng = source
end

-- Play-test seam.
function CreatureService.info(id: number): Info?
	local creature = creatures[id]
	if creature == nil then
		local slotIndex = World.creatureIndex(id)
		if slotIndex == nil then
			return nil
		end
		return {
			kind = World.creatureSlots[slotIndex].kind,
			alive = false,
			mode = "",
			targetId = 0,
			position = nil,
			owner = nil,
		}
	end
	return {
		kind = creature.kind.id,
		alive = creature.humanoid.Health > 0,
		mode = creature.brain.mode,
		targetId = creature.brain.targetId,
		position = creature.root.Position,
		owner = creature.owner,
	}
end

-- Play-test seam: a den creature comes back now, at full health, at its den.
function CreatureService.respawn(id: number)
	local slotIndex = World.creatureIndex(id)
	if slotIndex == nil then
		return
	end
	generations[id] = (generations[id] or 0) + 1
	spawnSlot(slotIndex)
end

function CreatureService.start()
	folder()
	CombatService.onHit(function(attackerId, targetId, amount, path)
		local creature = creatures[targetId]
		if creature ~= nil and not creature.gone then
			creature.tally = Rewards.record(creature.tally, attackerId, path, amount, os.clock())
			creature.provoker = attackerId
		end
	end)
	for slotIndex in World.creatureSlots do
		spawnSlot(slotIndex)
	end
	RunService.Heartbeat:Connect(onHeartbeat)
end

return CreatureService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="72">
        <Properties>
          <string name="Name">CrownService</string>
          <string name="Source"><![CDATA[--!strict
-- Crowning (spec 3.15): a complete Ledger earns one Crown per run. This service gives the
-- Crown, tells the island, lights the sky, and keeps the title, the circlet and the badge.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")
local TweenService = game:GetService("TweenService")

local Crown = require(ReplicatedStorage.Shared.Rules.Crown)
local Ledger = require(ReplicatedStorage.Shared.Rules.Ledger)
local Net = require(ReplicatedStorage.Shared.Net)
local Protection = require(ReplicatedStorage.Shared.Rules.Protection)
local RateLimiter = require(ReplicatedStorage.Shared.Rules.RateLimiter)
local Renounce = require(ReplicatedStorage.Shared.Rules.Renounce)
local ClaimService = require(script.Parent.ClaimService)
local CombatService = require(script.Parent.CombatService)
local DataService = require(script.Parent.DataService)
local Fighters = require(script.Parent.Fighters)
local Fx = require(script.Parent.Fx)
local LaunchConfig = require(script.Parent.LaunchConfig)
local LedgerService = require(script.Parent.LedgerService)
local ProtectionService = require(script.Parent.ProtectionService)
local TradeService = require(script.Parent.TradeService)
local TrialService = require(script.Parent.TrialService)

local STONE_TAG = "TallyStone"
local PROMPT_NAME = "RenouncePrompt"
local BUCKET_CAPACITY = 10
local BUCKET_REFILL_PER_SECOND = 5
local TAG_NAME = "CrownTag"
local CIRCLET_NAME = "GiltCirclet"
local GOLD = Color3.fromRGB(255, 215, 90)
local CIRCLET_GOLD = Color3.fromRGB(235, 190, 60)
local GEM_COLOR = Color3.fromRGB(150, 60, 200)
local LIGHT_SECONDS = 6
local SIXTY = math.rad(60)

local CrownService = {}

local ceremony: RemoteEvent
local tried: { [Player]: boolean } = {}
local badgeId: number = LaunchConfig.CROWNED_BADGE_ID
local awardFn: ((userId: number, badgeId: number) -> boolean)? = nil
local offerRemote: RemoteEvent
-- The open Renounce offer per player, and the shared rate-limit buckets for prompt and remote.
local offers: { [Player]: Renounce.Offer } = {}
local buckets: { [Player]: RateLimiter.Bucket } = {}
local clock: () -> number = os.clock
local connected: { [Instance]: boolean } = {}

local function realAward(userId: number, id: number): boolean
	return game:GetService("BadgeService"):AwardBadge(userId, id)
end

-- Removes only our own tag and circlet: the MARKED tag and party markers stay.
local function undress(character: Model, head: Instance?)
	if head ~= nil then
		for _, child in head:GetChildren() do
			if child.Name == TAG_NAME then
				child:Destroy()
			end
		end
	end
	for _, child in character:GetChildren() do
		if child.Name == CIRCLET_NAME then
			child:Destroy()
		end
	end
end

local function circletPart(
	name: string,
	size: Vector3,
	color: Color3,
	material: Enum.Material
): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.Color = color
	part.Material = material
	part.Massless = true
	part.Anchored = false
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	return part
end

local function buildTag(head: BasePart, title: string)
	local tag = Instance.new("BillboardGui")
	tag.Name = TAG_NAME
	tag.Adornee = head
	tag.AlwaysOnTop = true
	tag.MaxDistance = 150
	tag.Size = UDim2.fromOffset(180, 28)
	tag.StudsOffset = Vector3.new(0, 5.5, 0)

	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Text = title
	label.TextColor3 = GOLD
	label.TextStrokeTransparency = 0.3
	label.TextScaled = true
	label.Font = Enum.Font.GothamBold
	label.Parent = tag

	tag.Parent = head
end

local function buildCirclet(character: Model, head: BasePart, stars: number)
	local circlet = Instance.new("Model")
	circlet.Name = CIRCLET_NAME
	-- In the character first, so each weld sees both parts in the world.
	circlet.Parent = character
	local h = head.Size.Y / 2

	local function place(angle: number, radius: number, lift: number): CFrame
		return head.CFrame * CFrame.Angles(0, angle, 0) * CFrame.new(0, lift, -radius)
	end

	local function attach(part: BasePart, cframe: CFrame)
		part.CFrame = cframe
		part.Parent = circlet
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = head
		weld.Part1 = part
		weld.Parent = part
	end

	for k = 0, 5 do
		local point = circletPart(
			"CircletPoint",
			Vector3.new(0.3, 0.6, 0.3),
			CIRCLET_GOLD,
			Enum.Material.Metal
		)
		attach(point, place(k * SIXTY, 0.75, h + 0.15))
		local band = circletPart(
			"CircletBand",
			Vector3.new(0.78, 0.18, 0.18),
			CIRCLET_GOLD,
			Enum.Material.Metal
		)
		attach(band, place((k + 0.5) * SIXTY, 0.65, h - 0.05))
	end
	for k = 0, Crown.gems(stars) - 1 do
		local gem =
			circletPart("CircletGem", Vector3.new(0.28, 0.28, 0.28), GEM_COLOR, Enum.Material.Neon)
		gem.Shape = Enum.PartType.Ball
		attach(gem, place(k * SIXTY, 0.8, h - 0.05))
	end
end

-- Rebuilds the title tag and circlet from saved data. No yield.
local function dress(player: Player, character: Model?)
	if character == nil then
		return
	end
	local head = character:FindFirstChild("Head")
	undress(character, head)
	local data = DataService.get(player)
	if data == nil or head == nil or not head:IsA("BasePart") then
		return
	end
	local title = Crown.title(data.crown.crowns, data.crown.stars)
	if title == "" then
		return
	end
	buildTag(head, title)
	buildCirclet(character, head, data.crown.stars)
end

-- Attributes, tag and circlet from saved data. Does nothing without loaded data.
function CrownService.refresh(player: Player)
	local data = DataService.get(player)
	if data == nil then
		return
	end
	player:SetAttribute("Crowns", data.crown.crowns)
	player:SetAttribute("Stars", data.crown.stars)
	dress(player, player.Character)
end

local function checkBadge(player: Player)
	local data = DataService.get(player)
	local id = badgeId
	if data == nil or not Crown.wantsBadge(data.crown, id) or tried[player] then
		return
	end
	tried[player] = true
	local award = awardFn
	task.spawn(function()
		local given = false
		if award ~= nil then
			local ok, result = pcall(award, player.UserId, id)
			given = ok and result == true
		else
			local ok, result = pcall(realAward, player.UserId, id)
			given = ok and result == true
			if not given then
				-- Already owning the badge counts as awarded.
				local badgeService = game:GetService("BadgeService")
				local ok2, has =
					pcall(badgeService.UserHasBadgeAsync, badgeService, player.UserId, id)
				given = ok2 and has == true
			end
		end
		-- The calls above may have outlasted the data: read it again.
		local fresh = DataService.get(player)
		if given and fresh ~= nil then
			fresh.crown.badgeAwarded = true
		end
	end)
end

local function playLight(player: Player)
	local _, root = Fighters.body(player.UserId)
	if root == nil then
		return
	end
	local part = Instance.new("Part")
	part.Name = "CrownLight"
	part.Shape = Enum.PartType.Cylinder
	part.Size = Vector3.new(200, 8, 8)
	part.CFrame = CFrame.new(root.Position + Vector3.new(0, 100, 0))
		* CFrame.Angles(0, 0, math.rad(90))
	part.Material = Enum.Material.Neon
	part.Color = GOLD
	part.Transparency = 0.3
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Parent = Fx.folder()
	TweenService:Create(part, TweenInfo.new(LIGHT_SECONDS), { Transparency = 1 }):Play()
	task.delay(LIGHT_SECONDS + 0.5, part.Destroy, part)
	Fx.ring(root.Position, 20, GOLD)
end

-- No yielding call in here: the Crown record is read and written in one go.
local function tryCrown(player: Player)
	local data = DataService.get(player)
	if data == nil then
		return
	end
	if not Crown.canCrown(data.crown, data.ledger) then
		return
	end
	data.crown = Crown.crown(data.crown, data.ledger)
	local crowns = data.crown.crowns
	CrownService.refresh(player)
	LedgerService.notifyAll("LEDGER_COMPLETE", { player = player.DisplayName })
	LedgerService.notify(player, "CROWNED_YOU", { title = Crown.title(crowns, data.crown.stars) })
	ceremony:FireAllClients({ userId = player.UserId, name = player.DisplayName, crowns = crowns })
	playLight(player)
	checkBadge(player)
end

-- Play-test seam: award nil means the real BadgeService. Forgets who was already tried.
function CrownService.setBadge(id: number, award: ((userId: number, badgeId: number) -> boolean)?)
	badgeId = id
	awardFn = award
	table.clear(tried)
end

-- True if the player has a token left in their rate-limit bucket (takes one).
local function allowed(player: Player): boolean
	local now = os.clock()
	local bucket = buckets[player]
	if bucket == nil then
		bucket = RateLimiter.new(BUCKET_CAPACITY, now)
		buckets[player] = bucket
	end
	return RateLimiter.allow(bucket, now, BUCKET_CAPACITY, BUCKET_REFILL_PER_SECOND)
end

-- The facts Renounce.check needs, read fresh each time. No yield.
local function state(player: Player, now: number): Renounce.State
	local data = DataService.get(player)
	local _, root = Fighters.body(player.UserId)
	local status = ProtectionService.status(player, now)
	return {
		loaded = data ~= nil,
		complete = data ~= nil and Ledger.isComplete(data.ledger),
		crowns = if data ~= nil then data.crown.crowns else 0,
		stars = if data ~= nil then data.crown.stars else 0,
		alive = root ~= nil,
		locked = LedgerService.isLocked(player),
		claiming = ClaimService.isClaiming(player),
		-- Only an open session counts; a pending invite is not a trade.
		trading = TradeService.session(player) ~= nil,
		inTrial = TrialService.run(player) ~= nil,
		inTown = status ~= nil and status.inSafeZone,
		marked = status ~= nil and Protection.isMarked(status, now),
		lastFightAt = CombatService.lastFightAt(player),
	}
end

local function closeOffer(player: Player)
	offers[player] = nil
	offerRemote:FireClient(player, nil)
end

-- The Tally Stone prompt: checks, then opens the offer window on the player's screen.
-- Returns the message code (also the play-test seam's result).
function CrownService.beginRenounce(player: Player): string
	if player.Parent ~= Players or not allowed(player) then
		return "SLOW_DOWN"
	end
	local ok, code = Renounce.check(state(player, os.clock()), os.clock())
	if not ok then
		LedgerService.notify(player, code)
		return code
	end
	local data = DataService.get(player)
	if data == nil then
		LedgerService.notify(player, "DATA_NOT_LOADED")
		return "DATA_NOT_LOADED"
	end
	offers[player] = Renounce.offer(clock())
	offerRemote:FireClient(player, {
		lines = Renounce.offerLines(data.crown),
		seconds = Renounce.OFFER_SECONDS,
	})
	return "RENOUNCE_OFFER"
end

-- Play-test seam: the player's open offer, if any.
function CrownService.offer(player: Player): Renounce.Offer?
	return offers[player]
end

-- Play-test seam: the offer clock (default os.clock).
function CrownService.setClock(newClock: () -> number)
	clock = newClock
end

local function handleAction(player: Player, raw: any)
	if player.Parent ~= Players or not allowed(player) then
		return
	end
	local request = Renounce.parse(raw)
	if request == nil then
		LedgerService.notify(player, "BAD_REQUEST")
		return
	end
	if request.kind == "cancel" then
		if offers[player] ~= nil then
			closeOffer(player)
			LedgerService.notify(player, "RENOUNCE_CANCELLED")
		else
			LedgerService.notify(player, "RENOUNCE_NO_OFFER")
		end
		return
	end

	local word = request.word or ""
	local confirmed, confirmCode = Renounce.confirm(offers[player], word, clock())
	if not confirmed then
		LedgerService.notify(player, confirmCode)
		-- A wrong word keeps the offer open; an expired offer closes.
		if confirmCode == "RENOUNCE_EXPIRED" then
			closeOffer(player)
		end
		return
	end
	-- The world may have changed since the offer: check again with fresh facts.
	local ok, code = Renounce.check(state(player, os.clock()), os.clock())
	if not ok then
		closeOffer(player)
		LedgerService.notify(player, code)
		return
	end

	-- No yielding call from here to the last write: all five parts change, or none.
	local data = DataService.get(player)
	if data == nil then
		closeOffer(player)
		LedgerService.notify(player, "DATA_NOT_LOADED")
		return
	end
	local out = Renounce.apply({
		ledger = data.ledger,
		vault = data.vault,
		crown = data.crown,
		trials = data.trials,
		rounds = data.rounds,
	})
	if not LedgerService.set(player, out.ledger) then
		-- The data went away; drop the offer, and tell the client if it is still there.
		if player.Parent == Players then
			closeOffer(player)
		else
			offers[player] = nil
		end
		LedgerService.notify(player, "DATA_NOT_LOADED")
		return
	end
	LedgerService.setVault(player, out.vault)
	data.crown = out.crown
	data.trials = out.trials
	data.rounds = out.rounds
	offers[player] = nil

	offerRemote:FireClient(player, nil)
	LedgerService.notify(player, "RENOUNCE_DONE")
	LedgerService.notifyAll("RENOUNCED", { player = player.DisplayName })
	CrownService.refresh(player)
	TrialService.resync(player)
end

local function hookStone(stone: Instance)
	local prompt = stone:FindFirstChild(PROMPT_NAME)
	if prompt == nil or not prompt:IsA("ProximityPrompt") or connected[prompt] then
		return
	end
	connected[prompt] = true
	prompt.Triggered:Connect(function(player: Player)
		CrownService.beginRenounce(player)
	end)
end

local function watchPlayer(player: Player)
	player.CharacterAdded:Connect(function(character)
		task.spawn(function()
			local head = character:WaitForChild("Head", 5)
			if head ~= nil then
				dress(player, character)
			end
		end)
	end)
	local character = player.Character
	if character ~= nil then
		task.spawn(dress, player, character)
	end
end

function CrownService.start()
	ceremony = LedgerService.makeRemote(Net.Ceremony)
	offerRemote = LedgerService.makeRemote(Net.RenounceOffer)
	LedgerService.makeRemote(Net.RenounceAction).OnServerEvent:Connect(handleAction)

	for _, stone in CollectionService:GetTagged(STONE_TAG) do
		hookStone(stone)
	end
	CollectionService:GetInstanceAddedSignal(STONE_TAG):Connect(hookStone)

	LedgerService.onChanged(function(player)
		tryCrown(player)
	end)
	DataService.onLoaded(function(player)
		CrownService.refresh(player)
		tryCrown(player)
		checkBadge(player)
	end)

	Players.PlayerAdded:Connect(watchPlayer)
	for _, player in Players:GetPlayers() do
		watchPlayer(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		tried[player] = nil
		offers[player] = nil
		buckets[player] = nil
	end)
end

return CrownService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="73">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Crown = require(ReplicatedStorage.Shared.Rules.Crown)
local Ledger = require(ReplicatedStorage.Shared.Rules.Ledger)
local PathProgress = require(ReplicatedStorage.Shared.Rules.PathProgress)
local Rounds = require(ReplicatedStorage.Shared.Rules.Rounds)
local TrialRun = require(ReplicatedStorage.Shared.Rules.TrialRun)
local Types = require(ReplicatedStorage.Shared.Types)
local Vault = require(ReplicatedStorage.Shared.Rules.Vault)
local ProfileStore = require(script.Parent.Vendor.ProfileStore)

type PlayerData = Types.PlayerData

local DataService = {}

local TEMPLATE = {
	schemaVersion = 1,
	ledger = { claimed = {}, free = {} },
	coin = 0,
	vault = {},
	shieldEnded = false,
	paths = PathProgress.new(),
	trials = TrialRun.newRecord(),
	crown = Crown.newRecord(),
	rounds = Rounds.new(),
}

-- Longest a leaving player's profile stays open for holds.
local MAX_HOLD_SECONDS = 45
local HOLD_POLL_SECONDS = 0.25

local store = ProfileStore.New("PlayerData_v1", TEMPLATE)

-- Active profiles by player. An entry exists only between a finished load and its release.
local profiles: { [Player]: any } = {}
-- Players whose load is in flight, so a player is never loaded twice.
local loading: { [Player]: boolean } = {}
-- Players whose session is being ended because they are leaving, so they are not kicked.
local leaving: { [Player]: boolean } = {}
-- Number of open holds per player; a held profile stays open after the player has left.
local holds: { [Player]: number } = {}
local beforeReleaseCallbacks: { (player: Player) -> () } = {}
local loadedCallbacks: { (player: Player, data: PlayerData) -> () } = {}

local function fireLoaded(player: Player, data: PlayerData)
	for _, callback in loadedCallbacks do
		task.spawn(callback, player, data)
	end
end

local function loadProfile(player: Player)
	if profiles[player] ~= nil or loading[player] then
		return
	end
	loading[player] = true

	local profile = store:StartSessionAsync(tostring(player.UserId), {
		Cancel = function()
			return player.Parent ~= Players
		end,
	})
	loading[player] = nil

	if profile == nil then
		-- Cancelled because the player left (Kick is then a harmless no-op) or the load failed.
		if player.Parent == Players then
			player:Kick("Your data could not be loaded. Please rejoin.")
		end
		return
	end

	if player.Parent ~= Players then
		-- The player left while the profile was loading: release it and store nothing.
		profile:EndSession()
		return
	end

	profile:AddUserId(player.UserId)
	profile:Reconcile()
	profile.Data.ledger = Ledger.sanitize(profile.Data.ledger)
	profile.Data.vault = Vault.sanitize(profile.Data.vault, profile.Data.ledger)
	profile.Data.paths = PathProgress.sanitize(profile.Data.paths)
	profile.Data.trials = TrialRun.sanitize(profile.Data.trials, os.time())
	profile.Data.crown = Crown.sanitize(profile.Data.crown)
	profile.Data.rounds = Rounds.sanitize(profile.Data.rounds)
	if type(profile.Data.shieldEnded) ~= "boolean" then
		profile.Data.shieldEnded = false
	end
	local coin = profile.Data.coin
	if type(coin) ~= "number" or coin ~= coin or coin == math.huge or coin < 0 then
		profile.Data.coin = 0
	end

	profile.OnSessionEnd:Connect(function()
		if profiles[player] == profile then
			profiles[player] = nil
		end
		local isLeaving = leaving[player]
		leaving[player] = nil
		if player.Parent == Players and not isLeaving then
			player:Kick("Your data was loaded elsewhere. Please rejoin.")
		end
	end)

	profiles[player] = profile
	fireLoaded(player, profile.Data)
end

local function releaseProfile(player: Player)
	local profile = profiles[player]
	profiles[player] = nil
	if profile ~= nil then
		leaving[player] = true
		profile:EndSession()
	end
end

-- Runs when a player is leaving, before the profile is released. Holds are taken here.
function DataService.beforeRelease(callback: (player: Player) -> ())
	table.insert(beforeReleaseCallbacks, callback)
end

-- Keeps the player's profile open (for up to MAX_HOLD_SECONDS after they leave).
-- Returns a function that lets go; it works once only.
function DataService.hold(player: Player): () -> ()
	holds[player] = (holds[player] or 0) + 1
	local released = false
	return function()
		if released then
			return
		end
		released = true
		local count = holds[player]
		if count ~= nil then
			holds[player] = if count > 1 then count - 1 else nil
		end
	end
end

local function handleRemoving(player: Player)
	for _, callback in beforeReleaseCallbacks do
		local ok, err = pcall(callback, player)
		if not ok then
			warn(`[IsleOfAvarice] beforeRelease callback failed: {err}`)
		end
	end
	local deadline = os.clock() + MAX_HOLD_SECONDS
	while holds[player] ~= nil and os.clock() < deadline do
		task.wait(HOLD_POLL_SECONDS)
	end
	holds[player] = nil
	releaseProfile(player)
end

-- Returns the player's saved data, or nil until it has loaded and after it was released.
function DataService.get(player: Player): PlayerData?
	local profile = profiles[player]
	if profile ~= nil and profile:IsActive() then
		return profile.Data
	end
	return nil
end

-- The saved data of every player whose profile is open, including held players who have left.
function DataService.all(): { PlayerData }
	local result: { PlayerData } = {}
	for _, profile in profiles do
		if profile:IsActive() then
			table.insert(result, profile.Data)
		end
	end
	return result
end

-- Registers a callback that runs (in its own thread) once a player's data is loaded and sanitised.
-- Players whose data is already loaded are reported immediately.
function DataService.onLoaded(callback: (player: Player, data: PlayerData) -> ())
	table.insert(loadedCallbacks, callback)
	for player, profile in profiles do
		if profile:IsActive() then
			task.spawn(callback, player, profile.Data)
		end
	end
end

function DataService.start()
	Players.PlayerAdded:Connect(function(player)
		loadProfile(player)
	end)
	Players.PlayerRemoving:Connect(handleRemoving)
	for _, player in Players:GetPlayers() do
		task.spawn(loadProfile, player)
	end
end

return DataService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="74">
        <Properties>
          <string name="Name">EdictService</string>
          <string name="Source"><![CDATA[--!strict
-- The five Edicts (spec 3.13): using one from a free slot, the Veil, who has met whom, and
-- what a defeat destroys. EdictRules holds every rule; this service gathers the facts, checks
-- each request itself (who, where, when, whether they hold the card) and applies the result.
-- Veil and "met" are session state and never saved. No yielding call sits between reading a
-- Ledger and writing it back.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Cards = require(ReplicatedStorage.Shared.Catalog.Cards)
local EdictRules = require(ReplicatedStorage.Shared.Rules.EdictRules)
local Geography = require(ReplicatedStorage.Shared.Rules.Geography)
local Hazards = require(ReplicatedStorage.Shared.Rules.Hazards)
local Ledger = require(ReplicatedStorage.Shared.Rules.Ledger)
local Net = require(ReplicatedStorage.Shared.Net)
local Protection = require(ReplicatedStorage.Shared.Rules.Protection)
local RateLimiter = require(ReplicatedStorage.Shared.Rules.RateLimiter)
local Sites = require(ReplicatedStorage.Shared.Catalog.Sites)
local Types = require(ReplicatedStorage.Shared.Types)
local World = require(ReplicatedStorage.Shared.Catalog.World)
local CombatService = require(script.Parent.CombatService)
local DataService = require(script.Parent.DataService)
local Fighters = require(script.Parent.Fighters)
local LedgerService = require(script.Parent.LedgerService)
local ProtectionService = require(script.Parent.ProtectionService)
local TrialService = require(script.Parent.TrialService)

local BUCKET_CAPACITY = 10
local BUCKET_REFILL_PER_SECOND = 5
local MEET_TICK_SECONDS = 1
local HOMECOMING_LIFT = 4 -- above the spawn pad, so the character lands on it

local EdictService = {}

-- When each player's Veil ends, on os.clock().
local veilUntil: { [Player]: number } = {}
-- Who has come within MEET_RANGE of whom. Always set both ways.
local met: { [Player]: { [Player]: boolean } } = {}
local buckets: { [Player]: RateLimiter.Bucket } = {}
local resultRemote: RemoteEvent
local syncRemote: RemoteEvent
local accumulated = 0
local rng: () -> number = math.random

local function allowed(player: Player): boolean
	local now = os.clock()
	local bucket = buckets[player]
	if bucket == nil then
		bucket = RateLimiter.new(BUCKET_CAPACITY, now)
		buckets[player] = bucket
	end
	return RateLimiter.allow(bucket, now, BUCKET_CAPACITY, BUCKET_REFILL_PER_SECOND)
end

local function vec(position: Vector3): Types.Vec3
	return { x = position.X, y = position.Y, z = position.Z }
end

function EdictService.isVeiled(player: Player): boolean
	return EdictRules.isVeiled(veilUntil[player], os.clock())
end

-- Veil seconds left and the players this one has met who are still here, by name.
local function sync(player: Player)
	if player.Parent ~= Players then
		return
	end
	local list: { { userId: number, name: string } } = {}
	local others = met[player]
	if others ~= nil then
		for other in others do
			if other.Parent == Players then
				table.insert(list, { userId = other.UserId, name = other.DisplayName })
			end
		end
	end
	table.sort(list, function(a, b)
		if a.name ~= b.name then
			return a.name < b.name
		end
		return a.userId < b.userId
	end)
	syncRemote:FireClient(player, EdictRules.veilSeconds(veilUntil[player], os.clock()), list)
end

-- Marks the two as having met. True when it was new for either side.
local function markMet(a: Player, b: Player): boolean
	local fresh = false
	local aMet = met[a]
	if aMet == nil then
		aMet = {}
		met[a] = aMet
	end
	if not aMet[b] then
		aMet[b] = true
		fresh = true
	end
	local bMet = met[b]
	if bMet == nil then
		bMet = {}
		met[b] = bMet
	end
	if not bMet[a] then
		bMet[a] = true
		fresh = true
	end
	return fresh
end

-- Play-test seam: marks the two as having met.
function EdictService.meet(a: Player, b: Player)
	if markMet(a, b) then
		sync(a)
		sync(b)
	end
end

-- Play-test seam: the defeat-loss rolls (default math.random).
function EdictService.setRng(roll: () -> number)
	rng = roll
end

-- Once a second: every pair of living players within MEET_RANGE has met.
local function meetTick()
	local present: { { player: Player, position: Types.Vec3 } } = {}
	for _, player in Players:GetPlayers() do
		local _, root = Fighters.body(player.UserId)
		if root ~= nil then
			table.insert(present, { player = player, position = vec(root.Position) })
		end
	end
	for i = 1, #present do
		for j = i + 1, #present do
			local a, b = present[i], present[j]
			if EdictRules.near(a.position, b.position, EdictRules.MEET_RANGE) then
				EdictService.meet(a.player, b.player)
			end
		end
	end
end

-- Passage and Homecoming. Not while Marked, in a fight, or in a trial; a player with no
-- loaded data or no living body is not told anything more than "not now".
local function travelAllowed(player: Player, now: number): (boolean, string)
	local status = ProtectionService.status(player, now)
	if status == nil then
		return false, "EDICT_NOT_NOW"
	end
	local ok, code = EdictRules.canTravel({
		marked = Protection.isMarked(status, now),
		lastFightAt = CombatService.lastFightAt(player),
		inTrial = TrialService.run(player) ~= nil,
	}, now)
	return ok, code or "EDICT_NOT_NOW"
end

-- Players, effects and creatures do not count as something solid to land in.
local function overlapParams(): OverlapParams
	local ignore: { Instance } = {}
	for _, other in Players:GetPlayers() do
		if other.Character ~= nil then
			table.insert(ignore, other.Character)
		end
	end
	for _, name in { "Effects", "Creatures" } do
		local folder = workspace:FindFirstChild(name)
		if folder ~= nil then
			table.insert(ignore, folder)
		end
	end
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = ignore
	params.RespectCanCollide = true
	return params
end

local function isClear(x: number, z: number, y: number, params: OverlapParams): boolean
	if not Geography.isLand(x, z) then
		return false
	end
	-- Not inside a wall, a tree or a building.
	if #workspace:GetPartBoundsInBox(CFrame.new(x, y, z), Vector3.new(4, 5, 4), params) > 0 then
		return false
	end
	for _, hazard in Sites.hazards do
		if Hazards.affects(hazard, x, z) then
			return false
		end
	end
	return true
end

local function moveRoot(root: BasePart, x: number, y: number, z: number)
	root.CFrame = CFrame.new(x, y, z) * root.CFrame.Rotation
	root.AssemblyLinearVelocity = Vector3.zero
end

-- The Ledger after the card is used up. Written in the same step as the effect.
local function consume(player: Player, ledger: Types.Ledger, use: EdictRules.Use)
	local after = Ledger.discard(ledger, use.freeIndex)
	if after ~= nil then
		LedgerService.set(player, after)
	end
end

local function useSummons(player: Player, ledger: Types.Ledger, use: EdictRules.Use)
	local relicId = use.relicId
	if relicId == nil then
		return
	end
	local people: { EdictRules.Person } = {}
	for _, other in Players:GetPlayers() do
		local data = DataService.get(other)
		if data ~= nil then
			table.insert(people, {
				userId = other.UserId,
				name = other.DisplayName,
				ledger = data.ledger,
				veiled = EdictService.isVeiled(other),
			})
		end
	end
	local names = EdictRules.holders(people, relicId, player.UserId)
	resultRemote:FireClient(player, EdictRules.summonsResult(relicId, names))
	consume(player, ledger, use)
end

local function useAudit(player: Player, root: BasePart, ledger: Types.Ledger, use: EdictRules.Use)
	local others: { EdictRules.Body } = {}
	for _, other in Players:GetPlayers() do
		if other ~= player then
			local _, otherRoot = Fighters.body(other.UserId)
			if otherRoot ~= nil then
				table.insert(others, { userId = other.UserId, position = vec(otherRoot.Position) })
			end
		end
	end
	local targetId =
		EdictRules.auditTarget({ userId = player.UserId, position = vec(root.Position) }, others)
	local target = if targetId ~= nil then Players:GetPlayerByUserId(targetId) else nil
	local targetData = if target ~= nil then DataService.get(target) else nil
	if target == nil or targetData == nil then
		LedgerService.notify(player, "EDICT_NO_TARGET")
		return
	end
	if EdictService.isVeiled(target) then
		resultRemote:FireClient(player, EdictRules.veiledResult(target.DisplayName))
	else
		resultRemote:FireClient(
			player,
			EdictRules.auditResult(target.DisplayName, targetData.ledger, targetData.vault)
		)
		LedgerService.notify(target, "AUDITED", { player = player.DisplayName })
	end
	consume(player, ledger, use)
end

local function useVeil(player: Player, ledger: Types.Ledger, use: EdictRules.Use)
	veilUntil[player] = os.clock() + EdictRules.VEIL_SECONDS
	LedgerService.notify(player, "EDICT_VEIL_ON")
	consume(player, ledger, use)
	sync(player)
end

local function usePassage(
	player: Player,
	root: BasePart,
	ledger: Types.Ledger,
	use: EdictRules.Use,
	now: number
)
	local targetId = use.targetId
	local entry = if targetId ~= nil then Fighters.get(targetId) else nil
	local target = if entry ~= nil and entry.kind == "player" then entry.player else nil
	local metSet = met[player]
	if target == nil or target == player or metSet == nil or not metSet[target] then
		LedgerService.notify(player, "EDICT_NOT_MET")
		return
	end
	local _, targetRoot = Fighters.body(target.UserId)
	if targetRoot == nil then
		LedgerService.notify(player, "EDICT_NO_TARGET")
		return
	end
	local ok, code = travelAllowed(player, now)
	if not ok then
		LedgerService.notify(player, code)
		return
	end
	local params = overlapParams()
	local targetY = targetRoot.Position.Y
	local spot = EdictRules.arrival(vec(targetRoot.Position), function(x: number, z: number)
		return isClear(x, z, targetY, params)
	end)
	moveRoot(root, spot.x, spot.y, spot.z)
	LedgerService.notify(player, "PASSAGE_DONE", { player = target.DisplayName })
	consume(player, ledger, use)
end

local function useHomecoming(
	player: Player,
	root: BasePart,
	ledger: Types.Ledger,
	use: EdictRules.Use,
	now: number
)
	local ok, code = travelAllowed(player, now)
	if not ok then
		LedgerService.notify(player, code)
		return
	end
	moveRoot(root, World.spawn.x, World.spawn.y + HOMECOMING_LIFT, World.spawn.z)
	LedgerService.notify(player, "HOMECOMING_DONE")
	consume(player, ledger, use)
end

-- The client names a card row and what it needs; everything else is checked here, in order:
-- present and not too fast, Ledger not locked, a valid request for a card actually held there,
-- a living body. Nothing changes on a refusal.
local function handleUse(player: Player, raw: any)
	if player.Parent ~= Players or not allowed(player) then
		return
	end
	if LedgerService.isLocked(player) then
		LedgerService.notify(player, "LEDGER_LOCKED")
		return
	end
	local ledger = LedgerService.get(player)
	local use, code = EdictRules.parseUse(ledger, raw)
	if use == nil or ledger == nil then
		LedgerService.notify(player, code)
		return
	end
	local humanoid, root = Fighters.body(player.UserId)
	if humanoid == nil or root == nil then
		LedgerService.notify(player, "EDICT_NOT_NOW")
		return
	end

	-- No yielding call from here to the Ledger write: the Ledger read cannot go stale.
	local now = os.clock()
	if use.key == "summons" then
		useSummons(player, ledger, use)
	elseif use.key == "audit" then
		useAudit(player, root, ledger, use)
	elseif use.key == "veil" then
		useVeil(player, ledger, use)
	elseif use.key == "passage" then
		usePassage(player, root, ledger, use, now)
	elseif use.key == "homecoming" then
		useHomecoming(player, root, ledger, use, now)
	end
end

-- A defeat destroys a third of the Edicts held (never Relics).
local function onDefeated(player: Player)
	if player.Parent ~= Players then
		return
	end
	local data = DataService.get(player)
	if data == nil then
		return
	end
	local after, lost = EdictRules.defeatLoss(data.ledger, rng)
	if #lost == 0 then
		return
	end
	if LedgerService.set(player, after) then
		LedgerService.notify(player, "EDICTS_LOST", { names = Cards.names(lost) })
	end
end

local function watchCharacter(player: Player, character: Model)
	local humanoid = character:WaitForChild("Humanoid", 10)
	if humanoid == nil or not humanoid:IsA("Humanoid") then
		return
	end
	humanoid.Died:Connect(function()
		onDefeated(player)
	end)
end

local function watchPlayer(player: Player)
	player.CharacterAdded:Connect(function(character)
		watchCharacter(player, character)
	end)
	local character = player.Character
	if character ~= nil then
		task.spawn(watchCharacter, player, character)
	end
end

local function onHeartbeat(deltaTime: number)
	accumulated += deltaTime
	if accumulated < MEET_TICK_SECONDS then
		return
	end
	accumulated = 0
	local ok, err = pcall(meetTick)
	if not ok then
		warn(`[IsleOfAvarice] EdictService meeting tick failed: {err}`)
	end
end

local function onRemoving(player: Player)
	veilUntil[player] = nil
	buckets[player] = nil
	met[player] = nil
	-- Everyone who had met them forgets them and is told.
	for other, others in met do
		if others[player] then
			others[player] = nil
			sync(other)
		end
	end
end

function EdictService.start()
	resultRemote = LedgerService.makeRemote(Net.EdictResult)
	syncRemote = LedgerService.makeRemote(Net.EdictSync)
	LedgerService.makeRemote(Net.EdictUse).OnServerEvent:Connect(handleUse)

	Players.PlayerAdded:Connect(watchPlayer)
	for _, player in Players:GetPlayers() do
		watchPlayer(player)
	end
	DataService.onLoaded(function(player)
		sync(player)
	end)
	Players.PlayerRemoving:Connect(onRemoving)
	RunService.Heartbeat:Connect(onHeartbeat)
end

return EdictService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="75">
        <Properties>
          <string name="Name">Fighters</string>
          <string name="Source"><![CDATA[--!strict
-- The registry of everything that fights, by numeric fighter id: players (their UserId),
-- training posts (World.POST_ID_BASE - i) and, from Task 9, creatures. Never infer a kind
-- from an id's sign: ask Fighters.get(id).kind.
--   Fighters.start()              players on join and leave; every TrainingPost part with a
--                                 valid PostId, now and when tagged later
--   Fighters.add(entry)           replaces any entry with the same id
--   Fighters.remove(id)
--   Fighters.get(id): Entry?
--   Fighters.all(): { Entry }     every entry: players, then posts, then creatures
--   Fighters.model(id)            character, post part or creature model
--   Fighters.body(id)             living Humanoid and root of a player or creature
--   Fighters.fighter(id)          Combat.Fighter at the root (posts: the part, look +z)
--   Fighters.list(viewer)         every other living fighter the viewer may fight
--   Fighters.mayFight(a, b)       whether `a` may hit `b` (never an ally)
--   Fighters.setAllies(fn)        PartyService installs who is allied; default: nobody
--   Fighters.allies(id)           a fresh copy of the ids allied with `id`
--   Fighters.allied(a, b)         a ~= b and b is allied with a
-- Requires only Roblox services and shared modules, so every server service may require it.
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Combat = require(ReplicatedStorage.Shared.Rules.Combat)
local World = require(ReplicatedStorage.Shared.Catalog.World)

export type Kind = "player" | "post" | "creature"
export type Entry = {
	id: number,
	kind: Kind,
	player: Player?, -- kind "player"
	-- A post part or creature model; a player's is read live from player.Character.
	model: Instance?,
	-- WalkSpeed with no slow or root: players 16, posts 0, creatures their catalog speed.
	baseSpeed: number,
	-- Creatures only: the one fighter id that may hit it or be hit by it (duel champion).
	owner: number?,
}

local POST_TAG = "TrainingPost"
local PLAYER_SPEED = 16
local KIND_ORDER: { Kind } = { "player", "post", "creature" }

local Fighters = {}

local entries: { [number]: Entry } = {}
-- Ids in the order they were first added, so lists come out in a stable order.
local order: { number } = {}
-- Who counts as an ally of an id. PartyService replaces it; the default has no allies.
local allyLookup: (id: number) -> { number } = function(_id: number): { number }
	return {}
end

function Fighters.add(entry: Entry)
	if entries[entry.id] == nil then
		table.insert(order, entry.id)
	end
	entries[entry.id] = entry
end

function Fighters.remove(id: number)
	if entries[id] == nil then
		return
	end
	entries[id] = nil
	local index = table.find(order, id)
	if index ~= nil then
		table.remove(order, index)
	end
end

function Fighters.get(id: number): Entry?
	return entries[id]
end

-- Every entry, players first, then posts, then creatures, each in the order they were added.
function Fighters.all(): { Entry }
	local result: { Entry } = {}
	for _, kind in KIND_ORDER do
		for _, id in order do
			local entry = entries[id]
			if entry ~= nil and entry.kind == kind then
				table.insert(result, entry)
			end
		end
	end
	return result
end

function Fighters.model(id: number): Instance?
	local entry = entries[id]
	if entry == nil then
		return nil
	end
	if entry.kind == "player" then
		local player = entry.player
		return if player ~= nil then player.Character else nil
	end
	return entry.model
end

-- The Humanoid and HumanoidRootPart of a living player or creature, or nil.
function Fighters.body(id: number): (Humanoid?, BasePart?)
	local entry = entries[id]
	if entry == nil or entry.kind == "post" then
		return nil, nil
	end
	local model = Fighters.model(id)
	if model == nil then
		return nil, nil
	end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if humanoid == nil or humanoid.Health <= 0 then
		return nil, nil
	end
	local root = model:FindFirstChild("HumanoidRootPart")
	if root == nil or not root:IsA("BasePart") then
		return nil, nil
	end
	return humanoid, root
end

-- A living fighter's position and facing; health for players and creatures, none for posts.
-- Nil for a dead player or creature, and for a post whose part is not in the world.
function Fighters.fighter(id: number): Combat.Fighter?
	local entry = entries[id]
	if entry == nil then
		return nil
	end
	if entry.kind == "post" then
		local model = entry.model
		if model == nil or not model:IsA("BasePart") or not model:IsDescendantOf(workspace) then
			return nil
		end
		local p = (model :: BasePart).Position
		return {
			id = id,
			position = { x = p.X, y = p.Y, z = p.Z },
			look = { x = 0, y = 0, z = 1 },
		}
	end
	local humanoid, root = Fighters.body(id)
	if humanoid == nil or root == nil then
		return nil
	end
	local p = root.Position
	local look = root.CFrame.LookVector
	return {
		id = id,
		position = { x = p.X, y = p.Y, z = p.Z },
		look = { x = look.X, y = look.Y, z = look.Z },
		health = humanoid.Health,
	}
end

-- Installed by PartyService; until then nobody has allies.
function Fighters.setAllies(alliesOf: (id: number) -> { number })
	allyLookup = alliesOf
end

-- A fresh copy of the ids allied with `id` (its party mates), so callers may keep it.
function Fighters.allies(id: number): { number }
	return table.clone(allyLookup(id))
end

-- True when `b` is a party mate of `a`; never true for a fighter and itself.
function Fighters.allied(a: number, b: number): boolean
	return a ~= b and table.find(allyLookup(a), b) ~= nil
end

-- False for a fighter against itself, for allies, for an unknown id, for a post attacker, and
-- when either side has an owner that is not the other.
function Fighters.mayFight(a: number, b: number): boolean
	if a == b then
		return false
	end
	if Fighters.allied(a, b) then
		return false
	end
	local attacker, target = entries[a], entries[b]
	if attacker == nil or target == nil or attacker.kind == "post" then
		return false
	end
	if attacker.owner ~= nil and attacker.owner ~= b then
		return false
	end
	if target.owner ~= nil and target.owner ~= a then
		return false
	end
	return true
end

-- Every other living fighter `viewer` may fight, posts included: players first, then posts,
-- then creatures.
function Fighters.list(viewer: number): { Combat.Fighter }
	local result: { Combat.Fighter } = {}
	for _, entry in Fighters.all() do
		if not Fighters.mayFight(viewer, entry.id) then
			continue
		end
		local fighter = Fighters.fighter(entry.id)
		if fighter ~= nil then
			table.insert(result, fighter)
		end
	end
	return result
end

local function postIdOf(instance: Instance): number?
	local id = instance:GetAttribute("PostId")
	if instance:IsA("BasePart") and type(id) == "number" and World.postIndex(id) ~= nil then
		return id
	end
	return nil
end

local function addPost(instance: Instance)
	local id = postIdOf(instance)
	if id ~= nil then
		Fighters.add({ id = id, kind = "post", model = instance, baseSpeed = 0 })
	end
end

local function removePost(instance: Instance)
	local id = postIdOf(instance)
	if id == nil then
		return
	end
	local entry = entries[id]
	if entry ~= nil and entry.model == instance then
		Fighters.remove(id)
	end
end

local function addPlayer(player: Player)
	Fighters.add({ id = player.UserId, kind = "player", player = player, baseSpeed = PLAYER_SPEED })
end

function Fighters.start()
	Players.PlayerAdded:Connect(addPlayer)
	for _, player in Players:GetPlayers() do
		addPlayer(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		-- Only this Player's own entry: a rejoin under the same UserId may already own the id.
		local entry = entries[player.UserId]
		if entry ~= nil and entry.player == player then
			Fighters.remove(player.UserId)
		end
	end)

	-- Posts in index order, so lists keep the catalog order.
	local tagged = CollectionService:GetTagged(POST_TAG)
	table.sort(tagged, function(a, b)
		local ia = World.postIndex(postIdOf(a) or 0) or math.huge
		local ib = World.postIndex(postIdOf(b) or 0) or math.huge
		return ia < ib
	end)
	for _, instance in tagged do
		addPost(instance)
	end
	CollectionService:GetInstanceAddedSignal(POST_TAG):Connect(addPost)
	CollectionService:GetInstanceRemovedSignal(POST_TAG):Connect(removePost)
end

return Fighters
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="76">
        <Properties>
          <string name="Name">Fx</string>
          <string name="Source"><![CDATA[--!strict
-- Short-lived, server-made visuals in workspace.Effects: shot rays and burst rings. Shared by
-- AbilityService and CreatureService. Rays and characters pass through all of it.
local Debris = game:GetService("Debris")

local SHOT_WIDTH = 0.3
local SHOT_SECONDS = 0.15
local RING_SECONDS = 0.3
local RING_SEGMENTS = 24
local RING_WIDTH = 0.6
local RING_HEIGHT = 0.2

local Fx = {}

function Fx.folder(): Folder
	local existing = workspace:FindFirstChild("Effects")
	if existing ~= nil and existing:IsA("Folder") then
		return existing
	end
	local folder = Instance.new("Folder")
	folder.Name = "Effects"
	folder.Parent = workspace
	return folder
end

local function effectPart(name: string, color: Color3): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Material = Enum.Material.Neon
	part.Color = color
	return part
end

-- A thin beam from one point to another.
function Fx.ray(from: Vector3, to: Vector3, color: Color3)
	local length = (to - from).Magnitude
	if not (length > 0 and length < math.huge) then
		return
	end
	local part = effectPart("Shot", color)
	part.Size = Vector3.new(SHOT_WIDTH, SHOT_WIDTH, length)
	part.CFrame = CFrame.lookAt(from, to) * CFrame.new(0, 0, -length / 2)
	part.Parent = Fx.folder()
	Debris:AddItem(part, SHOT_SECONDS)
end

-- A flat ring of the given radius around a point.
function Fx.ring(center: Vector3, radius: number, color: Color3)
	if not (radius > 0 and radius < math.huge) then
		return
	end
	local ring = Instance.new("Model")
	ring.Name = "Ring"
	local segment = 2 * radius * math.sin(math.pi / RING_SEGMENTS) + RING_WIDTH
	for i = 1, RING_SEGMENTS do
		local part = effectPart("Segment", color)
		-- Local X points outwards from the centre, local Z along the ring.
		part.Size = Vector3.new(RING_WIDTH, RING_HEIGHT, segment)
		part.CFrame = CFrame.new(center)
			* CFrame.Angles(0, (i - 1) / RING_SEGMENTS * 2 * math.pi, 0)
			* CFrame.new(radius, 0, 0)
		part.Parent = ring
	end
	ring.Parent = Fx.folder()
	Debris:AddItem(ring, RING_SECONDS)
end

return Fx
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="77">
        <Properties>
          <string name="Name">HazardService</string>
          <string name="Source"><![CDATA[--!strict
-- Applies the island's hazards to every player four times a second. The server decides all
-- of it: damage, healing, slow and drowning. The gust push is the one client-applied effect
-- and is not handled here. Hazard cycles run on workspace:GetServerTimeNow().
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Effects = require(ReplicatedStorage.Shared.Rules.Effects)
local Geography = require(ReplicatedStorage.Shared.Rules.Geography)
local Hazards = require(ReplicatedStorage.Shared.Rules.Hazards)
local Sites = require(ReplicatedStorage.Shared.Catalog.Sites)
local CombatService = require(script.Parent.CombatService)
local StatusService = require(script.Parent.StatusService)

-- A long stall must not turn into one huge damage or healing step.
local MAX_ELAPSED_SECONDS = 1

local HazardService = {}

-- Real time gathered since the last tick.
local accumulated = 0
-- The last burst cycle that hit each player, by hazard id, so a burst lands once per cycle.
local lastBurst: { [Player]: { [string]: number } } = {}

-- The Humanoid and HumanoidRootPart of a living character, or nil.
local function living(player: Player): (Humanoid?, BasePart?)
	local character = player.Character
	if character == nil then
		return nil, nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid == nil or humanoid.Health <= 0 then
		return nil, nil
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	if root == nil or not root:IsA("BasePart") then
		return nil, nil
	end
	return humanoid, root
end

-- One player's share of a tick: drowning, damage, bursts, healing, then slow.
local function tickPlayer(player: Player, now: number, elapsed: number)
	local humanoid, root = living(player)
	if humanoid == nil or root == nil then
		return
	end
	local position = root.Position
	if position.Y < Geography.DROWN_Y then
		CombatService.environmentDefeat(player)
		return
	end

	local sample = Hazards.sample(Sites.hazards, position.X, position.Z, now)
	if sample.dps > 0 then
		CombatService.environmentDamage(player, sample.dps * elapsed)
	end

	if #sample.bursts > 0 then
		local seen = lastBurst[player]
		if seen == nil then
			seen = {}
			lastBurst[player] = seen
		end
		for _, burst in sample.bursts do
			if seen[burst.id] ~= burst.cycle then
				seen[burst.id] = burst.cycle
				CombatService.environmentDamage(player, burst.damage, true)
			end
		end
	end

	if sample.heal > 0 and humanoid.Health > 0 then
		humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + sample.heal * elapsed)
	end

	local slow = sample.slow
	if slow < 1 then
		StatusService.update(player.UserId, function(status, at)
			return Effects.applyAmbientSlow(status, slow, Hazards.SLOW_SECONDS, at)
		end)
	end
end

local function runTick(elapsed: number)
	local now = workspace:GetServerTimeNow()
	local failures = 0
	local firstError = ""
	for _, player in Players:GetPlayers() do
		local ok, err = pcall(tickPlayer, player, now, elapsed)
		if not ok then
			failures += 1
			if failures == 1 then
				firstError = tostring(err)
			end
		end
	end
	-- One warning per tick, however many players failed: this runs four times a second.
	if failures > 0 then
		warn(`[IsleOfAvarice] HazardService failed for {failures} player(s): {firstError}`)
	end
end

local function onHeartbeat(deltaTime: number)
	accumulated += deltaTime
	if accumulated < Hazards.TICK_SECONDS then
		return
	end
	local elapsed = math.min(accumulated, MAX_ELAPSED_SECONDS)
	accumulated = 0
	runTick(elapsed)
end

function HazardService.start()
	Players.PlayerRemoving:Connect(function(player)
		lastBurst[player] = nil
	end)
	RunService.Heartbeat:Connect(onHeartbeat)
end

return HazardService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="78">
        <Properties>
          <string name="Name">LaunchConfig</string>
          <string name="Source"><![CDATA[--!strict
-- Things the owner sets once before the game goes live.
return {
	-- The Crowned badge's id from the Creator Dashboard. 0 means no badge: nothing is awarded.
	CROWNED_BADGE_ID = 0,
	-- The ordered data store that holds the all-time board. A new name starts an empty board.
	BOARD_STORE = "CrownedBoard_v1",
}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="79">
        <Properties>
          <string name="Name">LeaderboardService</string>
          <string name="Source"><![CDATA[--!strict
-- The all-time board of the Crowned on the Tally Stone. One background thread writes players'
-- Crown counts to an ordered data store, reads the top rows back and redraws the stone. Every
-- data store and name call is in pcall and lives only in this thread, so a failing store never
-- slows the game and the board still shows this server's players.
local CollectionService = game:GetService("CollectionService")
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Leaderboard = require(ReplicatedStorage.Shared.Rules.Leaderboard)
local DataService = require(script.Parent.DataService)
local LaunchConfig = require(script.Parent.LaunchConfig)

export type Backend = {
	write: (userId: number, crowns: number) -> boolean, -- true when stored
	readTop: (count: number) -> { Leaderboard.Entry }?, -- nil when it could not read
}

local LeaderboardService = {}

local TAG = "TallyStone"
local ROUND_SECONDS = 2
local EARLY_READ_SECONDS = 5

local realBackend: Backend? = nil
local backend: Backend? = nil
local stored: { Leaderboard.Entry } = {}
local online = false
local lastReadAt = -math.huge
local readSoon = false
local lastFailAt: { [Player]: number } = {}
local names: { [string]: string } = {}
local askedName: { [number]: boolean } = {}
local view: Leaderboard.View = Leaderboard.view({}, {}, false)
local busy = false
local warned: { [string]: boolean } = {}

-- The first failure of each kind warns; later ones are silent.
local function warnOnce(kind: string, message: unknown)
	if warned[kind] then
		return
	end
	warned[kind] = true
	warn(`[IsleOfAvarice] board: {kind} failed: {message}`)
end

-- The ordered data store, or nil (an unpublished place has none).
local function makeRealBackend(): Backend?
	local ok, result = pcall(function()
		return DataStoreService:GetOrderedDataStore(LaunchConfig.BOARD_STORE)
	end)
	if not ok or result == nil then
		warnOnce("store", result)
		return nil
	end
	local store = result :: any
	return {
		write = function(userId: number, crowns: number): boolean
			-- Only Studio test players have ids below 1, and Leaderboard.fromPage cannot read
			-- such a key back, so the real store is never asked to keep one. Counts as a
			-- failed write: it is retried only after RETRY_SECONDS, and it never warns.
			if userId < 1 then
				return false
			end
			local wrote, err = pcall(store.UpdateAsync, store, tostring(userId), function(old: any)
				return Leaderboard.keep(old, crowns)
			end)
			if not wrote then
				warnOnce("write", err)
			end
			return wrote
		end,
		readTop = function(count: number): { Leaderboard.Entry }?
			local read, page = pcall(function()
				return store:GetSortedAsync(false, count):GetCurrentPage()
			end)
			if not read then
				warnOnce("read", page)
				return nil
			end
			return Leaderboard.fromPage(page)
		end,
	}
end

-- Writes the view onto the Tally Stone's board.
local function draw()
	for _, stone in CollectionService:GetTagged(TAG) do
		local board = stone:FindFirstChild("Board")
		if board == nil then
			continue
		end
		local title = board:FindFirstChild("Title")
		if title ~= nil and title:IsA("TextLabel") then
			title.Text = view.title
		end
		local subtitle = board:FindFirstChild("Subtitle")
		if subtitle ~= nil and subtitle:IsA("TextLabel") then
			subtitle.Text = view.subtitle
		end
		for i = 1, Leaderboard.ROWS do
			local row = board:FindFirstChild("Row" .. i)
			if row ~= nil and row:IsA("TextLabel") then
				row.Text = view.rows[i] or ""
			end
		end
	end
end

local function writePass()
	local current = backend
	if current == nil then
		return
	end
	for _, player in Players:GetPlayers() do
		local data = DataService.get(player)
		if data == nil then
			continue
		end
		local crowns = data.crown.crowns
		if
			not Leaderboard.shouldWrite(
				crowns,
				data.crown.boardCrowns,
				lastFailAt[player],
				os.clock()
			)
		then
			continue
		end
		local ok = current.write(player.UserId, crowns)
		-- The write yielded: the player may have left since.
		if player.Parent ~= Players then
			continue
		end
		if ok then
			local after = DataService.get(player)
			if after ~= nil then
				after.crown.boardCrowns = math.max(after.crown.boardCrowns, crowns)
			end
			readSoon = true
			lastFailAt[player] = nil
		else
			lastFailAt[player] = os.clock()
		end
	end
end

local function readPass()
	local sinceRead = os.clock() - lastReadAt
	if
		not (
			sinceRead >= Leaderboard.REFRESH_SECONDS
			or (readSoon and sinceRead >= EARLY_READ_SECONDS)
		)
	then
		return
	end
	lastReadAt = os.clock()
	readSoon = false
	local current = backend
	local rows = if current ~= nil then current.readTop(Leaderboard.ROWS) else nil
	if rows == nil then
		online = false
		return
	end
	stored = rows
	online = true
	local present: { [number]: boolean } = {}
	for _, player in Players:GetPlayers() do
		present[player.UserId] = true
	end
	for _, entry in rows do
		local id = entry.userId
		if present[id] or askedName[id] then
			continue
		end
		askedName[id] = true
		local ok, name = pcall(Players.GetNameFromUserIdAsync, Players, id)
		if ok and type(name) == "string" then
			names[tostring(id)] = name
		else
			warnOnce("name", name)
		end
	end
end

local function drawPass()
	local live: { Leaderboard.Entry } = {}
	for _, player in Players:GetPlayers() do
		names[tostring(player.UserId)] = player.Name
		local data = DataService.get(player)
		if data ~= nil and data.crown.crowns >= 1 then
			table.insert(live, { userId = player.UserId, crowns = data.crown.crowns })
		end
	end
	local base: { Leaderboard.Entry } = if online then stored else {}
	view = Leaderboard.view(Leaderboard.merge(base, live), names, online)
	draw()
end

local function runRound()
	busy = true
	local ok, err = pcall(function()
		-- Draw what this server knows first, so a new Crown shows at once; the store calls
		-- below can be slow and only refine the board.
		drawPass()
		writePass()
		readPass()
		drawPass()
	end)
	busy = false
	if not ok then
		warnOnce("round", err)
	end
end

-- Play-test seam: nil puts the real ordered data store back.
function LeaderboardService.setBackend(newBackend: Backend?)
	backend = newBackend or realBackend
	stored = {}
	online = false
	lastReadAt = -math.huge
	table.clear(lastFailAt)
end

-- Play-test seam: one write pass, one read, one draw, now.
function LeaderboardService.refreshNow()
	while busy do
		task.wait(0.1)
	end
	lastReadAt = -math.huge
	runRound()
end

-- Play-test seam: the view last drawn.
function LeaderboardService.board(): Leaderboard.View
	return view
end

function LeaderboardService.isOnline(): boolean
	return online
end

function LeaderboardService.start()
	realBackend = makeRealBackend()
	backend = realBackend
	Players.PlayerRemoving:Connect(function(player)
		lastFailAt[player] = nil
	end)
	task.spawn(function()
		while true do
			if not busy then
				runRound()
			end
			task.wait(ROUND_SECONDS)
		end
	end)
end

return LeaderboardService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="80">
        <Properties>
          <string name="Name">LedgerService</string>
          <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LedgerActions = require(ReplicatedStorage.Shared.Rules.LedgerActions)
local RateLimiter = require(ReplicatedStorage.Shared.Rules.RateLimiter)
local Net = require(ReplicatedStorage.Shared.Net)
local Cards = require(ReplicatedStorage.Shared.Catalog.Cards)
local Types = require(ReplicatedStorage.Shared.Types)
local Vault = require(ReplicatedStorage.Shared.Rules.Vault)
local DataService = require(script.Parent.DataService)

type Ledger = Types.Ledger
type Vault = Types.Vault

local BUCKET_CAPACITY = 10
local BUCKET_REFILL_PER_SECOND = 5
local SLOW_DOWN_INTERVAL = 1

local LedgerService = {}

local ledgerSync: RemoteEvent
local ledgerAction: RemoteEvent
local ledgerRequest: RemoteEvent
local notifyRemote: RemoteEvent

local buckets: { [Player]: RateLimiter.Bucket } = {}
local lastSlowDown: { [Player]: number } = {}
local locked: { [Player]: boolean } = {}
local changedCallbacks: { (player: Player, ledger: Ledger) -> () } = {}
local remotesFolder: Folder?

-- The player's Ledger, or nil until their data has loaded and after they left.
function LedgerService.get(player: Player): Ledger?
	local data = DataService.get(player)
	if data == nil then
		return nil
	end
	return data.ledger
end

-- The player's Vault, or nil until their data has loaded and after they left.
function LedgerService.getVault(player: Player): Vault?
	local data = DataService.get(player)
	if data == nil then
		return nil
	end
	return data.vault
end

-- Ledgers of every player whose data is loaded (including held players who have left).
function LedgerService.all(): { Ledger }
	local result: { Ledger } = {}
	for _, data in DataService.all() do
		table.insert(result, data.ledger)
	end
	return result
end

-- A locked player's Ledger and Vault may not be changed by that player.
function LedgerService.lock(player: Player)
	locked[player] = true
end

function LedgerService.unlock(player: Player)
	locked[player] = nil
end

function LedgerService.isLocked(player: Player): boolean
	return locked[player] == true
end

function LedgerService.onChanged(callback: (player: Player, ledger: Ledger) -> ())
	table.insert(changedCallbacks, callback)
end

-- Creates a RemoteEvent in the Remotes folder. Works for services started after LedgerService.start().
function LedgerService.makeRemote(name: string): RemoteEvent
	local folder = remotesFolder
	assert(folder ~= nil, "LedgerService.start must run before makeRemote")
	local remote = Instance.new("RemoteEvent")
	remote.Name = name
	remote.Parent = folder
	return remote
end

-- Writes the Ledger to saved data, prunes the Vault to match, and tells that player's client.
-- Returns false, changing nothing, if no data is loaded.
function LedgerService.set(player: Player, ledger: Ledger): boolean
	local data = DataService.get(player)
	if data == nil then
		return false
	end
	data.ledger = ledger
	data.vault = Vault.prune(data.vault, ledger)
	if player.Parent == Players then
		ledgerSync:FireClient(player, ledger, data.vault)
	end
	for _, callback in changedCallbacks do
		task.spawn(callback, player, ledger)
	end
	return true
end

-- Writes the Vault to saved data and tells that player's client.
-- Returns false, changing nothing, if no data is loaded.
function LedgerService.setVault(player: Player, vault: Vault): boolean
	local data = DataService.get(player)
	if data == nil then
		return false
	end
	data.vault = vault
	if player.Parent == Players then
		ledgerSync:FireClient(player, data.ledger, vault)
	end
	return true
end

function LedgerService.notify(player: Player, code: string, args: { [string]: string }?)
	notifyRemote:FireClient(player, code, args)
end

function LedgerService.notifyAll(code: string, args: { [string]: string }?)
	notifyRemote:FireAllClients(code, args)
end

-- True if the player has a token left in their rate-limit bucket (takes one).
local function allowed(player: Player): boolean
	local now = os.clock()
	local bucket = buckets[player]
	if bucket == nil then
		bucket = RateLimiter.new(BUCKET_CAPACITY, now)
		buckets[player] = bucket
	end
	return RateLimiter.allow(bucket, now, BUCKET_CAPACITY, BUCKET_REFILL_PER_SECOND)
end

local function handleRequest(player: Player)
	if player.Parent ~= Players then
		return
	end
	if not allowed(player) then
		return
	end
	local ledger = LedgerService.get(player)
	if ledger ~= nil then
		ledgerSync:FireClient(player, ledger, LedgerService.getVault(player) or {})
	end
end

local function handleAction(player: Player, request: any)
	if player.Parent ~= Players then
		return
	end
	if not allowed(player) then
		local now = os.clock()
		local last = lastSlowDown[player]
		if last == nil or now - last >= SLOW_DOWN_INTERVAL then
			lastSlowDown[player] = now
			LedgerService.notify(player, "SLOW_DOWN")
		end
		return
	end

	if LedgerService.isLocked(player) then
		LedgerService.notify(player, "LEDGER_LOCKED")
		return
	end

	-- No yielding call from here to set(): the Ledger read cannot go stale.
	local newLedger, code, cardId = LedgerActions.apply(LedgerService.get(player), request)
	if newLedger == nil then
		LedgerService.notify(player, code)
		return
	end
	if not LedgerService.set(player, newLedger) then
		LedgerService.notify(player, "DATA_NOT_LOADED")
		return
	end
	LedgerService.notify(player, code, { name = Cards.name(cardId) })
end

function LedgerService.start()
	local folder = Instance.new("Folder")
	folder.Name = Net.FOLDER
	folder.Parent = ReplicatedStorage

	remotesFolder = folder
	ledgerSync = LedgerService.makeRemote(Net.LedgerSync)
	ledgerAction = LedgerService.makeRemote(Net.LedgerAction)
	ledgerRequest = LedgerService.makeRemote(Net.LedgerRequest)
	notifyRemote = LedgerService.makeRemote(Net.Notify)

	ledgerAction.OnServerEvent:Connect(handleAction)
	ledgerRequest.OnServerEvent:Connect(handleRequest)
	Players.PlayerRemoving:Connect(function(player)
		buckets[player] = nil
		lastSlowDown[player] = nil
		-- A held player's profile is still open; whoever holds it unlocks them.
		-- Deferred so the holds taken by other PlayerRemoving handlers exist by now.
		task.defer(function()
			if DataService.get(player) == nil then
				locked[player] = nil
			end
		end)
	end)

	DataService.onLoaded(function(player, data)
		-- A player may have left before this callback ran.
		if player.Parent == Players then
			ledgerSync:FireClient(player, data.ledger, data.vault)
		end
	end)
end

return LedgerService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="81">
        <Properties>
          <string name="Name">LookPainter</string>
          <string name="Source"><![CDATA[--!strict
-- Paints a part from a named look in the Looks catalog.
--   LookPainter.paint(part, look)
--       Sets the part's colour, material and transparency. A look the catalog does not have,
--       or one whose material is not an Enum.Material item, paints opaque grey SmoothPlastic
--       instead, so a typo shows on the island rather than breaking the build.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Looks = require(ReplicatedStorage.Shared.Catalog.Looks)

local FALLBACK_COLOR = Color3.fromRGB(128, 128, 128)

local LookPainter = {}

-- The Enum.Material item with this name, or nil. Indexing an Enum with a name it does not
-- have raises, and a name such as "GetEnumItems" finds a method, so both are screened out.
local function materialNamed(name: string): Enum.Material?
	local ok, item = pcall(function(): any
		return (Enum.Material :: any)[name]
	end)
	if ok and typeof(item) == "EnumItem" and item.EnumType == Enum.Material then
		return item
	end
	return nil
end

function LookPainter.paint(part: BasePart, look: string)
	local spec = Looks.byName[look]
	if spec ~= nil then
		local material = materialNamed(spec.material)
		if material ~= nil then
			part.Color = Color3.fromRGB(spec.r, spec.g, spec.b)
			part.Material = material
			part.Transparency = spec.transparency
			return
		end
	end
	part.Color = FALLBACK_COLOR
	part.Material = Enum.Material.SmoothPlastic
	part.Transparency = 0
end

return LookPainter
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="82">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
local AbilityService = require(script.Parent.AbilityService)
local ClaimService = require(script.Parent.ClaimService)
local CombatService = require(script.Parent.CombatService)
local CreatureService = require(script.Parent.CreatureService)
local CrownService = require(script.Parent.CrownService)
local DataService = require(script.Parent.DataService)
local EdictService = require(script.Parent.EdictService)
local Fighters = require(script.Parent.Fighters)
local HazardService = require(script.Parent.HazardService)
local LeaderboardService = require(script.Parent.LeaderboardService)
local LedgerService = require(script.Parent.LedgerService)
local PartyService = require(script.Parent.PartyService)
local PathService = require(script.Parent.PathService)
local ProtectionService = require(script.Parent.ProtectionService)
local RegenService = require(script.Parent.RegenService)
local ShopService = require(script.Parent.ShopService)
local SourceService = require(script.Parent.SourceService)
local StatusService = require(script.Parent.StatusService)
local TradeService = require(script.Parent.TradeService)
local TrialService = require(script.Parent.TrialService)
local VaultService = require(script.Parent.VaultService)
local WorldBuilder = require(script.Parent.WorldBuilder)

-- A failing step is reported but does not stop the steps after it.
local function runStep(name: string, step: () -> ())
	local ok, trace = xpcall(step, debug.traceback)
	if not ok then
		warn(`[IsleOfAvarice] {name} failed: {trace}`)
	end
end

runStep("WorldBuilder.build", WorldBuilder.build)
-- The fighter registry first: every service below looks players and posts up by id.
runStep("Fighters.start", Fighters.start)
runStep("LedgerService.start", LedgerService.start)
runStep("SourceService.start", SourceService.start)
runStep("VaultService.start", VaultService.start)
runStep("ProtectionService.start", ProtectionService.start)
-- StatusService never requires CombatService, and CombatService never requires PathService
-- (PathService -> ClaimService -> CombatService): the functions are passed in here instead.
runStep("StatusService.start", function()
	StatusService.start(CombatService.damage)
end)
runStep("CombatService.start", function()
	CombatService.start(PathService.get, PathService.grant)
end)
runStep("AbilityService.start", AbilityService.start)
runStep("HazardService.start", HazardService.start)
runStep("ClaimService.start", ClaimService.start)
runStep("PathService.start", PathService.start)
runStep("CreatureService.start", CreatureService.start)
runStep("TrialService.start", TrialService.start)
runStep("EdictService.start", EdictService.start)
runStep("ShopService.start", ShopService.start)
runStep("TradeService.start", TradeService.start)
-- After CombatService: a leaver's combat-log credit runs before they leave their party.
runStep("PartyService.start", PartyService.start)
runStep("LeaderboardService.start", LeaderboardService.start)
runStep("CrownService.start", CrownService.start)
runStep("RegenService.start", RegenService.start)
-- Data last, so no player loads before the remotes and callbacks exist.
runStep("DataService.start", DataService.start)

print("[IsleOfAvarice] server started")
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="83">
        <Properties>
          <string name="Name">PartyService</string>
          <string name="Source"><![CDATA[--!strict
-- Parties (spec 3.14): asking the nearest player, the invite, joining, leaving, removing a
-- member and handing over the lead. Party holds every rule; this service owns the one live
-- state, tells the players what changed and installs who counts as an ally. Every handler
-- reads the state and stores the new one with no yielding call in between.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Shared.Net)
local Party = require(ReplicatedStorage.Shared.Rules.Party)
local PartyView = require(ReplicatedStorage.Shared.Rules.PartyView)
local RateLimiter = require(ReplicatedStorage.Shared.Rules.RateLimiter)
local Trade = require(ReplicatedStorage.Shared.Rules.Trade)
local Types = require(ReplicatedStorage.Shared.Types)
local DataService = require(script.Parent.DataService)
local Fighters = require(script.Parent.Fighters)
local LedgerService = require(script.Parent.LedgerService)

type Invite = { from: Player, expiresAt: number }

local BUCKET_CAPACITY = 10
local BUCKET_REFILL_PER_SECOND = 5

local PartyService = {}

local state: Party.State = Party.new()
-- Every present player by UserId, so a member id can be turned back into a Player.
local players: { [number]: Player } = {}
-- Pending invites, keyed by the invited player.
local invites: { [Player]: Invite } = {}
-- Who each asker has asked.
local asked: { [Player]: Player } = {}
local buckets: { [Player]: RateLimiter.Bucket } = {}
local inviteRemote: RemoteEvent
local syncRemote: RemoteEvent

local function allowed(player: Player): boolean
	local now = os.clock()
	local bucket = buckets[player]
	if bucket == nil then
		bucket = RateLimiter.new(BUCKET_CAPACITY, now)
		buckets[player] = bucket
	end
	return RateLimiter.allow(bucket, now, BUCKET_CAPACITY, BUCKET_REFILL_PER_SECOND)
end

-- A message to someone who may already have left.
local function tell(player: Player, code: string, args: { [string]: string }?)
	if player.Parent == Players then
		LedgerService.notify(player, code, args)
	end
end

-- A message to a member by id, when they are still here.
local function tellId(userId: number, code: string, args: { [string]: string }?)
	local player = players[userId]
	if player ~= nil then
		tell(player, code, args)
	end
end

local function nameOf(userId: number): string
	local player = players[userId]
	return if player ~= nil then player.DisplayName else "A player"
end

local function vec(position: Vector3): Types.Vec3
	return { x = position.X, y = position.Y, z = position.Z }
end

-- Each present member gets the whole party, in join order.
local function sync(party: Party.Party)
	local members: { PartyView.Member } = {}
	for _, userId in party.members do
		table.insert(members, { userId = userId, name = nameOf(userId) })
	end
	local view: PartyView.Sync = { leader = party.leader, members = members }
	for _, userId in party.members do
		local player = players[userId]
		if player ~= nil and player.Parent == Players then
			syncRemote:FireClient(player, view)
		end
	end
end

local function unsync(player: Player)
	if player.Parent == Players then
		syncRemote:FireClient(player, nil)
	end
end

-- Removes an invite to `target`, from either table.
local function clearInvite(target: Player)
	local invite = invites[target]
	if invite == nil then
		return
	end
	invites[target] = nil
	if asked[invite.from] == target then
		asked[invite.from] = nil
	end
end

-- Tells whoever is left what happened when `removedId` went out of `before` (by their own
-- leave, an exit or a kick): the party broke up, or the rest hear `code` and any new leader.
local function announceRemoval(before: Party.Party, removedId: number, code: string)
	local remaining: { number } = {}
	for _, userId in before.members do
		if userId ~= removedId then
			table.insert(remaining, userId)
		end
	end
	local after = Party.find(state, remaining[1])
	if after == nil then
		for _, userId in remaining do
			tellId(userId, "PARTY_DISBANDED")
			local player = players[userId]
			if player ~= nil then
				unsync(player)
			end
		end
		return
	end
	local removedName = nameOf(removedId)
	for _, userId in remaining do
		tellId(userId, code, { player = removedName })
		if after.leader ~= before.leader then
			tellId(userId, "PARTY_NEW_LEADER", { player = nameOf(after.leader) })
		end
	end
	sync(after)
end

-- Takes a player out of their party. Returns the refusal code, or nil when it worked.
local function removeMember(userId: number, why: string): string?
	local before = Party.find(state, userId)
	local after, code = Party.leave(state, userId)
	if before == nil or after == nil then
		return code
	end
	state = after
	local leaver = players[userId]
	if why == "left" and leaver ~= nil then
		tell(leaver, "PARTY_LEFT")
		unsync(leaver)
	end
	announceRemoval(before, userId, "PARTY_MEMBER_LEFT")
	return nil
end

local function handleRequest(player: Player)
	if player.Parent ~= Players or not allowed(player) then
		return
	end
	local _, root = Fighters.body(player.UserId)
	-- A member who cannot invite hears why even when nobody else is in range.
	local own = Party.find(state, player.UserId)
	if own ~= nil and own.leader ~= player.UserId then
		LedgerService.notify(player, "PARTY_NOT_LEADER")
		return
	end
	if own ~= nil and #own.members >= Party.MAX_SIZE then
		LedgerService.notify(player, "PARTY_FULL")
		return
	end
	if
		DataService.get(player) == nil
		or root == nil
		or asked[player] ~= nil
		or invites[player] ~= nil
	then
		LedgerService.notify(player, "EDICT_NOT_NOW")
		return
	end
	-- The asker's own party mates are left out so one standing closest cannot hide a new player.
	local mates = Party.allies(state, player.UserId)
	local others: { Trade.Body } = {}
	for userId, other in players do
		if other ~= player and other.Parent == Players and table.find(mates, userId) == nil then
			local _, otherRoot = Fighters.body(userId)
			if otherRoot ~= nil then
				table.insert(others, { userId = userId, position = vec(otherRoot.Position) })
			end
		end
	end
	local targetId =
		Trade.nearest({ userId = player.UserId, position = vec(root.Position) }, others)
	local target = if targetId ~= nil then players[targetId] else nil
	if target == nil then
		LedgerService.notify(player, "EDICT_NO_TARGET")
		return
	end
	local can, code = Party.canInvite(state, player.UserId, target.UserId)
	if not can then
		LedgerService.notify(player, code, { player = target.DisplayName })
		return
	end
	if DataService.get(target) == nil or invites[target] ~= nil or asked[target] ~= nil then
		LedgerService.notify(player, "PARTY_BUSY", { player = target.DisplayName })
		return
	end

	local invite: Invite = { from = player, expiresAt = os.clock() + Party.INVITE_SECONDS }
	invites[target] = invite
	asked[player] = target
	inviteRemote:FireClient(target, { from = player.DisplayName, seconds = Party.INVITE_SECONDS })
	LedgerService.notify(player, "PARTY_INVITE_SENT", { player = target.DisplayName })
	task.delay(Party.INVITE_SECONDS, function()
		if invites[target] ~= invite then
			return
		end
		clearInvite(target)
		if target.Parent == Players then
			inviteRemote:FireClient(target, nil)
		end
		tell(player, "PARTY_EXPIRED")
	end)
end

local function handleReply(player: Player, accept: any)
	if player.Parent ~= Players or not allowed(player) then
		return
	end
	local invite = invites[player]
	if invite == nil then
		LedgerService.notify(player, "PARTY_NO_INVITE")
		return
	end
	clearInvite(player)
	local asker = invite.from
	if accept ~= true then
		tell(asker, "PARTY_DECLINED", { player = player.DisplayName })
		return
	end
	if asker.Parent ~= Players then
		LedgerService.notify(player, "PARTY_NO_INVITE")
		return
	end
	local joined = Party.join(state, asker.UserId, player.UserId)
	if joined == nil then
		-- The invitee hears it in their own words, naming the asker.
		LedgerService.notify(player, "PARTY_JOIN_FAILED", { player = asker.DisplayName })
		return
	end
	state = joined
	local party = Party.find(state, player.UserId)
	if party == nil then
		return
	end
	tell(player, "PARTY_JOINED", { player = nameOf(party.leader) })
	for _, userId in party.members do
		if userId ~= player.UserId then
			tellId(userId, "PARTY_MEMBER_JOINED", { player = player.DisplayName })
		end
	end
	sync(party)
end

local function handleAction(player: Player, raw: any)
	if player.Parent ~= Players or not allowed(player) then
		return
	end
	if type(raw) ~= "table" or type(raw.kind) ~= "string" then
		LedgerService.notify(player, "BAD_REQUEST")
		return
	end
	local kind = raw.kind
	if kind == "leave" then
		local code = removeMember(player.UserId, "left")
		if code ~= nil then
			LedgerService.notify(player, code)
		end
	elseif kind == "kick" then
		local before = Party.find(state, player.UserId)
		local after, code = Party.kick(state, player.UserId, raw.userId)
		if after == nil or before == nil then
			LedgerService.notify(player, code)
			return
		end
		state = after
		local removed = players[raw.userId]
		if removed ~= nil then
			tell(removed, "PARTY_KICKED", { player = player.DisplayName })
			unsync(removed)
		end
		announceRemoval(before, raw.userId, "PARTY_MEMBER_KICKED")
	elseif kind == "promote" then
		local after, code = Party.promote(state, player.UserId, raw.userId)
		if after == nil then
			LedgerService.notify(player, code)
			return
		end
		state = after
		local party = Party.find(state, player.UserId)
		if party == nil then
			return
		end
		for _, userId in party.members do
			tellId(userId, "PARTY_NEW_LEADER", { player = nameOf(party.leader) })
		end
		sync(party)
	else
		LedgerService.notify(player, "BAD_REQUEST")
	end
end

-- Runs through DataService.beforeRelease, after CombatService's combat-log credit.
local function onExit(player: Player)
	removeMember(player.UserId, "exit")
	-- An invite to them is dropped; an invite from them is withdrawn from whoever was shown it.
	clearInvite(player)
	local target = asked[player]
	if target ~= nil then
		asked[player] = nil
		local sent = invites[target]
		if sent ~= nil and sent.from == player then
			invites[target] = nil
			if target.Parent == Players then
				inviteRemote:FireClient(target, nil)
			end
		end
	end
	buckets[player] = nil
	-- Leave a rejoin under the same UserId alone.
	if players[player.UserId] == player then
		players[player.UserId] = nil
	end
end

-- Play-test seam: a copy of the player's party (user ids), if any.
function PartyService.party(player: Player): Party.Party?
	return Party.find(state, player.UserId)
end

function PartyService.start()
	inviteRemote = LedgerService.makeRemote(Net.PartyInvite)
	syncRemote = LedgerService.makeRemote(Net.PartySync)
	LedgerService.makeRemote(Net.PartyRequest).OnServerEvent:Connect(handleRequest)
	LedgerService.makeRemote(Net.PartyReply).OnServerEvent:Connect(handleReply)
	LedgerService.makeRemote(Net.PartyAction).OnServerEvent:Connect(handleAction)

	-- Reads the live `state`, so every replacement is seen.
	Fighters.setAllies(function(id: number): { number }
		return Party.allies(state, id)
	end)

	for _, player in Players:GetPlayers() do
		players[player.UserId] = player
	end
	Players.PlayerAdded:Connect(function(player: Player)
		players[player.UserId] = player
	end)
	DataService.beforeRelease(onExit)
end

return PartyService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="84">
        <Properties>
          <string name="Name">PathService</string>
          <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Abilities = require(ReplicatedStorage.Shared.Catalog.Abilities)
local Loadout = require(ReplicatedStorage.Shared.Rules.Loadout)
local Net = require(ReplicatedStorage.Shared.Net)
local PathProgress = require(ReplicatedStorage.Shared.Rules.PathProgress)
local Protection = require(ReplicatedStorage.Shared.Rules.Protection)
local RateLimiter = require(ReplicatedStorage.Shared.Rules.RateLimiter)
local Types = require(ReplicatedStorage.Shared.Types)
local ClaimService = require(script.Parent.ClaimService)
local DataService = require(script.Parent.DataService)
local LedgerService = require(script.Parent.LedgerService)
local SourceService = require(script.Parent.SourceService)

type PathProgress = Types.PathProgress

local BUCKET_CAPACITY = 10
local BUCKET_REFILL_PER_SECOND = 5
local DEFEAT_XP = 150
local SECONDS_PER_DAY = 86400

local PathService = {}

local buckets: { [Player]: RateLimiter.Bucket } = {}
local changedCallbacks: { (player: Player, progress: PathProgress) -> () } = {}
local pathSync: RemoteEvent

-- True if the player has a token left in their rate-limit bucket (takes one).
local function allowed(player: Player): boolean
	local now = os.clock()
	local bucket = buckets[player]
	if bucket == nil then
		bucket = RateLimiter.new(BUCKET_CAPACITY, now)
		buckets[player] = bucket
	end
	return RateLimiter.allow(bucket, now, BUCKET_CAPACITY, BUCKET_REFILL_PER_SECOND)
end

-- The server reads the position itself. No character counts as outside the safe zone.
local function playerInSafeZone(player: Player): boolean
	local character = player.Character
	local root = if character ~= nil then character:FindFirstChild("HumanoidRootPart") else nil
	if root == nil or not root:IsA("BasePart") then
		return false
	end
	local p = root.Position
	return Protection.inSafeZone({ x = p.X, y = p.Y, z = p.Z })
end

local function sync(player: Player, data: Types.PlayerData)
	if player.Parent ~= Players then
		return
	end
	pathSync:FireClient(player, data.paths, data.coin, os.time())
end

-- The player's saved Path progress, or nil until loaded and after they left.
function PathService.get(player: Player): PathProgress?
	local data = DataService.get(player)
	if data == nil then
		return nil
	end
	return data.paths
end

function PathService.onChanged(callback: (player: Player, progress: PathProgress) -> ())
	table.insert(changedCallbacks, callback)
end

local function fireChanged(player: Player, progress: PathProgress)
	for _, callback in changedCallbacks do
		local ok, err = pcall(callback, player, progress)
		if not ok then
			warn(`[IsleOfAvarice] onChanged callback failed: {err}`)
		end
	end
end

local function abilityName(id: string): string
	local ability = Abilities.byId[id]
	return if ability ~= nil then ability.name else id
end

-- Adds Path XP at the learning rate for the player's Calling. Does nothing for a player whose
-- data is not loaded or who has left. No yielding call between the read and the write.
function PathService.grant(player: Player, path: string, base: number)
	if player.Parent ~= Players then
		return
	end
	local data = DataService.get(player)
	if data == nil then
		return
	end
	local newProgress, gained, levelsGained, unlocked = PathProgress.addXp(data.paths, path, base)
	if not (gained > 0) then
		return
	end
	newProgress = Loadout.autoFill(newProgress, unlocked)
	data.paths = newProgress

	if levelsGained > 0 then
		LedgerService.notify(player, "LEVEL_UP", {
			path = path,
			level = tostring(PathProgress.level(newProgress, path)),
		})
	end
	for _, id in unlocked do
		LedgerService.notify(player, "ABILITY_UNLOCKED", { name = abilityName(id) })
	end
	sync(player, data)
	fireChanged(player, newProgress)
end

local function handlePick(player: Player, pathId: any)
	if player.Parent ~= Players or not allowed(player) then
		return
	end
	local data = DataService.get(player)
	if data == nil then
		LedgerService.notify(player, "DATA_NOT_LOADED")
		return
	end
	local newProgress, code, unlocked = PathProgress.chooseCalling(data.paths, pathId)
	if newProgress == nil then
		LedgerService.notify(player, code)
		return
	end
	data.paths = Loadout.autoFill(newProgress, unlocked)
	LedgerService.notify(player, "CALLING_CHOSEN", { path = newProgress.calling })
	sync(player, data)
	fireChanged(player, data.paths)
end

local function handleChange(player: Player, pathId: any)
	if player.Parent ~= Players or not allowed(player) then
		return
	end
	local data = DataService.get(player)
	if data == nil then
		LedgerService.notify(player, "DATA_NOT_LOADED")
		return
	end
	local now = os.time()
	local newProgress, code, cost = PathProgress.changeCalling(data.paths, pathId, data.coin, now)
	if newProgress == nil then
		if code == "CALLING_COOLDOWN" then
			local left = data.paths.callingChangedAt + PathProgress.CHANGE_COOLDOWN - now
			LedgerService.notify(
				player,
				code,
				{ days = tostring(math.max(1, math.ceil(left / SECONDS_PER_DAY))) }
			)
		elseif code == "NOT_ENOUGH_COIN" then
			LedgerService.notify(player, code, { cost = tostring(PathProgress.CHANGE_COST) })
		else
			LedgerService.notify(player, code)
		end
		return
	end
	-- Paid through addCoin, so the client's Coin line stays current. No yield before the write.
	if not SourceService.addCoin(player, -cost) then
		LedgerService.notify(
			player,
			"NOT_ENOUGH_COIN",
			{ cost = tostring(PathProgress.CHANGE_COST) }
		)
		return
	end
	data.paths = newProgress
	LedgerService.notify(player, "CALLING_CHANGED", { path = newProgress.calling })
	sync(player, data)
	fireChanged(player, newProgress)
end

local function handleLoadout(player: Player, request: any)
	if player.Parent ~= Players or not allowed(player) then
		return
	end
	local data = DataService.get(player)
	local newProgress, code =
		Loadout.apply(if data ~= nil then data.paths else nil, request, playerInSafeZone(player))
	if newProgress == nil or data == nil then
		LedgerService.notify(player, code)
		return
	end
	data.paths = newProgress
	LedgerService.notify(player, code)
	sync(player, data)
	fireChanged(player, newProgress)
end

function PathService.start()
	pathSync = LedgerService.makeRemote(Net.PathSync)
	LedgerService.makeRemote(Net.PickCalling).OnServerEvent:Connect(handlePick)
	LedgerService.makeRemote(Net.ChangeCalling).OnServerEvent:Connect(handleChange)
	LedgerService.makeRemote(Net.LoadoutAction).OnServerEvent:Connect(handleLoadout)

	DataService.onLoaded(function(player, data)
		sync(player, data)
	end)

	ClaimService.onClaimStarted(function(killer)
		local progress = PathService.get(killer)
		if progress ~= nil and progress.calling ~= "" then
			PathService.grant(killer, progress.calling, DEFEAT_XP)
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		buckets[player] = nil
	end)
end

return PathService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="85">
        <Properties>
          <string name="Name">Payout</string>
          <string name="Source"><![CDATA[--!strict
-- Pays one player a reward: Coin, then Path XP, then Relics. Creature defeats, passed trials
-- and the quest all pay through here, so they cannot drift apart. SourceService.award tells
-- the player what became of each Relic (gained, sealed, lost).
local PathService = require(script.Parent.PathService)
local SourceService = require(script.Parent.SourceService)

export type Reward = {
	coin: number,
	xp: number,
	-- The Path the XP goes to; "" or nil pays no XP.
	path: string?,
	relics: { string }?,
}

local Payout = {}

function Payout.give(player: Player, reward: Reward)
	if reward.coin > 0 then
		SourceService.addCoin(player, reward.coin)
	end
	local path = reward.path
	if reward.xp > 0 and path ~= nil and path ~= "" then
		PathService.grant(player, path, reward.xp)
	end
	local relics = reward.relics
	if relics ~= nil then
		for _, relicId in relics do
			SourceService.award(player, relicId)
		end
	end
end

-- The player's Calling, or "" before they have one or before their data has loaded.
function Payout.calling(player: Player): string
	local progress = PathService.get(player)
	return if progress ~= nil then progress.calling else ""
end

return Payout
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="86">
        <Properties>
          <string name="Name">ProtectionService</string>
          <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Shared.Net)
local Protection = require(ReplicatedStorage.Shared.Rules.Protection)
local Types = require(ReplicatedStorage.Shared.Types)
local DataService = require(script.Parent.DataService)
local LedgerService = require(script.Parent.LedgerService)

type Ledger = Types.Ledger
type Status = Protection.Status

local SHIELD_NAME = "Shield"
local MARKED_TAG_NAME = "MarkedTag"
local MARKED_COLOR = Color3.fromRGB(230, 40, 40)

local ProtectionService = {}

-- Per-player timers, on the os.clock() clock. The new-player shield lives in saved data.
type Timers = { respawnShieldUntil: number, markedUntil: number }
local timers: { [Player]: Timers } = {}

local statusSync: RemoteEvent

-- Read-only defaults for a player with no entry. Never written to.
local NO_TIMERS: Timers = { respawnShieldUntil = 0, markedUntil = 0 }

-- The player's timers, created on first use. Only for players still in the game.
local function timersFor(player: Player): Timers
	local t = timers[player]
	if t == nil then
		t = { respawnShieldUntil = 0, markedUntil = 0 }
		timers[player] = t
	end
	return t
end

-- Reads the player's timers without creating an entry (safe for players who left).
local function peekTimers(player: Player): Timers
	return timers[player] or NO_TIMERS
end

-- True while the player's data is loaded and the new-player shield has not ended.
local function hasNewShield(player: Player): boolean
	local data = DataService.get(player)
	return data ~= nil and not data.shieldEnded
end

-- The HumanoidRootPart of a living character, or nil.
local function livingRoot(player: Player): BasePart?
	local character = player.Character
	if character == nil then
		return nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid == nil or humanoid.Health <= 0 then
		return nil
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	if root == nil or not root:IsA("BasePart") then
		return nil
	end
	return root
end

local function sendStatus(player: Player)
	if player.Parent ~= Players then
		return
	end
	local now = os.clock()
	local t = peekTimers(player)
	statusSync:FireClient(player, {
		newShield = hasNewShield(player),
		respawnShieldSeconds = math.max(0, t.respawnShieldUntil - now),
		markedSeconds = math.max(0, t.markedUntil - now),
	})
end

-- Adds or removes the visible Shield force field so it matches the player's shields.
local function updateForceField(player: Player)
	local character = player.Character
	if character == nil then
		return
	end
	local shielded = hasNewShield(player) or os.clock() < peekTimers(player).respawnShieldUntil
	local existing = character:FindFirstChild(SHIELD_NAME)
	if shielded and existing == nil then
		local field = Instance.new("ForceField")
		field.Name = SHIELD_NAME
		field.Visible = true
		field.Parent = character
	elseif not shielded and existing ~= nil then
		existing:Destroy()
	end
end

local function removeMarkedTag(character: Model)
	for _, child in character:GetDescendants() do
		if child.Name == MARKED_TAG_NAME and child:IsA("BillboardGui") then
			child:Destroy()
		end
	end
end

local function addMarkedTag(character: Model)
	removeMarkedTag(character)
	local anchor = character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")
	if anchor == nil or not anchor:IsA("BasePart") then
		return
	end
	local tag = Instance.new("BillboardGui")
	tag.Name = MARKED_TAG_NAME
	tag.Adornee = anchor
	tag.AlwaysOnTop = true
	tag.MaxDistance = 200
	tag.Size = UDim2.fromOffset(120, 30)
	tag.StudsOffset = Vector3.new(0, 2.5, 0)

	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Text = "MARKED"
	label.TextColor3 = MARKED_COLOR
	label.TextStrokeTransparency = 0.3
	label.TextScaled = true
	label.Font = Enum.Font.GothamBold
	label.Parent = tag

	tag.Parent = anchor
end

-- Removes the Marked tag once the Marked time has run out (a later mark extends it).
local function scheduleUnmark(player: Player, after: number)
	task.delay(after, function()
		local t = timers[player]
		if t == nil or os.clock() < t.markedUntil then
			return
		end
		local character = player.Character
		if character ~= nil then
			removeMarkedTag(character)
		end
		sendStatus(player)
	end)
end

-- Ends the new-player shield for good.
local function endNewShield(player: Player)
	local data = DataService.get(player)
	if data == nil or data.shieldEnded then
		return
	end
	data.shieldEnded = true
	if player.Parent == Players then
		LedgerService.notify(player, "SHIELD_ENDED")
	end
	updateForceField(player)
	sendStatus(player)
end

local function checkShieldEnd(player: Player, ledger: Ledger)
	if Protection.shouldEndShield(ledger) then
		endNewShield(player)
	end
end

local function onCharacterAdded(player: Player, character: Model)
	local now = os.clock()
	local t = timersFor(player)
	t.respawnShieldUntil = now + Protection.RESPAWN_SHIELD_SECONDS
	updateForceField(player)
	if now < t.markedUntil then
		addMarkedTag(character)
	end
	sendStatus(player)

	task.delay(Protection.RESPAWN_SHIELD_SECONDS, function()
		if player.Character == character then
			updateForceField(player)
			sendStatus(player)
		end
	end)
end

local function watchPlayer(player: Player)
	player.CharacterAdded:Connect(function(character)
		onCharacterAdded(player, character)
	end)
	local character = player.Character
	if character ~= nil then
		task.spawn(onCharacterAdded, player, character)
	end
end

-- The player's protection status, or nil without loaded data or a living character.
function ProtectionService.status(player: Player, _now: number): Status?
	if DataService.get(player) == nil then
		return nil
	end
	local root = livingRoot(player)
	if root == nil then
		return nil
	end
	local t = peekTimers(player)
	local p = root.Position
	return {
		inSafeZone = Protection.inSafeZone({ x = p.X, y = p.Y, z = p.Z }),
		newShield = hasNewShield(player),
		respawnShieldUntil = t.respawnShieldUntil,
		markedUntil = t.markedUntil,
	}
end

-- Marks the player for MARKED_SECONDS from now. A player already Marked has the time extended.
function ProtectionService.mark(player: Player, now: number)
	if player.Parent ~= Players then
		return
	end
	local t = timersFor(player)
	local wasMarked = now < t.markedUntil
	t.markedUntil = now + Protection.MARKED_SECONDS
	if not wasMarked then
		LedgerService.notify(player, "MARKED")
		local character = player.Character
		if character ~= nil then
			addMarkedTag(character)
		end
	end
	sendStatus(player)
	scheduleUnmark(player, Protection.MARKED_SECONDS)
end

-- Ends the respawn shield early (the player attacked someone).
function ProtectionService.endRespawnShield(player: Player)
	local t = timers[player]
	if t == nil or t.respawnShieldUntil == 0 then
		return
	end
	t.respawnShieldUntil = 0
	updateForceField(player)
	sendStatus(player)
end

-- Play-test seam: ends the player's Mark now. A scheduled unmark that fires later finds
-- nothing left to do (or a newer Mark, which it leaves alone).
function ProtectionService.endMark(player: Player)
	local t = timers[player]
	if t == nil or t.markedUntil == 0 then
		return
	end
	t.markedUntil = 0
	local character = player.Character
	if character ~= nil then
		removeMarkedTag(character)
	end
	sendStatus(player)
end

function ProtectionService.start()
	statusSync = LedgerService.makeRemote(Net.StatusSync)
	local shieldDrop = LedgerService.makeRemote(Net.ShieldDrop)

	shieldDrop.OnServerEvent:Connect(function(player)
		if player.Parent ~= Players then
			return
		end
		endNewShield(player)
	end)

	LedgerService.onChanged(checkShieldEnd)
	DataService.onLoaded(function(player, data)
		checkShieldEnd(player, data.ledger)
		updateForceField(player)
		sendStatus(player)
	end)

	Players.PlayerAdded:Connect(watchPlayer)
	for _, player in Players:GetPlayers() do
		watchPlayer(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		timers[player] = nil
	end)
end

return ProtectionService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="87">
        <Properties>
          <string name="Name">RegenService</string>
          <string name="Source"><![CDATA[--!strict
-- Slow health regeneration for every player's character, once they have been left alone.
-- Roblox's own regeneration is switched off by the empty Health script in StarterCharacterScripts;
-- Regen holds the rule, this service only watches damage and writes the result.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Regen = require(ReplicatedStorage.Shared.Rules.Regen)

local TICK_SECONDS = 0.5

local RegenService = {}

local lastHurtAt: { [Player]: number } = {}
local healthWatch: { [Player]: RBXScriptConnection } = {}
local accumulated = 0

local function watch(player: Player, character: Model)
	local previous = healthWatch[player]
	if previous ~= nil then
		previous:Disconnect()
		healthWatch[player] = nil
	end
	-- A new character starts unhurt.
	lastHurtAt[player] = nil
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid == nil then
		return
	end
	local last = humanoid.Health
	healthWatch[player] = humanoid.HealthChanged:Connect(function(health: number)
		if health < last then
			lastHurtAt[player] = os.clock()
		end
		last = health
	end)
end

local function onHeartbeat(deltaTime: number)
	accumulated += deltaTime
	if accumulated < TICK_SECONDS then
		return
	end
	local elapsed = accumulated
	accumulated = 0
	local now = os.clock()
	for _, player in Players:GetPlayers() do
		local character = player.Character
		local humanoid = if character ~= nil
			then character:FindFirstChildOfClass("Humanoid")
			else nil
		if humanoid ~= nil and humanoid.Health > 0 then
			local new = Regen.step(
				humanoid.Health,
				humanoid.MaxHealth,
				lastHurtAt[player] or -math.huge,
				now,
				elapsed
			)
			if new ~= humanoid.Health then
				humanoid.Health = new
			end
		end
	end
end

function RegenService.start()
	local function track(player: Player)
		player.CharacterAdded:Connect(function(character)
			watch(player, character)
		end)
		if player.Character ~= nil then
			watch(player, player.Character)
		end
	end
	for _, player in Players:GetPlayers() do
		track(player)
	end
	Players.PlayerAdded:Connect(track)
	Players.PlayerRemoving:Connect(function(player)
		local connection = healthWatch[player]
		if connection ~= nil then
			connection:Disconnect()
		end
		healthWatch[player] = nil
		lastHurtAt[player] = nil
	end)
	RunService.Heartbeat:Connect(onHeartbeat)
end

return RegenService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="88">
        <Properties>
          <string name="Name">ShopService</string>
          <string name="Source"><![CDATA[--!strict
-- The Edict Hall clerk: packs, Copper Relics and selling spare cards. Shop holds every rule;
-- this service checks who is asking and how close they stand, then writes the Ledger and
-- Coin in one step. A sale or a purchase fully happens or does not happen at all.
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local EdictRules = require(ReplicatedStorage.Shared.Rules.EdictRules)
local Net = require(ReplicatedStorage.Shared.Net)
local Protection = require(ReplicatedStorage.Shared.Rules.Protection)
local RateLimiter = require(ReplicatedStorage.Shared.Rules.RateLimiter)
local Shop = require(ReplicatedStorage.Shared.Rules.Shop)
local ShopCatalog = require(ReplicatedStorage.Shared.Catalog.Shop)
local World = require(ReplicatedStorage.Shared.Catalog.World)
local CombatService = require(script.Parent.CombatService)
local DataService = require(script.Parent.DataService)
local Fighters = require(script.Parent.Fighters)
local LedgerService = require(script.Parent.LedgerService)
local ProtectionService = require(script.Parent.ProtectionService)
local SourceService = require(script.Parent.SourceService)

local BUCKET_CAPACITY = 10
local BUCKET_REFILL_PER_SECOND = 5
local CLERK_TAG = "ShopClerk"
local ROOT_LIFT = 3 -- a standing character's root above the ground

local ShopService = {}

local buckets: { [Player]: RateLimiter.Bucket } = {}
local openRemote: RemoteEvent
local rng: () -> number = math.random

local function allowed(player: Player): boolean
	local now = os.clock()
	local bucket = buckets[player]
	if bucket == nil then
		bucket = RateLimiter.new(BUCKET_CAPACITY, now)
		buckets[player] = bucket
	end
	return RateLimiter.allow(bucket, now, BUCKET_CAPACITY, BUCKET_REFILL_PER_SECOND)
end

-- Play-test seam: the pack rolls (default math.random).
function ShopService.setRng(roll: () -> number)
	rng = roll
end

local function showShop(player: Player)
	local data = DataService.get(player)
	if data == nil then
		LedgerService.notify(player, "DATA_NOT_LOADED")
		return
	end
	openRemote:FireClient(player, Shop.view(data.ledger, data.coin))
end

-- The client sends a purchase or a sale; everything else is checked here, in order: present
-- and not too fast, data loaded, Ledger not locked, standing at the clerk, then the rules.
local function handleAction(player: Player, raw: any)
	if player.Parent ~= Players or not allowed(player) then
		return
	end
	local data = DataService.get(player)
	if data == nil then
		LedgerService.notify(player, "DATA_NOT_LOADED")
		return
	end
	if LedgerService.isLocked(player) then
		LedgerService.notify(player, "LEDGER_LOCKED")
		return
	end
	local _, root = Fighters.body(player.UserId)
	local clerk = World.clerk
	if root == nil then
		LedgerService.notify(player, "TOO_FAR")
		return
	end
	local distance = (root.Position - Vector3.new(clerk.x, clerk.y + ROOT_LIFT, clerk.z)).Magnitude
	-- Written positively so a NaN distance is refused.
	if not (distance <= ShopCatalog.REACH) then
		LedgerService.notify(player, "TOO_FAR")
		return
	end

	-- Selling is dealing: refused while Marked or just out of a fight, so cards cannot leave
	-- reach of a blind claim. Buying stays open. A non-table request falls through to Shop.apply.
	if type(raw) == "table" and raw.kind == "sell" then
		local now = os.clock()
		local status = ProtectionService.status(player, now)
		if status == nil then
			LedgerService.notify(player, "EDICT_NOT_NOW")
			return
		end
		local canDeal, dealCode = EdictRules.canDeal({
			marked = Protection.isMarked(status, now),
			lastFightAt = CombatService.lastFightAt(player),
		}, now)
		if not canDeal then
			LedgerService.notify(player, dealCode or "EDICT_NOT_NOW")
			return
		end
	end

	-- No yielding call from here to the writes: the Ledger and Coin read cannot go stale.
	local coinBefore = data.coin
	local newLedger, newCoin, code, args = Shop.apply(data.ledger, coinBefore, raw, rng)
	if newLedger == nil then
		LedgerService.notify(player, code, args)
		return
	end
	if not LedgerService.set(player, newLedger) then
		LedgerService.notify(player, "DATA_NOT_LOADED")
		return
	end
	SourceService.addCoin(player, newCoin - coinBefore)
	LedgerService.notify(player, code, args)
	showShop(player)
end

local function connectClerk(instance: Instance)
	local prompt = instance:FindFirstChildOfClass("ProximityPrompt")
	if prompt == nil then
		return
	end
	prompt.Triggered:Connect(function(player: Player)
		showShop(player)
	end)
end

function ShopService.start()
	openRemote = LedgerService.makeRemote(Net.ShopOpen)
	LedgerService.makeRemote(Net.ShopAction).OnServerEvent:Connect(handleAction)

	for _, instance in CollectionService:GetTagged(CLERK_TAG) do
		connectClerk(instance)
	end
	CollectionService:GetInstanceAddedSignal(CLERK_TAG):Connect(connectClerk)
	Players.PlayerRemoving:Connect(function(player)
		buckets[player] = nil
	end)
end

return ShopService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="89">
        <Properties>
          <string name="Name">Sight</string>
          <string name="Source"><![CDATA[--!strict
-- Server-side world rays shared by AbilityService and CombatService.
--   Sight.rayParams(): RaycastParams
--       Rays pass through every player's character, workspace.Effects, workspace.Creatures
--       and anything a character could walk through (non-colliding parts, water).
--   Sight.obstruction(from, to, target?): Vector3?
--       Where the straight line from `from` to `to` is first blocked, or nil when clear.
--       Pass the target's model (Fighters.model): a first hit on it or one of its
--       descendants is not a block. A NaN or infinite line counts as blocked.
--   Sight.inSight(from, to, target?): boolean
--       True when nothing solid stands between the two points.
--   Sight.move(humanoid, root, target): number
--       Moves a character or creature towards a point (dash, pull, knockback, lunge),
--       stopping short of walls. Returns the level distance travelled.
--   Sight.filter(from, fighters): { Fighter }
--       The fighters the point `from` has a clear line to, in order. Used before choosing
--       a nearest target, so one behind a corner never takes the hit.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Combat = require(ReplicatedStorage.Shared.Rules.Combat)
local Types = require(ReplicatedStorage.Shared.Types)
local Fighters = require(script.Parent.Fighters)

type Fighter = Combat.Fighter

local R6_LEG_HEIGHT = 2

local Sight = {}

Sight.WALL_MARGIN = 2 -- a move stops this many studs short of anything in its way
Sight.GROUND_PROBE = 50 -- how far below a move's end point to look for ground

function Sight.rayParams(): RaycastParams
	local exclude: { Instance } = {}
	for _, name in { "Effects", "Creatures" } do
		local folder = workspace:FindFirstChild(name)
		if folder ~= nil then
			table.insert(exclude, folder)
		end
	end
	for _, other in Players:GetPlayers() do
		local character = other.Character
		if character ~= nil then
			table.insert(exclude, character)
		end
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = exclude
	params.RespectCanCollide = true
	params.IgnoreWater = true
	return params
end

function Sight.obstruction(from: Vector3, to: Vector3, target: Instance?): Vector3?
	local delta = to - from
	-- Written so a NaN or infinite line counts as blocked.
	if not (delta.Magnitude < math.huge) then
		return from
	end
	local result = workspace:Raycast(from, delta, Sight.rayParams())
	if result == nil then
		return nil
	end
	if target ~= nil and (result.Instance == target or result.Instance:IsDescendantOf(target)) then
		return nil
	end
	return result.Position
end

function Sight.inSight(from: Vector3, to: Vector3, target: Instance?): boolean
	return Sight.obstruction(from, to, target) == nil
end

function Sight.filter(from: Vector3, fighters: { Fighter }): { Fighter }
	local kept: { Fighter } = {}
	for _, fighter in fighters do
		local p = fighter.position
		if Sight.inSight(from, Vector3.new(p.x, p.y, p.z), Fighters.model(fighter.id)) then
			table.insert(kept, fighter)
		end
	end
	return kept
end

-- Height of the root's centre above the feet of a standing character.
function Sight.standHeight(humanoid: Humanoid, root: BasePart): number
	if humanoid.RigType == Enum.HumanoidRigType.R15 then
		return humanoid.HipHeight + root.Size.Y / 2
	end
	return R6_LEG_HEIGHT + root.Size.Y / 2
end

-- Moves a character towards `target` using only the server's own geometry. `target` always
-- comes from a server plan, never from a client. A level ray from the root towards the
-- target's x and z stops WALL_MARGIN short of anything in the way; a ray down from there
-- stands the character on the ground, or keeps its current height if there is none. The
-- facing is kept and the velocity zeroed. Returns the level distance actually travelled
-- (0 when nothing moved).
function Sight.move(humanoid: Humanoid, root: BasePart, target: Types.Vec3): number
	local from = root.Position
	local dx = target.x - from.X
	local dz = target.z - from.Z
	local distance = math.sqrt(dx * dx + dz * dz)
	-- Written so NaN or infinite targets move nobody.
	if not (distance > 0 and distance < math.huge) then
		return 0
	end
	local direction = Vector3.new(dx / distance, 0, dz / distance)
	local params = Sight.rayParams()
	local travel = distance
	local blocked = workspace:Raycast(from, direction * distance, params)
	if blocked ~= nil then
		travel = math.max(0, blocked.Distance - Sight.WALL_MARGIN)
	end
	local stop = from + direction * travel
	local y = from.Y
	local ground = workspace:Raycast(stop, Vector3.new(0, -Sight.GROUND_PROBE, 0), params)
	if ground ~= nil then
		y = ground.Position.Y + Sight.standHeight(humanoid, root)
	end
	root.CFrame = CFrame.new(stop.X, y, stop.Z) * root.CFrame.Rotation
	root.AssemblyLinearVelocity = Vector3.zero
	return travel
end

return Sight
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="90">
        <Properties>
          <string name="Name">SiteBuilder</string>
          <string name="Source"><![CDATA[--!strict
-- Builds the island's structures and a visual marker for each hazard.
--   SiteBuilder.build(island)
--       Adds Folder "Features" (one anchored Part for every Sites.features entry) and Folder
--       "Hazards" (one marker Part for every Sites.hazards entry that covers an area) to
--       `island`. Each marker is named with its hazard id, carries the attribute HazardId and
--       the tag "Hazard", and touches nothing: it is only there to be seen. A region-wide
--       hazard has no marker. A tide marker also carries the attribute Rise.
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Sites = require(ReplicatedStorage.Shared.Catalog.Sites)
local Types = require(ReplicatedStorage.Shared.Types)
local World = require(ReplicatedStorage.Shared.Catalog.World)
local LookPainter = require(script.Parent.LookPainter)

local SiteBuilder = {}

local MARKER_THICKNESS = 0.3
-- Markers float a little above the surface they mark so the ground does not hide them.
local MARKER_LIFT = 0.2
local TIDE_RISE = 3
-- A sign's label floats this far above the top of the part that carries it.
local LABEL_CLEARANCE = 2

-- White bold text over the part (height studs tall), in the style of the training-post label.
-- It sits above the part's top face so the part itself never hides it.
local function addLabel(part: BasePart, text: string, height: number)
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(260, 70)
	gui.StudsOffset = Vector3.new(0, height / 2 + LABEL_CLEARANCE, 0)
	gui.MaxDistance = 120
	gui.AlwaysOnTop = false
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0.5
	label.TextScaled = true
	label.Font = Enum.Font.GothamBold
	label.Parent = gui
	gui.Parent = part
end

local function buildFeature(parent: Folder, feature: Types.Feature)
	local part = Instance.new("Part")
	part.Name = feature.look
	part.Anchored = true
	local centre = CFrame.new(feature.x, feature.y, feature.z)
	if feature.shape == "cylinder" then
		-- A Roblox cylinder's axis is X: Size is (height, diameter, diameter), and a quarter
		-- turn about Z stands it upright.
		part.Shape = Enum.PartType.Cylinder
		part.Size = Vector3.new(feature.sy, feature.sx, feature.sx)
		part.CFrame = centre * CFrame.Angles(0, 0, math.rad(90))
	else
		-- A bearing runs clockwise from north (-Z), so the turn about Y is its negative.
		part.Size = Vector3.new(feature.sx, feature.sy, feature.sz)
		part.CFrame = centre * CFrame.Angles(0, -math.rad(feature.yaw), 0)
	end
	LookPainter.paint(part, feature.look)
	part.CanCollide = feature.solid
	if not feature.solid then
		part.CanQuery = false
		part.CanTouch = false
	end
	if feature.text ~= nil then
		addLabel(part, feature.text, feature.sy)
	end
	part.Parent = parent
end

local function buildMarker(parent: Folder, hazard: Types.Hazard)
	local shape = hazard.shape
	if shape.kind == "region" then
		return
	end
	local part = Instance.new("Part")
	part.Name = hazard.id
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	local centre = CFrame.new(shape.x, (hazard.markerY or World.groundY) + MARKER_LIFT, shape.z)
	if shape.kind == "circle" then
		-- A flat disc: the cylinder's axis (its X, the thickness) is turned to point up.
		part.Shape = Enum.PartType.Cylinder
		part.Size = Vector3.new(MARKER_THICKNESS, shape.radius * 2, shape.radius * 2)
		part.CFrame = centre * CFrame.Angles(0, 0, math.rad(90))
	else
		part.Size = Vector3.new(2 * shape.halfAcross, MARKER_THICKNESS, 2 * shape.halfAlong)
		part.CFrame = centre * CFrame.Angles(0, -math.rad(shape.bearing), 0)
	end
	LookPainter.paint(part, hazard.look)
	part:SetAttribute("HazardId", hazard.id)
	CollectionService:AddTag(part, "Hazard")
	if hazard.look == "tide" then
		part:SetAttribute("Rise", TIDE_RISE)
	end
	part.Parent = parent
end

function SiteBuilder.build(island: Folder)
	local features = Instance.new("Folder")
	features.Name = "Features"
	for _, feature in Sites.features do
		buildFeature(features, feature)
	end
	features.Parent = island

	local hazards = Instance.new("Folder")
	hazards.Name = "Hazards"
	for _, hazard in Sites.hazards do
		buildMarker(hazards, hazard)
	end
	hazards.Parent = island
end

return SiteBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="91">
        <Properties>
          <string name="Name">SourceService</string>
          <string name="Source"><![CDATA[--!strict
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Shared.Net)
local Relics = require(ReplicatedStorage.Shared.Catalog.Relics)
local World = require(ReplicatedStorage.Shared.Catalog.World)
local Scarcity = require(ReplicatedStorage.Shared.Rules.Scarcity)
local Sources = require(ReplicatedStorage.Shared.Rules.Sources)
local DataService = require(script.Parent.DataService)
local Fighters = require(script.Parent.Fighters)
local LedgerService = require(script.Parent.LedgerService)

local SourceService = {}

local coinSync: RemoteEvent

-- Copies of the Relic held on this server, claimed and spare alike.
function SourceService.held(relicId: string): number
	return Scarcity.countHeld(LedgerService.all(), relicId)
end

local function isSealed(relicId: string): boolean
	return Scarcity.isSealed(relicId, SourceService.held(relicId))
end

-- The one way a reward Relic (creature drop, trial, quest) reaches a Ledger. It goes to a
-- free slot under the same rules as a cache, and the player is told the result here:
-- GOT_CARD, REWARD_SEALED, REWARD_LOST (free slots full) or REWARD_LOCKED. Returns that
-- code; DATA_NOT_LOADED and UNKNOWN_CARD are returned without a message.
function SourceService.award(player: Player, relicId: string): string
	-- No yielding call between reading the Ledger and storing the new one.
	local newLedger, code = Sources.give(
		LedgerService.get(player),
		relicId,
		isSealed(relicId),
		LedgerService.isLocked(player)
	)
	local relic = Relics.byId[relicId]
	local args = { name = if relic ~= nil then relic.name else "" }
	if newLedger ~= nil then
		if not LedgerService.set(player, newLedger) then
			return "DATA_NOT_LOADED"
		end
		LedgerService.notify(player, "GOT_CARD", args)
		return "GOT_CARD"
	end
	local told = if code == "SEALED"
		then "REWARD_SEALED"
		elseif code == "FREE_FULL" then "REWARD_LOST"
		elseif code == "LEDGER_LOCKED" then "REWARD_LOCKED"
		else nil
	if told == nil then
		return code
	end
	LedgerService.notify(player, told, args)
	return told
end

-- Adds Coin (or takes it, with a negative delta) and tells the client. False, with nothing
-- changed, for a delta that is not a finite number, unloaded data, or a result below 0.
function SourceService.addCoin(player: Player, delta: number): boolean
	if not (delta > -math.huge and delta < math.huge) then
		return false
	end
	local data = DataService.get(player)
	if data == nil then
		return false
	end
	local coin = data.coin + delta
	if not (coin >= 0 and coin < math.huge) then
		return false
	end
	data.coin = coin
	if player.Parent == Players then
		coinSync:FireClient(player, coin)
	end
	return true
end

-- Sealed caches read "Sealed cache" with a dull pillar; open ones read "Cache" with a glowing one.
local function showSealed(part: BasePart, sealed: boolean)
	local prompt = part:FindFirstChildOfClass("ProximityPrompt")
	if prompt ~= nil then
		prompt.ObjectText = if sealed then "Sealed cache" else "Cache"
	end
	local pillar = part:FindFirstChild("Pillar")
	if pillar ~= nil and pillar:IsA("BasePart") then
		pillar.Material = if sealed then Enum.Material.SmoothPlastic else Enum.Material.Neon
	end
end

local function setVisible(part: BasePart, visible: boolean)
	local transparency = if visible then 0 else 1
	part.Transparency = transparency
	part.CanCollide = visible
	local pillar = part:FindFirstChild("Pillar")
	if pillar ~= nil and pillar:IsA("BasePart") then
		pillar.Transparency = transparency
		pillar.CanCollide = visible
	end
	local prompt = part:FindFirstChildOfClass("ProximityPrompt")
	if prompt ~= nil then
		prompt.Enabled = visible
	end
end

local function distanceToPlayer(player: Player, part: BasePart): number
	local character = player.Character
	local root = if character ~= nil then character:FindFirstChild("HumanoidRootPart") else nil
	if root == nil or not root:IsA("BasePart") then
		return math.huge
	end
	return (root.Position - part.Position).Magnitude
end

type Hold = { began: number, ended: number? }

local state: Sources.SourceState = Sources.new(World.caches)
local cacheParts: { BasePart } = {}
-- part -> player -> when they started holding the prompt and when they let go. Cleared on every
-- trigger, when the player leaves, dies, respawns or goes out of reach, and for the whole part
-- when it opens.
local holds: { [BasePart]: { [Player]: Hold } } = {}

local function refreshSealed()
	for _, part in cacheParts do
		local cacheId = part:GetAttribute("CacheId")
		local cache = if type(cacheId) == "string" then World.cacheById[cacheId] else nil
		if cache ~= nil then
			showSealed(part, isSealed(cache.relicId))
		end
	end
end

-- Opens the cache at `part` for `player` and returns the code. A held cache is only opened
-- by a hold the server saw begin and last long enough.
local function open(player: Player, part: BasePart): string
	local cacheId = part:GetAttribute("CacheId")
	local cache = if type(cacheId) == "string" then World.cacheById[cacheId] else nil
	if cache == nil then
		return "CACHE_EMPTY"
	end

	-- No yielding call between tryCollect and storing the new state.
	local now = os.clock()
	local byPlayer = holds[part]
	local h = if byPlayer ~= nil then byPlayer[player] else nil
	local hold = if cache.hold ~= nil and cache.hold > 0 then cache.hold else nil
	local began = if h ~= nil then h.began else nil
	local ended = if h ~= nil then h.ended else nil
	local holdOk = Sources.holdOk(hold, began, ended, now)
	if byPlayer ~= nil then
		byPlayer[player] = nil
	end
	local newState, newLedger, code, availableAt = Sources.tryCollect(
		state,
		LedgerService.get(player),
		cache,
		now,
		distanceToPlayer(player, part),
		isSealed(cache.relicId),
		LedgerService.isLocked(player),
		holdOk
	)
	if newLedger == nil or availableAt == nil then
		LedgerService.notify(player, code)
		return code
	end
	if not LedgerService.set(player, newLedger) then
		-- The data went away; the cache stays as it was.
		LedgerService.notify(player, "DATA_NOT_LOADED")
		return "DATA_NOT_LOADED"
	end
	state = newState
	-- The cache is empty now: nobody's hold on it counts for the next opening.
	holds[part] = nil
	local relic = Relics.byId[cache.relicId]
	LedgerService.notify(player, code, { name = if relic ~= nil then relic.name else "" })

	setVisible(part, false)
	task.delay(availableAt - now, setVisible, part, true)
	return code
end

-- Play-test seam: the prompt's path with no hold record. Returns the code ("CACHE_EMPTY" when
-- no cache part has that id).
function SourceService.tryOpen(player: Player, cacheId: string): string
	for _, part in cacheParts do
		if part:GetAttribute("CacheId") == cacheId then
			return open(player, part)
		end
	end
	return "CACHE_EMPTY"
end

local function dropHolds(player: Player)
	for _, byPlayer in holds do
		byPlayer[player] = nil
	end
end

-- Drops a hold once the player is dead, gone or out of reach of the part.
local function sweepHolds()
	for part, byPlayer in holds do
		for player in byPlayer do
			local _, root = Fighters.body(player.UserId)
			if
				player.Parent == nil
				or root == nil
				or (root.Position - part.Position).Magnitude > Sources.MAX_DISTANCE
			then
				byPlayer[player] = nil
			end
		end
	end
end

local function connect(instance: Instance)
	if not instance:IsA("BasePart") then
		return
	end
	local part = instance
	local prompt = part:FindFirstChildOfClass("ProximityPrompt")
	if prompt == nil then
		return
	end
	table.insert(cacheParts, part)
	prompt.PromptButtonHoldBegan:Connect(function(player: Player)
		local byPlayer = holds[part]
		if byPlayer == nil then
			byPlayer = {}
			holds[part] = byPlayer
		end
		byPlayer[player] = { began = os.clock() }
	end)
	prompt.PromptButtonHoldEnded:Connect(function(player: Player)
		local byPlayer = holds[part]
		local h = if byPlayer ~= nil then byPlayer[player] else nil
		if h ~= nil and h.ended == nil then
			h.ended = os.clock()
		end
	end)
	prompt.Triggered:Connect(function(player: Player)
		open(player, part)
	end)
end

function SourceService.start()
	coinSync = LedgerService.makeRemote(Net.CoinSync)
	DataService.onLoaded(function(player, data)
		if player.Parent == Players then
			coinSync:FireClient(player, data.coin)
		end
	end)

	for _, instance in CollectionService:GetTagged("Cache") do
		connect(instance)
	end

	local function watch(player: Player)
		player.CharacterRemoving:Connect(function()
			dropHolds(player)
		end)
	end
	Players.PlayerAdded:Connect(watch)
	for _, player in Players:GetPlayers() do
		watch(player)
	end
	task.spawn(function()
		while true do
			task.wait(0.25)
			sweepHolds()
		end
	end)

	LedgerService.onChanged(refreshSealed)
	DataService.onLoaded(refreshSealed)
	Players.PlayerRemoving:Connect(function(player)
		dropHolds(player)
		-- One frame later, once the leaving player's data is gone (held players stay counted).
		task.defer(refreshSealed)
	end)
	refreshSealed()
end

return SourceService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="92">
        <Properties>
          <string name="Name">StatusService</string>
          <string name="Source"><![CDATA[--!strict
-- Owns every fighter's effect status (slow, root, burn, shield, ...), keyed by fighter id
-- (see Fighters), and the ground zones. Never requires CombatService: Main passes its damage
-- function into start(), so every burn and zone tick goes through the one damage pipeline.
-- The only writer of WalkSpeed: baseSpeed × Effects.speedFactor, for every fighter with a body.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local StarterPlayer = game:GetService("StarterPlayer")

local Casting = require(ReplicatedStorage.Shared.Rules.Casting)
local Combat = require(ReplicatedStorage.Shared.Rules.Combat)
local Effects = require(ReplicatedStorage.Shared.Rules.Effects)
local Paths = require(ReplicatedStorage.Shared.Catalog.Paths)
local Types = require(ReplicatedStorage.Shared.Types)
local Fighters = require(script.Parent.Fighters)

type Status = Effects.Status
type DamageOpts = { reflected: boolean?, tick: boolean?, passive: boolean?, path: string? }
-- CombatService.damage: true when the hit landed.
type DamageFn = (attackerId: number, targetId: number, amount: number, opts: DamageOpts?) -> boolean

type ZoneEntry = {
	owner: number,
	x: number,
	y: number,
	-- Fighters inside when the zone was placed; others who walk in later are passive targets.
	inside: { [number]: boolean },
	z: number,
	radius: number,
	dps: number,
	slow: number?,
	path: string,
	expiresAt: number,
	part: BasePart?,
}

local TICK_SECONDS = 1
local ZONE_SLOW_SECONDS = 1.2
local ZONE_THICKNESS = 0.3
local ZONE_TRANSPARENCY = 0.6
local ZONE_DEFAULT_COLOR = Color3.fromRGB(200, 200, 200)

local StatusService = {}

-- Time from os.clock() everywhere. All keyed by fighter id.
local statuses: { [number]: Status } = {}
-- The Path of the ability that set each fighter's current burn, for the burn's ticks.
local burnPaths: { [number]: string } = {}
local zones: { ZoneEntry } = {}
-- The Humanoid whose jump we zeroed for a root, so it can be restored afterwards (players).
local jumpBlocked: { [number]: Humanoid } = {}
local damageFn: DamageFn? = nil
local nextTick = 0

-- Read-only defaults for a fighter with no entry. Never written to.
local FRESH: Status = Effects.new()

local function effectsFolder(): Folder
	local existing = workspace:FindFirstChild("Effects")
	if existing ~= nil and existing:IsA("Folder") then
		return existing
	end
	local folder = Instance.new("Folder")
	folder.Name = "Effects"
	folder.Parent = workspace
	return folder
end

local function pathColor(path: string): Color3
	local info = Paths.info[path :: Types.PathId]
	if info == nil then
		return ZONE_DEFAULT_COLOR
	end
	return Color3.fromRGB(info.color.r, info.color.g, info.color.b)
end

-- A translucent neon disc of the zone's radius lying on the ground.
local function makeZonePart(entry: ZoneEntry): BasePart
	local part = Instance.new("Part")
	part.Name = "Zone"
	part.Shape = Enum.PartType.Cylinder
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Material = Enum.Material.Neon
	part.Color = pathColor(entry.path)
	part.Transparency = ZONE_TRANSPARENCY
	-- A cylinder's axis is its X axis: stand it on end, then lay it flat.
	part.Size = Vector3.new(ZONE_THICKNESS, entry.radius * 2, entry.radius * 2)
	part.CFrame = CFrame.new(entry.x, entry.y + 0.25, entry.z) * CFrame.Angles(0, 0, math.pi / 2)
	part.Parent = effectsFolder()
	return part
end

local function removeZone(index: number)
	local entry = table.remove(zones, index)
	if entry ~= nil and entry.part ~= nil then
		entry.part:Destroy()
	end
end

local function removeExpiredZones(now: number)
	for i = #zones, 1, -1 do
		local entry = zones[i]
		-- Written so a NaN time removes the zone rather than keeping it forever.
		if not (now < entry.expiresAt) or Fighters.get(entry.owner) == nil then
			removeZone(i)
		end
	end
end

local function horizontalDistance(ax: number, az: number, bx: number, bz: number): number
	local dx = ax - bx
	local dz = az - bz
	return math.sqrt(dx * dx + dz * dz)
end

-- Runs one tick step; a failure is reported and does not stop the other steps.
local function guarded(name: string, step: () -> ())
	local ok, err = pcall(step)
	if not ok then
		warn(`[IsleOfAvarice] StatusService {name} failed: {err}`)
	end
end

-- True when a fighter at `p` is inside the zone: within its radius on the ground plane and
-- within the height tolerance every other targeting rule uses.
local function zoneContains(entry: ZoneEntry, p: Types.Vec3): boolean
	return horizontalDistance(p.x, p.z, entry.x, entry.z) <= entry.radius
		and math.abs(p.y - entry.y) <= Combat.STRIKE_MAX_HEIGHT
end

local function tickBurns(now: number, damage: DamageFn)
	-- Snapshot first: damage writes statuses while we would otherwise be iterating them.
	local burns: { { victim: number, dps: number, burnBy: number, path: string } } = {}
	for id, status in statuses do
		local dps, burnBy = Effects.burnTick(status, now)
		if dps > 0 and burnBy ~= 0 then
			table.insert(
				burns,
				{ victim = id, dps = dps, burnBy = burnBy, path = burnPaths[id] or "" }
			)
		end
	end
	for _, burn in burns do
		-- A burner who has gone (left, or a creature despawned) burns no more.
		if Fighters.get(burn.burnBy) == nil then
			continue
		end
		guarded("burn tick", function()
			damage(burn.burnBy, burn.victim, burn.dps, { tick = true, path = burn.path })
		end)
	end
end

local function tickZone(entry: ZoneEntry, damage: DamageFn)
	local owner = entry.owner
	if Fighters.get(owner) == nil then
		return
	end
	for _, target in Fighters.list(owner) do
		if not zoneContains(entry, target.position) then
			continue
		end
		-- Someone who walked in after placement is hurt and slowed, but the owner is not
		-- marked, loses no respawn shield and starts no fight by it.
		local passive = not entry.inside[target.id]
		-- Posts pay the zone's Path; players (and creatures) take the damage.
		local landed = damage(
			owner,
			target.id,
			entry.dps,
			{ tick = true, passive = passive, path = entry.path }
		)
		-- The slow is only refreshed on a target the damage actually reached; posts ignore it.
		local slow = entry.slow
		local targetEntry = Fighters.get(target.id)
		if landed and slow ~= nil and targetEntry ~= nil and targetEntry.kind ~= "post" then
			local factor: number = slow
			StatusService.update(target.id, function(status, at)
				return Effects.applySlow(status, factor, ZONE_SLOW_SECONDS, at)
			end)
		end
	end
end

local function tick(now: number)
	local configured = damageFn
	if configured == nil then
		return
	end
	local damage: DamageFn = configured
	tickBurns(now, damage)
	-- A copy: a zone's owner leaving mid-tick must not shift the list under us.
	for _, entry in table.clone(zones) do
		if now < entry.expiresAt then
			guarded("zone tick", function()
				tickZone(entry, damage)
			end)
		end
	end
end

-- Walk speed follows slow and root for every fighter with a living body; jumping is off
-- while a player is rooted.
local function applyMovement(now: number)
	for _, entry in Fighters.all() do
		local id = entry.id
		local humanoid = Fighters.body(id)
		if humanoid == nil then
			continue
		end
		local status = statuses[id] or FRESH
		local speed = entry.baseSpeed * Effects.speedFactor(status, now)
		if humanoid.WalkSpeed ~= speed then
			humanoid.WalkSpeed = speed
		end
		if entry.kind ~= "player" then
			continue
		end
		local blocked = jumpBlocked[id]
		if Effects.isRooted(status, now) then
			if blocked ~= humanoid then
				humanoid.JumpPower = 0
				humanoid.JumpHeight = 0
				jumpBlocked[id] = humanoid
			end
		elseif blocked ~= nil then
			if blocked == humanoid then
				humanoid.JumpPower = StarterPlayer.CharacterJumpPower
				humanoid.JumpHeight = StarterPlayer.CharacterJumpHeight
			end
			jumpBlocked[id] = nil
		end
	end
end

local function onHeartbeat()
	local now = os.clock()
	applyMovement(now)
	removeExpiredZones(now)
	if now >= nextTick then
		nextTick = now + TICK_SECONDS
		tick(now)
	end
end

-- The fighter's status; a fresh one when it has none. Treat it as read-only.
function StatusService.get(id: number): Status
	return statuses[id] or Effects.new()
end

-- Replaces the fighter's status with fn(status, now). No yielding inside fn. A fighter with
-- no entry (a post, or a player who has left) is not given one: fn sees a fresh status and
-- its result is dropped.
function StatusService.update(id: number, fn: (Status, number) -> Status)
	local current = statuses[id]
	local nextStatus = fn(current or Effects.new(), os.clock())
	if current ~= nil then
		statuses[id] = nextStatus
	end
end

-- A fresh status: players on join and respawn, creatures on spawn.
function StatusService.reset(id: number)
	statuses[id] = Effects.new()
	burnPaths[id] = nil
	jumpBlocked[id] = nil
end

-- Forgets the fighter's status and burn Path, and removes the zones it owns.
function StatusService.drop(id: number)
	statuses[id] = nil
	burnPaths[id] = nil
	jumpBlocked[id] = nil
	for i = #zones, 1, -1 do
		if zones[i].owner == id then
			removeZone(i)
		end
	end
end

-- A landed ability hit's statuses on the target (Effects.applyHit). The burn remembers the
-- ability's Path for its ticks. A target with no status (a post) is left alone.
function StatusService.applyHit(attackerId: number, targetId: number, ability: Types.Ability)
	if statuses[targetId] == nil then
		return
	end
	StatusService.update(targetId, function(status, now)
		return Effects.applyHit(status, ability, attackerId, now)
	end)
	if ability.burn ~= nil then
		burnPaths[targetId] = ability.path
	end
end

-- A ground zone owned by `ownerId`: once a second it damages every other fighter inside
-- (posts pay `path` XP), until it expires or its owner is gone.
function StatusService.addZone(ownerId: number, zone: Casting.Zone, path: string)
	if Fighters.get(ownerId) == nil then
		return
	end
	local radius, duration, dps = zone.radius, zone.duration, zone.dps
	if
		not (radius > 0 and radius < math.huge)
		or not (duration > 0 and duration < math.huge)
		or not (dps >= 0 and dps < math.huge)
		or not (math.abs(zone.center.x) < math.huge and math.abs(zone.center.z) < math.huge)
	then
		return
	end
	local entry: ZoneEntry = {
		owner = ownerId,
		x = zone.center.x,
		y = zone.center.y,
		z = zone.center.z,
		inside = {},
		radius = radius,
		dps = dps,
		slow = zone.slow,
		path = path,
		expiresAt = os.clock() + duration,
		part = nil,
	}
	if not (math.abs(zone.center.y) < math.huge) then
		return
	end
	-- Every fighter standing in it counts, allies included: an ally removed from the party
	-- later must not turn into a passive target.
	for _, other in Fighters.all() do
		if other.id == ownerId then
			continue
		end
		local fighter = Fighters.fighter(other.id)
		if fighter ~= nil and zoneContains(entry, fighter.position) then
			entry.inside[other.id] = true
		end
	end
	entry.part = makeZonePart(entry)
	table.insert(zones, entry)
end

function StatusService.start(damage: DamageFn)
	damageFn = damage
	effectsFolder()

	local function watchPlayer(player: Player)
		StatusService.reset(player.UserId)
		player.CharacterAdded:Connect(function()
			StatusService.reset(player.UserId)
		end)
	end
	Players.PlayerAdded:Connect(watchPlayer)
	for _, player in Players:GetPlayers() do
		watchPlayer(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		-- Leave a rejoin under the same UserId alone.
		local entry = Fighters.get(player.UserId)
		if entry == nil or entry.player == player then
			StatusService.drop(player.UserId)
		end
	end)

	nextTick = os.clock() + TICK_SECONDS
	RunService.Heartbeat:Connect(onHeartbeat)
end

return StatusService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="93">
        <Properties>
          <string name="Name">TerrainBuilder</string>
          <string name="Source"><![CDATA[--!strict
-- Builds the island's ground and the sea around it.
--   TerrainBuilder.build(island)
--       Adds Folder "Ground" (one Part per strip from Geography.strips(), painted with its
--       region's ground look) and Folder "Sea" (four Parts) to `island`.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Geography = require(ReplicatedStorage.Shared.Rules.Geography)
local Regions = require(ReplicatedStorage.Shared.Catalog.Regions)
local World = require(ReplicatedStorage.Shared.Catalog.World)
local LookPainter = require(script.Parent.LookPainter)

local TerrainBuilder = {}

local GROUND_THICKNESS = 4
-- A Part cannot be larger than 2048 studs on a side, so the sea is four of them, one per
-- quadrant, together covering -2048 to 2048 in x and z.
local SEA_SIZE = 2048
local SEA_THICKNESS = 2
local SEA_CENTER_Y = -4
local SEA_COLOR = Color3.fromRGB(40, 100, 170)
local SEA_TRANSPARENCY = 0.3

local function buildGround(island: Folder)
	local ground = Instance.new("Folder")
	ground.Name = "Ground"
	for _, strip in Geography.strips() do
		local region = Regions.byId[strip.region]
		local part = Instance.new("Part")
		part.Name = "Ground"
		part.Anchored = true
		part.Size = Vector3.new(strip.x2 - strip.x1, GROUND_THICKNESS, Geography.CELL)
		-- Block centres are half a height below the top face.
		part.CFrame =
			CFrame.new((strip.x1 + strip.x2) / 2, World.groundY - GROUND_THICKNESS / 2, strip.z)
		LookPainter.paint(part, if region then region.ground else "")
		part.Parent = ground
	end
	ground.Parent = island
end

local function buildSea(island: Folder)
	local sea = Instance.new("Folder")
	sea.Name = "Sea"
	for _, signX in { -1, 1 } do
		for _, signZ in { -1, 1 } do
			local part = Instance.new("Part")
			part.Name = "Sea"
			part.Anchored = true
			part.Size = Vector3.new(SEA_SIZE, SEA_THICKNESS, SEA_SIZE)
			part.CFrame = CFrame.new(signX * SEA_SIZE / 2, SEA_CENTER_Y, signZ * SEA_SIZE / 2)
			part.Color = SEA_COLOR
			part.Material = Enum.Material.Glass
			part.Transparency = SEA_TRANSPARENCY
			part.CanCollide = false
			part.Parent = sea
		end
	end
	sea.Parent = island
end

function TerrainBuilder.build(island: Folder)
	buildGround(island)
	buildSea(island)
end

return TerrainBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="94">
        <Properties>
          <string name="Name">TradeService</string>
          <string name="Source"><![CDATA[--!strict
-- Player-to-player trades (spec 3.13): asking the nearest player, the invite, the two offers,
-- the two confirmations and the swap. Trade holds every rule; this service owns the sessions,
-- watches that both traders stay close and well, and settles. The swap writes both Ledgers
-- and both Coin totals in one step: no yielding call from reading both players' data to the
-- last write, so it fully happens or does not happen at all.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local EdictRules = require(ReplicatedStorage.Shared.Rules.EdictRules)
local Net = require(ReplicatedStorage.Shared.Net)
local Protection = require(ReplicatedStorage.Shared.Rules.Protection)
local RateLimiter = require(ReplicatedStorage.Shared.Rules.RateLimiter)
local Trade = require(ReplicatedStorage.Shared.Rules.Trade)
local Types = require(ReplicatedStorage.Shared.Types)
local CombatService = require(script.Parent.CombatService)
local DataService = require(script.Parent.DataService)
local Fighters = require(script.Parent.Fighters)
local LedgerService = require(script.Parent.LedgerService)
local ProtectionService = require(script.Parent.ProtectionService)
local SourceService = require(script.Parent.SourceService)

-- Both traders map to the same Ref; `session` is replaced as the trade changes.
type Ref = { session: Trade.Session, a: Player, b: Player }
type Invite = { from: Player }

local BUCKET_CAPACITY = 10
local BUCKET_REFILL_PER_SECOND = 5
local WATCH_SECONDS = 0.5

local TradeService = {}

-- Pending invites, keyed by the invited player.
local invites: { [Player]: Invite } = {}
-- Who each asker has asked.
local asked: { [Player]: Player } = {}
local trades: { [Player]: Ref } = {}
local buckets: { [Player]: RateLimiter.Bucket } = {}
local inviteRemote: RemoteEvent
local syncRemote: RemoteEvent
local accumulated = 0

local function allowed(player: Player): boolean
	local now = os.clock()
	local bucket = buckets[player]
	if bucket == nil then
		bucket = RateLimiter.new(BUCKET_CAPACITY, now)
		buckets[player] = bucket
	end
	return RateLimiter.allow(bucket, now, BUCKET_CAPACITY, BUCKET_REFILL_PER_SECOND)
end

-- A message to someone who may already have left.
local function tell(player: Player, code: string, args: { [string]: string }?)
	if player.Parent == Players then
		LedgerService.notify(player, code, args)
	end
end

local function vec(position: Vector3): Types.Vec3
	return { x = position.X, y = position.Y, z = position.Z }
end

-- Present, data loaded, alive and not locked: able to take part in a trade at all.
local function fit(player: Player): boolean
	if player.Parent ~= Players or DataService.get(player) == nil then
		return false
	end
	if LedgerService.isLocked(player) then
		return false
	end
	local _, root = Fighters.body(player.UserId)
	return root ~= nil
end

-- Not Marked and not just out of a fight (and so not moving cards out of a blind claim's
-- reach). A player with no loaded data is not told more than "not now".
local function canDealNow(player: Player): (boolean, string)
	local now = os.clock()
	local status = ProtectionService.status(player, now)
	if status == nil then
		return false, "EDICT_NOT_NOW"
	end
	local ok, code = EdictRules.canDeal({
		marked = Protection.isMarked(status, now),
		lastFightAt = CombatService.lastFightAt(player),
	}, now)
	return ok, code or "EDICT_NOT_NOW"
end

local function freeToTrade(player: Player): boolean
	return fit(player) and trades[player] == nil and invites[player] == nil and asked[player] == nil
end

-- Written positively so a NaN distance counts as too far.
local function withinKeepRange(a: Player, b: Player): boolean
	local _, rootA = Fighters.body(a.UserId)
	local _, rootB = Fighters.body(b.UserId)
	if rootA == nil or rootB == nil then
		return false
	end
	return (rootA.Position - rootB.Position).Magnitude <= Trade.KEEP_RANGE
end

-- Each trader gets their own view of the trade.
local function sync(ref: Ref)
	for _, pair in { { ref.a, ref.b }, { ref.b, ref.a } } do
		local player, other = pair[1], pair[2]
		local data = DataService.get(player)
		if player.Parent == Players and data ~= nil then
			syncRemote:FireClient(
				player,
				Trade.view(
					ref.session,
					player.UserId,
					other.DisplayName,
					data.ledger,
					data.coin,
					os.clock()
				)
			)
		end
	end
end

local function closeWindow(player: Player)
	if player.Parent == Players then
		syncRemote:FireClient(player, nil)
	end
end

-- Ends the trade with nothing swapped and tells whoever is still here.
local function cancel(ref: Ref)
	if trades[ref.a] ~= ref and trades[ref.b] ~= ref then
		return
	end
	if trades[ref.a] == ref then
		trades[ref.a] = nil
	end
	if trades[ref.b] == ref then
		trades[ref.b] = nil
	end
	for _, player in { ref.a, ref.b } do
		tell(player, "TRADE_CANCELLED")
		closeWindow(player)
	end
end

local function settle(ref: Ref)
	local a, b = ref.a, ref.b
	local dataA, dataB = DataService.get(a), DataService.get(b)
	if
		dataA == nil
		or dataB == nil
		or a.Parent ~= Players
		or b.Parent ~= Players
		or LedgerService.isLocked(a)
		or LedgerService.isLocked(b)
		or not fit(a)
		or not fit(b)
		or not withinKeepRange(a, b)
		-- The early confirmer may have started a fight since: cards must not move then.
		or not canDealNow(a)
		or not canDealNow(b)
	then
		cancel(ref)
		return
	end
	-- No yielding call from here to the last write: neither Ledger can go stale.
	local ledgerA, coinA, ledgerB, coinB, code =
		Trade.settle(ref.session, dataA.ledger, dataA.coin, dataB.ledger, dataB.coin)
	if ledgerA == nil or ledgerB == nil then
		tell(a, code)
		tell(b, code)
		ref.session = Trade.unconfirm(ref.session, os.clock())
		sync(ref)
		return
	end
	local heldA, heldB = dataA.coin, dataB.coin
	-- Out of `trades` first, so the Ledger-changed hook below does nothing.
	trades[a] = nil
	trades[b] = nil
	LedgerService.set(a, ledgerA)
	LedgerService.set(b, ledgerB)
	SourceService.addCoin(a, coinA - heldA)
	SourceService.addCoin(b, coinB - heldB)
	tell(a, "TRADE_DONE")
	tell(b, "TRADE_DONE")
	closeWindow(a)
	closeWindow(b)
end

-- Removes an invite to `target`, from either table.
local function clearInvite(target: Player)
	local invite = invites[target]
	if invite == nil then
		return
	end
	invites[target] = nil
	if asked[invite.from] == target then
		asked[invite.from] = nil
	end
end

local function handleRequest(player: Player)
	if player.Parent ~= Players or not allowed(player) then
		return
	end
	if not freeToTrade(player) then
		LedgerService.notify(player, "EDICT_NOT_NOW")
		return
	end
	local canDeal, dealCode = canDealNow(player)
	if not canDeal then
		LedgerService.notify(player, dealCode)
		return
	end
	local _, root = Fighters.body(player.UserId)
	if root == nil then
		LedgerService.notify(player, "EDICT_NOT_NOW")
		return
	end
	local others: { Trade.Body } = {}
	for _, other in Players:GetPlayers() do
		if other ~= player then
			local _, otherRoot = Fighters.body(other.UserId)
			if otherRoot ~= nil then
				table.insert(others, { userId = other.UserId, position = vec(otherRoot.Position) })
			end
		end
	end
	local targetId =
		Trade.nearest({ userId = player.UserId, position = vec(root.Position) }, others)
	local target = if targetId ~= nil then Players:GetPlayerByUserId(targetId) else nil
	if target == nil then
		LedgerService.notify(player, "EDICT_NO_TARGET")
		return
	end
	if not freeToTrade(target) then
		LedgerService.notify(player, "TRADE_BUSY", { player = target.DisplayName })
		return
	end

	local invite: Invite = { from = player }
	invites[target] = invite
	asked[player] = target
	inviteRemote:FireClient(target, { from = player.DisplayName, seconds = Trade.INVITE_SECONDS })
	LedgerService.notify(player, "TRADE_SENT", { player = target.DisplayName })
	task.delay(Trade.INVITE_SECONDS, function()
		if invites[target] ~= invite then
			return
		end
		clearInvite(target)
		if target.Parent == Players then
			inviteRemote:FireClient(target, nil)
		end
		tell(player, "TRADE_EXPIRED")
	end)
end

local function handleReply(player: Player, accept: any)
	if player.Parent ~= Players or not allowed(player) then
		return
	end
	local invite = invites[player]
	if invite == nil then
		LedgerService.notify(player, "TRADE_NOT_OPEN")
		return
	end
	clearInvite(player)
	local asker = invite.from
	if accept ~= true then
		tell(asker, "TRADE_DECLINED", { player = player.DisplayName })
		return
	end
	if not fit(asker) or not fit(player) or not withinKeepRange(asker, player) then
		tell(asker, "TRADE_CANCELLED")
		tell(player, "TRADE_CANCELLED")
		return
	end
	-- The accepter hears their own reason; the asker's reason is not shared. The asker is
	-- always told the trade is off.
	local canDeal, dealCode = canDealNow(player)
	if not canDeal then
		tell(player, dealCode)
		tell(asker, "TRADE_CANCELLED")
		return
	end
	if not canDealNow(asker) then
		tell(asker, "TRADE_CANCELLED")
		tell(player, "TRADE_CANCELLED")
		return
	end
	local ref: Ref = {
		session = Trade.new(asker.UserId, player.UserId, os.clock()),
		a = asker,
		b = player,
	}
	trades[asker] = ref
	trades[player] = ref
	sync(ref)
end

local function handleAction(player: Player, raw: any)
	if player.Parent ~= Players or not allowed(player) then
		return
	end
	local ref = trades[player]
	if ref == nil then
		LedgerService.notify(player, "TRADE_NOT_OPEN")
		return
	end
	if type(raw) ~= "table" or type(raw.kind) ~= "string" then
		LedgerService.notify(player, "BAD_REQUEST")
		return
	end
	local kind = raw.kind
	if kind ~= "cancel" then
		-- A dead or locked trader cannot act; the watch ends the trade shortly.
		local _, root = Fighters.body(player.UserId)
		if root == nil then
			LedgerService.notify(player, "EDICT_NOT_NOW")
			return
		end
		if LedgerService.isLocked(player) then
			LedgerService.notify(player, "LEDGER_LOCKED")
			return
		end
	end
	if kind == "offer" then
		local data = DataService.get(player)
		local session, code = Trade.setOffer(
			ref.session,
			player.UserId,
			raw,
			if data ~= nil then data.ledger else nil,
			if data ~= nil then data.coin else 0,
			os.clock()
		)
		if session == nil then
			LedgerService.notify(player, code)
			return
		end
		ref.session = session
		sync(ref)
	elseif kind == "confirm" then
		local canDeal, dealCode = canDealNow(player)
		if not canDeal then
			LedgerService.notify(player, dealCode)
			return
		end
		local session, code = Trade.confirm(ref.session, player.UserId, os.clock())
		if session == nil then
			LedgerService.notify(player, code)
			return
		end
		ref.session = session
		if Trade.ready(session) then
			settle(ref)
		else
			sync(ref)
		end
	elseif kind == "cancel" then
		cancel(ref)
	else
		LedgerService.notify(player, "BAD_REQUEST")
	end
end

-- A trade ends when a trader is gone, dead, locked, or has walked too far from the other.
local function watch()
	for _, ref in table.clone(trades) do
		if trades[ref.a] ~= ref and trades[ref.b] ~= ref then
			continue
		end
		if not fit(ref.a) or not fit(ref.b) or not withinKeepRange(ref.a, ref.b) then
			cancel(ref)
		end
	end
end

local function onHeartbeat(deltaTime: number)
	accumulated += deltaTime
	if accumulated < WATCH_SECONDS then
		return
	end
	accumulated = 0
	local ok, err = pcall(watch)
	if not ok then
		warn(`[IsleOfAvarice] TradeService watch failed: {err}`)
	end
end

-- Something else changed a trader's Ledger: an offer they can no longer cover is emptied.
local function onLedgerChanged(player: Player, ledger: Types.Ledger)
	local ref = trades[player]
	local data = DataService.get(player)
	if ref == nil or data == nil then
		return
	end
	ref.session = Trade.prune(ref.session, player.UserId, ledger, data.coin, os.clock())
	sync(ref)
end

local function onRemoving(player: Player)
	local ref = trades[player]
	if ref ~= nil then
		cancel(ref)
	end
	-- An invite to them: the asker is told it is off.
	local invite = invites[player]
	if invite ~= nil then
		tell(invite.from, "TRADE_CANCELLED")
	end
	clearInvite(player)
	-- An invite from them: withdrawn from whoever was shown it.
	local target = asked[player]
	if target ~= nil then
		asked[player] = nil
		local sent = invites[target]
		if sent ~= nil and sent.from == player then
			invites[target] = nil
			if target.Parent == Players then
				inviteRemote:FireClient(target, nil)
			end
		end
	end
	buckets[player] = nil
end

-- Play-test seam: the player's trade session, if any.
function TradeService.session(player: Player): Trade.Session?
	local ref = trades[player]
	return if ref ~= nil then ref.session else nil
end

function TradeService.start()
	inviteRemote = LedgerService.makeRemote(Net.TradeInvite)
	syncRemote = LedgerService.makeRemote(Net.TradeSync)
	LedgerService.makeRemote(Net.TradeRequest).OnServerEvent:Connect(handleRequest)
	LedgerService.makeRemote(Net.TradeReply).OnServerEvent:Connect(handleReply)
	LedgerService.makeRemote(Net.TradeAction).OnServerEvent:Connect(handleAction)

	LedgerService.onChanged(onLedgerChanged)
	Players.PlayerRemoving:Connect(onRemoving)
	RunService.Heartbeat:Connect(onHeartbeat)
end

return TradeService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="95">
        <Properties>
          <string name="Name">TrialService</string>
          <string name="Source"><![CDATA[--!strict
-- The Wardens' trials and the Unpaid Debt quest. TrialRun holds every rule; this service
-- owns the running trials, checks every request itself (who, where, when), watches the
-- clock, the markers and creature defeats, and pays out through Payout.
-- A client only ever says "I accept trial X": distance, progress, time and rewards are the
-- server's. No yielding call sits between reading a run or record and writing it back.
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Ledger = require(ReplicatedStorage.Shared.Rules.Ledger)
local Net = require(ReplicatedStorage.Shared.Net)
local RateLimiter = require(ReplicatedStorage.Shared.Rules.RateLimiter)
local Rounds = require(ReplicatedStorage.Shared.Rules.Rounds)
local TrialRun = require(ReplicatedStorage.Shared.Rules.TrialRun)
local TrialView = require(ReplicatedStorage.Shared.Rules.TrialView)
local Trials = require(ReplicatedStorage.Shared.Catalog.Trials)
local Types = require(ReplicatedStorage.Shared.Types)
local World = require(ReplicatedStorage.Shared.Catalog.World)
local CreatureService = require(script.Parent.CreatureService)
local DataService = require(script.Parent.DataService)
local Fighters = require(script.Parent.Fighters)
local LedgerService = require(script.Parent.LedgerService)
local Payout = require(script.Parent.Payout)
local SourceService = require(script.Parent.SourceService)

type Active = {
	run: TrialRun.Run,
	parcel: Instance?,
	championId: number?,
	died: RBXScriptConnection?,
}

local BUCKET_CAPACITY = 10
local BUCKET_REFILL_PER_SECOND = 5
local TICK_SECONDS = 0.1
local WARDEN_TAG = "Warden"
local ROOT_LIFT = 3 -- a standing character's root above the ground
local COLOSSUS = "brine_colossus"
local QUEST_COLOSSUS = "colossus"
local PARCEL_COLOR = Color3.fromRGB(140, 100, 60)

local TrialService = {}

local runs: { [Player]: Active } = {}
local buckets: { [Player]: RateLimiter.Bucket } = {}
local offerRemote: RemoteEvent
local syncRemote: RemoteEvent
local accumulated = 0
-- Run timers and trial cooldowns. Replaced by the play test to skip time.
local clock: () -> number = os.clock
local realClock: () -> number = os.time

local function allowed(player: Player): boolean
	local now = os.clock()
	local bucket = buckets[player]
	if bucket == nil then
		bucket = RateLimiter.new(BUCKET_CAPACITY, now)
		buckets[player] = bucket
	end
	return RateLimiter.allow(bucket, now, BUCKET_CAPACITY, BUCKET_REFILL_PER_SECOND)
end

-- Free slots the player can still fill: none while their Ledger is locked.
local function room(player: Player, data: Types.PlayerData): number
	if LedgerService.isLocked(player) then
		return 0
	end
	return math.max(0, Ledger.FREE_SLOTS - #data.ledger.free)
end

local function sync(player: Player)
	if player.Parent ~= Players then
		return
	end
	local data = DataService.get(player)
	if data == nil then
		return
	end
	local active = runs[player]
	local state: TrialView.HudState? = nil
	if active ~= nil then
		state = {
			trialId = active.run.trialId,
			progress = active.run.progress,
			goal = active.run.goal,
			secondsLeft = active.run.endsAt - clock(),
		}
	end
	syncRemote:FireClient(player, state, data.trials.questStep, data.rounds)
end

-- A quest step: a passed trial's id, or "colossus". Only the next step counts.
local function questEvent(player: Player, data: Types.PlayerData, event: string)
	local step, completed = TrialRun.advanceQuest(data.trials.questStep, event)
	if step == data.trials.questStep and not completed then
		return
	end
	data.trials = { cooldowns = data.trials.cooldowns, questStep = step }
	local quest = Trials.quest
	if completed then
		LedgerService.notify(player, "QUEST_COMPLETE", { coin = tostring(quest.coin) })
		Payout.give(player, {
			coin = quest.coin,
			xp = quest.xp,
			path = Payout.calling(player),
			relics = { quest.relicId },
		})
	else
		LedgerService.notify(player, "QUEST_STEP", { n = tostring(step) })
	end
end

-- A round step: a passed trial's id for the Warden's Round, a creature kind for the Beast
-- Tally. Each step counts once; the last one pays the round out through Payout.
local function roundEvent(player: Player, data: Types.PlayerData, roundId: string, stepId: string)
	local record, code = Rounds.advance(data.rounds, roundId, stepId)
	if code == "" then
		return
	end
	data.rounds = record
	local round = Trials.roundById[roundId]
	if round == nil then
		return
	end
	if code == "ROUND_STEP" then
		LedgerService.notify(player, code, {
			name = round.name,
			n = tostring(#record[roundId]),
			total = tostring(#round.steps),
		})
	elseif code == "ROUND_COMPLETE" then
		LedgerService.notify(player, code, { name = round.name, coin = tostring(round.coin) })
		Payout.give(player, {
			coin = round.coin,
			xp = round.xp,
			path = Payout.calling(player),
			relics = { round.relicId },
		})
	end
end

-- The one way a trial ends: pass, timeout, defeat or leaving. Clears the run with its parcel
-- and champion, starts the cooldown, pays a pass, and tells the player. `failCode` is the
-- message for a failure; nil says nothing (the player is leaving).
local function endRun(player: Player, passed: boolean, failCode: string?)
	local active = runs[player]
	if active == nil then
		return
	end
	runs[player] = nil
	if active.died ~= nil then
		active.died:Disconnect()
	end
	if active.parcel ~= nil then
		active.parcel:Destroy()
	end
	if active.championId ~= nil then
		CreatureService.despawn(active.championId)
	end

	local trial = Trials.byId[active.run.trialId]
	local data = DataService.get(player)
	if data ~= nil then
		data.trials = TrialRun.finish(data.trials, active.run.trialId, passed, realClock())
	end
	if trial == nil then
		return
	end
	if passed and data ~= nil then
		LedgerService.notify(
			player,
			"TRIAL_PASSED",
			{ name = trial.name, coin = tostring(trial.coin) }
		)
		-- Coin and XP are paid even when the Relic is sealed or there is no room for it.
		Payout.give(player, {
			coin = trial.coin,
			xp = trial.xp,
			path = Payout.calling(player),
			relics = { trial.relicId },
		})
		questEvent(player, data, trial.id)
		roundEvent(player, data, "wardens", trial.id)
	elseif failCode ~= nil then
		LedgerService.notify(player, failCode, { name = trial.name })
	end
	sync(player)
end

local function giveParcel(root: BasePart): Instance
	local parcel = Instance.new("Part")
	parcel.Name = "Parcel"
	parcel.Size = Vector3.new(1.5, 1.2, 1.5)
	parcel.Color = PARCEL_COLOR
	parcel.Material = Enum.Material.Wood
	parcel.Massless = true
	parcel.CanCollide = false
	parcel.CanQuery = false
	parcel.CanTouch = false
	parcel.CFrame = root.CFrame * CFrame.new(0, 0.4, 1.3)
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = root
	weld.Part1 = parcel
	weld.Parent = parcel
	parcel.Parent = root.Parent
	return parcel
end

local function showOffer(player: Player, trialId: string)
	local data = DataService.get(player)
	local trial = Trials.byId[trialId]
	if data == nil then
		LedgerService.notify(player, "DATA_NOT_LOADED")
		return
	end
	if trial == nil then
		return
	end
	local active = runs[player]
	offerRemote:FireClient(
		player,
		TrialView.offer(
			trial.id,
			data.trials,
			if active ~= nil then active.run.trialId else nil,
			realClock(),
			SourceService.held(trial.relicId),
			room(player, data)
		)
	)
end

-- The client names a trial; everything else is checked here, in order: data, a known trial,
-- standing by its Warden, no trial running, no cooldown. Nothing starts on a refusal.
local function handleAccept(player: Player, rawId: any)
	if player.Parent ~= Players or not allowed(player) then
		return
	end
	local data = DataService.get(player)
	if data == nil then
		LedgerService.notify(player, "DATA_NOT_LOADED")
		return
	end
	local trial = if type(rawId) == "string" then Trials.byId[rawId] else nil
	if trial == nil then
		LedgerService.notify(player, "BAD_REQUEST")
		return
	end
	local humanoid, root = Fighters.body(player.UserId)
	local warden = World.wardens[trial.id]
	if humanoid == nil or root == nil or warden == nil then
		LedgerService.notify(player, "TOO_FAR")
		return
	end
	local distance = (root.Position - Vector3.new(warden.x, warden.y + ROOT_LIFT, warden.z)).Magnitude
	-- Written positively so a NaN distance is refused.
	if not (distance <= TrialRun.WARDEN_REACH) then
		LedgerService.notify(player, "TOO_FAR")
		return
	end

	local current = runs[player]
	local run, code = TrialRun.start(
		data.trials,
		if current ~= nil then current.run else nil,
		trial.id,
		clock(),
		realClock()
	)
	if run == nil then
		if code == "TRIAL_COOLDOWN" then
			local left = TrialRun.cooldownLeft(data.trials, trial.id, realClock())
			LedgerService.notify(
				player,
				code,
				{ name = trial.name, seconds = tostring(math.ceil(left)) }
			)
		else
			LedgerService.notify(player, code)
		end
		return
	end

	local active: Active = { run = run }
	runs[player] = active
	if trial.kind == "delivery" then
		active.parcel = giveParcel(root)
	elseif trial.kind == "duel" then
		active.championId = CreatureService.spawnChampion(player, World.duelArena)
	end
	-- Any defeat during a trial fails it.
	active.died = humanoid.Died:Connect(function()
		if runs[player] == active then
			endRun(player, false, "TRIAL_FAILED_DEFEAT")
		end
	end)
	LedgerService.notify(player, "TRIAL_STARTED", { name = trial.name })
	sync(player)
end

local function tickRun(player: Player, active: Active)
	local run = active.run
	if TrialRun.isExpired(run, clock()) then
		endRun(player, false, "TRIAL_FAILED_TIME")
		return
	end
	local trial = Trials.byId[run.trialId]
	local _, root = Fighters.body(player.UserId)
	if trial == nil or root == nil then
		return
	end
	if trial.kind == "course" then
		local markers = World.courses[trial.id]
		local marker = if markers ~= nil then markers[run.progress + 1] else nil
		if marker ~= nil then
			local gap = (root.Position - Vector3.new(marker.x, marker.y, marker.z)).Magnitude
			if gap <= TrialRun.MARKER_RADIUS then
				active.run = TrialRun.reachMarker(run, run.progress + 1)
				LedgerService.notify(player, "MARKER_REACHED", {
					n = tostring(active.run.progress),
					total = tostring(active.run.goal),
				})
				sync(player)
			end
		end
	elseif trial.kind == "delivery" then
		local harbour = World.harbour
		local gap = (root.Position - Vector3.new(harbour.x, harbour.y + ROOT_LIFT, harbour.z)).Magnitude
		if gap <= TrialRun.DELIVERY_RADIUS then
			active.run = TrialRun.complete(run)
		end
	end
	if TrialRun.isPassed(active.run) then
		endRun(player, true, nil)
	end
end

local function onHeartbeat(deltaTime: number)
	accumulated += deltaTime
	if accumulated < TICK_SECONDS then
		return
	end
	accumulated = 0
	-- A copy: a trial ending mid-tick must not change the table under us.
	for player, active in table.clone(runs) do
		if runs[player] ~= active then
			continue
		end
		local ok, err = pcall(tickRun, player, active)
		if not ok then
			warn(`[IsleOfAvarice] TrialService tick failed: {err}`)
		end
	end
end

-- Hunts count a creature the player helped defeat; a duel ends when the duellist's champion
-- falls; the Brine Colossus is the quest's last step for everyone who helped.
local function onCreatureDefeated(
	kind: string,
	id: number,
	contributors: { Player },
	owner: Player?
)
	for _, player in contributors do
		local active = runs[player]
		if active ~= nil then
			local counted = TrialRun.countDefeat(active.run, kind)
			if counted.progress ~= active.run.progress then
				active.run = counted
				LedgerService.notify(player, "HUNT_PROGRESS", {
					n = tostring(counted.progress),
					total = tostring(counted.goal),
				})
				if TrialRun.isPassed(counted) then
					endRun(player, true, nil)
				else
					sync(player)
				end
			end
		end
	end
	if owner ~= nil then
		local active = runs[owner]
		if active ~= nil and active.championId == id then
			-- It is already gone: nothing left to despawn.
			active.championId = nil
			active.run = TrialRun.complete(active.run)
			if TrialRun.isPassed(active.run) then
				endRun(owner, true, nil)
			end
		end
	end
	for _, player in contributors do
		local data = DataService.get(player)
		if data ~= nil then
			if kind == COLOSSUS then
				questEvent(player, data, QUEST_COLOSSUS)
			end
			roundEvent(player, data, "beasts", kind)
			sync(player)
		end
	end
end

local function connectWarden(instance: Instance)
	local trialId = instance:GetAttribute("TrialId")
	local prompt = instance:FindFirstChildOfClass("ProximityPrompt")
	if type(trialId) ~= "string" or prompt == nil then
		return
	end
	prompt.Triggered:Connect(function(player: Player)
		showOffer(player, trialId)
	end)
end

-- Sends the player their TrialSync now (used after a Renounce restarts the quest).
function TrialService.resync(player: Player)
	sync(player)
end

-- Play-test seam: the player's running trial, if any.
function TrialService.run(player: Player): TrialRun.Run?
	local active = runs[player]
	return if active ~= nil then active.run else nil
end

-- Play-test seam: the clocks for run timers (default os.clock) and cooldowns (os.time).
function TrialService.setClocks(runClock: () -> number, cooldownClock: () -> number)
	clock = runClock
	realClock = cooldownClock
end

function TrialService.start()
	offerRemote = LedgerService.makeRemote(Net.TrialOffer)
	syncRemote = LedgerService.makeRemote(Net.TrialSync)
	LedgerService.makeRemote(Net.TrialAccept).OnServerEvent:Connect(handleAccept)

	for _, instance in CollectionService:GetTagged(WARDEN_TAG) do
		connectWarden(instance)
	end
	CollectionService:GetInstanceAddedSignal(WARDEN_TAG):Connect(connectWarden)

	CreatureService.onDefeated(onCreatureDefeated)
	DataService.onLoaded(function(player)
		sync(player)
	end)
	-- Leaving fails the trial quietly, so its cooldown is saved before the profile closes.
	DataService.beforeRelease(function(player)
		endRun(player, false, nil)
	end)
	Players.PlayerRemoving:Connect(function(player)
		buckets[player] = nil
	end)
	RunService.Heartbeat:Connect(onHeartbeat)
end

return TrialService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="96">
        <Properties>
          <string name="Name">VaultService</string>
          <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Protection = require(ReplicatedStorage.Shared.Rules.Protection)
local RateLimiter = require(ReplicatedStorage.Shared.Rules.RateLimiter)
local Vault = require(ReplicatedStorage.Shared.Rules.Vault)
local Net = require(ReplicatedStorage.Shared.Net)
local Relics = require(ReplicatedStorage.Shared.Catalog.Relics)
local LedgerService = require(script.Parent.LedgerService)

local BUCKET_CAPACITY = 10
local BUCKET_REFILL_PER_SECOND = 5

local VaultService = {}

local buckets: { [Player]: RateLimiter.Bucket } = {}

-- True if the player has a token left in their rate-limit bucket (takes one).
local function allowed(player: Player): boolean
	local now = os.clock()
	local bucket = buckets[player]
	if bucket == nil then
		bucket = RateLimiter.new(BUCKET_CAPACITY, now)
		buckets[player] = bucket
	end
	return RateLimiter.allow(bucket, now, BUCKET_CAPACITY, BUCKET_REFILL_PER_SECOND)
end

-- The server reads the position itself. No character counts as outside the safe zone.
local function playerInSafeZone(player: Player): boolean
	local character = player.Character
	local root = if character ~= nil then character:FindFirstChild("HumanoidRootPart") else nil
	if root == nil or not root:IsA("BasePart") then
		return false
	end
	local p = root.Position
	return Protection.inSafeZone({ x = p.X, y = p.Y, z = p.Z })
end

local function handleAction(player: Player, request: any)
	if player.Parent ~= Players then
		return
	end
	if not allowed(player) then
		return
	end

	-- No yielding call from here to setVault(): the reads cannot go stale.
	local newVault, code, cardId = Vault.apply(
		LedgerService.getVault(player),
		LedgerService.get(player),
		request,
		playerInSafeZone(player),
		LedgerService.isLocked(player)
	)
	if newVault == nil then
		LedgerService.notify(player, code)
		return
	end
	if not LedgerService.setVault(player, newVault) then
		LedgerService.notify(player, "DATA_NOT_LOADED")
		return
	end
	local relic = if cardId ~= nil then Relics.byId[cardId] else nil
	LedgerService.notify(player, code, { name = if relic ~= nil then relic.name else "" })
end

function VaultService.start()
	local vaultAction = LedgerService.makeRemote(Net.VaultAction)
	vaultAction.OnServerEvent:Connect(handleAction)
	Players.PlayerRemoving:Connect(function(player)
		buckets[player] = nil
	end)
end

return VaultService
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="97">
        <Properties>
          <string name="Name">Vendor</string>
        </Properties>
        <Item class="ModuleScript" referent="98">
          <Properties>
            <string name="Name">ProfileStore</string>
            <string name="Source"><![CDATA[--[[
MAD STUDIO (by loleris)

-[ProfileStore]---------------------------------------

	Periodic DataStore saving solution with session locking
	
	WARNINGS FOR "Profile.Data" VALUES:
	 	! Do not create numeric tables with gaps - attempting to store such tables will result in an error.
		! Do not create mixed tables (some values indexed by number and others by a string key)
			- only numerically indexed  data will be stored.
		! Do not index tables by anything other than numbers and strings.
		! Do not reference Roblox Instances
		! Do not reference userdata (Vector3, Color3, CFrame...) - Serialize userdata before referencing
		! Do not reference functions
		
	Members:
	
		ProfileStore.IsClosing          [bool]
			-- Set to true after a game:BindToClose() trigger
			
		ProfileStore.IsCriticalState    [bool]
			-- Set to true when ProfileStore experiences too many consecutive errors
		
		ProfileStore.OnError            [Signal] (message, store_name, profile_key)
			-- Most ProfileStore errors will be caught and passed to this signal
			
		ProfileStore.OnOverwrite        [Signal] (store_name, profile_key)
			-- Triggered when a DataStore key was likely used to store data that wasn't
			a ProfileStore profile or the ProfileStore structure was invalidly manually
			altered for that DataStore key
			
		ProfileStore.OnCriticalToggle   [Signal] (is_critical)
			-- Triggered when ProfileStore experiences too many consecutive errors
		
		ProfileStore.DataStoreState     [string] ("NotReady", "NoInternet", "NoAccess", "Access")
			-- This value resembles ProfileStore's access to the DataStore; The value starts
			as "NotReady" and will eventually change to one of the other 3 possible values.
	
	Functions:
	
		ProfileStore.New(store_name, template?) --> [ProfileStore]
			store_name   [string] -- DataStore name
			template     [table] or nil -- Profiles will default to given table (hard-copy) when no data was saved previously
			
		ProfileStore.SetConstant(name, value)
			name    [string]
			value   [number]
				
	Members [ProfileStore]:
	
		ProfileStore.Mock   [ProfileStore]
			-- Reflection of ProfileStore methods, but the methods will now query a mock
			DataStore with no relation to the real DataStore
			
		ProfileStore.Name   [string]
		
	Methods [ProfileStore]:
	
		ProfileStore:StartSessionAsync(profile_key, params?) --> [Profile] or nil
			profile_key [string] -- DataStore key
			params      nil or [table]: -- Custom params; E.g. {Steal = true}
				{
					Steal = true, -- Pass this to disregard an existing session lock
					Cancel = fn() -> (boolean), -- Pass this to create a request cancel condition.
						-- If the cancel function returns true, ProfileStore will stop trying to
						-- start the session and return nil
				}
			
		ProfileStore:MessageAsync(profile_key, message) --> is_success [bool]
			profile_key [string] -- DataStore key
			message     [table] -- Data to be messaged to the profile
			
		ProfileStore:GetAsync(profile_key, version?) --> [Profile] or nil
			-- Reads a profile without starting a session - will not autosave
			profile_key   [string] -- DataStore key
			version       nil or [string] -- DataStore key version

		ProfileStore:VersionQuery(profile_key, sort_direction?, min_date?, max_date?) --> [VersionQuery]
			profile_key      [string]
			sort_direction   nil or [Enum.SortDirection]
			min_date         nil or [DateTime]
			max_date         nil or [DateTime]
			
		ProfileStore:RemoveAsync(profile_key) --> is_success [bool]
			-- Completely removes profile data from the DataStore / mock DataStore with no way to recover it.

	Methods [VersionQuery]:

		VersionQuery:NextAsync() --> [Profile] or nil -- (Yields)
			-- Returned profile is similar to profiles returned by ProfileStore:GetAsync()
		
	Members [Profile]:
	
		Profile.Data               [table]
			-- When the profile is active changes to this table are guaranteed to be saved
		Profile.LastSavedData      [table] (Read-only)
			-- Last snapshot of "Profile.Data" that has been successfully saved to the DataStore;
			Useful for proper developer product purchase receipt handling
		
		Profile.FirstSessionTime   [number] (Read-only)
			-- os.time() timestamp of the first profile session
			
		Profile.SessionLoadCount   [number] (Read-only) -- Amount of times a session was started for this profile
			
		Profile.Session            [table] (Read-only) {PlaceId = number, JobId = string} / nil
			-- Set to a table if this profile is in use by a server; nil if released

		Profile.RobloxMetaData     [table] -- Writable table that gets saved automatically and once the profile is released
		Profile.UserIds            [table] -- (Read-only) -- {user_id [number], ...} -- User ids associated with this profile

		Profile.KeyInfo            [DataStoreKeyInfo] -- Changes before OnAfterSave signal
		
		Profile.OnSave             [Signal] ()
			-- Triggered right before changes to Profile.Data are saved to the DataStore
			
		Profile.OnLastSave         [Signal] (reason [string]: "Manual", "External", "Shutdown")
			-- Triggered right before changes to Profile.Data are saved to the DataStore
			for the last time; A reason is provided for the last save:
				- "Manual"   - Profile:EndSession() was called
				- "Shutdown" - The server that has ownership of this profile is shutting down
				- "External" - Another server has started a session for this profile
			Note that this event will not trigger for when a profile session is ended by
			another server trying to take ownership of the session - this is impossible to
			do without compromising on ProfileStore's speed.
			
		Profile.OnSessionEnd       [Signal] ()
			-- Triggered when the profile session is terminated on this server
		
		Profile.OnAfterSave        [Signal] (last_saved_data)
			-- Triggered after a successful save
			last_saved_data [table] -- Profile.LastSavedData
			
		Profile.ProfileStore       [ProfileStore] -- ProfileStore object this profile belongs to
		Profile.Key                [string] -- DataStore key
		
	Methods [Profile]:
	
		Profile:IsActive() --> [bool] -- If "true" is returned, changes to Profile.Data are guaranteed to save;
			This guarantee is only valid until code yields (e.g. task.wait() is used).
			
		Profile:Reconcile() -- Fills in missing (nil) [string_key] = [value] pairs to the Profile.Data structure
			from the "template" argument that was passed to "ProfileStore.New()"
			
		Profile:EndSession() -- Call after the server has finished working with this profile
			e.g., after the player leaves (Profile object will become inactive)

		Profile:AddUserId(user_id) -- Associates user_id with profile (GDPR compliance)
			user_id   [number]

		Profile:RemoveUserId(user_id) -- Unassociates user_id with profile (safe function)
			user_id   [number]
			
		Profile:MessageHandler(fn) -- Sets a message handler for this profile
			fn [function] (message [table], processed [function]())
			-- The handler function receives a message table and a callback function;
			The callback function is to be called when a message has been processed
			- this will discard the message from the profile message cache; If the
			callback function is not called, other message handlers will also be triggered
			with unprocessed message data.
			
		Profile:Save() -- If the profile session is still active makes an UpdateAsync call
			to the DataStore to immediately save profile data

		Profile:SetAsync() -- Forcefully saves changes to the profile; Only for profiles
			loaded with ProfileStore:GetAsync() or ProfileStore:VersionQuery()
		
--]]

local AUTO_SAVE_PERIOD = 300 -- (Seconds) Time between when changes to a profile are saved to the DataStore
local LOAD_REPEAT_PERIOD = 10 -- (Seconds) Time between successive profile reads when handling a session conflict
local FIRST_LOAD_REPEAT = 5 -- (Seconds) Time between first and second profile read when handling a session conflict
local SESSION_STEAL = 40 -- (Seconds) Time until a session conflict is resolved with the waiting server stealing the session
local ASSUME_DEAD = 630 -- (Seconds) If a profile hasn't had updates for this long, quickly assume an active session belongs to a crashed server
local START_SESSION_TIMEOUT = 120 -- (Seconds) If a session can't be started for a profile for this long, stop repeating calls to the DataStore

local CRITICAL_STATE_ERROR_COUNT = 5 -- Assume critical state if this many issues happen in a short amount of time
local CRITICAL_STATE_ERROR_EXPIRE = 120 -- (Seconds) Individual issue expiration
local CRITICAL_STATE_EXPIRE = 120 -- (Seconds) Critical state expiration

local MAX_MESSAGE_QUEUE = 1000 -- Max messages saved in a profile that were sent using "ProfileStore:MessageAsync()"

----- Dependencies -----

-- local Util = require(game.ReplicatedStorage.Shared.Util)
-- local Signal = Util.Signal

local Signal
do
	local FreeRunnerThread

	--[[
		Yield-safe coroutine reusing by stravant;
		Sources:
		https://devforum.roblox.com/t/lua-signal-class-comparison-optimal-goodsignal-class/1387063
		https://gist.github.com/stravant/b75a322e0919d60dde8a0316d1f09d2f
	--]]

	local function AcquireRunnerThreadAndCallEventHandler(fn, ...)
		local acquired_runner_thread = FreeRunnerThread
		FreeRunnerThread = nil
		fn(...)
		-- The handler finished running, this runner thread is free again.
		FreeRunnerThread = acquired_runner_thread
	end

	local function RunEventHandlerInFreeThread(...)
		AcquireRunnerThreadAndCallEventHandler(...)
		while true do
			AcquireRunnerThreadAndCallEventHandler(coroutine.yield())
		end
	end

	local Connection = {}
	Connection.__index = Connection

	local SignalClass = {}
	SignalClass.__index = SignalClass

	function Connection:Disconnect()
		if self.is_connected == false then
			return
		end

		local signal = self.signal
		self.is_connected = false
		signal.listener_count -= 1

		if signal.head == self then
			signal.head = self.next
		else
			local prev = signal.head
			while prev ~= nil and prev.next ~= self do
				prev = prev.next
			end
			if prev ~= nil then
				prev.next = self.next
			end
		end
	end

	function SignalClass.New()
		local self = {
			head = nil,
			listener_count = 0,
		}
		setmetatable(self, SignalClass)

		return self
	end

	function SignalClass:Connect(listener: (...any) -> ())
		if type(listener) ~= "function" then
			error(`[{script.Name}]: \"listener\" must be a function; Received {typeof(listener)}`)
		end

		local connection = {
			listener = listener,
			signal = self,
			next = self.head,
			is_connected = true,
		}
		setmetatable(connection, Connection)

		self.head = connection
		self.listener_count += 1

		return connection
	end

	function SignalClass:GetListenerCount(): number
		return self.listener_count
	end

	function SignalClass:Fire(...)
		local item = self.head
		while item ~= nil do
			if item.is_connected == true then
				if not FreeRunnerThread then
					FreeRunnerThread = coroutine.create(RunEventHandlerInFreeThread)
				end
				task.spawn(FreeRunnerThread, item.listener, ...)
			end
			item = item.next
		end
	end

	function SignalClass:Wait()
		local co = coroutine.running()
		local connection
		connection = self:Connect(function(...)
			connection:Disconnect()
			task.spawn(co, ...)
		end)
		return coroutine.yield()
	end

	Signal = table.freeze({
		New = SignalClass.New,
	})
end

----- Private -----

local ActiveSessionCheck = {} -- {[session_token] = profile, ...}
local AutoSaveList = {} -- {profile, ...} -- Loaded profile table which will be circularly auto-saved
local IssueQueue = {} -- {issue_time, ...}

local DataStoreService = game:GetService("DataStoreService")
local MessagingService = game:GetService("MessagingService")
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")

local PlaceId = game.PlaceId
local JobId = game.JobId

local AutoSaveIndex = 1 -- Next profile to auto save
local LastAutoSave = os.clock()

local LoadIndex = 0

local ActiveProfileLoadJobs = 0 -- Number of active threads that are loading in profiles
local ActiveProfileSaveJobs = 0 -- Number of active threads that are saving profiles

local CriticalStateStart = 0 -- os.clock()

local IsStudio = RunService:IsStudio()
local DataStoreState: "NotReady" | "NoInternet" | "NoAccess" | "Access" = "NotReady"

local MockStore = {}
local UserMockStore = {}
local MockFlag = false

local OnError = Signal.New() -- (message, store_name, profile_key)
local OnOverwrite = Signal.New() -- (store_name, profile_key)

local UpdateQueue =
	{ -- For stability sake, we won't do UpdateAsync calls for the same key until all previous calls finish
		--[[
		[session_token] = {
			coroutine, ...
		},
		...
	--]]
	}

local function WaitInUpdateQueue(session_token) --> next_in_queue()
	local is_first = false

	if UpdateQueue[session_token] == nil then
		is_first = true
		UpdateQueue[session_token] = {}
	end

	local queue = UpdateQueue[session_token]

	if is_first == false then
		table.insert(queue, coroutine.running())
		coroutine.yield()
	end

	return function()
		local next_co = table.remove(queue, 1)
		if next_co ~= nil then
			coroutine.resume(next_co)
		else
			UpdateQueue[session_token] = nil
		end
	end
end

local function SessionToken(store_name, profile_key, is_mock)
	local session_token = "L_" -- Live

	if is_mock == true then
		session_token = "U_" -- User mock
	elseif DataStoreState ~= "Access" then
		session_token = "M_" -- Mock, cause no DataStore access
	end

	session_token ..= store_name .. "\0" .. profile_key

	return session_token
end

local function DeepCopyTable(t)
	local copy = {}
	for key, value in pairs(t) do
		if type(value) == "table" then
			copy[key] = DeepCopyTable(value)
		else
			copy[key] = value
		end
	end
	return copy
end

local function ReconcileTable(target, template)
	for k, v in pairs(template) do
		if type(k) == "string" then -- Only string keys will be reconciled
			if target[k] == nil then
				if type(v) == "table" then
					target[k] = DeepCopyTable(v)
				else
					target[k] = v
				end
			elseif type(target[k]) == "table" and type(v) == "table" then
				ReconcileTable(target[k], v)
			end
		end
	end
end

local function RegisterError(error_message, store_name, profile_key) -- Called when a DataStore API call errors
	warn(`[{script.Name}]: DataStore API error (STORE:{store_name}; KEY:{profile_key}) - {tostring(error_message)}`)
	table.insert(IssueQueue, os.clock()) -- Adding issue time to queue
	OnError:Fire(tostring(error_message), store_name, profile_key)
end

local function RegisterOverwrite(store_name, profile_key) -- Called when a corrupted profile is loaded
	warn(`[{script.Name}]: Invalid profile was overwritten (STORE:{store_name}; KEY:{profile_key})`)
	OnOverwrite:Fire(store_name, profile_key)
end

local function NewMockDataStoreKeyInfo(params)
	local version_id_string = tostring(params.VersionId or 0)
	local meta_data = params.MetaData or {}
	local user_ids = params.UserIds or {}

	return {
		CreatedTime = params.CreatedTime,
		UpdatedTime = params.UpdatedTime,
		Version = string.rep("0", 16)
			.. "."
			.. string.rep("0", 10 - string.len(version_id_string))
			.. version_id_string
			.. "."
			.. string.rep("0", 16)
			.. "."
			.. "01",

		GetMetadata = function()
			return DeepCopyTable(meta_data)
		end,

		GetUserIds = function()
			return DeepCopyTable(user_ids)
		end,
	}
end

local function MockUpdateAsync(mock_data_store, profile_store_name, key, transform_function, is_get_call) --> loaded_data, key_info
	local profile_store = mock_data_store[profile_store_name]

	if profile_store == nil then
		profile_store = {}
		mock_data_store[profile_store_name] = profile_store
	end

	local epoch_time = math.floor(os.time() * 1000)
	local mock_entry = profile_store[key]
	local mock_entry_was_nil = false

	if mock_entry == nil then
		mock_entry_was_nil = true
		if is_get_call ~= true then
			mock_entry = {
				Data = nil,
				CreatedTime = epoch_time,
				UpdatedTime = epoch_time,
				VersionId = 0,
				UserIds = {},
				MetaData = {},
			}
			profile_store[key] = mock_entry
		end
	end

	local mock_key_info = mock_entry_was_nil == false and NewMockDataStoreKeyInfo(mock_entry) or nil

	local transform, user_ids, roblox_meta_data = transform_function(mock_entry and mock_entry.Data, mock_key_info)

	if transform == nil then
		return nil
	else
		if mock_entry ~= nil and is_get_call ~= true then
			mock_entry.Data = DeepCopyTable(transform)
			mock_entry.UserIds = DeepCopyTable(user_ids or {})
			mock_entry.MetaData = DeepCopyTable(roblox_meta_data or {})
			mock_entry.VersionId += 1
			mock_entry.UpdatedTime = epoch_time
		end

		return DeepCopyTable(transform), mock_entry ~= nil and NewMockDataStoreKeyInfo(mock_entry) or nil
	end
end

local function UpdateAsync(profile_store, profile_key, transform_params, is_user_mock, is_get_call, version) --> loaded_data, key_info
	--transform_params = {
	--	ExistingProfileHandle = function(latest_data),
	--	MissingProfileHandle = function(latest_data),
	--	EditProfile = function(lastest_data),
	--}

	local loaded_data, key_info

	local next_in_queue = WaitInUpdateQueue(SessionToken(profile_store.Name, profile_key, is_user_mock))

	local success = true

	local success, error_message = pcall(function()
		local transform_function = function(latest_data)
			local missing_profile = false
			local overwritten = false
			local global_updates = { 0, {} }

			if latest_data == nil then
				missing_profile = true
			elseif type(latest_data) ~= "table" then
				missing_profile = true
				overwritten = true
			else
				if
					type(latest_data.Data) == "table"
					and type(latest_data.MetaData) == "table"
					and type(latest_data.GlobalUpdates) == "table"
				then
					-- Regular profile structure detected:

					latest_data.WasOverwritten = false -- Must be set to false if set previously
					global_updates = latest_data.GlobalUpdates

					if transform_params.ExistingProfileHandle ~= nil then
						transform_params.ExistingProfileHandle(latest_data)
					end
				elseif
					latest_data.Data == nil
					and latest_data.MetaData == nil
					and type(latest_data.GlobalUpdates) == "table"
				then
					-- Regular structure not detected, but GlobalUpdate data exists:

					latest_data.WasOverwritten = false -- Must be set to false if set previously
					global_updates = latest_data.GlobalUpdates or global_updates
					missing_profile = true
				else
					missing_profile = true
					overwritten = true
				end
			end

			-- Profile was not created or corrupted and no GlobalUpdate data exists:
			if missing_profile == true then
				latest_data = {
					-- Data = nil,
					-- MetaData = nil,
					GlobalUpdates = global_updates,
				}
				if transform_params.MissingProfileHandle ~= nil then
					transform_params.MissingProfileHandle(latest_data)
				end
			end

			-- Editing profile:
			if transform_params.EditProfile ~= nil then
				transform_params.EditProfile(latest_data)
			end

			-- Invalid data handling (Silently override with empty profile)
			if overwritten == true then
				latest_data.WasOverwritten = true -- Temporary tag that will be removed on first save
			end

			return latest_data, latest_data.UserIds, latest_data.RobloxMetaData
		end

		if is_user_mock == true then -- Used when the profile is accessed through ProfileStore.Mock
			loaded_data, key_info =
				MockUpdateAsync(UserMockStore, profile_store.Name, profile_key, transform_function, is_get_call)
			task.wait() -- Simulate API call yield
		elseif DataStoreState ~= "Access" then -- Used when API access is disabled
			loaded_data, key_info =
				MockUpdateAsync(MockStore, profile_store.Name, profile_key, transform_function, is_get_call)
			task.wait() -- Simulate API call yield
		else
			if is_get_call == true then
				if version ~= nil then
					local success, error_message = pcall(function()
						loaded_data, key_info = profile_store.data_store:GetVersionAsync(profile_key, version)
					end)

					if
						success == false
						and type(error_message) == "string"
						and string.find(error_message, "not valid") ~= nil
					then
						warn(`[{script.Name}]: Passed version argument is not valid; Traceback:\n` .. debug.traceback())
					end
				else
					loaded_data, key_info = profile_store.data_store:GetAsync(profile_key)
				end

				loaded_data = transform_function(loaded_data)
			else
				loaded_data, key_info = profile_store.data_store:UpdateAsync(profile_key, transform_function)
			end
		end
	end)

	next_in_queue()

	if success == true and type(loaded_data) == "table" then
		-- Invalid data handling:
		if loaded_data.WasOverwritten == true and is_get_call ~= true then
			RegisterOverwrite(profile_store.Name, profile_key)
		end
		-- Return loaded_data:
		return loaded_data, key_info
	else
		-- Error handling:
		RegisterError(error_message or "Undefined error", profile_store.Name, profile_key)
		-- Return nothing:
		return nil
	end
end

local function IsThisSession(session_tag)
	return session_tag[1] == PlaceId and session_tag[2] == JobId
end

local function ReadMockFlag(): boolean
	local is_mock = MockFlag
	MockFlag = false
	return is_mock
end

local function WaitForStoreReady(profile_store)
	while profile_store.is_ready == false do
		task.wait()
	end
end

local function AddProfileToAutoSave(profile)
	ActiveSessionCheck[profile.session_token] = profile

	-- Add at AutoSaveIndex and move AutoSaveIndex right:

	table.insert(AutoSaveList, AutoSaveIndex, profile)

	if #AutoSaveList > 1 then
		AutoSaveIndex = AutoSaveIndex + 1
	elseif #AutoSaveList == 1 then
		-- First profile created - make sure it doesn't get immediately auto saved:
		LastAutoSave = os.clock()
	end
end

local function RemoveProfileFromAutoSave(profile)
	ActiveSessionCheck[profile.session_token] = nil

	local auto_save_index = table.find(AutoSaveList, profile)

	if auto_save_index ~= nil then
		table.remove(AutoSaveList, auto_save_index)
		if auto_save_index < AutoSaveIndex then
			AutoSaveIndex = AutoSaveIndex - 1 -- Table contents were moved left before AutoSaveIndex so move AutoSaveIndex left as well
		end
		if AutoSaveList[AutoSaveIndex] == nil then -- AutoSaveIndex was at the end of the AutoSaveList - reset to 1
			AutoSaveIndex = 1
		end
	end
end

local function SaveProfileAsync(profile, is_ending_session, is_overwriting, last_save_reason)
	if type(profile.Data) ~= "table" then
		error(
			`[{script.Name}]: Developer code likely set "Profile.Data" to a non-table value! (STORE:{profile.ProfileStore.Name}; KEY:{profile.Key})`
		)
	end

	profile.OnSave:Fire()
	if is_ending_session == true then
		profile.OnLastSave:Fire(last_save_reason or "Manual")
	end

	if is_ending_session == true and is_overwriting ~= true then
		if profile.roblox_message_subscription ~= nil then
			profile.roblox_message_subscription:Disconnect()
		end
		RemoveProfileFromAutoSave(profile)
		profile.OnSessionEnd:Fire()
	end

	ActiveProfileSaveJobs = ActiveProfileSaveJobs + 1

	-- Compare "SessionLoadCount" when writing to profile to prevent a rare case of repeat last save when the profile is loaded on the same server again

	local repeat_save_flag = true -- Released Profile save calls have to repeat until they succeed
	local exp_backoff = 1

	while repeat_save_flag == true do
		if is_ending_session ~= true then
			repeat_save_flag = false
		end

		local loaded_data, key_info = UpdateAsync(profile.ProfileStore, profile.Key, {
			ExistingProfileHandle = nil,
			MissingProfileHandle = nil,
			EditProfile = function(latest_data)
				-- Check if this session still owns the profile:

				local session_owns_profile = false

				if is_overwriting ~= true then
					local active_session = latest_data.MetaData.ActiveSession
					local session_load_count = latest_data.MetaData.SessionLoadCount

					if type(active_session) == "table" then
						session_owns_profile = IsThisSession(active_session)
							and session_load_count == profile.load_index
					end
				else
					session_owns_profile = true
				end

				-- We may only edit the profile if this server has ownership of the profile:

				if session_owns_profile == true then
					-- Clear processed updates (messages):

					local locked_updates = profile.locked_global_updates -- [index] = true, ...
					local active_updates = latest_data.GlobalUpdates[2]
					-- ProfileService module format: {{update_id, version_id, update_locked, update_data}, ...}
					-- ProfileStore module format: {{update_id, update_data}, ...}

					if next(locked_updates) ~= nil then
						local i = 1
						while i <= #active_updates do
							local update = active_updates[i]
							if locked_updates[update[1]] == true then
								table.remove(active_updates, i)
							else
								i += 1
							end
						end
					end

					-- Save profile data:

					latest_data.Data = profile.Data
					latest_data.RobloxMetaData = profile.RobloxMetaData
					latest_data.UserIds = profile.UserIds

					if is_overwriting ~= true then
						latest_data.MetaData.LastUpdate = os.time()

						if is_ending_session == true then
							latest_data.MetaData.ActiveSession = nil
						end
					else
						latest_data.MetaData.ActiveSession = nil
						latest_data.MetaData.ForceLoadSession = nil
					end
				end
			end,
		}, profile.is_mock)

		if loaded_data ~= nil and key_info ~= nil then
			if is_overwriting == true then
				break
			end

			repeat_save_flag = false

			local active_session = loaded_data.MetaData.ActiveSession
			local session_load_count = loaded_data.MetaData.SessionLoadCount
			local session_owns_profile = false

			if type(active_session) == "table" then
				session_owns_profile = IsThisSession(active_session) and session_load_count == profile.load_index
			end

			local force_load_session = loaded_data.MetaData.ForceLoadSession
			local force_load_pending = false
			if type(force_load_session) == "table" then
				force_load_pending = not IsThisSession(force_load_session)
			end

			local is_active = profile:IsActive()

			-- If another server is trying to start a session for this profile - end the session:

			if force_load_pending == true and session_owns_profile == true then
				if is_active == true then
					SaveProfileAsync(profile, true, false, "External")
				end
				break
			end

			-- Clearing processed update list / Detecting new updates:

			local locked_updates = profile.locked_global_updates -- [index] = true, ...
			local received_updates = profile.received_global_updates -- [index] = true, ...
			local active_updates = loaded_data.GlobalUpdates[2]

			local new_updates = {} -- {}, ...
			local still_pending = {} -- [index] = true, ...

			for _, update in ipairs(active_updates) do
				if locked_updates[update[1]] == true then
					still_pending[update[1]] = true
				elseif received_updates[update[1]] ~= true then
					received_updates[update[1]] = true
					table.insert(new_updates, update)
				end
			end

			for index in pairs(locked_updates) do
				if still_pending[index] ~= true then
					locked_updates[index] = nil
				end
			end

			-- Updating profile values:

			profile.KeyInfo = key_info
			profile.LastSavedData = loaded_data.Data
			profile.global_updates = loaded_data.GlobalUpdates and loaded_data.GlobalUpdates[2] or {}

			if session_owns_profile == true then
				if is_active == true and is_ending_session ~= true then
					-- Processing new global updates (messages):

					for _, update in ipairs(new_updates) do
						local index = update[1]
						local update_data = update[#update] -- Backwards compatibility with ProfileService

						for _, handler in ipairs(profile.message_handlers) do
							local is_processed = false
							local processed_callback = function()
								is_processed = true
								locked_updates[index] = true
							end

							local send_update_data = DeepCopyTable(update_data)

							task.spawn(handler, send_update_data, processed_callback)

							if is_processed == true then
								break
							end
						end
					end
				end
			else
				if profile.roblox_message_subscription ~= nil then
					profile.roblox_message_subscription:Disconnect()
				end

				if is_active == true then
					RemoveProfileFromAutoSave(profile)
					profile.OnSessionEnd:Fire()
				end
			end

			profile.OnAfterSave:Fire(profile.LastSavedData)
		elseif repeat_save_flag == true then
			-- DataStore call likely resulted in an error; Repeat the DataStore call shortly
			task.wait(exp_backoff)
			exp_backoff = math.min(if last_save_reason == "Shutdown" then 8 else 20, exp_backoff * 2)
		end
	end

	ActiveProfileSaveJobs = ActiveProfileSaveJobs - 1
end

----- Public -----

--[[
	Saved profile structure:
	
	{
		Data = {},
		
		MetaData = {
			ProfileCreateTime = 0,
			SessionLoadCount = 0,
			ActiveSession = {place_id, game_job_id, unique_session_id} / nil,
			ForceLoadSession = {place_id, game_job_id} / nil,
			LastUpdate = 0, -- os.time()
			MetaTags = {}, -- Backwards compatibility with ProfileService
		},
		
		RobloxMetaData = {},
		UserIds = {},
		
		GlobalUpdates = {
			update_index,
			{
				{update_index, data}, ...
			},
		},
	}

--]]

export type Profile<T> = {
	Data: T & { [any]: any },
	LastSavedData: T & { [any]: any },
	FirstSessionTime: number,
	SessionLoadCount: number,
	Session: { PlaceId: number, JobId: string }?,
	RobloxMetaData: { [any]: any },
	UserIds: { [any]: any },
	KeyInfo: DataStoreKeyInfo,
	OnSave: { Connect: (self: any, listener: () -> ()) -> { Disconnect: (self: any) -> () } },
	OnLastSave: {
		Connect: (
			self: any,
			listener: (reason: "Manual" | "External" | "Shutdown") -> ()
		) -> { Disconnect: (self: any) -> () },
	},
	OnSessionEnd: { Connect: (self: any, listener: () -> ()) -> { Disconnect: (self: any) -> () } },
	OnAfterSave: {
		Connect: (self: any, listener: (last_saved_data: T & { [any]: any }) -> ()) -> (
			{ Disconnect: (self: any) -> () }
		),
	},
	ProfileStore: { [any]: any },
	Key: string,

	IsActive: (self: any) -> boolean,
	Reconcile: (self: any) -> (),
	EndSession: (self: any) -> (),
	AddUserId: (self: any, user_id: number) -> (),
	RemoveUserId: (self: any, user_id: number) -> (),
	MessageHandler: (self: any, fn: (message: { [any]: any }, processed: () -> ()) -> ()) -> (),
	Save: (self: any) -> (),
	SetAsync: (self: any) -> (),
}

export type VersionQuery<T> = {
	NextAsync: (self: any) -> Profile<T>?,
}

type ProfileStoreStandard<T> = {
	Name: string,
	StartSessionAsync: (self: any, profile_key: string, params: { Steal: boolean? }) -> Profile<T>?,
	MessageAsync: (self: any, profile_key: string, message: { [any]: any }) -> boolean,
	GetAsync: (self: any, profile_key: string, version: string?) -> Profile<T>?,
	VersionQuery: (
		self: any,
		profile_key: string,
		sort_direction: Enum.SortDirection?,
		min_date: DateTime | number | nil,
		max_date: DateTime | number | nil
	) -> VersionQuery<T>,
	RemoveAsync: (self: any, profile_key: string) -> boolean,
}

export type ProfileStore<T> = {
	Mock: ProfileStoreStandard<T>,
} & ProfileStoreStandard<T>

type ConstantName =
	"AUTO_SAVE_PERIOD"
	| "LOAD_REPEAT_PERIOD"
	| "FIRST_LOAD_REPEAT"
	| "SESSION_STEAL"
	| "ASSUME_DEAD"
	| "START_SESSION_TIMEOUT"
	| "CRITICAL_STATE_ERROR_COUNT"
	| "CRITICAL_STATE_ERROR_EXPIRE"
	| "CRITICAL_STATE_EXPIRE"
	| "MAX_MESSAGE_QUEUE"

export type ProfileStoreModule = {
	IsClosing: boolean,
	IsCriticalState: boolean,
	OnError: {
		Connect: (
			self: any,
			listener: (message: string, store_name: string, profile_key: string) -> ()
		) -> { Disconnect: (self: any) -> () },
	},
	OnOverwrite: {
		Connect: (
			self: any,
			listener: (store_name: string, profile_key: string) -> ()
		) -> { Disconnect: (self: any) -> () },
	},
	OnCriticalToggle: { Connect: (
		self: any,
		listener: (is_critical: boolean) -> ()
	) -> { Disconnect: (self: any) -> () } },
	DataStoreState: "NotReady" | "NoInternet" | "NoAccess" | "Access",
	New: <T>(store_name: string, template: T?) -> ProfileStore<T>,
	SetConstant: (name: ConstantName, value: number) -> (),
}

local Profile = {}
Profile.__index = Profile

function Profile.New(raw_data, key_info, profile_store, key, is_mock, session_token)
	local data = raw_data.Data or {}
	local session = raw_data.MetaData and raw_data.MetaData.ActiveSession or nil

	local global_updates = raw_data.GlobalUpdates and raw_data.GlobalUpdates[2] or {}
	local received_global_updates = {}

	for _, update in ipairs(global_updates) do
		received_global_updates[update[1]] = true
	end

	local self = {

		Data = data,
		LastSavedData = DeepCopyTable(data),

		FirstSessionTime = raw_data.MetaData and raw_data.MetaData.ProfileCreateTime or 0,
		SessionLoadCount = raw_data.MetaData and raw_data.MetaData.SessionLoadCount or 0,
		Session = session and { PlaceId = session[1], JobId = session[2] },

		RobloxMetaData = raw_data.RobloxMetaData or {},
		UserIds = raw_data.UserIds or {},
		KeyInfo = key_info,

		OnAfterSave = Signal.New(),
		OnSave = Signal.New(),
		OnLastSave = Signal.New(),
		OnSessionEnd = Signal.New(),

		ProfileStore = profile_store,
		Key = key,

		load_timestamp = os.clock(),
		is_mock = is_mock,
		session_token = session_token or "",
		load_index = raw_data.MetaData and raw_data.MetaData.SessionLoadCount or 0,
		locked_global_updates = {},
		received_global_updates = received_global_updates,
		message_handlers = {},
		global_updates = global_updates,
	}
	setmetatable(self, Profile)

	return self
end

function Profile:IsActive()
	return ActiveSessionCheck[self.session_token] == self
end

function Profile:Reconcile()
	ReconcileTable(self.Data, self.ProfileStore.template)
end

function Profile:EndSession()
	if self:IsActive() == true then
		task.spawn(SaveProfileAsync, self, true, nil, "Manual") -- Call save function in a new thread with release_from_session = true
	end
end

function Profile:AddUserId(user_id) -- Associates user_id with profile (GDPR compliance)
	if type(user_id) ~= "number" or user_id % 1 ~= 0 then
		warn(
			`[{script.Name}]: Invalid UserId argument for :AddUserId() ({tostring(user_id)}); Traceback:\n`
				.. debug.traceback()
		)
		return
	end

	if user_id < 0 and self.is_mock ~= true and DataStoreState == "Access" then
		return -- Avoid giving real Roblox APIs negative UserId's
	end

	if table.find(self.UserIds, user_id) == nil then
		table.insert(self.UserIds, user_id)
	end
end

function Profile:RemoveUserId(user_id) -- Unassociates user_id with profile (safe function)
	if type(user_id) ~= "number" or user_id % 1 ~= 0 then
		warn(
			`[{script.Name}]: Invalid UserId argument for :RemoveUserId() ({tostring(user_id)}); Traceback:\n`
				.. debug.traceback()
		)
		return
	end

	local index = table.find(self.UserIds, user_id)

	if index ~= nil then
		table.remove(self.UserIds, index)
	end
end

function Profile:SetAsync() -- Saves the profile to the DataStore and removes the session lock
	if self.view_mode ~= true then
		error(`[{script.Name}]: :SetAsync() can only be used in view mode`)
	end

	SaveProfileAsync(self, nil, true)
end

function Profile:MessageHandler(fn)
	if type(fn) ~= "function" then
		error(`[{script.Name}]: fn argument is not a function`)
	end

	if self.view_mode ~= true and self:IsActive() ~= true then
		return -- Don't process messages if the profile session was ended
	end

	local locked_updates = self.locked_global_updates
	table.insert(self.message_handlers, fn)

	for _, update in ipairs(self.global_updates) do
		local index = update[1]
		local update_data = update[#update] -- Backwards compatibility with ProfileService

		if locked_updates[index] ~= true then
			local processed_callback = function()
				locked_updates[index] = true
			end

			local send_update_data = DeepCopyTable(update_data)

			task.spawn(fn, send_update_data, processed_callback)
		end
	end
end

function Profile:Save()
	if self.view_mode == true then
		error(`[{script.Name}]: Can't save profile in view mode; Should you be calling :SetAsync() instead?`)
	end

	if self:IsActive() == false then
		warn(
			`[{script.Name}]: Attempted saving an inactive profile (STORE:{self.ProfileStore.Name}; KEY:{self.Key});`
				.. ` Traceback:\n`
				.. debug.traceback()
		)
		return
	end

	-- Move the profile right behind the auto save index to delay the next auto save for it:
	RemoveProfileFromAutoSave(self)
	AddProfileToAutoSave(self)

	-- Perform save in new thread:
	task.spawn(SaveProfileAsync, self)
end

local ProfileStore: ProfileStoreModule = {

	IsClosing = false,
	IsCriticalState = false,
	OnError = OnError, -- (message, store_name, profile_key)
	OnOverwrite = OnOverwrite, -- (store_name, profile_key)
	OnCriticalToggle = Signal.New(), -- (is_critical)
	DataStoreState = "NotReady", -- ("NotReady", "NoInternet", "NoAccess", "Access")
}
ProfileStore.__index = ProfileStore

function ProfileStore.SetConstant(name, value)
	if type(value) ~= "number" then
		error(`[{script.Name}]: Invalid value type`)
	end

	if name == "AUTO_SAVE_PERIOD" then
		AUTO_SAVE_PERIOD = value
	elseif name == "LOAD_REPEAT_PERIOD" then
		LOAD_REPEAT_PERIOD = value
	elseif name == "FIRST_LOAD_REPEAT" then
		FIRST_LOAD_REPEAT = value
	elseif name == "SESSION_STEAL" then
		SESSION_STEAL = value
	elseif name == "ASSUME_DEAD" then
		ASSUME_DEAD = value
	elseif name == "START_SESSION_TIMEOUT" then
		START_SESSION_TIMEOUT = value
	elseif name == "CRITICAL_STATE_ERROR_COUNT" then
		CRITICAL_STATE_ERROR_COUNT = value
	elseif name == "CRITICAL_STATE_ERROR_EXPIRE" then
		CRITICAL_STATE_ERROR_EXPIRE = value
	elseif name == "CRITICAL_STATE_EXPIRE" then
		CRITICAL_STATE_EXPIRE = value
	elseif name == "MAX_MESSAGE_QUEUE" then
		MAX_MESSAGE_QUEUE = value
	else
		error(`[{script.Name}]: Invalid constant name was provided`)
	end
end

function ProfileStore.Test()
	return {
		ActiveSessionCheck = ActiveSessionCheck,
		AutoSaveList = AutoSaveList,
		ActiveProfileLoadJobs = ActiveProfileLoadJobs,
		ActiveProfileSaveJobs = ActiveProfileSaveJobs,
		MockStore = MockStore,
		UserMockStore = UserMockStore,
		UpdateQueue = UpdateQueue,
	}
end

function ProfileStore.New(store_name, template)
	template = template or {}

	if type(store_name) ~= "string" then
		error(`[{script.Name}]: Invalid or missing "store_name"`)
	elseif string.len(store_name) == 0 then
		error(`[{script.Name}]: store_name cannot be an empty string`)
	elseif string.len(store_name) > 50 then
		error(`[{script.Name}]: store_name is too long`)
	end

	if type(template) ~= "table" then
		error(`[{script.Name}]: Invalid template argument`)
	end

	local self
	self = {

		Mock = {

			Name = store_name,

			StartSessionAsync = function(_, profile_key)
				MockFlag = true
				return self:StartSessionAsync(profile_key)
			end,
			MessageAsync = function(_, profile_key, message)
				MockFlag = true
				return self:MessageAsync(profile_key, message)
			end,
			GetAsync = function(_, profile_key, version)
				MockFlag = true
				return self:GetAsync(profile_key, version)
			end,
			VersionQuery = function(_, profile_key, sort_direction, min_date, max_date)
				MockFlag = true
				return self:VersionQuery(profile_key, sort_direction, min_date, max_date)
			end,
			RemoveAsync = function(_, profile_key)
				MockFlag = true
				return self:RemoveAsync(profile_key)
			end,
		},

		Name = store_name,

		template = template,
		data_store = nil,
		load_jobs = {},
		mock_load_jobs = {},
		is_ready = true,
	}
	setmetatable(self, ProfileStore)

	local options = Instance.new("DataStoreOptions")
	options:SetExperimentalFeatures({ v2 = true })

	if DataStoreState == "NotReady" then
		-- The module is not sure whether DataStores are accessible yet:

		self.is_ready = false

		task.spawn(function()
			repeat
				task.wait()
			until DataStoreState ~= "NotReady"

			if DataStoreState == "Access" then
				self.data_store = DataStoreService:GetDataStore(store_name, nil, options)
			end

			self.is_ready = true
		end)
	elseif DataStoreState == "Access" then
		self.data_store = DataStoreService:GetDataStore(store_name, nil, options)
	end

	return self
end

function ProfileStore:StartSessionAsync(profile_key, params)
	local is_mock = ReadMockFlag()

	if type(profile_key) ~= "string" then
		error(`[{script.Name}]: profile_key must be a string`)
	elseif string.len(profile_key) == 0 then
		error(`[{script.Name}]: Invalid profile_key`)
	elseif string.len(profile_key) > 50 then
		error(`[{script.Name}]: profile_key is too long`)
	end

	if params ~= nil and type(params) ~= "table" then
		error(`[{script.Name}]: Invalid params`)
	end

	params = params or {}

	if ProfileStore.IsClosing == true then
		return nil
	end

	WaitForStoreReady(self)

	local session_token = SessionToken(self.Name, profile_key, is_mock)

	if ActiveSessionCheck[session_token] ~= nil then
		error(`[{script.Name}]: Profile (STORE:{self.Name}; KEY:{profile_key}) is already loaded in this session`)
	end

	ActiveProfileLoadJobs = ActiveProfileLoadJobs + 1

	local is_user_cancel = false

	local function cancel_condition()
		if is_user_cancel == false then
			if params.Cancel ~= nil then
				is_user_cancel = params.Cancel() == true
			end
			return is_user_cancel
		end
		return true
	end

	local user_steal = params.Steal == true

	local force_load_steps = 0 -- Session conflict handling values
	local request_force_load = true
	local steal_session = false

	local start = os.clock()
	local exp_backoff = 1

	while ProfileStore.IsClosing == false and cancel_condition() == false do
		-- Load profile:

		-- SPECIAL CASE - If StartSessionAsync is called for the same key again before another StartSessionAsync finishes,
		-- grab the DataStore return for the new call. The early call will return nil. This is supposed to retain
		-- expected and efficient behaviour in cases where a player would quickly rejoin the same server.

		LoadIndex += 1
		local load_id = LoadIndex
		local profile_load_jobs = is_mock == true and self.mock_load_jobs or self.load_jobs
		local profile_load_job = profile_load_jobs[profile_key] -- {load_id, {loaded_data, key_info} or nil}

		local loaded_data, key_info
		local unique_session_id = HttpService:GenerateGUID(false)

		if profile_load_job ~= nil then
			profile_load_job[1] = load_id -- Steal load job
			while profile_load_job[2] == nil do -- Wait for job to finish
				task.wait()
			end
			if profile_load_job[1] == load_id then -- Load job hasn't been double-stolen
				loaded_data, key_info = table.unpack(profile_load_job[2])
				profile_load_jobs[profile_key] = nil
			else
				ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
				return nil
			end
		else
			profile_load_job = { load_id, nil }
			profile_load_jobs[profile_key] = profile_load_job

			profile_load_job[2] = table.pack(UpdateAsync(self, profile_key, {
				ExistingProfileHandle = function(latest_data)
					if ProfileStore.IsClosing == true or cancel_condition() == true then
						return
					end

					local active_session = latest_data.MetaData.ActiveSession
					local force_load_session = latest_data.MetaData.ForceLoadSession

					if active_session == nil then
						latest_data.MetaData.ActiveSession = { PlaceId, JobId, unique_session_id }
						latest_data.MetaData.ForceLoadSession = nil
					elseif type(active_session) == "table" then
						if IsThisSession(active_session) == false then
							local last_update = latest_data.MetaData.LastUpdate
							if last_update ~= nil then
								if os.time() - last_update > ASSUME_DEAD then
									latest_data.MetaData.ActiveSession = { PlaceId, JobId, unique_session_id }
									latest_data.MetaData.ForceLoadSession = nil
									return
								end
							end
							if steal_session == true or user_steal == true then
								local force_load_interrupted = if force_load_session ~= nil
									then not IsThisSession(force_load_session)
									else true
								if force_load_interrupted == false or user_steal == true then
									latest_data.MetaData.ActiveSession = { PlaceId, JobId, unique_session_id }
									latest_data.MetaData.ForceLoadSession = nil
								end
							elseif request_force_load == true then
								latest_data.MetaData.ForceLoadSession = { PlaceId, JobId }
							end
						else
							latest_data.MetaData.ForceLoadSession = nil
						end
					end
				end,
				MissingProfileHandle = function(latest_data)
					local is_cancel = ProfileStore.IsClosing == true or cancel_condition() == true

					latest_data.Data = DeepCopyTable(self.template)
					latest_data.MetaData = {
						ProfileCreateTime = os.time(),
						SessionLoadCount = 0,
						ActiveSession = if is_cancel == false then { PlaceId, JobId, unique_session_id } else nil,
						ForceLoadSession = nil,
						MetaTags = {}, -- Backwards compatibility with ProfileService
					}
				end,
				EditProfile = function(latest_data)
					if ProfileStore.IsClosing == true or cancel_condition() == true then
						return
					end

					local active_session = latest_data.MetaData.ActiveSession
					if active_session ~= nil and IsThisSession(active_session) == true then
						latest_data.MetaData.SessionLoadCount = latest_data.MetaData.SessionLoadCount + 1
						latest_data.MetaData.LastUpdate = os.time()
					end
				end,
			}, is_mock))
			if profile_load_job[1] == load_id then -- Load job hasn't been stolen
				loaded_data, key_info = table.unpack(profile_load_job[2])
				profile_load_jobs[profile_key] = nil
			else
				ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
				return nil -- Load job stolen
			end
		end

		-- Handle load_data:

		if loaded_data ~= nil and key_info ~= nil then
			local active_session = loaded_data.MetaData.ActiveSession
			if type(active_session) == "table" then
				if IsThisSession(active_session) == true then
					-- Profile is now taken by this session:

					local profile = Profile.New(loaded_data, key_info, self, profile_key, is_mock, session_token)
					AddProfileToAutoSave(profile)

					if is_mock ~= true and DataStoreState == "Access" then
						-- Use MessagingService to quickly detect session conflicts and resolve them quickly:

						local last_roblox_message = 0

						profile.roblox_message_subscription = MessagingService:SubscribeAsync(
							"PS_" .. unique_session_id,
							function(message)
								if
									type(message.Data) == "table"
									and message.Data.LoadCount == profile.SessionLoadCount
								then
									-- High reaction rate, based on numPlayers × 10 DataStore budget as of writing
									if os.clock() - last_roblox_message > 6 then
										last_roblox_message = os.clock()
										if profile:IsActive() == true then
											if message.Data.EndSession == true then
												SaveProfileAsync(profile, true, false, "External")
											else
												profile:Save()
											end
										end
									end
								end
							end
						)
					end

					if ProfileStore.IsClosing == true or cancel_condition() == true then
						-- The server has initiated a shutdown by the time this profile was loaded
						SaveProfileAsync(profile, true) -- Release profile and yield until the DataStore call is finished
						profile = nil -- Don't return the profile object
					end

					ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
					return profile
				else
					if ProfileStore.IsClosing == true or cancel_condition() == true then
						ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
						return nil
					end

					-- Profile is taken by some other session:

					local force_load_session = loaded_data.MetaData.ForceLoadSession
					local force_load_interrupted = if force_load_session ~= nil
						then not IsThisSession(force_load_session)
						else true

					if force_load_interrupted == false then
						if request_force_load == false then
							force_load_steps = force_load_steps + 1
							if force_load_steps >= math.ceil(SESSION_STEAL / LOAD_REPEAT_PERIOD) then
								steal_session = true
							end
						end

						-- Request the remote server to end its session:
						if type(active_session[3]) == "string" then
							local session_load_count = loaded_data.MetaData.SessionLoadCount or 0
							MessagingService:PublishAsync(
								"PS_" .. active_session[3],
								{ LoadCount = session_load_count, EndSession = true }
							)
						end

						-- Attempt to load the profile again after a delay
						local wait_until = os.clock()
							+ if request_force_load == true then FIRST_LOAD_REPEAT else LOAD_REPEAT_PERIOD
						repeat
							task.wait()
						until os.clock() >= wait_until or ProfileStore.IsClosing == true
					else
						-- Another session tried to load this profile:
						ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
						return nil
					end

					request_force_load = false -- Only request a force load once
				end
			else
				ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
				return nil -- In this scenario it is likely that this server started shutting down
			end
		else
			-- A DataStore call has likely ended in an error:

			local default_timeout = false

			if params.Cancel == nil then
				default_timeout = os.clock() - start >= START_SESSION_TIMEOUT
			end

			if default_timeout == true or ProfileStore.IsClosing == true or cancel_condition() == true then
				ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
				return nil
			end

			task.wait(exp_backoff) -- Repeat the call shortly
			exp_backoff = math.min(20, exp_backoff * 2)
		end
	end

	ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
	return nil -- Game started shutting down or the request was cancelled - don't return the profile
end

function ProfileStore:MessageAsync(profile_key, message)
	local is_mock = ReadMockFlag()

	if type(profile_key) ~= "string" then
		error(`[{script.Name}]: profile_key must be a string`)
	elseif string.len(profile_key) == 0 then
		error(`[{script.Name}]: Invalid profile_key`)
	elseif string.len(profile_key) > 50 then
		error(`[{script.Name}]: profile_key is too long`)
	end

	if type(message) ~= "table" then
		error(`[{script.Name}]: message must be a table`)
	end

	if ProfileStore.IsClosing == true then
		return false
	end

	WaitForStoreReady(self)

	local exp_backoff = 1

	while ProfileStore.IsClosing == false do
		-- Updating profile:

		local loaded_data = UpdateAsync(self, profile_key, {
			ExistingProfileHandle = nil,
			MissingProfileHandle = nil,
			EditProfile = function(latest_data)
				local global_updates = latest_data.GlobalUpdates
				local update_list = global_updates[2]
				--{
				--	update_index,
				--	{
				--		{update_index, data}, ...
				--	},
				--},

				global_updates[1] += 1
				table.insert(update_list, { global_updates[1], message })

				-- Clearing queue if above limit:

				while #update_list > MAX_MESSAGE_QUEUE do
					table.remove(update_list, 1)
				end
			end,
		}, is_mock)

		if loaded_data ~= nil then
			local session_token = SessionToken(self.Name, profile_key, is_mock)

			local profile = ActiveSessionCheck[session_token]

			if profile ~= nil then
				-- The message was sent to a profile that is active in this server:
				profile:Save()
			else
				local meta_data = loaded_data.MetaData or {}
				local active_session = meta_data.ActiveSession
				local session_load_count = meta_data.SessionLoadCount or 0

				if type(active_session) == "table" and type(active_session[3]) == "string" then
					-- Request the remote server to auto-save sooner and receive the message:
					MessagingService:PublishAsync("PS_" .. active_session[3], { LoadCount = session_load_count })
				end
			end

			return true
		else
			task.wait(exp_backoff) -- A DataStore call has likely ended in an error - repeat the call shortly
			exp_backoff = math.min(20, exp_backoff * 2)
		end
	end

	return false
end

function ProfileStore:GetAsync(profile_key, version)
	local is_mock = ReadMockFlag()

	if type(profile_key) ~= "string" then
		error(`[{script.Name}]: profile_key must be a string`)
	elseif string.len(profile_key) == 0 then
		error(`[{script.Name}]: Invalid profile_key`)
	elseif string.len(profile_key) > 50 then
		error(`[{script.Name}]: profile_key is too long`)
	end

	if ProfileStore.IsClosing == true then
		return nil
	end

	WaitForStoreReady(self)

	if version ~= nil and (is_mock or DataStoreState ~= "Access") then
		return nil -- No version support in mock mode
	end

	local exp_backoff = 1

	while ProfileStore.IsClosing == false do
		-- Load profile:

		local loaded_data, key_info = UpdateAsync(
			self,
			profile_key,
			{
				ExistingProfileHandle = nil,
				MissingProfileHandle = function(latest_data)
					latest_data.Data = DeepCopyTable(self.template)
					latest_data.MetaData = {
						ProfileCreateTime = os.time(),
						SessionLoadCount = 0,
						ActiveSession = nil,
						ForceLoadSession = nil,
						MetaTags = {}, -- Backwards compatibility with ProfileService
					}
				end,
				EditProfile = nil,
			},
			is_mock,
			true, -- Use :GetAsync()
			version -- DataStore key version
		)

		-- Handle load_data:

		if loaded_data ~= nil then
			if key_info == nil then
				return nil -- Load was successful, but the key was empty - return no profile object
			end

			local profile = Profile.New(loaded_data, key_info, self, profile_key, is_mock)
			profile.view_mode = true

			return profile
		else
			task.wait(exp_backoff) -- A DataStore call has likely ended in an error - repeat the call shortly
			exp_backoff = math.min(20, exp_backoff * 2)
		end
	end

	return nil -- Game started shutting down - don't return the profile
end

function ProfileStore:RemoveAsync(profile_key)
	local is_mock = ReadMockFlag()

	if type(profile_key) ~= "string" or string.len(profile_key) == 0 then
		error(`[{script.Name}]: Invalid profile_key`)
	end

	if ProfileStore.IsClosing == true then
		return false
	end

	WaitForStoreReady(self)

	local wipe_status = false

	local next_in_queue = WaitInUpdateQueue(SessionToken(self.Name, profile_key, is_mock))

	if is_mock == true then -- Used when the profile is accessed through ProfileStore.Mock
		local mock_data_store = UserMockStore[self.Name]

		if mock_data_store ~= nil then
			mock_data_store[profile_key] = nil
			if next(mock_data_store) == nil then
				UserMockStore[self.Name] = nil
			end
		end

		wipe_status = true
		task.wait() -- Simulate API call yield
	elseif DataStoreState ~= "Access" then -- Used when API access is disabled
		local mock_data_store = MockStore[self.Name]

		if mock_data_store ~= nil then
			mock_data_store[profile_key] = nil
			if next(mock_data_store) == nil then
				MockStore[self.Name] = nil
			end
		end

		wipe_status = true
		task.wait() -- Simulate API call yield
	else -- Live DataStore
		wipe_status = pcall(function()
			self.data_store:RemoveAsync(profile_key)
		end)
	end

	next_in_queue()

	return wipe_status
end

local ProfileVersionQuery = {}
ProfileVersionQuery.__index = ProfileVersionQuery

function ProfileVersionQuery.New(profile_store, profile_key, sort_direction, min_date, max_date)
	local self = {
		profile_store = profile_store,
		profile_key = profile_key,
		sort_direction = sort_direction,
		min_date = min_date,
		max_date = max_date,

		query_pages = nil,
		query_index = 0,
		query_failure = false,

		is_query_yielded = false,
		query_queue = {},
	}
	setmetatable(self, ProfileVersionQuery)

	return self
end

function MoveVersionQueryQueue(self) -- Hidden ProfileVersionQuery method
	while #self.query_queue > 0 do
		local queue_entry = table.remove(self.query_queue, 1)

		task.spawn(queue_entry)

		if self.is_query_yielded == true then
			break
		end
	end
end

local VersionQueryNextAsyncStackingFlag = false

function ProfileVersionQuery:NextAsync()
	local is_stacking = VersionQueryNextAsyncStackingFlag == true
	VersionQueryNextAsyncStackingFlag = false

	if self.profile_store == nil then
		return nil
	end

	WaitForStoreReady(self.profile_store)

	local profile
	local is_finished = false

	local function query_job()
		if self.query_failure == true then
			is_finished = true
			return
		end

		-- First "next" call loads version pages:

		if self.query_pages == nil then
			self.is_query_yielded = true

			task.spawn(function()
				VersionQueryNextAsyncStackingFlag = true
				profile = self:NextAsync()
				is_finished = true
			end)

			local list_success, error_message = pcall(function()
				self.query_pages = self.profile_store.data_store:ListVersionsAsync(
					self.profile_key,
					self.sort_direction,
					self.min_date,
					self.max_date
				)
				self.query_index = 0
			end)

			if list_success == false or self.query_pages == nil then
				warn(`[{script.Name}]: Version query fail - {tostring(error_message)}`)
				self.query_failure = true
			end

			self.is_query_yielded = false

			MoveVersionQueryQueue(self)

			return
		end

		local current_page = self.query_pages:GetCurrentPage()
		local next_item = current_page[self.query_index + 1]

		-- No more entries:

		if self.query_pages.IsFinished == true and next_item == nil then
			is_finished = true
			return
		end

		-- Load next page when this page is over:

		if next_item == nil then
			self.is_query_yielded = true
			task.spawn(function()
				VersionQueryNextAsyncStackingFlag = true
				profile = self:NextAsync()
				is_finished = true
			end)

			local success, error_message = pcall(function()
				self.query_pages:AdvanceToNextPageAsync()
				self.query_index = 0
			end)

			if success == false or #self.query_pages:GetCurrentPage() == 0 then
				self.query_failure = true
			end

			self.is_query_yielded = false
			MoveVersionQueryQueue(self)

			return
		end

		-- Next page item:

		self.query_index += 1
		profile = self.profile_store:GetAsync(self.profile_key, next_item.Version)
		is_finished = true
	end

	if self.is_query_yielded == false then
		query_job()
	else
		if is_stacking == true then
			table.insert(self.query_queue, 1, query_job)
		else
			table.insert(self.query_queue, query_job)
		end
	end

	while is_finished == false do
		task.wait()
	end

	return profile
end

local WarnAboutVersionQueryOnce = false

function ProfileStore:VersionQuery(profile_key, sort_direction, min_date, max_date)
	local is_mock = ReadMockFlag()

	if type(profile_key) ~= "string" or string.len(profile_key) == 0 then
		error(`[{script.Name}]: Invalid profile_key`)
	end

	if ProfileStore.IsClosing == true then
		return setmetatable({}, ProfileVersionQuery) -- Silently fail :NextAsync() requests
	end

	if is_mock or DataStoreState ~= "Access" then
		if IsStudio == true and WarnAboutVersionQueryOnce == false then
			WarnAboutVersionQueryOnce = true
			warn(`[{script.Name}]: :VersionQuery() is not supported in mock mode!`)
		end
		return setmetatable({}, ProfileVersionQuery) -- Silently fail :NextAsync() requests
	end

	-- Type check:

	if
		sort_direction ~= nil
		and (typeof(sort_direction) ~= "EnumItem" or sort_direction.EnumType ~= Enum.SortDirection)
	then
		error(`[{script.Name}]: Invalid sort_direction ({tostring(sort_direction)})`)
	end

	if min_date ~= nil and typeof(min_date) ~= "DateTime" and typeof(min_date) ~= "number" then
		error(`[{script.Name}]: Invalid min_date ({tostring(min_date)})`)
	end

	if max_date ~= nil and typeof(max_date) ~= "DateTime" and typeof(max_date) ~= "number" then
		error(`[{script.Name}]: Invalid max_date ({tostring(max_date)})`)
	end

	min_date = typeof(min_date) == "DateTime" and min_date.UnixTimestampMillis or min_date
	max_date = typeof(max_date) == "DateTime" and max_date.UnixTimestampMillis or max_date

	return ProfileVersionQuery.New(self, profile_key, sort_direction, min_date, max_date)
end

-- DataStore API access check:

if IsStudio == true then
	task.spawn(function()
		local new_state = "NoAccess"

		local status, message = pcall(function()
			-- This will error if current instance has no Studio API access:
			DataStoreService:GetDataStore("____PS"):SetAsync("____PS", os.time())
		end)

		local no_internet_access = status == false and string.find(message, "ConnectFail", 1, true) ~= nil

		if no_internet_access == true then
			warn(`[{script.Name}]: No internet access - check your network connection`)
		end

		if
			status == false
			and (
				string.find(message, "403", 1, true) ~= nil -- Cannot write to DataStore from studio if API access is not enabled
				or string.find(message, "must publish", 1, true) ~= nil -- Game must be published to access live keys
				or no_internet_access == true
			)
		then -- No internet access
			new_state = if no_internet_access == true then "NoInternet" else "NoAccess"
			print(`[{script.Name}]: Roblox API services unavailable - data will not be saved`)
		else
			new_state = "Access"
			print(`[{script.Name}]: Roblox API services available - data will be saved`)
		end

		DataStoreState = new_state
		ProfileStore.DataStoreState = new_state
	end)
else
	DataStoreState = "Access"
	ProfileStore.DataStoreState = "Access"
end

-- Update loop:

RunService.Heartbeat:Connect(function()
	-- Auto saving:

	local auto_save_list_length = #AutoSaveList
	if auto_save_list_length > 0 then
		local auto_save_index_speed = AUTO_SAVE_PERIOD / auto_save_list_length
		local os_clock = os.clock()
		while os_clock - LastAutoSave > auto_save_index_speed do
			LastAutoSave = LastAutoSave + auto_save_index_speed
			local profile = AutoSaveList[AutoSaveIndex]
			if os_clock - profile.load_timestamp < AUTO_SAVE_PERIOD / 2 then
				-- This profile is freshly loaded - auto saving immediately is not necessary:
				profile = nil
				for _ = 1, auto_save_list_length - 1 do
					-- Move auto save index to the right:
					AutoSaveIndex = AutoSaveIndex + 1
					if AutoSaveIndex > auto_save_list_length then
						AutoSaveIndex = 1
					end
					profile = AutoSaveList[AutoSaveIndex]
					if os_clock - profile.load_timestamp >= AUTO_SAVE_PERIOD / 2 then
						break
					else
						profile = nil
					end
				end
			end
			-- Move auto save index to the right:
			AutoSaveIndex = AutoSaveIndex + 1
			if AutoSaveIndex > auto_save_list_length then
				AutoSaveIndex = 1
			end
			-- Perform save call:
			if profile ~= nil then
				task.spawn(SaveProfileAsync, profile) -- Auto save profile in new thread
			end
		end
	end

	-- Critical state handling:

	if ProfileStore.IsCriticalState == false then
		if #IssueQueue >= CRITICAL_STATE_ERROR_COUNT then
			ProfileStore.IsCriticalState = true
			ProfileStore.OnCriticalToggle:Fire(true)
			CriticalStateStart = os.clock()
			warn(`[{script.Name}]: Entered critical state`)
		end
	else
		if #IssueQueue >= CRITICAL_STATE_ERROR_COUNT then
			CriticalStateStart = os.clock()
		elseif os.clock() - CriticalStateStart > CRITICAL_STATE_EXPIRE then
			ProfileStore.IsCriticalState = false
			ProfileStore.OnCriticalToggle:Fire(false)
			warn(`[{script.Name}]: Critical state ended`)
		end
	end

	-- Issue queue:

	while true do
		local issue_time = IssueQueue[1]
		if issue_time == nil then
			break
		elseif os.clock() - issue_time > CRITICAL_STATE_ERROR_EXPIRE then
			table.remove(IssueQueue, 1)
		else
			break
		end
	end
end)

-- Release all loaded profiles when the server is shutting down:

task.spawn(function()
	while DataStoreState == "NotReady" do
		task.wait()
	end

	if DataStoreState ~= "Access" then
		game:BindToClose(function()
			ProfileStore.IsClosing = true
			task.wait() -- Mock shutdown delay
		end)

		return -- Don't wait for profiles to properly save in mock mode so studio could end the simulation faster
	end

	game:BindToClose(function()
		ProfileStore.IsClosing = true

		-- Release all active profiles:
		-- (Clone AutoSaveList to a new table because AutoSaveList changes when profiles are released)

		local on_close_save_job_count = 0
		local active_profiles = {}
		for index, profile in ipairs(AutoSaveList) do
			active_profiles[index] = profile
		end

		-- Release the profiles; Releasing profiles can trigger listeners that release other profiles, so check active state:
		for _, profile in ipairs(active_profiles) do
			if profile:IsActive() == true then
				on_close_save_job_count = on_close_save_job_count + 1
				task.spawn(function() -- Save profile on new thread
					SaveProfileAsync(profile, true, nil, "Shutdown")
					on_close_save_job_count = on_close_save_job_count - 1
				end)
			end
		end

		-- Yield until all active profile jobs are finished:
		while on_close_save_job_count > 0 or ActiveProfileLoadJobs > 0 or ActiveProfileSaveJobs > 0 do
			task.wait()
		end

		return -- We're done!
	end)
end)

return ProfileStore
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="99">
        <Properties>
          <string name="Name">WorldBuilder</string>
          <string name="Source"><![CDATA[--!strict
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Creatures = require(ReplicatedStorage.Shared.Catalog.Creatures)
local Relics = require(ReplicatedStorage.Shared.Catalog.Relics)
local Tiers = require(ReplicatedStorage.Shared.Catalog.Tiers)
local Trials = require(ReplicatedStorage.Shared.Catalog.Trials)
local Types = require(ReplicatedStorage.Shared.Types)
local World = require(ReplicatedStorage.Shared.Catalog.World)
local SiteBuilder = require(script.Parent.SiteBuilder)
local TerrainBuilder = require(script.Parent.TerrainBuilder)

local WorldBuilder = {}

local STONE = Color3.fromRGB(150, 146, 140)
local ROCK = Color3.fromRGB(110, 110, 112)
local WOOD = Color3.fromRGB(139, 100, 60)
local WALL = Color3.fromRGB(170, 150, 120)
local LEDGE = Color3.fromRGB(96, 100, 110)
local DEN = Color3.fromRGB(52, 46, 40)
local MARKER = Color3.fromRGB(120, 230, 255)
local SKIN = Color3.fromRGB(232, 200, 160)
local SLATE = Color3.fromRGB(70, 74, 82)
local CLERK_ROBE = Color3.fromRGB(70, 40, 100)
local WARDEN_COLORS: { [string]: Color3 } = {
	tidewalk = Color3.fromRGB(40, 110, 160),
	gullstep_climb = Color3.fromRGB(150, 160, 175),
	salt_post = Color3.fromRGB(225, 225, 215),
	cull_the_pack = Color3.fromRGB(120, 60, 50),
	shellbreaker = Color3.fromRGB(190, 160, 100),
	tallymans_duel = Color3.fromRGB(30, 80, 80),
	reed_run = Color3.fromRGB(110, 140, 70),
	bellows_dance = Color3.fromRGB(200, 90, 40),
	spitter_season = Color3.fromRGB(90, 120, 50),
	grand_tally = Color3.fromRGB(150, 60, 200),
}
-- The west Sluice begins here; the Harbour Warden's dock points at it.
local SLUICE_HEAD = Vector3.new(-330, 0, 30)

local function makePart(
	parent: Instance,
	name: string,
	size: Vector3,
	position: Vector3,
	color: Color3,
	material: Enum.Material
): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Anchored = true
	part.Size = size
	part.CFrame = CFrame.new(position)
	part.Color = color
	part.Material = material
	part.Parent = parent
	return part
end

local function buildTallyport(island: Folder)
	local town = Instance.new("Folder")
	town.Name = "Tallyport"

	makePart(
		town,
		"Plaza",
		Vector3.new(80, 0.2, 80),
		Vector3.new(0, World.groundY + 0.1, 0),
		STONE,
		Enum.Material.Cobblestone
	)

	local spawnPad = Instance.new("SpawnLocation")
	spawnPad.Name = "Spawn"
	spawnPad.Anchored = true
	spawnPad.Neutral = true
	spawnPad.Size = Vector3.new(6, 1, 6)
	spawnPad.CFrame = CFrame.new(World.spawn.x, World.spawn.y, World.spawn.z)
	-- No default spawn force field: ProtectionService gives the respawn shield instead.
	spawnPad.Duration = 0
	spawnPad.Parent = town

	-- Safe-zone marker: a flat disc over the plaza. A Roblox cylinder's axis is X,
	-- so it is turned a quarter about Z to lie flat. Plaza top is groundY + 0.2.
	local disc = Instance.new("Part")
	disc.Name = "SafeZone"
	disc.Shape = Enum.PartType.Cylinder
	disc.Anchored = true
	disc.CanCollide = false
	disc.CanTouch = false
	disc.CanQuery = false
	disc.Size = Vector3.new(0.05, World.townRadius * 2, World.townRadius * 2)
	disc.CFrame = CFrame.new(0, World.groundY + 0.2 + 0.1, 0) * CFrame.Angles(0, 0, math.rad(90))
	disc.Color = Color3.fromRGB(255, 225, 140)
	disc.Material = Enum.Material.Neon
	disc.Transparency = 0.8
	disc.Parent = town

	-- Four buildings of different sizes at the plaza corners (width, height, depth).
	local buildings = {
		{ x = -28, z = -28, w = 16, h = 12, d = 14 },
		{ x = 28, z = -28, w = 12, h = 18, d = 12 },
		{ x = -28, z = 28, w = 14, h = 9, d = 18 },
		{ x = 28, z = 28, w = 18, h = 14, d = 16 },
	}
	for i, b in buildings do
		makePart(
			town,
			"Building" .. i,
			Vector3.new(b.w, b.h, b.d),
			Vector3.new(b.x, World.groundY + b.h / 2, b.z),
			WALL,
			Enum.Material.Brick
		)
	end
	town.Parent = island
end

local function buildCache(island: Folder, index: number, cache: Types.Cache)
	local relic = Relics.byId[cache.relicId]
	local c = Tiers.info[relic.tier].color
	local color = Color3.fromRGB(c.r, c.g, c.b)
	local p = cache.position
	-- The cache is 2 tall and its position is its centre, so the floor it stands on is 1 below.
	-- Most caches stand on the ground; a few stand on a raised floor of their own.
	local base = p.y - 1

	local part = makePart(
		island,
		cache.id,
		Vector3.new(2, 2, 2),
		Vector3.new(p.x, p.y, p.z),
		color,
		Enum.Material.SmoothPlastic
	)
	part:SetAttribute("CacheId", cache.id)
	CollectionService:AddTag(part, "Cache")

	-- Pillar is 12 tall, standing on the cache's own floor 3 studs to the side.
	makePart(
		part,
		"Pillar",
		Vector3.new(1, 12, 1),
		Vector3.new(p.x + 3, base + 6, p.z),
		color,
		Enum.Material.Neon
	)

	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Open"
	prompt.ObjectText = "Cache"
	prompt.HoldDuration = cache.hold or 0.5
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.Parent = part

	-- Landmark rock: size depends only on the index, so every build is identical. Only a cache
	-- near the ground has one; a raised cache already stands out.
	if base < 1 then
		local w = 4 + (index % 3) * 2
		local h = 3 + (index % 4)
		local d = 4 + (index % 2) * 3
		makePart(
			island,
			"Rock" .. cache.id,
			Vector3.new(w, h, d),
			Vector3.new(p.x - 8, base + h / 2, p.z + 5),
			ROCK,
			Enum.Material.Slate
		)
	end
end

local function buildPost(island: Folder, index: number, position: Types.Vec3)
	-- 6 tall, standing on the ground.
	local part = makePart(
		island,
		"Post" .. index,
		Vector3.new(2, 6, 2),
		Vector3.new(position.x, World.groundY + 3, position.z),
		WOOD,
		Enum.Material.Wood
	)
	part:SetAttribute("PostId", World.POST_ID_BASE - index)
	CollectionService:AddTag(part, "TrainingPost")

	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(140, 30)
	gui.StudsOffset = Vector3.new(0, 4.5, 0)
	gui.MaxDistance = 60
	gui.AlwaysOnTop = true
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = "Training post"
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0.5
	label.TextScaled = true
	label.Font = Enum.Font.GothamBold
	label.Parent = gui
	gui.Parent = part
end

-- A flat disc lying on the ground. A Roblox cylinder's axis is X, so it is turned a quarter
-- about Z. Characters walk and rays pass through it unless `solid`.
local function makeDisc(
	parent: Instance,
	name: string,
	radius: number,
	position: Vector3,
	thickness: number,
	color: Color3,
	material: Enum.Material,
	solid: boolean
): Part
	local disc = Instance.new("Part")
	disc.Name = name
	disc.Shape = Enum.PartType.Cylinder
	disc.Anchored = true
	disc.CanCollide = solid
	disc.CanTouch = false
	disc.CanQuery = solid
	disc.Size = Vector3.new(thickness, radius * 2, radius * 2)
	disc.CFrame = CFrame.new(position) * CFrame.Angles(0, 0, math.rad(90))
	disc.Color = color
	disc.Material = material
	disc.Parent = parent
	return disc
end

local function makeLabel(parent: Instance, text: string, lift: number, maxDistance: number)
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(180, 44)
	gui.StudsOffset = Vector3.new(0, lift, 0)
	gui.MaxDistance = maxDistance
	gui.AlwaysOnTop = true
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0.5
	label.TextScaled = true
	label.Font = Enum.Font.GothamBold
	label.Parent = gui
	gui.Parent = parent
end

-- The Edict Hall clerk: a figure behind a low counter, with a "Shop" prompt. ShopService
-- finds the body by its tag. The counter is on the plaza side, towards the centre.
local function buildClerk(island: Folder)
	local town = island:FindFirstChild("Tallyport") or island
	local at = World.clerk
	local model = Instance.new("Model")
	model.Name = "EdictHallClerk"
	local body = makePart(
		model,
		"Body",
		Vector3.new(2, 4, 1.5),
		Vector3.new(at.x, at.y + 2, at.z),
		CLERK_ROBE,
		Enum.Material.SmoothPlastic
	)
	local head = makePart(
		model,
		"Head",
		Vector3.new(1.6, 1.6, 1.6),
		Vector3.new(at.x, at.y + 4.8, at.z),
		SKIN,
		Enum.Material.SmoothPlastic
	)
	head.Shape = Enum.PartType.Ball
	makePart(
		model,
		"Counter",
		Vector3.new(6, 3, 2),
		Vector3.new(at.x, at.y + 1.5, at.z + 2.5),
		WOOD,
		Enum.Material.Wood
	)
	model.PrimaryPart = body
	CollectionService:AddTag(body, "ShopClerk")
	makeLabel(body, "Edict Hall\nPacks, Copper Relics, selling", 5.5, 80)

	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Shop"
	prompt.ObjectText = "Edict Hall clerk"
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.Parent = body
	model.Parent = town
end

-- The Tally Stone: the all-time board of the Crowned, and where a player may Renounce. It
-- stands south of the plaza centre, clear of the spawn pad, the clerk and the buildings, and
-- faces the plaza. LeaderboardService finds the board through the tag and fills in the text.
local function buildTallyStone(island: Folder)
	local town = island:FindFirstChild("Tallyport") or island
	local at = World.tallyStone
	local centre = Vector3.new(at.x, 4.5, at.z)
	local model = Instance.new("Model")
	model.Name = "TallyStone"
	local stone =
		makePart(model, "Stone", Vector3.new(12, 9, 2), centre, SLATE, Enum.Material.Slate)
	stone.CFrame = CFrame.lookAt(centre, Vector3.new(0, 4.5, 0))
	model.PrimaryPart = stone
	CollectionService:AddTag(stone, "TallyStone")

	local gui = Instance.new("SurfaceGui")
	gui.Name = "Board"
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 0
	local function addText(
		name: string,
		top: number,
		height: number,
		color: Color3,
		font: Enum.Font
	)
		local label = Instance.new("TextLabel")
		label.Name = name
		label.Position = UDim2.fromScale(0.04, top)
		label.Size = UDim2.fromScale(0.92, height)
		label.BackgroundTransparency = 1
		label.Text = ""
		label.TextColor3 = color
		label.TextScaled = true
		label.TextXAlignment = if name == "Title" or name == "Subtitle"
			then Enum.TextXAlignment.Center
			else Enum.TextXAlignment.Left
		label.Font = font
		label.Parent = gui
	end
	addText("Title", 0, 0.14, Color3.fromRGB(255, 215, 90), Enum.Font.GothamBold)
	addText("Subtitle", 0.14, 0.08, Color3.fromRGB(170, 170, 175), Enum.Font.Gotham)
	for i = 1, 10 do
		addText(
			"Row" .. i,
			0.22 + (i - 1) * 0.075,
			0.075,
			Color3.fromRGB(235, 235, 235),
			Enum.Font.Gotham
		)
	end
	gui.Parent = stone

	makeLabel(stone, "Tally Stone\nThe Crowned", 6.5, 80)

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "RenouncePrompt"
	prompt.ActionText = "Renounce"
	prompt.ObjectText = "Tally Stone"
	prompt.HoldDuration = 2
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.Parent = stone
	model.Parent = town
end

-- A climb ledge: a rock block from the ground up to its top.
local function buildLedge(island: Folder, ledge: Types.Ledge)
	makePart(
		island,
		"Ledge",
		Vector3.new(ledge.size, ledge.top, ledge.size),
		Vector3.new(ledge.x, World.groundY + ledge.top / 2, ledge.z),
		LEDGE,
		Enum.Material.Slate
	)
end

-- A Warden: a small figure with a "Talk" prompt. TrialService finds the body by its tag.
local function buildWarden(island: Folder, trial: Types.Trial, position: Types.Vec3)
	local model = Instance.new("Model")
	model.Name = "Warden_" .. trial.id
	local color = WARDEN_COLORS[trial.id] or WOOD
	local body = makePart(
		model,
		"Body",
		Vector3.new(2, 4, 1.5),
		Vector3.new(position.x, World.groundY + 2, position.z),
		color,
		Enum.Material.SmoothPlastic
	)
	local head = makePart(
		model,
		"Head",
		Vector3.new(1.6, 1.6, 1.6),
		Vector3.new(position.x, World.groundY + 4.8, position.z),
		SKIN,
		Enum.Material.SmoothPlastic
	)
	head.Shape = Enum.PartType.Ball
	model.PrimaryPart = body
	body:SetAttribute("TrialId", trial.id)
	CollectionService:AddTag(body, "Warden")
	makeLabel(body, trial.warden .. "\nTrial: " .. trial.name, 5.5, 80)

	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Talk"
	prompt.ObjectText = trial.warden
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.Parent = body
	model.Parent = island
end

-- A course marker: a glowing ring on the surface under the marker, with its number.
local function buildMarker(island: Folder, trialId: string, index: number, marker: Types.Vec3)
	-- Markers are at standing-root height, 3 above the surface.
	local ring = makeDisc(
		island,
		"TrialMarker",
		3,
		Vector3.new(marker.x, marker.y - 3 + 0.15, marker.z),
		0.1,
		MARKER,
		Enum.Material.Neon,
		false
	)
	ring.Transparency = 0.3
	ring:SetAttribute("TrialId", trialId)
	ring:SetAttribute("Index", index)
	CollectionService:AddTag(ring, "TrialMarker")
	makeLabel(ring, tostring(index), 3, 60)
end

local function buildDen(island: Folder, den: Types.Den)
	local kind = Creatures.byId[den.kind]
	local patch = makeDisc(
		island,
		"Den",
		8,
		Vector3.new(den.position.x, World.groundY + 0.25, den.position.z),
		0.1,
		DEN,
		Enum.Material.Ground,
		false
	)
	makeLabel(patch, (if kind ~= nil then kind.name else den.kind) .. " den", 4, 60)
end

-- The M4 world: climbs, Wardens, course markers, the harbour dock, the duel arena and dens.
local function buildTrialsAndDens(island: Folder)
	for _, ledges in World.climbs do
		for _, ledge in ledges do
			buildLedge(island, ledge)
		end
	end
	for _, trial in Trials.list do
		local position = World.wardens[trial.id]
		if position ~= nil then
			buildWarden(island, trial, position)
		end
	end
	for trialId, markers in World.courses do
		for index, marker in markers do
			buildMarker(island, trialId, index, marker)
		end
	end

	local harbour = Vector3.new(World.harbour.x, World.groundY, World.harbour.z)
	local toward = (SLUICE_HEAD - harbour).Unit
	local dock =
		makePart(island, "Dock", Vector3.new(8, 1, 30), harbour, WOOD, Enum.Material.WoodPlanks)
	local dockCentre = harbour + toward * 20 + Vector3.new(0, 0.5, 0)
	dock.CFrame = CFrame.lookAt(dockCentre, dockCentre + toward)

	makeDisc(
		island,
		"DuelArena",
		25,
		Vector3.new(World.duelArena.x, World.groundY + 0.1, World.duelArena.z),
		0.2,
		STONE,
		Enum.Material.Cobblestone,
		true
	)
	for _, den in World.dens do
		buildDen(island, den)
	end
end

function WorldBuilder.build()
	local island = Instance.new("Folder")
	island.Name = "Island"
	TerrainBuilder.build(island)
	SiteBuilder.build(island)
	buildTallyport(island)
	buildClerk(island)
	buildTallyStone(island)
	for i, cache in World.caches do
		buildCache(island, i, cache)
	end
	for i, position in World.trainingPosts do
		buildPost(island, i, position)
	end
	buildTrialsAndDens(island)
	island.Parent = workspace
end

return WorldBuilder
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
