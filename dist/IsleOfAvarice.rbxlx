          <Item class="ModuleScript" referent="11">
            <Properties>
              <string name="Name">BastionReach</string>
              <string name="Source"><![CDATA[--!strict
local Geography = require("../../Rules/Geography")
local Types = require("../../Types")
local Make = require("./Make")

local REGION: Types.RegionId = "BastionReach"
local WALL_HEIGHT = 24
local ROOF_BOTTOM = 12
local ROOF_TOP = 13.5
local POST_RADIUS = 1.5

-- The three yards, nearest first: the along of the curtain wall that opens the yard, and the
-- across of the gate in it.
local CURTAIN_ALONGS = { 520, 640, 760 }
local GATES = { -120, 120, -120 }

local features: { Types.Feature } = {}

local function wall(a1: number, a2: number, c1: number, c2: number)
	table.insert(features, Make.block(REGION, a1, a2, c1, c2, 0, WALL_HEIGHT, "wall", true))
end

-- A curtain wall across each yard's mouth, with a 20-stud gate centred on the across g.
for i, a in CURTAIN_ALONGS do
	local gate = GATES[i]
	wall(a - 4, a + 4, -200, gate - 10)
	wall(a - 4, a + 4, gate + 10, 200)
end
wall(516, 884, -204, -196)
wall(516, 884, 196, 204)
wall(876, 884, -200, 200)

-- One shelter per yard: a roof on two posts, in line with the prize.
for _, a in CURTAIN_ALONGS do
	table.insert(
		features,
		Make.block(REGION, a + 12, a + 108, -16, 16, ROOF_BOTTOM, ROOF_TOP, "roof", true)
	)
	table.insert(features, Make.disc(REGION, a + 14, 0, POST_RADIUS, 0, ROOF_BOTTOM, "wall", true))
	table.insert(features, Make.disc(REGION, a + 106, 0, POST_RADIUS, 0, ROOF_BOTTOM, "wall", true))
end

-- Three rows of rocks in each yard. The middle column (n = 5) is left bare: that is the shelter
-- line, and the way to the prize.
local hazards: { Types.Hazard } = {}
for yard, a in CURTAIN_ALONGS do
	local damage = if yard == 3 then 35 else 30
	for row = 0, 2 do
		for n = 0, 10 do
			if n ~= 5 then
				local cycle: Types.Cycle = if yard == 3
					then { period = 4.5, warn = 1.5, active = 0.6, offset = ((n + row) % 3) * 1.5 }
					else { period = 6, warn = 2, active = 0.6, offset = ((n + row) % 4) * 1.5 }
				table.insert(hazards, {
					id = `BastionRock{yard}_{row}_{n}`,
					region = REGION,
					name = "Rockfall",
					look = "rockfall",
					shape = Geography.circle(REGION, a + 24 + 36 * row, -180 + 36 * n, 18),
					cycle = cycle,
					damage = damage,
				})
			end
		end
	end
end

local prizeX, prizeZ = Geography.place(REGION, 820, 0)

local site: Types.Site = {
	region = REGION,
	hazards = hazards,
	features = features,
	prize = { relicId = "R012", x = prizeX, y = 1, z = prizeZ, hold = 4 },
	keepOut = { Geography.rect(REGION, 510, 890, -210, 210) },
}

return site
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="12">
            <Properties>
              <string name="Name">CinderFlats</string>
              <string name="Source"><![CDATA[--!strict
local Geography = require("../../Rules/Geography")
local Types = require("../../Types")
local Make = require("./Make")

local REGION: Types.RegionId = "CinderFlats"
local VENT_DAMAGE = 35
local LAVA_DPS = 30
local BASALT_TOP = 0.6

local function vent(id: string, shape: Types.Shape, cycle: Types.Cycle): Types.Hazard
	return {
		id = id,
		region = REGION,
		name = "Vent",
		look = "vent",
		shape = shape,
		cycle = cycle,
		damage = VENT_DAMAGE,
	}
end

local function lava(id: string, shape: Types.Shape, holes: { Types.Shape }?): Types.Hazard
	return {
		id = id,
		region = REGION,
		name = "Lava",
		look = "lava",
		shape = shape,
		holes = holes,
		dps = LAVA_DPS,
	}
end

local hazards: { Types.Hazard } = {}

-- A five by five grid of vents; vent 5m + n + 1 is row m, column n, and the grid erupts in a
-- slow diagonal wave.
for m = 0, 4 do
	for n = 0, 4 do
		table.insert(
			hazards,
			vent(
				`CinderVent{5 * m + n + 1}`,
				Geography.circle(REGION, 440 + 40 * m, -80 + 40 * n, 15),
				{ period = 6, warn = 1.5, active = 1, offset = ((m + 2 * n) % 5) * 1.2 }
			)
		)
	end
end

-- Lava along both flanks of the vent field.
table.insert(hazards, lava("CinderFlank1", Geography.rect(REGION, 440, 620, -190, -110), nil))
table.insert(hazards, lava("CinderFlank2", Geography.rect(REGION, 440, 620, 110, 190), nil))

local pools = {
	{ 340, -120, 22 },
	{ 350, 90, 20 },
	{ 680, -190, 26 },
	{ 700, 200, 24 },
}
for i, pool in pools do
	table.insert(
		hazards,
		lava(`CinderPool{i}`, Geography.circle(REGION, pool[1], pool[2], pool[3]), nil)
	)
end

-- The lake round the prize islet, crossed by a causeway.
table.insert(
	hazards,
	lava("CinderLake", Geography.circle(REGION, 760, 0, 110), {
		Geography.circle(REGION, 760, 0, 32),
		Geography.rect(REGION, 650, 730, -10, 10),
	})
)

-- Four vents on the causeway, firing one after another toward the islet.
for i = 1, 4 do
	table.insert(
		hazards,
		vent(
			`CinderCausewayVent{i}`,
			Geography.circle(REGION, 640 + 20 * i, 0, 11),
			{ period = 4.8, warn = 1.2, active = 0.8, offset = (i - 1) * 1.2 }
		)
	)
end

table.insert(
	hazards,
	vent(
		"CinderPrizeVent",
		Geography.circle(REGION, 760, 0, 12),
		{ period = 5, warn = 1.5, active = 1, offset = 0 }
	)
)

local features: { Types.Feature } = {
	Make.block(REGION, 650, 730, -10, 10, 0, BASALT_TOP, "basalt", true),
	Make.disc(REGION, 760, 0, 32, 0, BASALT_TOP, "basalt", true),
}

local prizeX, prizeZ = Geography.place(REGION, 760, 0)

local site: Types.Site = {
	region = REGION,
	hazards = hazards,
	features = features,
	prize = { relicId = "R011", x = prizeX, y = 1.6, z = prizeZ, hold = 3 },
	keepOut = {
		Geography.rect(REGION, 420, 640, -200, 200),
		Geography.circle(REGION, 760, 0, 120),
	},
}

return site
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="13">
            <Properties>
              <string name="Name">DrownedFen</string>
              <string name="Source"><![CDATA[--!strict
local Geography = require("../../Rules/Geography")
local Types = require("../../Types")
local Make = require("./Make")

local REGION: Types.RegionId = "DrownedFen"
local BOARDWALK_TOP = 0.6

-- along from, along to, across from, across to. The two long walks run down the middle with a
-- rotted gap between them; the three short ones lead off to the east.
local BOARDWALKS = {
	{ 400, 620, -7, 7 },
	{ 680, 860, -7, 7 },
	{ 493, 507, 7, 150 },
	{ 493, 707, 143, 157 },
	{ 693, 707, 7, 150 },
}

local bog = Geography.rect(REGION, 400, 860, -180, 200)

local holes: { Types.Shape } = {}
local features: { Types.Feature } = {}
for _, walk in BOARDWALKS do
	table.insert(holes, Geography.rect(REGION, walk[1], walk[2], walk[3], walk[4]))
	table.insert(
		features,
		Make.block(REGION, walk[1], walk[2], walk[3], walk[4], 0, BOARDWALK_TOP, "wood", true)
	)
end

local site: Types.Site = {
	region = REGION,
	hazards = {
		{
			id = "FenBog",
			region = REGION,
			name = "Bog",
			look = "bog",
			shape = bog,
			holes = holes,
			slow = 0.5,
			dps = 3,
		},
	},
	features = features,
	prize = nil,
	keepOut = { bog },
}

return site
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="14">
            <Properties>
              <string name="Name">HushGardens</string>
              <string name="Source"><![CDATA[--!strict
local Geography = require("../../Rules/Geography")
local Types = require("../../Types")

local REGION: Types.RegionId = "HushGardens"
local SPRING_RADIUS = 14
local KEEP_OUT_RADIUS = 20

-- along, across.
local springs = {
	{ 380, 0 },
	{ 470, 0 },
	{ 560, 0 },
	{ 650, 0 },
	{ 740, 0 },
	{ 450, -120 },
	{ 560, 140 },
	{ 660, -150 },
	{ 790, 130 },
}

-- The blight must come first: a point in both reads "Blight" then "Spring".
local hazards: { Types.Hazard } = {
	{
		id = "HushBlight",
		region = REGION,
		name = "Blight",
		look = "none",
		shape = Geography.regionShape(REGION, 330),
		dps = 5,
	},
}
local keepOut: { Types.Shape } = {}
for i, spring in springs do
	table.insert(hazards, {
		id = `HushSpring{i}`,
		region = REGION,
		name = "Spring",
		look = "spring",
		shape = Geography.circle(REGION, spring[1], spring[2], SPRING_RADIUS),
		heal = 15,
	})
	table.insert(keepOut, Geography.circle(REGION, spring[1], spring[2], KEEP_OUT_RADIUS))
end

local prizeX, prizeZ = Geography.place(REGION, 860, 0)
table.insert(keepOut, Geography.circle(REGION, 860, 0, KEEP_OUT_RADIUS))

local site: Types.Site = {
	region = REGION,
	hazards = hazards,
	features = {},
	prize = { relicId = "R008", x = prizeX, y = 1, z = prizeZ, hold = 3 },
	keepOut = keepOut,
}

return site
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="15">
            <Properties>
              <string name="Name">Make</string>
              <string name="Source"><![CDATA[--!strict
local Geography = require("../../Rules/Geography")
local Types = require("../../Types")

local Make = {}

-- A feature covering the region-frame rectangle a1..a2 along, c1..c2 across, from height y1
-- to y2. Its yaw is the region's bearing.
function Make.block(
	regionId: string,
	a1: number,
	a2: number,
	c1: number,
	c2: number,
	y1: number,
	y2: number,
	look: string,
	solid: boolean
): Types.Feature
	local footprint = Geography.rect(regionId, a1, a2, c1, c2)
	return {
		look = look,
		shape = "block",
		x = footprint.x,
		y = (y1 + y2) / 2,
		z = footprint.z,
		sx = 2 * footprint.halfAcross,
		sy = y2 - y1,
		sz = 2 * footprint.halfAlong,
		yaw = footprint.bearing,
		solid = solid,
	}
end

-- An upright cylinder from height y1 to y2.
function Make.disc(
	regionId: string,
	along: number,
	across: number,
	radius: number,
	y1: number,
	y2: number,
	look: string,
	solid: boolean
): Types.Feature
	local footprint = Geography.rect(regionId, along, along, across, across)
	return {
		look = look,
		shape = "cylinder",
		x = footprint.x,
		y = (y1 + y2) / 2,
		z = footprint.z,
		sx = 2 * radius,
		sy = y2 - y1,
		sz = 2 * radius,
		yaw = footprint.bearing,
		solid = solid,
	}
end

return Make
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="16">
            <Properties>
              <string name="Name">ReckoningRock</string>
              <string name="Source"><![CDATA[--!strict
local Geography = require("../../Rules/Geography")
local Types = require("../../Types")

-- The Rock has no bearing of its own. It lies due south of the island centre, so it is measured
-- in the Fen's frame: along is world z, across is minus world x, and the Rock's centre is
-- (1240, 0).
local FRAME = "DrownedFen"

local site: Types.Site = {
	region = "ReckoningRock",
	hazards = {
		{
			id = "RockTide",
			region = "ReckoningRock",
			name = "High tide",
			look = "tide",
			shape = Geography.rect(FRAME, 940, 1160, -20, 20),
			cycle = { period = 120, warn = 15, active = 35, offset = 0 },
			dps = 40,
		},
	},
	features = {},
	-- World coordinates, written out so the Rock's x is exactly 0.
	prize = { relicId = "R010", x = 0, y = 1, z = 1240, hold = 3 },
	keepOut = { Geography.circle(FRAME, 1240, 0, 30) },
}

return site
]]></string>
            </Properties>
